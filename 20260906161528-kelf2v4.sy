yle=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"中，确保消息持久化存储"}]},{"ID":"20260913224342-69u9jar","Type":"NodeParagraph","Properties":{"id":"20260913224342-69u9jar","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"同时，我会为"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"接收者 ID 和状态字段建立索引"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n优化后续的查询性能，确保即使有大量离线消息也能快速检索"}]},{"ID":"20260913224342-lrmo6bg","Type":"NodeParagraph","Properties":{"id":"20260913224342-lrmo6bg","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"索引设计上，因为用户上线后都是按接收人、未读状态查消息，还要按发送时间排序\n所以我"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"建 receiver_id、status、send_time 联合索引，遵循最左前缀原则"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n（能直接定位到某人的未读消息、且天然按时间有序，不用全表扫描也不用额外排序）\n登录时按 receiver_id + status 捞出未读、按 send_time 排序下发\n既能快速过滤接收人和未读状态，又能"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"利用索引天然有序省去文件排序"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n大数据量下查询性能也能稳住"}]},{"ID":"20260913224342-y0r7fuv","Type":"NodeParagraph","Properties":{"id":"20260913224342-y0r7fuv","updated":"20260913224342"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"消息下发与状态管理"},{"Type":"NodeText","Data":"\n在用户登录成功后，服务器会立即查询该用户的所有未读离线消息\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"按照时间顺序逐条推送给用户,并实时更新消息状态为已读"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260913224342-d3zduqh","Type":"NodeParagraph","Properties":{"id":"20260913224342-d3zduqh","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"下发机制采用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"批量查询 + 逐条推送"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"的方式\n既保证了消息的完整性，又避免了单次数据量过大导致的网络传输问题\n此外，我还会考虑"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"消息的过期清理机制\n定期删除超过一定时间的已读离线消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n防止数据库无限增长，确保系统的长期稳定运行"}]},{"ID":"20260913224342-zyn6qov","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-zyn6qov","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"百万并发下离线消息表设计"}]},{"ID":"20260913224342-k1xmjrb","Type":"NodeParagraph","Properties":{"id":"20260913224342-k1xmjrb","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"百万并发场景，单库单表肯定扛不住\n首先我会做"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"消息水平分库分表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，按照"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"接受者 ID 做哈希分片"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，把海量消息打散到多个库表\n避免单表数据量过大、查询写入瓶颈"}]},{"ID":"20260913224342-swbkq5o","Type":"NodeParagraph","Properties":{"id":"20260913224342-swbkq5o","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"其次不会直接落库 MySQL，会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"加 Redis 做缓冲削峰"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高并发瞬间的离线消息先写入 Redis 队列做暂存"},{"Type":"NodeText","Data":"\n再通过异步消息慢慢落地 MySQL，防止瞬时大量写请求压垮数据库"}]},{"ID":"20260913224342-th1o6po","Type":"NodeParagraph","Properties":{"id":"20260913224342-th1o6po","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"查询层面\n用户上线拉取离线消息"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优先读 Redis 缓存"},{"Type":"NodeText","Data":"\n把用户未读消息提前缓存，只有缓存不命中才查分表后的 MySQL"}]},{"ID":"20260913224342-45bil16","Type":"NodeParagraph","Properties":{"id":"20260913224342-45bil16","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"索引方面\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"做数据冷热分离 + 定时归档"},{"Type":"NodeText","Data":"\n离线消息有明显冷热特征：已读、超过一定时间（比如 3 个月）的历史消息就是冷数据\n我会用定时任务，定期把冷数据迁移到归档表或大数据存储\n只在业务表保留最近的热数据，强制把单表数据量压在百万以内"}]},{"ID":"20260913224342-y19ivbd","Type":"NodeParagraph","Properties":{"id":"20260913224342-y19ivbd","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"另外我还会做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"消息异步化、批量更新"},{"Type":"NodeText","Data":"\n用户标记已读不逐条更新数据库，而是合并批量操作\n减少数据库行锁和频繁 IO，整体抗住百万并发的读写压力"}]},{"ID":"20260913224342-eujzu31","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-eujzu31","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"用户上线的通知优化方案"}]},{"ID":"20260913224342-l3hs5xs","Type":"NodeParagraph","Properties":{"id":"20260913224342-l3hs5xs","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"把通知"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"批量发送、异步处理"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，并"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"缓存好友状态"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不用每次都查 MySQL"},{"Type":"NodeText","Data":"\n减少重复推送和网络开销，提升登录速度\n增加"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"确认与重试机制"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，保证通知不丢失，同时用统一协议支持更多状态更新\n客户端做队列与批量刷新，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"服务端优化心跳和"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"消息压缩"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，整体更流畅稳定"}]},{"ID":"20260913224342-2p3dps7","Type":"NodeParagraph","Properties":{"id":"20260913224342-2p3dps7","updated":"20260913224342"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"好友状态主动拉取"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"，让"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"客户端定期去问服务器要好友的在线状态"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，而不是等服务器主动推送\n每隔一段时间请求一次，也可以带上时间戳只拉取有变化的增量数据，减少网络传输"}]},{"ID":"20260913224342-6qksf61","Type":"NodeParagraph","Properties":{"id":"20260913224342-6qksf61","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"实际项目里可以用"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);"},"TextMarkType":"text","TextMarkTextContent":"推送 + 拉取混合模式"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);\"}"},{"Type":"NodeText","Data":"：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"重要好友用推送保证实时，普通好友用拉取减轻压力"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n再配合本地缓存、智能间隔和协议压缩，既能保证体验，又能提升整体性能"}]},{"ID":"20260913224342-kooz6ee","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-kooz6ee","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"你在项目中用到了哪些设计模式？分别用在什么地方？"}]},{"ID":"20260913224342-edagbzc","Type":"NodeParagraph","Properties":{"id":"20260913224342-edagbzc","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"单例模式：整个系统只有一个 CKernel 实例，统一管理核心业务，不重复创建浪费资源。\n中介者模式：用 IMediator 接口和实现类做中间协调层，把业务逻辑和网络通信分开，两边互不干扰，解耦更清晰。\n命令模式：靠 CKernel 里的函数指针数组，按协议类型直接找对应处理函数，把请求和处理解耦。\n（命令模式是\"把请求封装成对象、让发起者和执行者解耦\"）"}]},{"ID":"20260913224342-7sykq88","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-7sykq88","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"单例模式在你的项目中是如何应用的？"}]},{"ID":"20260913224342-6zt3u0a","Type":"NodeParagraph","Properties":{"id":"20260913224342-6zt3u0a","updated":"20260913224342"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单例设计"},{"Type":"NodeText","Data":"\nCKernel 构造函数赋值给静态指针，确保全局只有一个内核实例，网络层通过全局指针调用处理方法，不重复创建、节省资源，接口统一、安全稳定"}]},{"ID":"20260913224342-zyzfumv","Type":"NodeParagraph","Properties":{"id":"20260913224342-zyzfumv","updated":"20260913224342"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"客户端功能"},{"Type":"NodeText","Data":"：管理登录、好友、聊天界面，绑定 UI 与业务，通过 TCP 通信，解析协议、处理登录 / 聊天 / 加好友，同步好友状态。\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"服务端功能"},{"Type":"NodeText","Data":"：管理客户端连接，按协议分发处理，操作数据库，维护在线状态，转发消息、通知上下线。"}]},{"ID":"20260913224342-ecea88y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-ecea88y","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"中介者模式如何解耦网络层与业务层？你是如何设计 “中介者” 的？"}]},{"ID":"20260913224342-i8hv09a","Type":"NodeParagraph","Properties":{"id":"20260913224342-i8hv09a","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"让 TcpServerMediator 做中间层，把网络层和业务层分开\n业务层只用中介者提供的方法\n网络层收到数据，也通过中介者转给业务层\n中介者里持有网络对象和业务层单例指针，充当中间协调人"}]},{"ID":"20260913224342-0k96xwk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-0k96xwk","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"介绍下你项目中用到的多线程，如何避免多线程下的数据竞争？"}]},{"ID":"20260913224342-m5g4ki1","Type":"NodeParagraph","Properties":{"id":"20260913224342-m5g4ki1","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"项目中使用了 两个核心线程\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"acceptThread 负责循环接收客户端连接"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，每来一个连接就创建一个新的 recvThread 处理该客户端的数据接收。\n多线程竞争主要出现在 m_mapThreadIdToSocket （线程 ID 到 socket 的映射）和 m_mapIdToSocket （用户 ID 到 socket 的映射）这两个共享容器上。实际优化时，我会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"使用 std::mutex 配合 std::lock_guard 对容器访问进行加锁"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224342-8gxqq8b","Type":"NodeTable","TableAligns":[0,0,0,0],"Properties":{"colgroup":"|||","id":"20260913224342-8gxqq8b","updated":"20260913224342"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"映射表名称"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"所属层级"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"核心作用"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"用途"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"m_mapThreadIdToSocket"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"TcpServer"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"线程 ↔ 连接 绑定"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"多线程接收数据、连接管理"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"m_mapIdToSocket"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"CKernel"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"用户 ID ↔ 连接 绑定"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"消息转发、在线状态管理、好友通知"}]}]}]},{"ID":"20260913224342-z655hg8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-z655hg8","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"MySQL 中用户表、好友关系表、离线消息表的结构是怎样设计的？"}]},{"ID":"20260913224342-e0w9i4u","Type":"NodeParagraph","Properties":{"id":"20260913224342-e0w9i4u","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"用户表 ： id (主键自增)、 name (昵称唯一)、 tel (手机号唯一)、 password 、 feeling 、 iconid (头像 ID)\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"好友关系表  ： idA 、 idB （联合主键，表示 A 和 B 是好友关系，双向存储两条记录）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n离线消息表：包含 id (自增)、 from_id (发送者)、 to_id (接收者)、 content (内容)、 send_time (发送时间)，已读未读状态标识"}]},{"ID":"20260913224342-yurmzyb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-yurmzyb","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"如果用户在长时间离线后上线，需要拉取大量历史消息，你会怎么设计拉取策略避免 UI 卡顿？"}]},{"ID":"20260913224342-wu6f8la","Type":"NodeParagraph","Properties":{"id":"20260913224342-wu6f8la","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"采用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"分页加载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，每次只加载少量最近消息，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"滑动到底再加载下一页"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，避免一次性加载太多数据导致内存占用过高、界面卡顿\n使用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"异步加载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，把网络请求和数据处理放在后台线程，不阻塞主线程，保证 UI 一直流畅\n通过增量加载，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"只拉取新增和未读消息，优先显示重要内容，再按需加载历史消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n同时用数据压缩、增量同步、"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"本地缓存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，减少网络传输和重复请求，降低带宽消耗"}]},{"ID":"20260913224342-4ub47rm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-4ub47rm","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"你如何处理 “同一账号多处同时登录” 的场景？"}]},{"ID":"20260913224342-qvulkt8","Type":"NodeParagraph","Properties":{"id":"20260913224342-qvulkt8","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"在 m_mapIdToSocket 中"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"保存用户 ID 到 socket 的映射"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n当用户登录时，先"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"检查该 userId 是否已存在于 map 中"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224342-svhnqve","Type":"NodeParagraph","Properties":{"id":"20260913224342-svhnqve","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"如果存在，说明该账号已在别处登录，此时有两种处理策略\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"踢下线 ：关闭旧 socket，强制下线旧客户端，新客户端登录成功\n拒绝登录 ：新客户端登录失败，提示\"账号已在别处登录\""}]},{"ID":"20260913224342-dmcopbn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-dmcopbn","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"如何设计一个 “"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"最近联系人列表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"”，保证查询和更新都足够快速？"}]},{"ID":"20260913224342-ayyk679","Type":"NodeParagraph","Properties":{"id":"20260913224342-ayyk679","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"我设计的高性能最近联系人列表，采用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"双向链表 + 哈希表的组合结构"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"哈希表实现 O (1) 快速查找，双向链表保证按最近联系时间排序"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n让插入、移到头部、删除旧数据都是 O (1) 操作\n每次有消息往来，就把对应联系人移到链表最前面，超过最大数量时删掉最久未联系的\n列表查询直接遍历链表，配合缓存和分页，速度非常快\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"数据通过本地数据库持久化，启动时重建链表和哈希表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224342-t53lzz4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224342-t53lzz4","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"如何确保聊天信息从 A 发送到 B 能被成功接收，及丢包、重传的解决办法"}]},{"ID":"20260913224342-2vql3az","Type":"NodeParagraph","Properties":{"id":"20260913224342-2vql3az","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"发送方写好消息后"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"先存在本地"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，避免闪退丢失，再通过 TCP 或 WebSocket 发送\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"服务器收到后会立即存起"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"来，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"再转发"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"给接收方\n接收方收到后，会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"给服务器发回执"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，确认收到后"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"再存在本地并展示"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"出来\n同时，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"每条消息都有唯一 ID"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，还会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"标记"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"待发送、已发送等"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"状态"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，方便追踪\n服务器和客户端的"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"双重存储、回执确认"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，就是消息可靠的基础保障"}]},{"ID":"20260913224342-2e174ho","Type":"NodeParagraph","Properties":{"id":"20260913224342-2e174ho","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"丢包主要有三个常见原因：\n网络层面的"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"抖动、断网"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n服务器层面的"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"过载、宕机"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n客户端的"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"闪退"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"切网"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"或被后台杀掉"}]},{"ID":"20260913224342-9ux54qq","Type":"NodeParagraph","Properties":{"id":"20260913224342-9ux54qq","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"针对这些问题，也有对应的解决办法：\n网络上用 TCP 这类自带"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"可靠传输"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"的协议，还会实时检测网络质量\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"弱网时调整发送频率"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n服务器用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"消息队列削峰，多节点集群部署"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n避免单节点故障，再通过负载均衡分摊压力\n客户端则会实现"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"断网自动重连"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，没收到回执的消息"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"先缓存，网络恢复后自动重发"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224342-h3vhkbp","Type":"NodeParagraph","Properties":{"id":"20260913224342-h3vhkbp","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"丢包后的重传也有讲究，主要看两个触发条件：\n发送方没收到服务器回执、服务器没收到接收方回执，超过 1-3 秒的超时时间就会触发重传\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"为了不加重网络负担，重传间隔会逐渐变长"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，还会限制最多重传 3-5 次，失败后就提示用户\n网络恢复后，会把待重传消息批量发送，提高效率\n另外，通过"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"消息唯一 ID 去重和本地记录已收消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，能避免同一条消息被重复处理"}]},{"ID":"20260913224342-6194rth","Type":"NodeParagraph","Properties":{"id":"20260913224342-6194rth","updated":"20260913224342"},"Children":[{"Type":"NodeText","Data":"除了基础保障，还有一些高级措施进一步确保可靠：\nWebSocket 连接失败时，会用手机系统推送作为备用通道，根据网络状况切换最优通道\n消息采用多副本存储，服务器故障后能快速恢复未处理消息\n同时会实时监控发送成功率、重传率等指标，出现异常及时告警排查\n总的来说，只要把客户端本地存储、服务器持久化、网络传输保障、回执重传策略结合起来，再配合容灾和监控，就能实现 IM 消息的“零丢失”，提升用户体验和系统稳定性。"}]},{"ID":"20260913224201-x2iglls","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-x2iglls","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"读扩散和写扩散\t"}]},{"ID":"20260913224201-1cle4xx","Type":"NodeParagraph","Properties":{"id":"20260913224201-1cle4xx","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"在 IM 群消息场景中，主要分为写扩散和读扩散两种模式"}]},{"ID":"20260913224201-4v6yhmq","Type":"NodeParagraph","Properties":{"id":"20260913224201-4v6yhmq","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"写扩散是指发送一条群消息时，分别写入每个群成员的独立信箱\n用户读取时只需拉取自己的信箱即可"}]},{"ID":"20260913224201-715nrvc","Type":"NodeParagraph","Properties":{"id":"20260913224201-715nrvc","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"这种方式读取性能极高，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"适合高并发读取场景"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，也"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"支持用户独立删除自己的消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n但会带来大量的写入冗余和存储成本，群人数过多时延迟会明显增大，这也是微信群人数限制在 500 人左右的重要原因"}]},{"ID":"20260913224201-33shcwa","Type":"NodeParagraph","Properties":{"id":"20260913224201-33shcwa","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"读扩散则是所有群成员共享一个群信箱，一条消息只需要写入一次，读取时再结合个人的消息删除表做过滤展示\n这种方式"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"写入成本低、实时性好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，但"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"读取逻辑更复杂，容易出现 IO 热点问题"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，更适合超大群场景"}]},{"ID":"20260913224201-tjbc97l","Type":"NodeParagraph","Properties":{"id":"20260913224201-tjbc97l","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image-20260403213157763"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260403213157763.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260913224201-ogyrhxm","Type":"NodeParagraph","Properties":{"id":"20260913224201-ogyrhxm","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"朋友圈"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"这类 Feed 流同样适用读写扩散思路"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n读扩散是每次拉取所有好友动态再内存排序，实现简单但读取开销大，容易出现"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"热点瓶颈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n写扩散则是用户发布内容后，直接推送到所有好友的收件箱中，用户刷朋友圈时只需查询自己的收件箱\n体验更流畅，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"但发布时写入量大"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"、存储冗余更高，适合读多写少的场景\n为了"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"优化写扩散，通常只在收件箱中存储消息 ID 而不是完整内容"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"查询时采用懒加载方式减少压力"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-g3lzdof","Type":"NodeParagraph","Properties":{"id":"20260913224201-g3lzdof","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"feed 流：平台持续向用户推送内容的信息流，常见于 APP 首页、推荐页或关注页，内容按时间、热度或算法排序，用户通过上下滑动不断加载新内容，像刷抖音、朋友圈、微博首页看到的连续内容，都是典型的 Feed 流"}]},{"ID":"20260913224201-syz0na7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-syz0na7","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"为什么 IM 系统采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"收件箱 / 发件箱分离、写扩散"},{"Type":"NodeText","Data":"设计后，读取消息时"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不需要遍历全群、不需要实时聚合，读取速度很快"},{"Type":"NodeText","Data":"？"}]},{"ID":"20260913224201-z8dziae","Type":"NodeParagraph","Properties":{"id":"20260913224201-z8dziae","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"IM 采用收件箱、发件箱与消息正文分离的架构，并且基于写扩散实现消息分发"}]},{"ID":"20260913224201-i99osfh","Type":"NodeParagraph","Properties":{"id":"20260913224201-i99osfh","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"消息发送阶段，服务端会提前遍历群内所有成员\n把这条消息提前分发写入每一位成员独立的收件箱中\n遍历群成员、消息归属分配这些重操作，都在发送时完成"}]},{"ID":"20260913224201-4p3rnyj","Type":"NodeParagraph","Properties":{"id":"20260913224201-4p3rnyj","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"用户的收件箱是个人专属索引表，里面只保存自己收到的消息\n天然就是该用户完整聊天记录，无需再次筛选、匹配成员和排序聚合"}]},{"ID":"20260913224201-3w8bz6z","Type":"NodeParagraph","Properties":{"id":"20260913224201-3w8bz6z","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"用户读取聊天记录时，只需要查询自己单独的收件箱即可\n不需要遍历全群，也不需要实时聚合计算，因此读取速度极快"}]},{"ID":"20260913224201-pvuok34","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-pvuok34","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"超大群聊中怎么解决读扩散最大痛点：实时性差"}]},{"ID":"20260913224201-qgfp9c0","Type":"NodeParagraph","Properties":{"id":"20260913224201-qgfp9c0","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"纯读扩散不推送，体验很差\n真实大厂方案是："},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"读扩散为主 + 推送兜底"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260913224201-in9f4ur","Type":"NodeParagraph","Properties":{"id":"20260913224201-in9f4ur","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"群消息只存一份：只写入一张群消息表（群 ID + 消息序号 seq + 内容），不按用户写离线消息\n每个用户维护自己的消费位点 offset/seq：记录我读到第几条了\n发消息：服务端只写 1 次库，不遍历几万人逐个推送\n收消息：客户端主动拉取大于我当前 offset 的新消息"}]},{"ID":"20260913224201-k8dx9sz","Type":"NodeParagraph","Properties":{"id":"20260913224201-k8dx9sz","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"发群消息，写入群消息表，生成全局 seq\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"服务端不逐个推消息内容，只给在线用户发一个极简推送通知"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\n“群有新消息，自己来拉”\n客户端收到通知，主动拉取最新一批消息\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"离线用户：上线后直接拉取从上次 offset 到最新的所有消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n既不用推几万条消息，又保证实时收到提醒。"}]},{"ID":"20260913224201-30cnwew","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-30cnwew","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"几万人大群，所有人同时拉取消息，并发读爆炸怎么扛"}]},{"ID":"20260913224201-xr52ujr","Type":"NodeParagraph","Properties":{"id":"20260913224201-xr52ujr","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"主要靠"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"缓存、批量拉取、削峰、位点设计"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"解决高并发读问题"}]},{"ID":"20260913224201-eodcb8r","Type":"NodeParagraph","Properties":{"id":"20260913224201-eodcb8r","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"首先群消息只存一份，用全局递增 seq 做唯一标识，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"热点消息直接放 Redis 缓存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n用户拉取不走 MySQL，用 "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"Redis 扛高并发读取压力"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n其次客户端不是单条拉消息，而是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"根据自己的 offset "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"批量拉取区间消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n一次请求拉多条，大幅减少请求次数\n同时收到新消息通知后，客户端"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"做随机延迟抖动，打散并发请求"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，避免大量用户同一时刻集中查询\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"再结合大群分片、接口限流，配合 seq 位点保证消息有序不重复"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，整体就能稳定支撑超大群的并发读取"}]},{"ID":"20260913224201-w6lm13p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-w6lm13p","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"不同服务器怎么保证消息一致"}]},{"ID":"20260913224201-gjauoh7","Type":"NodeParagraph","Properties":{"id":"20260913224201-gjauoh7","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"几万人大群采用读扩散实现，为了应对大量用户同时读取的压力\n我们"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"把热点群消息统一放在 Redis 缓存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，不直接查数据库\n客户端根据自己的读取位点批量拉取消息，收到新消息通知后随机延迟请求，错开并发高峰"}]},{"ID":"20260913224201-kge7w5b","Type":"NodeParagraph","Properties":{"id":"20260913224201-kge7w5b","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"我们会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"把大群成员分散到多台服务节点做分片处理"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，分摊查询压力，同时做接口限流防止服务被打崩\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"消息全局只存一份，所有节点共用同一份数据，配合递增的消息序号和用户位点\n保证多节点下消息一致、有序、不重复"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-z86fsp4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-z86fsp4","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"微信朋友圈功能怎么实现的"}]},{"ID":"20260913224201-mzceo8h","Type":"NodeParagraph","Properties":{"id":"20260913224201-mzceo8h","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"朋友圈本质就是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"写扩散 + 读扩散结合"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"的方案"}]},{"ID":"20260913224201-6ra40pb","Type":"NodeParagraph","Properties":{"id":"20260913224201-6ra40pb","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"用户发朋友圈时，首先把动态内容、图片、文字存到数据库\n再给自己的好友列表做写扩散，把这条动态 ID 推送到每个好友的朋友圈收件箱里\n这样好友打开朋友圈，直接读自己收件箱里的动态就行，不用去遍历所有人的发布记录，速度很快"}]},{"ID":"20260913224201-nw4jv69","Type":"NodeParagraph","Properties":{"id":"20260913224201-nw4jv69","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"对于好友特别多的用户，不会挨个推送，改用读扩散，只存一份发布记录，好友浏览时按需拉取"}]},{"ID":"20260913224201-i19dq56","Type":"NodeParagraph","Properties":{"id":"20260913224201-i19dq56","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"同时用分布式自增 ID 保证动态有序，结合缓存动态、分页加载、点赞评论异步更新，减少数据库压力\n再加上权限控制，实现分组可见、仅自己可见，整体保证性能和用户体验"}]},{"ID":"20260913224201-gmdtr3f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-gmdtr3f","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"已读、@ 提醒、小红点怎么实现？"}]},{"ID":"20260913224201-1qhpldy","Type":"NodeParagraph","Properties":{"id":"20260913224201-1qhpldy","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"已读：用户拉取并展示后，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"上报自己的最大 seq"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"；服务端统计多少人读到该消息 seq\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"@ 某人：不走群消息推送，单独给被 @ 人发一条点对点推送 / 通知"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n小红点：客户端对比本地 offset 和服务端最新 seq，差值 \u003e 0 就显示红点"}]},{"ID":"20260913224201-3o0asee","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-3o0asee","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"TCP 能确保消息一定正确传达不丢吗\t\t"}]},{"ID":"20260913224201-icgedg8","Type":"NodeParagraph","Properties":{"id":"20260913224201-icgedg8","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"TCP 只能保证传输层的可靠，也就是它能保证发的字节流，一定会按顺序、不丢、不错的传到对端的传输层\n但是不能保证应用层的消息不丢：\n比如，客户端发了消息，TCP 把数据传到了服务端的内核\n但是服务端的进程还没来得及读，就挂了,那这个数据就丢了\n或者，客户端发了消息之后，自己挂了，没收到服务端的 ACK，就以为消息没发出去\n其实服务端已经收到了，这时候如果客户端重发，就会重复\n所以 TCP 只是传输层的保障，应用层还是要自己做 ACK、重试、持久化这些，才能保证消息不丢"}]},{"ID":"20260913224201-tckl4wo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-tckl4wo","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"业内普遍的 IM 都用什么协议吗"}]},{"ID":"20260913224201-hltegkp","Type":"NodeParagraph","Properties":{"id":"20260913224201-hltegkp","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"目前业内主流 IM 通信协议主要分为"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"私有二进制协议、通用标准协议、Web 端专用协议"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n核心是兼顾实时性、可靠性、功耗和安全性"}]},{"ID":"20260913224201-lj5iuah","Type":"NodeParagraph","Properties":{"id":"20260913224201-lj5iuah","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"传统大厂自研 IM 大多用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"私有二进制协议"},{"Type":"NodeText","Data":"，比如微信、钉钉这类\n底层一般基于 TCP，自己封装包头、消息序号、心跳、重传、加密逻辑\n二进制格式体积小，解析快，还能自定义消息格式\n适合高并发、低延迟的即时聊天，缺点是兼容性差、开发成本高"}]},{"ID":"20260913224201-5givj1u","Type":"NodeParagraph","Properties":{"id":"20260913224201-5givj1u","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"通用开源标准协议里 XMPP 是老牌 XML 协议，早期 QQ、陌陌用过，扩展性强但冗余大、性能一般\nMQTT 轻量、功耗低，更多用于 loT 设备，移动端 IM 也会用来做推送\nWebSocket 是 Web 端 IM 标配，基于 HTTP 握手后长连接，浏览器原生支持，网页聊天，小程序 IM 基本用它"}]},{"ID":"20260913224201-whb4668","Type":"NodeParagraph","Properties":{"id":"20260913224201-whb4668","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"近几年 Web3 领域兴起了 XMTP（可扩展消息传输协议）\n它是去中心化开源 IM 协议，区别与传统中心化架构，以区块链钱包地址作为身份标识\n不用手机号注册账号，用你区块链钱包里那串唯一地址当聊天 ID，不同钱包、链上软件之间能互相发消息，消息只有收发双方能看见，平台管不着删不掉，主要用来在钱包、链上小程序里聊天"}]},{"ID":"20260913224201-s58o1wl","Type":"NodeParagraph","Properties":{"id":"20260913224201-s58o1wl","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"现在主流移动端 IM 大多是 TCP+ 私有协议为主，WebSocket 做 Web 端兼容\n同时搭配 UDP 做音视频实时流，用 QUIC 协议优化弱网下的连接稳定性\n去中心化场景则优先采用 XMTP，整体思路就是长连接保在线、自定义协议保性能、分层适配不同端"}]},{"ID":"20260913224201-uaiaynb","Type":"NodeParagraph","Properties":{"id":"20260913224201-uaiaynb","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"XML"},{"Type":"NodeText","Data":" 是可扩展标记语言，简单说就是一种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用来结构化存储、传输数据的文本格式"},{"Type":"NodeText","Data":"\n和 HTML 长得像，但不负责展示页面，只用来描述数据）"}]},{"ID":"20260913224201-g0ret9h","Type":"NodeParagraph","Properties":{"id":"20260913224201-g0ret9h","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"企业微信这种聊天产品一般会选哪种"},{"Type":"NodeText","Data":"，更接近：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"TLS 长连接 + 私有 IM 协议 + HTTPS 接口 + 独立音视频协议，而不是直接用标准 XMPP"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-zzsyqyx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-zzsyqyx","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"什么叫去中心化"}]},{"ID":"20260913224201-s7ef21h","Type":"NodeParagraph","Properties":{"id":"20260913224201-s7ef21h","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"中心化：\n像微信、QQ，所有聊天记录、用户信息都存在腾讯的服务器里\n腾讯想删你消息、封你号、看你聊天都可以，它说了算"}]},{"ID":"20260913224201-6n8fjny","Type":"NodeParagraph","Properties":{"id":"20260913224201-6n8fjny","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"去中心化：\n没有某一家公司单独掌控服务器，数据分散存在很多节点上\n平台管不了你、删不掉你的消息、不能封你账号\n你的身份、聊天数据都归你自己，不由第三方平台控制，这就是去中心化"}]},{"ID":"20260913224201-xvsp034","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-xvsp034","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"你项目通信过程中用到加密了吗"}]},{"ID":"20260913224201-m05yz7c","Type":"NodeParagraph","Properties":{"id":"20260913224201-m05yz7c","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"严格按项目事实说：密码用了 MD5 后再发\n客户端把密码做 16 字节 MD5，服务端转成 32 位十六进制串存库和比对\n但业务链路本身没有 TLS，没有传输层加密\n所以严格说：只做了密码摘要处理，没做整条链路加密"}]},{"ID":"20260913224201-rvaw5n8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-rvaw5n8","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"你设计一个 TCP 加密，你怎么设计"}]},{"ID":"20260913224201-z5uioxg","Type":"NodeParagraph","Properties":{"id":"20260913224201-z5uioxg","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"如果我自己设计 TCP 加密，核心就一句话：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"非对称密钥负责安全协商，对称密钥负责高速加密传输"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-8ryluh7","Type":"NodeParagraph","Properties":{"id":"20260913224201-8ryluh7","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"首先握手阶段，用 RSA 或者 ECDHE 非对称算法，主要做两件事：\n一是验证对方身份防冒充，二是安全协商出一个临时的会话密钥，全程不泄露密钥"}]},{"ID":"20260913224201-sclqud1","Type":"NodeParagraph","Properties":{"id":"20260913224201-sclqud1","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"然后传输数据的时候，用 AES‑GCM 这种对称加密，速度快适合 TCP 长连接\n每包消息带上序列号、随机数、校验标签，防止重放攻击、消息篡改\n再额外加上证书校验、定期密钥轮换、支持会话恢复，保证安全和性能\n实际项目里肯定直接用成熟的 TLS 协议，不会自己从头写一套，避免安全漏洞"}]},{"ID":"20260913224201-xsjc0kh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-xsjc0kh","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"这个项目中 IM 消息最多能发多少条"}]},{"ID":"20260913224201-a56gnxj","Type":"NodeParagraph","Properties":{"id":"20260913224201-a56gnxj","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"单条消息长度上限"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"有明确限制：4096 字节"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-9d53o17","Type":"NodeParagraph","Properties":{"id":"20260913224201-9d53o17","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"项目目前没有做历史消息存储的功能，\n协议层面没有“多少条消息”上限\n主要约束是：\n单条消息内容最大 4096 字节\nTCP 发送/接收速度和网络带宽\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"客户端 UI 历史消息积累导致内存/性能下降"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913224201-fc9lyv6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-fc9lyv6","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"设计一个历史消息的功能你怎么设计"}]},{"ID":"20260913224201-cl0g2vu","Type":"NodeParagraph","Properties":{"id":"20260913224201-cl0g2vu","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"把聊天历史放在服务端数据库里"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n服务端收到聊天请求后\n先把 发送者用户 ID、接收者用户 ID、消息内容、消息时间戳 / 发送时间等\n存入消息表再转发给目标客户端\n这样可以保证历史记录集中存储、易于备份、支持多端同步"}]},{"ID":"20260913224201-vh0jeim","Type":"NodeParagraph","Properties":{"id":"20260913224201-vh0jeim","updated":"20260913224201"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"客户端可以配合做本地缓存，保存最近几百条会话记录"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n提升打开聊天窗口的响应速度和离线体验\n但核心数据仍以服务端数据库为准，避免不同设备间记录不一致"}]},{"ID":"20260913224201-9vusd97","Type":"NodeParagraph","Properties":{"id":"20260913224201-9vusd97","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"考虑到前端显示和性能，建议客户端只拉取最近 N 条历史，滚动加载旧消息\n服务端可以按时间或对话分区存储，保证查询效率"}]},{"ID":"20260913224201-n5x4cg9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-n5x4cg9","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"你 IM 消息流是怎么设计的"}]},{"ID":"20260913224201-pcc811o","Type":"NodeParagraph","Properties":{"id":"20260913224201-pcc811o","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"核心就是一条很清晰的链路：\n聊天窗输入 -\u003e 客户端业务层封包 -\u003e TCP 发送 -\u003e 服务端路由 -\u003e 对端客户端解包展示\nUI 不直接操作 socket，而是统一交给 CKernel 做业务封装\n这样界面层、网络层、协议层是解耦的，后面加新消息类型会比较容易"}]},{"ID":"20260913224201-4rsceqb","Type":"NodeParagraph","Properties":{"id":"20260913224201-4rsceqb","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"协议上我用的是固定结构体加 type 消息号，再配合“先读包长、再读包体”的方式处理 TCP 粘包拆包\n收到完整包以后，不是写很多 if-else，而是通过协议号分发到对应处理函数\n所以登录、聊天、好友信息、下线通知这些消息，都是同一套消息分发框架在跑"}]},{"ID":"20260913224201-53wd62q","Type":"NodeParagraph","Properties":{"id":"20260913224201-53wd62q","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"聊天消息本身比较直接：\n发送方把 userId、friendId、content 封成聊天包发给服务端\n服务端根据 friendId 查在线 socket，在线就直接转发，不在线就回失败结果给发送方\n登录和退出的时候，我还做了好友信息同步和上下线通知，所以整个消息流不只是“发聊天”\n而是把单聊、好友列表、在线状态这几个核心链路都串起来了"}]},{"ID":"20260913224201-ften5oz","Type":"NodeParagraph","Properties":{"id":"20260913224201-ften5oz","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"这版重点是先把实时在线消息链路打通，属于轻量版 IM\n如果做成线上方案，我会再补消息落库、离线消息、ACK 确认和重发机制\n这样可靠性就能进一步提升"}]},{"ID":"20260913224201-k86za0l","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-k86za0l","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"消息内容是怎么发的"}]},{"ID":"20260913224201-xu3vzkt","Type":"NodeParagraph","Properties":{"id":"20260913224201-xu3vzkt","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"消息内容是跟 userId、friendId 一起，放进一个聊天协议包里发的"}]},{"ID":"20260913224201-7lpsyw2","Type":"NodeParagraph","Properties":{"id":"20260913224201-7lpsyw2","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"客户端发送时会创建 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"STRU"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"CHAT"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"RQ\n里面有三个核心字段：发送者 id、接收者 id、消息内容 content\ncontent 本质上是一个 char content[4096]，先把输入框里的文本拷进去\n然后整个结构体作为一段二进制数据，通过 TCP 发给服务端"}]},{"ID":"20260913224201-hko0047","Type":"NodeParagraph","Properties":{"id":"20260913224201-hko0047","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"服务端收到后，先按“包长 + 包体”把完整数据收出来，再把这段包体强转回 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"STRU"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"CHAT"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"RQ\n这样就能直接拿到里面的 content\n如果对方在线，服务端不改内容，直接把这个聊天包原样转发给对方\n对方客户端收到后再解包，把 content 取出来显示到聊天窗口"}]},{"ID":"20260913224201-bjnbocf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913224201-bjnbocf","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"IM 数据量很大的情况下，先拉旧数据还是新数据，有什么区别，先拉新数据如果上面旧数据有丢失怎么办"}]},{"ID":"20260913224201-bzxutne","Type":"NodeParagraph","Properties":{"id":"20260913224201-bzxutne","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"工业级 IM 同步里\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"从数据正确性的角度，通常先拉旧数据\n从用户体验的角度，可以优先展示最先数据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n因为 IM 的核心不是把最新几条消息先显示出来，而是要保证整个消息链条 不丢、不重、不乱序\n并且在断线重连、换设备登录、本地数据异常时还能恢复一致"}]},{"ID":"20260913224201-mgs4cxd","Type":"NodeParagraph","Properties":{"id":"20260913224201-mgs4cxd","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"所谓先拉旧数据，本质上是先基于断点或服务端游标补齐历史缺口，再去追最新增量\n这样做的好处是可以先验证消息序列是否连续\n比如 seq 是否有缺口、是否存在重复、撤回编辑等状态是否完整回放\n一旦同步链路先闭合，再接最新消息，整个系统的一致性会更强，这也是“工业级”更看重的点"}]},{"ID":"20260913224201-o676e0m","Type":"NodeParagraph","Properties":{"id":"20260913224201-o676e0m","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"如果一上来先拉新数据，虽然首屏体验会更快，用户能先看到最近消息\n但风险是：中间数据如果已经丢了，最新消息会把这个问题暂时掩盖掉\n后面再回头补历史时，就会面临缺口检测、乱序合并、幂等去重、状态回放更复杂的问题\n所以先拉新更像是产品体验优化策略，不是最稳的数据同步策略"}]},{"ID":"20260913224201-eb03uhr","Type":"NodeParagraph","Properties":{"id":"20260913224201-eb03uhr","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"工业级方案在同步层一般先旧后新，先补齐历史、校验连续性，再追最新增量\n而在展示层可以先用本地缓存或局部最新数据提升响应速度"}]},{"ID":"20260913224201-evejy3c","Type":"NodeParagraph","Properties":{"id":"20260913224201-evejy3c","updated":"20260913224201"},"Children":[{"Type":"NodeText","Data":"这样既保证了数据一致性，又兼顾了用户体验"}]}]}