d-warning-color));\"}"},{"Type":"NodeText","Data":"\n但不会马上给真正的物理内存，而是用到的时候才分配，也就是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"写时复制"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907145439-ebeydwj","Type":"NodeParagraph","Properties":{"id":"20260907145439-ebeydwj","updated":"20260907145439"},"Children":[{"Type":"NodeText","Data":"内存用完调用 delete 或 free 时，内存也不是立刻还给操作系统\n而是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"先还给 C 库的内存池"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，方便下次继续复用，减少系统调用开销\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只有当空闲内存比较多的时候，库才会把多余的内存释放回系统"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907145758-exdov5f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907145758-exdov5f","updated":"20260907150112"},"Children":[{"Type":"NodeText","Data":"new 和 malloc\t\t\t"}]},{"ID":"20260907145758-kx3dxq7","Type":"NodeParagraph","Properties":{"id":"20260907145758-kx3dxq7","updated":"20260907145758"},"Children":[{"Type":"NodeText","Data":"new 和 delete 是 C++ 关键字 / 运算符\t\tmalloc 和 free 是 C 标准库函数\nnew 和 malloc 都在堆区分配内存，但 "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 会调用构造函数进行初始化，并在分配失败时抛出异常"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"malloc 不调用构造函数，需要手动初始化，并在分配失败时返回 NULL"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 会自动识别类型，malloc 不自动识别返回 void*"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907145758-mi9nsvi","Type":"NodeParagraph","Properties":{"id":"20260907145758-mi9nsvi","updated":"20260907145758"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"不是自己运行时识别类型，而是编译器根据你写死的类型\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"在编译期决定内存大小、构造函数和返回指针类型，运行时只是按这个结果去分配和构造对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907145758-e9tzc2o","Type":"NodeParagraph","Properties":{"id":"20260907145758-e9tzc2o","updated":"20260907145758"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 可以重载，malloc 不能重载\ndelete 会调析构，free 不调析构"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907150112-24kq7w3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907150112-24kq7w3","updated":"20260907151307"},"Children":[{"Type":"NodeText","Data":"new 的底层执行流程是什么？\t\t"}]},{"ID":"20260907150112-ls4ni5w","Type":"NodeParagraph","Properties":{"id":"20260907150112-ls4ni5w","updated":"20260907150112"},"Children":[{"Type":"NodeText","Data":"new 内存分配底层函数"}]},{"ID":"20260907150112-5xya33s","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260907150112-5xya33s","updated":"20260907150112"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 全局 operator new \nvoid* operator new(size_t size) {\n    // 底层：最终调用 malloc 分配内存\n    void* p = malloc(size);\n    // 分配失败：抛出 bad_alloc 异常\n    if (p == nullptr) throw bad_alloc();\n    return p;\n}\n\n// 第一步：调用operator new，分配原始内存，只传sizeof(A)字节，不知道A是什么\nvoid* raw = operator new(sizeof(A));\n// 第二步！编译器自动插入：在raw这块内存上调用A的构造函数\nA* ptr = new(raw) A; // 定位new，执行构造\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260907150112-lp0om0v","Type":"NodeParagraph","Properties":{"id":"20260907150112-lp0om0v","updated":"20260907150112"},"Children":[{"Type":"NodeText","Data":"计算所需内存大小，先调用 operator new () 去堆上申请内存底层，其实就是用 malloc 去拿空间，只是封装了一层。\n内存拿到后，自动调用构造函数初始化对象，最后返回正确类型的指针"}]},{"ID":"20260907151307-v27hpo6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907151307-v27hpo6","updated":"20260907151635"},"Children":[{"Type":"NodeText","Data":"malloc 怎么分配内存的\t"}]},{"ID":"20260907151307-r3izkyd","Type":"NodeParagraph","Properties":{"id":"20260907151307-r3izkyd","updated":"20260907151307"},"Children":[{"Type":"NodeText","Data":"malloc 是 C 库提供的堆内存分配函数，底层由 glibc 的 ptmalloc 管理\n它"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"内部维护空闲链表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"优先在已有堆空间"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"中寻找合适的空闲块分配\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"小内存通过 brk/sbrk 扩展堆顶，大内存则用 mmap 映射匿名页"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n分配时会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"记录块大小等元信息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，方便 free 回收"}]},{"ID":"20260907151307-0k8x2f0","Type":"NodeParagraph","Properties":{"id":"20260907151307-0k8x2f0","updated":"20260907151307"},"Children":[{"Type":"NodeText","Data":"free 一般只是将内存标记为空闲并放回链表，不会立即归还操作系统，只有堆尾连续空闲时才可能收缩\nmmap 分配的内存可直接 munmap 释放"}]},{"ID":"20260907151307-cp9maw5","Type":"NodeParagraph","Properties":{"id":"20260907151307-cp9maw5","updated":"20260907151307"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"mmap 之所以比 brk 慢，主要是因为 mmap 每次分配都要执行系统调用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n进入内核态去建立虚拟内存映射、分配物理页，还要处理页表，开销本身就比较大\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"而 brk 只是简单移动堆顶指针，只在堆空间不够时才调用一次，后续小内存分配都在用户态通过内存池复用，不需要频繁进内核"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n另外，mmap 分配的内存释放时会直接归还给系统，频繁创建销毁会产生大量缺页异常和系统调用开销，所以比 brk 这种批量管理堆内存的方式效率更低"}]},{"ID":"20260907151635-ojg1ven","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907151635-ojg1ven","updated":"20260907153110"},"Children":[{"Type":"NodeText","Data":"delete 和 detele[]的区别"}]},{"ID":"20260907151635-j0o7o7w","Type":"NodeParagraph","Properties":{"id":"20260907151635-j0o7o7w","updated":"20260907151635"},"Children":[{"Type":"NodeText","Data":"delete 和 delete[] 的区别，核心在于它们释放的对象类型不一样\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"delete 用来释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"单个对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"，delete[] 用来释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"动态数组"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907151635-t0kdiwj","Type":"NodeParagraph","Properties":{"id":"20260907151635-t0kdiwj","updated":"20260907151635"},"Children":[{"Type":"NodeText","Data":"比如你如果是 new T 出来的，就必须用 delete\n如果是 new T[n] 出来的，就必须用 delete[]"}]},{"ID":"20260907151635-3merd4r","Type":"NodeParagraph","Properties":{"id":"20260907151635-3merd4r","updated":"20260907151635"},"Children":[{"Type":"NodeText","Data":"因为数组释放时，不只是回收内存，还要对数组里的每个元素逐个调用析构函数\n所以编译器需要知道这是“数组形式”的释放"}]},{"ID":"20260907151635-y77o6yv","Type":"NodeParagraph","Properties":{"id":"20260907151635-y77o6yv","updated":"20260907151635"},"Children":[{"Type":"NodeText","Data":"如果混用，比如 new[] 却用 delete，或者 new 却用 delete[]，结果就是未定义行为\n轻则析构不完整，重则内存破坏、程序崩溃"}]},{"ID":"20260907153110-o63f8nj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907153110-o63f8nj","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"可以通过给函数加 const 实现重载吗"}]},{"ID":"20260907153110-nmp3eeh","Type":"NodeParagraph","Properties":{"id":"20260907153110-nmp3eeh","updated":"20260907153110"},"Children":[{"Type":"NodeText","Data":"可以，但要分情况"}]},{"ID":"20260907153110-6wv9ut9","Type":"NodeParagraph","Properties":{"id":"20260907153110-6wv9ut9","updated":"20260907153110"},"Children":[{"Type":"NodeText","Data":"如果只是普通函数参数写成 int 和 const int，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不能"},{"Type":"NodeText","Data":"构成重载\n因为按值传递时顶层 const 不算函数签名的一部分\n比如 void f(int) 和 void f(const int) 是一样的"}]},{"ID":"20260907153110-vxaag0q","Type":"NodeParagraph","Properties":{"id":"20260907153110-vxaag0q","updated":"20260907153110"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"但如果 const 作用在引用、指针指向对象，或者成员函数后面，那就"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"可以"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"参与重载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n比如 void f(int\u0026) 和 void f(const int\u0026) 可以重载\n类里的 void func() 和 void func() const 也可以重载\n因为后者表示这个成员函数不会修改对象，二者对应的是不同的函数签名"}]},{"ID":"20260907153639-t186jqo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907153639-t186jqo","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"static 关键字的作用"}]},{"ID":"20260907153639-cux8ytz","Type":"NodeParagraph","Properties":{"id":"20260907153639-cux8ytz","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"修饰局部变量时，会把变量的存储位置从栈区改为静态区"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n让它只初始化一次，生命周期延长到整个程序结束，并且保留上一次的值"}]},{"ID":"20260907153639-n6cl4s7","Type":"NodeParagraph","Properties":{"id":"20260907153639-n6cl4s7","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"修饰全局变量或函数时，会限制它们的作用域仅在当前文件内"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n避免不同文件之间同名冲突，实现文件私有化"}]},{"ID":"20260907153639-f0455zw","Type":"NodeParagraph","Properties":{"id":"20260907153639-f0455zw","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"修饰类的成员变量和成员函数时，让它们属于整个类而非某个对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n可以不创建对象直接访问\n所有对象共享同一份静态成员，且静态函数不能访问非静态成员"}]},{"ID":"20260907153639-r8zn156","Type":"NodeParagraph","Properties":{"id":"20260907153639-r8zn156","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"函数中变量使用 static 的作用"}]},{"ID":"20260907153639-7fhyg1s","Type":"NodeParagraph","Properties":{"id":"20260907153639-7fhyg1s","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"延长生命周期"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\nstatic 局部变量，程序整个运行期间都存在，不会随函数调用结束销毁"}]},{"ID":"20260907153639-zt67mtr","Type":"NodeParagraph","Properties":{"id":"20260907153639-zt67mtr","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"只初始化一次\n首次进函数初始化，后续重复调用直接"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"沿用上次的值，保留状态"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907153639-8x5xxhx","Type":"NodeParagraph","Properties":{"id":"20260907153639-8x5xxhx","updated":"20260907153639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"作用域不变"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n仍然只能在当前函数内使用，外部无法访问\n节省开销，适合需要记录累计计数、保留上次运算结果的场景"}]},{"ID":"20260907153639-t3h96m7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907153639-t3h96m7","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"static 是线程安全的吗"}]},{"ID":"20260907153639-yktc2ig","Type":"NodeParagraph","Properties":{"id":"20260907153639-yktc2ig","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"全局 static、类静态成员 static：\n多线程同时读写会有数据竞争，不加锁、不用 atomic 就会出错"}]},{"ID":"20260907153639-69x1x6a","Type":"NodeParagraph","Properties":{"id":"20260907153639-69x1x6a","updated":"20260907153639"},"Children":[{"Type":"NodeText","Data":"最特殊的是函"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"数局部 static"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\nC++11 后编译器自动加了线程初始化保护，只保证初始化一次是线程安全\n但后续多线程读写依然不安全"}]},{"ID":"20260907151310-yu1op6x","Type":"NodeParagraph","Properties":{"id":"20260907151310-yu1op6x","updated":"20260907151310"}},{"ID":"20260907151310-mbu3qgt","Type":"NodeParagraph","Properties":{"id":"20260907151310-mbu3qgt","updated":"20260907151310"}},{"ID":"20260907151310-d8tfl12","Type":"NodeParagraph","Properti