: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n合并多个目标文件、链接库文件，解决函数地址引用，最终生成 可执行文件"}]},{"ID":"20260907142508-8lpibss","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907142508-8lpibss","updated":"20260907143413"},"Children":[{"Type":"NodeText","Data":"内存不足的原因及应对策略\t\t\u003e"}]},{"ID":"20260907142508-2qg0vyz","Type":"NodeParagraph","Properties":{"id":"20260907142508-2qg0vyz","updated":"20260907142508"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原因"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"内存泄漏，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"申请的内存没释放，越用越多\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"一次性加载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"过大数据，比如大文件、大集合直接全载入内存\n还有"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"并发请求太多"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，线程、缓存过多占用资源，以及内存碎片导致无法分配连续空间"}]},{"ID":"20260907142508-iq4lrn9","Type":"NodeParagraph","Properties":{"id":"20260907142508-iq4lrn9","updated":"20260907142508"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"应对策略"},{"Type":"NodeText","Data":"\n先用工具定位泄漏并及时释放内存\n对大数据采用分页、流式处理，避免一次性加载\n控制并发和缓存大小，复用对象减少碎片\n压力大时再配合限流、扩容，从架构上分担内存压力"}]},{"ID":"20260907143413-tofa7nw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907143413-tofa7nw","updated":"20260907143824"},"Children":[{"Type":"NodeText","Data":"C++ 中指针和引用的区别"}]},{"ID":"20260907143413-1nnhhs8","Type":"NodeParagraph","Properties":{"id":"20260907143413-1nnhhs8","updated":"20260907143413"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"指针是存放变量地址的变量"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，支持空值、可重新指向、能做指针运算和多级间接访问\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"引用是变量的别名"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，必须初始化绑定对象，不能为空且不可更换指向，用法更简洁安全"}]},{"ID":"20260907143413-codglhl","Type":"NodeParagraph","Properties":{"id":"20260907143413-codglhl","updated":"20260907143413"},"Children":[{"Type":"NodeText","Data":"日常开发中，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"函数传参、避免拷贝、确定对象一定存在时优先用引用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n需要表示"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"空值、动态切换指向、管理堆内存、实现链表树等数据结构"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n或是和 C 代码交互时，再使用指针"}]},{"ID":"20260907143824-lcinwbg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907143824-lcinwbg","updated":"20260907144325"},"Children":[{"Type":"NodeText","Data":"虚拟内存地址和编译器有什么关系？"}]},{"ID":"20260907143824-7qrbz53","Type":"NodeParagraph","Properties":{"id":"20260907143824-7qrbz53","updated":"20260907143824"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"编译器在编译、链接时，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"并不使用真实物理地址，而是直接使用虚拟地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n它会按照操作系统规定的虚拟地址空间布局\n给代码段、数据段、栈、全局变量等分配相对的虚拟地址\n链接时完成符号解析和重定位，最终生成的可执行文件里全是虚拟地址\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"程序加载运行时，再由操作系统通过 MMU 和页表，把这些虚拟地址映射到真实物理内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144325-u46zdct","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907144325-u46zdct","updated":"20260907144434"},"Children":[{"Type":"NodeText","Data":"在 C++ 中创建一个类，在一开始类中有些什么\t"}]},{"ID":"20260907144325-30ro1b0","Type":"NodeParagraph","Properties":{"id":"20260907144325-30ro1b0","updated":"20260907144325"},"Children":[{"Type":"NodeText","Data":"默认有 private、public、protected 访问权限，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"默认是 private"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n编译器会自动生成四个默认成员函数：默认构造、析构函数、拷贝构造、赋值运算符重载\n除此之外没有成员变量和成员函数，需要自己手动添加"}]},{"ID":"20260907144325-55povs9","Type":"NodeParagraph","Properties":{"id":"20260907144325-55povs9","updated":"20260907144325"},"Children":[{"Type":"NodeText","Data":"构造函数：\nC++98 是 4 个\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"C++11 后是 6 个：默认构造、析构函数、拷贝构造、赋值运算符重载，移动构造函数和移动赋值运算符"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144325-c4144g9","Type":"NodeParagraph","Properties":{"id":"20260907144325-c4144g9","updated":"20260907144325"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"C++ 中空类大小为 1 字节，用于保证对象有唯一内存地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n类对象所占内存"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只与非静态成员变量相关"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，会按内存对齐规则计算大小，成员函数\n静态成员变量不占用对象内存，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"若含虚函数则会额外给对象增加一个虚表指针大小"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144434-zolcb6z","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907144434-zolcb6z","updated":"20260907144703"},"Children":[{"Type":"NodeText","Data":"sizeof(1==1) 在 C 和 C++ 中分别是什么结果？"}]},{"ID":"20260907144434-pbm4tuk","Type":"NodeParagraph","Properties":{"id":"20260907144434-pbm4tuk","updated":"20260907144434"},"Children":[{"Type":"NodeText","Data":"在 C 语言中，1= =1 是关系表达式，其结果为整数类型，真用 1 表示、假用 0 表示，因此表达式的值类型是 int\n在常见平台下 int 占 4 个字节，所以 sizeof(1= =1) 的结果是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":" 4"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144434-3v3pssy","Type":"NodeParagraph","Properties":{"id":"20260907144434-3v3pssy","updated":"20260907144434"},"Children":[{"Type":"NodeText","Data":"在 C++ 中，关系表达式的结果是真正的布尔类型 bool\ntrue 和 false 都是该类型的值。而 bool 类型的大小固定为 1 字节，因此 sizeof(1==1) 的结果是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":" 1"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144703-jxony69","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907144703-jxony69","updated":"20260907145439"},"Children":[{"Type":"NodeText","Data":"i++=1，++i= 1 哪—句对"}]},{"ID":"20260907144703-p7m1iku","Type":"NodeParagraph","Properties":{"id":"20260907144703-p7m1iku","updated":"20260907144703"},"Children":[{"Type":"NodeText","Data":"++i=1 是对的"}]},{"ID":"20260907144703-jitivms","Type":"NodeParagraph","Properties":{"id":"20260907144703-jitivms","updated":"20260907144703"},"Children":[{"Type":"NodeText","Data":"++i 是前置自增，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"返回的是左值"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"所以可以放在赋值号的左边\ni++ 是先返回 i 的旧值再给 i 加 1，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"返回的是临时副本，属于右值"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907144703-ty6rhup","Type":"NodeParagraph","Properties":{"id":"20260907144703-ty6rhup","updated":"20260907144703"},"Children":[{"Type":"NodeText","Data":"前置自增 ++i 效率通常比后置自增 i++ 高\n因为后置自增需要额外保存旧值，产生临时对象"}]},{"ID":"20260907144703-vg63s00","Type":"NodeParagraph","Properties":{"id":"20260907144703-vg63s00","updated":"20260907144703"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"在 C++ 中，后置自增可以重载为返回左值，但这不符合语言规范和使用习惯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260907145439-zw2fr4r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907145439-zw2fr4r","updated":"20260907145758"},"Children":[{"Type":"NodeText","Data":"内存分配流程"}]},{"ID":"20260907145439-m47cz8n","Type":"NodeParagraph","Properties":{"id":"20260907145439-m47cz8n","updated":"20260907145439"},"Children":[{"Type":"NodeText","Data":"new 或者 malloc 申请内存时\n并