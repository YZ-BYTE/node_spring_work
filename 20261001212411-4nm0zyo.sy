置零、螺旋矩阵、旋转图像、搜索二维矩阵 II"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"7"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"链表"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"14"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"相交链表 ~ LRU 缓存"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"8"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"二叉树"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"15"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中序遍历 ~ 二叉树中的最大路径和"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"9"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"图论"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"4"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"岛屿数量、腐烂的橘子、课程表、实现 Trie"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"10"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"回溯"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"8"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"全排列、子集、电话号码的字母组合、组合总和、括号生成、单词搜索、分割回文串、N 皇后"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"11"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"二分查找"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"6"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"搜索插入位置 ~ 寻找两个正序数组的中位数"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"12"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"栈"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"有效的括号、最小栈、字符串解码、每日温度、柱状图中最大的矩形"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"13"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"堆"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数组中的第K个最大元素、前 K 个高频元素、数据流的中位数"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"14"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"贪心算法"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"4"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"买卖股票的最佳时机、跳跃游戏、跳跃游戏 II、划分字母区间"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"15"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"动态规划"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"10"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"爬楼梯 ~ 最长有效括号"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"16"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多维动态规划"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不同路径、最小路径和、最长回文子串、最长公共子序列、编辑距离"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"17"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"技巧"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只出现一次的数字、多数元素、颜色分类、下一个排列、寻找重复数"}]}]}]},{"ID":"20261001212411-6w6h7dm","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-6w6h7dm","updated":"20261001212411"}},{"ID":"20261001212411-8qhx1fz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-8qhx1fz","updated":"20261002154331"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"一、哈希（3 题）"}]},{"ID":"20261001212411-w8w132n","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-w8w132n","updated":"20261002154331"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1. 两数之和（简单 · No.1）"}]},{"ID":"20261001212411-bit4aib","Type":"NodeParagraph","Properties":{"id":"20261001212411-bit4aib","updated":"20261002154331"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"​ 和目标值 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"​，在数组中找出"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和等于"},{"Type":"NodeText","Data":" ​"},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"​ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"的两个数"},{"Type":"NodeText","Data":"，返回它们的下标。同一个元素不能使用两次，答案唯一。\n示例：​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [2,7,11,15]"},{"Type":"NodeText","Data":"​,​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target = 9"},{"Type":"NodeText","Data":"​ → ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,1]"},{"Type":"NodeText","Data":"​（2 + 7 = 9）。"}]},{"ID":"20261001212411-gw8d1n4","Type":"NodeParagraph","Properties":{"id":"20261001212411-gw8d1n4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：用哈希表记录「元素值 → 下标」，一次遍历中对每个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i]"},{"Type":"NodeText","Data":" 先查表里有没有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target - nums[i]"},{"Type":"NodeText","Data":"，有就直接返回两个下标，没有就把当前值塞进表里继续往后走，整体时间复杂度 O(n)，空间 O(n)。"}]},{"ID":"20261001212411-09aghpk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-09aghpk","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e twoSum(vector\u003cint\u003e\u0026 nums, int target) {\n        unordered_map\u003cint, int\u003e pos; // 哈希表：记录「已经扫过的数值 -\u003e 它的下标」，实现 O(1) 查找\n        for (int i = 0; i \u003c nums.size(); ++i) {\n            // 当前数是 nums[i]，它需要的「搭档」就是 target - nums[i]\n            auto it = pos.find(target - nums[i]);\n            if (it != pos.end()) return {it-\u003esecond, i}; // 搭档之前出现过，直接返回两个下标\n            pos[nums[i]] = i; // 暂时没搭档，就把自己登记进去，留给后面的数来匹配\n        }\n        return {}; // 题目保证有解，这里只是形式上的兜底\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-973eaij","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-973eaij","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2. 字母异位词分组（中等 · No.49）"}]},{"ID":"20261001212411-pajp9hr","Type":"NodeParagraph","Properties":{"id":"20261001212411-pajp9hr","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"strs"},{"Type":"NodeText","Data":"，把其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互为字母异位词"},{"Type":"NodeText","Data":"（字母组成完全相同、只是排列顺序不同）的字符串分到同一组，返回分组结果，组的顺序与组内顺序不限。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[\"eat\",\"tea\",\"tan\",\"ate\",\"nat\",\"bat\"]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[\"eat\",\"tea\",\"ate\"],[\"tan\",\"nat\"],[\"bat\"]]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-tnkzyrz","Type":"NodeParagraph","Properties":{"id":"20261001212411-tnkzyrz","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：把每个单词按字符排序后的结果作为「异位词」的统一签名，用哈希表把签名相同的单词分到一组；排序签名 O(m log m)，总复杂度 O(n · m log m)，其中 m 为单词长度。"}]},{"ID":"20261001212411-uzkavn6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-uzkavn6","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cvector\u003cstring\u003e\u003e groupAnagrams(vector\u003cstring\u003e\u0026 strs) {\n        unordered_map\u003cstring, vector\u003cstring\u003e\u003e groups; // 签名 -\u003e 该组的所有单词\n        for (auto\u0026 s : strs) {\n            string key = s;\n            sort(key.begin(), key.end()); // 异位词排序后完全一样，正好当「统一签名」\n            groups[key].push_back(s);     // 签名相同就自动落到同一组\n        }\n        vector\u003cvector\u003cstring\u003e\u003e ans;\n        for (auto\u0026 kv : groups)\n            ans.push_back(move(kv.second)); // 把每组单词搬运进答案，move 避免额外拷贝\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-9725qcf","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-9725qcf","updated":"20261002162958"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3. 最长连续序列（中等 · No.128）"}]},{"ID":"20261001212411-lag90xg","Type":"NodeParagraph","Properties":{"id":"20261001212411-lag90xg","updated":"20261002162958"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定未排序的整数数组 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"​，找出其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数字连续的最长序列的长度"},{"Type":"NodeText","Data":"。序列不要求在原数组中下标连续，只要求数值上是连续的整数。要求算法时间复杂度 O(n)。\n示例：​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[100,4,200,1,3,2]"},{"Type":"NodeText","Data":"​ → 4（连续序列 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1,2,3,4"},{"Type":"NodeText","Data":"​）。"}]},{"ID":"20261001212411-z2thj95","Type":"NodeParagraph","Properties":{"id":"20261001212411-z2thj95","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先把所有数放进集合，然后只从「序列起点」（即 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"num-1"},{"Type":"NodeText","Data":" 不在集合里的数）开始向后扩展计数，这样每个元素至多被访问两次，避免了排序，整体时间 O(n)。"}]},{"ID":"20261001212411-jsdg92y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-jsdg92y","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int longestConsecutive(vector\u003cint\u003e\u0026 nums) {\n        unordered_set\u003cint\u003e st(nums.begin(), nums.end()); // 去重 + O(1) 判断某数是否存在\n        int ans = 0;\n        for (int x : st) {\n            if (st.count(x - 1)) continue; // x 前面还有数，说明它不是一段连续数的开头，跳过（防止重复扫描）\n            int cur = x;                     // 确认 x 是「起点」，从这里开始往后数\n            while (st.count(cur + 1)) ++cur; // 一直往后，直到遇到断点\n            ans = max(ans, cur - x + 1);     // 这一段连续序列的长度\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-bseulvn","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-bseulvn","updated":"20261001212411"}},{"ID":"20261001212411-ju24iix","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-ju24iix","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"二、双指针（4 题）"}]},{"ID":"20261001212411-vpbmqmw","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-vpbmqmw","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4. 移动零（简单 · No.283）"}]},{"ID":"20261001212411-2hvp9a7","Type":"NodeParagraph","Properties":{"id":"20261001212411-2hvp9a7","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，把所有的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0"},{"Type":"NodeText","Data":" 移动到数组末尾，同时"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保持非零元素的相对顺序"},{"Type":"NodeText","Data":"。必须原地操作，不能复制整个数组。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,1,0,3,12]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[1,3,12,0,0]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-or1sfoo","Type":"NodeParagraph","Properties":{"id":"20261001212411-or1sfoo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：双指针，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 指向当前非零元素应放置的位置，遍历时把所有非零数按相对顺序交换到前面，最后把尾部剩余位置全部填 0，一次遍历 O(n)、O(1) 空间且保持相对顺序。"}]},{"ID":"20261001212411-q0zb2kc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-q0zb2kc","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void moveZeroes(vector\u003cint\u003e\u0026 nums) {\n        int i = 0; // i 始终指向「下一个非零数应该放的位置」\n        for (int j = 0; j \u003c nums.size(); ++j)\n            if (nums[j] != 0) swap(nums[i++], nums[j]); // 遇到非零数就把它换到 i 处，i 再后移\n        // 循环结束时，非零数都被按原顺序挤到了前面，后面的坑自然全是 0\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ksx1jln","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ksx1jln","updated":"20261002164038"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5. 盛最多水的容器（中等 · No.11）"}]},{"ID":"20261001212411-6q7gpun","Type":"NodeParagraph","Properties":{"id":"20261001212411-6q7gpun","updated":"20261002164038"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定长度 n 的整数数组 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"height"},{"Type":"NodeText","Data":"​，代表 n 条竖线的高度（第 i 条线的两端点是 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(i,0)"},{"Type":"NodeText","Data":"​ 和 ​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(i,height[i])"},{"Type":"NodeText","Data":"​）。找出其中两条线，使它们与 x 轴围成的容器能装最多的水，返回最大储水量。\n示例：​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[1,8,6,2,5,4,8,3,7]"},{"Type":"NodeText","Data":"​ → 49。"}]},{"ID":"20261001212411-xr7m3eu","Type":"NodeParagraph","Properties":{"id":"20261001212411-xr7m3eu","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：左右指针夹逼，容量由短板决定，每次移动较短的那一边——因为移动长板容量只可能变小，移动短板才有可能遇到更高的板从而更新答案，直到两指针相遇，O(n)。"}]},{"ID":"20261001212411-gcuon8b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-gcuon8b","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int maxArea(vector\u003cint\u003e\u0026 height) {\n        int l = 0, r = height.size() - 1, ans = 0;\n        while (l \u003c r) {\n            // 面积 = 较矮那条边的高度 × 两边的距离\n            ans = max(ans, min(height[l], height[r]) * (r - l));\n            // 移动较矮的一边：移动高的那一边只会让面积更小（宽度变小、高度还被矮的卡住）\n            if (height[l] \u003c height[r]) ++l;\n            else --r;\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-egswni1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-egswni1","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"6. 三数之和（中等 · No.15）"}]},{"ID":"20261001212411-08o44y2","Type":"NodeParagraph","Properties":{"id":"20261001212411-08o44y2","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，找出所有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和为 0 且互不相同"},{"Type":"NodeText","Data":"的三元组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[nums[i], nums[j], nums[k]]"},{"Type":"NodeText","Data":"（i、j、k 两两不同）。答案中不能包含重复的三元组。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[-1,0,1,2,-1,-4]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[-1,-1,2],[-1,0,1]]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-19yr9ao","Type":"NodeParagraph","Properties":{"id":"20261001212411-19yr9ao","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先排序，固定最左的数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i]"},{"Type":"NodeText","Data":"，对右侧区间用左右双指针找两数之和等于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"-nums[i]"},{"Type":"NodeText","Data":" 的组合；找到答案时左右指针同时收缩并跳过重复值，若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i] \u0026gt; 0"},{"Type":"NodeText","Data":" 可直接提前结束，整体 O(n²) 并天然去重。"}]},{"ID":"20261001212411-77hei05","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-77hei05","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cvector\u003cint\u003e\u003e threeSum(vector\u003cint\u003e\u0026 nums) {\n        sort(nums.begin(), nums.end()); // 先排序，后面才能用双指针 + 方便去重\n        vector\u003cvector\u003cint\u003e\u003e ans;\n        int n = nums.size();\n        for (int i = 0; i \u003c n; ++i) { // 固定三元组里最小的那个数 nums[i]\n            if (nums[i] \u003e 0) break;   // 最小的数都 \u003e 0，后面不可能再凑出和为 0\n            if (i \u003e 0 \u0026\u0026 nums[i] == nums[i - 1]) continue; // 跳过重复的 nums[i]，避免答案重复\n            int l = i + 1, r = n - 1; // 在 i 右边用左右指针找两数之和 = -nums[i]\n            while (l \u003c r) {\n                long long sum = (long long)nums[i] + nums[l] + nums[r]; // 用 long long 防止相加溢出\n                if (sum \u003c 0) ++l;       // 和太小，左指针右移让数变大\n                else if (sum \u003e 0) --r;  // 和太大，右指针左移让数变小\n                else {\n                    ans.push_back({nums[i], nums[l], nums[r]}); // 找到一组答案\n                    while (l \u003c r \u0026\u0026 nums[l] == nums[l + 1]) ++l; // 跳过重复的左值\n                    while (l \u003c r \u0026\u0026 nums[r] == nums[r - 1]) --r; // 跳过重复的右值\n                    ++l; --r; // 两侧同时向内收缩，继续找\n                }\n            }\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-5waiatt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-5waiatt","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"7. 接雨水（困难 · No.42）"}]},{"ID":"20261001212411-ivgw7ig","Type":"NodeParagraph","Properties":{"id":"20261001212411-ivgw7ig","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定 n 个非负整数表示宽度均为 1 的柱子高度，计算按此排列后下雨时柱子之间能接住多少单位的雨水。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,1,0,2,1,0,1,3,2,1,2,1]"},{"Type":"NodeText","Data":" → 6。"}]},{"ID":"20261001212411-0xspmn3","Type":"NodeParagraph","Properties":{"id":"20261001212411-0xspmn3","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：双指针维护 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"leftMax"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"rightMax"},{"Type":"NodeText","Data":"，较矮的一侧当前柱子能接的水就由该侧最大高度决定（另一侧必然 ≥ 它），于是矮的一侧指针内移并结算雨水，直到相遇，O(n) 时间、O(1) 空间。"}]},{"ID":"20261001212411-fue9tei","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-fue9tei","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int trap(vector\u003cint\u003e\u0026 height) {\n        int l = 0, r = height.size() - 1;\n        int leftMax = 0, rightMax = 0, ans = 0;\n        while (l \u003c r) {\n            leftMax = max(leftMax, height[l]);   // 左边到目前为止的最高柱子\n            rightMax = max(rightMax, height[r]); // 右边到目前为止的最高柱子\n            // 谁的柱子矮，谁那侧的水位就由自己这侧的最高柱子决定（另一侧一定更高，挡得住）\n            if (height[l] \u003c height[r]) ans += leftMax - height[l++];\n            else ans += rightMax - height[r--];\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-2zexu1b","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-2zexu1b","updated":"20261001212411"}},{"ID":"20261001212411-jln3z79","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-jln3z79","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"三、滑动窗口（2 题）"}]},{"ID":"20261001212411-cxddbfl","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-cxddbfl","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8. 无重复字符的最长子串（中等 · No.3）"}]},{"ID":"20261001212411-3lfv7fy","Type":"NodeParagraph","Properties":{"id":"20261001212411-3lfv7fy","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":"，找出其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不含重复字符的最长子串"},{"Type":"NodeText","Data":"的长度（子串必须连续）。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"abcabcbb\""},{"Type":"NodeText","Data":" → 3（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"abc\""},{"Type":"NodeText","Data":"）；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"bbbbb\""},{"Type":"NodeText","Data":" → 1。"}]},{"ID":"20261001212411-r27in7h","Type":"NodeParagraph","Properties":{"id":"20261001212411-r27in7h","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：右指针不断扩窗口，用哈希表记录每个字符最后出现的位置，一旦发现重复就把左指针直接跳到「上次出现位置 + 1」处（只右移不回退），全程维护以 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"r"},{"Type":"NodeText","Data":" 结尾的最长无重复窗口，O(n)。"}]},{"ID":"20261001212411-3gkz55g","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-3gkz55g","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int lengthOfLongestSubstring(string s) {\n        unordered_map\u003cchar, int\u003e last; // 记录每个字符「上一次出现」的下标\n        int l = 0, ans = 0;            // 窗口为 [l, r]\n        for (int r = 0; r \u003c s.size(); ++r) {\n            // 如果 s[r] 之前出现过，且那次出现还在当前窗口内，就把窗口左边界跳过去\n            if (last.count(s[r]) \u0026\u0026 last[s[r]] \u003e= l)\n                l = last[s[r]] + 1;\n            last[s[r]] = r;              // 更新该字符最新出现的下标\n            ans = max(ans, r - l + 1);   // 当前窗口长度就是一个候选答案\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-wgoqp95","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-wgoqp95","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"9. 找到字符串中所有字母异位词（中等 · No.438）"}]},{"ID":"20261001212411-v6n9i10","Type":"NodeParagraph","Properties":{"id":"20261001212411-v6n9i10","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":"，找出 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 中所有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":" 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"字母异位词"},{"Type":"NodeText","Data":"的起始下标，答案顺序不限。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s = \"cbaebabacd\""},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p = \"abc\""},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,6]"},{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"cba\""},{"Type":"NodeText","Data":" 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"bac\""},{"Type":"NodeText","Data":"）。"}]},{"ID":"20261001212411-05yxusz","Type":"NodeParagraph","Properties":{"id":"20261001212411-05yxusz","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：固定长度等于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":" 的滑动窗口，用长度 26 的数组统计窗口内字母频次，与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":" 的频次逐个比较，窗口滑动时增量更新，窗口长度达到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":" 后每次比较一次，O(n)（比较 26 个字母可视为常数）。"}]},{"ID":"20261001212411-zodgho9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-zodgho9","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e findAnagrams(string s, string p) {\n        vector\u003cint\u003e ans;\n        int n = s.size(), m = p.size();\n        if (n \u003c m) return ans; // s 比 p 还短，不可能有异位词\n        vector\u003cint\u003e need(26, 0), win(26, 0); // need：p 的字母频次；win：当前窗口的字母频次\n        for (char c : p) ++need[c - 'a'];\n        for (int r = 0; r \u003c n; ++r) {\n            ++win[s[r] - 'a'];                    // 右端进窗口\n            if (r \u003e= m) --win[s[r - m] - 'a'];    // 窗口超长，左端出窗口，维持长度恰好为 m\n            if (r \u003e= m - 1 \u0026\u0026 win == need)        // 窗口长度够了，且频次完全一致\n                ans.push_back(r - m + 1);         // 记录这个窗口的起点\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-1xdsl3v","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-1xdsl3v","updated":"20261001212411"}},{"ID":"20261001212411-v38dbwg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-v38dbwg","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"四、子串（3 题）"}]},{"ID":"20261001212411-f1vjrnr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-f1vjrnr","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"10. 和为 K 的子数组（中等 · No.560）"}]},{"ID":"20261001212411-oqz2x8d","Type":"NodeParagraph","Properties":{"id":"20261001212411-oqz2x8d","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"，统计并返回"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和恰好为 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"k"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 的连续子数组的个数"},{"Type":"NodeText","Data":"（数组元素可能为负数）。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [1,1,1]"},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k = 2"},{"Type":"NodeText","Data":" → 2。"}]},{"ID":"20261001212411-gahk2og","Type":"NodeParagraph","Properties":{"id":"20261001212411-gahk2og","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：前缀和 + 哈希表，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prefix[j] - prefix[i] == k"},{"Type":"NodeText","Data":" 说明 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i+1..j"},{"Type":"NodeText","Data":" 这段和为 k，因此遍历时对每个前缀和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur"},{"Type":"NodeText","Data":" 累加哈希表里 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur - k"},{"Type":"NodeText","Data":" 出现的次数即为答案，注意要先查表再插入，且哈希表初始要有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"{0: 1}"},{"Type":"NodeText","Data":" 以统计从头开始的子数组，O(n)。"}]},{"ID":"20261001212411-tfqjn1t","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-tfqjn1t","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int subarraySum(vector\u003cint\u003e\u0026 nums, int k) {\n        unordered_map\u003cint, int\u003e cnt{{0, 1}}; // 前缀和 -\u003e 出现次数；放一个 0 表示「从数组开头算起」\n        int cur = 0, ans = 0;\n        for (int x : nums) {\n            cur += x;                 // 累加到当前位置的前缀和\n            ans += cnt[cur - k];      // 之前有多少个前缀和等于 cur - k，就有多少段子数组和为 k\n            ++cnt[cur];               // 把当前前缀和记进表里（先查后存，避免子数组长度为 0 被算进去）\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-rllcn8f","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-rllcn8f","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"11. 滑动窗口最大值（困难 · No.239）"}]},{"ID":"20261001212411-kfvhs29","Type":"NodeParagraph","Properties":{"id":"20261001212411-kfvhs29","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和滑动窗口大小 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"，窗口从数组最左端滑到最右端，每次向右移动一位，返回"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"每个窗口中的最大值"},{"Type":"NodeText","Data":"组成的数组。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [1,3,-1,-3,5,3,6,7]"},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k = 3"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[3,3,5,5,6,7]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-9we7o3d","Type":"NodeParagraph","Properties":{"id":"20261001212411-9we7o3d","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：单调递减双端队列存放下标，队首始终是当前窗口最大值的下标：新元素入队前把所有比它小的队尾元素弹出（它们不可能再成为最大值），再弹出过期的队首下标，窗口形成后取队首，每个元素进出队列各一次，O(n)。"}]},{"ID":"20261001212411-i47qr0o","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-i47qr0o","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e maxSlidingWindow(vector\u003cint\u003e\u0026 nums, int k) {\n        deque\u003cint\u003e dq; // 存下标，它们对应的值从队首到队尾单调递减，队首就是窗口最大值\n        vector\u003cint\u003e ans;\n        for (int i = 0; i \u003c nums.size(); ++i) {\n            // 新来的 nums[i] 比队尾那些数大，那些数以后永远没机会当最大值了，直接踢掉\n            while (!dq.empty() \u0026\u0026 nums[dq.back()] \u003c= nums[i]) dq.pop_back();\n            dq.push_back(i);\n            if (dq.front() \u003c= i - k) dq.pop_front(); // 队首已经滑出窗口，删掉\n            if (i \u003e= k - 1) ans.push_back(nums[dq.front()]); // 窗口已成形，队首就是本窗口最大值\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ahqv9c1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ahqv9c1","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"12. 最小覆盖子串（困难 · No.76）"}]},{"ID":"20261001212411-veaw3b0","Type":"NodeParagraph","Properties":{"id":"20261001212411-veaw3b0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"t"},{"Type":"NodeText","Data":"，返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"涵盖 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 全部字符的最短子串"},{"Type":"NodeText","Data":"（字符的出现次数也要满足 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"t"},{"Type":"NodeText","Data":" 中的次数）；若不存在这样的子串则返回空串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"\""},{"Type":"NodeText","Data":"。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s = \"ADOBECODEBANC\""},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"t = \"ABC\""},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"BANC\""},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-ueitwwe","Type":"NodeParagraph","Properties":{"id":"20261001212411-ueitwwe","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：右指针扩张窗口并统计字符数，当窗口已覆盖 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"t"},{"Type":"NodeText","Data":" 的所有字符后，左指针收缩寻找更短的合法窗口并记录最小长度；用一个计数器表示「还有多少种字符未达到需求量」，收缩时某种字符数量跌破需求就恢复计数，整体 O(n)。"}]},{"ID":"20261001212411-kyo1gee","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-kyo1gee","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    string minWindow(string s, string t) {\n        vector\u003cint\u003e need(128, 0), win(128, 0); // need：t 中每个字符的需求量；win：当前窗口内各字符的数量\n        for (char c : t) ++need[c];\n        int kinds = 0; // t 里一共有多少种字符（这些种类都必须凑齐）\n        for (int i = 0; i \u003c 128; ++i) if (need[i]) ++kinds;\n        int formed = 0; // 当前窗口里「数量已达标」的字符种类数\n        int l = 0;\n        int bestLen = INT_MAX, bestL = 0; // 记录最短合法子串的长度和起点\n        for (int r = 0; r \u003c s.size(); ++r) {\n            char c = s[r];\n            ++win[c];                                              // 右端字符进窗口\n            if (need[c] \u0026\u0026 win[c] == need[c]) ++formed;            // 这种字符刚好凑齐，达标种类 +1\n            while (formed == kinds) {                              // 所有种类都达标，窗口已合法\n                if (r - l + 1 \u003c bestLen) {                         // 更新更短的最优解\n                    bestLen = r - l + 1;\n                    bestL = l;\n                }\n                char d = s[l++];                                   // 收缩左边界，尝试更短的窗口\n                --win[d];\n                if (need[d] \u0026\u0026 win[d] \u003c need[d]) --formed;         // 某种字符不够了，窗口失去合法性\n            }\n        }\n        return bestLen == INT_MAX ? \"\" : s.substr(bestL, bestLen); // 从没合法过就返回空串\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-isttc49","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-isttc49","updated":"20261001212411"}},{"ID":"20261001212411-3mipw0i","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-3mipw0i","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"五、普通数组（5 题）"}]},{"ID":"20261001212411-web2u0p","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-web2u0p","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"13. 最大子数组和（中等 · No.53）"}]},{"ID":"20261001212411-1xeuqu4","Type":"NodeParagraph","Properties":{"id":"20261001212411-1xeuqu4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，找出一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和最大的连续子数组"},{"Type":"NodeText","Data":"（至少包含一个元素），返回其最大和。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[-2,1,-3,4,-1,2,1,-5,4]"},{"Type":"NodeText","Data":" → 6（子数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[4,-1,2,1]"},{"Type":"NodeText","Data":"）。"}]},{"ID":"20261001212411-g8cm66p","Type":"NodeParagraph","Properties":{"id":"20261001212411-g8cm66p","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：Kadane 动态规划，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur"},{"Type":"NodeText","Data":" 表示以当前位置结尾的最大子数组和，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur = max(x, cur + x)"},{"Type":"NodeText","Data":"——前面的累积为负就丢弃、从当前值重新开始，同时用全局答案记录最大值，O(n)。"}]},{"ID":"20261001212411-46tr4lv","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-46tr4lv","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int maxSubArray(vector\u003cint\u003e\u0026 nums) {\n        int cur = 0, ans = INT_MIN;\n        for (int x : nums) {\n            // 以 x 结尾的最大和：要么接在前面的累积后面，要么从前面的负累赘里跳出来、以 x 重新开始\n            cur = max(x, cur + x);\n            ans = max(ans, cur); // 全局最优一定出现在某个「以 i 结尾」的状态里\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-kg6j2x8","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-kg6j2x8","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"14. 合并区间（中等 · No.56）"}]},{"ID":"20261001212411-eory9fr","Type":"NodeParagraph","Properties":{"id":"20261001212411-eory9fr","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定区间数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"intervals"},{"Type":"NodeText","Data":"，合并所有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相互重叠"},{"Type":"NodeText","Data":"的区间，返回互不重叠的区间数组（按起点升序）。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,3],[2,6],[8,10],[15,18]]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,6],[8,10],[15,18]]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-iqr74yo","Type":"NodeParagraph","Properties":{"id":"20261001212411-iqr74yo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：按区间左端点排序，顺序扫描时若当前区间左端点不超过结果中最后一个区间的右端点就合并（取右端点较大值），否则单独追加新区间，O(n log n)。"}]},{"ID":"20261001212411-kn98xuw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-kn98xuw","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cvector\u003cint\u003e\u003e merge(vector\u003cvector\u003cint\u003e\u003e\u0026 intervals) {\n        sort(intervals.begin(), intervals.end()); // 按起点排序，重叠的区间才会挨在一起\n        vector\u003cvector\u003cint\u003e\u003e ans;\n        for (auto\u0026 it : intervals) {\n            // 当前区间起点 \u003c= 上一个区间的终点 ⇒ 有重叠，合并（终点取两者较大值）\n            if (!ans.empty() \u0026\u0026 it[0] \u003c= ans.back()[1])\n                ans.back()[1] = max(ans.back()[1], it[1]);\n            else\n                ans.push_back(it); // 不重叠，直接作为一个新区间\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-1o0911v","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-1o0911v","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"15. 轮转数组（中等 · No.189）"}]},{"ID":"20261001212411-hj5wkwq","Type":"NodeParagraph","Properties":{"id":"20261001212411-hj5wkwq","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，把数组中元素"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"向右轮转 k 个位置"},{"Type":"NodeText","Data":"（k 非负），要求原地修改。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums = [1,2,3,4,5,6,7]"},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k = 3"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[5,6,7,1,2,3,4]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-ozovfgm","Type":"NodeParagraph","Properties":{"id":"20261001212411-ozovfgm","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先整体反转，再分别反转前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k % n"},{"Type":"NodeText","Data":" 个和剩下的部分，等价于把末尾 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 个元素搬到开头且保持顺序，三次反转 O(n)、O(1) 空间，也避免了取模带来的下标绕圈问题。"}]},{"ID":"20261001212411-k5z4rfg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-k5z4rfg","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void rotate(vector\u003cint\u003e\u0026 nums, int k) {\n        int n = nums.size();\n        k %= n; // k 可能大于 n，取余后才是真正要移动的步数\n        reverse(nums.begin(), nums.end());                     // 第一步：整体反转\n        reverse(nums.begin(), nums.begin() + k);               // 第二步：反转前 k 个\n        reverse(nums.begin() + k, nums.end());                 // 第三步：反转剩下部分\n        // 三次反转的净效果 = 把末尾 k 个元素原序挪到最前面\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-xz82nky","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-xz82nky","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"16. 除了自身以外数组的乘积（中等 · No.238）"}]},{"ID":"20261001212411-2k4b5nf","Type":"NodeParagraph","Properties":{"id":"20261001212411-2k4b5nf","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，返回数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"answer"},{"Type":"NodeText","Data":"，其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"answer[i]"},{"Type":"NodeText","Data":" 等于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"除 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"nums[i]"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 之外其余所有元素的乘积"},{"Type":"NodeText","Data":"。要求不能使用除法，且时间复杂度为 O(n)。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[1,2,3,4]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[24,12,8,6]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-9e453d1","Type":"NodeParagraph","Properties":{"id":"20261001212411-9e453d1","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：不许用除法就分两次前缀扫描：第一次从左往右把「左侧累积乘积」写进答案数组，第二次从右往左用变量维护「右侧累积乘积」并乘到答案上，最终每个位置就是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"left[i] * right[i]"},{"Type":"NodeText","Data":"，O(n) 时间、O(1) 额外空间。"}]},{"ID":"20261001212411-e4rrn9n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-e4rrn9n","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e productExceptSelf(vector\u003cint\u003e\u0026 nums) {\n        int n = nums.size();\n        vector\u003cint\u003e ans(n, 1);\n        int left = 1; // 从左往右累积的乘积\n        for (int i = 0; i \u003c n; ++i) {\n            ans[i] = left;     // 先把「i 左边所有数的乘积」放进答案\n            left *= nums[i];   // 再把 nums[i] 累加进 left，供后面的位置使用\n        }\n        int right = 1; // 从右往左累积的乘积\n        for (int i = n - 1; i \u003e= 0; --i) {\n            ans[i] *= right;   // 乘上「i 右边所有数的乘积」，两次扫完即为「除自己外全部乘积」\n            right *= nums[i];\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-2s9zivr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-2s9zivr","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"17. 缺失的第一个正数（困难 · No.41）"}]},{"ID":"20261001212411-6pfcc2u","Type":"NodeParagraph","Properties":{"id":"20261001212411-6pfcc2u","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定未排序的整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，找出其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"没有出现过的最小正整数"},{"Type":"NodeText","Data":"。要求时间 O(n)、额外空间 O(1)。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[3,4,-1,1]"},{"Type":"NodeText","Data":" → 2；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[7,8,9,11,12]"},{"Type":"NodeText","Data":" → 1。"}]},{"ID":"20261001212411-zgv28v9","Type":"NodeParagraph","Properties":{"id":"20261001212411-zgv28v9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：原地哈希置换，把每个值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"x"},{"Type":"NodeText","Data":"（满足 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1 \u0026lt;= x \u0026lt;= n"},{"Type":"NodeText","Data":"）放到下标 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"x-1"},{"Type":"NodeText","Data":" 上，一遍交换之后扫描一遍，第一个「"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i] != i+1"},{"Type":"NodeText","Data":"」的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i+1"},{"Type":"NodeText","Data":" 即为答案；若 1..n 都在则答案是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n+1"},{"Type":"NodeText","Data":"，O(n) 时间、O(1) 空间。"}]},{"ID":"20261001212411-exsghsm","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-exsghsm","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int firstMissingPositive(vector\u003cint\u003e\u0026 nums) {\n        int n = nums.size();\n        // 目标：让数值 x（1\u003c=x\u003c=n）待在 nums[x-1] 的位置上，像整理书架的抽屉\n        for (int i = 0; i \u003c n; ++i)\n            while (nums[i] \u003e= 1 \u0026\u0026 nums[i] \u003c= n \u0026\u0026 nums[nums[i] - 1] != nums[i])\n                swap(nums[i], nums[nums[i] - 1]); // 一直换到当前位置放对了（或值本身不合法）为止\n        // 逐个检查：第一个「位置和值对不上」的位置，答案就是它的 1-based 编号\n        for (int i = 0; i \u003c n; ++i)\n            if (nums[i] != i + 1) return i + 1;\n        return n + 1; // 1..n 全都在，答案就是 n+1\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-lurv51i","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-lurv51i","updated":"20261001212411"}},{"ID":"20261001212411-9t9pct6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-9t9pct6","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"六、矩阵（4 题）"}]},{"ID":"20261001212411-ljdjy0o","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ljdjy0o","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"18. 矩阵置零（中等 · No.73）"}]},{"ID":"20261001212411-yooggxr","Type":"NodeParagraph","Properties":{"id":"20261001212411-yooggxr","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个 m×n 矩阵，如果某个元素为 0，则把它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"所在的行和列上的所有元素都置为 0"},{"Type":"NodeText","Data":"。要求原地修改。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,1,1],[1,0,1],[1,1,1]]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,0,1],[0,0,0],[1,0,1]]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-xueqvw0","Type":"NodeParagraph","Properties":{"id":"20261001212411-xueqvw0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：借用第一行和第一列当作标记数组：先扫描全矩阵，遇到 0 就把对应行首、列首置 0；再反过来用行首/列首的标记把中间区域清零；最后单独处理第一行第一列自身（单独用两个布尔变量记录原始状态），O(mn) 时间、O(1) 空间。"}]},{"ID":"20261001212411-wd2cozi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-wd2cozi","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void setZeroes(vector\u003cvector\u003cint\u003e\u003e\u0026 matrix) {\n        int m = matrix.size(), n = matrix[0].size();\n        // 第一行/第一列既是数据、又要当标记位用，所以先单独记下它们原本有没有 0\n        bool firstRow = false, firstCol = false;\n        for (int j = 0; j \u003c n; ++j) if (matrix[0][j] == 0) firstRow = true;\n        for (int i = 0; i \u003c m; ++i) if (matrix[i][0] == 0) firstCol = true;\n        // 第一遍：中间的 0 用它所在行的行首和所在列的列首来「记账」\n        for (int i = 1; i \u003c m; ++i)\n            for (int j = 1; j \u003c n; ++j)\n                if (matrix[i][j] == 0) matrix[i][0] = matrix[0][j] = 0;\n        // 第二遍：根据行首/列首的账本，把中间区域该清零的清零\n        for (int i = 1; i \u003c m; ++i)\n            for (int j = 1; j \u003c n; ++j)\n                if (matrix[i][0] == 0 || matrix[0][j] == 0) matrix[i][j] = 0;\n        // 最后按最初记录的标记，处理第一行和第一列\n        if (firstRow)\n            for (int j = 0; j \u003c n; ++j) matrix[0][j] = 0;\n        if (firstCol)\n            for (int i = 0; i \u003c m; ++i) matrix[i][0] = 0;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-drf68md","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-drf68md","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"19. 螺旋矩阵（中等 · No.54）"}]},{"ID":"20261001212411-7yqimu4","Type":"NodeParagraph","Properties":{"id":"20261001212411-7yqimu4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个 m×n 矩阵，按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"顺时针螺旋顺序"},{"Type":"NodeText","Data":"返回矩阵中的所有元素。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,2,3],[4,5,6],[7,8,9]]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[1,2,3,6,9,8,7,4,5]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-or606zp","Type":"NodeParagraph","Properties":{"id":"20261001212411-or606zp","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"top/bottom/left/right"},{"Type":"NodeText","Data":" 四个边界模拟一圈圈向内收：先从左到右走完上边（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"top++"},{"Type":"NodeText","Data":"），再从上到下走右边（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"right--"},{"Type":"NodeText","Data":"），依此类推，每走完一条边收缩对应边界，注意每轮都要检查边界防止重复访问，O(mn)。"}]},{"ID":"20261001212411-0ifx5kd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-0ifx5kd","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e spiralOrder(vector\u003cvector\u003cint\u003e\u003e\u0026 matrix) {\n        vector\u003cint\u003e ans;\n        int m = matrix.size(), n = matrix[0].size();\n        int top = 0, bottom = m - 1, left = 0, right = n - 1; // 四条边界的当前位置\n        while (top \u003c= bottom \u0026\u0026 left \u003c= right) {\n            for (int j = left; j \u003c= right; ++j) ans.push_back(matrix[top][j]); // 上边：从左到右\n            ++top;                                                             // 上边用完了，往下缩\n            for (int i = top; i \u003c= bottom; ++i) ans.push_back(matrix[i][right]); // 右边：从上到下\n            --right;\n            if (top \u003c= bottom) // 还要有行可走，否则会重复遍历（只剩一行的情形）\n                for (int j = right; j \u003e= left; --j) ans.push_back(matrix[bottom][j]); // 下边：从右到左\n            --bottom;\n            if (left \u003c= right) // 还要有列可走\n                for (int i = bottom; i \u003e= top; --i) ans.push_back(matrix[i][left]); // 左边：从下到上\n            ++left;\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-u3kuhxt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-u3kuhxt","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"20. 旋转图像（中等 · No.48）"}]},{"ID":"20261001212411-kx429vc","Type":"NodeParagraph","Properties":{"id":"20261001212411-kx429vc","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个 n×n 的二维矩阵，将图像"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"顺时针旋转 90°"},{"Type":"NodeText","Data":"，必须原地旋转，不能使用另一个矩阵。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[1,2,3],[4,5,6],[7,8,9]]"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[[7,4,1],[8,5,2],[9,6,3]]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-r8y1crq","Type":"NodeParagraph","Properties":{"id":"20261001212411-r8y1crq","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：顺时针旋转 90° 等于「先沿主对角线转置、再反转每一行」：转置交换 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"matrix[i][j]"},{"Type":"NodeText","Data":" 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"matrix[j][i]"},{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"j \u0026gt; i"},{"Type":"NodeText","Data":"），水平翻转把行内元素对调，两步均是原地 O(n²) 操作。"}]},{"ID":"20261001212411-lm2l278","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-lm2l278","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void rotate(vector\u003cvector\u003cint\u003e\u003e\u0026 matrix) {\n        int n = matrix.size();\n        // 第一步：沿主对角线翻转（转置），把 matrix[i][j] 和 matrix[j][i] 互换\n        for (int i = 0; i \u003c n; ++i)\n            for (int j = i + 1; j \u003c n; ++j) // 只处理上三角，避免换两次换回来\n                swap(matrix[i][j], matrix[j][i]);\n        // 第二步：每一行左右翻转\n        for (auto\u0026 row : matrix) reverse(row.begin(), row.end());\n        // 这两步合起来正好等价于「顺时针旋转 90°」\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-lq3qvy7","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-lq3qvy7","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"21. 搜索二维矩阵 II（中等 · No.240）"}]},{"ID":"20261001212411-p8tiwsu","Type":"NodeParagraph","Properties":{"id":"20261001212411-p8tiwsu","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定 m×n 矩阵，满足"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"每一行从左到右升序、每一列从上到下升序"},{"Type":"NodeText","Data":"，高效地判断目标值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":" 是否存在于矩阵中。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"matrix = [[1,4,7,11],[2,5,8,12],[3,6,9,16],[10,13,14,17]]"},{"Type":"NodeText","Data":","},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target = 5"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"true"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-slbdd0t","Type":"NodeParagraph","Properties":{"id":"20261001212411-slbdd0t","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：从右上角出发：当前值比目标大说明整列都可能偏大、列号左移，比目标小说明整行都偏小、行号下移，利用行列各自有序的性质每次排除一行或一列，最坏 O(m+n)。"}]},{"ID":"20261001212411-3348ful","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-3348ful","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool searchMatrix(vector\u003cvector\u003cint\u003e\u003e\u0026 matrix, int target) {\n        int m = matrix.size(), n = matrix[0].size();\n        int i = 0, j = n - 1; // 从右上角出发：它是这一行的最大值、也是这一列的最小值，最好用来「剪枝」\n        while (i \u003c m \u0026\u0026 j \u003e= 0) {\n            if (matrix[i][j] == target) return true;\n            if (matrix[i][j] \u003e target) --j; // 比目标大 ⇒ 这一列下面只会更大，整列排除，往左走\n            else ++i;                       // 比目标小 ⇒ 这一行右边只会更小，整行排除，往下走\n        }\n        return false; // 走出边界说明不存在\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-oid6g23","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-oid6g23","updated":"20261001212411"}},{"ID":"20261001212411-q3z8g5j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-q3z8g5j","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"七、链表（14 题）"}]},{"ID":"20261001212411-t80gh1n","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-t80gh1n","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"22. 相交链表（简单 · No.160）"}]},{"ID":"20261001212411-a4wfwwe","Type":"NodeParagraph","Properties":{"id":"20261001212411-a4wfwwe","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定两个单链表的头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"headA"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"headB"},{"Type":"NodeText","Data":"，判断它们是否相交（从某个节点起共享同一段节点，比较的是节点地址而非节点值）。若相交返回相交的第一个节点，否则返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"。要求时间 O(m+n)、空间 O(1)。"}]},{"ID":"20261001212411-bqv8anl","Type":"NodeParagraph","Properties":{"id":"20261001212411-bqv8anl","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：双指针法，指针 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"a"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"b"},{"Type":"NodeText","Data":" 分别从两链表头出发，走到末尾就改走另一条链表头，这样两条指针走过的总长度相等——若相交，它们会在交点相遇（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"a == b"},{"Type":"NodeText","Data":"）；若不相交则同时走到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"，O(m+n) 时间、O(1) 空间。"}]},{"ID":"20261001212411-u8vv6l3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-u8vv6l3","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {\n        ListNode *a = headA, *b = headB;\n        while (a != b) {                       // 相遇（或同时变空）时退出循环\n            a = a ? a-\u003enext : headB;           // a 走到尽头就跳到 B 的头，把两边的路程「补齐」\n            b = b ? b-\u003enext : headA;           // b 同理\n        }\n        // 相交时在交点相遇；不相交时各自走完 m+n 步后同时为 null，也相遇（返回 null）\n        return a;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-djuerdm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-djuerdm","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"23. 反转链表（简单 · No.206）"}]},{"ID":"20261001212411-7uff347","Type":"NodeParagraph","Properties":{"id":"20261001212411-7uff347","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定单链表的头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"head"},{"Type":"NodeText","Data":"，反转整个链表并返回反转后的头节点。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1→2→3→4→5"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"5→4→3→2→1"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-1atvnb5","Type":"NodeParagraph","Properties":{"id":"20261001212411-1atvnb5","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：迭代三指针，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur"},{"Type":"NodeText","Data":" 分别记录已反转部分的尾和当前节点，每次把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur-\u0026gt;next"},{"Type":"NodeText","Data":" 指向 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev"},{"Type":"NodeText","Data":" 后整体前移，直到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur"},{"Type":"NodeText","Data":" 为空，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev"},{"Type":"NodeText","Data":" 即新的头，O(n)。"}]},{"ID":"20261001212411-g9nbfb7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-g9nbfb7","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* reverseList(ListNode* head) {\n        ListNode* prev = nullptr; // 已反转部分的头（初始为空）\n        ListNode* cur = head;     // 正在处理的节点\n        while (cur) {\n            ListNode* nxt = cur-\u003enext; // 先保存下一个节点，防止改指针后走丢\n            cur-\u003enext = prev;          // 让当前节点指回前一个节点 → 方向掉头\n            prev = cur;                // prev 前进到当前节点\n            cur = nxt;                 // cur 前进到下一个\n        }\n        return prev; // 循环结束时 prev 指向原来的尾，即反转后的头\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-m1gv2o1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-m1gv2o1","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"24. 回文链表（简单 · No.234）"}]},{"ID":"20261001212411-x52abgy","Type":"NodeParagraph","Properties":{"id":"20261001212411-x52abgy","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定单链表的头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"head"},{"Type":"NodeText","Data":"，判断它是否为回文链表（正序读与倒序读的值序列完全相同），要求在 O(n) 时间、O(1) 空间内完成。"}]},{"ID":"20261001212411-uxtqdew","Type":"NodeParagraph","Properties":{"id":"20261001212411-uxtqdew","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：快慢指针找到中点后，把从 slow 开始到末尾的整段链表原地反转，再用两个指针分别从头、从反转后的那半段头部同步往后比较值，全部相等即为回文；翻转后 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"q"},{"Type":"NodeText","Data":" 所在的那段长度不超过前半段，所以只需以 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"q"},{"Type":"NodeText","Data":" 走完为终止条件（奇数长度时中间节点会与自己比较一次，不影响结果），O(n) 时间、O(1) 额外空间。"}]},{"ID":"20261001212411-rn2h1g7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-rn2h1g7","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool isPalindrome(ListNode* head) {\n        ListNode *slow = head, *fast = head;\n        while (fast \u0026\u0026 fast-\u003enext) { // 快指针走两步、慢指针走一步，快走到头时慢指针正好在中点\n            slow = slow-\u003enext;\n            fast = fast-\u003enext-\u003enext;\n        }\n        ListNode* prev = nullptr;\n        while (slow) { // 把后半段链表原地反转\n            ListNode* nxt = slow-\u003enext;\n            slow-\u003enext = prev;\n            prev = slow;\n            slow = nxt;\n        }\n        ListNode *p = head, *q = prev; // p 从头往后走，q 从反转后的后半段头部往后走（相当于从尾部倒着走）\n        while (q) {                    // 后半段更短（或等长），以它走完为终止；奇数长度时中间节点会与自己比一次\n            if (p-\u003eval != q-\u003eval) return false;\n            p = p-\u003enext;\n            q = q-\u003enext;\n        }\n        return true;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-4fonawr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-4fonawr","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"25. 环形链表（简单 · No.141）"}]},{"ID":"20261001212411-8f7354m","Type":"NodeParagraph","Properties":{"id":"20261001212411-8f7354m","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定单链表的头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"head"},{"Type":"NodeText","Data":"，判断链表中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"是否存在环"},{"Type":"NodeText","Data":"（即是否可以从某个节点沿着 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"next"},{"Type":"NodeText","Data":" 反复回到它自己）。有环返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"true"},{"Type":"NodeText","Data":"，否则返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"false"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-38j26wc","Type":"NodeParagraph","Properties":{"id":"20261001212411-38j26wc","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：Floyd 判圈，慢指针每次走一步、快指针每次走两步，若链表有环快慢必然在环内相遇，否则快指针先到达末尾，O(n) 时间、O(1) 空间。"}]},{"ID":"20261001212411-5b85eef","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-5b85eef","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool hasCycle(ListNode *head) {\n        ListNode *slow = head, *fast = head;\n        while (fast \u0026\u0026 fast-\u003enext) { // 快指针能走就继续追\n            slow = slow-\u003enext;       // 慢指针一步\n            fast = fast-\u003enext-\u003enext; // 快指针两步\n            if (slow == fast) return true; // 追上 ⇒ 有环\n        }\n        return false; // 快指针走到头 ⇒ 无环\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-zwde7hj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-zwde7hj","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"26. 环形链表 II（中等 · No.142）"}]},{"ID":"20261001212411-2f4q8pj","Type":"NodeParagraph","Properties":{"id":"20261001212411-2f4q8pj","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定单链表的头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"head"},{"Type":"NodeText","Data":"，返回链表"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"开始入环的第一个节点"},{"Type":"NodeText","Data":"；若链表无环则返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"。要求不使用额外空间。"}]},{"ID":"20261001212411-8q9dbky","Type":"NodeParagraph","Properties":{"id":"20261001212411-8q9dbky","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：还是 Floyd 算法，快慢相遇后把一个指针放回头节点，两指针都改为每次走一步，再次相遇点即为环的入口——因为此时两者走过的距离差恰好是环长的整数倍。"}]},{"ID":"20261001212411-7ypejc5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-7ypejc5","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode *detectCycle(ListNode *head) {\n        ListNode *slow = head, *fast = head;\n        while (fast \u0026\u0026 fast-\u003enext) {\n            slow = slow-\u003enext;\n            fast = fast-\u003enext-\u003enext;\n            if (slow == fast) { // 第一次相遇，说明有环\n                ListNode* p = head;      // 一个指针回到起点\n                while (p != slow) {      // 两个指针都改成每次走一步，再次相遇处就是环的入口\n                    p = p-\u003enext;\n                    slow = slow-\u003enext;\n                }\n                return p;\n            }\n        }\n        return nullptr; // 走完了还没相遇 ⇒ 无环\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-xt9lq9x","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-xt9lq9x","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"27. 合并两个有序链表（简单 · No.21）"}]},{"ID":"20261001212411-cbwir1m","Type":"NodeParagraph","Properties":{"id":"20261001212411-cbwir1m","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：将两个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"升序"},{"Type":"NodeText","Data":"链表合并为一个新的升序链表并返回，新链表由拼接原有两个链表的所有节点组成。"}]},{"ID":"20261001212411-rh1jhp5","Type":"NodeParagraph","Properties":{"id":"20261001212411-rh1jhp5","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：哑结点 + 双指针，每次把两个链表当前较小的节点接到结果链尾部并前移，一方走完后直接接上另一方剩余部分，O(m+n)。"}]},{"ID":"20261001212411-en8y0mf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-en8y0mf","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* mergeTwoLists(ListNode* l1, ListNode* l2) {\n        ListNode dummy(0);      // 哑结点，省去「结果链表为空」的特判\n        ListNode* tail = \u0026dummy; // tail 永远指向结果链表的尾部\n        while (l1 \u0026\u0026 l2) {\n            if (l1-\u003eval \u003c= l2-\u003eval) { // 谁小接谁\n                tail-\u003enext = l1;\n                l1 = l1-\u003enext;\n            } else {\n                tail-\u003enext = l2;\n                l2 = l2-\u003enext;\n            }\n            tail = tail-\u003enext; // 尾部后移\n        }\n        tail-\u003enext = l1 ? l1 : l2; // 一方走完，另一方的剩余部分直接整段接上\n        return dummy.next;         // 哑结点的 next 才是真正的头\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ta5inix","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ta5inix","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"28. 两数相加（中等 · No.2）"}]},{"ID":"20261001212411-bsz9yua","Type":"NodeParagraph","Properties":{"id":"20261001212411-bsz9yua","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定两个非空链表表示两个非负整数（每个节点存一位数字，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"逆序"},{"Type":"NodeText","Data":"存储，即个位在头），返回它们之和对应的链表（同样逆序存储）。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"2→4→3"},{"Type":"NodeText","Data":"（即 342）加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"5→6→4"},{"Type":"NodeText","Data":"（即 465）得 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"7→0→8"},{"Type":"NodeText","Data":"（即 807）。"}]},{"ID":"20261001212411-gx0rrrh","Type":"NodeParagraph","Properties":{"id":"20261001212411-gx0rrrh","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：模拟竖式加法，哑结点串起新链表，两个指针同步遍历两条链表，逐位相加再加上进位 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"carry"},{"Type":"NodeText","Data":"，每产生一位就 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"carry /= 10"},{"Type":"NodeText","Data":"，最后若还有进位要补一个新节点，O(max(m,n))。"}]},{"ID":"20261001212411-lneez6g","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-lneez6g","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {\n        ListNode dummy(0);\n        ListNode* tail = \u0026dummy;\n        int carry = 0; // 进位\n        while (l1 || l2 || carry) { // 只要还有数字或还有进位就要继续算\n            int sum = carry;\n            if (l1) { sum += l1-\u003eval; l1 = l1-\u003enext; } // 加上 l1 当前位\n            if (l2) { sum += l2-\u003eval; l2 = l2-\u003enext; } // 加上 l2 当前位\n            carry = sum / 10;                           // 新的进位\n            tail-\u003enext = new ListNode(sum % 10);        // 当前位结果\n            tail = tail-\u003enext;\n        }\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-sdhe15l","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-sdhe15l","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"29. 删除链表的倒数第 N 个结点（中等 · No.19）"}]},{"ID":"20261001212411-xgv9i2k","Type":"NodeParagraph","Properties":{"id":"20261001212411-xgv9i2k","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定链表头节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"head"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":"，删除链表的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"倒数第 n 个节点"},{"Type":"NodeText","Data":"并返回头节点，要求只遍历一趟。"}]},{"ID":"20261001212411-bja31xp","Type":"NodeParagraph","Properties":{"id":"20261001212411-bja31xp","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：快慢指针，让快指针先走 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":" 步，然后快慢一起走，快指针到达末尾时慢指针恰好停在待删节点的前驱上，配合哑结点即可统一处理删除头结点的情况，一趟扫描 O(L)。"}]},{"ID":"20261001212411-rixumnz","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-rixumnz","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* removeNthFromEnd(ListNode* head, int n) {\n        ListNode dummy(0);\n        dummy.next = head;              // 哑结点：让「删头结点」和删其他节点一样处理\n        ListNode *fast = \u0026dummy, *slow = \u0026dummy;\n        for (int i = 0; i \u003c n; ++i) fast = fast-\u003enext; // 快指针先走 n 步，拉开 n 个身位\n        while (fast-\u003enext) {            // 一起走，直到快指针到最后一节点\n            fast = fast-\u003enext;\n            slow = slow-\u003enext;\n        }\n        slow-\u003enext = slow-\u003enext-\u003enext;  // 此时 slow 正好在待删节点的前一个，跳过它\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-25mv12d","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-25mv12d","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"30. 两两交换链表中的节点（中等 · No.24）"}]},{"ID":"20261001212411-scf8a61","Type":"NodeParagraph","Properties":{"id":"20261001212411-scf8a61","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定链表，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"两两交换"},{"Type":"NodeText","Data":"其中相邻的节点并返回交换后链表的头节点。必须实际调整节点指针来完成，不能只修改节点里的值。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1→2→3→4"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"2→1→4→3"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-wdr3wqd","Type":"NodeParagraph","Properties":{"id":"20261001212411-wdr3wqd","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：哑结点 + 迭代，每次定位到一组两个节点的前驱 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pre"},{"Type":"NodeText","Data":"，记 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"first = pre-\u0026gt;next"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"second = first-\u0026gt;next"},{"Type":"NodeText","Data":"，按 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pre → second → first → 后续"},{"Type":"NodeText","Data":" 重新接线并把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pre"},{"Type":"NodeText","Data":" 前移到这组末尾，重复直到不足两个节点，O(n)。"}]},{"ID":"20261001212411-trrx14j","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-trrx14j","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* swapPairs(ListNode* head) {\n        ListNode dummy(0);\n        dummy.next = head;\n        ListNode* pre = \u0026dummy; // pre 指向「当前这组两个节点的前驱」\n        while (pre-\u003enext \u0026\u0026 pre-\u003enext-\u003enext) { // 还有完整的一组才继续\n            ListNode* first = pre-\u003enext;\n            ListNode* second = first-\u003enext;\n            // 重新接线：pre → second → first → 原来的第三个节点\n            first-\u003enext = second-\u003enext;\n            second-\u003enext = first;\n            pre-\u003enext = second;\n            pre = first; // 跳到这一组的末尾（也就是 first），准备处理下一组\n        }\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-i4z9rdp","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-i4z9rdp","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"31. K 个一组翻转链表（困难 · No.25）"}]},{"ID":"20261001212411-ujck10w","Type":"NodeParagraph","Properties":{"id":"20261001212411-ujck10w","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定链表头节点，每 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 个节点为一组进行翻转，返回翻转后的链表；若最后剩余节点不足 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 个，则保持原有顺序。要求只能调整节点指针，不能修改节点的值。"}]},{"ID":"20261001212411-39ites4","Type":"NodeParagraph","Properties":{"id":"20261001212411-39ites4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：哑结点 + 分段反转，先检查剩余长度是否够 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"（不足则直接接上收尾），够则对这段子链表反转 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k-1"},{"Type":"NodeText","Data":" 次指针，接回原链后把组首指针移动到组尾继续下一段，每段 O(k)，总 O(n)。"}]},{"ID":"20261001212411-b3p246n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-b3p246n","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* reverseKGroup(ListNode* head, int k) {\n        ListNode dummy(0);\n        dummy.next = head;\n        ListNode* pre = \u0026dummy; // pre 指向「上一组的最后一个节点」\n        while (true) {\n            // 先探路：看看后面还剩不到 k 个节点？不够就直接返回（剩下的保持原序）\n            ListNode* check = pre;\n            for (int i = 0; i \u003c k; ++i) {\n                check = check-\u003enext;\n                if (!check) return dummy.next;\n            }\n            ListNode* first = pre-\u003enext; // 本组第一个节点，反转后会变成本组最后一个\n            ListNode* cur = first-\u003enext;\n            for (int i = 1; i \u003c k; ++i) { // 把后 k-1 个节点依次「头插」到 pre 后面\n                ListNode* nxt = cur-\u003enext;\n                cur-\u003enext = pre-\u003enext;\n                pre-\u003enext = cur;\n                cur = nxt;\n            }\n            first-\u003enext = cur; // 本组末尾接上后面还没处理的部分\n            pre = first;       // pre 移动到本组末尾，开始下一组\n        }\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-gmzs9rd","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-gmzs9rd","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"32. 随机链表的复制（中等 · No.138）"}]},{"ID":"20261001212411-ynym7fr","Type":"NodeParagraph","Properties":{"id":"20261001212411-ynym7fr","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个链表，每个节点除了 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"next"},{"Type":"NodeText","Data":" 还有一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"random"},{"Type":"NodeText","Data":" 指针（可能指向链表中任意节点或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"）。请"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"深拷贝"},{"Type":"NodeText","Data":"这个链表并返回新链表的头节点，新链表的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"next"},{"Type":"NodeText","Data":" 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"random"},{"Type":"NodeText","Data":" 都必须指向新链表中的新节点，不能指向原节点。"}]},{"ID":"20261001212411-hjpxv2w","Type":"NodeParagraph","Properties":{"id":"20261001212411-hjpxv2w","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：哈希表记录「原节点 → 新节点」，先第一遍把每个原节点都克隆出来，再第二遍根据原节点的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"next"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"random"},{"Type":"NodeText","Data":" 指针从表里查出对应新节点接上，两趟 O(n)。"}]},{"ID":"20261001212411-cydeixr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-cydeixr","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    Node* copyRandomList(Node* head) {\n        unordered_map\u003cNode*, Node*\u003e clone; // 原节点 -\u003e 对应的新节点\n        for (Node* p = head; p; p = p-\u003enext)\n            clone[p] = new Node(p-\u003eval); // 第一趟：每个原节点先造一个「分身」\n        for (Node* p = head; p; p = p-\u003enext) {\n            clone[p]-\u003enext = clone[p-\u003enext];     // p 的下一个节点，换成它对应的分身\n            clone[p]-\u003erandom = clone[p-\u003erandom]; // random 同理（p-\u003erandom 为 null 时 clone[null] 也是 null）\n        }\n        return clone[head]; // head 为空时 clone[head] 也是 null，天然正确\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-dt82fra","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-dt82fra","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"33. 排序链表（中等 · No.148）"}]},{"ID":"20261001212411-it15ole","Type":"NodeParagraph","Properties":{"id":"20261001212411-it15ole","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定链表头节点，将其"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"按升序排列"},{"Type":"NodeText","Data":"并返回。进阶要求：时间复杂度 O(n log n)、空间复杂度 O(1)。"}]},{"ID":"20261001212411-io063kt","Type":"NodeParagraph","Properties":{"id":"20261001212411-io063kt","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：归并排序：快慢指针找到中点断开成两半，递归排好序后用双指针合并两个有序链表，时间 O(n log n)、递归栈 O(log n)，比直接收集值排序更符合链表题意。"}]},{"ID":"20261001212411-rhqw37o","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-rhqw37o","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* sortList(ListNode* head) {\n        if (!head || !head-\u003enext) return head; // 空链表或只有一个节点，天然有序\n        ListNode *slow = head, *fast = head-\u003enext;\n        while (fast \u0026\u0026 fast-\u003enext) { // 快慢指针找中点（fast 先走一步是为了让 slow 停在中点左侧）\n            slow = slow-\u003enext;\n            fast = fast-\u003enext-\u003enext;\n        }\n        ListNode* right = slow-\u003enext;\n        slow-\u003enext = nullptr;        // 从中间断开，分成两条链表\n        ListNode* left = sortList(head);  // 递归排好左半\n        right = sortList(right);          // 递归排好右半\n        // 合并两个有序链表（同「合并两个有序链表」那道题的写法）\n        ListNode dummy(0);\n        ListNode* tail = \u0026dummy;\n        while (left \u0026\u0026 right) {\n            if (left-\u003eval \u003c= right-\u003eval) { tail-\u003enext = left; left = left-\u003enext; }\n            else { tail-\u003enext = right; right = right-\u003enext; }\n            tail = tail-\u003enext;\n        }\n        tail-\u003enext = left ? left : right; // 剩余部分整段接上\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-91hso2c","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-91hso2c","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"34. 合并 K 个升序链表（困难 · No.23）"}]},{"ID":"20261001212411-dai1f07","Type":"NodeParagraph","Properties":{"id":"20261001212411-dai1f07","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个链表数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lists"},{"Type":"NodeText","Data":"，其中每个链表都已升序排列，将它们"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合并为一个升序链表"},{"Type":"NodeText","Data":"并返回。"}]},{"ID":"20261001212411-ywl0c91","Type":"NodeParagraph","Properties":{"id":"20261001212411-ywl0c91","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：最小堆维护「每个链表当前头结点」，每次弹出全局最小值接到结果链表尾部并把该链表的下一个节点入堆，堆里最多 k 个元素，总入堆出堆各 n 次，时间 O(n log k)。"}]},{"ID":"20261001212411-9pfhgjs","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-9pfhgjs","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    ListNode* mergeKLists(vector\u003cListNode*\u003e\u0026 lists) {\n        // 小顶堆，存 (节点值, 节点指针)，每次能 O(log k) 拿到当前所有链表头里的最小值\n        priority_queue\u003cpair\u003cint, ListNode*\u003e, vector\u003cpair\u003cint, ListNode*\u003e\u003e, greater\u003c\u003e\u003e pq;\n        for (auto* h : lists)\n            if (h) pq.push({h-\u003eval, h}); // 每条链表的头节点先入堆\n        ListNode dummy(0);\n        ListNode* tail = \u0026dummy;\n        while (!pq.empty()) {\n            ListNode* node = pq.top().second; // 取出全局最小的节点\n            pq.pop();\n            tail-\u003enext = node;                // 接到结果链表尾部\n            tail = tail-\u003enext;\n            if (node-\u003enext) pq.push({node-\u003enext-\u003eval, node-\u003enext}); // 它所属链表的下一节点补进堆\n        }\n        return dummy.next;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ed8mpv2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ed8mpv2","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"35. LRU 缓存（中等 · No.146）"}]},{"ID":"20261001212411-2wimfuo","Type":"NodeParagraph","Properties":{"id":"20261001212411-2wimfuo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：设计并实现 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"LRUCache"},{"Type":"NodeText","Data":" 类：构造时给定容量 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"capacity"},{"Type":"NodeText","Data":"；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"get(key)"},{"Type":"NodeText","Data":" 若 key 存在则返回对应值，否则返回 -1；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"put(key, value)"},{"Type":"NodeText","Data":" 若 key 已存在则更新值，否则插入；当键数量超过容量时，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"淘汰最久未使用（Least Recently Used）的键"},{"Type":"NodeText","Data":"。要求两个操作的平均时间复杂度都是 O(1)。"}]},{"ID":"20261001212411-9kjcmvo","Type":"NodeParagraph","Properties":{"id":"20261001212411-9kjcmvo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：哈希表 + 双向链表的经典组合，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"key -\u0026gt; 节点地址"},{"Type":"NodeText","Data":" 的哈希表保证 O(1) 查找，双向链表维护访问顺序（表头最新、表尾最旧）："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"get"},{"Type":"NodeText","Data":" 时把命中节点摘下挪到表头；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"put"},{"Type":"NodeText","Data":" 时若已存在先删旧节点，满了就删表尾（同时从哈希表移除），再插入表头，全部操作 O(1)。"}]},{"ID":"20261001212411-4jp8tya","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-4jp8tya","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class LRUCache {\n    struct Node {                 // 双向链表节点：既存 key 又存 value\n        int key, val;             // 存 key 是为了淘汰表尾时能从哈希表里也删掉它\n        Node *prev, *next;\n        Node(int k = 0, int v = 0) : key(k), val(v), prev(nullptr), next(nullptr) {}\n    };\n    int capacity_;\n    unordered_map\u003cint, Node*\u003e cache_; // key -\u003e 该节点在链表中的地址\n    Node *head_, *tail_;              // 两个哑结点：head_ 之后是最新，tail_ 之前是最旧\n\n    void remove(Node* node) {         // 把节点从链表中摘下来\n        node-\u003eprev-\u003enext = node-\u003enext;\n        node-\u003enext-\u003eprev = node-\u003eprev;\n    }\n    void pushFront(Node* node) {      // 把节点插到最前面（表示「刚刚被使用过」）\n        node-\u003enext = head_-\u003enext;\n        node-\u003eprev = head_;\n        head_-\u003enext-\u003eprev = node;\n        head_-\u003enext = node;\n    }\n\npublic:\n    LRUCache(int capacity) : capacity_(capacity) {\n        head_ = new Node();          // 初始化双向链表，头尾相连\n        tail_ = new Node();\n        head_-\u003enext = tail_;\n        tail_-\u003eprev = head_;\n    }\n\n    int get(int key) {\n        auto it = cache_.find(key);\n        if (it == cache_.end()) return -1; // 不存在\n        Node* node = it-\u003esecond;\n        remove(node);        // 先摘下来\n        pushFront(node);     // 再放到最前面（标记为最近使用）\n        return node-\u003eval;\n    }\n\n    void put(int key, int value) {\n        auto it = cache_.find(key);\n        if (it != cache_.end()) { // key 已存在：更新值并挪到最前\n            Node* node = it-\u003esecond;\n            node-\u003eval = value;\n            remove(node);\n            pushFront(node);\n            return;\n        }\n        if ((int)cache_.size() == capacity_) { // 容量满了：淘汰链表最尾部（最久未使用）的那个\n            Node* old = tail_-\u003eprev;\n            remove(old);\n            cache_.erase(old-\u003ekey); // 哈希表里也要删掉\n            delete old;             // 释放内存\n        }\n        Node* node = new Node(key, value); // 插入新节点到最前面\n        cache_[key] = node;\n        pushFront(node);\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-hpq6ix1","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-hpq6ix1","updated":"20261001212411"}},{"ID":"20261001212411-u14rz40","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-u14rz40","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"八、二叉树（15 题）"}]},{"ID":"20261001212411-fef6644","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-fef6644","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"36. 二叉树的中序遍历（简单 · No.94）"}]},{"ID":"20261001212411-n5a5fnn","Type":"NodeParagraph","Properties":{"id":"20261001212411-n5a5fnn","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，返回它的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中序遍历"},{"Type":"NodeText","Data":"（顺序为「左子树 → 根 → 右子树」）结果。进阶：用迭代（非递归）方式实现。"}]},{"ID":"20261001212411-b9488e1","Type":"NodeParagraph","Properties":{"id":"20261001212411-b9488e1","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：迭代栈模拟递归：一路把左子节点压栈直到为空，弹栈访问并转向右子树，重复至栈空且指针为空，O(n) 时间、O(h) 空间（h 为树高）。"}]},{"ID":"20261001212411-olg7clo","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-olg7clo","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e inorderTraversal(TreeNode* root) {\n        vector\u003cint\u003e ans;\n        stack\u003cTreeNode*\u003e st;\n        TreeNode* cur = root;\n        while (cur || !st.empty()) { // 当前节点为空且栈也空时才结束\n            while (cur) {            // 一路向左，把沿途节点全压栈（这些是最先要访问的）\n                st.push(cur);\n                cur = cur-\u003eleft;\n            }\n            cur = st.top();          // 左边走不动了，弹出栈顶访问\n            st.pop();\n            ans.push_back(cur-\u003eval);\n            cur = cur-\u003eright;        // 转向右子树，重复上面的过程\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-j6y46pb","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-j6y46pb","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"37. 二叉树的最大深度（简单 · No.104）"}]},{"ID":"20261001212411-17j2au6","Type":"NodeParagraph","Properties":{"id":"20261001212411-17j2au6","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，返回它的最大深度（从根节点到最远叶子节点路径上的节点数）。"}]},{"ID":"20261001212411-rcd0cxa","Type":"NodeParagraph","Properties":{"id":"20261001212411-rcd0cxa","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：递归，空节点深度为 0，否则深度 = 1 + max(左子树深度, 右子树深度)，自底向上返回，O(n)。"}]},{"ID":"20261001212411-v4c0i7j","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-v4c0i7j","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int maxDepth(TreeNode* root) {\n        if (!root) return 0; // 空树深度为 0\n        // 自己算 1 层，再加上左右子树里更高的那一棵\n        return 1 + max(maxDepth(root-\u003eleft), maxDepth(root-\u003eright));\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-61rhzq3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-61rhzq3","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"38. 翻转二叉树（简单 · No.226）"}]},{"ID":"20261001212411-yawdjmv","Type":"NodeParagraph","Properties":{"id":"20261001212411-yawdjmv","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，翻转这棵二叉树（交换每个节点的左右孩子）并返回根节点。"}]},{"ID":"20261001212411-bd9eqfx","Type":"NodeParagraph","Properties":{"id":"20261001212411-bd9eqfx","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：前序/后序递归均可——先交换当前节点的左右子树，再对左右子树分别递归翻转，最终整棵树镜像翻转，O(n)。"}]},{"ID":"20261001212411-qwm5n1e","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-qwm5n1e","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    TreeNode* invertTree(TreeNode* root) {\n        if (!root) return nullptr;\n        swap(root-\u003eleft, root-\u003eright); // 交换当前节点的左右孩子\n        invertTree(root-\u003eleft);        // 递归翻转（现在的）左子树\n        invertTree(root-\u003eright);       // 递归翻转（现在的）右子树\n        return root;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-eqat5ye","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-eqat5ye","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"39. 对称二叉树（简单 · No.101）"}]},{"ID":"20261001212411-e9agp8w","Type":"NodeParagraph","Properties":{"id":"20261001212411-e9agp8w","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，检查它是否"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"轴对称"},{"Type":"NodeText","Data":"（即左右两棵子树互为镜像）。"}]},{"ID":"20261001212411-bxkv5fl","Type":"NodeParagraph","Properties":{"id":"20261001212411-bxkv5fl","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：定义镜像判断函数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"isMirror(a, b)"},{"Type":"NodeText","Data":"：两节点都空为真、恰一空为假、值不等为假，否则递归比较「a 的左子树与 b 的右子树、a 的右子树与 b 的左子树」是否都镜像相等，O(n)。"}]},{"ID":"20261001212411-9wb9pm5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-9wb9pm5","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    bool mirror(TreeNode* a, TreeNode* b) { // 判断 a、b 两棵子树是否互为镜像\n        if (!a \u0026\u0026 !b) return true;          // 都为空，对称\n        if (!a || !b) return false;         // 只有一个为空，不对称\n        // 根值相同，且 a 的左 ↔ b 的右、a 的右 ↔ b 的左 也互为镜像\n        return a-\u003eval == b-\u003eval \u0026\u0026 mirror(a-\u003eleft, b-\u003eright)\n                                \u0026\u0026 mirror(a-\u003eright, b-\u003eleft);\n    }\npublic:\n    bool isSymmetric(TreeNode* root) {\n        return !root || mirror(root-\u003eleft, root-\u003eright); // 空树视为对称\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-p196ypz","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-p196ypz","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"40. 二叉树的直径（简单 · No.543）"}]},{"ID":"20261001212411-2xgidn4","Type":"NodeParagraph","Properties":{"id":"20261001212411-2xgidn4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，返回树的直径——即"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"任意两个节点之间最长路径的边数"},{"Type":"NodeText","Data":"。这条路径不一定经过根节点。"}]},{"ID":"20261001212411-l3tmhby","Type":"NodeParagraph","Properties":{"id":"20261001212411-l3tmhby","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：后序 DFS 返回以该节点为起点向下的最大深度，路过节点时用「左深度 + 右深度」更新全局直径答案（即经过该节点的最长路径边数），每个节点只被访问一次，O(n)。"}]},{"ID":"20261001212411-x03eogm","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-x03eogm","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    int ans = 0;\n    int depth(TreeNode* node) { // 返回以 node 为起点向下的最大深度（边数）\n        if (!node) return 0;\n        int l = depth(node-\u003eleft);\n        int r = depth(node-\u003eright);\n        // 经过 node 的最长路径 = 左子树最深 + 右子树最深，更新全局答案\n        ans = max(ans, l + r);\n        return 1 + max(l, r); // 往上返回「单边」最大深度\n    }\npublic:\n    int diameterOfBinaryTree(TreeNode* root) {\n        depth(root); // 遍历过程中自动维护答案\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-df26bi6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-df26bi6","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"41. 二叉树的层序遍历（中等 · No.102）"}]},{"ID":"20261001212411-yzrmxum","Type":"NodeParagraph","Properties":{"id":"20261001212411-yzrmxum","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，返回按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"层序遍历"},{"Type":"NodeText","Data":"（从上到下、每层从左到右）得到的节点值，结果是一个二维数组，每个子数组代表一层。"}]},{"ID":"20261001212411-riiblfp","Type":"NodeParagraph","Properties":{"id":"20261001212411-riiblfp","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：BFS 队列，根入队后每次记录当前队列大小即该层节点数，弹出这些节点、把子节点入队，逐层收集成一个二维结果，O(n)。"}]},{"ID":"20261001212411-bqfcbaw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-bqfcbaw","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cvector\u003cint\u003e\u003e levelOrder(TreeNode* root) {\n        vector\u003cvector\u003cint\u003e\u003e ans;\n        if (!root) return ans;\n        queue\u003cTreeNode*\u003e q;\n        q.push(root);\n        while (!q.empty()) {\n            int sz = q.size(); // 关键：先记住「这一层有多少个节点」\n            vector\u003cint\u003e level;\n            while (sz--) {     // 只处理这一层的 sz 个节点，新入队的属于下一层\n                TreeNode* node = q.front();\n                q.pop();\n                level.push_back(node-\u003eval);\n                if (node-\u003eleft) q.push(node-\u003eleft);\n                if (node-\u003eright) q.push(node-\u003eright);\n            }\n            ans.push_back(move(level)); // 一层收完，放进答案\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-tmwil0a","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-tmwil0a","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"42. 将有序数组转换为二叉搜索树（简单 · No.108）"}]},{"ID":"20261001212411-jt6ii3u","Type":"NodeParagraph","Properties":{"id":"20261001212411-jt6ii3u","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"升序排列"},{"Type":"NodeText","Data":"的整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，将其转换为一棵"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高度平衡"},{"Type":"NodeText","Data":"的二叉搜索树（BST）。高度平衡指每个节点的左右两棵子树深度差不超过 1。"}]},{"ID":"20261001212411-ovs6y1k","Type":"NodeParagraph","Properties":{"id":"20261001212411-ovs6y1k","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：每次取区间中点作为根（保证左右子树节点数相差不超过 1、树高平衡），再对左右半区间递归构造，类似二分查找的递归结构，O(n)。"}]},{"ID":"20261001212411-tsveqv1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-tsveqv1","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    TreeNode* build(vector\u003cint\u003e\u0026 nums, int l, int r) {\n        if (l \u003e r) return nullptr;         // 区间为空，没有节点\n        int mid = l + (r - l) / 2;         // 取中点当根，天然保证左右子树数量均衡\n        TreeNode* node = new TreeNode(nums[mid]);\n        node-\u003eleft = build(nums, l, mid - 1);   // 左半区间构造左子树\n        node-\u003eright = build(nums, mid + 1, r);  // 右半区间构造右子树\n        return node;\n    }\npublic:\n    TreeNode* sortedArrayToBST(vector\u003cint\u003e\u0026 nums) {\n        return build(nums, 0, nums.size() - 1);\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-5ty3ks6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-5ty3ks6","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"43. 验证二叉搜索树（中等 · No.98）"}]},{"ID":"20261001212411-mdqvr1d","Type":"NodeParagraph","Properties":{"id":"20261001212411-mdqvr1d","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，判断它是否是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有效的二叉搜索树"},{"Type":"NodeText","Data":"：任意节点的左子树中所有值都"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"严格小于"},{"Type":"NodeText","Data":"该节点，右子树中所有值都"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"严格大于"},{"Type":"NodeText","Data":"该节点。"}]},{"ID":"20261001212411-au4mvj5","Type":"NodeParagraph","Properties":{"id":"20261001212411-au4mvj5","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：递归时携带开区间上下界（用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"long long"},{"Type":"NodeText","Data":" 防止溢出）：左子树所有值必须落在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(low, root-\u0026gt;val)"},{"Type":"NodeText","Data":" 内，右子树落在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(root-\u0026gt;val, high)"},{"Type":"NodeText","Data":" 内，任一不满足即返回 false，O(n)。"}]},{"ID":"20261001212411-dfxzw1d","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-dfxzw1d","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    // node 的整棵子树必须严格落在开区间 (low, high) 内\n    bool valid(TreeNode* node, long long low, long long high) {\n        if (!node) return true;\n        if (node-\u003eval \u003c= low || node-\u003eval \u003e= high) return false; // 越界即非法\n        // 左子树的上界收紧为当前值，右子树的下界收紧为当前值\n        return valid(node-\u003eleft, low, node-\u003eval)\n            \u0026\u0026 valid(node-\u003eright, node-\u003eval, high);\n    }\npublic:\n    bool isValidBST(TreeNode* root) {\n        return valid(root, LLONG_MIN, LLONG_MAX); // 根节点不受限制，用无穷大开区间\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-qgqpd02","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-qgqpd02","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"44. 二叉搜索树中第 K 小的元素（中等 · No.230）"}]},{"ID":"20261001212411-ta8twgo","Type":"NodeParagraph","Properties":{"id":"20261001212411-ta8twgo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一棵二叉搜索树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"，返回树中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第 k 小"},{"Type":"NodeText","Data":"的元素值（k 从 1 开始计数）。"}]},{"ID":"20261001212411-ku3h3ii","Type":"NodeParagraph","Properties":{"id":"20261001212411-ku3h3ii","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：BST 中序遍历天然得到升序序列，用栈迭代中序，边弹出边计数，第 k 个弹出的节点即答案，平均 O(H + k)。"}]},{"ID":"20261001212411-04ejg0y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-04ejg0y","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int kthSmallest(TreeNode* root, int k) {\n        stack\u003cTreeNode*\u003e st;\n        TreeNode* cur = root;\n        while (cur || !st.empty()) {\n            while (cur) { // 中序遍历的固定套路：一路向左压栈\n                st.push(cur);\n                cur = cur-\u003eleft;\n            }\n            cur = st.top();\n            st.pop();\n            if (--k == 0) return cur-\u003eval; // 中序第 k 个弹出的就是第 k 小\n            cur = cur-\u003eright;\n        }\n        return -1;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-xu8hruu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-xu8hruu","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"45. 二叉树的右视图（中等 · No.199）"}]},{"ID":"20261001212411-hp6ielz","Type":"NodeParagraph","Properties":{"id":"20261001212411-hp6ielz","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树的根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，想象自己站在树的右侧，按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"从上到下"},{"Type":"NodeText","Data":"的顺序返回能看到的节点值（也就是每一层最右边的那个节点）。"}]},{"ID":"20261001212411-q8bhf15","Type":"NodeParagraph","Properties":{"id":"20261001212411-q8bhf15","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：层序 BFS，每层结束时队列里最后一个节点就是该层从右侧看到的节点，依次收集即可；也可以用先右后左的 DFS 按深度记录第一个到达的节点，O(n)。"}]},{"ID":"20261001212411-vzt37d5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-vzt37d5","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e rightSideView(TreeNode* root) {\n        vector\u003cint\u003e ans;\n        if (!root) return ans;\n        queue\u003cTreeNode*\u003e q;\n        q.push(root);\n        while (!q.empty()) {\n            int sz = q.size();\n            for (int i = 0; i \u003c sz; ++i) {\n                TreeNode* node = q.front();\n                q.pop();\n                if (i == sz - 1) ans.push_back(node-\u003eval); // 每层的最后一个节点，就是右侧能看到的\n                if (node-\u003eleft) q.push(node-\u003eleft);\n                if (node-\u003eright) q.push(node-\u003eright);\n            }\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-fdmxtdn","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-fdmxtdn","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"46. 二叉树展开为链表（中等 · No.114）"}]},{"ID":"20261001212411-x09r5hk","Type":"NodeParagraph","Properties":{"id":"20261001212411-x09r5hk","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，将它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原地展开成一个单链表"},{"Type":"NodeText","Data":"：展开后各节点只通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"right"},{"Type":"NodeText","Data":" 指针串联，顺序与二叉树的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"前序遍历"},{"Type":"NodeText","Data":"一致，同时所有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"left"},{"Type":"NodeText","Data":" 指针都置为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"null"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-n6qir7p","Type":"NodeParagraph","Properties":{"id":"20261001212411-n6qir7p","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：按「根 → 右 → 左」的逆前序遍历（右子树先处理），用成员指针 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev"},{"Type":"NodeText","Data":" 记录上一个处理的节点：先把当前节点的右指针指向 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev"},{"Type":"NodeText","Data":"、左指针置空，再让 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev = node"},{"Type":"NodeText","Data":"，最终自然形成与前序遍历一致的单链，O(n)、O(h) 栈空间。"}]},{"ID":"20261001212411-x4bitey","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-x4bitey","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    TreeNode* prev = nullptr; // 已经处理好的那一段链表的头（它是后处理的，所以顺序是对的）\n    void dfs(TreeNode* node) {\n        if (!node) return;\n        dfs(node-\u003eright);                 // 先处理右子树（逆前序）\n        dfs(node-\u003eleft);                  // 再处理左子树\n        node-\u003eright = prev;               // 让当前节点指向已拼好的链表\n        node-\u003eleft = nullptr;             // 左指针必须置空\n        prev = node;                      // 当前节点成为新的链头\n    }\npublic:\n    void flatten(TreeNode* root) {\n        dfs(root);\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-bv2ng2e","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-bv2ng2e","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"47. 从前序与中序遍历序列构造二叉树（中等 · No.105）"}]},{"ID":"20261001212411-sjfwcq3","Type":"NodeParagraph","Properties":{"id":"20261001212411-sjfwcq3","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一棵二叉树的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"前序遍历"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"preorder"},{"Type":"NodeText","Data":" 与"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中序遍历"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"inorder"},{"Type":"NodeText","Data":"（所有节点值互不相同），请构造并返回这棵二叉树。"}]},{"ID":"20261001212411-gxyw5vn","Type":"NodeParagraph","Properties":{"id":"20261001212411-gxyw5vn","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：前序第一个是根，用哈希表记录中序里每个值的下标从而 O(1) 找到根的位置，根左侧是左子树、右侧是右子树，再对左右区间递归构造；前序区间长度与中序一致，整体 O(n)。"}]},{"ID":"20261001212411-qx70nex","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-qx70nex","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    unordered_map\u003cint, int\u003e pos; // 值 -\u003e 它在中序遍历中的下标，用来 O(1) 定位根\n    TreeNode* build(vector\u003cint\u003e\u0026 pre, vector\u003cint\u003e\u0026 in, int pl, int pr, int il, int ir) {\n        if (pl \u003e pr) return nullptr;      // 区间为空\n        int rootVal = pre[pl];            // 前序的第一个元素就是当前子树的根\n        int k = pos[rootVal];             // 根在中序里的位置，左边是左子树、右边是右子树\n        int leftSize = k - il;            // 左子树的节点个数\n        TreeNode* node = new TreeNode(rootVal);\n        // 前序区间、中序区间都要按 leftSize 对应着切开\n        node-\u003eleft = build(pre, in, pl + 1, pl + leftSize, il, k - 1);\n        node-\u003eright = build(pre, in, pl + leftSize + 1, pr, k + 1, ir);\n        return node;\n    }\npublic:\n    TreeNode* buildTree(vector\u003cint\u003e\u0026 preorder, vector\u003cint\u003e\u0026 inorder) {\n        for (int i = 0; i \u003c inorder.size(); ++i) pos[inorder[i]] = i; // 预处理下标表\n        return build(preorder, inorder, 0, preorder.size() - 1,\n                     0, inorder.size() - 1);\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-20f3a08","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-20f3a08","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"48. 路径总和 III（中等 · No.437）"}]},{"ID":"20261001212411-acmn2fc","Type":"NodeParagraph","Properties":{"id":"20261001212411-acmn2fc","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"targetSum"},{"Type":"NodeText","Data":"，返回"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"路径和等于 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"targetSum"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 的路径数目"},{"Type":"NodeText","Data":"。路径不需要从根节点开始，也不需要在叶子节点结束，但"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"必须从上往下"},{"Type":"NodeText","Data":"（只能由父节点指向子节点）。"}]},{"ID":"20261001212411-1bkbbm6","Type":"NodeParagraph","Properties":{"id":"20261001212411-1bkbbm6","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：前缀和 + 哈希表的树上 DFS：维护从根到当前节点的路径前缀和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur"},{"Type":"NodeText","Data":"，若哈希表中存在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cur - target"},{"Type":"NodeText","Data":" 则说明中间某段子路径和等于 target、次数累加，回溯时把当前前缀和的计数减回去（保证路径不跨过当前分支），O(n)。"}]},{"ID":"20261001212411-34krx3n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-34krx3n","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    unordered_map\u003clong long, int\u003e cnt; // 前缀和 -\u003e 在「根到当前节点」这条路径上出现的次数\n    int ans = 0;\n    void dfs(TreeNode* node, long long cur, long long target) {\n        if (!node) return;\n        cur += node-\u003eval;                    // 更新当前前缀和\n        ans += cnt[cur - target];            // 之前有多少个前缀能凑出 target，就新增多少条路径\n        ++cnt[cur];                          // 把当前前缀和登记进表\n        dfs(node-\u003eleft, cur, target);\n        dfs(node-\u003eright, cur, target);\n        --cnt[cur];                          // 回溯：离开这条分支时把登记撤销，避免污染其他分支\n    }\npublic:\n    int pathSum(TreeNode* root, long long targetSum) {\n        cnt[0] = 1; // 空前缀和为 0，表示「从根开始就算一条路径」\n        dfs(root, 0, targetSum);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ikdzjv1","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ikdzjv1","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"49. 二叉树的最近公共祖先（中等 · No.236）"}]},{"ID":"20261001212411-mubb9h2","Type":"NodeParagraph","Properties":{"id":"20261001212411-mubb9h2","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":" 以及两个节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"q"},{"Type":"NodeText","Data":"，返回它们的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最近公共祖先（LCA）"},{"Type":"NodeText","Data":"——即在树中同时拥有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"q"},{"Type":"NodeText","Data":" 作为后代（允许自身）的那个最深节点。"}]},{"ID":"20261001212411-zkx8wqx","Type":"NodeParagraph","Properties":{"id":"20261001212411-zkx8wqx","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：后序递归，若当前节点为空或等于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"p"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"q"},{"Type":"NodeText","Data":" 直接返回它；否则在左右子树中查找，若左右各找到一个说明当前节点就是最近公共祖先，否则返回非空的那一侧的结果，O(n)。"}]},{"ID":"20261001212411-nrujqnt","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-nrujqnt","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {\n        if (!root || root == p || root == q) return root; // 命中目标节点（或走到底），直接返回\n        TreeNode* left = lowestCommonAncestor(root-\u003eleft, p, q);   // 去左子树找\n        TreeNode* right = lowestCommonAncestor(root-\u003eright, p, q); // 去右子树找\n        if (left \u0026\u0026 right) return root; // 两边各找到一个 ⇒ 当前节点就是分叉点，即最近公共祖先\n        return left ? left : right;     // 只有一边找到 ⇒ 结果就在那一边\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-9q3i8kg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-9q3i8kg","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"50. 二叉树中的最大路径和（困难 · No.124）"}]},{"ID":"20261001212411-pjgqtv0","Type":"NodeParagraph","Properties":{"id":"20261001212411-pjgqtv0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定二叉树根节点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root"},{"Type":"NodeText","Data":"，返回它的最大路径和。路径被定义为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"从树中任意节点出发、沿父子边到达任意节点的序列"},{"Type":"NodeText","Data":"，同一个节点在路径中最多出现一次，且路径中至少包含一个节点。"}]},{"ID":"20261001212411-hly2w43","Type":"NodeParagraph","Properties":{"id":"20261001212411-hly2w43","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：后序 DFS，对每个节点计算「以它为顶点、只能往下延伸的单边最大贡献」"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"gain = max(0, 左/右孩子的贡献)"},{"Type":"NodeText","Data":"，返回值为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"node-\u0026gt;val + max(l, r)"},{"Type":"NodeText","Data":"（只能带一条边往上延伸）；同时用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"node-\u0026gt;val + 左贡献 + 右贡献"},{"Type":"NodeText","Data":" 更新全局答案（即以该节点为拐点的完整路径和），负贡献一律按 0 丢弃，O(n)。"}]},{"ID":"20261001212411-itutunl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-itutunl","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    int ans = INT_MIN;\n    int gain(TreeNode* node) { // 返回「以 node 为起点的单边最大贡献」（只能选一条岔路往上延伸）\n        if (!node) return 0;\n        int l = max(0, gain(node-\u003eleft));  // 左边贡献为负就干脆不要\n        int r = max(0, gain(node-\u003eright)); // 右边同理\n        ans = max(ans, node-\u003eval + l + r); // 以 node 为「拐点」的完整路径：左 + 自己 + 右\n        return node-\u003eval + max(l, r);      // 往上只能带一条路，取较大的那侧\n    }\npublic:\n    int maxPathSum(TreeNode* root) {\n        gain(root);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-uqkkqjy","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-uqkkqjy","updated":"20261001212411"}},{"ID":"20261001212411-z5g1zeg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-z5g1zeg","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"九、图论（4 题）"}]},{"ID":"20261001212411-inepr9v","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-inepr9v","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"51. 岛屿数量（中等 · No.200）"}]},{"ID":"20261001212411-wwlb8v8","Type":"NodeParagraph","Properties":{"id":"20261001212411-wwlb8v8","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"'1'"},{"Type":"NodeText","Data":"（陆地）和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"'0'"},{"Type":"NodeText","Data":"（水）组成的二维网格 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"grid"},{"Type":"NodeText","Data":"，求岛屿的数量。岛屿由水平或竖直方向相邻的陆地连接而成，四周被水包围。"}]},{"ID":"20261001212411-7claoed","Type":"NodeParagraph","Properties":{"id":"20261001212411-7claoed","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：遍历网格，遇到 '1' 就答案加一，并从该点 BFS/DFS 把整座岛的 '1' 全部改成 '0'（标记访问），保证每个格子只被处理常数次，时间复杂度 O(mn)。"}]},{"ID":"20261001212411-f6z0jqq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-f6z0jqq","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    void dfs(vector\u003cvector\u003cchar\u003e\u003e\u0026 grid, int i, int j) {\n        int m = grid.size(), n = grid[0].size();\n        if (i \u003c 0 || i \u003e= m || j \u003c 0 || j \u003e= n || grid[i][j] != '1') return; // 越界或不是陆地，返回\n        grid[i][j] = '0'; // 把它「沉掉」，相当于标记已访问，避免重复计数\n        dfs(grid, i + 1, j); // 上下左右四个方向继续扩散\n        dfs(grid, i - 1, j);\n        dfs(grid, i, j + 1);\n        dfs(grid, i, j - 1);\n    }\npublic:\n    int numIslands(vector\u003cvector\u003cchar\u003e\u003e\u0026 grid) {\n        int ans = 0;\n        for (int i = 0; i \u003c grid.size(); ++i)\n            for (int j = 0; j \u003c grid[0].size(); ++j)\n                if (grid[i][j] == '1') { // 发现一块还没被淹过的陆地，说明是一座新的岛\n                    ++ans;\n                    dfs(grid, i, j);     // 把整座岛淹掉\n                }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-6ua3f3k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-6ua3f3k","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"52. 腐烂的橘子（中等 · No.994）"}]},{"ID":"20261001212411-a61nrna","Type":"NodeParagraph","Properties":{"id":"20261001212411-a61nrna","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定网格 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"grid"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0"},{"Type":"NodeText","Data":" 表示空格、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"1"},{"Type":"NodeText","Data":" 表示新鲜橘子、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"2"},{"Type":"NodeText","Data":" 表示腐烂橘子。每分钟，腐烂橘子会把上下左右四个方向上相邻的新鲜橘子也变腐烂。返回"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"直到没有新鲜橘子为止所需的最少分钟数"},{"Type":"NodeText","Data":"；若不可能全部腐烂则返回 -1。"}]},{"ID":"20261001212411-hf27qf9","Type":"NodeParagraph","Properties":{"id":"20261001212411-hf27qf9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：多源 BFS，一开始把所有腐烂橘子同时入队作为第 0 层，每扩散一层时间加 1，统计最终还剩多少新鲜橘子（非零即无法感染），每格只入队一次，O(mn)。"}]},{"ID":"20261001212411-xh78f6w","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-xh78f6w","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int orangesRotting(vector\u003cvector\u003cint\u003e\u003e\u0026 grid) {\n        int m = grid.size(), n = grid[0].size();\n        queue\u003cpair\u003cint, int\u003e\u003e q;\n        int fresh = 0;\n        for (int i = 0; i \u003c m; ++i)\n            for (int j = 0; j \u003c n; ++j) {\n                if (grid[i][j] == 2) q.push({i, j}); // 所有腐烂橘子同时入队（多源 BFS 的起点）\n                else if (grid[i][j] == 1) ++fresh;    // 顺便统计新鲜橘子总数\n            }\n        int dirs[4][2] = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}}; // 四个方向\n        int minutes = 0;\n        while (!q.empty() \u0026\u0026 fresh \u003e 0) { // 还有新鲜橘子才需要继续扩散\n            int sz = q.size();            // 当前这一层（同一分钟）要处理的腐烂橘子数\n            while (sz--) {\n                int x = q.front().first, y = q.front().second;\n                q.pop();\n                for (auto\u0026 d : dirs) {\n                    int nx = x + d[0], ny = y + d[1];\n                    if (nx \u003c 0 || nx \u003e= m || ny \u003c 0 || ny \u003e= n) continue; // 越界\n                    if (grid[nx][ny] != 1) continue;                      // 不是新鲜橘子\n                    grid[nx][ny] = 2;  // 感染它\n                    --fresh;\n                    q.push({nx, ny});  // 下一分钟由它继续向外扩散\n                }\n            }\n            ++minutes; // 一层处理完，时间 +1\n        }\n        return fresh == 0 ? minutes : -1; // 还有新鲜橘子剩下 ⇒ 无法全部腐烂\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-xj3ax8h","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-xj3ax8h","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"53. 课程表（中等 · No.207）"}]},{"ID":"20261001212411-pq19gbv","Type":"NodeParagraph","Properties":{"id":"20261001212411-pq19gbv","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：总共需要修 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"numCourses"},{"Type":"NodeText","Data":" 门课程，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prerequisites[i] = [a, b]"},{"Type":"NodeText","Data":" 表示修课程 a 之前必须先修完课程 b。判断"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"是否可能修完所有课程"},{"Type":"NodeText","Data":"（即依赖关系图中没有环）。"}]},{"ID":"20261001212411-f8p5r7b","Type":"NodeParagraph","Properties":{"id":"20261001212411-f8p5r7b","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：拓扑排序（Kahn 算法）判环：统计每门课的入度，把入度为 0 的课入队，每弹出一门课就把依赖它的课入度减一、减到 0 就入队，最后统计已出队的课程数，若等于总课程数说明可以修完（无环），O(V + E)。"}]},{"ID":"20261001212411-eahs4ne","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-eahs4ne","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool canFinish(int numCourses, vector\u003cvector\u003cint\u003e\u003e\u0026 prerequisites) {\n        vector\u003cvector\u003cint\u003e\u003e graph(numCourses);      // 邻接表：graph[b] 存所有「依赖 b」的课 a\n        vector\u003cint\u003e indeg(numCourses, 0);           // 每门课的前置课程数量（入度）\n        for (auto\u0026 p : prerequisites) {\n            graph[p[1]].push_back(p[0]);            // 先 p[1] 后 p[0]，建一条 p[1] → p[0] 的边\n            ++indeg[p[0]];\n        }\n        queue\u003cint\u003e q;\n        for (int i = 0; i \u003c numCourses; ++i)\n            if (indeg[i] == 0) q.push(i);           // 没有前置要求的课，随时可以修\n        int taken = 0;                              // 已修课程数\n        while (!q.empty()) {\n            int cur = q.front();\n            q.pop();\n            ++taken;\n            for (int nxt : graph[cur])\n                if (--indeg[nxt] == 0) q.push(nxt); // 前置课修完了，这门课也解锁了\n        }\n        return taken == numCourses;                 // 全部修完 ⇒ 无环；否则剩下的课互相死锁（有环）\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-mticpdx","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-mticpdx","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"54. 实现 Trie（前缀树）（中等 · No.208）"}]},{"ID":"20261001212411-xz9qj7x","Type":"NodeParagraph","Properties":{"id":"20261001212411-xz9qj7x","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：实现 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Trie"},{"Type":"NodeText","Data":" 类："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"insert(word)"},{"Type":"NodeText","Data":" 插入一个单词；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"search(word)"},{"Type":"NodeText","Data":" 判断该单词是否完整存在于树中；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"startsWith(prefix)"},{"Type":"NodeText","Data":" 判断树中是否有以该前缀开头的单词。"}]},{"ID":"20261001212411-ue8cnbl","Type":"NodeParagraph","Properties":{"id":"20261001212411-ue8cnbl","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：每个节点挂 26 个子节点指针和一个「是否为单词结尾」标记："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"insert"},{"Type":"NodeText","Data":" 沿路径创建缺失的子节点并在末尾打标记，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"search"},{"Type":"NodeText","Data":" 按字符逐层走并要求末尾有标记，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"startsWith"},{"Type":"NodeText","Data":" 只要求前缀路径存在即可，三者均为 O(单词长度)。"}]},{"ID":"20261001212411-kovbjo9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-kovbjo9","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Trie {\n    struct Node {\n        Node* next[26] = {}; // 26 个字母对应的子节点，初始全为 nullptr\n        bool end = false;    // 是否有某个单词在这个节点处结束\n    };\n    Node* root = new Node();\n\npublic:\n    Trie() {}\n\n    void insert(string word) {\n        Node* cur = root;\n        for (char c : word) {\n            int i = c - 'a';\n            if (!cur-\u003enext[i]) cur-\u003enext[i] = new Node(); // 路径上没有就新建\n            cur = cur-\u003enext[i];\n        }\n        cur-\u003eend = true; // 最后一个节点打上「单词结尾」标记\n    }\n\n    bool search(string word) {\n        Node* cur = walk(word);\n        return cur \u0026\u0026 cur-\u003eend; // 路径走通了，并且确实有单词在这里结束\n    }\n\n    bool startsWith(string prefix) {\n        return walk(prefix) != nullptr; // 只要前缀路径能走通就行，不要求是单词结尾\n    }\n\nprivate:\n    Node* walk(const string\u0026 s) { // 沿着 s 的字符往下走，走不通返回 nullptr\n        Node* cur = root;\n        for (char c : s) {\n            int i = c - 'a';\n            if (!cur-\u003enext[i]) return nullptr;\n            cur = cur-\u003enext[i];\n        }\n        return cur;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-j5naom1","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-j5naom1","updated":"20261001212411"}},{"ID":"20261001212411-jzs9263","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-jzs9263","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十、回溯（8 题）"}]},{"ID":"20261001212411-vorsb9j","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-vorsb9j","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"55. 全排列（中等 · No.46）"}]},{"ID":"20261001212411-2dc6kmg","Type":"NodeParagraph","Properties":{"id":"20261001212411-2dc6kmg","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个不含重复数字的数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，返回它所有可能的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全排列"},{"Type":"NodeText","Data":"，顺序不限。"}]},{"ID":"20261001212411-aecnif9","Type":"NodeParagraph","Properties":{"id":"20261001212411-aecnif9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：回溯模板，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path"},{"Type":"NodeText","Data":" 存当前排列、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"used"},{"Type":"NodeText","Data":" 数组标记哪些元素已用，每层从所有未用元素中选一个放进 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path"},{"Type":"NodeText","Data":" 递归，回溯时撤销选择，递归树共 n! 个叶子，O(n · n!)。"}]},{"ID":"20261001212411-morkapa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-morkapa","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cvector\u003cint\u003e\u003e ans;\n    vector\u003cint\u003e path;\n    vector\u003cbool\u003e used;\n    void backtrack(vector\u003cint\u003e\u0026 nums) {\n        if (path.size() == nums.size()) { // 已经排满 n 个数，得到一个完整排列\n            ans.push_back(path);\n            return;\n        }\n        for (int i = 0; i \u003c nums.size(); ++i) {\n            if (used[i]) continue;   // 这个数已经用过了，跳过\n            used[i] = true;          // 做选择：标记已用\n            path.push_back(nums[i]);\n            backtrack(nums);         // 进入下一层继续选\n            path.pop_back();         // 撤销选择，回到这一层再试别的数\n            used[i] = false;\n        }\n    }\npublic:\n    vector\u003cvector\u003cint\u003e\u003e permute(vector\u003cint\u003e\u0026 nums) {\n        used.assign(nums.size(), false);\n        backtrack(nums);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-lj1yy14","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-lj1yy14","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"56. 子集（中等 · No.78）"}]},{"ID":"20261001212411-ngzssjw","Type":"NodeParagraph","Properties":{"id":"20261001212411-ngzssjw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个元素互不相同的整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，返回它的所有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"子集（幂集）"},{"Type":"NodeText","Data":"，不能包含重复子集，顺序不限。"}]},{"ID":"20261001212411-fw2sqo0","Type":"NodeParagraph","Properties":{"id":"20261001212411-fw2sqo0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：回溯时每个位置「选或不选」，或者更常见地：进入递归先记录当前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path"},{"Type":"NodeText","Data":"（它本身就是答案之一），然后从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"start"},{"Type":"NodeText","Data":" 开始逐个把元素加入并递归，保证子集不重复地生成，O(n · 2ⁿ)。"}]},{"ID":"20261001212411-y00mhhy","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-y00mhhy","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cvector\u003cint\u003e\u003e ans;\n    vector\u003cint\u003e path;\n    void backtrack(vector\u003cint\u003e\u0026 nums, int start) {\n        ans.push_back(path); // 关键：每到一个节点，当前的 path 本身就是一个合法子集\n        for (int i = start; i \u003c nums.size(); ++i) {\n            path.push_back(nums[i]);    // 把 nums[i] 加进来\n            backtrack(nums, i + 1);     // 只能从 i 后面继续选，保证不重复\n            path.pop_back();            // 撤销\n        }\n    }\npublic:\n    vector\u003cvector\u003cint\u003e\u003e subsets(vector\u003cint\u003e\u0026 nums) {\n        backtrack(nums, 0);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-n26mkss","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-n26mkss","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"57. 电话号码的字母组合（中等 · No.17）"}]},{"ID":"20261001212411-erz48h0","Type":"NodeParagraph","Properties":{"id":"20261001212411-erz48h0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个仅包含数字 2–9 的字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"digits"},{"Type":"NodeText","Data":"，返回它所有可能表示的字母组合（映射关系同电话键盘：2→abc、3→def……9→wxyz），顺序不限；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"digits"},{"Type":"NodeText","Data":" 为空时返回空数组。"}]},{"ID":"20261001212411-be8qlx9","Type":"NodeParagraph","Properties":{"id":"20261001212411-be8qlx9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：数字到字母的映射表 + 回溯，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"index"},{"Type":"NodeText","Data":" 表示当前处理到第几位数字，每层枚举该数字对应的所有字母接进 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path"},{"Type":"NodeText","Data":"，当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"index"},{"Type":"NodeText","Data":" 走到末尾即收集一个组合；位数为 n 时最多生成 4ⁿ 个组合。"}]},{"ID":"20261001212411-69dfq2w","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-69dfq2w","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    const vector\u003cstring\u003e mapping = {\"\", \"\", \"abc\", \"def\", \"ghi\", \"jkl\",\n                                    \"mno\", \"pqrs\", \"tuv\", \"wxyz\"}; // 下标 0/1 用不上，2~9 对应字母\n    vector\u003cstring\u003e ans;\n    string path;\n    void backtrack(const string\u0026 digits, int i) { // i 表示当前处理第几位数字\n        if (i == digits.size()) {        // 所有位都处理完了\n            if (!path.empty()) ans.push_back(path); // digits 为空时不会产生结果\n            return;\n        }\n        for (char c : mapping[digits[i] - '0']) { // 枚举这位数字对应的所有字母\n            path.push_back(c);\n            backtrack(digits, i + 1);             // 处理下一位\n            path.pop_back();                      // 回溯\n        }\n    }\npublic:\n    vector\u003cstring\u003e letterCombinations(string digits) {\n        backtrack(digits, 0);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-p7ms3ln","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-p7ms3ln","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"58. 组合总和（中等 · No.39）"}]},{"ID":"20261001212411-ozveucs","Type":"NodeParagraph","Properties":{"id":"20261001212411-ozveucs","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无重复元素"},{"Type":"NodeText","Data":"的候选数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"candidates"},{"Type":"NodeText","Data":" 和目标值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"，找出所有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和等于 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"target"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 的组合"},{"Type":"NodeText","Data":"；同一个数字可以被"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无限次重复选取"},{"Type":"NodeText","Data":"，答案中不能出现重复组合。"}]},{"ID":"20261001212411-ynj4n8w","Type":"NodeParagraph","Properties":{"id":"20261001212411-ynj4n8w","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先排序，回溯携带 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"start"},{"Type":"NodeText","Data":"（保证组合不重复）和剩余 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"remain"},{"Type":"NodeText","Data":"，在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"start"},{"Type":"NodeText","Data":" 处开始循环：若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"candidates[i] \u0026gt; remain"},{"Type":"NodeText","Data":" 提前剪枝退出，否则选中它并用同一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 递归（同一数字可重复使用），回溯后继续试下一个。"}]},{"ID":"20261001212411-lvoaslk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-lvoaslk","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cvector\u003cint\u003e\u003e ans;\n    vector\u003cint\u003e path;\n    void backtrack(vector\u003cint\u003e\u0026 cand, int start, int remain) {\n        if (remain == 0) {          // 正好凑够目标值\n            ans.push_back(path);\n            return;\n        }\n        for (int i = start; i \u003c cand.size(); ++i) {\n            if (cand[i] \u003e remain) break;    // 已排序，后面只会更大，直接结束这一层\n            path.push_back(cand[i]);\n            backtrack(cand, i, remain - cand[i]); // 注意传的是 i 不是 i+1 ⇒ 同一个数可以重复用\n            path.pop_back();\n        }\n    }\npublic:\n    vector\u003cvector\u003cint\u003e\u003e combinationSum(vector\u003cint\u003e\u0026 candidates, int target) {\n        sort(candidates.begin(), candidates.end()); // 排序后才能用 break 剪枝\n        backtrack(candidates, 0, target);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ykfomh3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ykfomh3","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"59. 括号生成（中等 · No.22）"}]},{"ID":"20261001212411-r5s7quq","Type":"NodeParagraph","Properties":{"id":"20261001212411-r5s7quq","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定括号的对数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":"，生成所有由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":" 对括号组成的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有效（合法）括号组合"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-f4aybfs","Type":"NodeParagraph","Properties":{"id":"20261001212411-f4aybfs","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：回溯，参数为已构造的字符串和左右括号计数：左括号只要用不满 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":" 个就能加，右括号只有在「已用右括号数 \u003c 左括号数」时才能加（保证任意前缀中右括号不超过左括号），长度达到 2n 即收集一个合法序列。"}]},{"ID":"20261001212411-liocfnx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-liocfnx","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cstring\u003e ans;\n    string path;\n    void backtrack(int n, int open, int close) {\n        if (path.size() == 2 * n) { // 长度够了，一定合法（因为每一步都保证了合法性）\n            ans.push_back(path);\n            return;\n        }\n        if (open \u003c n) {              // 左括号还没用完，可以加一个 '('\n            path.push_back('(');\n            backtrack(n, open + 1, close);\n            path.pop_back();\n        }\n        if (close \u003c open) {          // 只有右括号比左括号少时才能加 ')'，否则会出现 \"()\" 这种非法前缀\n            path.push_back(')');\n            backtrack(n, open, close + 1);\n            path.pop_back();\n        }\n    }\npublic:\n    vector\u003cstring\u003e generateParenthesis(int n) {\n        backtrack(n, 0, 0);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-0rens0d","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-0rens0d","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"60. 单词搜索（中等 · No.79）"}]},{"ID":"20261001212411-hk8hbdg","Type":"NodeParagraph","Properties":{"id":"20261001212411-hk8hbdg","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定 m×n 的字符网格 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"board"},{"Type":"NodeText","Data":" 和一个字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word"},{"Type":"NodeText","Data":"，判断 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word"},{"Type":"NodeText","Data":" 是否存在于网格中。单词必须由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"水平或竖直方向上相邻"},{"Type":"NodeText","Data":"的格子依次拼成，同一个格子不能重复使用。"}]},{"ID":"20261001212411-ckd0m9x","Type":"NodeParagraph","Properties":{"id":"20261001212411-ckd0m9x","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：在网格上做回溯 DFS，从每个等于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word[0]"},{"Type":"NodeText","Data":" 的格子出发，沿四个方向匹配下一个字符；进入前把当前格子改成特殊字符防止重复访问，返回时还原（原地标记法替代 visited 数组），任一路径匹配完整单词即返回 true。"}]},{"ID":"20261001212411-cp0sqel","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-cp0sqel","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    int m, n;\n    bool dfs(vector\u003cvector\u003cchar\u003e\u003e\u0026 board, int i, int j,\n             const string\u0026 word, int k) { // k 表示当前要匹配 word 中的第几个字符\n        if (k == word.size()) return true;                       // 整个单词都匹配完了\n        if (i \u003c 0 || i \u003e= m || j \u003c 0 || j \u003e= n) return false;    // 越界\n        if (board[i][j] != word[k]) return false;                // 字符对不上\n        char tmp = board[i][j];\n        board[i][j] = '#'; // 临时标记为「已访问」，防止同一条路径里走回头路\n        bool ok = dfs(board, i + 1, j, word, k + 1)\n               || dfs(board, i - 1, j, word, k + 1)\n               || dfs(board, i, j + 1, word, k + 1)\n               || dfs(board, i, j - 1, word, k + 1); // 四个方向任一条路能走通即可\n        board[i][j] = tmp; // 回溯：恢复原字符，供别的路径使用\n        return ok;\n    }\npublic:\n    bool exist(vector\u003cvector\u003cchar\u003e\u003e\u0026 board, string word) {\n        m = board.size();\n        n = board[0].size();\n        for (int i = 0; i \u003c m; ++i)\n            for (int j = 0; j \u003c n; ++j)\n                if (dfs(board, i, j, word, 0)) return true; // 从每个格子都试着作为起点\n        return false;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-dj6w66o","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-dj6w66o","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"61. 分割回文串（中等 · No.131）"}]},{"ID":"20261001212411-l1ti8g7","Type":"NodeParagraph","Properties":{"id":"20261001212411-l1ti8g7","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":"，将它分割成若干个子串，使"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"每个子串都是回文串"},{"Type":"NodeText","Data":"，返回所有可能的分割方案。"}]},{"ID":"20261001212411-m4hjuyd","Type":"NodeParagraph","Properties":{"id":"20261001212411-m4hjuyd","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：回溯枚举所有切割方案，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"start"},{"Type":"NodeText","Data":" 之前的已切好，从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"start"},{"Type":"NodeText","Data":" 试到末尾，只有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s[start..i]"},{"Type":"NodeText","Data":" 是回文才切下这一段入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path"},{"Type":"NodeText","Data":" 并对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i+1"},{"Type":"NodeText","Data":" 递归，回溯撤销；到达末尾时收集整个切割方案，判断回文用双指针向内收缩。"}]},{"ID":"20261001212411-iz9swn7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-iz9swn7","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cvector\u003cstring\u003e\u003e ans;\n    vector\u003cstring\u003e path;\n    bool isPal(const string\u0026 s, int l, int r) { // 判断 s[l..r] 是否为回文（双指针向内夹）\n        while (l \u003c r)\n            if (s[l++] != s[r--]) return false;\n        return true;\n    }\n    void backtrack(const string\u0026 s, int start) { // start 表示「还没切割的部分」的起点\n        if (start == s.size()) { // 整个字符串都切完了，得到一个方案\n            ans.push_back(path);\n            return;\n        }\n        for (int i = start; i \u003c s.size(); ++i)\n            if (isPal(s, start, i)) {                        // 只有这一段是回文才值得切\n                path.push_back(s.substr(start, i - start + 1));\n                backtrack(s, i + 1);                         // 从下一段继续切\n                path.pop_back();                             // 回溯\n            }\n    }\npublic:\n    vector\u003cvector\u003cstring\u003e\u003e partition(string s) {\n        backtrack(s, 0);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-p3bb3u2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-p3bb3u2","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"62. N 皇后（困难 · No.51）"}]},{"ID":"20261001212411-fz6221m","Type":"NodeParagraph","Properties":{"id":"20261001212411-fz6221m","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：将 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":" 个皇后放在 n×n 的棋盘上，使它们互不攻击（任意两个皇后不能在同一行、同一列或同一条斜线上），返回所有不同的摆放方案，用字符串数组表示棋盘（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"'Q'"},{"Type":"NodeText","Data":" 表示皇后，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"'.'"},{"Type":"NodeText","Data":" 表示空位）。"}]},{"ID":"20261001212411-w36psoj","Type":"NodeParagraph","Properties":{"id":"20261001212411-w36psoj","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：逐行回溯，用三个布尔数组记录已被占用的列、主对角线（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"row - col"},{"Type":"NodeText","Data":" 为定值）和副对角线（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"row + col"},{"Type":"NodeText","Data":" 为定值），每行找到所有安全列放皇后后递归下一行；到达底行时把棋盘收集进答案，O(n!)。"}]},{"ID":"20261001212411-cdctnyy","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-cdctnyy","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    vector\u003cvector\u003cstring\u003e\u003e ans;\n    vector\u003cstring\u003e board;              // 当前棋盘（每行一个字符串）\n    vector\u003cbool\u003e col, diag1, diag2;    // 列、主对角线、副对角线是否已被占用\n    int n;\n    void backtrack(int row) {\n        if (row == n) {                // 每一行都放好了皇后，得到一个解\n            ans.push_back(board);\n            return;\n        }\n        for (int c = 0; c \u003c n; ++c) {  // 尝试在当前行的每一列放皇后\n            int d1 = row - c + n - 1;  // 主对角线编号：同一条上 row-col 是定值，加偏移避免负数\n            int d2 = row + c;          // 副对角线编号：同一条上 row+col 是定值\n            if (col[c] || diag1[d1] || diag2[d2]) continue; // 会互相攻击，跳过\n            col[c] = diag1[d1] = diag2[d2] = true; // 占用\n            board[row][c] = 'Q';       // 落子\n            backtrack(row + 1);        // 处理下一行\n            board[row][c] = '.';       // 回溯：撤子\n            col[c] = diag1[d1] = diag2[d2] = false;\n        }\n    }\npublic:\n    vector\u003cvector\u003cstring\u003e\u003e solveNQueens(int n) {\n        this-\u003en = n;\n        col.assign(n, false);\n        diag1.assign(2 * n, false); // row-col 的取值范围是 [-(n-1), n-1]\n        diag2.assign(2 * n, false); // row+col 的取值范围是 [0, 2n-2]\n        board.assign(n, string(n, '.'));\n        backtrack(0);\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-gs5xm9m","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-gs5xm9m","updated":"20261001212411"}},{"ID":"20261001212411-7bau1f9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-7bau1f9","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十一、二分查找（6 题）"}]},{"ID":"20261001212411-u7p3xja","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-u7p3xja","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"63. 搜索插入位置（简单 · No.35）"}]},{"ID":"20261001212411-tf6n8wu","Type":"NodeParagraph","Properties":{"id":"20261001212411-tf6n8wu","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无重复元素"},{"Type":"NodeText","Data":"的升序数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和目标值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"，若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":" 存在则返回其下标，否则返回它按顺序插入数组时应处的下标。要求时间复杂度 O(log n)。"}]},{"ID":"20261001212411-vrrm7zg","Type":"NodeParagraph","Properties":{"id":"20261001212411-vrrm7zg","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：本质是求「第一个 ≥ target 的位置」（lower_bound）：采用半开区间 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[l, r)"},{"Type":"NodeText","Data":" 二分，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[mid] \u0026lt; target"},{"Type":"NodeText","Data":" 时左边界右移，否则右边界左移，返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"l"},{"Type":"NodeText","Data":" 即为插入点，O(log n)。"}]},{"ID":"20261001212411-3wdiw1q","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-3wdiw1q","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int searchInsert(vector\u003cint\u003e\u0026 nums, int target) {\n        int l = 0, r = nums.size(); // 半开区间 [l, r)，r 可能等于 n（插到末尾）\n        while (l \u003c r) {             // 区间内还有元素就继续\n            int mid = l + (r - l) / 2; // 这样写可以避免 l+r 溢出\n            if (nums[mid] \u003c target) l = mid + 1; // mid 太小，答案一定在右边\n            else r = mid;                        // mid 已经 \u003e= target，答案在 mid 或更左边\n        }\n        return l; // 循环结束时 l 就是「第一个 \u003e= target 的位置」\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-gswj5eb","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-gswj5eb","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"64. 搜索二维矩阵（中等 · No.74）"}]},{"ID":"20261001212411-nxfa2ep","Type":"NodeParagraph","Properties":{"id":"20261001212411-nxfa2ep","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定 m×n 矩阵，满足"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"每行从左到右升序，且每一行的第一个数大于上一行的最后一个数"},{"Type":"NodeText","Data":"（因此整个矩阵拉平后是一个有序数组），判断 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":" 是否存在于矩阵中。要求 O(log(m·n))。"}]},{"ID":"20261001212411-dc965eo","Type":"NodeParagraph","Properties":{"id":"20261001212411-dc965eo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：把矩阵整体当作一个长度为 m·n 的有序数组做二分：下标 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mid"},{"Type":"NodeText","Data":" 对应矩阵位置 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"matrix[mid / n][mid % n]"},{"Type":"NodeText","Data":"（n 为列数），比较后收缩左右边界，O(log(mn))。"}]},{"ID":"20261001212411-ysy4prs","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-ysy4prs","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool searchMatrix(vector\u003cvector\u003cint\u003e\u003e\u0026 matrix, int target) {\n        int m = matrix.size(), n = matrix[0].size();\n        int l = 0, r = m * n - 1; // 把二维矩阵「拉直」成一个长度为 m*n 的一维数组\n        while (l \u003c= r) {\n            int mid = l + (r - l) / 2;\n            int val = matrix[mid / n][mid % n]; // 一维下标 ↔ 二维坐标的换算：行 = mid/n，列 = mid%n\n            if (val == target) return true;\n            if (val \u003c target) l = mid + 1;\n            else r = mid - 1;\n        }\n        return false;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ebjmql4","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-ebjmql4","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"65. 在排序数组中查找元素的第一个和最后一个位置（中等 · No.34）"}]},{"ID":"20261001212411-aodqorg","Type":"NodeParagraph","Properties":{"id":"20261001212411-aodqorg","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"非递减"},{"Type":"NodeText","Data":"（可能含重复元素）的整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和目标值 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"，返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":" 在数组中出现的起始下标和结束下标；若不存在则返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[-1,-1]"},{"Type":"NodeText","Data":"。要求 O(log n)。"}]},{"ID":"20261001212411-zmq6cf8","Type":"NodeParagraph","Properties":{"id":"20261001212411-zmq6cf8","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：两次二分分别求下界：第一个位置就是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lower_bound(target)"},{"Type":"NodeText","Data":"，若该位置值不等于 target 则不存在；最后一个位置是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lower_bound(target + 1) - 1"},{"Type":"NodeText","Data":"，全程 O(log n)。"}]},{"ID":"20261001212411-1mqhaux","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-1mqhaux","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    // 求「第一个 \u003e= target 的下标」，返回值范围是 [0, n]（可能等于 n 表示不存在）\n    int lowerBound(vector\u003cint\u003e\u0026 nums, long long target) {\n        int l = 0, r = nums.size();\n        while (l \u003c r) {\n            int mid = l + (r - l) / 2;\n            if (nums[mid] \u003c target) l = mid + 1;\n            else r = mid;\n        }\n        return l;\n    }\npublic:\n    vector\u003cint\u003e searchRange(vector\u003cint\u003e\u0026 nums, int target) {\n        int first = lowerBound(nums, target);              // target 第一次出现的位置\n        if (first == nums.size() || nums[first] != target)\n            return {-1, -1};                               // 找不到 target\n        int last = lowerBound(nums, (long long)target + 1) - 1; // 第一个 \u003e target 的位置再往前一格\n        return {first, last};\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-1j7tbjy","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-1j7tbjy","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"66. 搜索旋转排序数组（中等 · No.33）"}]},{"ID":"20261001212411-7rcihkm","Type":"NodeParagraph","Properties":{"id":"20261001212411-7rcihkm","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 原本升序且元素互不相同，但在某个下标处被"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旋转"},{"Type":"NodeText","Data":"过（例如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[0,1,2,4,5,6,7]"},{"Type":"NodeText","Data":" 旋转成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[4,5,6,7,0,1,2]"},{"Type":"NodeText","Data":"）。给定 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"target"},{"Type":"NodeText","Data":"，返回它的下标，不存在则返回 -1，要求 O(log n)。"}]},{"ID":"20261001212411-sux47gn","Type":"NodeParagraph","Properties":{"id":"20261001212411-sux47gn","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：每次取中点后，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[l, mid]"},{"Type":"NodeText","Data":" 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[mid, r]"},{"Type":"NodeText","Data":" 中必有一半是有序的：若左半有序且 target 落在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[nums[l], nums[mid])"},{"Type":"NodeText","Data":" 内就去左半，否则去右半；右半有序时对称处理，O(log n)。"}]},{"ID":"20261001212411-jj1r0rr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-jj1r0rr","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int search(vector\u003cint\u003e\u0026 nums, int target) {\n        int l = 0, r = nums.size() - 1;\n        while (l \u003c= r) {\n            int mid = l + (r - l) / 2;\n            if (nums[mid] == target) return mid;\n            if (nums[l] \u003c= nums[mid]) { // 左半段 [l, mid] 是有序的\n                if (nums[l] \u003c= target \u0026\u0026 target \u003c nums[mid]) r = mid - 1; // target 就落在左半\n                else l = mid + 1;\n            } else {                    // 否则右半段 [mid, r] 一定是有序的\n                if (nums[mid] \u003c target \u0026\u0026 target \u003c= nums[r]) l = mid + 1; // target 就落在右半\n                else r = mid - 1;\n            }\n        }\n        return -1;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-dx2nq2q","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-dx2nq2q","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"67. 寻找旋转排序数组中的最小值（中等 · No.153）"}]},{"ID":"20261001212411-soa90mt","Type":"NodeParagraph","Properties":{"id":"20261001212411-soa90mt","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个元素"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互不相同"},{"Type":"NodeText","Data":"的升序数组经过若干次旋转后得到的数组，返回其中的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最小值"},{"Type":"NodeText","Data":"，要求 O(log n)。"}]},{"ID":"20261001212411-yjz2fuu","Type":"NodeParagraph","Properties":{"id":"20261001212411-yjz2fuu","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：比较 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[mid]"},{"Type":"NodeText","Data":" 与右端点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[r]"},{"Type":"NodeText","Data":"：若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[mid] \u0026gt; nums[r]"},{"Type":"NodeText","Data":" 说明最小值在右半（mid 位于左段的大数区），"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"l = mid + 1"},{"Type":"NodeText","Data":"；否则最小值在含 mid 的左半，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"r = mid"},{"Type":"NodeText","Data":"，直到区间收缩为单个元素，O(log n)。"}]},{"ID":"20261001212411-bek3bbt","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-bek3bbt","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int findMin(vector\u003cint\u003e\u0026 nums) {\n        int l = 0, r = nums.size() - 1;\n        while (l \u003c r) { // 收敛到一个元素时它就是最小值\n            int mid = l + (r - l) / 2;\n            if (nums[mid] \u003e nums[r]) l = mid + 1; // mid 在「大的那一段」，最小值一定在它右边\n            else r = mid;                          // mid 在「小的那一段」，最小值在 mid 或它左边\n        }\n        return nums[l];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-0f0uw2q","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-0f0uw2q","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"68. 寻找两个正序数组的中位数（困难 · No.4）"}]},{"ID":"20261001212411-m0xyfor","Type":"NodeParagraph","Properties":{"id":"20261001212411-m0xyfor","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定两个大小分别为 m 和 n 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"升序"},{"Type":"NodeText","Data":"数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums1"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums2"},{"Type":"NodeText","Data":"，返回这两个数组合并后的中位数。要求时间复杂度 O(log(m+n))。"}]},{"ID":"20261001212411-o1qfnyv","Type":"NodeParagraph","Properties":{"id":"20261001212411-o1qfnyv","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：在较短数组上二分「切割位置」"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":"（表示 nums1 左半取 i 个元素），令 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"j = (m+n+1)/2 - i"},{"Type":"NodeText","Data":"，要求切割满足 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"L1 \u0026lt;= R2"},{"Type":"NodeText","Data":" 且 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"L2 \u0026lt;= R1"},{"Type":"NodeText","Data":"（两边左端都不超过对方右端）；满足时若总长为奇数取 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"max(L1, L2)"},{"Type":"NodeText","Data":"，否则取两边边界平均，不满足则调整切割方向，每次砍掉一半搜索范围。"}]},{"ID":"20261001212411-kwbew9b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-kwbew9b","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    double findMedianSortedArrays(vector\u003cint\u003e\u0026 nums1, vector\u003cint\u003e\u0026 nums2) {\n        if (nums1.size() \u003e nums2.size()) // 只在较短的数组上二分，效率更高\n            return findMedianSortedArrays(nums2, nums1);\n        int m = nums1.size(), n = nums2.size();\n        int half = (m + n + 1) / 2; // 左半部分应有的元素个数（偶数时取下中位那边）\n        int l = 0, r = m;\n        while (l \u003c= r) {\n            int i = l + (r - l) / 2; // nums1 左半取 i 个\n            int j = half - i;        // nums2 左半就得取 j 个，凑够 half\n            int L1 = i == 0 ? INT_MIN : nums1[i - 1]; // nums1 左半最大（切在最左端就用 -∞ 兜底）\n            int R1 = i == m ? INT_MAX : nums1[i];     // nums1 右半最小\n            int L2 = j == 0 ? INT_MIN : nums2[j - 1]; // nums2 左半最大\n            int R2 = j == n ? INT_MAX : nums2[j];     // nums2 右半最小\n            if (L1 \u003c= R2 \u0026\u0026 L2 \u003c= R1) { // 切割合法：左半全部不大于右半\n                if ((m + n) % 2) return max(L1, L2);                       // 奇数个，中位数是左半最大值\n                return (max(L1, L2) + min(R1, R2)) / 2.0;                  // 偶数个，取中间两数平均\n            } else if (L1 \u003e R2) r = i - 1; // nums1 左半切多了，往左调\n            else l = i + 1;                // nums1 左半切少了，往右调\n        }\n        return 0.0;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ksk9nc9","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-ksk9nc9","updated":"20261001212411"}},{"ID":"20261001212411-uy99ljh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-uy99ljh","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十二、栈（5 题）"}]},{"ID":"20261001212411-2c8eiyv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-2c8eiyv","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"69. 有效的括号（简单 · No.20）"}]},{"ID":"20261001212411-cwty6g4","Type":"NodeParagraph","Properties":{"id":"20261001212411-cwty6g4","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个只包含 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"("},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":")"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"["},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"]"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"{"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"}"},{"Type":"NodeText","Data":" 的字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":"，判断它是否"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有效"},{"Type":"NodeText","Data":"：左括号必须用相同类型的右括号按正确顺序闭合，且每个右括号都有对应的左括号。"}]},{"ID":"20261001212411-985033e","Type":"NodeParagraph","Properties":{"id":"20261001212411-985033e","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：遍历字符串，左括号入栈；遇到右括号就检查栈顶是否为对应左括号（不匹配或栈为空都直接失败）并弹栈，最后要求栈为空，O(n)。"}]},{"ID":"20261001212411-33a0yq8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-33a0yq8","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool isValid(string s) {\n        stack\u003cchar\u003e st;\n        unordered_map\u003cchar, char\u003e match = {{')', '('}, {']', '['}, {'}', '{'}}; // 右括号 -\u003e 对应的左括号\n        for (char c : s) {\n            if (!match.count(c)) {      // 是左括号，直接入栈等着被匹配\n                st.push(c);\n            } else {                    // 是右括号\n                if (st.empty() || st.top() != match[c]) return false; // 栈空或类型对不上，非法\n                st.pop();               // 匹配成功，把对应的左括号弹掉\n            }\n        }\n        return st.empty(); // 全部匹配完，栈必须为空才算合法\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-l7gmscw","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-l7gmscw","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"70. 最小栈（中等 · No.155）"}]},{"ID":"20261001212411-apv6whw","Type":"NodeParagraph","Properties":{"id":"20261001212411-apv6whw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：设计一个栈，支持 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"push"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pop"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"top"},{"Type":"NodeText","Data":" 操作，并能在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"常数时间"},{"Type":"NodeText","Data":"内检索到栈中的最小元素。"}]},{"ID":"20261001212411-yw3w8d9","Type":"NodeParagraph","Properties":{"id":"20261001212411-yw3w8d9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：辅助栈同步记录「到当前位置为止的最小值」：主栈正常 push/pop，最小栈压入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"min(x, mins.top())"},{"Type":"NodeText","Data":"，于是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"getMin"},{"Type":"NodeText","Data":" 直接读辅助栈顶，所有操作 O(1)。"}]},{"ID":"20261001212411-r2d224y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-r2d224y","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class MinStack {\n    stack\u003cint\u003e st;    // 主栈，存真实数据\n    stack\u003cint\u003e mins;  // 辅助栈，栈顶永远是「当前整个栈的最小值」\n\npublic:\n    MinStack() {\n        mins.push(INT_MAX); // 哨兵，保证第一次 push 时 mins.top() 有值可比\n    }\n\n    void push(int val) {\n        st.push(val);\n        mins.push(min(val, mins.top())); // 新最小值 = min(新来的数, 之前的最小值)\n    }\n\n    void pop() {\n        st.pop();\n        mins.pop(); // 两个栈同步弹出，辅助栈顶自动恢复成「上一个历史最小值」\n    }\n\n    int top() {\n        return st.top(); // 直接读主栈顶\n    }\n\n    int getMin() {\n        return mins.top(); // O(1) 拿到最小值\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-d4orj7j","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-d4orj7j","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"71. 字符串解码（中等 · No.394）"}]},{"ID":"20261001212411-cmmp3xb","Type":"NodeParagraph","Properties":{"id":"20261001212411-cmmp3xb","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个编码字符串，编码规则为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k[encoded_string]"},{"Type":"NodeText","Data":"，表示方括号内的字符串恰好重复 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 次（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 为正整数），输入保证合法且不含多余空格。返回解码后的字符串。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"3[a]2[bc]\""},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"aaabcbc\""},{"Type":"NodeText","Data":"；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"3[a2[c]]\""},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\"accaccacc\""},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-cmp76o8","Type":"NodeParagraph","Properties":{"id":"20261001212411-cmp76o8","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：两个栈分别保存「倍数」和「前缀字符串」：遇到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"["},{"Type":"NodeText","Data":" 把当前累积的数字和外层字符串入栈并重置，遇到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"]"},{"Type":"NodeText","Data":" 弹出外层与倍数、把当前串重复 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":" 次接回外层，普通字符直接累积到当前串。"}]},{"ID":"20261001212411-bgocysa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-bgocysa","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    string decodeString(string s) {\n        stack\u003cint\u003e counts;      // 保存还没用上的重复次数\n        stack\u003cstring\u003e strs;     // 保存还没拼回去的外层字符串\n        string cur;             // 当前正在构建的字符串\n        int num = 0;            // 当前正在读的数字（可能有多位，所以要 ×10 累积）\n        for (char c : s) {\n            if (isdigit(c)) {\n                num = num * 10 + (c - '0'); // 处理多位数字，如 \"12\"\n            } else if (c == '[') {          // 进入一个新括号：把外面的现场存起来\n                counts.push(num);\n                strs.push(cur);\n                num = 0;                    // 重置，准备处理括号里的内容\n                cur.clear();\n            } else if (c == ']') {          // 括号结束，开始展开\n                int k = counts.top();\n                counts.pop();\n                string outer = strs.top();\n                strs.pop();\n                string rep;\n                while (k--) rep += cur;     // 把括号里的内容重复 k 次\n                cur = outer + rep;          // 拼到外层字符串后面\n            } else {\n                cur += c;                   // 普通字母，直接接到当前串\n            }\n        }\n        return cur;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-vor5i3k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-vor5i3k","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"72. 每日温度（中等 · No.739）"}]},{"ID":"20261001212411-v65ai3u","Type":"NodeParagraph","Properties":{"id":"20261001212411-v65ai3u","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"temperatures"},{"Type":"NodeText","Data":" 表示每天的温度，返回数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"answer"},{"Type":"NodeText","Data":"，其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"answer[i]"},{"Type":"NodeText","Data":" 表示第 i 天之后"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"需要等待多少天才会出现比它更高的温度"},{"Type":"NodeText","Data":"；若之后都不会出现更高温度，则为 0。"}]},{"ID":"20261001212411-0hz9ooh","Type":"NodeParagraph","Properties":{"id":"20261001212411-0hz9ooh","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：单调递减栈存放下标，栈内温度从栈底到栈顶递减：新温度更高时不断弹出栈顶并结算「等待天数 = 当前下标 - 弹出下标」，最后留在栈里的就是右边没有更热天气的，每个元素进出一次，O(n)。"}]},{"ID":"20261001212411-s9jrevj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-s9jrevj","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e dailyTemperatures(vector\u003cint\u003e\u0026 temperatures) {\n        int n = temperatures.size();\n        vector\u003cint\u003e ans(n, 0);\n        stack\u003cint\u003e st; // 存下标，它们对应的温度从栈底到栈顶单调递减（还没等到更高温度的日子）\n        for (int i = 0; i \u003c n; ++i) {\n            // 今天的温度比栈顶那些日子高 ⇒ 它们的答案就是今天\n            while (!st.empty() \u0026\u0026 temperatures[st.top()] \u003c temperatures[i]) {\n                ans[st.top()] = i - st.top(); // 等待的天数\n                st.pop();\n            }\n            st.push(i); // 今天还没等到更高的温度，先入栈排队\n        }\n        return ans; // 留在栈里的下标对应的答案保持 0\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-b6s4tw4","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-b6s4tw4","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"73. 柱状图中最大的矩形（困难 · No.84）"}]},{"ID":"20261001212411-9oi51uf","Type":"NodeParagraph","Properties":{"id":"20261001212411-9oi51uf","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定 n 个非负整数表示柱状图中各柱子的高度（每个柱子宽度为 1、相邻紧挨），求该柱状图中能勾勒出的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最大矩形面积"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-jmmxya0","Type":"NodeParagraph","Properties":{"id":"20261001212411-jmmxya0","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：单调递增栈（栈底到栈顶高度递增）+ 哨兵：遇到比栈顶矮的柱子就弹出，弹出的高度能向右延伸到当前下标 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":"、向左延伸到新栈顶的下一个位置，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"height * (i - 新栈顶 - 1)"},{"Type":"NodeText","Data":" 更新答案；遍历结束后把剩余柱子当作右边界为 n 继续结算，O(n)。"}]},{"ID":"20261001212411-r0t9m6b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-r0t9m6b","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int largestRectangleArea(vector\u003cint\u003e\u0026 heights) {\n        int n = heights.size();\n        stack\u003cint\u003e st;\n        st.push(-1); // 左侧哨兵：栈底放 -1，方便统一计算左边界（避免写 st.empty() 的特判）\n        int ans = 0;\n        for (int i = 0; i \u003c n; ++i) {\n            // 遇到比栈顶矮的柱子，说明栈顶柱子的「右边界」确定下来了，可以结算它的最大面积\n            while (st.top() != -1 \u0026\u0026 heights[st.top()] \u003e= heights[i]) {\n                int h = heights[st.top()];\n                st.pop();\n                ans = max(ans, h * (i - st.top() - 1)); // 宽度 = 右边界 i - 左边界(新栈顶) - 1\n            }\n            st.push(i);\n        }\n        // 栈里还剩的柱子，右边界都是 n，逐一结算\n        while (st.top() != -1) {\n            int h = heights[st.top()];\n            st.pop();\n            ans = max(ans, h * (n - st.top() - 1));\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-12d68h3","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-12d68h3","updated":"20261001212411"}},{"ID":"20261001212411-5x3l88c","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-5x3l88c","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十三、堆（3 题）"}]},{"ID":"20261001212411-3ohg69o","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-3ohg69o","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"74. 数组中的第K个最大元素（中等 · No.215）"}]},{"ID":"20261001212411-e0y2b9y","Type":"NodeParagraph","Properties":{"id":"20261001212411-e0y2b9y","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"，返回数组中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第 k 个最大的元素"},{"Type":"NodeText","Data":"（按降序排序后的第 k 个数，而不是第 k 个不同的元素）。进阶要求：时间复杂度 O(n)。"}]},{"ID":"20261001212411-q5uooyw","Type":"NodeParagraph","Properties":{"id":"20261001212411-q5uooyw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：维护一个大小为 k 的小顶堆（堆顶是当前第 k 大的值）：遍历时入堆、堆超过 k 就弹出最小值，结束后堆顶即答案；O(n log k)，也可以用快速选择做到平均 O(n)。"}]},{"ID":"20261001212411-done35e","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-done35e","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int findKthLargest(vector\u003cint\u003e\u0026 nums, int k) {\n        priority_queue\u003cint, vector\u003cint\u003e, greater\u003cint\u003e\u003e pq; // 小顶堆（greater 让最小的浮到堆顶）\n        for (int x : nums) {\n            pq.push(x);\n            if (pq.size() \u003e k) pq.pop(); // 只保留最大的 k 个数，多出来的最小值直接扔掉\n        }\n        return pq.top(); // 堆里剩的就是前 k 大，堆顶即其中最小的 = 第 k 大\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-07er0rd","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-07er0rd","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"75. 前 K 个高频元素（中等 · No.347）"}]},{"ID":"20261001212411-1feubxb","Type":"NodeParagraph","Properties":{"id":"20261001212411-1feubxb","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":" 和整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"k"},{"Type":"NodeText","Data":"，返回其中出现"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"频率前 k 高"},{"Type":"NodeText","Data":"的元素，顺序不限。"}]},{"ID":"20261001212411-k6jfocf","Type":"NodeParagraph","Properties":{"id":"20261001212411-k6jfocf","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先哈希表统计频率，再用「桶排序」：以频率作为下标开 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n+1"},{"Type":"NodeText","Data":" 个桶，把元素按频率放进去，从高频桶向低频桶依次取直到取满 k 个，整体 O(n)，比堆更省。"}]},{"ID":"20261001212411-fpny23x","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-fpny23x","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e topKFrequent(vector\u003cint\u003e\u0026 nums, int k) {\n        unordered_map\u003cint, int\u003e cnt;              // 元素 -\u003e 出现次数\n        for (int x : nums) ++cnt[x];\n        int n = nums.size();\n        vector\u003cvector\u003cint\u003e\u003e buckets(n + 1);       // buckets[f] 存放「出现 f 次」的所有元素\n        for (auto\u0026 kv : cnt) buckets[kv.second].push_back(kv.first);\n        vector\u003cint\u003e ans;\n        for (int f = n; f \u003e= 0 \u0026\u0026 ans.size() \u003c k; --f) // 从最高频率往下扫\n            for (int x : buckets[f]) {\n                if (ans.size() == k) break;\n                ans.push_back(x);                 // 取满 k 个就停\n            }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-l3h7lfo","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-l3h7lfo","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"76. 数据流的中位数（困难 · No.295）"}]},{"ID":"20261001212411-18sxpqh","Type":"NodeParagraph","Properties":{"id":"20261001212411-18sxpqh","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：设计 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"MedianFinder"},{"Type":"NodeText","Data":" 类："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"addNum(num)"},{"Type":"NodeText","Data":" 从数据流中添加一个整数；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"findMedian()"},{"Type":"NodeText","Data":" 返回当前所有元素的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中位数"},{"Type":"NodeText","Data":"（元素个数为奇数时是中间那个，为偶数时是中间两个数的平均值）。"}]},{"ID":"20261001212411-sswlm50","Type":"NodeParagraph","Properties":{"id":"20261001212411-sswlm50","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：对顶堆：大顶堆存较小的一半、小顶堆存较大的一半，插入时先入大顶堆再把堆顶挪到小顶堆，并保证大顶堆元素数不少于小顶堆（多 1 个或相等）；奇数个时中位数为大顶堆堆顶，偶数个为两堆顶平均，每次调整 O(log n)。"}]},{"ID":"20261001212411-4rmx4ml","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-4rmx4ml","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class MedianFinder {\n    priority_queue\u003cint\u003e low;                            // 较小的一半，大顶堆（堆顶是这半边的最大值）\n    priority_queue\u003cint, vector\u003cint\u003e, greater\u003cint\u003e\u003e hi;  // 较大的一半，小顶堆（堆顶是这半边的最小值）\n\npublic:\n    MedianFinder() {}\n\n    void addNum(int num) {\n        low.push(num);          // 先无脑丢进 low\n        hi.push(low.top());     // 再把 low 里最大的挪给 hi，保证 low 里的数全都 \u003c= hi 里的数\n        low.pop();\n        if (low.size() \u003c hi.size()) { // 维持约定：low 的元素个数 \u003e= hi（多 1 个或相等）\n            low.push(hi.top());\n            hi.pop();\n        }\n    }\n\n    double findMedian() {\n        if (low.size() \u003e hi.size()) return low.top(); // 奇数个：多出来的那个就在 low 的堆顶\n        return (low.top() + hi.top()) / 2.0;          // 偶数个：取两个堆顶的平均值\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-1r7ak1c","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-1r7ak1c","updated":"20261001212411"}},{"ID":"20261001212411-n9dz18j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-n9dz18j","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十四、贪心算法（4 题）"}]},{"ID":"20261001212411-x6swpbu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-x6swpbu","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"77. 买卖股票的最佳时机（简单 · No.121）"}]},{"ID":"20261001212411-r6bjho5","Type":"NodeParagraph","Properties":{"id":"20261001212411-r6bjho5","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prices"},{"Type":"NodeText","Data":"，其中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prices[i]"},{"Type":"NodeText","Data":" 表示第 i 天该股票的价格。你只能选择"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"某一天买入、并在之后某一天卖出"},{"Type":"NodeText","Data":"（只能交易一次），返回能获得的最大利润；若无法获利则返回 0。"}]},{"ID":"20261001212411-8ntraor","Type":"NodeParagraph","Properties":{"id":"20261001212411-8ntraor","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：一次遍历维护「目前为止见过的最低价」，每天用当前价格减去最低价更新最大利润，若价格更低则更新最低价，利润只在更低价格之后才可能更大，O(n)。"}]},{"ID":"20261001212411-vrtsvpd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-vrtsvpd","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int maxProfit(vector\u003cint\u003e\u0026 prices) {\n        int minPrice = INT_MAX, ans = 0;\n        for (int p : prices) {\n            minPrice = min(minPrice, p);   // 更新「历史最低买入价」\n            ans = max(ans, p - minPrice);  // 假设今天卖出，利润 = 今天价格 - 之前的最低价\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-cd5ui30","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-cd5ui30","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"78. 跳跃游戏（中等 · No.55）"}]},{"ID":"20261001212411-oocebe1","Type":"NodeParagraph","Properties":{"id":"20261001212411-oocebe1","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定非负整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，你最初位于下标 0，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i]"},{"Type":"NodeText","Data":" 表示从位置 i 最多可以向前跳跃的步数。判断你是否"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"能够到达最后一个下标"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-al2eem6","Type":"NodeParagraph","Properties":{"id":"20261001212411-al2eem6","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：贪心维护「当前位置能到达的最远下标」"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"far"},{"Type":"NodeText","Data":"，遍历时若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i \u0026gt; far"},{"Type":"NodeText","Data":" 说明够不着直接返回 false，否则用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i + nums[i]"},{"Type":"NodeText","Data":" 更新 far，最后能走完全程即可达，O(n)。"}]},{"ID":"20261001212411-k490k0g","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-k490k0g","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool canJump(vector\u003cint\u003e\u0026 nums) {\n        int far = 0; // 目前能到达的最远下标\n        for (int i = 0; i \u003c nums.size(); ++i) {\n            if (i \u003e far) return false;       // 连 i 都跳不到，后面的更到不了\n            far = max(far, i + nums[i]);     // 从 i 起跳能到的最远处，刷新最远可达\n        }\n        return true; // 一路都没有断点，说明能走到最后\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-majbxhv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-majbxhv","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"79. 跳跃游戏 II（中等 · No.45）"}]},{"ID":"20261001212411-o8y31cg","Type":"NodeParagraph","Properties":{"id":"20261001212411-o8y31cg","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定非负整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，你从下标 0 出发，每次可以跳到当前范围内任意位置，求"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"到达最后一个下标所需的最少跳跃次数"},{"Type":"NodeText","Data":"（题目保证一定能到达）。"}]},{"ID":"20261001212411-ynsswrb","Type":"NodeParagraph","Properties":{"id":"20261001212411-ynsswrb","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：贪心按「跳跃层」推进："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"curEnd"},{"Type":"NodeText","Data":" 是当前这一跳的边界、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nextFar"},{"Type":"NodeText","Data":" 是下一跳能到达的最远位置，走到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"curEnd"},{"Type":"NodeText","Data":" 时就必须再跳一次（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ans++"},{"Type":"NodeText","Data":" 并把边界推进到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nextFar"},{"Type":"NodeText","Data":"），每层线性扫描，O(n)。"}]},{"ID":"20261001212411-sxg2xar","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-sxg2xar","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int jump(vector\u003cint\u003e\u0026 nums) {\n        int ans = 0, curEnd = 0, nextFar = 0;\n        for (int i = 0; i \u003c nums.size() - 1; ++i) { // 注意不用处理最后一个下标\n            nextFar = max(nextFar, i + nums[i]);    // 在「当前这一跳能覆盖的范围」内，最远能蹦到哪\n            if (i == curEnd) {   // 已经走到本次跳跃范围的最右端，必须再跳一次\n                ++ans;\n                curEnd = nextFar; // 新的范围边界，相当于 BFS 的「下一层」\n            }\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-bw72k82","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-bw72k82","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"80. 划分字母区间（中等 · No.763）"}]},{"ID":"20261001212411-196xev9","Type":"NodeParagraph","Properties":{"id":"20261001212411-196xev9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":"，将其划分为尽可能多的片段，要求"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"同一个字母最多只出现在一个片段中"},{"Type":"NodeText","Data":"，返回各片段的长度组成的列表。"}]},{"ID":"20261001212411-mjk40m9","Type":"NodeParagraph","Properties":{"id":"20261001212411-mjk40m9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先扫描一遍记录每个字母最后出现的位置，再线性遍历并维护当前片段的右边界 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"end"},{"Type":"NodeText","Data":"：每遇到一个字母就用它的最后位置更新 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"end"},{"Type":"NodeText","Data":"，当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i == end"},{"Type":"NodeText","Data":" 时说明该片段内所有字母都不会再在后面出现，此刻切割并重置，O(n)。"}]},{"ID":"20261001212411-s77dgcy","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-s77dgcy","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cint\u003e partitionLabels(string s) {\n        int last[26] = {};                              // 每个字母最后出现的下标\n        for (int i = 0; i \u003c s.size(); ++i) last[s[i] - 'a'] = i;\n        vector\u003cint\u003e ans;\n        int start = 0, end = 0;\n        for (int i = 0; i \u003c s.size(); ++i) {\n            end = max(end, last[s[i] - 'a']); // 当前片段至少要延伸到「已出现字母的最远位置」\n            if (i == end) {                   // 走到头了，说明这个片段可以安全切开\n                ans.push_back(i - start + 1);\n                start = i + 1;                // 开始下一个片段\n            }\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-phw7sjs","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-phw7sjs","updated":"20261001212411"}},{"ID":"20261001212411-mnzyrdb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-mnzyrdb","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十五、动态规划（10 题）"}]},{"ID":"20261001212411-p4m7i3j","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-p4m7i3j","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"81. 爬楼梯（简单 · No.70）"}]},{"ID":"20261001212411-ez1b73v","Type":"NodeParagraph","Properties":{"id":"20261001212411-ez1b73v","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：假设你正在爬楼梯，需要 n 阶才能到达楼顶，每次你可以爬 1 或 2 个台阶，返回共有多少种不同的方法可以爬到楼顶。"}]},{"ID":"20261001212411-87bm90o","Type":"NodeParagraph","Properties":{"id":"20261001212411-87bm90o","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：到第 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 阶只能从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i-1"},{"Type":"NodeText","Data":"（走 1 步）或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i-2"},{"Type":"NodeText","Data":"（走 2 步）上来，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"f(i) = f(i-1) + f(i-2)"},{"Type":"NodeText","Data":"，用两个滚动变量即可把空间压到 O(1)，O(n)。"}]},{"ID":"20261001212411-4jeccxl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-4jeccxl","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int climbStairs(int n) {\n        int a = 1, b = 1; // a = f(i-2), b = f(i-1)；f(0)=1, f(1)=1\n        for (int i = 2; i \u003c= n; ++i) {\n            int c = a + b; // 到第 i 阶的方法数 = 前两阶之和\n            a = b;         // 滚动更新\n            b = c;\n        }\n        return b;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-i6b8kvh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-i6b8kvh","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"82. 杨辉三角（简单 · No.118）"}]},{"ID":"20261001212411-44muezb","Type":"NodeParagraph","Properties":{"id":"20261001212411-44muezb","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定行数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"numRows"},{"Type":"NodeText","Data":"，生成杨辉三角的前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"numRows"},{"Type":"NodeText","Data":" 行（每行首尾为 1，其余位置等于上一行左右两个数之和）。"}]},{"ID":"20261001212411-lh5hvdw","Type":"NodeParagraph","Properties":{"id":"20261001212411-lh5hvdw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：逐行生成，每行首尾是 1，中间每个数等于上一行「左上 + 右上」两个数之和（即 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"prev[j-1] + prev[j]"},{"Type":"NodeText","Data":"），直接复用上一行结果，O(n²)。"}]},{"ID":"20261001212411-qj04hm7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-qj04hm7","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    vector\u003cvector\u003cint\u003e\u003e generate(int numRows) {\n        vector\u003cvector\u003cint\u003e\u003e ans;\n        for (int i = 0; i \u003c numRows; ++i) {\n            vector\u003cint\u003e row(i + 1, 1); // 先整行填 1（首尾天然是 1）\n            for (int j = 1; j \u003c i; ++j)\n                row[j] = ans.back()[j - 1] + ans.back()[j]; // 上一行的左上 + 右上\n            ans.push_back(row);\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-l5zh2ht","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-l5zh2ht","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"83. 打家劫舍（中等 · No.198）"}]},{"ID":"20261001212411-liwvm6l","Type":"NodeParagraph","Properties":{"id":"20261001212411-liwvm6l","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定非负整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i]"},{"Type":"NodeText","Data":" 表示第 i 间房内的现金。不能偷"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相邻"},{"Type":"NodeText","Data":"的两间房，求一夜之内能够偷到的最高金额。"}]},{"ID":"20261001212411-cdni9yk","Type":"NodeParagraph","Properties":{"id":"20261001212411-cdni9yk","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：状态 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i]"},{"Type":"NodeText","Data":" 表示偷到第 i 家的最优收益，转移为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"max(dp[i-1], dp[i-2] + nums[i])"},{"Type":"NodeText","Data":"（不偷则继承上家，偷则加上前前家），用两个变量滚动即可，O(n)。"}]},{"ID":"20261001212411-a9v2lbk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-a9v2lbk","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int rob(vector\u003cint\u003e\u0026 nums) {\n        int pre2 = 0, pre1 = 0; // pre2 = dp[i-2], pre1 = dp[i-1]\n        for (int x : nums) {\n            int cur = max(pre1, pre2 + x); // 不偷 x（继承上一家）或 偷 x（加上前前家）\n            pre2 = pre1;                   // 滚动前进\n            pre1 = cur;\n        }\n        return pre1;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-k2o0yby","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-k2o0yby","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"84. 完全平方数（中等 · No.279）"}]},{"ID":"20261001212411-5intpvp","Type":"NodeParagraph","Properties":{"id":"20261001212411-5intpvp","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n"},{"Type":"NodeText","Data":"，返回"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和为 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 的完全平方数的最少数量"},{"Type":"NodeText","Data":"（完全平方数如 1、4、9、16……）。示例："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n = 12"},{"Type":"NodeText","Data":" → 3（4 + 4 + 4）；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"n = 13"},{"Type":"NodeText","Data":" → 2（4 + 9）。"}]},{"ID":"20261001212411-fassq2f","Type":"NodeParagraph","Properties":{"id":"20261001212411-fassq2f","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：完全背包 DP，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i]"},{"Type":"NodeText","Data":" 表示凑出 i 所需最少的完全平方数个数，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[0] = 0"},{"Type":"NodeText","Data":"、其余初始化为大值，外层枚举金额、内层枚举平方数做 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i] = min(dp[i], dp[i - j*j] + 1)"},{"Type":"NodeText","Data":"，答案即 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[n]"},{"Type":"NodeText","Data":"，O(n√n)。"}]},{"ID":"20261001212411-htcu64x","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-htcu64x","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int numSquares(int n) {\n        vector\u003cint\u003e dp(n + 1, INT_MAX); // dp[i] = 凑出 i 的最少平方数个数，先设成无穷大\n        dp[0] = 0;                      // 凑 0 不需要任何数\n        for (int i = 1; i \u003c= n; ++i)\n            for (int j = 1; j * j \u003c= i; ++j) // 枚举所有不超过 i 的平方数 j*j（物品可无限次使用）\n                dp[i] = min(dp[i], dp[i - j * j] + 1);\n        return dp[n];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-5nbuyaf","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-5nbuyaf","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"85. 零钱兑换（中等 · No.322）"}]},{"ID":"20261001212411-2s7ezyv","Type":"NodeParagraph","Properties":{"id":"20261001212411-2s7ezyv","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定不同面额的硬币数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"coins"},{"Type":"NodeText","Data":" 和总金额 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"amount"},{"Type":"NodeText","Data":"，计算凑成总金额所需的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最少硬币个数"},{"Type":"NodeText","Data":"（每种硬币数量无限）；若无法凑成则返回 -1。"}]},{"ID":"20261001212411-ggau01j","Type":"NodeParagraph","Properties":{"id":"20261001212411-ggau01j","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i]"},{"Type":"NodeText","Data":" 表示凑出金额 i 所需的最少硬币数，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[0] = 0"},{"Type":"NodeText","Data":"、其余为无穷大，对每个金额遍历每种面额 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"c"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i] = min(dp[i], dp[i - c] + 1)"},{"Type":"NodeText","Data":"（完全背包），最终 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[amount]"},{"Type":"NodeText","Data":" 仍为无穷大则返回 -1，O(amount · k)。"}]},{"ID":"20261001212411-8e4esri","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-8e4esri","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int coinChange(vector\u003cint\u003e\u0026 coins, int amount) {\n        vector\u003cint\u003e dp(amount + 1, amount + 1); // 用 amount+1 当「无穷大」（凑 amount 最多用 amount 个 1 元）\n        dp[0] = 0;\n        for (int i = 1; i \u003c= amount; ++i)\n            for (int c : coins)\n                if (c \u003c= i) // 面额不能超过当前金额\n                    dp[i] = min(dp[i], dp[i - c] + 1); // 用掉一枚硬币 c，剩下 i-c 继续凑\n        return dp[amount] \u003e amount ? -1 : dp[amount]; // 仍是「无穷大」说明凑不出来\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-8c9kn8k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-8c9kn8k","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"86. 单词拆分（中等 · No.139）"}]},{"ID":"20261001212411-n1dmvx8","Type":"NodeParagraph","Properties":{"id":"20261001212411-n1dmvx8","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 和一个字符串列表 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wordDict"},{"Type":"NodeText","Data":"（字典中的单词可以重复使用），判断 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 能否被拆分成一个或多个出现在字典中的单词。"}]},{"ID":"20261001212411-bhcbzmf","Type":"NodeParagraph","Properties":{"id":"20261001212411-bhcbzmf","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i]"},{"Type":"NodeText","Data":" 表示字符串前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 个字符能否被拆分，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[0] = true"},{"Type":"NodeText","Data":"，对每个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 枚举分割点 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"j"},{"Type":"NodeText","Data":"，若 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[j]"},{"Type":"NodeText","Data":" 为真且 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s[j..i)"},{"Type":"NodeText","Data":" 出现在字典里则 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i] = true"},{"Type":"NodeText","Data":"，用哈希集合把单词查询降到 O(1)，总 O(n² · L)。"}]},{"ID":"20261001212411-9x3mces","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-9x3mces","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool wordBreak(string s, vector\u003cstring\u003e\u0026 wordDict) {\n        unordered_set\u003cstring\u003e dict(wordDict.begin(), wordDict.end()); // 哈希集合，O(1) 判断单词是否存在\n        int n = s.size();\n        vector\u003cbool\u003e dp(n + 1, false); // dp[i] = 前 i 个字符能否被成功拆分\n        dp[0] = true;                  // 空串天然可以\n        for (int i = 1; i \u003c= n; ++i)\n            for (int j = 0; j \u003c i \u0026\u0026 !dp[i]; ++j) // 枚举分割点 j，把 s 切成 [0,j) 和 [j,i)\n                if (dp[j] \u0026\u0026 dict.count(s.substr(j, i - j))) // 前半段可分 + 后半段是字典里的词\n                    dp[i] = true;\n        return dp[n];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-1f4qkoh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-1f4qkoh","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"87. 最长递增子序列（中等 · No.300）"}]},{"ID":"20261001212411-0ma407f","Type":"NodeParagraph","Properties":{"id":"20261001212411-0ma407f","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，找出其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最长严格递增子序列"},{"Type":"NodeText","Data":"的长度（子序列不要求数组下标连续，但元素的相对顺序必须保持不变）。进阶要求 O(n log n)。"}]},{"ID":"20261001212411-ho0w0lr","Type":"NodeParagraph","Properties":{"id":"20261001212411-ho0w0lr","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：贪心 + 二分的 O(n log n) 做法：维护数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tails"},{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tails[k]"},{"Type":"NodeText","Data":" 表示长度为 k+1 的递增子序列可能的最小结尾），对每个数在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tails"},{"Type":"NodeText","Data":" 上做 lower_bound：能替换就替换该位置（让结尾更小、更易接长），否则追加；最终 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tails"},{"Type":"NodeText","Data":" 的长度即答案。"}]},{"ID":"20261001212411-m8kyqw5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-m8kyqw5","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int lengthOfLIS(vector\u003cint\u003e\u0026 nums) {\n        vector\u003cint\u003e tails; // tails[k] = 长度为 k+1 的递增子序列的最小可能结尾\n        for (int x : nums) {\n            // 找到第一个 \u003e= x 的位置：把那里换成 x，让这个长度的子序列「结尾更小」，将来更容易接长\n            auto it = lower_bound(tails.begin(), tails.end(), x);\n            if (it == tails.end()) tails.push_back(x); // 比所有结尾都大 ⇒ 可以接在最长序列后面，长度 +1\n            else *it = x;\n        }\n        return tails.size(); // tails 的长度就是最长递增子序列的长度\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-tm5mnp9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-tm5mnp9","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"88. 乘积最大子数组（中等 · No.152）"}]},{"ID":"20261001212411-u93eh2k","Type":"NodeParagraph","Properties":{"id":"20261001212411-u93eh2k","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"（可能包含负数），找出乘积最大的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"非空连续子数组"},{"Type":"NodeText","Data":"并返回其乘积。"}]},{"ID":"20261001212411-tykkt00","Type":"NodeParagraph","Properties":{"id":"20261001212411-tykkt00","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：因为负负得正，所以需要同时维护「以当前位置结尾的最大乘积」和「最小乘积」："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"curMax = max(x, curMax*x, curMin*x)"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"curMin = min(...)"},{"Type":"NodeText","Data":"（用交换前的值计算），负数会把最大最小互换角色，全局答案取所有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"curMax"},{"Type":"NodeText","Data":" 的最大值，O(n)。"}]},{"ID":"20261001212411-dqk1lyw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-dqk1lyw","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int maxProduct(vector\u003cint\u003e\u0026 nums) {\n        int ans = nums[0], curMax = nums[0], curMin = nums[0]; // 以当前元素结尾的最大/最小乘积\n        for (int i = 1; i \u003c nums.size(); ++i) {\n            int x = nums[i];\n            int a = curMax * x, b = curMin * x; // 先用旧值算好，避免下面覆盖后互相影响\n            curMax = max({x, a, b}); // 从「重新开始」「接最大值」「接最小值（负数变正）」里选最大的\n            curMin = min({x, a, b}); // 最小值同理，负数情况下它就是将来的最大值的种子\n            ans = max(ans, curMax);\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-wooaaeg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-wooaaeg","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"89. 分割等和子集（中等 · No.416）"}]},{"ID":"20261001212411-u4r6ajn","Type":"NodeParagraph","Properties":{"id":"20261001212411-u4r6ajn","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个只包含正整数的非空数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，判断是否可以将这个数组分割成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"两个子集，使得两个子集的元素和相等"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-glpbbkk","Type":"NodeParagraph","Properties":{"id":"20261001212411-glpbbkk","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：先求总和，奇数或超半即 false；问题转化为「能否从数组中选出和为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sum/2"},{"Type":"NodeText","Data":" 的子集」，即 0/1 背包布尔 DP："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[j]"},{"Type":"NodeText","Data":" 表示能否凑出和 j，倒序遍历金额保证每个元素只用一次，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[j] = dp[j] || dp[j - x]"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-y7hzaib","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-y7hzaib","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    bool canPartition(vector\u003cint\u003e\u0026 nums) {\n        int sum = 0;\n        for (int x : nums) sum += x;\n        if (sum % 2) return false;      // 总和是奇数，不可能平分\n        int target = sum / 2;\n        vector\u003cbool\u003e dp(target + 1, false); // dp[j] = 能否用数组里的数凑出和 j\n        dp[0] = true;\n        for (int x : nums)\n            for (int j = target; j \u003e= x; --j) // 必须倒着遍历：保证每个数只被用一次（0/1 背包关键）\n                dp[j] = dp[j] || dp[j - x];\n        return dp[target];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-comnd57","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-comnd57","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"90. 最长有效括号（困难 · No.32）"}]},{"ID":"20261001212411-g0eff6a","Type":"NodeParagraph","Properties":{"id":"20261001212411-g0eff6a","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个只包含 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"'('"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"')'"},{"Type":"NodeText","Data":" 的字符串，找出其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最长的有效（格式正确且连续）括号子串"},{"Type":"NodeText","Data":"的长度。"}]},{"ID":"20261001212411-edhdo5s","Type":"NodeParagraph","Properties":{"id":"20261001212411-edhdo5s","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：栈底放「当前无效部分的起始下标」：初始化压入 -1，遇 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"("},{"Type":"NodeText","Data":" 下标入栈；遇 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":")"},{"Type":"NodeText","Data":" 先弹栈顶，若栈已空就把当前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":")"},{"Type":"NodeText","Data":" 的下标作为新分界压入，否则答案用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i - stack.top()"},{"Type":"NodeText","Data":" 更新（以栈顶为无效起点），O(n)。"}]},{"ID":"20261001212411-6osvwv8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-6osvwv8","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int longestValidParentheses(string s) {\n        stack\u003cint\u003e st;\n        st.push(-1); // 哨兵：它代表「最后一个没被匹配的右括号」的位置，用来算长度\n        int ans = 0;\n        for (int i = 0; i \u003c s.size(); ++i) {\n            if (s[i] == '(') {\n                st.push(i);           // 左括号，先记下位置\n            } else {\n                st.pop();             // 右括号，和栈顶的左括号配对（或弹掉哨兵）\n                if (st.empty()) {\n                    st.push(i);       // 说明这个右括号没得配，它成为新的无效分界点\n                } else {\n                    ans = max(ans, i - st.top()); // 从栈顶（无效分界）到 i 之间的都是有效括号\n                }\n            }\n        }\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-20puisf","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-20puisf","updated":"20261001212411"}},{"ID":"20261001212411-ydmowbk","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-ydmowbk","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十六、多维动态规划（5 题）"}]},{"ID":"20261001212411-n3wwkpy","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-n3wwkpy","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"91. 不同路径（中等 · No.62）"}]},{"ID":"20261001212411-jvvj1zw","Type":"NodeParagraph","Properties":{"id":"20261001212411-jvvj1zw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：一个机器人位于 m×n 网格的左上角 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(0,0)"},{"Type":"NodeText","Data":"，每次只能"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"向下或向右"},{"Type":"NodeText","Data":"移动一步，求它到达右下角 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"(m-1,n-1)"},{"Type":"NodeText","Data":" 共有多少条不同的路径。"}]},{"ID":"20261001212411-tkdl8l3","Type":"NodeParagraph","Properties":{"id":"20261001212411-tkdl8l3","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j]"},{"Type":"NodeText","Data":" 表示到达 (i,j) 的路径数，转移为「上方 + 左方」之和，第一行第一列全为 1（只有一种走法），滚动一维数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[j] += dp[j-1]"},{"Type":"NodeText","Data":" 即可，O(mn) 时间、O(n) 空间。"}]},{"ID":"20261001212411-4ofquzd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-4ofquzd","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int uniquePaths(int m, int n) {\n        vector\u003cint\u003e dp(n, 1); // 滚动数组，初始对应第一行：每个格子都只有 1 条路（一路向右）\n        for (int i = 1; i \u003c m; ++i)      // 从第二行开始逐行推\n            for (int j = 1; j \u003c n; ++j)\n                dp[j] += dp[j - 1];      // 更新前 dp[j] 是「上方」，dp[j-1] 已是「左方」，相加即两条来路之和\n        return dp[n - 1];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-z8zenns","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-z8zenns","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"92. 最小路径和（中等 · No.64）"}]},{"ID":"20261001212411-wnz73m9","Type":"NodeParagraph","Properties":{"id":"20261001212411-wnz73m9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个 m×n 的非负整数网格 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"grid"},{"Type":"NodeText","Data":"，从左上角出发走到右下角，每次只能向下或向右移动一步，求路径上所有数字之和的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最小值"},{"Type":"NodeText","Data":"。"}]},{"ID":"20261001212411-jbai879","Type":"NodeParagraph","Properties":{"id":"20261001212411-jbai879","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j]"},{"Type":"NodeText","Data":" 为到该格的最小路径和，只能从上方或左方过来，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j] = grid[i][j] + min(上方, 左方)"},{"Type":"NodeText","Data":"，第一行第一列初始化为沿途累加，滚动一维即可，O(mn)。"}]},{"ID":"20261001212411-7q5po0j","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-7q5po0j","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int minPathSum(vector\u003cvector\u003cint\u003e\u003e\u0026 grid) {\n        int m = grid.size(), n = grid[0].size();\n        vector\u003cint\u003e dp(n, INT_MAX); // dp[j] 表示到达当前行第 j 列的最小路径和\n        dp[0] = 0;                  // 起点的「虚拟前驱」，让 (0,0) 能正确取到自己的值\n        for (int i = 0; i \u003c m; ++i) {\n            dp[0] += grid[i][0];    // 第一列只能从上边走下来，单独累加\n            for (int j = 1; j \u003c n; ++j)\n                dp[j] = grid[i][j] + min(dp[j], dp[j - 1]); // 从上（旧 dp[j]）或 从左（dp[j-1]）取较小\n        }\n        return dp[n - 1];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-8wkvfvu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-8wkvfvu","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"93. 最长回文子串（中等 · No.5）"}]},{"ID":"20261001212411-pzpl7p5","Type":"NodeParagraph","Properties":{"id":"20261001212411-pzpl7p5","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":"，找到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"s"},{"Type":"NodeText","Data":" 中最长的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"回文子串"},{"Type":"NodeText","Data":"（回文串指正着读和倒着读相同的字符串）。"}]},{"ID":"20261001212411-g5xh1m2","Type":"NodeParagraph","Properties":{"id":"20261001212411-g5xh1m2","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：中心扩展法，枚举每个位置（以及相邻两字符之间）作为回文中心，向两边扩张直到字符不等或越界，奇偶两种中心都要试，记录最长区间后用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"substr"},{"Type":"NodeText","Data":" 截取，O(n²) 时间、O(1) 空间。"}]},{"ID":"20261001212411-0o2z6d4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-0o2z6d4","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\n    int bestL = 0, bestLen = 1; // 记录目前找到的最长回文：起点和长度（至少 1 个字符）\n    void expand(const string\u0026 s, int l, int r) { // 以 l、r 为中心向两边扩展\n        while (l \u003e= 0 \u0026\u0026 r \u003c s.size() \u0026\u0026 s[l] == s[r]) { // 两边字符相同就继续扩\n            --l;\n            ++r;\n        }\n        // 循环退出时 s[l+1..r-1] 才是回文，长度 = r - l - 1\n        if (r - l - 1 \u003e bestLen) {\n            bestLen = r - l - 1;\n            bestL = l + 1;\n        }\n    }\npublic:\n    string longestPalindrome(string s) {\n        for (int i = 0; i \u003c s.size(); ++i) {\n            expand(s, i, i);     // 以单个字符为中心，处理奇数长度回文，如 \"aba\"\n            expand(s, i, i + 1); // 以两个字符的间隙为中心，处理偶数长度回文，如 \"abba\"\n        }\n        return s.substr(bestL, bestLen);\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-qb6vla0","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-qb6vla0","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"94. 最长公共子序列（中等 · No.1143）"}]},{"ID":"20261001212411-fdg2k9x","Type":"NodeParagraph","Properties":{"id":"20261001212411-fdg2k9x","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定两个字符串 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"text1"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"text2"},{"Type":"NodeText","Data":"，返回它们"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最长公共子序列"},{"Type":"NodeText","Data":"的长度（子序列指不改变相对顺序、可以不连续的子串）；若不存在公共子序列则返回 0。"}]},{"ID":"20261001212411-13l8fiz","Type":"NodeParagraph","Properties":{"id":"20261001212411-13l8fiz","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j]"},{"Type":"NodeText","Data":" 表示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"text1"},{"Type":"NodeText","Data":" 前 i 个字符与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"text2"},{"Type":"NodeText","Data":" 前 j 个字符的 LCS 长度：字符相等时 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j] = dp[i-1][j-1] + 1"},{"Type":"NodeText","Data":"，否则取「丢掉一个 text1 字符」或「丢掉一个 text2 字符」的较大值；滚动一维时注意先用变量保存旧的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[j-1]"},{"Type":"NodeText","Data":"，O(mn)。"}]},{"ID":"20261001212411-eicc45h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-eicc45h","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int longestCommonSubsequence(string text1, string text2) {\n        int m = text1.size(), n = text2.size();\n        vector\u003cint\u003e dp(n + 1, 0); // 压缩成一维：dp[j] 对应二维里的 dp[i][j]\n        for (int i = 1; i \u003c= m; ++i) {\n            int prev = 0; // prev 用来暂存「上一轮」的 dp[j-1]，也就是 dp[i-1][j-1]\n            for (int j = 1; j \u003c= n; ++j) {\n                int tmp = dp[j]; // 先存下当前的 dp[j]，它下一轮就是新的 prev\n                if (text1[i - 1] == text2[j - 1])\n                    dp[j] = prev + 1;            // 两字符相同，在 dp[i-1][j-1] 基础上 +1\n                else\n                    dp[j] = max(dp[j], dp[j - 1]); // 否则丢掉 text1 的字符（dp[j]）或 text2 的字符（dp[j-1]）\n                prev = tmp;\n            }\n        }\n        return dp[n];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-19zg99h","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-19zg99h","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"95. 编辑距离（中等 · No.72）"}]},{"ID":"20261001212411-lda13rb","Type":"NodeParagraph","Properties":{"id":"20261001212411-lda13rb","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定两个单词 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word1"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word2"},{"Type":"NodeText","Data":"，返回将 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word1"},{"Type":"NodeText","Data":" 转换成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word2"},{"Type":"NodeText","Data":" 所使用的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最少操作数"},{"Type":"NodeText","Data":"。允许的操作有三种：插入一个字符、删除一个字符、替换一个字符。"}]},{"ID":"20261001212411-1e9gwrl","Type":"NodeParagraph","Properties":{"id":"20261001212411-1e9gwrl","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i][j]"},{"Type":"NodeText","Data":" 表示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word1"},{"Type":"NodeText","Data":" 前 i 个字符变成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"word2"},{"Type":"NodeText","Data":" 前 j 个字符的最少操作数：末尾字符相同则继承 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dp[i-1][j-1]"},{"Type":"NodeText","Data":"；否则取「删（dp[i-1][j]）/ 增（dp[i][j-1]）/ 改（dp[i-1][j-1]）」三者最小 +1，滚动一维时用变量暂存左上角旧值，O(mn)。"}]},{"ID":"20261001212411-jprk7lx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-jprk7lx","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int minDistance(string word1, string word2) {\n        int m = word1.size(), n = word2.size();\n        vector\u003cint\u003e dp(n + 1);\n        for (int j = 0; j \u003c= n; ++j) dp[j] = j; // 边界：空串变成 word2 前 j 个字符需要 j 次插入\n        for (int i = 1; i \u003c= m; ++i) {\n            int prev = dp[0]; // prev = dp[i-1][0]，即二维里的左上角那个值\n            dp[0] = i;        // 边界：word1 前 i 个字符变成空串需要 i 次删除\n            for (int j = 1; j \u003c= n; ++j) {\n                int tmp = dp[j]; // 暂存旧的 dp[j]（即 dp[i-1][j]），供下一列当 prev\n                if (word1[i - 1] == word2[j - 1])\n                    dp[j] = prev;  // 末尾字符相同，不用操作，直接继承左上角\n                else\n                    dp[j] = 1 + min({prev, dp[j], dp[j - 1]}); // 替换 / 删除 / 插入 里挑最小的\n                prev = tmp;\n            }\n        }\n        return dp[n];\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-4o8sspn","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-4o8sspn","updated":"20261001212411"}},{"ID":"20261001212411-7zvazvc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261001212411-7zvazvc","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十七、技巧（5 题）"}]},{"ID":"20261001212411-52oxw30","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-52oxw30","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"96. 只出现一次的数字（简单 · No.136）"}]},{"ID":"20261001212411-9y6qer9","Type":"NodeParagraph","Properties":{"id":"20261001212411-9y6qer9","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个非空整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，除了某个元素只出现一次外，其余每个元素都出现两次，找出这个只出现一次的元素。要求线性时间、常量额外空间。"}]},{"ID":"20261001212411-0atgmzo","Type":"NodeParagraph","Properties":{"id":"20261001212411-0atgmzo","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：异或的自反性："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"a ^ a = 0"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"a ^ 0 = a"},{"Type":"NodeText","Data":"，把所有数异或一遍，成对出现的数互相抵消，最后剩下的就是只出现一次的那个，O(n)、O(1) 空间。"}]},{"ID":"20261001212411-ssh42sw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-ssh42sw","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int singleNumber(vector\u003cint\u003e\u0026 nums) {\n        int ans = 0;\n        for (int x : nums) ans ^= x; // 出现两次的数在异或中自己抵消成 0，最后只剩落单的那个\n        return ans;\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-h5rfn41","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-h5rfn41","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"97. 多数元素（简单 · No.169）"}]},{"ID":"20261001212411-7xtue98","Type":"NodeParagraph","Properties":{"id":"20261001212411-7xtue98","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定大小为 n 的数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，返回其中的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多数元素"},{"Type":"NodeText","Data":"（出现次数超过 ⌊n/2⌋ 的元素）。可以假定数组非空且多数元素一定存在。"}]},{"ID":"20261001212411-1wbyq6j","Type":"NodeParagraph","Properties":{"id":"20261001212411-1wbyq6j","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：Boyer-Moore 投票法：维护候选者和票数，相同则 +1、不同则 -1，减到 0 就换人；由于多数元素出现次数超过一半，最后剩下的候选者必是它，O(n)、O(1) 空间。"}]},{"ID":"20261001212411-ykv7z2c","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-ykv7z2c","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int majorityElement(vector\u003cint\u003e\u0026 nums) {\n        int candidate = 0, votes = 0;\n        for (int x : nums) {\n            if (votes == 0) candidate = x;      // 票数归零，换一个候选人\n            votes += (x == candidate) ? 1 : -1; // 支持他就加票，反对他就减票\n        }\n        return candidate; // 票数过半的人一定会在「相互抵消」后活到最后\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-vzq5839","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-vzq5839","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"98. 颜色分类（中等 · No.75）"}]},{"ID":"20261001212411-4m1lvyw","Type":"NodeParagraph","Properties":{"id":"20261001212411-4m1lvyw","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个包含红(0)、白(1)、蓝(2) 三种颜色的数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，原地排序使相同颜色相邻，并按 0、1、2 的顺序排列。不能使用库的排序函数，要求只扫描一趟。"}]},{"ID":"20261001212411-esvuly8","Type":"NodeParagraph","Properties":{"id":"20261001212411-esvuly8","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：荷兰国旗三指针："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lo"},{"Type":"NodeText","Data":" 指向 0 应放的位置、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hi"},{"Type":"NodeText","Data":" 指向 2 应放的位置、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 从左向右扫描；遇到 0 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lo"},{"Type":"NodeText","Data":" 交换并同时推进 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lo"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":"，遇到 2 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hi"},{"Type":"NodeText","Data":" 交换并只推进 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hi"},{"Type":"NodeText","Data":"（换过来的元素还没看过、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 不动），遇到 1 直接过，一次遍历 O(n)、O(1) 空间。"}]},{"ID":"20261001212411-pdiextm","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-pdiextm","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void sortColors(vector\u003cint\u003e\u0026 nums) {\n        int lo = 0, i = 0, hi = nums.size() - 1; // [0,lo) 是 0 区，[hi+1,n) 是 2 区，中间待处理\n        while (i \u003c= hi) {\n            if (nums[i] == 0) {\n                swap(nums[i], nums[lo]); // 0 换到左区\n                ++lo;\n                ++i;                     // 换过来的一定是 1（已处理过），可以直接前进\n            } else if (nums[i] == 2) {\n                swap(nums[i], nums[hi]); // 2 换到右区\n                --hi;                    // 换过来的数还没检查过，i 不能动，下一轮再看它\n            } else {\n                ++i;                     // 是 1，本来就在中间，直接跳过\n            }\n        }\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-779no9t","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-779no9t","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"99. 下一个排列（中等 · No.31）"}]},{"ID":"20261001212411-xo55zf7","Type":"NodeParagraph","Properties":{"id":"20261001212411-xo55zf7","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定整数数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，将它变成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"字典序中的下一个更大排列"},{"Type":"NodeText","Data":"；如果不存在更大的排列（即已经是降序），则将它重排为最小的排列（升序）。要求原地修改，只允许常数级额外空间。"}]},{"ID":"20261001212411-4rdgchz","Type":"NodeParagraph","Properties":{"id":"20261001212411-4rdgchz","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：从右往左找第一个「右侧存在更大数」的位置 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":"（即 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i] \u0026lt; nums[i+1]"},{"Type":"NodeText","Data":"），再从右找第一个比 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums[i]"},{"Type":"NodeText","Data":" 大的数 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"j"},{"Type":"NodeText","Data":" 交换，最后把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i"},{"Type":"NodeText","Data":" 右侧（此时必为降序）整体反转成升序得到最小的更大排列；若整个数组是降序则直接反转成升序。"}]},{"ID":"20261001212411-yq33lq1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-yq33lq1","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    void nextPermutation(vector\u003cint\u003e\u0026 nums) {\n        int n = nums.size();\n        int i = n - 2;\n        while (i \u003e= 0 \u0026\u0026 nums[i] \u003e= nums[i + 1]) --i; // 从右往左找第一个「左 \u003c 右」的位置，它需要被调大\n        if (i \u003e= 0) { // 找到了，说明还存在更大的排列\n            int j = n - 1;\n            while (nums[j] \u003c= nums[i]) --j; // 从右往左找第一个比 nums[i] 大的数（最小的那个）\n            swap(nums[i], nums[j]);         // 交换后，i 处的数变大，且 i 右侧仍保持降序\n        }\n        // 把 i 右侧的降序段反转成升序，得到「变大之后尽可能小」的排列（i\u003c0 时等价于整体升序重排）\n        reverse(nums.begin() + i + 1, nums.end());\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-z4m8uas","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261001212411-z4m8uas","updated":"20261001212411"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"100. 寻找重复数（中等 · No.287）"}]},{"ID":"20261001212411-bcvvi88","Type":"NodeParagraph","Properties":{"id":"20261001212411-bcvvi88","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"题目描述"},{"Type":"NodeText","Data":"：给定一个包含 n+1 个整数的数组 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nums"},{"Type":"NodeText","Data":"，其中的数字都在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[1, n]"},{"Type":"NodeText","Data":" 范围内，因此至少存在一个重复整数。假设"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只有一个数重复"},{"Type":"NodeText","Data":"（可能出现多次），找出这个重复的数。要求不修改数组、只使用常量级额外空间。"}]},{"ID":"20261001212411-jm3ai3p","Type":"NodeParagraph","Properties":{"id":"20261001212411-jm3ai3p","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思路"},{"Type":"NodeText","Data":"：把数组当下标映射成链表（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"i → nums[i]"},{"Type":"NodeText","Data":"），值域 1..n 保证一定有环，重复数就是环的入口：用快慢指针（慢走 1 步、快走 2 步）找到相遇点，再把一个指针放回 0、两指针同速前进，再次相遇处即重复数（Floyd 判圈），O(n)、O(1) 空间。"}]},{"ID":"20261001212411-eb6vgef","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20261001212411-eb6vgef","updated":"20261001212411"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Solution {\npublic:\n    int findDuplicate(vector\u003cint\u003e\u0026 nums) {\n        int slow = 0, fast = 0;\n        do {  // 第一阶段：快慢指针在环内相遇\n            slow = nums[slow];         // 慢指针走一步\n            fast = nums[nums[fast]];   // 快指针走两步\n        } while (slow != fast);\n        slow = 0; // 第二阶段：一个指针回到起点，两者都改成一次走一步\n        while (slow != fast) {\n            slow = nums[slow];\n            fast = nums[fast];\n        }\n        return slow; // 再次相遇的位置就是环的入口，也就是重复的那个数\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20261001212411-ti2z22h","Type":"NodeThematicBreak","Properties":{"id":"20261001212411-ti2z22h","updated":"20261001212411"}},{"ID":"20261001212411-tno69py","Type":"NodeParagraph","Properties":{"id":"20261001212411-tno69py","updated":"20261001212411"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全 100 题完。"},{"Type":"NodeText","Data":" 复习建议：按分类刷完后，对每题至少手写两遍「思路 + 代码」，重点吃透：双指针/滑动窗口的收缩时机、回溯的模板与剪枝、二分的边界写法（半开区间统一 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"l \u0026lt; r"},{"Type":"NodeText","Data":"）、单调栈的单调方向、以及动态规划的状态定义与转移方程。"}]}]}