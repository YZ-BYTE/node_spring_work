arkTextContent":"一类是企微业务日志"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，我会解析四段日志——\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"[Memory] 拿进程提交内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"VirtualAvaliable 拿系统虚拟地址和内存负载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"、\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"[sys] 拿系统提交内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"[MemoryInspector] 拿内置内存监控"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"另一类是 dump 硬证据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，就是 !analyze -v 里抽出来的 FAILURE_BUCKET_ID、异常码、错误码这些字段，\n比如异常码 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"0xE0000008 是 Chromium partition_alloc 的专用 OOM 码"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，一看就是内存分配失败。"}]},{"ID":"20260921170806-iqse9fz","Type":"NodeParagraph","Properties":{"id":"20260921170806-iqse9fz","updated":"20260921170817"},"Children":[{"Type":"NodeText","Data":"============"}]},{"ID":"20260920143602-7xvdlw3","Type":"NodeParagraph","Properties":{"id":"20260920143602-7xvdlw3","updated":"20260920143620"},"Children":[{"Type":"NodeText","Data":"（[Memory] 看企微进程吃了多少，[sys] 看全系统提交了多少，\n\t\tVirtualAvaliable 看进程和系统各自还剩多少——前两个看\"用了多少\"，它看\"剩了多少\"）"}]},{"ID":"20260921170808-r6s5prt","Type":"NodeParagraph","Properties":{"id":"20260921170808-r6s5prt","updated":"20260921170809"},"Children":[{"Type":"NodeText","Data":"============"}]},{"ID":"20260920141849-h2b2hk8","Type":"NodeParagraph","Properties":{"id":"20260920141849-h2b2hk8","updated":"20260920143319"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"判定用的是十条规则链，先命中先返回"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"。\n 核心思路是区分\"系统内存不足\"还是\"企微自身虚拟地址耗尽\"：\n比如"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"系统提交内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"使用率超过 95%、"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"可用页面文件"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"低于 200MB、内存负载 95% 以上，这些判成 system_oom；\n反过来如果"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"虚拟地址低于 200MB 但页面文件还有 1GB 以上"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，\n说明系统有余量、是企微自己地址耗尽，判成 wxwork_oom。\n还有 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"CDB 的 memory_summary 里 Free 低于 5% 这种精确数据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，也会优先命中。"}]},{"ID":"20260921170811-yu8n7jw","Type":"NodeParagraph","Properties":{"id":"20260921170811-yu8n7jw","updated":"20260921170815"},"Children":[{"Type":"NodeText","Data":"=============="}]},{"ID":"20260920141849-896jliu","Type":"NodeParagraph","Properties":{"id":"20260920141849-896jliu","updated":"20260920142452"},"Children":[{"Type":"NodeText","Data":"还有一个关键设计是优先级和兜底。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"日志结论优先于 dump 硬证据，因为日志是运行时真实观测"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，能区分系统还是企微；"}]},{"ID":"20260920141849-7dtmg8e","Type":"NodeParagraph","Properties":{"id":"20260920141849-7dtmg8e","updated":"20260920143142"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-inline-builtin-success-color, var(--b3-card-success-color)); background-color: var(--b3-inline-builtin-success-background-color, var(--b3-card-success-background));"},"TextMarkType":"text strong","TextMarkTextContent":"扫描上做了性能优化。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-inline-builtin-success-color, var(--b3-card-success-color)); background-color: var(--b3-inline-builtin-success-background-color, var(--b3-card-success-background));\"}"},{"Type":"NodeText","Data":"\n日志文件很大，我"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"先按 PID 精准匹配日志文件"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"命中不了再全目录兜底扫描"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"，\n中间还做了"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"日期预过滤"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"大文件采样判断、200 万行的扫描上限"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，避免超时。"}]},{"ID":"20261003111312-b8jodqm","Type":"NodeThematicBreak","Properties":{"id":"20261003111312-b8jodqm","updated":"20261003111312"}},{"ID":"20261003111315-x56kn2w","Type":"NodeThematicBreak","Properties":{"id":"20261003111315-x56kn2w","updated":"20261003111315"}},{"ID":"20260920133105-ze7apil","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260920133105-ze7apil","updated":"20261003111329"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"CPU部分"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"分析详情"}]},{"ID":"20260920145016-910q30z","Type":"NodeParagraph","Properties":{"id":"20260920145016-910q30z","updated":"20260920145031"},"Children":[{"Type":"NodeText","Data":"我做的 CPU 分析，就是专门识别 Intel 13/14 代处理器那个已知的硬件缺陷——\n这批 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"CPU 高负载下会偶尔算错数，导致程序随机崩溃"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260921170755-70r8pj5","Type":"NodeParagraph","Properties":{"id":"20260921170755-70r8pj5","updated":"20260921170758"},"Children":[{"Type":"NodeText","Data":"================="}]},{"ID":"20260920145016-kwc9880","Type":"NodeParagraph","Properties":{"id":"20260920145016-kwc9880","updated":"20260920145114"},"Children":[{"Type":"NodeText","Data":"第一步解析 !cpuid 拿到型号\n第二步看\"证据够不够硬\"，分强弱两档。\n硬证据有四种，单独出现就能定罪：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"崩溃位置到处乱崩"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"——把所有 dump 的崩溃位置去重，超过 3 个不同位置就定罪；\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"内存地址最高位被翻转"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"——把访问地址清掉最高位后能落回合法的低位区，而且不同 dump 清位后地址还都不一样；\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"寄存器里小整数被翻最高位"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"——某个寄存器值清位后正好落回 1~65535 的小整数；\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"日志里数据库反复损坏"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"——database disk image is malformed 出现 2 次以上。\n弱证据是 CRT 容器损坏、堆损坏，这些也可能只是软件 bug，所以单独出现不下结论。"}]},{"ID":"20260921170801-33ecd06","Type":"NodeParagraph","Properties":{"id":"20260921170801-33ecd06","updated":"20260921170802"},"Children":[{"Type":"NodeText","Data":"=================="}]},{"ID":"20260920145513-mf5yw07","Type":"NodeParagraph","Properties":{"id":"20260920145513-mf5yw07","updated":"20260920150842"},"Children":[{"Type":"NodeText","Data":"其中地址翻转和寄存器翻转是互补的：\n一个抓\"污染的结果\"（访问地址），一个抓\"污染的源头\"（寄存器）。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"因为地址可能在崩溃前被算术运算洗白、第一种就抓不到了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，\n但寄存器里还残留着那个被翻位的小整数，第二种能兜住。\n反过来，第二种也只认一种情况——翻的是个\"小数字\"（清位后落回 1~65535）。\n如果翻的是个正常地址（清位后是个大数字），第二种就分不清了，只能靠第一种来抓。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"另外，地址数据本来就是现成的、每个 dump 都有，而寄存器还得额外再跑一次命令去拿"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"}]},{"ID":"20261003111327-c62yx69","Type":"NodeThematicBreak","Properties":{"id":"20261003111327-c62yx69","updated":"20261003111327"}},{"ID":"20261003111329-9bztxm3","Type":"NodeThematicBreak","Properties":{"id":"20261003111329-9bztxm3","updated":"20261003111329"}},{"ID":"20260905152340-fspo9ky","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260905152340-fspo9ky","updated":"20260921171921"},"Children":[{"Type":"NodeText","Data":"0xC0000005 表示访问违例"}]},{"ID":"20260905152344-hvq72wf","Type":"NodeParagraph","Properties":{"id":"20260905152344-hvq72wf","updated":"20260905152354"},"Children":[{"Type":"NodeText","Data":"读取了无效地址\n向无效地址写数据\n从无效地址执行代码"}]},{"ID":"20260905170117-8nzbj0q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260905170117-8nzbj0q","updated":"20260921171733"},"Children":[{"Type":"NodeText","Data":"Hook注入导致的堆破坏"}]},{"ID":"20260921170932-x20ln4i","Type":"NodeParagraph","Properties":{"id":"20260921170932-x20ln4i","updated":"20260921171618"},"Children":[{"Type":"NodeText","Data":"第三方注入模块破坏堆时，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"改的是堆管理器的元数据或对象虚表指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，不是自己的数据。\n堆块元数据就是堆管理器用来"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"strong text","TextMarkTextContent":"管理内存块的记账信息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"放在每个内存块最前面"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"；\n记录块大小、占用状态，空闲块额外保存双向链表指针，方便堆管理器快速找到空闲内存。"}]},{"ID":"20260921170932-ccu45u8","Type":"NodeParagraph","Properties":{"id":"20260921170932-ccu45u8","updated":"20260921171647"},"Children":[{"Type":"NodeText","Data":"典型越界写：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"模块申请 100 字节却写了 200，多出的部分正好覆盖相邻堆块的块头，改了它的 Size、Flags（连带 Flink/Blink）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"strong text","TextMarkTextContent":"这一写发生在合法可写区内，被改的字段当下不会被读，所以不触发任何异常，函数正常返回退栈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"。"},{"Type":"NodeText","Data":"\n崩溃要等到下一次分配/释放或虚函数调用\n——企微自己的正常逻辑顺着被污染的 Size 找下一块、或顺着 Flink/Blink 遍历链表，访问到非法地址才崩。"}]},{"ID":"20260921171659-9atmm1n","Type":"NodeParagraph","Properties":{"id":"20260921171659-9atmm1n","updated":"20260921171700"},"Children":[{"Type":"NodeText","Data":"======================"}]},{"ID":"20260921170932-x6l3mo4","Type":"NodeParagraph","Properties":{"id":"20260921170932-x6l3mo4","updated":"20260921171733"},"Children":[{"Type":"NodeText","Data":"这个错位带来归因风险：光看栈顶会把受害方误判成责任方。\n所以归因不能轻信栈顶，要回溯调用链看有没有第三方模块的连续残留帧——连续达到阈值才判它主因；\n痕迹不连续、或栈已被破坏得结构紊乱，就不给高置信结论，降级并标注内存破坏特征，交人工复核。"}]},{"ID":"20260911093008-69mhubu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260911093008-69mhubu","updated":"20261003154435"},"Children":[{"Type":"NodeText","Data":"Hook注入"}]},{"ID":"20260911093022-ct0ju54","Type":"NodeParagraph","Properties":{"id":"20260911093022-ct0ju54","updated":"20260921171959"},"Children":[{"Type":"NodeText","Data":"本质是劫持程序原有函数执行流程，拦截函数调用，在目标函数执行前/后插入自己的代码\nHook注入：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"把写的Hook钩子代码强行加载进目标进程，实现劫持目标程序内部函数的整套技术"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n注入的目的，就是把写的Hook代码加载到目标进程的内存空间里，不然我们的代码在自己进程，根本碰不到目标程序"}]},{"ID":"20260911093256-lzwvj5k","Type":"NodeParagraph","Properties":{"id":"20260911093256-lzwvj5k","updated":"20260911093419"},"Children":[{"Type":"NodeText","Data":"原本程序调用流程：A函数--\u003eB函数（原逻辑）--\u003e结果\nHook劫持后：A函数--\u003e我的钩子代码--\u003e原B函数--\u003e后置自定义代码--\u003e结果"}]},{"ID":"20260921172819-gam85lk","Type":"NodeParagraph","Properties":{"id":"20260921172819-gam85lk","updated":"20260921172821"},"Children":[{"Type":"NodeText","Data":"======================="}]},{"ID":"20260911095147-3myr5ds","Type":"NodeParagraph","Properties":{"id":"20260911095147-3myr5ds","updated":"20260921173048"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"先说 IAT Hook。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"PE 导入表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，就是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":" PE 文件里一张记录外部函数信息的表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n程序调用 DLL 里的函数时，会从这张表里拿到函数真实内存地址\n所谓导入，就是进程加载 DLL 的时候，系统自动填充这张表里的函数地址\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"IAT Hook 就是修改这张导入表，把表里原始函数地址替换成我们钩子函数地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，适合钩 DLL 导出函数\n实现简单，但不能钩程序内部函数"}]},{"ID":"20260911095147-75ct058","Type":"NodeParagraph","Properties":{"id":"20260911095147-75ct058","updated":"20261003154435"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"再讲 Inline Hook。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n它"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"直接"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"修改目标函数入口的机器指令"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"（通"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text strong","TextMarkTextContent":"过目标函数的内存起始地址，直接读取进程内存，拿到开头的机器码"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n首先读取并备份目标函数开头几条原始指令，然后"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"在函数入口写入一条"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":" jmp 跳转指令"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n让程序一进到这个函数，就跳到我们的 Hook 代码\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"被覆盖掉的原始指令，我们放到一块申请好的内存，做成跳板"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n等我们前置逻辑跑完，就执行跳板里备份的指令，再跳回原函数剩下代码继续跑\nInline Hook 通用性更强，任何函数都能钩，但是坑更多，要注意寄存器、栈平衡和多线程问题"}]},{"ID":"20260911100633-zy7sjok","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260911100633-zy7sjok","updated":"20260921173359"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Hook注入对崩溃Dump分析的坏处"}]},{"ID":"20260911100633-4t9r45v","Type":"NodeParagraph","Properties":{"id":"20260911100633-4t9r45v","updated":"20260921173326"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"调用栈路线乱了，找不到真实报错位置"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n原本 A 调用 B，B 出错崩溃，栈一目了然。\nHook 插了岔路后路线变成：A→钩子代码→B。\n崩溃时栈里会多出钩子程序的函数，很容易误以为是自己代码崩了，实则是第三方钩子代码出错带崩了你的程序。"}]},{"ID":"20260921173328-mlccc8e","Type":"NodeParagraph","Properties":{"id":"20260921173328-mlccc8e","updated":"20260921173415"},"Children":[{"Type":"NodeText","Data":"==================="}]},{"ID":"20260911100633-dlxlo4w","Type":"NodeParagraph","Properties":{"id":"20260911100633-dlxlo4w","updated":"20260911100936"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"改了原始指令，现场被篡改"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Inline Hook 会直接改掉目标函数开头的几条机器码，用来跳转。"},{"Type":"NodeText","Data":"\n看崩溃快照时，函数开头代码已经不是原版样子，你根本看不到原始代码本该是什么样，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"没法判断原生逻辑的问题"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260921173342-r96q6x4","Type":"NodeParagraph","Properties":{"id":"20260921173342-r96q6x4","updated":"20260921173420"},"Children":[{"Type":"NodeText","Data":"===================="}]},{"ID":"20260911100633-tjyx5n5","Type":"NodeParagraph","Properties":{"id":"20260911100633-tjyx5n5","updated":"20260911100959"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"内存、堆被钩子搞坏"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"钩子代码申请释放内存不规范，会顺带弄坏程序本身的内存数据。"},{"Type":"NodeText","Data":"\n查看内存、堆结构的时候一片错乱，无法正常解析对象、变量。\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"甚至钩子用完偷偷卸载自身，崩溃时模块已经消失，栈上只剩一串无效地址，查起来完全无头。"}]},{"ID":"20260921173359-y4qg2jf","Type":"NodeThematicBreak","Properties":{"id":"20260921173359-y4qg2jf","updated":"20260921173359"}},{"ID":"20260913230148-l9s9p68","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913230148-l9s9p68","updated":"20260921173906"},"Children":[{"Type":"NodeText","Data":"两种栈溢出kb的输出情况"}]},{"ID":"20260913232959-6rl3n7p","Type":"NodeParagraph","Properties":{"id":"20260913232959-6rl3n7p","updated":"20260913233049"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"递归栈溢出时"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，栈帧完整，kb 可看到大量重复函数帧，能直接定位到递归函数\n它是递归深度过大耗尽栈空间，触发 c00000fd"}]},{"ID":"20260913233050-2gt9b4p","Type":"NodeParagraph","Properties":{"id":"20260913233050-2gt9b4p","updated":"20260921173906"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"缓冲区栈溢出"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"是栈上缓冲区越界覆盖返回地址，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"栈帧被破坏"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\nkb 出现非法 RetAddr 并告警，调用链断裂，无法靠 kb 还原原始调用栈，异常常为"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":" c0000005"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"}]},{"ID":"20260913233102-ctp9c72","Type":"NodeParagraph","Properties":{"id":"20260913233102-ctp9c72","updated":"20260913233104"},"Children":[{"Type":"NodeText","Data":"二者本质区别：递归溢出栈结构完好，缓冲区溢出栈元数据被篡改"}]},{"ID":"20260913233205-dymihdt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260913233205-dymihdt","updated":"20261003160240"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"栈溢出+空栈场景为什么很有可能是Hook"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"}]},{"ID":"20260913233331-oc6k9t5","Type":"NodeParagraph","Properties":{"id":"20260913233331-oc6k9t5","updated":"20261003160240"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"能制造无限递归的，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"最常见的就是 hook 的跳板逻辑自环"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n——"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"inline hook 的 trampoline "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"回调原函数时又落回自己被 hook 的入口"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"或者"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"多个安全软件互相 hook 同一个函数、链成环"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，一层层把栈吃光"}]},{"ID":"20260921174443-52vaqoj","Type":"NodeParagraph","Properties":{"id":"20260921174443-52vaqoj","updated":"20260921174445"},"Children":[{"Type":"NodeText","Data":"======================="}]},{"ID":"20260913233331-88ikgdw","Type":"NodeParagraph","Properties":{"id":"20260913233331-88ikgdw","updated":"20260921174358"},"Children":[{"Type":"NodeText","Data":"而\"空栈\"不是真的空，是被过滤器剃空的\nhook 递归的栈恰好两个都踩："},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text strong","TextMarkTextContent":"递归主体全落在系统模块里被第一道剔光，hook 模块自己的帧又多半没符号"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"}]},{"ID":"20260913233331-zdwobs9","Type":"NodeParagraph","Properties":{"id":"20260913233331-zdwobs9","updated":"20260921174439"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"能既吃光整条栈、又让用户帧消失的，只有在系统 API 层反复绕圈的调用链"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，这就是 hook 的形态\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"再叠加环境里加载了 DLP/Hook 类第三方模块"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，就基本坐实了"}]},{"ID":"20260913233331-mwcdfdr","Type":"NodeParagraph","Properties":{"id":"20260913233331-mwcdfdr","updated":"20260921174509"},"Children":[{"Type":"NodeText","Data":"不过空栈本身是过滤器的副作用，也可能是符号缺失或栈被破坏，所以我们只当高嫌疑，得有环境佐证才归因"}]},{"ID":"20260921175322-ckt2i27","Type":"NodeParagraph","Properties":{"id":"20260921175322-ckt2i27","updated":"20260921175327"},"Children":[{"Type":"NodeText","Data":"==================="}]},{"ID":"20260913234133-ajc6p0l","Type":"NodeParagraph","Properties":{"id":"20260913234133-ajc6p0l","updated":"20260917152805"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"访问违例加空栈再加 CreateProcess 调用链，对应的是 IAT Hook 腐败。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-font-color11);\"}"}]},{"ID":"20260913234133-6es1hkh","Type":"NodeParagraph","Properties":{"id":"20260913234133-6es1hkh","updated":"20260921175353"},"Children":[{"Type":"NodeText","Data":"原理是这样：\n模块调 CreateProcessW 不是直接跳到 kernel32(用户态系统库)，\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"而是跳过一个存在 IAT 导入地址表里的函数指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\nDLP 软件为了拦截进程创建，会把这个 IAT 槽改成自己的 hook 地址\n如果 DLP 的 hook 模块被卸载了，IAT 槽还指着旧地址，\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"业务代码一调 CreateProcessW 就跳到被释放的野指针上\n直接 0xC0000005 访问违例"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"}]},{"ID":"20260921175520-5izhsfe","Type":"NodeParagraph","Properties":{"id":"20260921175520-5izhsfe","updated":"20260921175524"},"Children":[{"Type":"NodeText","Data":"======================="}]},{"ID":"20260913234133-ufsrz2c","Type":"NodeParagraph","Properties":{"id":"20260913234133-ufsrz2c","updated":"20260921175408"},"Children":[{"Type":"NodeText","Data":"那为什么是空栈？\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"因为崩溃就发生在跳转那一刻，CreateProcessW 函数体根本没执行"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"栈上那一帧在 kernel32 透明模块里被过滤掉了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n真正跳飞的崩溃地址又不在任何已知模块、没有模块信息，也被剃掉，所以 userFrames 又空了。"}]},{"ID":"20260921175527-1hv0f2w","Type":"NodeParagraph","Properties":{"id":"20260921175527-1hv0f2w","updated":"20260921175532"},"Children":[{"Type":"NodeText","Data":"======================="}]},{"ID":"20260913234133-vqav174","Type":"NodeParagraph","Properties":{"id":"20260913234133-vqav174","updated":"20260921175547"},"Children":[{"Type":"NodeText","Data":"这和栈溢出那条是同源不同病：\n都是第三方 hook 导致系统模块崩溃、症状都是空栈\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"区别是栈溢出对应 hook 递归把自己绕死，IAT 腐败对应 hook 跳转链断裂跳到野指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260921175550-rsay1is","Type":"NodeParagraph","Properties":{"id":"20260921175550-rsay1is","updated":"20260921175553"},"Children":[{"Type":"NodeText","Data":"======================="}]},{"ID":"20260921175548-3wagrp4","Type":"NodeParagraph","Properties":{"id":"20260921175548-3wagrp4","updated":"20260921175623"},"Children":[{"Type":"NodeText","Data":"所以判定\n一条是溢出 0xC00000FD，\n一条是访问违例 0xC0000005 加栈里出现 CreateProcess\n再叠加环境里有 DLP 类模块，就能定性为 IAT Hook 腐败"}]},{"ID":"20260914213044-ljccld4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260914213044-ljccld4","updated":"20261003162950"},"Children":[{"Type":"NodeText","Data":"工具遇到需要解压大zip和上传大dump时是怎么做的"}]},{"ID":"20260914214247-5svp8on","Type":"NodeParagraph","Properties":{"id":"20260914214247-5svp8on","updated":"20261003162855"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"解压大 zip 的关键是别卡 UI、别重复解。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n 解压前先算指纹，computeFileSha1 "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"按 1MB 分块流式读"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，\n然后拿这个指纹当解压目录名（temp/CrashAnalyze/\u003csha1\u003e/）"}]},{"ID":"20260921175920-wd78phb","Type":"NodeParagraph","Properties":{"id":"20260921175920-wd78phb","updated":"20260921175922"},"Children":[{"Type":"NodeText","Data":"============================"}]},{"ID":"20260914214247-5xvsfiz","Type":"NodeParagraph","Properties":{"id":"20260914214247-5xvsfiz","updated":"20261003162924"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"上传大 dump 的关键是别白传、别拖垮服务。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n上传前"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"先做本地 SHA-1 去重"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n上传时流式上传"}]},{"ID":"20260921180254-19t0tsm","Type":"NodeParagraph","Properties":{"id":"20260921180254-19t0tsm","updated":"20260921180257"},"Children":[{"Type":"NodeText","Data":"==========================="}]},{"ID":"20260921180252-uspvivj","Type":"NodeParagraph","Properties":{"id":"20260921180252-uspvivj","updated":"20261003162950"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"用File.openRead()拿字节流---文件不会一次性读进内存，而是分成小块往外送\ndio对stream类型不会自动算文件大小，所以先"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"file.length()"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-font-color11);\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"拿到字节数\n手动写进请求头，服务才知道什么时候传完了"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"手动覆写 Content-Type — dio 默认发 JSON 头，\n上传二进制必须改成 application/octet-stream\n否则服务端会按 JSON 解析直接报错"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260921180303-z8s1u5i","Type":"NodeParagraph","Properties":{"id":"20260921180303-z8s1u5i","updated":"20260921180306"},"Children":[{"Type":"NodeText","Data":"=========================="}]},{"ID":"20260921180259-gleommg","Type":"NodeParagraph","Properties":{"id":"20260921180259-gleommg","updated":"20261003162155"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"本质就是：dio.put() + file.openRead() 流式 body + 手动补两个 header，搞定大文件上传。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\nfile.openRead() 把本地 dump 文件变成一条按需逐块读取的字节流（边读边发、不撑内存），\ndio.put() 拿着这条流当请求体，把文件以 HTTP PUT 流式上传到服务端。"}]},{"ID":"20260914221746-58v3iz0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260914221746-58v3iz0","updated":"20260921180409"},"Children":[{"Type":"NodeText","Data":"用户传一半不传了怎么处理"}]},{"ID":"20260914222823-igzfn5d","Type":"NodeParagraph","Properties":{"id":"20260914222823-igzfn5d","updated":"20260921180358"},"Children":[{"Type":"NodeText","Data":"第一层是临时文件\n上传前服务端会给每个 token 建一个临时目录，上传中断后文件就留在这\n后台"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"每天跑一次清理任务"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，扫描 tmp 目录，如果文件修改时间超过几小时且 token 不在活跃列表里，就整个目录删掉\n如果客户端只是断了几秒正在重连，token 还在内存里，会跳过不删，防止误删"}]},{"ID":"20260921180407-lzigm4c","Type":"NodeParagraph","Properties":{"id":"20260921180407-lzigm4c","updated":"20260921180409"},"Children":[{"Type":"NodeText","Data":"===================="}]},{"ID":"20260914222823-732akwe","Type":"NodeParagraph","Properties":{"id":"20260914222823-732akwe","updated":"20260914222912"},"Children":[{"Type":"NodeText","Data":"第二层是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"已落盘的 dump"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n上传成功的文件会移到 dumps/\u003csha1\u003e.dmp，有独立的月度过期清理\n删除超过 N 天未访问的 dump，但至少保留最近几个，正在被 CDB session 用的也不会删"}]},{"ID":"20260914223006-vjrgqmi","Type":"NodeParagraph","Properties":{"id":"20260914223006-vjrgqmi","updated":"20260914223010"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"用户手动取消分析时，会发生三件事："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260914223006-lclmm9u","Type":"NodeParagraph","Properties":{"id":"20260914223006-lclmm9u","updated":"20260914223020"},"Children":[{"Type":"NodeText","Data":"取消在途请求\nManager 创建一个 CrashMcpCancellationToken，底层包装了 dio 的 CancelToken\n用户点取消时调 cancel()，所有正在发的 HTTP 请求（上传、分析命令等）立刻中断抛 DioException"}]},{"ID":"20260914223611-l5j8b2c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260914223611-l5j8b2c","updated":"20260914223617"},"Children":[{"Type":"NodeText","Data":"客户端打开超大 dump 文件或者超大 log，怎么保证打开时内存不被挤爆，还能流畅上下滚动查看"}]},{"ID":"20260914223609-zxugkrs","Type":"NodeParagraph","Properties":{"id":"20260914223609-zxugkrs","updated":"20260914223638"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"虚拟滚动"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\nUI 层用 ListView.builder 这类懒加载列表，只渲染可视区域内的几十行\n滚动时动态回收和创建 widget，内存里永远只有屏幕大小的数据"}]},{"ID":"20260914223609-bhks0bj","Type":"NodeParagraph","Properties":{"id":"20260914223609-bhks0bj","updated":"20260914223701"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"流式读取 + 分页加载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n文件不一次性 readAsBytes() 全读进内存，而是用 File.openRead() 流式读、按需加载\n比如先读前 1000 行显示，滚动到底再加载下一批\n代码库里处理大 log 就是这么做的——_readFirstNLines() 只读前 N 行做采样判断，避免全量读"}]},{"ID":"20260914223609-edk8tst","Type":"NodeParagraph","Properties":{"id":"20260914223609-edk8tst","updated":"20260914223727"},"Children":[{"Type":"NodeText","Data":"行数上限兜底\n设一个 maxTotalLines（比如 200 万行），超过就停读，防止极端情况内存爆掉\n同时大文件先做采样：读前 2000 行判断时间范围，无关文件直接跳过，根本不进内存"}]},{"ID":"20260915082311-ptvgg1d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260915082311-ptvgg1d","updated":"20260916230149"},"Children":[{"Type":"NodeText","Data":"快速滚轮滚动时会频繁 IO，会不会卡住？怎么处理？"}]},{"ID":"20260915082322-d449pts","Type":"NodeParagraph","Properties":{"id":"20260915082322-d449pts","updated":"20260915084040"},"Children":[{"Type":"NodeText","Data":"会卡，因为每次滚到新位置都要等磁盘读完才能渲染，磁盘IO延迟几十毫秒，用户能明显到卡顿\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"处理思路："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text strong","TextMarkTextContent":"MMAP"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n打开大文件时不一次性读进内存，用 mmap 把文件映射到虚拟地址空间\n传统 read：应用发请求 → 内核读磁盘 → 拷贝到用户空间 → 应用才能用，两次拷贝\nmmap：应用直接访问映射地址 → 操作系统透明处理缺页中断，只拷贝一次\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"预取+缓存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n不要等用户滚到才读，而是提前加载\n比如滚动到列表80%位置时就把下一批数据缓存到内存里，用户滚过去时数据已经存在了\n已经读过的也缓存住，来回滚动不重复IO\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"异步+占位"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\nIO放后台Isolate做，主线程不阻塞\n还没加载出来的区域显示骨架屏或loading占位符，加载完再替换\n用户看到的是“滑过去有个loading，马上出来”，而不是“卡住不动”\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"strong text","TextMarkTextContent":"节流滚动回调"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n加一个\"等一等\"的机制：每次滚动事件来了不立刻去读，而是开一个 150 毫秒的倒计时\n如果 150 毫秒内又来了新的滚动事件，就把上一次的倒计时取消、重新开一个新的\n等用户真正停下来，超过 150 毫秒没新的滚动了，才拿最后停的位置去读磁盘加载数据\n这样不管用户滚多快，最终只会触发一次 IO 请求"}]},{"ID":"20260916230149-e3g97tu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916230149-e3g97tu","updated":"20260918110510"},"Children":[{"Type":"NodeText","Data":"MCP会话关闭潜在风险"}]},{"ID":"20260916230157-nk8gtha","Type":"NodeParagraph","Properties":{"id":"20260916230157-nk8gtha","updated":"20260916230208"},"Children":[{"Type":"NodeText","Data":"预筛选阶段出现意外错误时，Session 的关闭责任不明确\n导致部分异常路径没有执行清理，Session 泄漏并持续占用服务器资源"}]},{"ID":"20260916230211-c8ki1rf","Type":"NodeParagraph","Properties":{"id":"20260916230211-c8ki1rf","updated":"20260916230253"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"解决："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n在预筛选流程中"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"引入"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":" transferSessionOwnership "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"标志"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"并结合 try/finally 管理 Session 生命周期"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n只有确认是有效 crash、需要交给深度分析的 Session 才"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"转移所有权"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"其他情况"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，包括异常路径，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"统一在 finally 中关闭"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"}]},{"ID":"20260918110510-n2xszsw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918110510-n2xszsw","updated":"20260921180837"},"Children":[{"Type":"NodeText","Data":"这个工具的输入输出是什么"}]},{"ID":"20260918110525-4giydcs","Type":"NodeParagraph","Properties":{"id":"20260918110525-4giydcs","updated":"20260918110813"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"直接输入是用户从文件选择器选的三类文件：.zip 反馈包、.dmp dump 文件，或者两者混选"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"}]},{"ID":"20260921180831-x43knyl","Type":"NodeParagraph","Properties":{"id":"20260921180831-x43knyl","updated":"20260921180833"},"Children":[{"Type":"NodeText","Data":"========"}]},{"ID":"20260918110525-33mh9ez","Type":"NodeParagraph","Properties":{"id":"20260918110525-33mh9ez","updated":"20260918110847"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"UI 层只负责把它们转成本地绝对路径列表交给 Manager"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"\n剩下的都在这条流水线内部消化——zip 会被解压成目录树，dmp 直接校验存在性\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"最终统一归一化成\"待分析的 dump 列表\""},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n然后经过去重、预筛，收敛成最多 5 个候选（每个带 sessionId、quick_triage 原始结果、PID、崩溃时间）\n所以严格说，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"真正的分析输入是这批候选 dump 对应的 CDB session + 深度采证出来的 DeepCollectionResult"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"}]},{"ID":"20260921180835-8i53ovj","Type":"NodeParagraph","Properties":{"id":"20260921180835-8i53ovj","updated":"20260921180837"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260918110525-b4lh38f","Type":"NodeParagraph","Properties":{"id":"20260918110525-b4lh38f","updated":"20260918111429"},"Children":[{"Type":"NodeText","Data":"输出\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"运行时输出是 MultiDumpAnalysisResult，这是给 UI 消费的顶层结果"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n里面有 dump 总数、崩溃模式数、每个分组的 GroupSummary（分组信息 + LocalAnalysisResult）、总体结论、总耗时\n以及可选的内存专项和 CPU 专项结果\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"每个分组的归因结果里最核心的四样东西是：分类、evidenceList 技术证据、userReply 客服话术"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260918110525-5l3ixvh","Type":"NodeParagraph","Properties":{"id":"20260918110525-5l3ixvh","updated":"20260918111501"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"另一个输出是归档记录"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"：\n同一份结果会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"再表达"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"成 AnalysisArchiveRecord\n写成本地 JSONL 并异步 POST 上报到统计后台，形成运营统计和质量反馈闭环"}]},{"ID":"20260918111607-78lgjt4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918111607-78lgjt4","updated":"20260918112035"},"Children":[{"Type":"NodeText","Data":"输出给客服的是什么"}]},{"ID":"20260918111825-l810nf6","Type":"NodeParagraph","Properties":{"id":"20260918111825-l810nf6","updated":"20260918111836"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"一段可以直接复制粘贴给用户的中文结论和排查建议"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，不是技术堆栈"}]},{"ID":"20260918111825-a5vi9s8","Type":"NodeParagraph","Properties":{"id":"20260918111825-a5vi9s8","updated":"20260918112018"},"Children":[{"Type":"NodeText","Data":"具体包括：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"归因结论"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"（比如\"由某第三方软件导致\"，或\"系统内存不足，请增加虚拟内存\"）\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"崩溃dll在电脑中的目录位置"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"按成本排序的排查建议"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n以"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"及这次问题涉及多少个 dump以及崩溃时间"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"}]},{"ID":"20260918111825-69kyo4l","Type":"NodeParagraph","Properties":{"id":"20260918111825-69kyo4l","updated":"20260918112035"},"Children":[{"Type":"NodeText","Data":"核心设计是技术证据和客服话术分离：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"evidenceList"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":" 是给研发看的异常码、栈帧、模块路径\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"userReply "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"是给客服用的自然语言，UI 把多个分组的同标题话术合并展示并支持一键复制"}]},{"ID":"20260918111127-v83wi11","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918111127-v83wi11","updated":"20260921181049"},"Children":[{"Type":"NodeText","Data":"解压之后，你是怎么从反馈包里找到 dump 文件的？"}]},{"ID":"20260918111143-k49ece1","Type":"NodeParagraph","Properties":{"id":"20260918111143-k49ece1","updated":"20260921180910"},"Children":[{"Type":"NodeText","Data":"解压完之后，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"工具会对这棵解压出来的目录树做一次深度优先递归遍历"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"边走目录边按扩展名分类"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":".dmp 直接收进 dump 列表，.pdb/.dll 收进符号文件列表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"\n遇到 .dmp.log 会读文件头的 MDMP 魔数判断它其实是伪装的 Minidump\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"遇到内层 .zip 就解压到 _inner 子目录再递归往下扫"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260921180928-d1tueug","Type":"NodeParagraph","Properties":{"id":"20260921180928-d1tueug","updated":"20260921180930"},"Children":[{"Type":"NodeText","Data":"============"}]},{"ID":"20260918111143-nu1gj3j","Type":"NodeParagraph","Properties":{"id":"20260918111143-nu1gj3j","updated":"20260918111241"},"Children":[{"Type":"NodeText","Data":"遍历过程做了两个保护：\n深度限制 10 层，并且不跟随符号链接防成环\n另外卡顿采样目录整棵子树直接跳过，只统计数量给 UI 提示"}]},{"ID":"20260918111143-09wxl2a","Type":"NodeParagraph","Properties":{"id":"20260918111143-09wxl2a","updated":"20260921181049"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"收完以后还会排个序，先按修改时间从新到旧"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n再把 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"Bugreport/ 目录下的 dump 提到最前"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，保证预筛优先分析系统自动生成的崩溃 dump"}]},{"ID":"20260918112950-8i518ba","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918112950-8i518ba","updated":"20261003162413"},"Children":[{"Type":"NodeText","Data":"对崩溃栈做分析时用到的上下文信息是哪来的"}]},{"ID":"20260918113114-qp4glk5","Type":"NodeParagraph","Properties":{"id":"20260918113114-qp4glk5","updated":"20260918113120"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"崩溃栈分析的上下文是三层融合来的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260918113114-jwlbk5x","Type":"NodeParagraph","Properties":{"id":"20260918113114-jwlbk5x","updated":"20261003162409"},"Children":[{"Type":"NodeText","Data":"第一层\n是 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"dump 里的现场证据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"都通过 CDB MCP 服务采出来"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"：\n.exr -1 打印最后一条异常记录拿异常码、异常地址和栈帧，\n.ecxr; kb 切到异常上下文拿完整调用栈和寄存器，\nmodule_list 拿加载的模块列表，\n!analyze -v 拿 faultingModule 和 failureBucketId，\n路径缺失再用 lmvm 补。"}]},{"ID":"20260918113114-o4f0sl6","Type":"NodeParagraph","Properties":{"id":"20260918113114-o4f0sl6","updated":"20261003162411"},"Children":[{"Type":"NodeText","Data":"第二层\n是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"运行环境上下文"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n也就是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"栈里的模块属于谁"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"来自 config.json 里的 crash_knowledge 名册"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n——透明系统模块、企微模块、第三方厂商名册和场景关联规则，规则引擎靠它把栈帧映射成第三方/企微/系统/未知"}]},{"ID":"20260918113114-vkzsjka","Type":"NodeParagraph","Properties":{"id":"20260918113114-vkzsjka","updated":"20261003162413"},"Children":[{"Type":"NodeText","Data":"第三层\n是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"跨 dump 的批次上下文"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"同组签名、同批次其他组的崩溃模式分散度，还有预筛阶段的 quickTriageHint，用作栈帧降级时的兜底来源"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260918114303-9e563v5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918114303-9e563v5","updated":"20260921181230"},"Children":[{"Type":"NodeText","Data":"怎么区分崩溃是第三方软件引起的，还是程序自己的 Bug？"}]},{"ID":"20260918135037-h2i6hf4","Type":"NodeParagraph","Properties":{"id":"20260918135037-h2i6hf4","updated":"20260918135125"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"栈顶不等于根因，判断的是\"位置 + 归属 + 环境\"三重证据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"，而不是谁崩在栈顶就算谁"}]},{"ID":"20260918135037-c1cschi","Type":"NodeParagraph","Properties":{"id":"20260918135037-c1cschi","updated":"20260918135037"},"Children":[{"Type":"NodeText","Data":"具体分三类证据："}]},{"ID":"20260918135037-nhybaw1","Type":"NodeParagraph","Properties":{"id":"20260918135037-nhybaw1","updated":"20260918141521"},"Children":[{"Type":"NodeText","Data":"第一类是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text strong","TextMarkTextContent":"名册匹配"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n 我们从 config.json 里加载第三方厂商和模块名册，然后"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"strong text","TextMarkTextContent":"把栈帧的模块名拿去查"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\nS3-A 看栈顶用户帧，栈顶命中就给高置信度\nS3-B 是栈顶没命中就往前 20 帧扫，按帧深度分级，越靠后置信度越低\n而且带防劫持：\n如果命中已知厂商之前，未知模块已经连续出现两帧以上，说明未知模块更接近崩点，就跳过这条已知厂商命中"}]},{"ID":"20260921181225-okln85x","Type":"NodeParagraph","Properties":{"id":"20260921181225-okln85x","updated":"20260921181227"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260918135037-y6cwpf8","Type":"NodeParagraph","Properties":{"id":"20260918135037-y6cwpf8","updated":"20260918210851"},"Children":[{"Type":"NodeText","Data":"第二类是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text strong","TextMarkTextContent":"场景关联"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"解决\"崩在系统模块但根因是第三方\"的隐式情况"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n① 看场景特征——栈里有没有相关函数（如输入法的 WordBreak、ImmGetCompositionString）\n或异常码对不对（io_error 就是纯异常码触发）\n② 看环境里是否加载了对应类别的第三方模块；\n③ 最关键，再确认这个厂商模块有没有真的出现在崩溃调用栈里——在栈里才给中置信度，只是被加载就只能给低置信度"}]},{"ID":"20260918210234-d0oxrcj","Type":"NodeParagraph","Properties":{"id":"20260918210234-d0oxrcj","updated":"20260918210326"},"Children":[{"Type":"NodeText","Data":"这里有个容易搞混的点：\"崩在系统模块\"是靠原始栈判断的，不是靠过滤后的 userFrames"}]},{"ID":"20260921181229-eflalmk","Type":"NodeParagraph","Properties":{"id":"20260921181229-eflalmk","updated":"20260921181230"},"Children":[{"Type":"NodeText","Data":"=========="}]},{"ID":"20260918135037-1jozujk","Type":"NodeParagraph","Properties":{"id":"20260918135037-1jozujk","updated":"20260918141530"},"Children":[{"Type":"NodeText","Data":"第三类是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);"},"TextMarkType":"text strong","TextMarkTextContent":"未知模块兜底"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);\"}"},{"Type":"NodeText","Data":"\n栈里有非企微、非透明、也不在名册里的模块，就归为\"未知第三方\"，按出现频次排序，话术只展示 Top3"}]},{"ID":"20260918135037-chsgdr9","Type":"NodeParagraph","Properties":{"id":"20260918135037-chsgdr9","updated":"20260918210636"},"Children":[{"Type":"NodeText","Data":"怎么区分第三方还是企微自身：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"企微自身的判定是最后一道，要等硬件、CEF 环境异常、I/O 错误、第三方命中、场景关联全部没命中"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n而且栈顶用户帧属于企微，才进 S5\n进去之后还要再筛：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"有内存破坏时看连续帧可靠性——企微连续三帧以上才判企微，第三方连续三帧以上就判\"企微是受害者\"\n两边都不连续就判栈不可信"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n没有内存破坏时，先看有没有未知模块（有就转未知第三方）\n再看环境里有没有 Hook 类软件（有就把置信度从高降到中）\n所以\"栈顶是企微\"只是必要条件，不是充分条件"}]},{"ID":"20260918211011-bac6xx6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918211011-bac6xx6","updated":"20260918232212"},"Children":[{"Type":"NodeText","Data":"crash分析为什么不能只看调用栈"}]},{"ID":"20260918212039-4iwi1mj","Type":"NodeParagraph","Properties":{"id":"20260918212039-4iwi1mj","updated":"20260918214431"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"调用栈只能告诉你\"程序崩在哪\"，不能告诉你\"是谁把它弄坏的\""},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"栈顶在很多场景里其实是受害者，不是肇事者"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"堆损坏 0xc0000374 时，栈顶往往是最后一个读到坏内存的模块，真正写坏内存的早就不在栈上了\n页面读取失败 0xc0000006 时，栈顶只是个在等磁盘的模块\nHook 注入场景崩在跳转链上，看着是崩溃点，根因是注入方\nCPU 不稳定时受害模块会随机出现在栈顶，两个 dump 的栈顶可能完全不同"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n所以我们归因是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"异常码语义优先，栈只作为一维证据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n还要叠加内存破坏模式检测、透明模块过滤、连续帧可靠性和未知模块主导性检查，最后用置信度钳位把\"有嫌疑\"和\"坐实\"区分开\n而且有些根因根本不在栈里——OOM 要看日志里的内存时间序列，CPU 缺陷要看型号加行为证据。所以调用栈是重要证据，但绝不能单点定罪"}]},{"ID":"20260918231015-k4zaakn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918231015-k4zaakn","updated":"20260918234000"},"Children":[{"Type":"NodeText","Data":"为什么要做进程主动退出的识别"}]},{"ID":"20260918232232-wc3y970","Type":"NodeParagraph","Properties":{"id":"20260918232232-wc3y970","updated":"20260918232407"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"进程主动退出，我的做法是不看栈、只看异常码"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n因为有两个特定异常码的语义本身就已经是\"企微自己把进程结束了\"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"一个是系统标准的进程致命退出码，一个是企微 Crashpad 自定义的上报码"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n只有命中这两个才进这条分支"}]},{"ID":"20260918232232-av010kt","Type":"NodeParagraph","Properties":{"id":"20260918232232-av010kt","updated":"20260918233439"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"第一，这两个场景的栈顶完全不可信"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"：\n一个是退出触发点，一个是崩溃上报模块，真正的原因根本不在栈上；\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"主动退出的码，语义是\"进程自己走了终止流程\"\n既然是\"走终止流程\"终结的，那栈顶按定义一定落在终止流程上——要么是退出触发点，要么是上报模块"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n第二，它的性质不一样，它不是被注入、被第三方或者硬件搞崩的"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"\n而是企微自己检测到不可恢复的错误后主动结束进程"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"常见根因是数据文件损坏、磁盘故障、未捕获异常或者内存分配失败"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"第三，排查动作和话术完全不同，根据栈里是否有CRT致命函数判断是否是企微代码问题"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"}]},{"ID":"20260918234000-wdyv4w9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260918234000-wdyv4w9","updated":"20260921181410"},"Children":[{"Type":"NodeText","Data":"什么叫透明模块（系统模块）？看用户栈之前为什么要过滤掉"}]},{"ID":"20260918234112-pm4cghh","Type":"NodeParagraph","Properties":{"id":"20260918234112-pm4cghh","updated":"20260918234247"},"Children":[{"Type":"NodeText","Data":"透明模块主要是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":" Windows 系统 DLL 和 C/C++ 运行时库"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n——像 ntdll、kernel32、user32、ucrtbase 这些"}]},{"ID":"20260918234112-ffimgp4","Type":"NodeParagraph","Properties":{"id":"20260918234112-ffimgp4","updated":"20260921181356"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"理由："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"第一，不过滤的话栈顶永远被系统 DLL 占着"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"——一个进程的栈里系统 DLL 可能占一多半\n（"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"因为程序的能力和风险都在系统 API 这个边界上——它把活外包给系统 DLL，CPU 出错（或走终止流程）的那一下往往正好在系统代码里执行，而栈顶就是\"最后被调用的那个函数\"，所以栈顶大概率是系统 DLL"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"）\n而我们最重的证据就是\"栈顶用户帧是谁\"，不过滤等于永远看不到真正的业务帧\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"第二，系统 DLL 是所有程序共用的公共代码，它在崩溃里更像受害者，而不是肇事者"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n崩溃落在它上面只有两种身份——被调用者，或者最后一个读到坏数据的人，都不构成责任证据\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"第三，它们还会制造假象，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"最典型的是堆破坏场景"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n栈顶往往正好落在 ntdll 的堆管理函数上，而它其实是\"发现堆坏了\"的那个人，不过滤就会把归因带偏"}]},{"ID":"20260918234112-4pvtp97","Type":"NodeParagraph","Properties":{"id":"20260918234112-4pvtp97","updated":"20260918234726"},"Children":[{"Type":"NodeText","Data":"所以过滤的目的就是把\"栈顶\"这"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"个最有价值的位置让给业务帧和第三方帧"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n当然它有代价，可能过滤成空栈，所以我们后面专门配了空栈兜底；\n而且过滤只作用于\"栈归属\"这一维\n原始栈帧是完整保留的——这也正是主动退出那一步还能在 CRT 帧里找到终止函数的原因"}]},{"ID":"20260905225727-ys62dgl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260905225727-ys62dgl","updated":"20261003162447"},"Children":[{"Type":"NodeText","Data":"用于"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"crash分析的skills"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"怎么做的"}]},{"ID":"20260905231745-lh2t4iq","Type":"NodeParagraph","Properties":{"id":"20260905231745-lh2t4iq","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"给一个 Windows 崩溃附件包，自动化出一份归因报告。\n链路是\"解压 → 读元数据 → CDB 分析 → 日志印证 → 归因 → 出报告\"，核心思想是分层取证、逐级降级。"}]},{"ID":"20260905231745-ayqapbv","Type":"NodeParagraph","Properties":{"id":"20260905231745-ayqapbv","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"具体实现上分两个 Python 脚本。\n  "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"dump_helper.py，负责"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"文件操作"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\nprepare 子命令解压 zip 后按体积降序列出所有 dmp，体积最大的就是主进程 dump；\nupload 子命令用标准库流式 PUT 上传 dump 到 MCP 服务端\n专门规避 PowerShell 里 curl 是 Invoke-WebRequest 别名的坑。\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"crash_context.py，负责"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text strong","TextMarkTextContent":"上下文分析"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\nmeta — 读元数据 JSON，给你挑重点：CPU 型号、服务端符号化好的栈、崩溃时间、设备 ID。自动算进程运行时长，顺手处理了启动时间是 UTC 而崩溃时间是本地时间的时区差。"}]},{"ID":"20260905232031-gtzw9e0","Type":"NodeParagraph","Properties":{"id":"20260905232031-gtzw9e0","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"logs — 拿崩溃时间做锚点，把包里日志按时间窗口分成四类，只有刚好覆盖崩溃那一刻的能当证据。同时自动标出混进来的其他案例目录，防止分析错对象。"}]},{"ID":"20260905232031-r0lxrtf","Type":"NodeParagraph","Properties":{"id":"20260905232031-r0lxrtf","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"grep — 在能用的日志里做关键词搜索，自动跳过加密日志和无关目录，返回结构化结果方便跟 dump 对着看。"}]},{"ID":"20260905231745-m3mdx6d","Type":"NodeParagraph","Properties":{"id":"20260905231745-m3mdx6d","updated":"20261003162447"},"Children":[{"Type":"NodeText","Data":"最大的效率优化是\""},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"先读元数据再决定要不要走 CDB"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\"。\n元数据里已经有服务端符号化好的完整栈和精确 CPU 型号，够用就跳过后面的上传和符号加载，省掉几分钟。\n只有需要寄存器值、堆内存、其他线程栈时才走 CDB。CDB 部分用 MCP 服务器封装，提供创建会话、执行命令、关闭会话这套工具，首轮 !analyze -v 就能拿到 80% 的结论。"}]},{"ID":"20260906144001-onejdhe","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260906144001-onejdhe","updated":"20260923220049"},"Children":[{"Type":"NodeText","Data":"反馈工具插件化你打算怎么做"}]},{"ID":"20260906144035-qhcrkqa","Type":"NodeParagraph","Properties":{"id":"20260906144035-qhcrkqa","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"这个引擎是「配置驱动的知识库 + 硬编码的职责链」\n知识层其实已经插件化了——第三方厂商名册、透明模块、场景规则全在 config.json 里\n加个 DLP 厂商改 JSON 就行，还能远程下发"}]},{"ID":"20260906144035-1u24v5c","Type":"NodeParagraph","Properties":{"id":"20260906144035-1u24v5c","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"插件化我主要做三件事。\n第一是把每个阶段抽成一个统一的 "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"Stage 接口"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"一个 id、一个 order 决定优先级、一个门控、一个 run 返回空就表示没命中交给下一个"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\nanalyze() 就退化成一个 for 循环，谁先命中就返回\n最后统一走出口方法做证据聚合和话术拼装，这个出口现在已经有了，改造成本很低。"}]},{"ID":"20260906144218-qiyh3yu","Type":"NodeParagraph","Properties":{"id":"20260906144218-qiyh3yu","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"同时要把散落的参数收敛成一个上下文对象——现在 S3-A 要接七八个参数\nS1.7 还得专门返回一个结构体往回传 skipS3 这种副作用，很别扭\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"收敛之后新插件能读到全量上下文，也能往里挂自己的中间态，加规则再也不用改已有方法的签名"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260906144035-ejrec3t","Type":"NodeParagraph","Properties":{"id":"20260906144035-ejrec3t","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"第二是配置和开关。\n除了"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"编译期一个显式的注册表保证顺序"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，我会把 stages 声明式写进配置\n配合工厂做开关——比如某个客户误报多了，远程把那条规则关掉，不用发版\n阈值也一样外置，现在扫描帧数 20、连续帧数 3 这些魔法数字散在代码里，抽出来后可以按灵敏度调档"}]},{"ID":"20260906144329-y2fhkqd","Type":"NodeParagraph","Properties":{"id":"20260906144329-y2fhkqd","updated":"20260921171943"},"Children":[{"Type":"NodeText","Data":"不过我得说清楚：\nDart 没反射、没有动态类加载，所以这是「配置驱动的编译期插件」，不是 jar 那种二进制热插拔\n另外把 CPU 缺陷分析、内存 OOM 扫描这类独立分析器固化成「结论覆写」插件，它们不进主链，只在最后按分类策略决定要不要覆盖主结论——以后加个显卡缺陷分析器，主管道一行都不用改。"}]},{"ID":"20260923220049-yjif09h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260923220049-yjif09h","updated":"20260923221539"},"Children":[{"Type":"NodeText","Data":"不在规则内的crash怎么处理"}]},{"ID":"20260923220105-oe6gdsa","Type":"NodeParagraph","Properties":{"id":"20260923220105-oe6gdsa","updated":"20260923220218"},"Children":[{"Type":"NodeText","Data":"第一层是模块不在名册里：\n引擎不会直接放弃，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"会走未知模块兜底"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n —— 把用户帧里所有非透明、非企微、非已知第三方的模块捞出来，\n按出现频次排序，只要有未知模块就归成 third_party_hit（medium 置信度），\n话术给 Top3 高嫌疑模块加上它的 DLL 路径，提示疑似 Hook/注入。"}]},{"ID":"20260923220158-g0trzq7","Type":"NodeParagraph","Properties":{"id":"20260923220158-g0trzq7","updated":"20260923220159"},"Children":[{"Type":"NodeText","Data":"====================="}]},{"ID":"20260923220105-zhr72dy","Type":"NodeParagraph","Properties":{"id":"20260923220105-zhr72dy","updated":"20260923220227"},"Children":[{"Type":"NodeText","Data":"第二层是"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"连未知模块都没有"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"（数据不足、栈不可信），\n才落到 unable_to_analyze，\n标\"无法自动判定，建议人工复核\"，\n但异常码、栈帧、模块、路径这些证据链全保留。"}]},{"ID":"20260923220201-sail8nu","Type":"NodeParagraph","Properties":{"id":"20260923220201-sail8nu","updated":"20260923220202"},"Children":[{"Type":"NodeText","Data":"========================"}]},{"ID":"20260923220105-schkwn5","Type":"NodeParagraph","Properties":{"id":"20260923220105-schkwn5","updated":"20260923220155"},"Children":[{"Type":"NodeText","Data":"关键是这些\"未分析出结果\"会原样归档上报，\n统计看板上有专门的细分维度，客服的\"有帮助/无帮助\"也回流。\n我们靠它发现新模块和新异常码，\n再补进配置名册或加规则——比如企微 Crashpad 的 0xfff00f01 就是这么加进 S1.6 的。\n原则是宁漏勿错，不确定不下结论，但样本一定不丢。"}]},{"ID":"20260923221539-pnk120p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260923221539-pnk120p","updated":"20260923221604"},"Children":[{"Type":"NodeText","Data":"针对线上偶发、难以稳定复现的问题，你有什么排查策略？"}]},{"ID":"20260923221541-7l9fbg0","Type":"NodeParagraph","Properties":{"id":"20260923221541-7l9fbg0","updated":"20260923221604"},"Children":[{"Type":"NodeText","Data":"首先先收集现场日志、崩溃堆栈、用户环境和触发操作，固定问题上下文；\n然后做概率复现尝试，放大压力、加埋点，抓异常时的状态；\n接着缩小范围，通过二分法定位模块，排查时序、竞态、资源释放这类非确定性问题；\n最后复盘根因，补充监控和自动化用例，防止再次发生。"}]},{"ID":"20260901161141-3pf9q26","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260901161141-3pf9q26","updated":"20261002230230"},"Children":[{"Type":"NodeText","Data":"工具统计后台"}]},{"ID":"20260901161222-yv6mt56","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260901161222-yv6mt56","updated":"20261002230230"},"Children":[{"Type":"NodeText","Data":"统计后台的整体架构是什么？"}]},{"ID":"20260915100937-i4bofjq","Type":"NodeParagraph","Properties":{"id":"20260915100937-i4bofjq","updated":"20261002230230"},"Children":[{"Type":"NodeText","Data":"整个服务是一个单进程的 Starlette ASGI 应用，用 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"build_app 工厂函数组装"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n它同时挂三套入口：REST API 提供上报、反馈、备注、统计、列表、搜索这些 JSON 接口；\nMCP 工具提供 看板概览数据、分页列表+多条件筛选、单条记录完整详情、多字段关键词模糊搜索、月度分类拆解矩阵 给 AI 或开发人员用；\nWeb 看板是 dashboard.html 加 ECharts （图表库）做的可视化页面\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"所有这些入口最终都调用同一个 DataService，\n它负责 JSONL 读写、内存索引和统计计算"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n服务启动或手动刷新时，从磁盘的 JSONL 文件重建内存索引"}]},{"ID":"20260921182529-d9qintk","Type":"NodeParagraph","Properties":{"id":"20260921182529-d9qintk","updated":"20260921182530"},"Children":[{"Type":"NodeText","Data":"============================"}]},{"ID":"20260915101342-r0g3cd4","Type":"NodeParagraph","Properties":{"id":"20260915101342-r0g3cd4","updated":"20260915101509"},"Children":[{"Type":"NodeText","Data":"不写工厂：文件一被 import，app 就被造出来了，全局只有这一个，配置写死，想换数据目录、想做测试都改不了。\n写工厂 build_app(cfg)：你调一次，它才造一个。传不同配置就得到不同实例，彼此完全隔离。\n关键点是闭包：里面的接口函数（比如 stats_endpoint）会把函数里的 data_svc \"记住\"带走，所以不用全局变量，每个 app 自带一份独立的数据层。"}]},{"ID":"20260915101626-h0um5q9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260915101626-h0um5q9","updated":"20260921182751"},"Children":[{"Type":"NodeText","Data":"（上报统计后台）为什么用内存索引？"}]},{"ID":"20260915101626-hfds5m0","Type":"NodeParagraph","Properties":{"id":"20260915101626-hfds5m0","updated":"20260915101654"},"Children":[{"Type":"NodeText","Data":"因为 JSONL 是追加写、全量重写，不适合随机查询\n服务启动时把磁盘上的 JSONL 全部读进内存"}]},{"ID":"20260915101657-mx3en9r","Type":"NodeParagraph","Properties":{"id":"20260915101657-mx3en9r","updated":"20260915104002"},"Children":[{"Type":"NodeText","Data":"构建两个索引：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"_index 是 id 到记录的映射，用于按 ID 查询和更新；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"_user_records 是用户名到记录列表的映射，用于按用户组织"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"\n两张表存的都是地址"}]},{"ID":"20260915101652-mkshijr","Type":"NodeParagraph","Properties":{"id":"20260915101652-mkshijr","updated":"20260915101707"},"Children":[{"Type":"NodeText","Data":"查询和统计都在内存里做，速度快\n代价是内存占用和磁盘数据量成正比，但对内部工具来说完全够用，而且提供了 rebuild_index 手动刷新来同步磁盘变化"}]},{"ID":"20260915103305-gnx6mav","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260915103305-gnx6mav","updated":"20261002232048"},"Children":[{"Type":"NodeText","Data":"（上报统计后台）新的分析记录来了先写内存还是先写磁盘"}]},{"ID":"20260915115948-wfyonb6","Type":"NodeParagraph","Properties":{"id":"20260915115948-wfyonb6","updated":"20260915120208"},"Children":[{"Type":"NodeText","Data":"新记录进来是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"先落盘、再更新内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"的：\n先把这一行 append 到该用户的 JSONL 文件\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"写成功了再更新两个索引"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"_index 里加上一条「id → 这条记录」的映射\n_user_records 里往该用户的列表末尾追加同一个记录"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n这么排是因为崩溃后果不一样：\n如果先改内存，落盘前挂了，客户端以为上报成功，但重启后内存清空、文件里也没有，这条就永久丢了\n先落盘的话，就算改内存前崩了，重启时 build_index 会把文件里的记录重新读回来"}]},{"ID":"20260921182729-3bnmxh6","Type":"NodeParagraph","Properties":{"id":"20260921182729-3bnmxh6","updated":"20260921182730"},"Children":[{"Type":"NodeText","Data":"============="}]},{"ID":"20260915115948-cvlnjzz","Type":"NodeParagraph","Properties":{"id":"20260915115948-cvlnjzz","updated":"20260915120257"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);"},"TextMarkType":"text","TextMarkTextContent":"这里还有个细节：_index 和 _user_records 是必须同时更新的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff); background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"前者负责按 id 查得到，后者负责按用户能重写文件，少更新一个就会\"两张表对不上\""},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n而这两行更新之间没有 await，所以它们一定连着执行完，不会出现\"一张表有、另一张没有\"的中间态\n真正会让出控制权的只有前面那个落盘的 await"}]},{"ID":"20260921182732-57o77j3","Type":"NodeParagraph","Properties":{"id":"20260921182732-57o77j3","updated":"20260921182733"},"Children":[{"Type":"NodeText","Data":"==============="}]},{"ID":"20260915115948-racm7fb","Type":"NodeParagraph","Properties":{"id":"20260915115948-racm7fb","updated":"20260915120337"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"另外点赞、备注这类只改字段的接口顺序是反过来的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"先改内存再重写文件"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n因为它只改记录本体里的一个字段，两个索引都指向同一个对象，所以"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"索引结构不用动，自动就是新的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n它和新增路径的差异在于：\n新增时内存里本来没这条记录、必须先落盘，而"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"更新时得先定位到内存里的对象才能改"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"}]},{"ID":"20260921182734-fbc07s4","Type":"NodeParagraph","Properties":{"id":"20260921182734-fbc07s4","updated":"20260921182736"},"Children":[{"Type":"NodeText","Data":"================"}]},{"ID":"20260915115948-dq0jhgv","Type":"NodeParagraph","Properties":{"id":"20260915115948-dq0jhgv","updated":"20261002232048"},"Children":[{"Type":"NodeText","Data":"最后一个缺口：\n重写文件用的是 \"w\" 直接覆盖、非原子，写一半崩会把文件截断成半成品\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"要补的话就是先写临时文件，再 os.replace() 原子替换"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n保证磁盘上要么全新、要么原样，然后再更新内存——做到\"要么都成功、要么都没生效\""}]},{"ID":"20260915124658-8ditygu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260915124658-8ditygu","updated":"20261002234114"},"Children":[{"Type":"NodeText","Data":"统计后台怎么保证并发安全"}]},{"ID":"20260915130308-5mcu8bv","Type":"NodeParagraph","Properties":{"id":"20260915130308-5mcu8bv","updated":"20260915130321"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"\"用户内串行、用户间并行、全局操作独占\""},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"来设计"}]},{"ID":"20260915130308-zjwr221","Type":"NodeParagraph","Properties":{"id":"20260915130308-zjwr221","updated":"20260921192650"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"写路径是按用户名分锁的"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n因为记录按用户拆成一个个 JSONL 文件，而每次更新都是\"读整个用户的列表、改一条、再整体覆盖写回\"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"中间有文件 IO 的 await 会让出协程"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"——会被插入\n → 靠 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"asyncio.Lock "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"拿到互斥，让同一用户的多个请求排队串行。\n不同用户写不同文件，本来就没冲突"}]},{"ID":"20260915130308-3nld4t2","Type":"NodeParagraph","Properties":{"id":"20260915130308-3nld4t2","updated":"20260915131448"},"Children":[{"Type":"NodeText","Data":"（线程锁 acquire 会把整个 loop 卡住；asyncio.Lock 只挂起当前这个协程）"}]},{"ID":"20260921192702-ud0nas8","Type":"NodeParagraph","Properties":{"id":"20260921192702-ud0nas8","updated":"20260921192705"},"Children":[{"Type":"NodeText","Data":"=============="}]},{"ID":"20260915130308-dzz96xv","Type":"NodeParagraph","Properties":{"id":"20260915130308-dzz96xv","updated":"20260915131622"},"Children":[{"Type":"NodeText","Data":"有几个细节：\n一是 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"update 接口要先按 id 查到记录、才知道锁哪把，等锁期间索引可能被 rebuild 清空"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"所以锁内要再查一次，避免操作已经不存在的记录"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n二是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"读操作完全不加锁，纯内存 dict、同步代码不会被切走"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n三是内存里两张索引共享同一个 record 对象，原地改字段两边同时生效\n而且两步更新之间没有 await，不会有\"一张有一张没有\"的中间态。"}]},{"ID":"20260915130308-nwwmaic","Type":"NodeParagraph","Properties":{"id":"20260915130308-nwwmaic","updated":"20260915132033"},"Children":[{"Type":"NodeText","Data":"最后是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"全局锁"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，我做成了读写锁语义：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"写路径持读锁、rebuild_index 持写锁"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n所以\"清空 → 重建\"是真正的原子区间，重建期间不会有写入落进马上被丢弃的旧索引\nrebuild 也只重建数据索引、不碰用户锁表，等锁的协程和新请求拿到的始终是同一把锁，互斥不会失效"}]},{"ID":"20261002234114-91kt1r1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20261002234114-91kt1r1","updated":"20261002234734"},"Children":[{"Type":"NodeText","Data":"优化这个刷新接口，你有哪些思路"}]},{"ID":"20261002234256-71734pj","Type":"NodeParagraph","Properties":{"id":"20261002234256-71734pj","updated":"20261002234408"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第一，给每个文件记个'指纹'"},{"Type":"NodeText","Data":"\n—— 就是它的修改时间和大小。\n刷新时先只看指纹（读文件属性，几乎不花时间），\n没变就直接返回、一个字节都不读；\n只有哪个用户的文件变了，才只重读那一个文件，\n因为数据本来就是一人一个文件，天然支持局部更新。"}]},{"ID":"20261002234411-ijvbtga","Type":"NodeParagraph","Properties":{"id":"20261002234411-ijvbtga","updated":"20261002234730"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第二，别先清空"},{"Type":"NodeText","Data":"\n —— 先在旁边把新索引完整建好，\n最后一瞬间把引用换过去，这样查询的人永远看到的是完整数据，不会读到半截。"}]},{"ID":"20261002234734-jqq3q8j","Type":"NodeParagraph","Properties":{"id":"20261002234734-jqq3q8j","updated":"20261002234734"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第三，别把用户锁表一起清了"},{"Type":"NodeText","Data":"\n—— 清掉之后，正在排队的请求和新来的请求拿的不是同一把锁，锁就形同虚设了。\n\"清锁表会让老协程拿旧锁、新协程拿新锁，两把锁不认识对方，互斥直接失效 —— 所以重建时锁表不清\""}]},{"ID":"20260921193517-eykueas","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260921193517-eykueas","updated":"20261004151435"},"Children":[{"Type":"NodeText","Data":"crash工具分析结果上报怎么做的"}]},{"ID":"20260915122817-jh3pjjj","Type":"NodeParagraph","Properties":{"id":"20260915122817-jh3pjjj","updated":"20260921193802"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"做了个"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"上报队列"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n目的是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"把\"分析完成\"和\"保存到后台\"解耦"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n分析一结束立刻出结果，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"上报扔队列后台异步做"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，网络慢或后台挂了都不卡界面\n队列里只有三种任务："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color1);"},"TextMarkType":"text","TextMarkTextContent":"主记录、备注、评价"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color1);\"}"}]},{"ID":"20260921193806-uhqgxlb","Type":"NodeParagraph","Properties":{"id":"20260921193806-uhqgxlb","updated":"20260921193809"},"Children":[{"Type":"NodeText","Data":"============="}]},{"ID":"20260915122817-fz8st83","Type":"NodeParagraph","Properties":{"id":"20260915122817-fz8st83","updated":"20260921194306"},"Children":[{"Type":"NodeText","Data":"队列串行消费、单个消费循环，用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"_isProcessing 标志防重入（"},{"Type":"NodeText","Data":"有循环在跑 → 直接返回，不新起循环）\n串行是为了保证顺序："},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"后台要求主记录先存在"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，\n所以 "},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color1);"},"TextMarkType":"text","TextMarkTextContent":"record 必须先于 remark/feedback 发出去"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color1);\"}"},{"Type":"NodeText","Data":"\n同时做了去重，taskId 用\"记录 ID + 类型\"拼，\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重复入队先删旧的，所以用户连点几次\"有帮助/没帮助\"，只发最后一次"}]},{"ID":"20260921194319-5bk803x","Type":"NodeParagraph","Properties":{"id":"20260921194319-5bk803x","updated":"20260921194325"},"Children":[{"Type":"NodeText","Data":"============"}]},{"ID":"20260915122817-dxqepyo","Type":"NodeParagraph","Properties":{"id":"20260915122817-dxqepyo","updated":"20260921193517"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"挂起区 + 取舍"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":" 最有意思的是挂起区：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"主记录还没入库时，备注和评价先挂起不发"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n否则后台返回\"记录不存在\"就被静默丢了\n等主记录成功后自动补发，并重置重试计数\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"挂起区就是一个按 taskId 去重的 Map"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color4);"},"TextMarkType":"text","TextMarkTextContent":"主记录没入库时，备注/评价先存在这里不发\n主记录一成功，把这些任务重置重试次数、塞回队列补发\n发失败也回到这里，而不是被静默丢掉——\n代价是它同样只在内存里，进程退出就没了，所以还得靠状态条和关闭拦截来兜底"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color4);\"}"}]},{"ID":"20260921194409-n3pvbfm","Type":"NodeParagraph","Properties":{"id":"20260921194409-n3pvbfm","updated":"20260921194412"},"Children":[{"Type":"NodeText","Data":"============"}]},{"ID":"20260915124003-bl4hj91","Type":"NodeParagraph","Properties":{"id":"20260915124003-bl4hj91","updated":"20260921193517"},"Children":[{"Type":"NodeText","Data":"（客户端主动发 POST /api/report，后台在这次 HTTP 响应里告诉它\"存成功了\"（2xx 且 body 里 ok != false）。客户端拿到这个返回值后，就在同一段代码里接着往下走，直接调 _flushPendingUpdates 把挂起的备注/评价塞回队列）"}]},{"ID":"20260915123342-3w8rig3","Type":"NodeParagraph","Properties":{"id":"20260915123342-3w8rig3","updated":"20260921193517"},"Children":[{"Type":"NodeText","Data":"重试是 1 次首发 + 3 次重试，退避 2 秒、5 秒、15 秒，可重试的放回队首\n判定上，网络错误和 5xx 可重试，400/404 和 body 里 ok: false 不可重试\n这里有个坑：后台可能 HTTP 200 但 body 是 ok: false，所以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"必须读响应体、不能只看状态码"},{"Type":"NodeText","Data":"。敢重试的前提是后台按 record id 覆盖、是幂等的，重复提交不会产生重复记录。"}]},{"ID":"20261004151435-9plwy1w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20261004151435-9plwy1w","updated":"20261004152416"},"Children":[{"Type":"NodeText","Data":"统计后台从JSONL迁移到MySQL应该怎么迁"}]},{"ID":"20261004151458-18tmj95","Type":"NodeParagraph","Properties":{"id":"20261004151458-18tmj95","updated":"20261004151548"},"Children":[{"Type":"NodeText","Data":"第一步先定 schema——\n把 JSONL 的字段落成表结构：\nrecord_id 做唯一键，\nuserName等这些统计高频维度建索引；\n旧记录缺字段的按现有读取层的口径做默认值映射\n——比如没有 feedback 就算 no_feedback，而不是算成 helpful，保证迁移前后统计口径不变；"}]},{"ID":"20261004151458-x49r7my","Type":"NodeParagraph","Properties":{"id":"20261004151458-x49r7my","updated":"20261004151614"},"Children":[{"Type":"NodeText","Data":"第二步离线导入脚本——\n扫全部按用户分片的 JSONL，逐行解析校验后批量插入，\n不边读边无脑 insert：坏行记录文件名行号跳过并汇报，\n导入完做对账——总记录数、分类分布、月度趋势、反馈有效率四个口径\n和 JSONL 全量算一遍比对，不一致不进入下一步；"}]},{"ID":"20261004151458-abz27pr","Type":"NodeParagraph","Properties":{"id":"20261004151458-abz27pr","updated":"20261004151628"},"Children":[{"Type":"NodeText","Data":"第三步双写灰度——\n写入接口同时落 JSONL 和 MySQL，\nMySQL 失败只记日志不挡上报，\n跑一段时间观察两边差异；"}]},{"ID":"20261004151458-iwsp0e6","Type":"NodeParagraph","Properties":{"id":"20261004151458-iwsp0e6","updated":"20261004152416"},"Children":[{"Type":"NodeText","Data":"第四步切读——\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"查询改为读 MySQL，再用双读比对跑一段"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"：\n接口返回的统计数字和 JSONL 路径算的完全一致才下线旧读路径，\nJSONL 全量保留只读备份，出任何口径差异都能回溯原始记录。\n回退方案就是把读开关拨回去，双写期间数据不丢。"}]},{"ID":"20260901161147-0z429jy","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260901161147-0z429jy","updated":"20260921193045"},"Children":[{"Type":"NodeText","Data":"企微项目"}]},{"ID":"20260901160542-ulmeluz","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260901160542-ulmeluz","updated":"20260921193045"},"Children":[{"Type":"NodeText","Data":"壳日志7天自动清理"}]},{"ID":"20260905232407-lv0t0ih","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260905232407-lv0t0ih","updated":"20260921193045"},"Children":[{"Type":"NodeText","Data":"启动时检测线程销毁时机与方式"}]},{"ID":"20260905233242-hfdefb9","Type":"NodeParagraph","Properties":{"id":"20260905233242-hfdefb9","updated":"20260921193042"},"Children":[{"Type":"NodeText","Data":"线程销毁时机：程序关闭时调用ShutdownLog()，\n此时通过g_trim_thread.join()阻塞等待清理线程完成\n确保所有资源正确释放后才继续关闭流程。"}]},{"ID":"20260921193043-f5u49xi","Type":"NodeParagraph","Properties":{"id":"20260921193043-f5u49xi","updated":"20260921193045"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260905233412-t16g682","Type":"NodeParagraph","Properties":{"id":"20260905233412-t16g682","updated":"20260905233412"},"Children":[{"Type":"NodeText","Data":"join()：阻塞等待线程完成，保证所有资源（文件句柄、内存）正确释放\ndetach()：线程后台运行，程序退出时可能被强制终止，导致：\n文件删除操作中断，清理不完整\n文件句柄未关闭，资源泄漏\n可能引发未定义行为"}]},{"ID":"20260905233443-y1vytmr","Type":"NodeParagraph","Properties":{"id":"20260905233443-y1vytmr","updated":"20260905233445"},"Children":[{"Type":"NodeText","Data":"join()是唯一能保证线程完全执行并安全回收资源的方式，符合壳APP启动清理的可靠性要求。"}]},{"ID":"20260915090023-fedtg5z","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260915090023-fedtg5z","updated":"20261004122807"},"Children":[{"Type":"NodeText","Data":"写日志是怎么做的"}]},{"ID":"20260915090031-q9vlmmr","Type":"NodeParagraph","Properties":{"id":"20260915090031-q9vlmmr","updated":"20260915090106"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"业务侧只写 WCRS_LOG_INFO()"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n宏展开成 RAII 的 LogEntry："},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"构造判级别"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"\u0026lt;\u0026lt; 攒流"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"析构统一 flush"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);"},"TextMarkType":"text","TextMarkTextContent":"底层用 spdlog async_logger 加 dist_sink"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-style-20260913200246-2dyiham-background-color, #554b00); color: var(--b3-inline-style-20260913200246-2dyiham-color, #ffffff);\"}"},{"Type":"NodeText","Data":"，同时落盘和输出 DebugView，业务线程不阻塞"}]},{"ID":"20260921193102-itw8gke","Type":"NodeParagraph","Properties":{"id":"20260921193102-itw8gke","updated":"20260921193104"},"Children":[{"Type":"NodeText","Data":"======="}]},{"ID":"20260915090642-k1r7u1s","Type":"NodeParagraph","Properties":{"id":"20260915090642-k1r7u1s","updated":"20260915090940"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"日志分了六个级别"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"},{"Type":"NodeText","Data":"，作用有三：\n级别不够的日志连字符串都不拼、直接丢掉，省开销\nWarn 以上立刻刷盘、以下攒着；运行期还能动态改级别"}]},{"ID":"20260915090940-6iyrn0b","Type":"NodeParagraph","Properties":{"id":"20260915090940-6iyrn0b","updated":"20260915091032"},"Children":[{"Type":"NodeText","Data":"刷盘方面不是每条都刷——业务线程只把日志扔进队列就返回，后台线程慢慢写\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"真正落盘只在三个时机：Warn 以上每条都刷、缓冲满自动刷、程序退出刷一次"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260921193140-18eperf","Type":"NodeParagraph","Properties":{"id":"20260921193140-18eperf","updated":"20260921193142"},"Children":[{"Type":"NodeText","Data":"=========="}]},{"ID":"20260915090106-arir1nf","Type":"NodeParagraph","Properties":{"id":"20260915090106-arir1nf","updated":"20260921193411"},"Children":[{"Type":"NodeText","Data":"可靠性上做了三级降级，日志系统失败不影响主流程\n（三级降级是为了保证日志系统坏了不影响业务：能写文件就写文件，写不了就退到只输出调试窗口、\n不碰文件系统，连兜底再出错就静默吞掉，绝不往外抛）"}]},{"ID":"20260915091043-lwiarwy","Type":"NodeParagraph","Properties":{"id":"20260915091043-lwiarwy","updated":"20260921193428"},"Children":[{"Type":"NodeText","Data":"7 天清理是两层：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));"},"TextMarkType":"text","TextMarkTextContent":"spdlog 的 max_files 管运行期数量，启动扫盘按文件名日期管过期文件，专门覆盖\"用户长期不启动\"的场景"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-info-background-color, var(--b3-card-info-background)); color: var(--b3-inline-builtin-info-color, var(--b3-card-info-color));\"}"}]},{"ID":"20260915091810-qc75fla","Type":"NodeParagraph","Properties":{"id":"20260915091810-qc75fla","updated":"20260915091810"}},{"ID":"20260915091814-58cngi7","Type":"NodeParagraph","Properties":{"id":"20260915091814-58cngi7","updated":"20260915091822"},"Children":[{"Type":"NodeText","Data":"LogEntry 是宏展开出来的临时对象，而 C++ 标准规定：\n临时对象在它所处的完整表达式（full-expression）求值结束时销毁 —— 最常见的边界就是分号。所以析构点就是 ;"}]},{"ID":"20260915091456-hsbrqsu","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260915091456-hsbrqsu","updated":"20260915091538"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"anNvbg=="},{"Type":"NodeCodeBlockCode","Data":"WCRS_LOG_INFO() \u003c\u003c \"open file \" \u003c\u003c path \u003c\u003c \" failed, code=\" \u003c\u003c code;\n\n相当于：\nLogEntry tmp(LogLevel::Info, __FILE__, __LINE__);   // ① 构造：判级别\ntmp.operator\u003c\u003c(\"open file \");                        // ② 往流里追加\ntmp.operator\u003c\u003c(path);                                // ②\ntmp.operator\u003c\u003c(\" failed, code=\");                    // ②\ntmp.operator\u003c\u003c(code);                                // ②\n// 语句结束，tmp 析构 → ③ 此时此刻才真正提交这一条日志\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20261004122807-p49dixv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20261004122807-p49dixv","updated":"20261004122943"},"Children":[{"Type":"NodeText","Data":"回调里又打日志，导致无限递归栈溢出，怎么解决"}]},{"ID":"20261004122809-f2ji906","Type":"NodeParagraph","Properties":{"id":"20261004122809-f2ji906","updated":"20261004122943"},"Children":[{"Type":"NodeText","Data":"日志析构里同步通知回调，回调里又打日志，绕成一个环，栈直接溢出。\n我的解法是加重入保护：\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"用 thread_local bool 记录'当前线程正在推送事件'"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"},{"Type":"NodeText","Data":"，\n进入回调前置位，回调路径里再触发日志时看到标志就直接跳过推送，\n只落盘不进回调，把环剪断。\n用 thread_local 而不是全局变量，是因为重入只发生在当前线程，\n线程局部标志既不会误伤其他线程正常打日志，也天然不用加锁。\n标志复位用 RAII 守卫做，无论正常返回还是异常退出都能复位，不会卡死；\n同时析构里整个推送逻辑用 catch (...) 包住，保证异常不外逃。\n这样既断了递归环，又保证任何退出路径下标志状态都是对的。"}]},{"ID":"20260905232355-ickwwsm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260905232355-ickwwsm","updated":"20260921194749"},"Children":[{"Type":"NodeText","Data":"蓝盾包版本自动检测下载"}]},{"ID":"20260916122535-mi1jf39","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916122535-mi1jf39","updated":"20260921194749"},"Children":[{"Type":"NodeText","Data":"蓝盾包版本检测安装的流程是怎么样的"}]},{"ID":"20260916122534-yo8hhmt","Type":"NodeParagraph","Properties":{"id":"20260916122534-yo8hhmt","updated":"20260916122639"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"一、任务启动与初始化"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n用户登录后，系统注册定时任务。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"任务首次执行延迟2秒，之后每24小时执行一次"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，确保及时检测新版本。"}]},{"ID":"20260921194733-4kv0b8j","Type":"NodeParagraph","Properties":{"id":"20260921194733-4kv0b8j","updated":"20260921194734"},"Children":[{"Type":"NodeText","Data":"======="}]},{"ID":"20260916122534-yqlx8yo","Type":"NodeParagraph","Properties":{"id":"20260916122534-yqlx8yo","updated":"20260916122554"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"二、版本检测流程"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"}]},{"ID":"20260916122534-m6tssm2","Type":"NodeParagraph","Properties":{"id":"20260916122534-m6tssm2","updated":"20260916122713"},"Children":[{"Type":"NodeText","Data":"闸门校验：任务开始时进行三项检查\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"是否为蓝盾包（非正式包）、Debug开关是否开启（默认关闭）、当前流水线ID是否有效"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n任一条件不满足则跳过本轮检测\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"CGI请求"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"：向服务端发送"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"CGI 3502请求"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，查询当前流水线最新成功构建的版本号。\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"版本比对"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"将服务器返回版本与本地运行版本进行比对"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，仅当前者更高时才继续。"}]},{"ID":"20260921194736-b38nl3e","Type":"NodeParagraph","Properties":{"id":"20260921194736-b38nl3e","updated":"20260921194738"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260916122601-4430k5c","Type":"NodeParagraph","Properties":{"id":"20260916122601-4430k5c","updated":"20260916122731"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"三、静默下载与存储"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n发现新版本后，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"系统使用固定URL模板拼接下载地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"（避免使用错误的详情页地址），后台静默下载安装包\n下载的文件存储为独立类别（PiplineUpdateSilent.tmp），"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"与手动下载的包物理隔离"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，互不影响"}]},{"ID":"20260921194740-alqnbmh","Type":"NodeParagraph","Properties":{"id":"20260921194740-alqnbmh","updated":"20260921194741"},"Children":[{"Type":"NodeText","Data":"========"}]},{"ID":"20260916122534-c23h3p1","Type":"NodeParagraph","Properties":{"id":"20260916122534-c23h3p1","updated":"20260916122756"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"四、节流与弹窗提醒"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n下载完成后，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"系统进行24小时节流判定（基于服务器时间防篡改）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n若满足条件，则通过"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"通知中心发送消息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，UI层监听后复用现有的升级弹窗，直接显示“下载完成”状态，提示用户安装。"}]},{"ID":"20260921194743-xm3aqdg","Type":"NodeParagraph","Properties":{"id":"20260921194743-xm3aqdg","updated":"20260921194744"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260916122534-yz5oi2h","Type":"NodeParagraph","Properties":{"id":"20260916122534-yz5oi2h","updated":"20260916122809"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"五、安装与清理"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n用户点击“立即安装”后，系统校验安装包存在性，然后调用安装程序\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"若用户关闭弹窗，已下载的包会保留，直到下一轮检测时清理过期包"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"。\n整个过程通过#if RDM_BUILD宏隔离，确保现网正式包不受影响。"}]},{"ID":"20260921194747-kg5fg92","Type":"NodeParagraph","Properties":{"id":"20260921194747-kg5fg92","updated":"20260921194749"},"Children":[{"Type":"NodeText","Data":"========="}]},{"ID":"20260916122534-vph1trc","Type":"NodeParagraph","Properties":{"id":"20260916122534-vph1trc","updated":"20260916122814"},"Children":[{"Type":"NodeText","Data":"这个流程设计兼顾了自动化与低打扰：\n后台自动检测和下载，仅在必要时弹窗提醒，且受24小时节流控制，避免频繁打扰用户"}]},{"ID":"20260916140856-g40sxkr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916140856-g40sxkr","updated":"20260921195406"},"Children":[{"Type":"NodeText","Data":"（蓝盾包版本检测）定时任务怎么注册的"}]},{"ID":"20260916140856-hxzndrl","Type":"NodeParagraph","Properties":{"id":"20260916140856-hxzndrl","updated":"20260916144614"},"Children":[{"Type":"NodeText","Data":"登录完成后，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"在 startup_management.cpp 中通过 work.AddConcurrentTask() 注册周期任务"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"},{"Type":"NodeText","Data":"\n用 #if RDM_BUILD 宏包裹确保只在蓝盾包编译\n构造时传 24h 编译期常量，首检延迟 2 秒（SetFirstIntervalTimeInSeconds(2)），后续每 24h 触发一次 DoOnInterval()"}]},{"ID":"20260916144608-qzcqxrc","Type":"NodeParagraph","Properties":{"id":"20260916144608-qzcqxrc","updated":"20260916144608"},"Children":[{"Type":"NodeText","Data":"AddConcurrentTask 本身其实什么都不干，它只是登记一个\"工厂函数\"，不会立刻执行"}]},{"ID":"20260916144530-mp6p372","Type":"NodeParagraph","Properties":{"id":"20260916144530-mp6p372","updated":"20260916144625"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"真正到点触发的时候，框架才把这些工厂函数挨个调用，生成具体任务"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"然后统一丢给一个并发执行器"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n执行器干的事很朴素：\n把所有子任务一次性全部发出去，谁都不等谁，这就是并发的来源——它不是自己开线程\n而是把任务一次性交给底层的统一分发器去跑"}]},{"ID":"20260916144530-bwqssga","Type":"NodeParagraph","Properties":{"id":"20260916144530-bwqssga","updated":"20260916144915"},"Children":[{"Type":"NodeText","Data":"接着做计数管理：\n每个子任务跑完就回调回来，把自己从待完成列表里删掉，列表清空就代表这一整组结束了\n而且"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"这个回调被特意投回任务自己的执行线程"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，所以管理这批任务时天然是单线程的，不用加锁"}]},{"ID":"20260916140856-21k1yjf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916140856-21k1yjf","updated":"20260916143033"},"Children":[{"Type":"NodeText","Data":"CGI 请求在哪个线程发送接收的"}]},{"ID":"20260916140856-ibcdrsr","Type":"NodeParagraph","Properties":{"id":"20260916140856-ibcdrsr","updated":"20260916143033"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"CGI 在 UI 线程发送"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n框架要求发起线程必须是 UI 线程\n周期任务运行在执行线程，所以先 GetUIThread()-\u003ePostTask 切到 UI 线程发请求\n回调里再 GetExecuteThread()-\u003ePostTask 切回执行线程处理结果，避免跨线程操作 timer 和成员状态"}]},{"ID":"20260916140856-5vgigix","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916140856-5vgigix","updated":"20260921201222"},"Children":[{"Type":"NodeText","Data":"（蓝盾包版本检测）节流判定怎么做的"}]},{"ID":"20260916140856-0eqj2f5","Type":"NodeParagraph","Properties":{"id":"20260916140856-0eqj2f5","updated":"20260921200705"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"弹窗前读取持久化的 last_notify_time（GlobalConfig 存储），判断 now - last_notify_time \u0026lt; 24h"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n未过期则跳过弹窗但保留已下载包。\n时间戳在 PostEvent 请求弹窗后立即写入（不是等 UI 展示完），\n因为通知是异步投递（PostMessage），唯一不一致窗口是投递后进程崩溃，\n误差方向安全——少弹一次而非重复骚扰。\n续期时还会向节流门槛对齐，避免（检测任务和弹窗任务时间对不上）\n检测周期与节流起点不同导致间隔近 48h。"}]},{"ID":"20260916145746-40v5saz","Type":"NodeParagraph","Properties":{"id":"20260916145746-40v5saz","updated":"20260921200713"},"Children":[{"Type":"NodeText","Data":"==========\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color11);"},"TextMarkType":"text","TextMarkTextContent":"不是\"固定每 24 小时跑一次\"，而是\"每轮跑完重新算下一次什么时候跑\"，算的时候把节流也考虑进去"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color11);\"}"}]},{"ID":"20260916145941-6eruvol","Type":"NodeParagraph","Properties":{"id":"20260916145941-6eruvol","updated":"20260921201222"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color3);"},"TextMarkType":"text","TextMarkTextContent":"先默认下一轮 24 小时后\n下一轮检测时间：再算一个 remain = 节流还剩多久到期（上次提醒时间 + 24h − 现在）\n如果节流还没到期、而且比 24 小时更早到期，那就别等一整天，把下一轮提前到节流到期那一刻"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color3);\"}"}]},{"ID":"20260916140856-u6vb3uf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916140856-u6vb3uf","updated":"20260916145222"},"Children":[{"Type":"NodeText","Data":"安装的单例弹窗做了什么处理"}]},{"ID":"20260916140856-o60x82w","Type":"NodeParagraph","Properties":{"id":"20260916140856-o60x82w","updated":"20260916145222"},"Children":[{"Type":"NodeText","Data":"弹窗前检测 suggest_instance 单例是否被占用（手动检查更新或上一轮静默提醒留下的旧窗口）\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"被占用就用同步的 ::DestroyWindow() 销毁旧窗口再重建"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"color: var(--b3-font-color2);"},"TextMarkType":"text","TextMarkTextContent":"不能用 Close()（异步 PostMessage(WM_CLOSE)）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"color: var(--b3-font-color2);\"}"},{"Type":"NodeText","Data":"，否则本函数返回前旧窗口还在\n会走\"只置顶\"分支导致本轮提醒弹不出来，且时间戳已写入，提醒直接丢失\n销毁限定 package_ready，蓝盾包手动链路不受影响"}]},{"ID":"20260916140856-iospbp3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260916140856-iospbp3","updated":"20260916140856"},"Children":[{"Type":"NodeText","Data":"完成这个需求有什么亮点"}]},{"ID":"20260916140856-7mtcxrj","Type":"NodeParagraph","Properties":{"id":"20260916140856-7mtcxrj","updated":"20260916140856"},"Children":[{"Type":"NodeText","Data":"双闸门隔离：编译期 RDM_BUILD 宏 + 运行期 Debug 开关，零外溢到现网\n物理隔离：静默包用独立文件类别 PiplineUpdateSilent.tmp，与手动跨线包互不可见，避免互删装错版本\n节流对齐：检测周期向节流门槛对齐 + 最小间隔保护，精确控制 24h 弹窗间隔\n线程安全范式：照抄框架既有范式（GetUIThread/GetExecuteThread 切换），避免跨线程竞态\n单例窗口销毁重建：解决\"只置顶旧窗口\"导致提醒丢失的隐蔽 bug\n异步通知解耦：logic 层只 PostEvent，UI 层 Register 后自取句柄弹窗，保持层级清晰"}]},{"ID":"20260916122931-yehevu6","Type":"NodeParagraph","Properties":{"id":"20260916122931-yehevu6","updated":"20260916122943"}},{"ID":"20260901150101-s7dnj81","Type":"NodeParagraph","Properties":{"id":"20260901150101-s7dnj81","updated":"20260901150101"}},{"ID":"20260901150101-kq2zhar","Type":"NodeParagraph","Properties":{"id":"20260901150101-kq2zhar","updated":"20260901150101"}},{"ID":"20260901150101-63imoey","Type":"NodeParagraph","Properties":{"id":"20260901150101-63imoey","updated":"20260901150101"}},{"ID":"20260901150101-llp71g0","Type":"NodeParagraph","Properties":{"id":"20260901150101-llp71g0","updated":"20260901150101"}},{"ID":"20260901150101-b8s42fh","Type":"NodeParagraph","Properties":{"id":"20260901150101-b8s42fh","updated":"20260901150101"}},{"ID":"20260901150101-rhqgoz3","Type":"NodeParagraph","Properties":{"id":"20260901150101-rhqgoz3","updated":"20260901150101"}},{"ID":"20260901150102-4w88cod","Type":"NodeParagraph","Properties":{"id":"20260901150102-4w88cod","updated":"20260901150102"}},{"ID":"20260901150102-iagektg","Type":"NodeParagraph","Properties":{"id":"20260901150102-iagektg","updated":"20260901150102"}},{"ID":"20260901150102-zfzaqqz","Type":"NodeParagraph","Properties":{"id":"20260901150102-zfzaqqz","updated":"20260901150102"}},{"ID":"20260901150102-n2x1o9l","Type":"NodeParagraph","Properties":{"id":"20260901150102-n2x1o9l","updated":"20260901150102"}},{"ID":"20260901150102-nil0kai","Type":"NodeParagraph","Properties":{"id":"20260901150102-nil0kai","updated":"20260901150102"}},{"ID":"20260901150102-65b631i","Type":"NodeParagraph","Properties":{"id":"20260901150102-65b631i","updated":"20260901150102"}},{"ID":"20260901150102-lxnirrw","Type":"NodeParagraph","Properties":{"id":"20260901150102-lxnirrw","updated":"20260901150102"}},{"ID":"20260901150102-n9zo89d","Type":"NodeParagraph","Properties":{"id":"20260901150102-n9zo89d","updated":"20260901150102"}},{"ID":"20260901150102-putzyj8","Type":"NodeParagraph","Properties":{"id":"20260901150102-putzyj8","updated":"20260901150102"}},{"ID":"20260901150102-h1rimmu","Type":"NodeParagraph","Properties":{"id":"20260901150102-h1rimmu","updated":"20260901150102"}},{"ID":"20260901150102-4xwnuty","Type":"NodeParagraph","Properties":{"id":"20260901150102-4xwnuty","updated":"20260901150102"}},{"ID":"20260901150102-aqoweoc","Type":"NodeParagraph","Properties":{"id":"20260901150102-aqoweoc","updated":"20260901150102"}},{"ID":"20260901150102-zvqmtjq","Type":"NodeParagraph","Properties":{"id":"20260901150102-zvqmtjq","updated":"20260901150102"}},{"ID":"20260901150102-6xdb7lw","Type":"NodeParagraph","Properties":{"id":"20260901150102-6xdb7lw","updated":"20260901150102"}},{"ID":"20260901150102-dzqgrus","Type":"NodeParagraph","Properties":{"id":"20260901150102-dzqgrus","updated":"20260901150102"}},{"ID":"20260901150102-vl8jet4","Type":"NodeParagraph","Properties":{"id":"20260901150102-vl8jet4","updated":"20260901150102"}},{"ID":"20260901150102-3mqppb5","Type":"NodeParagraph","Properties":{"id":"20260901150102-3mqppb5","updated":"20260901150102"}},{"ID":"20260901150102-l1xdb43","Type":"NodeParagraph","Properties":{"id":"20260901150102-l1xdb43","updated":"20260901150102"}},{"ID":"20260901150102-b7f3bzn","Type":"NodeParagraph","Properties":{"id":"20260901150102-b7f3bzn","updated":"20260901150102"}},{"ID":"20260901150102-hclsz0v","Type":"NodeParagraph","Properties":{"id":"20260901150102-hclsz0v","updated":"20260901150102"}},{"ID":"20260901150102-xg6d5i3","Type":"NodeParagraph","Properties":{"id":"20260901150102-xg6d5i3","updated":"20260901150102"}},{"ID":"20260901150102-8v168eo","Type":"NodeParagraph","Properties":{"id":"20260901150102-8v168eo","updated":"20260901150102"}},{"ID":"20260901150102-sos0sq2","Type":"NodeParagraph","Properties":{"id":"20260901150102-sos0sq2","updated":"20260901150102"}},{"ID":"20260901150102-4l9qybb","Type":"NodeParagraph","Properties":{"id":"2026090115010