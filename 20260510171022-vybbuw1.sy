t","Data":"两阶段审查：规范符合性审查 + 代码质量审查，确保交付质量"}]},{"ID":"20260510171022-o436xcx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-o436xcx","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"测试驱动开发 (TDD)"}]},{"ID":"20260510171022-61xr8y4","Type":"NodeParagraph","Properties":{"id":"20260510171022-61xr8y4","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"RED → GREEN → REFACTOR 强制循环"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RED :编写失败测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GREEN :编写最少代码让测试通过"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"REFACTOR :重构优化代码消除重复"}]},{"ID":"20260510171022-2xjs4ca","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-2xjs4ca","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"协作开发模式"}]},{"ID":"20260510171022-bttqceo","Type":"NodeParagraph","Properties":{"id":"20260510171022-bttqceo","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Git Worktrees"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"创建隔离的工作区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并行开发多个功能分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"验证干净的测试基线"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代码审查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"requesting-code-review"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"receiving-code-review"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按严重性报告问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"关键问题阻止进度"}]},{"ID":"20260510171022-aakkc4s","Type":"NodeParagraph","Properties":{"id":"20260510171022-aakkc4s","updated":"20260510171022"},"Chil