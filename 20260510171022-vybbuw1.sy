},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260412203101106.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260510171022-16xbax3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-16xbax3","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"多角色项目开发"}]},{"ID":"20260510171022-u37uxth","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-u37uxth","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单Agent对比多Agent"}]},{"ID":"20260510171022-omvsu7z","Type":"NodeParagraph","Properties":{"id":"20260510171022-omvsu7z","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"单 Agent 模式是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单个智能体独立完成全部工作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它结构简单、部署方便，内部通信成本极低、响应速度快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时 Token 消耗稳定可控，非常适合处理逻辑简单、流程单一的轻量化任务"}]},{"ID":"20260510171022-asonvc2","Type":"NodeParagraph","Properties":{"id":"20260510171022-asonvc2","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"但单 Agent 存在天然的能力短板："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同一个智能体需要身兼策划、执行、审核等多个角色"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很容易出现角色混乱、思路混淆的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时它无法做到深度专业细分，受限于模型本身能力和上下文窗口大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很难拆解、处理复杂长链路任务，也没办法同时并行推进多个工作"}]},{"ID":"20260510171022-do4i7bk","Type":"NodeParagraph","Properties":{"id":"20260510171022-do4i7bk","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"多 Agent 模式则是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多个专业智能体协同组队工作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个 Agent 只深耕一个细分领域、负责单一环节，实现了精细化专业分工"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它支持多任务并行处理，专职角色的输出质量更稳定可靠"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体架构可以灵活扩展，按需增减团队里的智能体数量"}]},{"ID":"20260510171022-9gg8fhu","Type":"NodeParagraph","Properties":{"id":"20260510171022-9gg8fhu","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"相比单 Agent，多 Agent 体系有全方位的优势："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复杂任务处理时长从 1-2 天压缩到 12-30 分钟，效率大幅提升"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子 Agent 可使用轻量模型，整体成本能降低 80%"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时内置 Review 交叉审查环节，能提前发现规避风险"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终实现全流程端到端自动化"}]},{"ID":"20260510171022-99crpjc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-99crpjc","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"互联网项目开发阶段与角色"}]},{"ID":"20260510171022-yc4l2k5","Type":"NodeParagraph","Properties":{"id":"20260510171022-yc4l2k5","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"需求分析 | 产品经理 PM"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"市场调研与用户画像"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编写 PRD 需求文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定义功能优先级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输出用户故事"}]},{"ID":"20260510171022-1nwmh8y","Type":"NodeParagraph","Properties":{"id":"20260510171022-1nwmh8y","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统设计 | 技术架构师"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"技术选型与方案评估"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统架构图设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库模型设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"API 接口规划"}]},{"ID":"20260510171022-e6k9g6t","Type":"NodeParagraph","Properties":{"id":"20260510171022-e6k9g6t","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"前端开发 | 前端工程师 FE"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UI 组件开发实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"交互逻辑与状态管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"页面路由与性能优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"响应式适配"}]},{"ID":"20260510171022-hjcmyuv","Type":"NodeParagraph","Properties":{"id":"20260510171022-hjcmyuv","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"后端开发 | 后端工程师 BE"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RESTful API 开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"业务逻辑实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据存储与缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全防护机制"}]},{"ID":"20260510171022-3voorun","Type":"NodeParagraph","Properties":{"id":"20260510171022-3voorun","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"测试验证 | 测试工程师 QA"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单元 / 集成测试编写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"边界条件与异常测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"性能与安全测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺陷追踪与回归"}]},{"ID":"20260510171022-acbxb0c","Type":"NodeParagraph","Properties":{"id":"20260510171022-acbxb0c","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"部署运维 | 运维工程师 OPS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CI/CD 流水线搭建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"容器化部署 (K8s)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"监控告警体系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"故障排查与优化"}]},{"ID":"20260510171022-7pslv9g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-7pslv9g","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"智能体角色映射 — AI Agent 扮演开发团队"}]},{"ID":"20260510171022-q9ng88i","Type":"NodeParagraph","Properties":{"id":"20260510171022-q9ng88i","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"核心理念：通过独立的 System Prompt 为每个 Agent 注入领域专业知识"}]},{"ID":"20260510171022-j2b90j1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-j2b90j1","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"OpenClaw 多智能体团队开发演示案例"}]},{"ID":"20260510171022-5xlojiu","Type":"NodeParagraph","Properties":{"id":"20260510171022-5xlojiu","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"目标是做一个带邮箱密码 + GitHub 第三方登录的用户登录模块"}]},{"ID":"20260510171022-ggyou6b","Type":"NodeParagraph","Properties":{"id":"20260510171022-ggyou6b","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"整个流程用 5 个专职 AI Agent，完全模拟真人开发团队流水线工作："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先由调度 Agent 接收需求、拆分任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再由需求分析师做 PRD 文档、设计 API 接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着开发者 Agent 写代码实现功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后代码审查 Agent 做安全和规范检查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后测试工程师 Agent 自动跑用例、验证功能"}]},{"ID":"20260510171022-n6bofuw","Type":"NodeParagraph","Properties":{"id":"20260510171022-n6bofuw","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"最终成果：自动产出 3 个 API 接口、5 个文件共 150 行代码，审查出 2 个问题，12 个测试用例通过率 92%，全程只花 12 分钟、成本仅 0.22 美元，全程 AI 自动协作完成"}]},{"ID":"20260510171022-uyevedw","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-uyevedw","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"OpenClaw架构深度分析"}]},{"ID":"20260510171022-9ffz9n9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-9ffz9n9","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"整体架构：三层调度中心"}]},{"ID":"20260510171022-cbc0mqf","Type":"NodeParagraph","Properties":{"id":"20260510171022-cbc0mqf","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"OpenClaw 是一套本地优先的 AI Agent 执行引擎"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而非简易聊天机器人，整体采用接口层→网关层→执行层的三层调度架构"}]},{"ID":"20260510171022-rva03r4","Type":"NodeParagraph","Properties":{"id":"20260510171022-rva03r4","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"接口层负责多聊天渠道接入适配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网关层通过 WebSocket 做实时消息路由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行层是 Agent 核心，负责 LLM 推理、工具执行与会话记忆管理"}]},{"ID":"20260510171022-qqm1pm7","Type":"NodeParagraph","Properties":{"id":"20260510171022-qqm1pm7","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"架构实现消息调度与 AI 执行解耦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用 WebSocket 事件驱动实时通信，同时数据全本地存储，保障用户隐私安全"}]},{"ID":"20260510171022-d0mqscn","Type":"NodeParagraph","Properties":{"id":"20260510171022-d0mqscn","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"类似于："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"OpenClaw = 本地优先 AI 引擎 + 极高系统权限 + 多 Agent 协同调度 + 全链路本地长记忆"},{"Type":"NodeImage","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image-20260418194954118"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260418194954118.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20260510171022-04sftjy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-04sftjy","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"接口层"}]},{"ID":"20260510171022-9i8jz4e","Type":"NodeParagraph","Properties":{"id":"20260510171022-9i8jz4e","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"接口层就是渠道适配器，每个聊天平台单独做一个适配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把各个平台五花八门的消息，统一转成系统内部能用的标准格式"}]},{"ID":"20260510171022-5ylny0u","Type":"NodeParagraph","Properties":{"id":"20260510171022-5ylny0u","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它自带身份验证，对接各平台专属登录授权"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能统一解析文本、图片、文件等各类消息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有白名单、限流等安全访问控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后再把回复转成对应平台格式、自动拆分长消息、处理媒体上传"}]},{"ID":"20260510171022-whyxi30","Type":"NodeParagraph","Properties":{"id":"20260510171022-whyxi30","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"目前全覆盖 WhatsApp、Telegram、飞书、Slack、微信、钉钉、Discord"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和自建 Web 等主流聊天渠道"}]},{"ID":"20260510171022-8ymk1xn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-8ymk1xn","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网关层"}]},{"ID":"20260510171022-qfwazkf","Type":"NodeParagraph","Properties":{"id":"20260510171022-qfwazkf","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"网关层是整个系统的消息中枢，负责承接接口层的标准化消息，再转发给执行层 Agent"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现消息调度和 AI 执行完全解耦"}]},{"ID":"20260510171022-ccy98z9","Type":"NodeParagraph","Properties":{"id":"20260510171022-ccy98z9","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它负责维护各个聊天平台的长连接，提供 WebSocket 实时接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会对入站消息做格式校验，再按类型分发事件，把消息精准路由到对应的 Agent 执行"}]},{"ID":"20260510171022-rp7h1xd","Type":"NodeParagraph","Properties":{"id":"20260510171022-rp7h1xd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"网关基于新版 Node.js 开发，默认本地本机访问，远程需要安全隧道"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用单机单网关、事件驱动非轮询架构，自带消息强校验和本地信任机制，安全又高效"}]},{"ID":"20260510171022-aw6u8gj","Type":"NodeParagraph","Properties":{"id":"20260510171022-aw6u8gj","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Node.js 就是让 JavaScript 代码可以脱离浏览器，直接在电脑 / 服务器上运行的工具"}]},{"ID":"20260510171022-mxzkyb6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-mxzkyb6","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"执行层"}]},{"ID":"20260510171022-8hm4r5u","Type":"NodeParagraph","Properties":{"id":"20260510171022-8hm4r5u","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"执行层是整个 Agent 的核心大脑运行引擎，收到网关转发的消息后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按固定四步流程完成完整 AI 智能处理"}]},{"ID":"20260510171022-nbi81uv","Type":"NodeParagraph","Properties":{"id":"20260510171022-nbi81uv","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"第一步先区分私聊 / 群聊会话，自动隔离不同会话权限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二步加载历史记忆、配置信息，组装完整上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三步执行大模型流式推理，在沙箱里安全调用工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四步把对话、工具日志全部本地持久化保存，实现上下文长期继承"}]},{"ID":"20260510171022-s20snz4","Type":"NodeParagraph","Properties":{"id":"20260510171022-s20snz4","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它通过 4 个配置文件完整定义 Agent 能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分别管理 Agent 人格、行为规则、可用工具、长期记忆索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"高度可自定义"}]},{"ID":"20260510171022-r3ee0n2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-r3ee0n2","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"MCP协议与AI工具互联"}]},{"ID":"20260510171022-g4fslo0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-g4fslo0","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 完整定义"}]},{"ID":"20260510171022-xg4ifwf","Type":"NodeParagraph","Properties":{"id":"20260510171022-xg4ifwf","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 全称 Model Context Protocol（模型上下文协议）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是一种面向AI 大模型 / Agent 系统与外部能力互联的标准化通用协议"}]},{"ID":"20260510171022-wg55t20","Type":"NodeParagraph","Properties":{"id":"20260510171022-wg55t20","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它不训练模型、不替代原有业务系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心目标是为 AI 提供一套统一、可发现、可调用、可控制的标准化方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全连接外部真实世界资源"}]},{"ID":"20260510171022-bizh5k8","Type":"NodeParagraph","Properties":{"id":"20260510171022-bizh5k8","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"大模型原生只擅长文本理解与生成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"天生不具备访问本地文件、数据库、操作系统终端、浏览器、企业内部业务系统的真实执行能力"}]},{"ID":"20260510171022-rn3vl9e","Type":"NodeParagraph","Properties":{"id":"20260510171022-rn3vl9e","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 的核心价值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就是把所有外部工具、资源、执行能力，以统一协议的形式标准化暴露给 AI"}]},{"ID":"20260510171022-7iqccfd","Type":"NodeParagraph","Properties":{"id":"20260510171022-7iqccfd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"因此 MCP 不只是一个通信协议，本质是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与外部工具之间的标准连接规范"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与各类上下文资源之间的统一访问入口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与可执行动作之间的协议化能力抽象层"}]},{"ID":"20260510171022-89qf8ah","Type":"NodeParagraph","Properties":{"id":"20260510171022-89qf8ah","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 实现工具互联、上下文互通、企业系统安全接入的核心基础设施"}]},{"ID":"20260510171022-x4b39ps","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-x4b39ps","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"传统 AI 工具接入存在的痛点"}]},{"ID":"20260510171022-3von4gy","Type":"NodeParagraph","Properties":{"id":"20260510171022-3von4gy","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接入协议碎片化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库一套接入方式、浏览器一套方式、企业内部平台又是另一套独立方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有统一标准，重复开发、维护成本极高"}]},{"ID":"20260510171022-fp6kyc5","Type":"NodeParagraph","Properties":{"id":"20260510171022-fp6kyc5","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"工具信息不统一不规范"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"部分工具只有代码接口、部分只有文档、部分缺少输入输出参数约束，模型 / Agent 无法清晰理解自身可用能力、调用规则"}]},{"ID":"20260510171022-8kysdsv","Type":"NodeParagraph","Properties":{"id":"20260510171022-8kysdsv","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"能力发现困难"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 无法感知当前环境有哪些可用能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不清楚能力入参出参要求、不明确自身权限边界，无法自主合理调用工具"}]},{"ID":"20260510171022-rp4she9","Type":"NodeParagraph","Properties":{"id":"20260510171022-rp4she9","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"安全控制分散混乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件访问、命令执行、数据库查询、内部服务调用各自独立管控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无法形成统一的权限治理、操作审批、行为审计机制，安全风险极高"}]},{"ID":"20260510171022-vv2t5su","Type":"NodeParagraph","Properties":{"id":"20260510171022-vv2t5su","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Agent 工程化难以扩展落地"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本地 Demo 可以简单运行，但企业级落地时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会面临接入混乱、调用不可控、能力复用性差、难以维护扩展的问题"}]},{"ID":"20260510171022-t8c15g7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-t8c15g7","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 统一解决的五大核心规范"}]},{"ID":"20260510171022-iiz8tuq","Type":"NodeParagraph","Properties":{"id":"20260510171022-iiz8tuq","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 针对以上痛点，把全流程抽象成一套统一标准化模式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"标准化暴露"},{"Type":"NodeText","Data":"：统一规范外部工具 / 资源的接入格式、描述定义，不再各自定制协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自动化发现"},{"Type":"NodeText","Data":"：AI 可自动枚举、感知全部可用能力与能力详情，无需人工配置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"规范化调用"},{"Type":"NodeText","Data":"：统一调用请求格式、交互流程，模型按标准发起执行请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结果如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结构化返回"},{"Type":"NodeText","Data":"：统一响应、错误、流式数据格式，AI 可稳定解析执行结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"权限如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"统一约束管控"},{"Type":"NodeText","Data":"：统一全链路权限校验、操作审批、行为审计、安全隔离机制"}]},{"ID":"20260510171022-5zl85w1","Type":"NodeParagraph","Properties":{"id":"20260510171022-5zl85w1","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这意味着:MCP不是把所有系统“变成同一种业务”，而是把它们对AI的接入方式变成同一种协议语言"}]},{"ID":"20260510171022-tw6n243","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-tw6n243","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么对 Agent 和 AI 编程重要"}]},{"ID":"20260510171022-h3o6mdd","Type":"NodeParagraph","Properties":{"id":"20260510171022-h3o6mdd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 的关键不是 “会聊天”，而是能完成任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而完成任务通常意味着 AI 需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读取真实上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"访问真实环境"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行真实动作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"获取真实反馈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于反馈继续决策"}]},{"ID":"20260510171022-z1750s5","Type":"NodeParagraph","Properties":{"id":"20260510171022-z1750s5","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"例如一个 AI 编程 Agent 修复 Bug 时，往往需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读取报错文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"搜索项目代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查询依赖版本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行测试命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修改代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再次运行验证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这已经不是单纯的 Prompt 能完成的事情"}]},{"ID":"20260510171022-1lqknr4","Type":"NodeParagraph","Properties":{"id":"20260510171022-1lqknr4","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它需要 AI 与文件系统、终端、测试框架、文档资源等形成受控互联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MCP 正是支撑这种互联的协议基础之一"}]},{"ID":"20260510171022-wubqtlu","Type":"NodeParagraph","Properties":{"id":"20260510171022-wubqtlu","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"在 MCP / AI 工具互联系统中的体现"}]},{"ID":"20260510171022-6tlokrm","Type":"NodeParagraph","Properties":{"id":"20260510171022-6tlokrm","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"在实际系统中，MCP 往往体现为以下结构："}]},{"ID":"20260510171022-zrzf67b","Type":"NodeParagraph","Properties":{"id":"20260510171022-zrzf67b","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP Client"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通常由 IDE、AI 助手、Agent Runtime 承担"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"负责连接 Server、发现能力、发起调用"}]},{"ID":"20260510171022-4kynnz8","Type":"NodeParagraph","Properties":{"id":"20260510171022-4kynnz8","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对外暴露能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"封装底层文件系统、数据库、浏览器、企业服务等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool / Resource / Prompt"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool 负责动作执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Resource 负责上下文读取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 负责复用任务模板"}]},{"ID":"20260510171022-bsbuev8","Type":"NodeParagraph","Properties":{"id":"20260510171022-bsbuev8","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 核心是完成真实任务而非聊天"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要 AI 读写上下文、访问环境、执行动作、根据反馈决策"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这类复杂编程任务无法仅靠 Prompt 实现，必须和文件、终端、代码系统真实互联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 MCP 采用 Client-Server 架构，Client 由 Agent/IDE 承担调用能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Server 封装暴露底层外部资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拆分 Tool 执行、Resource 读上下文、Prompt 复用模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 AI Agent 工具互联的标准协议底座"}]},{"ID":"20260510171022-yv42x1h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-yv42x1h","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"企业中的典型使用场景"}]},{"ID":"20260510171022-p9j6ux6","Type":"NodeParagraph","Properties":{"id":"20260510171022-p9j6ux6","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"企业内部最典型的 MCP 使用场景包括："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 编程助手读取项目代码并运行测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 运维助手查询日志平台与监控平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 助手读取内部知识库文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 自动创建或更新工单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 查询发布平台状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 在受控环境下执行终端命令"}]},{"ID":"20260510171022-e2b45uc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-e2b45uc","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 核心价值"}]},{"ID":"20260510171022-cemeim3","Type":"NodeParagraph","Properties":{"id":"20260510171022-cemeim3","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"统一工具接入标准、降低开发对接成本、AI 能力自主发现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"集中安全权限治理、支持 Agent 企业级工程扩展，同时与底层大模型完全解耦"}]},{"ID":"20260510171022-9xgj9lg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-9xgj9lg","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常见误区 / 边界 / 风险"}]},{"ID":"20260510171022-s5shdo6","Type":"NodeParagraph","Properties":{"id":"20260510171022-s5shdo6","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 1：MCP 就是大模型本身"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。MCP 是连接模型与外部能力的协议层"}]},{"ID":"20260510171022-0oibqkc","Type":"NodeParagraph","Properties":{"id":"20260510171022-0oibqkc","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 2：MCP 就是某个具体 SDK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。SDK 可以实现 MCP，但 MCP 本身是协议思想与交互规范"}]},{"ID":"20260510171022-3hy0a3a","Type":"NodeParagraph","Properties":{"id":"20260510171022-3hy0a3a","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 3：有了 MCP，模型就自动能安全执行一切操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。MCP 需要配合权限控制、审批、白名单、审计等工程机制"}]},{"ID":"20260510171022-oulh5ud","Type":"NodeParagraph","Properties":{"id":"20260510171022-oulh5ud","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 4：MCP 等于所有工具调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不完全等于。工具调用是行为，MCP 是使这种行为标准化、可发现、可治理的协议化方式"}]},{"ID":"20260510171022-lre93wi","Type":"NodeParagraph","Properties":{"id":"20260510171022-lre93wi","updated":"20260510171022"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260419201257484"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260419201257484.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260510171022-7nj1s9i","Type":"NodeParagraph","Properties":{"id":"20260510171022-7nj1s9i","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"用户提出任务后，AI 并不是直接操作文件系统或数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 通常通过 MCP Client 与 MCP Server 交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MCP Server 再把底层能力以 Tool / Resource / Prompt 的方式暴露出来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这使得 AI 对外部能力的访问变得统一、可控、可扩展"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"帮助读者从整体架构层面理解 MCP 的位置，明确它连接的是 AI 与外部真实能力"}]},{"ID":"20260510171022-quuc6e4","Type":"NodeParagraph","Properties":{"id":"20260510171022-quuc6e4","updated":"20260510171022"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260419200948217"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260419200948217.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260510171022-t6o0znh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-t6o0znh","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"RAG 基础"}]},{"ID":"20260510171022-sn35u1c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-sn35u1c","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 RAG"}]},{"ID":"20260510171022-sr8qfk6","Type":"NodeParagraph","Properties":{"id":"20260510171022-sr8qfk6","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"定义 / 概念说明"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RAG（Retrieval-Augmented Generation，检索增强生成）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是单纯“先查资料再回答”的口语化流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是一种把外部知识系统接入大模型推理链路的工程方法"}]},{"ID":"20260510171022-bkjz2v6","Type":"NodeParagraph","Properties":{"id":"20260510171022-bkjz2v6","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它的核心思想是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户提出问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统从外部知识源中检索相关内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将检索结果组织成高质量上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把上下文连同用户问题一起送给大模型生成答案"}]},{"ID":"20260510171022-guj7a10","Type":"NodeParagraph","Properties":{"id":"20260510171022-guj7a10","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"因此，RAG 的本质可以概括为："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外部知识检索 + 上下文增强 + 大模型生成"}]},{"ID":"20260510171022-9i48asf","Type":"NodeParagraph","Properties":{"id":"20260510171022-9i48asf","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这意味着，模型回答问题时不再只依赖参数里“记住”的知识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是可以在推理时动态读取知识库中的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最新信息、企业内部资料、代码仓库文档、API 文档、日志、历史方案等内容"}]},{"ID":"20260510171022-nycvaap","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-nycvaap","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么重要"}]},{"ID":"20260510171022-qrqw1fv","Type":"NodeParagraph","Properties":{"id":"20260510171022-qrqw1fv","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"RAG 重要，不是因为“LLM 不够强”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是因为大模型天然存在以下边界："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"知识边界：模型参数中不可能内化所有企业私有知识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时效边界：模型训练完成后，知识会逐渐过时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"事实可靠性边界：模型可能基于概率生成“看似合理但不真实”的内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"追溯边界：很多企业场景要求回答必须能指向原始依据"}]},{"ID":"20260510171022-orp8w9y","Type":"NodeParagraph","Properties":{"id":"20260510171022-orp8w9y","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"RAG 的价值就在于："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不试图让模型“记住一切”，而是让模型具备按需取证、基于证据作答的能力"}]},{"ID":"20260510171022-y939l11","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-y939l11","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"核心技术原理"}]},{"ID":"20260510171022-dj7vvkv","Type":"NodeParagraph","Properties":{"id":"20260510171022-dj7vvkv","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"RAG 通常包含两条链路："}]},{"ID":"20260510171022-vq8sifc","Type":"NodeParagraph","Properties":{"id":"20260510171022-vq8sifc","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"离线链路：知识准备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据采集"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文档清洗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文本切分（Chunking）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Embedding 向量化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"建立向量索引 / 混合索引"}]},{"ID":"20260510171022-ajcrzg5","Type":"NodeParagraph","Properties":{"id":"20260510171022-ajcrzg5","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"在线链路：查询回答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户 Query 输入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Query 向量化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"候选文档召回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重排（Rerank）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上下文拼接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"LLM 最终生成"}]},{"ID":"20260510171022-ol28e03","Type":"NodeParagraph","Properties":{"id":"20260510171022-ol28e03","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"其底层关键点是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"知识不主要存在于模型参数中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"知识主要存在于外部可更新索引中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"生成质量强依赖检索质量与上下文质量"}]},{"ID":"20260510171022-rxvkcq5","Type":"NodeParagraph","Properties":{"id":"20260510171022-rxvkcq5","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这也是为什么很多 RAG 系统里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正决定上限的并不是“换更大的模型”而是："}]},{"ID":"20260510171022-rkgn0o8","Type":"NodeParagraph","Properties":{"id":"20260510171022-rkgn0o8","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"数据质量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Chunk 设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Embedding 模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检索策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重排能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 构造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上下文污染控制"}]},{"ID":"20260510171022-nue50b4","Type":"NodeTable","Data":"| 模块                  | 作用                           | 工程关键点                       |\n| --------------------- | ------------------------------ | -------------------------------- |\n| 数据源                | 提供知识内容                   | 文档来源广、更新频繁、权限复杂   |\n| 数据处理管道          | 清洗、去重、切分、提取元数据   | 决定索引质量                     |\n| Embedding 模型        | 将文本映射为语义向量           | 模型领域适配性影响很大           |\n| 向量数据库 / 检索引擎 | 存储向量和元数据，支持近邻检索 | 检索性能、过滤能力、可维护性     |\n| 检索器                | 根据 Query 召回候选内容        | Top-K、过滤条件、混合检索        |\n| 重排器                | 对召回结果做精排               | 提高最终上下文质量               |\n| Prompt 构造器         | 拼接上下文和系统指令           | 决定模型如何利用证据             |\n| 生成模型              | 输出最终答案                   | 不是唯一关键，受上下文质量强约束 |","TableAligns":[0,0,0],"Properties":{"id":"20260510171022-nue50b4","updated":"20260510171022"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模块"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"作用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"工程关键点"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据源"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"提供知识内容"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"文档来源广、更新频繁、权限复杂"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据处理管道"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"清洗、去重、切分、提取元数据"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"决定索引质量"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Embedding 模型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"将文本映射为语义向量"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模型领域适配性影响很大"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"向量数据库 / 检索引擎"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"存储向量和元数据，支持近邻检索"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"检索性能、过滤能力、可维护性"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"检索器"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"根据 Query 召回候选内容"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Top-K、过滤条件、混合检索"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"重排器"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对召回结果做精排"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"提高最终上下文质量"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Prompt 构造器"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"拼接上下文和系统指令"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"决定模型如何利用证据"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"生成模型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"输出最终答案"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不是唯一关键，受上下文质量强约束"}]}]}]},{"ID":"20260510171022-wxnim90","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-wxnim90","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常见误区 / 性能瓶颈 / 风险"}]},{"ID":"20260510171022-i9dviac","Type":"NodeParagraph","Properties":{"id":"20260510171022-i9dviac","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 1：所有问题都应该上 RAG"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。对于纯开放性创作问题，RAG 反而可能引入不必要延迟"}]},{"ID":"20260510171022-iq8v9ya","Type":"NodeParagraph","Properties":{"id":"20260510171022-iq8v9ya","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 2：RAG 一定比直接问模型更便宜"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不一定。RAG 会引入 Embedding、检索、重排等额外开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的价值在于正确率和可控性，不总是最低成本"}]},{"ID":"20260510171022-stap15i","Type":"NodeParagraph","Properties":{"id":"20260510171022-stap15i","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 3：只要使用 RAG，就不需要模型能力了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"错误。检索提供证据，但最终生成、归纳、整合、表达仍然依赖 LLM"}]},{"ID":"20260510171022-hm8r7xo","Type":"NodeParagraph","Properties":{"id":"20260510171022-hm8r7xo","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 4:RAG 可以彻底消除幻觉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"错误。RAG 能显著降低幻觉，但不能保证100%正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果检索错、拼接乱、Prompt 弱，模型依旧日可能误答"}]},{"ID":"20260510171022-fhuj9fh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-fhuj9fh","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"企业中的典型使用场景"}]},{"ID":"20260510171022-svrh0p9","Type":"NodeParagraph","Properties":{"id":"20260510171022-svrh0p9","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"企业知识问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码库问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"API 文档问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"错误日志检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"历史方案检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"合规 / 制度问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客服知识辅助"}]},{"ID":"20260510171022-5f03ozh","Type":"NodeParagraph","Properties":{"id":"20260510171022-5f03ozh","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这些场景的共同点是："}]},{"ID":"20260510171022-zd45rlg","Type":"NodeParagraph","Properties":{"id":"20260510171022-zd45rlg","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"知识不在公开互联网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"知识更新频繁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要引用和可审计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要按权限隔离"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"问题往往是语义表达，不一定精确命中文档标题"}]},{"ID":"20260510171022-1s3yen2","Type":"NodeParagraph","Properties":{"id":"20260510171022-1s3yen2","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"技术示例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"示例：企业制度问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户提问："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"公司试用期员工报销差旅费需要哪些材料？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果直接问基础大模型，可能会输出看起来合理但并非公司真实规则的内容，例如："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要发票"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要审批单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要行程证明"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这些内容“可能通用正确”，但不代表你公司的制度真实如此"}]},{"ID":"20260510171022-mm3lcrs","Type":"NodeParagraph","Properties":{"id":"20260510171022-mm3lcrs","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"如果使用 RAG，系统会："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检索“差旅报销制度”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检索“试用期员工费用管理规定”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拼接相关段落"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让模型基于这些段落回答并引用来源"}]},{"ID":"20260510171022-ltqmmtc","Type":"NodeParagraph","Properties":{"id":"20260510171022-ltqmmtc","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"于是回答会变成："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"试用期员工可报销差旅费用，但需补充直属主管审批截图"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"高铁票、酒店发票、出差申请单为必需材料"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"金额超过 3000 元需部门负责人二级审批"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"来源：《差旅费用管理制度 v3.2》 第 4.2 节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这就是“生成”与“基于证据生成”的差异"}]},{"ID":"20260510171022-a729809","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-a729809","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"LangChain"}]},{"ID":"20260510171022-qrnybxe","Type":"NodeParagraph","Properties":{"id":"20260510171022-qrnybxe","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"LangChain 是主流大模型应用开发框架"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内置文档处理、Embedding、向量检索、RAG 完整链路、Agent 智能决策、工具调用与 Prompt 管理等组件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能够快速搭建知识库问答、自动化 Agent 应用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时可对接 MCP 协议实现 AI 与外部系统、工具的标准化互联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 Agent 与 AI 编程应用最常用的工程框架"}]},{"ID":"20260510171022-21hd1iv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-21hd1iv","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"一个完全由 AI 编程的项目"}]},{"ID":"20260510171022-rcgkjjk","Type":"NodeParagraph","Properties":{"id":"20260510171022-rcgkjjk","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这是当前最容易被学生低估、也最容易被面试官误判的一类项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多学生担心：“如果我这个项目很多代码是 AI 帮我写的，是不是就不值钱了？” 实际上，AI 编程项目本身不是问题，问题在于你有没有体现出自己的作用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"企业并不怕你用 AI，企业怕的是你："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"●不会拆需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"●不会判断方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"●不会验证输出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"●不会修 AI 生成的错误代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"●不会把半成品收口成能交付的项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以，一个“完全由 AI 编程辅助完成的项目”，只要你能证明自己做了这些工作，反而可以成为亮点"}]},{"ID":"20260510171022-expyeto","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-expyeto","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"开发流程"}]},{"ID":"20260510171022-r2vtzpd","Type":"NodeParagraph","Properties":{"id":"20260510171022-r2vtzpd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"提示词：你的关于项目各种想法，包含 标题，页面都有哪些，哪些功能，一个规则约束"}]},{"ID":"20260510171022-dz1kgsb","Type":"NodeParagraph","Properties":{"id":"20260510171022-dz1kgsb","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"确认需求：可以采用 头脑风暴来完成 -\u003e 生成一个设计文档（数据库 以及 api 内容 以及 项目基本框架）"}]},{"ID":"20260510171022-1vjcxhd","Type":"NodeParagraph","Properties":{"id":"20260510171022-1vjcxhd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"写计划：/plan 或者调用 写计划的技能"}]},{"ID":"20260510171022-vy1fryt","Type":"NodeParagraph","Properties":{"id":"20260510171022-vy1fryt","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"进入到开发阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前后端并行开发 --\u003e 子智能体完成 --\u003e 好处是每个智能体有独立的上下文."}]},{"ID":"20260510171022-5p9f6lu","Type":"NodeParagraph","Properties":{"id":"20260510171022-5p9f6lu","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"可以通过调用技能完成项目验收—\u003e执行完成前确认技能，来看项目验收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果遇到问题—-\u003e调用debug技能进行调试—–\u003e添加代码审查 requesting-code-review"}]},{"ID":"20260510171022-194zpg3","Type":"NodeParagraph","Properties":{"id":"20260510171022-194zpg3","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"如果问题解决不了 再次试一下模型(考虑新建对话，避免上下文爆了)，如果再解决不了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就尝试使用更好的模型"}]},{"ID":"20260510171022-qy5ptat","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-qy5ptat","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"面试时 Vibe coding 一个项目 7 步流程"}]},{"ID":"20260510171022-n01utn2","Type":"NodeParagraph","Properties":{"id":"20260510171022-n01utn2","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"7步流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"问题定义-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确定方案-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"搭建核心骨架-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完成最小闭环-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"做异常边界检验和测试-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于问题定义和骨架验收-"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写最后的交付材料"}]},{"ID":"20260510171022-c5o2xnh","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260510171022-c5o2xnh","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"1. 问题定义（理解任务）"}]},{"ID":"20260510171022-0m36kpy","Type":"NodeParagraph","Properties":{"id":"20260510171022-0m36kpy","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"第一步不是写代码，先把问题说清楚："}]},{"ID":"20260510171022-0gbcf8j","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-0gbcf8j","updated":"20260510171022"},"Children":[{"ID":"20260510171022-zqhwk5p","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-zqhwk5p","updated":"20260510171022"},"Children":[{"ID":"20260510171022-1i5alga","Type":"NodeParagraph","Properties":{"id":"20260510171022-1i5alga","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"最终交付物是什么"}]}]},{"ID":"20260510171022-2z0ljmv","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-2z0ljmv","updated":"20260510171022"},"Children":[{"ID":"20260510171022-4cv1fp1","Type":"NodeParagraph","Properties":{"id":"20260510171022-4cv1fp1","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"必须做的需求"}]}]},{"ID":"20260510171022-ksr2fvd","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-ksr2fvd","updated":"20260510171022"},"Children":[{"ID":"20260510171022-99sas3a","Type":"NodeParagraph","Properties":{"id":"20260510171022-99sas3a","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"可选加分项"}]}]},{"ID":"20260510171022-fxay07y","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-fxay07y","updated":"20260510171022"},"Children":[{"ID":"20260510171022-5hhhs5i","Type":"NodeParagraph","Properties":{"id":"20260510171022-5hhhs5i","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"怎样算完成"}]}]},{"ID":"20260510171022-jqo0shz","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260510171022-jqo0shz","updated":"20260510171022"},"Children":[{"ID":"20260510171022-34gpgyf","Type":"NodeParagraph","Properties":{"id":"20260510171022-34gpgyf","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"最容易翻车的点"}]}]}]},{"ID":"20260510171022-9h69shm","Type":"NodeParagraph","Properties":{"id":"20260510171022-9h69shm","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"注意：关键要求写入 .md，不留在聊天，方便后续清理上下文。"}]},{"ID":"20260510171022-zv7610x","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260510171022-zv7610x","updated":"20260510171022"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"提示词：\n\n先不要写代码，也不要给实现方案。\n请先把这个任务整理成一份可执行的问题定义，写到 .md文档中 只输出：\n1.最终交付物\n2.硬约束\n3.隐含要求\n4.什么叫完成\n5.最容易翻车的风险点\n要求:\n尽量短\n不要偷偷做实现假设\n不确定的地方请明确标出来\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260510171022-yo64bja","Type":"NodeThematicBreak","Properties":{"id":"20260510171022-yo64bja","updated":"20260510171022"}},{"ID":"20260510171022-iqiijbr","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260510171022-iqiijbr","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"2. 确定方案"}]},{"ID":"20260510171022-f5rkprd","Type":"NodeParagraph","Properties":{"id":"20260510171022-f5rkprd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"先给出 2–3 条方案，再选最稳的一条。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免 AI 直接按单一思路实现导致偏差。"}]},{"ID":"20260510171022-6ym7wjb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260510171022-6ym7wjb","updated":"20260510171022"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"提示词：\n现在不要写代码。\n基于问题定义，给我 2–3 条可行方案。\n每条需包含：\n\n1. 大致怎么做\n2. 主要优点\n3. 主要风险\n4. 实现复杂度\n5. 可测试性\n   最后明确推荐一条，并说明不选其他的理由，优先稳定交付。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260510171022-md7tr58","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260510171022-md7tr58","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"3. 搭建核心骨架"}]},{"ID":"20260510171022-hi1r05e","Type":"NodeParagraph","Properties":{"id":"20260510171022-hi1r05e","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"先定架构，再编码。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需明确："}]},{"ID":"20260510171022-jhk50wh","Type":"NodeL