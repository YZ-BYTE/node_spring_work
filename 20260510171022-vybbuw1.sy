ype":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"公式 = 角色 + 工作 + 要求 如 \"你是一位资深全栈工程师...\""},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提升回答专业性和准确性"}]},{"ID":"20260510171022-oenewn4","Type":"NodeParagraph","Properties":{"id":"20260510171022-oenewn4","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思维链 CoT（Chain-of-Thought）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心作用：引导 AI 逐步推理分析"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"澄清需求，执行确认 如 \"执行下一步前，要跟我确认...\""},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复杂问题拆解必备"}]},{"ID":"20260510171022-wd7xnug","Type":"NodeParagraph","Properties":{"id":"20260510171022-wd7xnug","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"少样本学习（Few-Shot Learning）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心作用：提供示例让 AI 模仿格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输入示例 → 输出示例 → 新输入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输出格式控制最佳实践"}]},{"ID":"20260510171022-pxbfm5v","Type":"NodeParagraph","Properties":{"id":"20260510171022-pxbfm5v","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结构化指令（Structured Output）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心作用：明确定输出格式要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"\"以 JSON 格式返回...\""},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序化处理场景首选"}]},{"ID":"20260510171022-siqmitt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-siqmitt","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Context Engineering 上下文工程"}]},{"ID":"20260510171022-13gsb4t","Type":"NodeParagraph","Properties":{"id":"20260510171022-13gsb4t","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"​\t————————————-— 让 AI 理解你的项目如理解自己"}]},{"ID":"20260510171022-dsidons","Type":"NodeParagraph","Properties":{"id":"20260510171022-dsidons","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"任务卷宗模式（Task Dossier）"},{"Type":"NodeText","Data":"只给 AI 当前任务必需的 3-5 个关键文件和明确规范，避免全库扫描，精准投喂上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目标定义清晰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"仅提供 3-5 个关键文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用 spec.md 规范约束（规则文件）\t\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免全库扫描，精准投喂上下文"}]},{"ID":"20260510171022-w51v77x","Type":"NodeParagraph","Properties":{"id":"20260510171022-w51v77x","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长期记忆管理（CLAUDE.md/.cursorrules）"},{"Type":"NodeText","Data":"用 CLAUDE.md/.cursorrules 记录项目技术栈、架构决策，让 AI 跨会话保持一致理解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"维护项目技术栈约定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"记录架构决策和进度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定期更新避免过期"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 AI 跨会话保持一致理解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"局部规约定制（Directory Rules）"},{"Type":"NodeText","Data":"按项目目录定制专属规则，让 AI 针对不同模块（如 UI/API）执行差异化开发策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按目录定制专属规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UI 组件专注 A11y 和性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"API 目录专注错误处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同模块不同策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Prompt Caching（缓存优化策略）"},{"Type":"NodeText","Data":"把静态固定内容放 Prompt 前半段、动态内容放末尾，大幅降低长上下文场景的延迟和成本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态内容放前半段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态信息置末尾"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可降低延迟和成本 90%"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长上下文场景必用技巧"}]},{"ID":"20260510171022-v7zk1rg","Type":"NodeParagraph","Properties":{"id":"20260510171022-v7zk1rg","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这四种上下文工程实战方法，核心是通过精准投喂、长期记忆、分域定制、缓存优化的组合策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为 AI 构建高效、稳定、可控的开发上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以任务卷宗模式精准投喂当前任务必需的关键信息，避免全库扫描"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 CLAUDE.md/.cursorrules 维护项目长期规则，让 AI 跨会话保持一致理解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按目录定制差异化开发规范，适配不同模块的业务需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再通过 Prompt Caching 优化上下文结构，大幅降低长上下文场景的延迟与成本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终让 AI 更精准、高效、稳定地理解并完成项目开发任务"}]},{"ID":"20260510171022-4v5upek","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-4v5upek","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Context Engineering 常见陷阱"}]},{"ID":"20260510171022-dz8yn5m","Type":"NodeTable","Data":"| 错误类型     | 后果                           | 修复方案                             |\n| ------------ | ------------------------------ | ------------------------------------ |\n| 上下文污染   | AI 引用过时或无关的代码        | 定期清理对话历史，手动重置上下文窗口 |\n| 过度冗余     | Token 浪费严重，回复可能被截断 | 用摘要代替全文，仅提供关键函数签名   |\n| 中间丢失效应 | AI 忽略长文本中间的核心指令    | 将最重要的指令放在上下文末尾位置     |\n| 缓存失效     | 动态内容导致缓存反复重建       | 静态内容前置，时间戳等动态内容后置   |","TableAligns":[0,0,0],"Properties":{"id":"20260510171022-dz8yn5m","updated":"20260510171022"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"错误类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"后果"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"修复方案"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"上下文污染"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AI 引用过时或无关的代码"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"定期清理对话历史，手动重置上下文窗口"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"过度冗余"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Token 浪费严重，回复可能被截断"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用摘要代替全文，仅提供关键函数签名"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中间丢失效应"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AI 忽略长文本中间的核心指令"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"将最重要的指令放在上下文末尾位置"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"缓存失效"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"动态内容导致缓存反复重建"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"静态内容前置，时间戳等动态内容后置"}]}]}]},{"ID":"20260510171022-e7dk3gz","Type":"NodeParagraph","Properties":{"id":"20260510171022-e7dk3gz","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"trae有上下文压缩  点一下压缩按钮就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Trae的上下文压缩，就是给AI的记忆自动瘦身"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把长对话、大项目里的废话、过时细节都删掉，只留核心结论、关键逻辑和重要规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它能自动或手动触发，让AI在有限窗口里始终聚焦重点，不跑偏、不遗忘，还能省Token、提速"}]},{"ID":"20260510171022-333xtty","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-333xtty","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Skills与MCP协议"}]},{"ID":"20260510171022-z1x3mia","Type":"NodeParagraph","Properties":{"id":"20260510171022-z1x3mia","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"MCP Model Context Protocol"},{"Type":"NodeText","Data":"模型上下文协议\t\t角色：工作流程手册"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Anthropic 推出的开放标准协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定位：系统连接标准协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"形式：协议规范 + MCP Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"功能：提供统一工具调用接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复用性：跨 AI 平台通用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全：权限控制与审计日志集中管控"}]},{"ID":"20260510171022-5z1785r","Type":"NodeParagraph","Properties":{"id":"20260510171022-5z1785r","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Agent Skills"},{"Type":"NodeText","Data":"智能体技能\t\t\t\t\t\t\t\t\t\t\t例如：我现在开发完的这个网站项目，我要求你把这段开发流程生成一个技能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于 Markdown 的任务指南封装"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定位：任务逻辑指南"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"形式：Markdown 文档 + 提示词模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"功能：封装领域任务执行逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复用性：依赖具体 Agent 平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"价值：提升复杂任务的执行准确率"}]},{"ID":"20260510171022-k7wphb8","Type":"NodeParagraph","Properties":{"id":"20260510171022-k7wphb8","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"协作流程：互补而非竞争"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户提出需求\t\tSkills 层解析任务\t\t生成配置参数\t\tMCP 调用外部 API\t\t返回结果"}]},{"ID":"20260510171022-uzf2fip","Type":"NodeThematicBreak","Properties":{"id":"20260510171022-uzf2fip","updated":"20260510171022"}},{"ID":"20260510171022-ksdgcbn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-ksdgcbn","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Skill与Prompt模板的关系"}]},{"ID":"20260510171022-3e4ht4s","Type":"NodeParagraph","Properties":{"id":"20260510171022-3e4ht4s","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Prompt 模板与 Skill 的关系可以概括为一句话："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 模板是 Skill 的组成部分之一，但 Prompt 模板本身并不等于 Skill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 模板更偏向于任务表达层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Skill 更偏向于能力封装层"}]},{"ID":"20260510171022-1eh96i0","Type":"NodeParagraph","Properties":{"id":"20260510171022-1eh96i0","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么重要"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在很多团队里，最容易出现的误判就是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把一段写得很漂亮的 Prompt 直接称为 Skill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"认为把 Prompt 放进配置中心就完成了能力建设"}]},{"ID":"20260510171022-otz0iuj","Type":"NodeParagraph","Properties":{"id":"20260510171022-otz0iuj","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这是不够的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为真正的 Skill 往往还需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适用范围定义（指南）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输入参数约束"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输出格式约束"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"失败处理逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool 调用机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"评估和版本管理"}]},{"ID":"20260510171022-t51k3ez","Type":"NodeParagraph","Properties":{"id":"20260510171022-t51k3ez","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两者的关系可以这样理解："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 模板：告诉模型 “怎么说、怎么想、怎么组织回答”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Skill：定义系统 “如何稳定完成某类任务”"}]},{"ID":"20260510171022-807kz8w","Type":"NodeParagraph","Properties":{"id":"20260510171022-807kz8w","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Skill 的复用价值主要来自四个方面："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工程复用同一类任务不必重复构建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"例如 “会议纪要 Skill” 可以被多个业务系统共用，而不是每个系统自己重写一套 Prompt"}]},{"ID":"20260510171022-4sdk4px","Type":"NodeParagraph","Properties":{"id":"20260510171022-4sdk4px","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"团队协作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"团队可以围绕统一 Skill 协同优化，而不是每个人各写一版"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这会显著提升一致性和协作效率"}]},{"ID":"20260510171022-hr8nh53","Type":"NodeParagraph","Properties":{"id":"20260510171022-hr8nh53","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"维护性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当规则变更、模型升级、输出格式调整时，只需要更新 Skill，即可影响所有依赖方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这是一种典型的 “单点维护、全局受益”。"}]},{"ID":"20260510171022-pfcapws","Type":"NodeParagraph","Properties":{"id":"20260510171022-pfcapws","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"标准化输出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Skill 能定义统一输出格式，让下游系统更容易解析和消费"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这对 Agent 编排、Workflow 节点串联、监控评估非常关键"}]},{"ID":"20260510171022-57byhfs","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171022-57byhfs","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"Superpowers 是什么？"}]},{"ID":"20260510171022-2oxsckx","Type":"NodeParagraph","Properties":{"id":"20260510171022-2oxsckx","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"一个完整的 AI 软件开发工作流框架，为 Coding Agents 赋予工程化超能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计优先"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写代码前先理解要做什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"技能组合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"20 + 可组合 Skills系统化流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工程化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TDD + 代码审查质量有保障"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心理念"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"测试驱动开发：始终先写测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单性为首要目标：降低复杂性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统化优于临时性：流程优于猜测"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"证据优于断言：验证后再宣布成功"}]},{"ID":"20260510171022-vodfkga","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171022-vodfkga","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"核心工作流程"}]},{"ID":"20260510171022-1sbbaxc","Type":"NodeParagraph","Properties":