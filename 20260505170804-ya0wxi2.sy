r_tid;      // 管理线程ID\n} pool_t;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-7ivjklt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-7ivjklt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"四、扩容策略"}]},{"ID":"20260505170804-k9caw2g","Type":"NodeParagraph","Properties":{"id":"20260505170804-k9caw2g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"触发条件 （满足任一即可）："}]},{"ID":"20260505170804-fqiictr","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-fqiictr","updated":"20260505170804"},"Children":[{"ID":"20260505170804-bpm7u4l","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-bpm7u4l","updated":"20260505170804"},"Children":[{"ID":"20260505170804-z31fu58","Type":"NodeParagraph","Properties":{"id":"20260505170804-z31fu58","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"任务积压 ： 当前任务数 \u003e 存活空闲线程数 （ queue_cur \u003e alive - busy ）"}]}]},{"ID":"20260505170804-oolezc8","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-oolezc8","updated":"20260505170804"},"Children":[{"ID":"20260505170804-asmk1mi","Type":"NodeParagraph","Properties":{"id":"20260505170804-asmk1mi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"高负载 ： 忙碌线程占比 \u003e= 80% （ busy / alive * 100 \u003e= 80 ）"}]}]},{"ID":"20260505170804-cs7o9vv","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-cs7o9vv","updated":"20260505170804"},"Children":[{"ID":"20260505170804-co21nue","Type":"NodeParagraph","Properties":{"id":"20260505170804-co21nue","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"未达上限 ： 存活线程数 \u003c 最大线程数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"扩容机制 （见 Thread_pool.cpp#L155-L180 ）："}]}]}]},{"ID":"20260505170804-b4975lk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-b4975lk","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"if ((cur \u003e alive - busy || (float)busy / alive * 100 \u003e= (float)80) \u0026\u0026\n    p-\u003ethread_max \u003e alive) {\n    for (int j = 0; j \u003c p-\u003ethread_min; j++) {  // 每次扩容10个线程\n        for (int i = 0; i \u003c p-\u003ethread_max; i++) {\n            if (p-\u003etids[i] == 0 || !if_thread_alive(p-\u003etids[i])) {\n                pthread_create(\u0026p-\u003etids[i], NULL, Custom, (void*)p);\n                ++(p-\u003ethread_alive);\n                break;\n            }\n        }\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-tqx0dbn","Type":"NodeParagraph","Properties":{"id":"20260505170804-tqx0dbn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"扩容特点 ："}]},{"ID":"20260505170804-m8d4feo","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-m8d4feo","updated":"20260505170804"},"Children":[{"ID":"20260505170804-3u2zlew","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-3u2zlew","updated":"20260505170804"},"Children":[{"ID":"20260505170804-btf0ypz","Type":"NodeParagraph","Properties":{"id":"20260505170804-btf0ypz","upd