lor: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"程序加载运行时，再由操作系统通过 MMU 和页表，把这些虚拟地址映射到真实物理内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-wzkujnh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wzkujnh","updated":"20260907144319"},"Children":[{"Type":"NodeText","Data":"在 C++ 中创建一个类，在一开始类中有些什么\t"}]},{"ID":"20260505170804-2nk7wn9","Type":"NodeParagraph","Properties":{"id":"20260505170804-2nk7wn9","updated":"20260907144216"},"Children":[{"Type":"NodeText","Data":"默认有 private、public、protected 访问权限，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"默认是 private"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n编译器会自动生成四个默认成员函数：默认构造、析构函数、拷贝构造、赋值运算符重载\n除此之外没有成员变量和成员函数，需要自己手动添加"}]},{"ID":"20260505170804-h25oaof","Type":"NodeParagraph","Properties":{"id":"20260505170804-h25oaof","updated":"20260907144228"},"Children":[{"Type":"NodeText","Data":"构造函数：\nC++98 是 4 个\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"C++11 后是 6 个：默认构造、析构函数、拷贝构造、赋值运算符重载，移动构造函数和移动赋值运算符"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-m749lzn","Type":"NodeParagraph","Properties":{"id":"20260505170804-m749lzn","updated":"20260907144319"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"C++ 中空类大小为 1 字节，用于保证对象有唯一内存地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n类对象所占内存"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只与非静态成员变量相关"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，会按内存对齐规则计算大小，成员函数\n静态成员变量不占用对象内存，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"若含虚函数则会额外给对象增加一个虚表指针大小"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-9ejpo99","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9ejpo99","updated":"20260907144344"},"Children":[{"Type":"NodeText","Data":"全局变量定义在头文件中有什么问题？\t\t"}]},{"ID":"20260505170804-cx8bg9o","Type":"NodeParagraph","Properties":{"id":"20260505170804-cx8bg9o","updated":"20260907144344"},"Children":[{"Type":"NodeText","Data":"如果在头文件中定义全局变量，当该头文件被多个文件 include 时\n该头文件中的全局变量就会被定义多次，导致"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"重复定义"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，因此不能再头文件中定义全局变量"}]},{"ID":"20260505170804-154q6tu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-154q6tu","updated":"20260907144351"},"Children":[{"Type":"NodeText","Data":"include \"\" 和 \u003c\u003e 的区别是什么？\t"}]},{"ID":"20260505170804-irt4s9x","Type":"NodeParagraph","Properties":{"id":"20260505170804-irt4s9x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"include \u003c 文件名 \u003e 和 "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include\"文件名\""},{"Type":"NodeText","Data":" 的区别:"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查找文件的位置：include \u003c 文件名 \u003e 在标准库头文件所在的目录中查找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果没有，再到当前源文件所在目录下查找"}]},{"ID":"20260505170804-9qgv7ig","Type":"NodeParagraph","Properties":{"id":"20260505170804-9qgv7ig","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include\"文件名\""},{"Type":"NodeText","Data":" 在当前源文件所在目录中进行查找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果没有再到系统目录中查找"}]},{"ID":"20260505170804-pnjethy","Type":"NodeParagraph","Properties":{"id":"20260505170804-pnjethy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用习惯：对于标准库中的头文件常用 include \u003c 文件名 \u003e，对于自己定义的头文件，常用 "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include\"文件名\""}]},{"ID":"20260505170804-uecg1hv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uecg1hv","updated":"20260907144429"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"sizeof(1==1) 在 C 和 C++ 中分别是什么结果？"}]},{"ID":"20260505170804-7iqvlkt","Type":"NodeParagraph","Properties":{"id":"20260505170804-7iqvlkt","updated":"20260907144426"},"Children":[{"Type":"NodeText","Data":"在 C 语言中，1= =1 是关系表达式，其结果为整数类型，真用 1 表示、假用 0 表示，因此表达式的值类型是 int\n在常见平台下 int 占 4 个字节，所以 sizeof(1= =1) 的结果是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":" 4"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-3q97z2c","Type":"NodeParagraph","Properties":{"id":"20260505170804-3q97z2c","updated":"20260907144429"},"Children":[{"Type":"NodeText","Data":"在 C++ 中，关系表达式的结果是真正的布尔类型 bool\ntrue 和 false 都是该类型的值。而 bool 类型的大小固定为 1 字节，因此 sizeof(1==1) 的结果是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":" 1"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-i2lvstc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-i2lvstc","updated":"20260907144505"},"Children":[{"Type":"NodeText","Data":"在 C++ 中，0.1+0.2 为什么不等于 0.3\t"}]},{"ID":"20260505170804-1s8asah","Type":"NodeParagraph","Properties":{"id":"20260505170804-1s8asah","updated":"20260907144454"},"Children":[{"Type":"NodeText","Data":"计算机使用二进制存储 float 和 double\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"而 0.1 和 0.2 都是二进制无限循环小数，无法精确表示，只能存储一个无限接近真实值的近似值"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n两个近似值相加后，结果自然也是一个近似值，和精确的 0.3 不相等\n这不是 C++ 的问题，而是所有语言通用的 IEEE 754 浮点数标准机制导致的"}]},{"ID":"20260505170804-q722wx9","Type":"NodeParagraph","Properties":{"id":"20260505170804-q722wx9","updated":"20260907144505"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"解决：不要用 == 直接比较浮点数，改用误差范围判断\nif (abs(a + b - 0.3) \u0026lt; 1e-6)"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-avl49ji","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-avl49ji","updated":"20260907144649"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"i++=1，++i= 1 哪—句对"}]},{"ID":"20260505170804-ssmcwk5","Type":"NodeParagraph","Properties":{"id":"20260505170804-ssmcwk5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"++i=1 是对的"}]},{"ID":"20260505170804-ioy8snr","Type":"NodeParagraph","Properties":{"id":"20260505170804-ioy8snr","updated":"20260907144634"},"Children":[{"Type":"NodeText","Data":"++i 是前置自增，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"返回的是左值"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"所以可以放在赋值号的左边\ni++ 是先返回 i 的旧值再给 i 加 1，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"返回的是临时副本，属于右值"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-esyzao4","Type":"NodeParagraph","Properties":{"id":"20260505170804-esyzao4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"前置自增 ++i 效率通常比后置自增 i++ 高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为后置自增需要额外保存旧值，产生临时对象"}]},{"ID":"20260505170804-gaag8pp","Type":"NodeParagraph","Properties":{"id":"20260505170804-gaag8pp","updated":"20260907144649"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"在 C++ 中，后置自增可以重载为返回左值，但这不符合语言规范和使用习惯"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-ewcz0y6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ewcz0y6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"i++ 是原子性的吗"}]},{"ID":"20260505170804-i8c1tx2","Type":"NodeParagraph","Properties":{"id":"20260505170804-i8c1tx2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"i++ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不是原子操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层会拆解为读取变量值、自增计算、写回内存三步"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程下三步之间会发生线程切换，引发数据覆盖、计数不准等线程安全问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"想要保证原子性，可使用 AtomicInteger 原子类 CAS 操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或是通过 synchronized、显式加锁实现"}]},{"ID":"20260505170804-6k6qbag","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6k6qbag","updated":"20260907145431"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存分配流程"}]},{"ID":"20260505170804-jayviou","Type":"NodeParagraph","Properties":{"id":"20260505170804-jayviou","updated":"20260907144720"},"Children":[{"Type":"NodeText","Data":"new 或者 malloc 申请内存时\n并不是直接跟操作系统要物理内存，而是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"先跟 C 库的内存管理器申请"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260506171848-1ofknsb","Type":"NodeParagraph","Properties":{"id":"20260506171848-1ofknsb","updated":"20260907144909"},"Children":[{"Type":"NodeText","Data":"C 库会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"优先在当前进程的堆里找一块空闲内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"给你用，这样速度比较快\n如果堆里空间不够了，C 库才会通过系统调用\n比如 brk 或者 mmap，向操作系统申请扩展堆空间"}]},{"ID":"20260506171903-hshty0a","Type":"NodeParagraph","Properties":{"id":"20260506171903-hshty0a","updated":"20260907144937"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"操作系统这时候会分配虚拟内存，并建立虚拟地址和物理内存的映射"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n但不会马上给真正的物理内存，而是用到的时候才分配，也就是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"写时复制"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-bx14oq5","Type":"NodeParagraph","Properties":{"id":"20260505170804-bx14oq5","updated":"20260907145431"},"Children":[{"Type":"NodeText","Data":"内存用完调用 delete 或 free 时，内存也不是立刻还给操作系统\n而是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"先还给 C 库的内存池"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，方便下次继续复用，减少系统调用开销\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只有当空闲内存比较多的时候，库才会把多余的内存释放回系统"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-ktkfq8e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ktkfq8e","updated":"20260907145600"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 内存管理的原则"}]},{"ID":"20260505170804-40zvvqr","Type":"NodeParagraph","Properties":{"id":"20260505170804-40zvvqr","updated":"20260907145600"},"Children":[{"Type":"NodeText","Data":"C++ 内存管理最核心的原则是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"谁申请，谁释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n保证内存申请和释放成对出现，避免泄漏和重复释放"}]},{"ID":"20260505170804-h39lina","Type":"NodeParagraph","Properties":{"id":"20260505170804-h39lina","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优先使用智能指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量避免使用裸指针，必须使用时也要明确所有权"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"杜绝野指针、空指针访问和重复 delete"}]},{"ID":"20260505170804-yyrwe1j","Type":"NodeParagraph","Properties":{"id":"20260505170804-yyrwe1j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"动态分配的内存一定要成对释放，杜绝只 new 不 delete"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时不使用已经释放的内存，防止出现悬垂指针"}]},{"ID":"20260505170804-cywd1e7","Type":"NodeParagraph","Properties":{"id":"20260505170804-cywd1e7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在容器和资源管理上，优先使用标准库容器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让系统自动管理内存，减少手动分配的场景"}]},{"ID":"20260505170804-gdm0d6c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-gdm0d6c","updated":"20260907145737"},"Children":[{"Type":"NodeText","Data":"new 和 malloc\t\t\t"}]},{"ID":"20260505170804-g3qqy1z","Type":"NodeParagraph","Properties":{"id":"20260505170804-g3qqy1z","updated":"20260907145656"},"Children":[{"Type":"NodeText","Data":"new 和 delete 是 C++ 关键字 / 运算符\t\tmalloc 和 free 是 C 标准库函数\nnew 和 malloc 都在堆区分配内存，但 "},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 会调用构造函数进行初始化，并在分配失败时抛出异常"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"malloc 不调用构造函数，需要手动初始化，并在分配失败时返回 NULL"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 会自动识别类型，malloc 不自动识别返回 void*"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260512122732-dql7iwi","Type":"NodeParagraph","Properties":{"id":"20260512122732-dql7iwi","updated":"20260907145737"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"不是自己运行时识别类型，而是编译器根据你写死的类型\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"在编译期决定内存大小、构造函数和返回指针类型，运行时只是按这个结果去分配和构造对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260512122742-vr6h7ge","Type":"NodeParagraph","Properties":{"id":"20260512122742-vr6h7ge","updated":"20260907145713"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"new 可以重载，malloc 不能重载\ndelete 会调析构，free 不调析构"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-zo5gx2q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zo5gx2q","updated":"20260907145751"},"Children":[{"Type":"NodeText","Data":"为什么有了 malloc 还需要 new？\t\t"}]},{"ID":"20260505170804-8pjg0hw","Type":"NodeParagraph","Properties":{"id":"20260505170804-8pjg0hw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"malloc 只负责内存分配，无法完成 C++ 对象的初始化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"new 不仅分配内存，还会自动调用构造函数，完成对象的构造，是面向对象的内存分配方式"}]},{"ID":"20260505170804-waef9vn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-waef9vn","updated":"20260907150104"},"Children":[{"Type":"NodeText","Data":"new 的底层执行流程是什么？\t\t"}]},{"ID":"20260505170804-libkyp8","Type":"NodeParagraph","Properties":{"id":"20260505170804-libkyp8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"new 内存分配底层函数"}]},{"ID":"20260505170804-8sktwou","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260505170804-8sktwou","updated":"20260907150104"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 全局 operator new \nvoid* operator new(size_t size) {\n    // 底层：最终调用 malloc 分配内存\n    void* p = malloc(size);\n    // 分配失败：抛出 bad_alloc 异常\n    if (p == nullptr) throw bad_alloc();\n    return p;\n}\n\n// 第一步：调用operator new，分配原始内存，只传sizeof(A)字节，不知道A是什么\nvoid* raw = operator new(sizeof(A));\n// 第二步！编译器自动插入：在raw这块内存上调用A的构造函数\nA* ptr = new(raw) A; // 定位new，执行构造\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260505170804-f4llif2","Type":"NodeParagraph","Properties":{"id":"20260505170804-f4llif2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"计算所需内存大小，先调用 operator new () 去堆上申请内存底层，其实就是用 malloc 去拿空间，只是封装了一层。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存拿到后，自动调用构造函数初始化对象，最后返回正确类型的指针"}]},{"ID":"20260505170804-bl2bb6a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bl2bb6a","updated":"20260907151231"},"Children":[{"Type":"NodeText","Data":"malloc 怎么分配内存的\t"}]},{"ID":"20260505170804-epi3nal","Type":"NodeParagraph","Properties":{"id":"20260505170804-epi3nal","updated":"20260907151157"},"Children":[{"Type":"NodeText","Data":"malloc 是 C 库提供的堆内存分配函数，底层由 glibc 的 ptmalloc 管理\n它"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"内部维护空闲链表"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"优先在已有堆空间"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"中寻找合适的空闲块分配\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"小内存通过 brk/sbrk 扩展堆顶，大内存则用 mmap 映射匿名页"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n分配时会"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"记录块大小等元信息"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，方便 free 回收"}]},{"ID":"20260907151200-rkd9ijz","Type":"NodeParagraph","Properties":{"id":"20260907151200-rkd9ijz","updated":"20260907151200"},"Children":[{"Type":"NodeText","Data":"free 一般只是将内存标记为空闲并放回链表，不会立即归还操作系统，只有堆尾连续空闲时才可能收缩\nmmap 分配的内存可直接 munmap 释放"}]},{"ID":"20260505170804-h5tdnyg","Type":"NodeParagraph","Properties":{"id":"20260505170804-h5tdnyg","updated":"20260907151231"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"mmap 之所以比 brk 慢，主要是因为 mmap 每次分配都要执行系统调用"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n进入内核态去建立虚拟内存映射、分配物理页，还要处理页表，开销本身就比较大\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"而 brk 只是简单移动堆顶指针，只在堆空间不够时才调用一次，后续小内存分配都在用户态通过内存池复用，不需要频繁进内核"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n另外，mmap 分配的内存释放时会直接归还给系统，频繁创建销毁会产生大量缺页异常和系统调用开销，所以比 brk 这种批量管理堆内存的方式效率更低"}]},{"ID":"20260505170804-joknv1m","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-joknv1m","updated":"20260907151511"},"Children":[{"Type":"NodeText","Data":"malloc 时的 brk 和 mmap\t\t"}]},{"ID":"20260505170804-7fsfns5","Type":"NodeParagraph","Properties":{"id":"20260505170804-7fsfns5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Linux 中 malloc 分配内存时，底层主要用两种系统调用：brk 和 mmap。小块内存默认用 brk，大块内存用 mmap"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"brk 是操作堆顶指针，把堆往上伸，分配速度很快，适合小内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它有个问题：只能从堆顶部释放，如果中间有内存没释放，后面的内存都还不回系统，容易产生碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"mmap 是在进程的映射区单独开一块独立内存，和堆没关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用完可以直接释放、立刻还给系统，不会产生碎片，适合大块内存"}]},{"ID":"20260505170804-tfn5k3v","Type":"NodeParagraph","Properties":{"id":"20260505170804-tfn5k3v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"所以 malloc 做了一个策略：小内存用 brk 保证速度，大内存用 mmap 避免碎片、提高利用率"}]},{"ID":"20260516133351-w7u6phb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516133351-w7u6phb","updated":"20260516085710"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"malloc 1KB 和 1MB 有什么区别"}]},{"ID":"20260516133351-kjf8a2y","Type":"NodeParagraph","Properties":{"id":"20260516133351-kjf8a2y","updated":"20260516133300"},"Children":[{"Type":"NodeText","Data":"malloc(1KB) 和 malloc(1MB) 本质上都是向堆申请内存，但​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"区别主要体现在分配方式、开销和对系统的影响上"},{"Type":"NodeText","Data":"​。"}]},{"ID":"20260516133351-jmgzpsc","Type":"NodeParagraph","Properties":{"id":"20260516133351-jmgzpsc","updated":"20260516133300"},"Children":[{"Type":"NodeText","Data":"第一，​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小块内存一般走内存分配器的缓存或堆管理逻辑"},{"Type":"NodeText","Data":"​，速度通常比较快；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大块内存"},{"Type":"NodeText","Data":" 往往可能直接向操作系统申请，比如通过 mmap 这类机制，分配和释放成本会更高。"}]},{"ID":"20260516133351-z1j87yu","Type":"NodeParagraph","Properties":{"id":"20260516133351-z1j87yu","updated":"20260516133300"},"Children":[{"Type":"NodeText","Data":"第二，​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1MB 更容易产生明显的内存占用压力"},{"Type":"NodeText","Data":"​。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"申请 1KB 基本没什么感觉，但 1MB 如果频繁申请释放，可能更容易带来内存碎片、缺页、缓存命中率下降这些问题。"}]},{"ID":"20260516133351-3js57f0","Type":"NodeParagraph","Properties":{"id":"20260516133351-3js57f0","updated":"20260516133300"},"Children":[{"Type":"NodeText","Data":"第三，​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"初始化和访问成本也不同"},{"Type":"NodeText","Data":"​。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"malloc 本身只是申请地址空间，不会主动清零，但真正使用这块内存时，1MB 的访问成本肯定比 1KB 大得多，尤其是在 cache 和 page 层面影响更明显。"}]},{"ID":"20260505170804-6p1v2xm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6p1v2xm","updated":"20260512122517"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"让你实现 malloc 和 free 的内存分配和释放，你怎么设计，考虑内存碎片问题？"}]},{"ID":"20260505170804-0rm3zye","Type":"NodeParagraph","Properties":{"id":"20260505170804-0rm3zye","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"手动实现简易内存池 + 隐式空闲链表来做 malloc 和 free"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时用边界标记、合并相邻空闲块、最佳适配解决内存碎片"}]},{"ID":"20260505170804-va9o5mv","Type":"NodeParagraph","Properties":{"id":"20260505170804-va9o5mv","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"整体设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先向操作系统申请一大块连续堆内存做内存池，把整块内存划分为已分配块、空闲块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个内存块头部加块大小、分配标记的元数据，用隐式链表串联所有块，不用额外指针存链表"}]},{"ID":"20260505170804-sca2xeb","Type":"NodeParagraph","Properties":{"id":"20260505170804-sca2xeb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"malloc 分配逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用首次适配 / 最佳适配遍历空闲链表，找到足够大的空闲块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果块富余空间够大，就拆分块，分出一小块给用户，剩余保留为空闲块，减少内部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"free 释放逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"释放时先标记块为空闲，立刻检查前驱和后继块，如果也是空闲就相邻合并，避免外部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用边界标记快速找到前后块起始地址，不用遍历链表就能直接合并，效率更高"}]},{"ID":"20260505170804-993khid","Type":"NodeParagraph","Properties":{"id":"20260505170804-993khid","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"碎片优化核心"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部碎片：空闲块拆分机制，不浪费多余空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外部碎片：free 后即时合并相邻空闲块，长时间保留大块连续内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体用内存池减少系统调用开销，链表管理简单高效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"兜底策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存池不足时，再向 OS 扩容申请新内存块，接入原有链表统一管理"}]},{"ID":"20260512122517-1io3t5f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512122517-1io3t5f","updated":"20260907151614"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"delete 和 detele[]的区别"}]},{"ID":"20260512122517-9dtnq8w","Type":"NodeParagraph","Properties":{"id":"20260512122517-9dtnq8w","updated":"20260907151614"},"Children":[{"Type":"NodeText","Data":"delete 和 delete[] 的区别，核心在于它们释放的对象类型不一样\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"delete 用来释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"单个对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"，delete[] 用来释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"动态数组"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260512122517-g5bccy6","Type":"NodeParagraph","Properties":{"id":"20260512122517-g5bccy6","updated":"20260512122345"},"Children":[{"Type":"NodeText","Data":"比如你如果是 new T 出来的，就必须用 delete"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是 new T[n] 出来的，就必须用 delete[]"}]},{"ID":"20260512122517-9y618tq","Type":"NodeParagraph","Properties":{"id":"20260512122517-9y618tq","updated":"20260512122351"},"Children":[{"Type":"NodeText","Data":"因为数组释放时，不只是回收内存，还要对数组里的每个元素逐个调用析构函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以编译器需要知道这是“数组形式”的释放"}]},{"ID":"20260512122517-za0xs8e","Type":"NodeParagraph","Properties":{"id":"20260512122517-za0xs8e","updated":"20260512122428"},"Children":[{"Type":"NodeText","Data":"如果混用，比如 new[] 却用 delete，或者 new 却用 delete[]，结果就是未定义行为"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"轻则析构不完整，重则内存破坏、程序崩溃"}]},{"ID":"20260512123226-9pg4qnz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512123226-9pg4qnz","updated":"20260907151643"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果要让你手动实现 delete[]，需要怎么做"}]},{"ID":"20260512123226-3host29","Type":"NodeParagraph","Properties":{"id":"20260512123226-3host29","updated":"20260907151643"},"Children":[{"Type":"NodeText","Data":"手动实现 delete[]，核心要解决两件事：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"先知道数组里有多少个对象"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"，再"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"逐个调用析构函数，最后统一释放整块内存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n因为数组不是一个对象，而是一批对象，不能像普通 delete 那样只析构一次"}]},{"ID":"20260512123226-ibfxglp","Type":"NodeParagraph","Properties":{"id":"20260512123226-ibfxglp","updated":"20260512123156"},"Children":[{"Type":"NodeText","Data":"一般做法是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 new[] 分配时，除了真正给用户的对象空间，还会额外多申请一小段“头部空间”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把数组元素个数记下来"}]},{"ID":"20260512123226-ymwu0nj","Type":"NodeParagraph","Properties":{"id":"20260512123226-ymwu0nj","updated":"20260512123218"},"Children":[{"Type":"NodeText","Data":"返回给用户的是头部后面的首元素地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"等 delete[] 时，再从用户指针往前退，取出这个元素个数，然后倒序调用每个元素的析构函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后把整块原始内存交给 operator delete[] 或 free 释放"}]},{"ID":"20260515184329-tb5nmdb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260515184329-tb5nmdb","updated":"20260907151653"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"平常释放一个指针时，为什么可以释放到正确的大小\t（delete）"}]},{"ID":"20260515184329-f24tmxo","Type":"NodeParagraph","Properties":{"id":"20260515184329-f24tmxo","updated":"20260907151653"},"Children":[{"Type":"NodeText","Data":"new 分配内存时，底层会多存一块"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"头信息，记录这块内存的总大小"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\ndelete 释放时，不用你手动传大小，编译器 / 运行时会自动查到这个大小\n直接完整回收，所以总能释放正确大小"}]},{"ID":"20260505170804-dvz68cc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dvz68cc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"外碎片如何处理？"}]},{"ID":"20260505170804-al87129","Type":"NodeParagraph","Properties":{"id":"20260505170804-al87129","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"释放即刻合并：free 时立刻合并前后相邻空闲块，把零散小块合成大块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大小块分离：小块用堆内链表复用，大块直接 mmap，释放直接还给内核，不堆碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"空闲块拆分：分配时富余空间拆出来留作空闲，减少浪费"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存池分桶：固定大小分块管理，减少碎片化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"极端做内存紧缩：挪动已分配内存，收拢空闲空间，常规 malloc 一般不用"}]},{"ID":"20260505170804-n28lwr9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-n28lwr9","updated":"20260907151846"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"在 c 中 malloc (0) 会发生什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-17fabvj","Type":"NodeParagraph","Properties":{"id":"20260505170804-17fabvj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"从 C 标准规定、底层实现、跨平台差异、工程规范四个维度做完整总结："}]},{"ID":"20260505170804-lsj9ayi","Type":"NodeParagraph","Properties":{"id":"20260505170804-lsj9ayi","updated":"20260907151821"},"Children":[{"Type":"NodeText","Data":"首先从 C 标准来看，malloc(0) 是合法的实现定义行为，标准不规定固定返回值，只允许两种结果：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"要么返回 NULL，要么返回一个非空但不能用于读写的唯一指针，两种行为都合规，不代表分配失败"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-hkgd0ik","Type":"NodeParagraph","Properties":{"id":"20260505170804-hkgd0ik","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Linux/glibc 底层实现中，malloc(0) 不会返回 NULL，而是会分配一块内存管理器规定的最小内存块（64 位系统通常 24/32 字节）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这是因为 glibc 的内存分配器有最小块限制和对齐要求，即便申请 0 字节，也会返回一个带管理结构的最小指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但这个指针绝对不能读写数据，否则会触发未定义行为"}]},{"ID":"20260505170804-jtuga44","Type":"NodeParagraph","Properties":{"id":"20260505170804-jtuga44","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"跨平台兼容性问题，不同标准库行为不一致："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"glibc 返回非空最小块，Windows、musl 等很大概率直接返回 NULL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这意味着依赖 malloc(0)返回值的代码，会出现严重的可移植性问题"}]},{"ID":"20260505170804-04zrtsx","Type":"NodeParagraph","Properties":{"id":"20260505170804-04zrtsx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后是工程最佳实践："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，绝不主动使用 malloc(0)，业务代码要提前判断 size 为 0 的情况，避免边界调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二，无论返回空还是非空，都不能解引用读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三，只要返回非空指针，必须调用 free 释放，否则会造成内存泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四，封装安全分配函数，提前拦截 size=0 的场景，保证代码健壮性"}]},{"ID":"20260505170804-8ihbjhx","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ihbjhx","updated":"20260907151846"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"malloc(0) 是实现定义，可能返回空\nnew(0) 是标准定义，全平台一定返回非空唯一指针，且绝不返回 nullptr"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\nnew T[0] 返回的指针，指向一个由堆分配器创建的最小合法占位地址\n它是非空、唯一、有效的堆指针，但不指向任何可读写内存，也不包含任何对象\n它的作用仅仅是满足 C++ 标准对零长度数组的规范，并能安全地被 delete[] 释放"}]},{"ID":"20260505170804-ucpr17t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ucpr17t","updated":"20260516093033"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"free 的回收机制\t\t\u003e\u003e"}]},{"ID":"20260505170804-tvdmzqm","Type":"NodeParagraph","Properties":{"id":"20260505170804-tvdmzqm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"free()是 C 语言用于释放 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"malloc/calloc/realloc"},{"Type":"NodeText","Data":" 申请的堆内存的函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它仅标记内存为空闲可复用，不会清空数据、也不会自动将指针置空，释放后需手动把指针赋值为 NULL 避免野指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遵循"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一次申请对应一次释放"},{"Type":"NodeText","Data":"原则，只能释放堆内存，重复释放、释放非堆内存都会导致程序崩溃"}]},{"ID":"20260516093033-tlqs39w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516093033-tlqs39w","updated":"20260907151934"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么在栈上分配内存"}]},{"ID":"20260516093033-5m3tn91","Type":"NodeParagraph","Properties":{"id":"20260516093033-5m3tn91","updated":"20260516092204"},"Children":[{"Type":"NodeText","Data":"栈上分配内存主要有两种方式"}]},{"ID":"20260516093033-x9o03g8","Type":"NodeParagraph","Properties":{"id":"20260516093033-x9o03g8","updated":"20260907151934"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"第一种是定义"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"局部变量、局部数组"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n由编译器自动分配，函数调用时创建栈帧，通过移动栈指针开辟空间\n函数执行完栈帧销毁，内存自动释放，速度快\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"大小编译时确定"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"，分配动作在"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"运行时"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"完成"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260516093033-d4nzwf0","Type":"NodeParagraph","Properties":{"id":"20260516093033-d4nzwf0","updated":"20260907151927"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"第二种是使用 "},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"alloca 函数"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n在运行时动态在当前函数栈上分配内存，同样不需要手动 free，函数结束自动回收\n但栈空间有限，alloca 容易栈溢出，且可移植性较差，一般不推荐使用\n整体来说，栈分配大小要么编译期固定，要么运行时动态扩容栈指针，由系统自动管理，不用手动释放\n大小和分配都是运行时"}]},{"ID":"20260505170804-svoedsz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-svoedsz","updated":"20260907151952"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"栈申请空间为什么比堆块\t\t\u003e\u003e"}]},{"ID":"20260505170804-qwkv46j","Type":"NodeParagraph","Properties":{"id":"20260505170804-qwkv46j","updated":"20260907151952"},"Children":[{"Type":"NodeText","Data":"核心原因是二者的管理机制和底层实现存在本质差异\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"栈是由系统自动管理的连续内存空间，分配和释放仅需通过"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"移动栈顶指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"这一条 CPU 指令即可完成"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n全程无需复杂计算、内存查找或系统调用，属于纯粹的硬件级操作，开销几乎可以忽略不计\n同时栈是线程私有的，不存在多线程竞争，进一步保证了分配效率"}]},{"ID":"20260505170804-is4a25b","Type":"NodeParagraph","Properties":{"id":"20260505170804-is4a25b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"堆则是进程内所有线程共享的动态内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分配时需要操作系统的内存管理器遍历空闲内存块、寻找适配空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还要维护内存链表、处理内存碎片，步骤繁琐且开销极大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程环境下，堆分配还必须加锁避免冲突，锁竞争会进一步降低速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此外，堆空间需要手动或通过垃圾回收机制释放，无法像栈一样随函数执行完毕自动回收，整体管理成本远高于栈"}]},{"ID":"20260505170804-c8ns9gz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c8ns9gz","updated":"20260907152006"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"堆与栈"}]},{"ID":"20260505170804-4hhkrqu","Type":"NodeParagraph","Properties":{"id":"20260505170804-4hhkrqu","updated":"20260907152003"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"栈"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"由系统自动分配、自动释放，空间小、速度快"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n存放局部变量、函数参数、返回地址这些\n栈的内存连续，遵循后进先出，生命周期跟着函数，函数结束立刻回收"}]},{"ID":"20260505170804-45ex87e","Type":"NodeParagraph","Properties":{"id":"20260505170804-45ex87e","updated":"20260907152006"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"堆"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"由程序员手动 new/malloc 申请，delete/free 释放"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n空间大、速度慢，内存不连续\n堆用来存大对象、生命周期不确定的数据，不手动释放容易造成内存泄漏"}]},{"ID":"20260505170804-dbx3wri","Type":"NodeParagraph","Properties":{"id":"20260505170804-dbx3wri","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"栈由系统管理无需手动回收，开销小效率高但空间有限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"堆需要自己管理内存，空间灵活可动态扩容，但有内存泄漏、内存碎片的问题"}]},{"ID":"20260505170804-9zsyf5f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9zsyf5f","updated":"20260907152948"},"Children":[{"Type":"NodeText","Data":"如何限制对象只能创建在栈上 / 只能创建在堆上\t"}]},{"ID":"20260505170804-mipoq1j","Type":"NodeParagraph","Properties":{"id":"20260505170804-mipoq1j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先是限制对象只能创建在栈上，禁止在堆上创建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象在堆上创建必须依赖 new 运算符，而 new 的底层会调用类的 operator new 分配内存，再调用构造函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以我们只需要将类的 operator new 和 operator new [] 重载为私有成员，外部就无法调用 new 来创建堆对象了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时，构造函数和析构函数保持公有，满足栈对象创建的要求"}]},{"ID":"20260505170804-wxzxnuz","Type":"NodeParagraph","Properties":{"id":"20260505170804-wxzxnuz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后是限制对象只能创建在堆上，禁止在栈上创建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈上创建对象会自动调用构造和析构函数，因此可以将析构函数声明为私有 / 保护"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器在栈上分配对象时，会检查析构函数的可访问性，私有析构函数会直接编译报错"}]},{"ID":"20260505170804-p75ow0y","Type":"NodeParagraph","Properties":{"id":"20260505170804-p75ow0y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时，需要提供一个公有的静态成员函数，在函数内部用 new 创建堆对象并返回指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为了安全释放内存，再提供一个公有的成员函数调用 delete 释放对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种方式既保证了对象只能在堆上创建，又规范了对象的创建和销毁流程，避免内存泄漏"}]},{"ID":"20260505170804-c4440kr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c4440kr","updated":"20260907153009"},"Children":[{"Type":"NodeText","Data":"野指针和悬空指针的概念？\t\t"}]},{"ID":"20260505170804-dasi8b6","Type":"NodeParagraph","Properties":{"id":"20260505170804-dasi8b6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"野指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针没初始化，或指向的内存已经释放、作废，却没置空，指向非法地址，这就是野指针。使用会直接崩溃。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"悬空指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指向的内存已经被 delete 释放，但指针没改成 nullptr。"}]},{"ID":"20260505170804-5ubtz3c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5ubtz3c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"extern"}]},{"ID":"20260505170804-n0iv1mc","Type":"NodeParagraph","Properties":{"id":"20260505170804-n0iv1mc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"extern 主要有两个作用："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"声明外部变量 / 函数，告诉编译器这个变量或函数不是在当前文件定义的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是在别的文件里定义的，我现在只是拿来用，你别报错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不会分配内存，只是做个声明告诉编译器而已"}]},{"ID":"20260505170804-ikk8dwc","Type":"NodeParagraph","Properties":{"id":"20260505170804-ikk8dwc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和 C 结合成 extern \"C\""},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来解决 C++ 和 C 混编时的名字修饰问题，让 C++ 能调用 C 代码"}]},{"ID":"20260505170804-gzykdtb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-gzykdtb","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#ifdef __cplusplus\nextern \"C\" {\n#endif\n// 这里放 C 风格的函数声明\nvoid foo();\nint bar(int);\n#ifdef __cplusplus\n}\n#endif\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3tnomse","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3tnomse","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C 语言中有哪些宏定义"}]},{"ID":"20260505170804-5uhotmc","Type":"NodeParagraph","Properties":{"id":"20260505170804-5uhotmc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统预定义宏："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"__FILE__文件名、__LINE__行号、__DATE__和__TIME__编译日期时间，多用于日志报错定位"}]},{"ID":"20260505170804-57snk83","Type":"NodeParagraph","Properties":{"id":"20260505170804-57snk83","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"条件编译宏："},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"define定义、"},{"Type":"NodeText","Data":"undef 取消，搭配 ifdef、ifndef、endif"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来跨平台适配、开关调试代码、防止头文件重复包含"}]},{"ID":"20260505170804-sgjt9ih","Type":"NodeParagraph","Properties":{"id":"20260505170804-sgjt9ih","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"业务自定义宏："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定义常量、简易函数宏，简化代码、提升复用性，还有 NULL 这类常用标准宏"}]},{"ID":"20260505170804-sf3smyx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-sf3smyx","updated":"20260524140748"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"const 和 define 的区别"}]},{"ID":"20260505170804-sjwy5i0","Type":"NodeParagraph","Properties":{"id":"20260505170804-sjwy5i0","updated":"20260506182414"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"define：只是简单的文字替换，没有类型、没有作用域，容易出"},{"Type":"NodeText","Data":"​ bug"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const：是真正的常量，有类型检查、有作用域，安全规范"}]},{"ID":"20260524140741-jlzjfa0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524140741-jlzjfa0","updated":"20260907153102"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"可以通过给函数加 const 实现重载吗"}]},{"ID":"20260524140803-sf5j0wf","Type":"NodeParagraph","Properties":{"id":"20260524140803-sf5j0wf","updated":"20260524140805"},"Children":[{"Type":"NodeText","Data":"可以，但要分情况"}]},{"ID":"20260524140803-pcsu1m9","Type":"NodeParagraph","Properties":{"id":"20260524140803-pcsu1m9","updated":"20260524140821"},"Children":[{"Type":"NodeText","Data":"如果只是普通函数参数写成 int 和 const int，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不能"},{"Type":"NodeText","Data":"构成重载"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为按值传递时顶层 const 不算函数签名的一部分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText"