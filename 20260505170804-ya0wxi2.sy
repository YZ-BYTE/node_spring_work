4-9lmo85h","updated":"20260505170804"},"Children":[{"ID":"20260505170804-fnscst2","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-fnscst2","updated":"20260505170804"},"Children":[{"ID":"20260505170804-t6a3uhb","Type":"NodeParagraph","Properties":{"id":"20260505170804-t6a3uhb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"malloc 和 new 的区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属性：new/delete 是 C++ 关键字 / 运算符；malloc/free 是 C 标准库函数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存类型：new 从自由存储区分配；malloc 从堆分配。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"初始化：new 会调用构造函数初始化对象；malloc 只分配内存，不初始化。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"返回值：new 返回对象类型指针，无需强转；malloc 返回 void*，必须强转。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存大小：new 自动计算大小；malloc 需手动指定字节数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"失败处理：new 失败抛异常；malloc 失败返回 NULL。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数组形式：new[]/delete[] 专门处理数组；malloc 不区分数组 / 普通内存。"}]}]},{"ID":"20260505170804-q1qhml6","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-q1qhml6","updated":"20260505170804"},"Children":[{"ID":"20260505170804-pzmjr6e","Type":"NodeParagraph","Properties":{"id":"20260505170804-pzmjr6e","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"map 和 unordered_map 的区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层：map 是红黑树；unordered_map 是哈希表。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有序性：map 自动按键有序；unordered_map 无序。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查询效率：map O(log n)；unordered_map O (1)（平均）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插入删除：map O(log n)；unordered_map O(1)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"迭代器：map 支持双向迭代器；unordered_map 支持前向迭代器。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用场景：需要有序用 map；追求高效查询用 unordered_map。"}]}]},{"ID":"20260505170804-s1ao8h8","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-s1ao8h8","updated":"20260505170804"},"Children":[{"ID":"20260505170804-1ag5y4i","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ag5y4i","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"map 和 vector 的区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层：vector 连续数组；map 红黑树。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存储：vector 存单一元素；map 存 key-value 键值对。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"访问：vector 支持下标随机访问 O(1)；map 按键查找 O (log n)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插入删除：vector 中间操作 O (n)；map 任意位置 O (log n)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有序性：vector 无序；map 按键有序。"}]}]},{"ID":"20260505170804-jp1wn5j","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-jp1wn5j","updated":"20260505170804"},"Children":[{"ID":"20260505170804-wep6pj6","Type":"NodeParagraph","Properties":{"id":"20260505170804-wep6pj6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"set、map、list 底层实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"map/set：红黑树（平衡二叉搜索树），自动排序、高效查找。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"list：双向循环链表，不支持随机访问，插入删除高效。"}]}]},{"ID":"20260505170804-un367rk","Type":"NodeListItem","Data":"5.","ListData":{"Typ":1,"Tight":true,"Start":5,"Delimiter":46,"Padding":3,"Marker":"NS4=","Num":5},"Properties":{"id":"20260505170804-un367rk","updated":"20260505170804"},"Children":[{"ID":"20260505170804-wu3e8lx","Type":"NodeParagraph","Properties":{"id":"20260505170804-wu3e8lx","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"const 和 define 的区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译阶段：const 编译阶段处理；define 预处理阶段（单纯替换）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类型安全：const 有类型检查；define 无类型检查。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用域：const 受作用域限制；define 全局生效。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调试：const 可调试；define 无法调试。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存：const 分配内存；define 不分配，直接替换。"}]}]},{"ID":"20260505170804-8nuenv5","Type":"NodeListItem","Data":"6.","ListData":{"Typ":1,"Tight":true,"Start":6,"Delimiter":46,"Padding":3,"Marker":"Ni4=","Num":6},"Properties":{"id":"20260505170804-8nuenv5","updated":"20260505170804"},"Children":[{"ID":"20260505170804-cibyqb2","Type":"NodeParagraph","Properties":{"id":"20260505170804-cibyqb2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"常量指针 和 指针常量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常量指针：const int* p → 指针指向的内容不能改，指针本身可以改。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针常量：int* const p → 指针本身不能改，指向的内容可以改。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"口诀：const 后面跟谁，谁就不能改。"}]}]},{"ID":"20260505170804-v21gm2s","Type":"NodeListItem","Data":"7.","ListData":{"Typ":1,"Tight":true,"Start":7,"Delimiter":46,"Padding":3,"Marker":"Ny4=","Num":7},"Properties":{"id":"20260505170804-v21gm2s","updated":"20260505170804"},"Children":[{"ID":"202