r: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n第二，直接通知其他所有 CPU 核心，把"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"他们抽屉里存的旧数据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"作废"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260507210708-izpvdph","Type":"NodeParagraph","Properties":{"id":"20260507210708-izpvdph","updated":"20260507205907"},"Children":[{"Type":"NodeText","Data":"其他核下次再读这个变量，自己抽屉里作废了，只能去公共区域拿最新的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样就穿透了每一层私有缓存，所有核都能立马看到最新值"}]},{"ID":"20260507210708-mcv7qr9","Type":"NodeParagraph","Properties":{"id":"20260507210708-mcv7qr9","updated":"20260907140931"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"原子变量要穿透缓存、立刻同步给所有核心，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"硬件必须强制把前后指令都卡住"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n不能乱排、不能延后\n正是因为要做缓存全局同步，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"天然自带内存屏障"},{"Type":"NodeText","Data":"\n从而顺便就禁止了指令乱序、保证执行顺序不乱"}]},{"ID":"20260524142633-x7y2bsu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524142633-x7y2bsu","updated":"20260907141031"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"连续内存更快的具体原因是什么"}]},{"ID":"20260524142650-vz8buhu","Type":"NodeParagraph","Properties":{"id":"20260524142650-vz8buhu","updated":"20260907140950"},"Children":[{"Type":"NodeText","Data":"连续内存更快，核心原因是它"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"更符合 CPU 和操作系统的访问方式"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260524142650-9ypkvds","Type":"NodeParagraph","Properties":{"id":"20260524142650-9ypkvds","updated":"20260907141011"},"Children":[{"Type":"NodeText","Data":"首先，CPU 读取数据不是一个字节一个字节地读，而是按"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"一整块缓存行去读"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n通常是 64 字节左右\n连续内存里的数据挨着排，访"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"问一个元素时，旁边一批元素往往会一起被带进 CPU cache"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n后面再访问相邻数据时就能"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"直接命中缓存"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，速度非常快"}]},{"ID":"20260524142650-4qgma0e","Type":"NodeParagraph","Properties":{"id":"20260524142650-4qgma0e","updated":"20260907141024"},"Children":[{"Type":"NodeText","Data":"其次，连续内存"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"对硬件预取也更友好"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\nCPU 发现你在顺序访问一段地址时，会提前把后面的数据预读进缓存\n但如果内存是链表那样分散跳跃的，CPU 很难预测下一次访问位置，缓存和预取效果都会变差"}]},{"ID":"20260524142650-k7bu21b","Type":"NodeParagraph","Properties":{"id":"20260524142650-k7bu21b","updated":"20260907141031"},"Children":[{"Type":"NodeText","Data":"再就是，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"连续内存减少了指针跳转和页表、TLB 这类地址转换开销"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n数据分散时，访问过程中更容易频繁跳到不同内存页，增加 cache miss 和 TLB miss\n连续存放时，局部性更强，整个访存链路都更顺"}]},{"ID":"20260507210725-f8i4i1t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507210725-f8i4i1t","updated":"20260907141250"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是局部性原理"}]},{"ID":"20260507210725-rnca1go","Type":"NodeParagraph","Properties":{"id":"20260507210725-rnca1go","updated":"20260907141243"},"Children":[{"Type":"NodeText","Data":"指程序运行时对指令和数据的访问，并不是完全随机的，而是呈现出"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"集中扎堆访问"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"的特征"}]},{"ID":"20260507210725-iplj8eo","Type":"NodeParagraph","Properties":{"id":"20260507210725-iplj8eo","updated":"20260907141250"},"Children":[{"Type":"NodeText","Data":"主要分为两类，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"时间局部性"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"和"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"空间局部性"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n时间局部性就是刚访问过的数据和指令，短时间内很可能再次被访问\n空间局部性就是访问某个内存地址后，它相邻的周边地址，接下来大概率也会被用到"}]},{"ID":"20260507210725-8k7y89r","Type":"NodeParagraph","Properties":{"id":"20260507210725-8k7y89r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"正是依靠局部性原理，计算机才能构建 CPU 缓存、内存、磁盘的分级存储体系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把近期常用的数据放在速度更快的缓存里，减少低速存储的访问次数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"极大提升程序整体运行效率"}]},{"ID":"20260505170804-k32xh8w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k32xh8w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"编译器优化等级？\t\t\u003e\u003e"}]},{"ID":"20260505170804-0lbzeef","Type":"NodeParagraph","Properties":{"id":"20260505170804-0lbzeef","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 编译器的优化等级是用于控制代码编译时优化程度、编译速度、调试便利性的参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主流编译器（GCC/Clang/MSVC）都提供了标准化的优化等级"}]},{"ID":"20260505170804-nat53xw","Type":"NodeParagraph","Properties":{"id":"20260505170804-nat53xw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常用等级分为："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-O0（默认无优化）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-O1（基础优化）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-O2（标准优化，生产常用）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-O3（极致性能优化）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-Os（优化体积）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-Ofast（极致速度）"}]},{"ID":"20260505170804-pmwqa8s","Type":"NodeParagraph","Properties":{"id":"20260505170804-pmwqa8s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"设置不同优化等级，是为了平衡开发调试和上线运行的需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开发阶段用 -O0，保留完整调试信息、编译快、方便断点调试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发布阶段用 -O2/O3，编译器会自动做指令重排、函数内联、死代码消除等优化，大幅提升程序运行效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"嵌入式等场景会用 -Os 优先减小可执行文件体积"}]},{"ID":"20260505170804-f7f619k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f7f619k","updated":"20260907141431"},"Children":[{"Type":"NodeText","Data":"编译加速怎么做？\t\t"}]},{"ID":"20260505170804-yrsjflh","Type":"NodeParagraph","Properties":{"id":"20260505170804-yrsjflh","updated":"20260907141345"},"Children":[{"Type":"NodeText","Data":"首先用"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"多线程并行编译"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，比如 make -j、Ninja、MSVC 的 /MP，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"直接利用多核"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，速度提升很明显"}]},{"ID":"20260505170804-zd74phw","Type":"NodeParagraph","Properties":{"id":"20260505170804-zd74phw","updated":"20260907141357"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"然后用 ccache 做编译缓存，配合预编译头 PCH，避免重复编译，增量编译会快很多"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"–预编译头 PCH"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，就是把项目里经常用到、又基本不改的头文件，比如标准库、第三方库的头文件，提前单独编译好\n–编译缓存就是把之前编译过的文件结果存起来。下次代码没改动时，直接用缓存，不用重新编译，大幅加快增量编译速度"}]},{"ID":"20260505170804-x1qg9gb","Type":"NodeParagraph","Properties":{"id":"20260505170804-x1qg9gb","updated":"20260907141413"},"Children":[{"Type":"NodeText","Data":"代码层面也会优化:\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"减少头文件依赖，多用前置声明，拆分大模块"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n避免一处修改导致大量文件重新编译，减少不必要的编译开销\n开发时也会用低优化等级快速编译，只在发布时开高优化，兼顾效率和性能"}]},{"ID":"20260505170804-3l0l6wa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3l0l6wa","updated":"20260907141434"},"Children":[{"Type":"NodeText","Data":"CPU 三级缓存？\t\t"}]},{"ID":"20260505170804-6npjczw","Type":"NodeParagraph","Properties":{"id":"20260505170804-6npjczw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CPU 三级缓存，就是 CPU 内部的三层高速缓存，分别是 L1、L2、L3"}]},{"ID":"20260505170804-5ilo7ip","Type":"NodeParagraph","Properties":{"id":"20260505170804-5ilo7ip","updated":"20260506171414"},"Children":[{"Type":"NodeText","Data":"L1 最小最快，每个核心独有，用来存最常用的指令和数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"L2 也是核心独占，容量比 L1 大、速度稍慢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作为 L1 的缓冲兜底，存放当前核心常用的一批数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"L3 是所有核心共享，容量最大、速度最慢，但依然比内存快很多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的作用就是减少 CPU 访问内存的次数，缓解 CPU 运算快、内存读写慢的速度差距，从而大幅提升程序运行效率"}]},{"ID":"20260505170804-jcwmrh8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jcwmrh8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何在编译链接时减小包大小\t\t\u003e\u003e"}]},{"ID":"20260505170804-gonfs96","Type":"NodeParagraph","Properties":{"id":"20260505170804-gonfs96","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编译去掉 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"-g"},{"Type":"NodeText","Data":" 调试信息，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"strip"},{"Type":"NodeText","Data":" 剔除符号表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开启 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"-Os"},{"Type":"NodeText","Data":" 优化体积"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时打开 LTO 链接时优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让编译器删掉无用函数和冗余代码"}]},{"ID":"20260505170804-ixejsmb","Type":"NodeParagraph","Properties":{"id":"20260505170804-ixejsmb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"尽量动态链接依赖库，不把库代码打包进程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再避免模板、宏造成的代码膨胀，最终体积就能明显减小"}]},{"ID":"20260505170804-udz1rau","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-udz1rau","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何优化程序最终的执行时间\t\t\u003e\u003e"}]},{"ID":"20260505170804-w2olmjf","Type":"NodeParagraph","Properties":{"id":"20260505170804-w2olmjf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"想优化程序最终执行时间，首先从编译层面入手，开启 O2 或 O3 优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让编译器做指令重排、循环展开、常量传播这类优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时打开 LTO 链接时优化，做跨函数全局优化，提升指令效率"}]},{"ID":"20260505170804-crdxpo7","Type":"NodeParagraph","Properties":{"id":"20260505170804-crdxpo7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后是算法与数据结构层面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把低效算法替换成更优的，比如把暴力查找换成哈希查找，减少时间复杂度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时减少内存拷贝、避免频繁创建销毁对象，降低不必要开销"}]},{"ID":"20260505170804-n1h0nyi","Type":"NodeParagraph","Properties":{"id":"20260505170804-n1h0nyi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"再就是缓存友好优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量让数据连续访问，提高 CPU 缓存命中率，减少内存等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程并行化计算，利用多核 CPU，把耗时逻辑异步化，也能显著加快执行速度"}]},{"ID":"20260505170804-dk37hvy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dk37hvy","updated":"20260907141830"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"代码编译的四个过程，每个阶段做了哪些事生成了什么文件"}]},{"ID":"20260505170804-j40jyb1","Type":"NodeParagraph","Propertie