odeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"析构：对象销毁时调用，释放资源，不可重载、无参无返回值。"}]}]},{"ID":"20260505170804-g1ei0y3","Type":"NodeListItem","Data":"10.","ListData":{"Typ":1,"Tight":true,"Start":10,"Delimiter":46,"Padding":4,"Marker":"MTAu","Num":10},"Properties":{"id":"20260505170804-g1ei0y3","updated":"20260505170804"},"Children":[{"ID":"20260505170804-s535bzr","Type":"NodeParagraph","Properties":{"id":"20260505170804-s535bzr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"子类父类构造 / 析构调用顺序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"构造：先父类构造 → 再子类成员初始化 → 最后子类构造。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"析构：先子类析构 → 再子类成员销毁 → 最后父类析构。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（多态中父类析构函数必须是虚函数，否则子类析构不调用）"}]}]},{"ID":"20260505170804-6zkrc7o","Type":"NodeListItem","Data":"11.","ListData":{"Typ":1,"Tight":true,"Start":11,"Delimiter":46,"Padding":4,"Marker":"MTEu","Num":11},"Properties":{"id":"20260505170804-6zkrc7o","updated":"20260505170804"},"Children":[{"ID":"20260505170804-1idig8b","Type":"NodeParagraph","Properties":{"id":"20260505170804-1idig8b","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态成员特性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属于类，不属于对象，所有对象共享。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类内声明，类外定义，不占用对象内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可通过类名:: 或对象. 访问。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态函数无 this 指针，只能访问静态成员。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"生命周期：程序整个运行期。"}]}]},{"ID":"20260505170804-fx85hbk","Type":"NodeListItem","Data":"12.","ListData":{"Typ":1,"Tight":true,"Start":12,"Delimiter":46,"Padding":4,"Marker":"MTIu","Num":12},"Properties":{"id":"20260505170804-fx85hbk","updated":"20260505170804"},"Children":[{"ID":"20260505170804-gnruyvx","Type":"NodeParagraph","Properties":{"id":"20260505170804-gnruyvx","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态库 和 动态库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态库（.a/.lib）：编译时链接进可执行文件，运行时无需库，文件大，更新需重新编译。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态库（.so/.dll）：运行时动态加载，多个程序共享，文件小，更新方便。"}]}]},{"ID":"20260505170804-kqlvle9","Type":"NodeListItem","Data":"13.","ListData":{"Typ":1,"Tight":true,"Start":13,"Delimiter":46,"Padding":4,"Marker":"MTMu","Num":13},"Properties":{"id":"20260505170804-kqlvle9","updated":"20260505170804"},"Children":[{"ID":"20260505170804-09z023i","Type":"NodeParagraph","Properties":{"id":"20260505170804-09z023i","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C 和 C++ 主要区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C 是面向过程；C++ 是面向对象。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 支持封装、继承、多态。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 有引用、重载、模板、异常、STL。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 更严格类型安全。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 内存管理更强大（new/delete、智能指针）。"}]}]},{"ID":"20260505170804-4cf0zhi","Type":"NodeListItem","Data":"14.","ListData":{"Typ":1,"Tight":true,"Start":14,"Delimiter":46,"Padding":4,"Marker":"MTQu","Num":14},"Properties":{"id":"20260505170804-4cf0zhi","updated":"20260505170804"},"Children":[{"ID":"20260505170804-ug38r12","Type":"NodeParagraph","Properties":{"id":"20260505170804-ug38r12","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"const 作用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修饰变量：变量只读，不可修改。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修饰函数参数：防止函数内修改参数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修饰成员函数：承诺不修改成员变量，只能调用 const 成员函数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修饰返回值：限制返回值修改。"}]}]},{"ID":"20260505170804-hxy82zd","Type":"NodeListItem","Data":"15.","ListData":{"Typ":1,"Tight":true,"Start":15,"Delimiter":46,"Padding":4,"Marker":"MTUu","Num":15},"Properties":{"id":"20260505170804-hxy82zd","updated":"20260505170804"},"Children":[{"ID":"20260505170804-jktj3qw","Type":"NodeParagraph","Properties":{"id":"20260505170804-jktj3qw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"指针 和 引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针是实体变量；引用是别名。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针可空；引用必须初始化，不能为空。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针可修改指向；引用一旦绑定不可更改。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针有多级；引用只有一级。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针需解引用；引用直接使用。"}]}]},{"ID":"20260505170804-ia3bmte","Type":"NodeListItem","Data":"16.","ListData":{"Typ":1,"Tight":true,"Start":16,"Delimiter":46,"Padding":4,"Marker":"MTYu","Num":16},"Properties":{"id":"20260505170804-ia3bmte","updated":"20260505170804"},"Children":[{"ID":"20260505170804-2mrg91h","Type":"NodeParagraph","Properties":{"id":"20260505170804-2mrg91h","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存泄漏 和 内存溢出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存泄漏：动态申请内存未释放，长期占用导致可用内存减少。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存溢出：申请内存时，剩余内存不足，无法分配。"}]}]},{"ID":"20260505170804-s4gl40z","Type":"NodeListItem","Data":"17.","ListData":{"Typ":1,"Tight":true,"Start":17,"Delimiter":46,"Padding":4,"Marker":"MTcu","Num":17},"Properties":{"id":"20260505170804-s4gl40z","updated":"20260505170804"},"Children":[{"ID":"20260505170804-goyher4","Type":"NodeParagraph","Properties":{"id":"20260505170804-goyher4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"STL 容器基本特性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"vector：连续数组，随机访问 O (1)，尾部增删快，中间慢。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"list：双向链表，不支持随机访问，任意位置增删 O (1)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque：双端队列，支持随机访问，头尾增删快。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"set：红黑树，键唯一、有序，查找 O (log n)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"map：红黑树，键值对、键唯一、有序。"}]}]},{"ID":"20260505170804-uetp6oa","Type":"NodeListItem","Data":"18.","ListData":{"Typ":1,"Tight":true,"Start":18,"Delimiter":46,"Padding":4,"Marker":"MTgu","Num":18},"Properties":{"id":"20260505170804-uetp6oa","updated":"20260505170804"},"Children":[{"ID":"20260505170804-j4b8871","Type":"NodeParagraph","Properties":{"id":"20260505170804-j4b8871","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"STL 迭代器种类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输入 / 输出迭代器：单遍读写，如流迭代器。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前向迭代器：单向移动，如 forward_list。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双向迭代器：可前后移动，如 list、map、set。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"随机访问迭代器：支持跳跃访问，如 vector、deque、array。"}]}]},{"ID":"20260505170804-6tvyrld","Type":"NodeListItem","Data":"19.","ListData":{"Typ":1,"Tight":true,"Start":19,"Delimiter":46,"Padding":4,"Marker":"MTku","Num":19},"Properties":{"id":"20260505170804-6tvyrld","updated":"20260505170804"},"Children":[{"ID":"20260505170804-0sz1sf8","Type":"NodeParagraph","Properties":{"id":"20260505170804-0sz1sf8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四种 cast 转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"static_cast：基础类型转换、上行转换（安全）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"dynamic_cast：多态类型转换，下行转换安全，失败返回 nullptr。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const_cast：去掉 const 属性。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"reinterpret_cast：低级强制转换，高危，用于指针 / 整数互转。"}]}]},{"ID":"20260505170804-i0nptga","Type":"NodeListItem","Data":"20.","ListData":{"Typ":1,"Tight":true,"Start":20,"Delimiter":46,"Padding":4,"Marker":"MjAu","Num":20},"Properties":{"id":"20260505170804-i0nptga","updated":"20260505170804"},"Children":[{"ID":"20260505170804-ym56l6h","Type":"NodeParagraph","Properties":{"id":"20260505170804-ym56l6h","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"面向对象三大特性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"封装：隐藏实现，暴露接口，提高安全性。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"继承：复用父类代码，扩展功能。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多态：同一接口不同实现，动态绑定。"}]}]},{"ID":"20260505170804-v9jr7o4","Type":"NodeListItem","Data":"21.","ListData":{"Typ":1,"Tight":true,"Start":21,"Delimiter":46,"Padding":4,"Marker":"MjEu","Num":21},"Properties":{"id":"20260505170804-v9jr7o4","updated":"20260505170804"},"Children":[{"ID":"20260505170804-5saoogy","Type":"NodeParagraph","Properties":{"id":"20260505170804-5saoogy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多态实现原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"含虚函数的类，编译器生成虚函数表 vtable。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象含虚指针 vptr，指向虚表。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调用虚函数时，通过 vptr 查找对应函数地址，动态绑定。"}]}]},{"ID":"20260505170804-4ttwgl6","Type":"NodeListItem","Data":"22.","ListData":{"Typ":1,"Tight":true,"Start":22,"Delimiter":46,"Padding":4,"Marker":"MjIu","Num":22},"Properties":{"id":"20260505170804-4ttwgl6","updated":"20260505170804"},"Children":[{"ID":"20260505170804-rkz4dij","Type":"NodeParagraph","Properties":{"id":"20260505170804-rkz4dij","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚函数 和 纯虚函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚函数：virtual func()，有实现，子类可重写。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"纯虚函数：virtual func()=0，无实现，类为抽象类，子类必须重写。"}]}]},{"ID":"20260505170804-9upq9t1","Type":"NodeListItem","Data":"23.","ListData":{"Typ":1,"Tight":true,"Start":23,"Delimiter":46,"Padding":4,"Marker":"MjMu","Num":23},"Properties":{"id":"20260505170804-9upq9t1","updated":"20260505170804"},"Children":[{"ID":"20260505170804-g15xxnu","Type":"NodeParagraph","Properties":{"id":"20260505170804-g15xxnu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C++11 新特性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"auto：自动类型推导。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"nullptr：安全空指针，替代 NULL。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能指针：shared_ptr/unique_ptr/weak_ptr，自动管理内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lambda 表达式：匿名函数，简化代码。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右值引用、移动语义、范围 for、constexpr 等。"}]}]},{"ID":"20260505170804-kf2t6ah","Type":"NodeListItem","Data":"24.","ListData":{"Typ":1,"Tight":true,"Start":24,"Delimiter":46,"Padding":4,"Marker":"MjQu","Num":24},"Properties":{"id":"20260505170804-kf2t6ah","updated":"20260505170804"},"Children":[{"ID":"20260505170804-3pq2jp8","Type":"NodeParagraph","Properties":{"id":"20260505170804-3pq2jp8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"智能指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"shared_ptr：共享型，引用计数，计数为 0 释放内存，线程安全计数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"unique_ptr：独占型，同一时间只有一个指针拥有对象，高效。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"weak_ptr：辅助 shared_ptr，不增加计数，解决循环引用问题。"}]}]},{"ID":"20260505170804-tf18v3t","Type":"NodeListItem","Data":"25.","ListData":{"Typ":1,"Tight":true,"Start":25,"Delimiter":46,"Padding":4,"Marker":"MjUu","Num":25},"Properties":{"id":"20260505170804-tf18v3t","updated":"20260505170804"},"Children":[{"ID":"20260505170804-kfqnv9i","Type":"NodeParagraph","Properties":{"id":"20260505170804-kfqnv9i","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"深拷贝 和 浅拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浅拷贝：简单赋值拷贝，指针共享同一块内存，析构重复释放崩溃。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"深拷贝：重新分配内存，拷贝内容，指针独立，避免冲突。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现：重载拷贝构造 + 赋值运算符，手动申请内存复制数据。"}]}]}]},{"ID":"20260505170804-1g82hc1","Type":"NodeParagraph","Properties":{"id":"20260505170804-1g82hc1","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"(补充高频考点)"}]},{"ID":"20260505170804-s4lgbjn","Type":"NodeParagraph","Properties":{"id":"20260505170804-s4lgbjn","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"\\26. [高频] 什么是内存对齐？为什么需要内存对齐？"}]},{"ID":"20260505170804-y2rvbqu","Type":"NodeParagraph","Properties":{"id":"20260505170804-y2rvbqu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存对齐：是编译器为了让 CPU 高效访问数据，将变量在内存中按指定对齐规则（如 2/4/8 字节）存放，不足则填充空白字节的机制。为什么需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提高 CPU 访问效率：CPU 按字长读取数据，对齐后一次读取完成，未对齐需多次读取 + 拼接，效率极低。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平台兼容性：部分硬件架构（ARM、嵌入式）不支持非对齐访问，直接报错崩溃。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 CPU 硬件设计的硬性要求，编译器默认自动开启。"}]},{"ID":"20260505170804-p5jtjqm","Type":"NodeParagraph","Properties":{"id":"20260505170804-p5jtjqm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"\\27. [高频] 野指针的产生原因及如何避免？"}]},{"ID":"20260505170804-86evtu0","Type":"NodeParagraph","Properties":{"id":"20260505170804-86evtu0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"野指针就是指向"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"非法内存"},{"Type":"NodeText","Data":"的指针，主要由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未初始化、释放后未置空、越界访问"},{"Type":"NodeText","Data":"造成。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免方法："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"初始化指针、释放后置空、多用智能指针、不越界"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-e6vzjg1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e6vzjg1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进阶 (15 + 项)"}]},{"ID":"20260505170804-m454m84","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-m454m84","updated":"20260505170804"},"Children":[{"ID":"20260505170804-5m4h0f9","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-5m4h0f9","updated":"20260505170804"},"Children":[{"ID":"20260505170804-cr0t8km","Type":"NodeParagraph","Properties":{"id":"20260505170804-cr0t8km","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单例模式："},{"Type":"NodeText","Data":"饿汉式、懒汉式、线程安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试回答：单例模式确保一个类只有一个实例，并提供全局访问点。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"饿汉式：类加载时就创建实例，天生线程安全，但可能提前占用资源。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"懒汉式：第一次使用时才创建，非线程安全，高并发下会创建多个实例。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程安全实现："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"懒汉式 + 互斥锁（效率低）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双检锁 DCL（Double-Check Locking）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++11 magic static（最推荐），局部静态变量由编译器保证线程安全。"}]}]},{"ID":"20260505170804-iy3lyln","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-iy3lyln","updated":"20260505170804"},"Children":[{"ID":"20260505170804-1oe5zjc","Type":"NodeParagraph","Properties":{"id":"20260505170804-1oe5zjc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工厂模式三类 \u0026 区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试回答："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单工厂：一个工厂生产所有产品，违反开闭原则。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工厂方法：一个产品对应一个工厂，符合开闭原则，但工厂类爆炸。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抽象工厂：一个工厂生产一系列相关产品，用于多产品族场景。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一句话区别：简单工厂 = 一个工厂；工厂方法 = 一个产品一个工厂；抽象工厂 = 一个工厂生产一族产品。"}]}]},{"ID":"20260505170804-gibc51a","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-gibc51a","updated":"20260505170804"},"Children":[{"ID":"20260505170804-wn4gb0s","Type":"NodeParagraph","Properties":{"id":"20260505170804-wn4gb0s","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"观察者模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原理：一对多依赖，当主题对象状态变化，所有依赖它的观察者自动收到通知并更新。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用场景：消息推送、事件监听、UI 刷新、发布订阅系统、日志监控。"}]}]},{"ID":"20260505170804-bpz1ei7","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-bpz1ei7","updated":"20260505170804"},"Children":[{"ID":"20260505170804-dkpkqjd","Type":"NodeParagraph","Properties":{"id":"20260505170804-dkpkqjd","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"策略模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用场景：需要动态切换算法 / 策略，且算法之间相互独立。例如：支付方式切换、排序策略切换、压缩算法选择、促销规则。"}]}]},{"ID":"20260505170804-fsk6qny","Type":"NodeListItem","Data":"5.","ListData":{"Typ":1,"Tight":true,"Start":5,"Delimiter":46,"Padding":3,"Marker":"NS4=","Num":5},"Properties":{"id":"20260505170804-fsk6qny","updated":"20260505170804"},"Children":[{"ID":"20260505170804-9kqg971","Type":"NodeParagraph","Properties":{"id":"20260505170804-9kqg971","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"装饰器模式 vs 代理模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试回答："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"装饰器：增强功能，关注对象功能扩展，可嵌套叠加。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代理：控制访问，隐藏对象、权限控制、延迟加载，不增强功能。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心区别：目的不同装饰 = 增强；代理 = 控制 / 隔离。"}]}]},{"ID":"20260505170804-ojx3t4b","Type":"NodeListItem","Data":"6.","ListData":{"Typ":1,"Tight":true,"Start":6,"Delimiter":46,"Padding":3,"Marker":"Ni4=","Num":6},"Properties":{"id":"20260505170804-ojx3t4b","updated":"20260505170804"},"Children":[{"ID":"20260505170804-e6n7hln","Type":"NodeParagraph","Properties":{"id":"20260505170804-e6n7hln","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单例线程安全优化 \u0026 破坏单例场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全优化："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++11 静态局部变量（最简洁安全）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双检锁 + 原子指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"破坏单例场景："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反射创建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"序列化 / 反序列化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拷贝构造 / 赋值重载未删除"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多进程环境"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防护：删除拷贝构造、赋值重载；防止反射；序列化时还原单例。"}]}]},{"ID":"20260505170804-w8dfhl0","Type":"NodeListItem","Data":"7.","ListData":{"Typ":1,"Tight":true,"Start":7,"Delimiter":46,"Padding":3,"Marker":"Ny4=","Num":7},"Properties":{"id":"20260505170804-w8dfhl0","updated":"20260505170804"},"Children":[{"ID":"20260505170804-cnel8g8","Type":"NodeParagraph","Properties":{"id":"20260505170804-cnel8g8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单例 + 工厂 组合使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"场景：工厂类只需要一个实例，避免重复创建工厂消耗资源。用法：让工厂类变成单例，对外提供唯一工厂实例，统一创建产品。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二、内存 / 性能 / 底层（8~9）"}]}]},{"ID":"20260505170804-ytrpqxr","Type":"NodeListItem","Data":"8.","ListData":{"Typ":1,"Tight":true,"Start":8,"Delimiter":46,"Padding":3,"Marker":"OC4=","Num":8},"Properties":{"id":"20260505170804-ytrpqxr","updated":"20260505170804"},"Children":[{"ID":"20260505170804-npj97tv","Type":"NodeParagraph","Properties":{"id":"20260505170804-npj97tv","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存池原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原理：预先申请一大块内存，分成固定大小块，避免频繁 malloc/new 产生内存碎片、提升分配速度。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：预先分配 → 链表管理空闲块 → 按需分配 → 批量释放。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适用：高频创建销毁小对象（如网络连接、消息包、游戏对象）。"}]}]},{"ID":"20260505170804-vono281","Type":"NodeListItem","Data":"9.","ListData":{"Typ":1,"Tight":true,"Start":9,"Delimiter":46,"Padding":3,"Marker":"OS4=","Num":9},"Properties":{"id":"20260505170804-vono281","updated":"20260505170804"},"Children":[{"ID":"20260505170804-955q1ij","Type":"NodeParagraph","Properties":{"id":"20260505170804-955q1ij","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存泄漏检测（valgrind）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试回答："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"valgrind --leak-check=full ./ 程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以定位：泄漏位置、泄漏大小、未释放的堆内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其他方法：智能指针、内存钩子、内存日志、ASAN 地址消毒器。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三、并发编程（10~16）"}]}]},{"ID":"20260505170804-0pdhg8r","Type":"NodeListItem","Data":"10.","ListData":{"Typ":1,"Tight":true,"Start":10,"Delimiter":46,"Padding":4,"Marker":"MTAu","Num":10},"Properties":{"id":"20260505170804-0pdhg8r","updated":"20260505170804"},"Children":[{"ID":"20260505170804-imi9a46","Type":"NodeParagraph","Properties":{"id":"20260505170804-imi9a46","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程同步方法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试回答："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"互斥锁 mutex：独占访问，保护临界区。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"条件变量 condition_variable：等待 / 唤醒，实现生产者消费者。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号量 semaphore：控制同时访问的线程数量。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自旋锁、读写锁、原子变量。"}]}]},{"ID":"20260505170804-m8huooi","Type":"NodeL