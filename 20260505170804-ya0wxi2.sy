b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"链接"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n合并多个目标文件、链接库文件，解决函数地址引用，最终生成 可执行文件"}]},{"ID":"20260505170804-a9tyxv3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a9tyxv3","updated":"20260907142518"},"Children":[{"Type":"NodeText","Data":"内存不足的原因及应对策略\t\t"}]},{"ID":"20260505170804-r5fwzq7","Type":"NodeParagraph","Properties":{"id":"20260505170804-r5fwzq7","updated":"20260907142419"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原因"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"内存泄漏，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"申请的内存没释放，越用越多\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"一次性加载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"过大数据，比如大文件、大集合直接全载入内存\