D":"20260505170804-66pgg80","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-66pgg80","updated":"20260907153848"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"static 是线程安全的吗"}]},{"ID":"20260505170804-tr61ypt","Type":"NodeParagraph","Properties":{"id":"20260505170804-tr61ypt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局 static、类静态成员 static："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程同时读写会有数据竞争，不加锁、不用 atomic 就会出错"}]},{"ID":"20260505170804-7pcfjsn","Type":"NodeParagraph","Properties":{"id":"20260505170804-7pcfjsn","updated":"20260907153848"},"Children":[{"Type":"NodeText","Data":"最特殊的是函"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"数局部 static"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：\nC++11 后编译器自动加了线程初始化保护，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只保证初始化一次是线程安全"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n但后续多线程读写依然不安全"}]},{"ID":"20260505170804-oc3pwxr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-oc3pwxr","updated":"20260506170226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"memcpy 和 strcpy 什么区别"}]},{"ID":"20260505170804-87huwdz","Type":"NodeParagraph","Properties":{"id":"20260505170804-87huwdz","updated":"20260506170222"},"Children":[{"Type":"NodeText","Data":"memcpy：用于内存块拷贝，可以拷贝任意类型的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需指定拷贝的字节数，适用于二进制数据"}]},{"ID":"20260506170225-v88jebb","Type":"NodeParagraph","Properties":{"id":"20260506170225-v88jebb","updated":"20260506170226"},"Children":[{"Type":"NodeText","Data":"strcpy：用于拷贝字符串，拷贝直到遇到 \\0 结束符，适用于字符串拷贝"}]},{"ID":"20260505170804-xyhwl31","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xyhwl31","updated":"20260907153946"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"memcpy 与 memmove，strcpy"}]},{"ID":"20260505170804-zmoi2wa","Type":"NodeParagraph","Properties":{"id":"20260505170804-zmoi2wa","updated":"20260907153940"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"strcpy"},{"Type":"NodeText","Data":"\n专门用来拷贝字符串，只处理字符类型，遇到 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"'\\0'"},{"Type":"NodeText","Data":" 就停止\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"它不检查内存重叠，也限制只能拷字符串，缓冲区容易溢出，安全性差"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260506170231-jjrg0sg","Type":"NodeParagraph","Properties":{"id":"20260506170231-jjrg0sg","updated":"20260907153946"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"memcpy"},{"Type":"NodeText","Data":"\n通用内存拷贝，能拷贝任意类型数据，按字节复制，长度由参数指定\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"不支持内存重叠，如果源地址和目标地址重叠，拷贝结果会出错，效率更高"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260506170235-ikoekty","Type":"NodeParagraph","Properties":{"id":"20260506170235-ikoekty","updated":"20260506170237"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"memmove"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同样是字节级通用内存拷贝，核心区别是支持内存重叠"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部会先判断地址位置，重叠时先临时缓存数据再拷贝，保证结果正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比 memcpy，会多一点性能开销"}]},{"ID":"20260505170804-hk3dfbn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hk3dfbn","updated":"20260907153915"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"explicit 的作用是什么？"}]},{"ID":"20260505170804-dhzg7gv","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-dhzg7gv","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"explicit CTest(int a,int b=30):m_a(a){} \n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-69p0bre","Type":"NodeParagraph","Properties":{"id":"20260505170804-69p0bre","updated":"20260506182525"},"Children":[{"Type":"NodeText","Data":"explicit 是 C++ 中用于修饰单参数构造函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（除了第一个参数外其余都有默认值的构造函数）的关键字"}]},{"ID":"20260505170804-y2qzmnh","Type":"NodeParagraph","Properties":{"id":"20260505170804-y2qzmnh","updated":"20260907153915"},"Children":[{"Type":"NodeText","Data":"作用：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"禁止隐式自动类型转换，只允许显式调用构造函数"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n避免因为编译器自动隐式转换，导致逻辑错误、代码可读性下降"}]},{"ID":"20260505170804-jkt2fh2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jkt2fh2","updated":"20260506182645"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"sizeof 和 strlen 的区别是什么？"}]},{"ID":"20260505170804-ygv41r8","Type":"NodeParagraph","Properties":{"id":"20260505170804-ygv41r8","updated":"20260506182645"},"Children":[{"Type":"NodeText","Data":"strlen 是头文件中的函数，sizeof 是 C++ 中的运算符"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"strlen 测量的是字符串的实际长度，以 \\0 结束"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 sizeof 测量的是字符数组的分配大小"}]},{"ID":"20260505170804-lxalf0b","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lxalf0b","updated":"20260907154011"},"Children":[{"Type":"NodeText","Data":"memcpy 的底层原理       "}]},{"ID":"20260505170804-xuzlk8l","Type":"NodeParagraph","Properties":{"id":"20260505170804-xuzlk8l","updated":"20260907153927"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"直接操作内存块的二进制数据"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n它会从源地址开始，逐个字节或者按更大的块把数据复制到目标地址\n直到复制完指定的字节数"}]},{"ID":"20260505170804-9onkiy8","Type":"NodeParagraph","Properties":{"id":"20260505170804-9onkiy8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实际实现里会做很多优化，比如对地址对齐的内存，用 4 字节、8 字节这样的大单位批量复制，比单字节循环快很多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对没对齐的部分，就先用单字节处理到对齐位置，再用块复制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个过程完全不关心数据类型，就是纯粹按字节搬运，所以复制后目标内存和源内存的二进制内容完全一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但不会处理字符串结束符这类特殊情况，而且要注意它不支持内存重叠的场景，重叠的话要用 memmove"}]},{"ID":"20260505170804-ila3v4y","Type":"NodeParagraph","Properties":{"id":"20260505170804-ila3v4y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存重叠指的是源内存区域和目标内存区域，有一部分地址是重合、交叉的"}]},{"ID":"20260505170804-mmpovzs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mmpovzs","updated":"20260907154630"},"Children":[{"Type":"NodeText","Data":"内存对齐\t"}]},{"ID":"20260505170804-89uzusa","Type":"NodeParagraph","Properties":{"id":"20260505170804-89uzusa","updated":"20260907154630"},"Children":[{"Type":"NodeText","Data":"就是让变量按规则放在合适的内存地址上，让 CPU 读得更快、不出错\nCPU 读内存是一块一块读的，不是一个字节一个字节读\n数据对齐，放在块的开头，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"CPU 一次就能读完"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n数据没对齐，跨在两块之间，CPU 要读两次再拼接，效率很低\n有些硬件必须对齐，否则直接报错，同时也能保证跨平台、网络传输时数据结构不乱"}]},{"ID":"20260505170804-6b839kd","Type":"NodeParagraph","Properties":{"id":"20260505170804-6b839kd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"struct 对齐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个成员自身对齐：按自己类型的大小放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体对齐：整个结构体总大小，必须是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最大成员大小"},{"Type":"NodeText","Data":"的整数倍，不够就补空字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体大小是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最大成员"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"默认对齐数"},{"Type":"NodeText","Data":"里较小那个的倍数"}]},{"ID":"20260505170804-gn1rz4m","Type":"NodeParagraph","Properties":{"id":"20260505170804-gn1rz4m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"union 对齐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有成员共用同一块内存，只能同时存一个。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大小 = 最大成员的大小，且必须是所有成员中最大对齐数的整数倍"}]},{"ID":"20260505170804-1y1khl5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1y1khl5","updated":"20260907154714"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 函数调用的压栈过程"}]},{"ID":"20260505170804-jv1lfd4","Type":"NodeParagraph","Properties":{"id":"20260505170804-jv1lfd4","updated":"20260907154714"},"Children":[{"Type":"NodeText","Data":"从右向左依次压入"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"函数参数"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n压入"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"返回地址"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n压入"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"调用者栈底指针 EBP（当前函数的栈底位置）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"进入被调用函数，建立新栈帧，将当前栈顶指针 ESP 赋值给 EBP"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，局部变量在栈上分配\n函数执行完，恢复栈指针、弹出栈帧，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"按返回地址回到原位置"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-49pzazc","Type":"NodeParagraph","Properties":{"id":"20260505170804-49pzazc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么是这个顺序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让被调用函数能方便找到参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让函数退出时能完美恢复现场，不乱栈"}]},{"ID":"20260505170804-dpn0rpd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dpn0rpd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"栈帧的概念和作用"}]},{"ID":"20260505170804-tose93s","Type":"NodeParagraph","Properties":{"id":"20260505170804-tose93s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"栈帧就是每调用一个函数，系统就给它单独开辟的一块栈空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个函数都有自己独立的栈帧，用来"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"存放函数调用信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多个函数嵌套调用，就会形成一叠栈帧，叫函数调用栈"}]},{"ID":"20260505170804-uk7uqdb","Type":"NodeParagraph","Properties":{"id":"20260505170804-uk7uqdb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"作用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存放函数参数、局部变量、临时数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保存返回地址，让函数知道执行完回到哪里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保存上一层栈底指针，方便函数返回后恢复现场"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让多层函数调用不乱套，各自用各自的空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数结束自动释放空间，不占内存"}]},{"ID":"20260505170804-yhm9zua","Type":"NodeParagraph","Properties":{"id":"20260505170804-yhm9zua","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"EBP 栈底指针：固定不动，作为基准，方便函数查找参数、变量和返回地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ESP 栈顶指针：动态变化，指向栈顶，用于分配和释放栈空间"}]},{"ID":"20260505170804-1jvqexs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1jvqexs","updated":"20260907155349"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"临时对象在什么时候产生"}]},{"ID":"20260505170804-husj3yz","Type":"NodeParagraph","Properties":{"id":"20260505170804-husj3yz","updated":"20260907155349"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"返回值优化"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：函数返回对象时，优化后直接构造到目标变量，省去拷贝 / 移动\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"隐式类型转换"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：类型不匹配时，编译器会生成临时对象完成转换\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"运算符重载"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：返回运算结果时，通常会产生临时对象\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"按值传递 / 返回"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：传值、返回值会触发拷贝，生成临时对象\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"const 引用延长临时对象生命周期"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"：临时对象绑定到 const 引用，生命周期会延长"}]},{"ID":"20260505170804-jqxwvxc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jqxwvxc","updated":"20260907155556"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"类中变量初始化顺序和销毁顺序"}]},{"ID":"20260505170804-bnysj6c","Type":"NodeParagraph","Properties":{"id":"20260505170804-bnysj6c","updated":"20260907155553"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"先父后子"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"，"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"先静态后实例"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n首先加载父类静态成员并完成初始化，再执行子类静态成员初始化\n静态内容只在类加载时执行一次\n之后初始化父类普通成员变量，再调用父类构造方法\n最后依次初始化子类普通成员变量、执行子类构造方法，完成整体创建"}]},{"ID":"20260505170804-56j1rzr","Type":"NodeParagraph","Properties":{"id":"20260505170804-56j1rzr","updated":"20260907155556"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"销毁顺序和初始化完全相反"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n对象回收时，会先执行子类的销毁逻辑、释放子类成员资源，再销毁子类成员变量\n最后释放父类成员并执行父类析构逻辑"}]},{"ID":"20260505170804-yhu7ei3","Type":"NodeParagraph","Properties":{"id":"20260505170804-yhu7ei3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这样的顺序可以保证子类依赖父类资源时，创建时资源先就绪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"销毁时不会出现父类资源提前释放导致子类异常的问题，保证继承体系资源管理的安全性"}]},{"ID":"20260505170804-ly8u521","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ly8u521","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是内部类?"}]},{"ID":"20260505170804-f3wp0dr","Type":"NodeParagraph","Properties":{"id":"20260505170804-f3wp0dr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果一个类 B 定义在另一个类 A 的内部, 这个类 B 就叫做内部类。类 A 叫外部类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性质"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部类是独立的, 不属于外部类, 更不能通过外部类的对象去调用内部类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部类就是外部类的友元类, 内部类可以通过外部类的对象来访问外部类中的所有成员"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外部类不是内部类的友元"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"}]},{"ID":"20260505170804-32qg8pg","Type":"NodeParagraph","Properties":{"id":"20260505170804-32qg8pg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内部类可以定义在外部类的 public、protected、private 都是可以的。 如果内部类定义在 public, 则可通过 外部类名::内部类名 来定义内部类的对象。 2. 内部类可以直接访问外部类中的 static、枚举成员, 不需要外部类的对象/类名。 3. 内部类可以在外部类类外定义 4. sizeof(外部类)=外部类, 和内部类没有任何关系 5. 定义堆区内部类对象的方法 outer::inner * pi = new outer::inner;"}]},{"ID":"20260505170804-50tqjwu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-50tqjwu","updated":"20260907155731"},"Children":[{"Type":"NodeText","Data":"重写、重载、隐藏的区别\t\t"}]},{"ID":"20260505170804-liova3w","Type":"NodeParagraph","Properties":{"id":"20260505170804-liova3w","updated":"20260506183206"},"Children":[{"Type":"NodeText","Data":"重载：同一个类里同名不同参的函数，是编译期多态，作用域相同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重写：子类改父类的虚函数，函数名、参数一模一样，是运行时多态，作用域不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"隐藏：子类定义了和父类同名的普通函数（无 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"virtual"},{"Type":"NodeText","Data":"​），只会隐藏父类所有同名函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不构成多态，作用域不同"}]},{"ID":"20260524124152-15w4mta","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524124152-15w4mta","updated":"20260907155745"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"函数重载重载的是什么东西"}]},{"ID":"20260524124153-n3zgz82","Type":"NodeParagraph","Properties":{"id":"20260524124153-n3zgz82","updated":"20260907155745"},"Children":[{"Type":"NodeText","Data":"重载的本质不是函数实现，也不是返回值，而是同一个函数名下面的参数列表\n也就是参数个数、类型或者顺序不同\n编译器在编译阶段会根据调用时传入的实参，去匹配最合适的那个函数版本\n所以它本质上是一种"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"编译期的多态"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-ovzlacw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ovzlacw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"编译器如何实现重载"}]},{"ID":"20260505170804-c5va21n","Type":"NodeParagraph","Properties":{"id":"20260505170804-c5va21n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编译器实现重载靠的是名字修饰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会把 函数名 + 参数类型 + 参数个数 一起编码，生成一个独一无二的符号名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如两个同名函数：func(int) 和 func(double)编译器会把它们改成不同的名字，让链接器能区分开"}]},{"ID":"20260505170804-bos10he","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bos10he","updated":"20260907155821"},"Children":[{"Type":"NodeText","Data":"委托构造\t\t\t"}]},{"ID":"20260505170804-1kmkrzo","Type":"NodeParagraph","Properties":{"id":"20260505170804-1kmkrzo","updated":"20260907155819"},"Children":[{"Type":"NodeText","Data":"C++ 委托构造是 C++11 引入的特性\n允许一个"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"构造函数调用同一个类中的另一个构造函数"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n核心作用是简化代码、避免构造逻辑重复，让多个重载构造函数可以复用核心初始化逻辑"}]},{"ID":"20260505170804-7kdzn7v","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-7kdzn7v","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class Person {\npublic:\n    // 目标构造函数（被委托的）\n    Person(int age, string name) {\n        this-\u003eage = age;\n        this-\u003ename = name;\n        cout \u003c\u003c \"全参构造被调用\" \u003c\u003c endl;\n    }\n    // 委托构造：委托给上面的全参构造\n    Person() : Person(0, \"unknown\") {\n        cout \u003c\u003c \"无参构造（委托）被调用\" \u003c\u003c endl;\n    }\n    // 委托构造：只传年龄\n    Person(int age) : Person(age, \"noname\") {\n        cout \u003c\u003c \"单参构造（委托）被调用\" \u003c\u003c endl;\n    }\n    void show() {\n        cout \u003c\u003c name \u003c\u003c \" : \" \u003c\u003c age \u003c\u003c endl;\n    }\nprivate:\n    int age;\n    string name;\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-rcc6wa6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rcc6wa6","updated":"20260907155830"},"Children":[{"Type":"NodeText","Data":"如何判断结构体是否相等？\t"}]},{"ID":"20260505170804-oq9r47y","Type":"NodeParagraph","Properties":{"id":"20260505170804-oq9r47y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"需要重载操作符==判断两个结构体是否相等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不能用函数 memcmp 来判断两个结构体是否相等，因为 memcmp 函数是逐个字节进行比较的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而结构体存在内存空间中保存时存在字节对齐，字节对齐时补的字节内容是随机的，会产生垃圾值，所以无法比较"}]},{"ID":"20260505170804-1wirnyd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-1wirnyd","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"struct A\n{\n    char c;\n    int val;\n    A(char c_tmp, int tmp) : c(c_tmp), val(tmp) {}\n\n    friend bool operator==(const A \u0026tmp1, const A \u0026tmp2); // 友元运算符重载函数\n};\n\nbool operator==(const A \u0026tmp1, const A \u0026tmp2)\n{\n    return (tmp1.c == tmp2.c \u0026\u0026 tmp1.val == tmp2.val);\n}\n\nint main()\n{\n    A ex1('a', 90), ex2('b', 80);\n    if (ex1 == ex2)\n        cout \u003c\u003c \"ex1 == ex2\" \u003c\u003c endl;\n    else\n        cout \u003c\u003c \"ex1 != ex2\" \u003c\u003c endl; // 输出\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-agaf5m9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-agaf5m9","updated":"20260907155932"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 的函数对象是什么？跟普通函数的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-nq7cowm","Type":"NodeParagraph","Properties":{"id":"20260505170804-nq7cowm","updated":"20260907155850"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"函数对象是指一个重载了 operator() 的类或结构体实例"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n函数对象可以像普通函数一样被调用，但它们实际上是对象，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"具有状态和行为"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-y8fmizb","Type":"NodeParagraph","Properties":{"id":"20260505170804-y8fmizb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"普通函数与函数对象的区别："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定义方式：普通函数是用 返回类型 函数名(参数) 语法定义的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而函数对象是一个类或结构体，并重载了 operator()"}]},{"ID":"20260505170804-4591pt8","Type":"NodeParagraph","Properties":{"id":"20260505170804-4591pt8","updated":"20260907155932"},"Children":[{"Type":"NodeText","Data":"状态：普通函数无状态，而"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"函数对象可以有内置的状态（成员变量）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n调用方式：普通函数被直接调用，函数对象需要先创建实例，然后用实例调用\n灵活性：函数对象可以重载多个操作符或添加更多功能，普通函数则只能定义一个函数"}]},{"ID":"20260505170804-i3lac83","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-i3lac83","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"//普通函数\nint add(int a, int b) {\n    return a + b;\n}\n//函数对象\nclass Add {\npublic:\n    int operator()(int a, int b) {\n        return a + b;\n    }\n};\n\nAdd add;\nint result = add(2, 3); // 调用函数对象\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-5cwubia","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5cwubia","updated":"20260907173220"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"类继承中父类和子类的内存布局"}]},{"ID":"20260505170804-2k5i98h","Type":"NodeParagraph","Properties":{"id":"20260505170804-2k5i98h","updated":"20260907172836"},"Children":[{"Type":"NodeText","Data":"父类成员在前，子类成员在后\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"有虚函数时先放虚表指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，再按这个顺序排"}]},{"ID":"20260505170804-gh3lq8l","Type":"NodeParagraph","Properties":{"id":"20260505170804-gh3lq8l","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无虚函数的简单继承"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先放父类的所有成员变量再放子类新增的成员变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"父类和子类的成员是连续排列的，父类部分的布局和单独的父类对象是一样的"}]},{"ID":"20260505170804-667uiq9","Type":"NodeParagraph","Properties":{"id":"20260505170804-667uiq9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有虚函数的单继承"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类对象开头先放父类的虚函数表指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后是父类的成员变量，最后是子类新增的成员变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类重写的虚函数会直接替换表里对应位置的函数地址，新增的函数地址会追加到虚表后面"}]},{"ID":"20260505170804-5c4yr4x","Type":"NodeParagraph","Properties":{"id":"20260505170804-5c4yr4x","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多继承"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个父类都按自己的顺序完整出现在子类对象里，顺序和继承声明顺序一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类新增的成员变量放在所有父类部分的后面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当访问不同父类的基地址时，会有偏移调整，编译器会自动处理"}]},{"ID":"20260505170804-1lrc16u","Type":"NodeParagraph","Properties":{"id":"20260505170804-1lrc16u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因为多继承里，多个父类是前后拼在一起的\t假如 A，B 是父类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"A 排在最前面，B 排在 A 的后面，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"B 的内存起点天生就有一段偏移，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以转 B 类指针时，编译器必须自动帮你加上这个偏移，否则指针就指到 A 身上，直接乱套"}]},{"ID":"20260505170804-oigctft","Type":"NodeParagraph","Properties":{"id":"20260505170804-oigctft","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"菱形继承(虚继承)"}]},{"ID":"20260505170804-jkd3kep","Type":"NodeParagraph","Properties":{"id":"20260505170804-jkd3kep","updated":"20260907173220"},"Children":[{"Type":"NodeText","Data":"为了解决重复继承的问题，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"虚基类会被放在对象的尾部\n所有派生类通过虚基类指针间接访问它"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-9dxk4pe","Type":"NodeParagraph","Properties":{"id":"20260505170804-9dxk4pe","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自身偏移"},{"Type":"NodeText","Data":"：修正当前子对象相对于对象首地址的位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚基类偏移"},{"Type":"NodeText","Data":"：记录从当前位置到尾部共享虚基类的距离"}]},{"ID":"20260505170804-n84l82n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-n84l82n","updated":"20260907173531"},"Children":[{"Type":"NodeText","Data":"单继承和多继承的虚函数表结构是怎样的？\t\t"}]},{"ID":"20260505170804-21cjscb","Type":"NodeParagraph","Properties":{"id":"20260505170804-21cjscb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单继承的虚表结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类会直接继承并复用父类的一张虚函数表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果子类没有重写任何虚函数，子类虚表的内容和父类完全一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果子类重写了父类的虚函数，就会在虚表中用子类的函数地址覆盖对应的父类函数地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类新增的虚函数，会直接追加在虚表的末尾"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象内存布局中，只有一个 虚指针 指向这张唯一的虚表"}]},{"ID":"20260505170804-rv4a3rk","Type":"NodeParagraph","Properties":{"id":"20260505170804-rv4a3rk","updated":"20260907173531"},"Children":[{"Type":"NodeText","Data":"多继承的虚函数表结构\n子类会为每一个包含虚函数的父类，分别生成一张独立的虚表\n子类对象中会包含多个虚指针，分别指向各个父类对应的虚表\n如果子类重写了某个父类的虚函数，就在对应的那张虚表中覆盖父类的地址\n如果是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"子类新增的虚函数，只会添加到第一个继承的父类的虚表末尾，不会加到其他虚表里"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-yfli84n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yfli84n","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 多继承支持情况及优缺点"}]},{"ID":"20260505170804-mxzeqzz","Type":"NodeParagraph","Properties":{"id":"20260505170804-mxzeqzz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 是直接支持多继承的，允许一个类从两个或多个父类同时继承"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"语法上就是逗号分隔多个基类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多继承的优点很明显："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码复用性更强，可以把不同功能模块拆成多个基类，子类一次性继承整合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现更灵活的组合，适合需要融合多种能力的场景"}]},{"ID":"20260505170804-f9urylb","Type":"NodeParagraph","Properties":{"id":"20260505170804-f9urylb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但缺点也很突出，最典型的就是菱形继承问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"导致派生类里出现重复的基类成员，引发二义性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时多个父类结构复杂，耦合度高，可读性、维护性变差，还容易出现构造、析构顺序混乱的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际项目里一般会用接口、组合来替代"}]},{"ID":"20260505170804-2asg1ae","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2asg1ae","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"菱形继承\t\t\u003e\u003e"}]},{"ID":"20260505170804-dtnsgxq","Type":"NodeParagraph","Properties":{"id":"20260505170804-dtnsgxq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 中的菱形继承指两个派生类继承同一个基类，又有类同时继承这两个派生类，形成菱形结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会导致最底层子类间接包含两份同一基类的子对象，引发数据冗余和成员访问二义性"}]},{"ID":"20260505170804-ko54xw5","Type":"NodeParagraph","Properties":{"id":"20260505170804-ko54xw5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决该问题的核心方式是使用虚继承，让公共基类成为虚基类，使其在最终对象中仅保留一份实例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器会通过虚基类表指针与虚基类表记录偏移，保证唯一访问路径，从而消除二义性并节省内存"}]},{"ID":"20260505170804-5t71leo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5t71leo","updated":"20260907173605"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚基类表的构成\t\u003e\u003e"}]},{"ID":"20260505170804-1xmsdpd","Type":"NodeParagraph","Properties":{"id":"20260505170804-1xmsdpd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚基类表是 C++ 为支持虚继承而生成的一张偏移量表，它与虚函数表相互独立，主要用于定位共享的虚基类子对象"}]},{"ID":"20260505170804-58jtbjx","Type":"NodeParagraph","Properties":{"id":"20260505170804-58jtbjx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一个使用了虚继承的对象，会在头部包含一个虚基类表指针 vbptr，指向属于该类的虚基类表"}]},{"ID":"20260505170804-1sw6ykf","Type":"NodeParagraph","Properties":{"id":"20260505170804-1sw6ykf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"表中存储的核心内容是各类偏移值，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"包括当前对象起始地址到虚基类表指针的偏移，以及从当前对象到各个虚基类子对象的偏移量"}]},{"ID":"20260505170804-w9f6p4u","Type":"NodeParagraph","Properties":{"id":"20260505170804-w9f6p4u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在菱形继承结构中，如果不使用虚继承，最底层的子类会间接包含两份顶层基类的子对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"引入虚继承后，顶层基类变为虚基类，在最终对象中只会存在一份共享的虚基类子对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此时各个派生类通过自身的虚基类表，利用表中记录的偏移量，都能准确找到这份唯一的虚基类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"依靠虚基类表提供的寻址信息，程序可以唯一、正确地访问基类成员，从而从根本上解决了菱形继承带来的二义性和数据冗余问题"}]},{"ID":"20260505170804-437dyjo","Type":"NodeParagraph","Properties":{"id":"20260505170804-437dyjo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"唯一的那份父类数据，存在最终派生类对象内存的末尾，中间子类不再存放，只通过偏移去查找"}]},{"ID":"20260505170804-t3ghrpw","Type":"NodeParagraph","Properties":{"id":"20260505170804-t3ghrpw","updated":"20260907173605"},"Children":[{"Type":"NodeText","Data":"虚基类表中主要存放两类偏移量：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"一类是虚基类指针 vbptr 到当前所属子类对象起始地址的偏移\n另一类是从当前对象位置到共享虚基类子对象的偏移，通过这些偏移量"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n编译器就能在菱形继承等复杂结构里，精准定位唯一的虚基类，避免数据重复和访问二义性"}]},{"ID":"20260505170804-mixi8x0","Type":"NodeParagraph","Properties":{"id":"20260505170804-mixi8x0","updated":"20260907173601"},"Children":[{"Type":"NodeText","Data":"我在哪儿：这个虚基类指针，距离当前对象最开头有多远\n虚基类在哪儿：从当前位置出发，往内存里走多少字节，能找到那个唯一共享的虚基类\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"自身偏移"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"：修正当前子对象相对于对象首地址的位置；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"虚基类偏移"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"：记录从当前位置到尾部共享虚基类的距离；"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n依靠两个偏移量，间接访问唯一一份虚基类，解决菱形继承数据冗余。"}]},{"ID":"20260505170804-tpk6n9j","Type":"NodeParagraph","Properties":{"id":"20260505170804-tpk6n9j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"假设只留 1 个偏移，会发生什么？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"你只能存一种距离："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要么只存「我到开头的距离」→ 找不到末尾的虚基类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要么只存「我到虚基类的距离」→ 指针向上转型时，无法修正自身地址，崩溃"}]},{"ID":"20260505170804-7qk40u8","Type":"NodeParagraph","Properties":{"id":"20260505170804-7qk40u8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先看表：vbptr 在我这个子对象偏移多少？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"→ 找到虚基类指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再看表：从我的子对象开头走多少到 A？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"→ 直接跳到唯一的虚基类"}]},{"ID":"20260505170804-htcu3zx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-htcu3zx","updated":"20260907173856"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果空类有继承，父类还会占用一个字节吗?"}]},{"ID":"20260505170804-tst4r47","Type":"NodeParagraph","Properties":{"id":"20260505170804-tst4r47","updated":"20260907173856"},"Children":[{"Type":"NodeText","Data":"不会\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"C++ 中空基类会触发空基类优化（EBO）"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n编译器会优化掉父类原本需要占用的 1 字节空间，子类对象大小不会因为继承空类而增加\n只有当空类作为成员变量时，才会占用 1 字节\n作为父类继承时，不会占用额外空间"}]},{"ID":"20260505170804-u6siq58","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-u6siq58","updated":"20260601222534"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"子类和父类的对象在内存是连续的吗？"}]},{"ID":"20260505170804-m5wor7s","Type":"NodeParagraph","Properties":{"id":"20260505170804-m5wor7s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"是连续的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 C++ 单一继承模型中，父类子对象和子类新增成员在内存中是连续存放的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"父类部分在前，子类新增成员在后，整体构成一块连续的内存布局"}]},{"ID":"20260505170804-1i5p2sv","Type":"NodeParagraph","Properties":{"id":"20260505170804-1i5p2sv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"只有在多继承、虚继承或存在虚函数时，布局会更复杂，但单一继承下内存一定连续"}]},{"ID":"20260505170804-0c9gyws","Type":"NodeParagraph","Properties":{"id":"20260505170804-0c9gyws","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在多继承中，子类会依次包含所有父类的子对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它们之间仍然连续，只是按继承顺序依次排列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果父类包含虚函数，会在头部增加虚表指针，布局会更复杂"}]},{"ID":"20260505170804-7m70em8","Type":"NodeParagraph","Properties":{"id":"20260505170804-7m70em8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在虚继承下，为了解决菱形继承的数据冗余问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器会插入偏移量指针或间接索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚基类子对象会被放到子类对象的尾部 / 共享位置，不再与直接子对象紧凑连续"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存布局由编译器通过间接方式管理，保证唯一实例"}]},{"ID":"20260505170804-hm1pwy6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hm1pwy6","updated":"20260601222536"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"有没有了解过 rule of three /rule of zero？"}]},{"ID":"20260505170804-28ycdc8","Type":"NodeParagraph","Properties":{"id":"20260505170804-28ycdc8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Rule of three 指的是如果一个类需要自定义析构函数、拷贝构造函数、拷贝赋值运算符中的任意一个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"那么通常需要同时实现这三个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用于管理资源如内存、文件句柄等，避免浅拷贝导致的重复释放或资源泄漏"}]},{"ID":"20260505170804-i2t1877","Type":"NodeParagraph","Properties":{"id":"20260505170804-i2t1877","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Rule of zero 是更现代的准则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量使用标准库容器或智能指针管理资源，不需要手动编写上述三个函数，让编译器自动生成默认实现，代码更简洁、更安全"}]},{"ID":"20260505170804-l3mlona","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-l3mlona","updated":"20260907174204"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对象切片"}]},{"ID":"20260505170804-4az4krs","Type":"NodeParagraph","Properties":{"id":"20260505170804-4az4krs","updated":"20260907174143"},"Children":[{"Type":"NodeText","Data":"对象切片就是子类对象赋值 / 拷贝给父类对象时\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"子类独有的成员、虚函数部分会被直接切掉丢弃"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n只保留父类那一部分，对象不再是原本的子类类型"}]},{"ID":"20260505170804-cpwu3ii","Type":"NodeParagraph","Properties":{"id":"20260505170804-cpwu3ii","updated":"20260907174204"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"父类指针引用不会切片，只有父类对象接收子类对象才会切片\n赋值拷贝时只会调用父类拷贝构造，只会拷贝父类子对象\n子类扩展部分直接丢弃，多态特性完全失效"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-e2bhtdw","Type":"NodeParagraph","Properties":{"id":"20260505170804-e2bhtdw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"日常最容易踩坑：函数参数传父类值类型、直接用父类变量接收子类对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"危害：多态失效、数据丢失、虚函数不转发、内存异常"}]},{"ID":"20260505170804-fnutyfq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fnutyfq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多态"}]},{"ID":"20260505170804-u741id8","Type":"NodeParagraph","Properties":{"id":"20260505170804-u741id8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多态是 C++ 面向对象的核心特性，核心是‘同一接口，不同实现’，分为静态多态和动态多态"}]},{"ID":"20260505170804-m4pzpb7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m4pzpb7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"动态多态的实现过程"}]},{"ID":"20260505170804-xbxo3nv","Type":"NodeParagraph","Properties":{"id":"20260505170804-xbxo3nv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"父类写虚函数，就会生成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚函数表"},{"Type":"NodeText","Data":"；子类继承后，重写虚函数会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"覆盖表中的地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子类对象自带"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚指针"},{"Type":"NodeText","Data":"，指向自己的虚表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用父类指针指向子类对象，调用函数时，会通过虚指针找到子类的虚表，执行"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"子类自己的函数"},{"Type":"NodeText","Data":"，这就是多态"}]},{"ID":"20260505170804-kl7neqg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kl7neqg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"静态多态和动态多态的区别？"}]},{"ID":"20260505170804-wcl9sqi","Type":"NodeParagraph","Properties":{"id":"20260505170804-wcl9sqi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"静态多态：编译的时候就定好调用哪个函数，速度快，但不够灵活；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态多态：运行的时候才查表确定调用谁，会多一点点跳转开销，但特别灵活，能适配各种子类对象。"}]},{"ID":"20260505170804-kqp835q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kqp835q","updated":"20260506184128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚函数表的内存开销？"}]},{"ID":"20260505170804-654wzrx","Type":"NodeParagraph","Properties":{"id":"20260505170804-654wzrx","updated":"20260506184128"},"Children":[{"Type":"NodeText","Data":"每个含虚函数的对象会多一个 vptr 的开销，vtable 属于类，不占用对象内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比多态带来的灵活性，这个开销通常可以接受"}]},{"ID":"20260505170804-trfk1fk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-trfk1fk","updated":"20260506184133"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚函数表是在哪个阶段生成的？"}]},{"ID":"20260505170804-3kwm3kb","Type":"NodeParagraph","Properties":{"id":"20260505170804-3kwm3kb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚函数表分为四个阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编译阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器看到类里有虚函数，就会为这个类创建一张虚函数表的雏形"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"生成在目标文件的只读数据段里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"表里先填上虚函数的名字符号，这时候还没有真正的内存地址，只是占位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"链接阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"链接器把多个目标文件合并，把虚函数表里的符号替换成真正的内存地址，虚函数表才算真正完成、可以使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"运行构造阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实例化对象时初始化 vptr，绑定当前类的虚表，子类会先父类、后自身完成覆盖"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"调用阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过基类指针访问虚函数，依靠 vptr 查找虚表，动态寻址完成动态绑定，实现多态"}]},{"ID":"20260505170804-rgusofv","Type":"NodeParagraph","Properties":{"id":"20260505170804-rgusofv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为什么在链接期才确定内存位置："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为编译的时候，函数还没确定最终位置，只有链接把所有文件拼在一起，才能算出每个函数的真实内存地址，填进虚函数表"}]},{"ID":"20260505170804-05sz5lu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-05sz5lu","updated":"20260907175859"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚函数指针、虚函数表存在哪个区域"}]},{"ID":"20260505170804-h5l477l","Type":"NodeParagraph","Properties":{"id":"20260505170804-h5l477l","updated":"20260907175659"},"Children":[{"Type":"NodeText","Data":"虚函数表属于编译期就确定的只读数据，存放在进程的只读数据段，也就是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"全局 / 静态区"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n整个类所有对象共用同一张虚表，不会每个对象各存一份"}]},{"ID":"20260505170804-apqfhhg","Type":"NodeParagraph","Properties":{"id":"20260505170804-apqfhhg","updated":"20260907175859"},"Children":[{"Type":"NodeText","Data":"虚函数指针是属"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"于对象实例的成员，它跟着对象走"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n如果对象在栈上创建，vptr 就在栈区\n如果是 new 出来的堆对象，vptr 就在堆区\n虚指针本身不单独占用全局区，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"只是作为对象头部的一部分存在"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-evlm21i","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-evlm21i","updated":"20260907175958"},"Children":[{"Type":"NodeText","Data":"基类的虚函数表存放在内存的什么区，虚表指针 vptr 的初始化时间？\t"}]},{"ID":"20260505170804-3vw10ft","Type":"NodeParagraph","Properties":{"id":"20260505170804-3vw10ft","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚函数表存放在只读数据段，属于类，所有对象共享一份。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚表指针 在构造函数执行期间初始化，对象创建时自动赋值；vptr 是对象的一部分，存在对象内存最前面"}]},{"ID":"20260505170804-fyg6ib1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fyg6ib1","updated":"20260907180418"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"派生类继承基类，虚函数表何时替换"}]},{"ID":"20260505170804-azrchak","Type":"NodeParagraph","Properties":{"id":"20260505170804-azrchak","updated":"20260907180418"},"Children":[{"Type":"NodeText","Data":"构造阶段：先执行基类构造，这时虚表用基类的\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"基类构造完成瞬间，直接切换成派生类虚表，再执行派生类构造"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-wl442m5","Type":"NodeParagraph","Properties":{"id":"20260505170804-wl442m5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"析构阶段：先执行派生类析构，此时用派生类虚表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"派生类析构完立刻切回基类虚表，再执行基类析构"}]},{"ID":"20260505170804-s0lxs98","Type":"NodeParagraph","Properties":{"id":"20260505170804-s0lxs98","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对象完全构造完毕后，就固定使用派生类虚表，不再变动"}]},{"ID":"20260505170804-squ67lb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-squ67lb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚函数和普通函数的区别在哪？\t\u003e\u003e"}]},{"ID":"20260505170804-nh6hxr2","Type":"NodeParagraph","Properties":{"id":"20260505170804-nh6hxr2","updated":"20260907180653"},"Children":[{"Type":"NodeText","Data":"虚函数和普通函数最核心的区别，在于"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"调用方式是编译期确定还是运行期确定"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，也就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态绑定和动态绑定"},{"Type":"NodeText","Data":"的区别"}]},{"ID":"20260505170804-jqcbtwv","Type":"NodeParagraph","Properties":{"id":"20260505170804-jqcbtwv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"普通函数在编译阶段就已经确定了调用地址，不管后续怎么用子类对象赋值给父类指针，调用的始终是父类的函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而虚函数会在运行时根据对象实际类型，去查找对应的虚函数表，调用真正属于子类的实现，从而实现多态"}]},{"ID":"20260505170804-jod8kmw","Type":"NodeParagraph","Properties":{"id":"20260505170804-jod8kmw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"从实现上看，带有虚函数的类会生成一张"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚函数表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象中还会多一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚指针"},{"Type":"NodeText","Data":"指向这张表，因此虚函数会略微增加内存开销和调用开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而普通函数没有这些额外结构，调用更快、效率更高"}]},{"ID":"20260505170804-ustvk4y","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20260505170804-ustvk4y","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"函数类型"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"能否为虚函数"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"核心原因"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"常函数"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"能"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"虚函数仅要求 “行为可重写”，const 仅限制函数不修改成员，二者无冲突"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"析构函数"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"能（建议设）"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"确保销毁子类对象时，先调用子类析构、再调用父类析构，避免内存泄漏"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"静态函数"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"不能"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"静态函数属于 “类” 而非 “对象”，无 this 指针，无法通过虚函数表绑定具体对象"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"构造函数"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"不能"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"构造函数执行时，对象（及虚函数表）尚未创建，无法确定要绑定的子类虚函数"}]}]}]},{"ID":"20260505170804-8pcfebo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8pcfebo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么必须用基类指针 / 引用才能触发多态？"}]},{"ID":"20260505170804-i4a9gqf","Type":"NodeParagraph","Properties":{"id":"20260505170804-i4a9gqf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"直接用子类对象调用函数，编译时就确定了，直接调用子类自己的函数，不用走虚表；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有父类指针或引用指向子类对象时，编译时不知道具体是哪个子类，才会在运行时通过虚指针找虚表，触发多态。"}]},{"ID":"20260505170804-8y2j2py","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8y2j2py","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"没有虚函数的话，C++ 如何实现多态？"}]},{"ID":"20260505170804-upobare","Type":"NodeParagraph","Properties":{"id":"20260505170804-upobare","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在没有虚函数的情况下，可以通过函数指针、std::function、手动类型擦除和模板来实现多态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每种方法都有其适用场景和局限性"}]},{"ID":"20260505170804-hrd5dna","Type":"NodeParagraph","Properties":{"id":"20260505170804-hrd5dna","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"函数指针只能指向单个函数，不能绑对象，没法存状态，用起来很死板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::function 有额外开销，体积大、速度慢，而且不能比较相等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"手动类型擦除写起来超级麻烦，难维护。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"模板编译时确定类型，做不到运行时多态，不能存不同类型到一个容器里"}]},{"ID":"20260505170804-jiw3sqo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jiw3sqo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"调用虚函数一定比调用普通函数慢吗\t\t\u003e\u003e"}]},{"ID":"20260505170804-muo1r20","Type":"NodeParagraph","Properties":{"id":"20260505170804-muo1r20","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不一定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"理论上虚函数需要查虚表、间接调用，确实比普通函数多一次寻址开销，看起来更慢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但现代编译器会做大量优化，比如虚函数内联、去虚拟化、常量传播"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多场景下虚函数调用会被直接优化成普通函数调用，效率几乎一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有在运行期确实无法确定对象类型、必须动态查虚表时，虚函数才会略慢一点，但这个开销极小，在工程上基本可以忽略"}]},{"ID":"20260505170804-irtreud","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-irtreud","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"friend 关键字 友元"}]},{"ID":"20260505170804-z6i0tvk","Type":"NodeParagraph","Properties":{"id":"20260505170804-z6i0tvk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"友元和友元函数，并不是类内的函数和类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以不能直接使用类的成员，可以通过对象来使用成员"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优缺点：访问使用保护和私有，使用更方便，破坏封装 安全性差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平时可以使用 共有的 get 方法来替换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"友元是不可以被继承的"}]},{"ID":"20260505170804-sxs3ipj","Type":"NodeParagraph","Properties":{"id":"20260505170804-sxs3ipj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"友元函数"},{"Type":"NodeText","Data":"：普通函数 / 其他类的成员函数被声明为当前类的友元，可直接访问类的私有 / 保护成员。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"声明方式：在类内部用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"friend"},{"Type":"NodeText","Data":" 关键字声明，函数定义可在类外（无需加 friend）。"}]},{"ID":"20260505170804-zbcbzar","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-zbcbzar","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class A {\nprivate:\n    int num = 10;\n    // 声明友元函数\n    friend void printNum(A\u0026 a); \n};\n// 友元函数定义\nvoid printNum(A\u0026 a) {\n    cout \u003c\u003c a.num \u003c\u003c endl; // 直接访问私有成员\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-coahb9h","Type":"NodeParagraph","Properties":{"id":"20260505170804-coahb9h","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"友元类"},{"Type":"NodeText","Data":"：整个类被声明为当前类的友元，该类的所有成员函数都能访问当前类的私有 / 保护成员。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"声明方式： friend class 类名; （仅需在当前类内部声明，无需在友元类中做任何操作）。"}]},{"ID":"20260505170804-4lli3cq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-4lli3cq","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class A {\nprivate:\n    int num = 10;\n    friend class B; // 声明B为A的友元类\n};\nclass B {\npublic:\n    void print(A\u0026 a) {\n        cout \u003c\u003c a.num \u003c\u003c endl; // B的成员函数可访问A的私有成员\n    }\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ws75dem","Type":"NodeParagraph","Properties":{"id":"20260505170804-ws75dem","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"场景 1：运算符重载（如重载 \u003c\u003c 运算符）。cout \u003c\u003c 对象 中的 \u003c\u003c 运算符需要访问对象的私有成员，通常将 ostream\u0026 operator\u003c\u003c(ostream\u0026, 类名\u0026) 声明为类的友元函数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"场景 2：跨类协作。两个高度耦合的类（如链表的节点类和链表类），通过友元简化数据访问，避免编写大量冗余的接口函数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"场景 3：测试场景。单元测试中，可将测试函数 / 测试类声明为目标类的友元，直接验证私有成员的逻辑，无需暴露不必要的接口。"}]},{"ID":"20260505170804-epn8qox","Type":"NodeParagraph","Properties":{"id":"20260505170804-epn8qox","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"友元函数和类成员函数的区别：友元函数不属于类，没有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":" 指针，必须显式传递类对象才能访问成员；成员函数属于类，自带 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":" 指针，可直接访问成员。"}]},{"ID":"20260505170804-43w5grq","Type":"NodeParagraph","Properties":{"id":"20260505170804-43w5grq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"何时避免使用友元：非必要场景（如普通业务逻辑）优先通过公有接口访问成员，仅在「封装性和灵活性需权衡」时使用友元。"}]},{"ID":"20260505170804-709s2bi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-709s2bi","updated":"20260907183256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 四种类型转换"}]},{"ID":"20260505170804-l9km3yo","Type":"NodeParagraph","Properties":{"id":"20260505170804-l9km3yo","updated":"20260907182414"},"Children":[{"Type":"NodeText","Data":"static_cast（静态转换）\t\t"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"编译期"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"就确定\t\n能转："},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"数字之间互转、子类指针转给父类（向上转型）、void* 转其他指针"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n也能父类转子类（向下转型），但不做安全检查，转错了直接出 bug、程序崩溃\n无关类型不能转，比如 int 转 int*、学生类转整数，都不行。"}]},{"ID":"20260505170804-z9vnsw6","Type":"NodeParagraph","Properties":{"id":"20260505170804-z9vnsw6","updated":"20260907183005"},"Children":[{"Type":"NodeText","Data":"dynamic_cast（动态转换）\t"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"运行时"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"检查，专门用来"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"安全"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"向下转型"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"。\n只能用在  有多态的继承结构里。\n父类指针转子类指针\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"支持交叉转换：多继承里，从一个基类转到另一个平级基类。"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-6r39rr9","Type":"NodeParagraph","Properties":{"id":"20260505170804-6r39rr9","updated":"20260907183005"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"const_cast"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n只干一件事：添加或去掉 const / volatile 限定。\n不改变类型、不改变内存，只改读写权限。"}]},{"ID":"20260505170804-c9uqxv1","Type":"NodeParagraph","Properties":{"id":"20260505170804-c9uqxv1","updated":"20260907183256"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"reinterpret_cast"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n最暴力、最不安全，直接重新解释内存\n不检查、不转换数据，直接把一块内存当成另一种类型看\n比如指针转整数、整数转指针、无关指针互转\n用错直接崩溃，只适合底层开发"}]},{"ID":"20260505170804-jgjmvnr","Type":"NodeParagraph","Properties":{"id":"20260505170804-jgjmvnr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"reinterpret_cast 在底层其实非常简单，它不做任何运行时的类型检查，也不会修改内存里的实际数据，只是在编译阶段把一段内存的二进制内容，直接按照目标类型重新去解释"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单说就是把指针或者数据的比特位原样照搬，强行当成另一种类型来用，完全不关心类型是否合法、是否安全，所有风险都由程序员自己承担"}]},{"ID":"20260505170804-77a0aiu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-77a0aiu","updated":"20260907183450"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"static_cast 类内类外修饰区别"}]},{"ID":"20260505170804-296gu06","Type":"NodeParagraph","Properties":{"id":"20260505170804-296gu06","updated":"20260907183325"},"Children":[{"Type":"NodeText","Data":"static_cast 是 C++ 里最常用的静态类型转换，在"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"编译期完成转换，不做运行时安全检查"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n它在类内部和类外部使用时，语法本身没有区别，真正的"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"差异主要体现在继承权限的访问控制上"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"}]},{"ID":"20260505170804-6c26c68","Type":"NodeParagraph","Properties":{"id":"20260505170804-6c26c68","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在类内部使用时，因为当前类对自身的继承关系拥有完全访问权限，所以不管是公有继承、保护继承还是私有继承，都可以正常使用 static_cast 进行基类和派生类之间的转换，不会出现权限相关的编译错误"}]},{"ID":"20260505170804-vtr1pyb","Type":"NodeParagraph","Properties":{"id":"20260505170804-vtr1pyb","updated":"20260907183450"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"而在类外部使用时，static_cast 只支持公有继承的类型转换"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n如果是私有继承或者保护继承，外部代码没有权限访问这种继承关系，直接转换会直接编译失败\n另外补充一个关键点：\nstatic_cast 向上转型，也就是派生类转基类是安全的\n但向下转型，基类转子类并不安全，因为它不检查对象实际类型，误用很容易出现未定义行为，这种场景更推荐使用 dynamic_cast"}]},{"ID":"20260505170804-g8m5o6q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-g8m5o6q","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"dynamic_cast 和 static_cast 的性能和安全性比较\t\u003e\u003e"}]},{"ID":"20260505170804-c0umo22","Type":"NodeParagraph","Properties":{"id":"20260505170804-c0umo22","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"性能方面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"static_cast 是编译的时候就搞定了，运行起来几乎没有开销，速度特别快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 dynamic_cast 要靠 RTTI 运行时类型信息，在程序跑的时候去查继承关系、做类型校验，会有明显的运行时开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"性能比 static_cast 差不少"}]},{"ID":"20260505170804-mq9ka0v","Type":"NodeParagraph","Properties":{"id":"20260505170804-mq9ka0v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"安全性方面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"static_cast 只在编译时做简单检查，不会真的判断转的对不对"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如你把父类指针强转成子类，只要语法没问题它就让你过，但实际对象不匹配的话，后面一用就会崩，而且它不会给你任何提示"}]},{"ID":"20260505170804-8nuee4b","Type":"NodeParagraph","Properties":{"id":"20260505170804-8nuee4b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"dynamic_cast 就安全很多，它只支持多态类型转换，运行时会检查类型对不对"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指针转失败会返回空，引用转失败会抛异常，你能立刻知道转错了，不会稀里糊涂出问题"}]},{"ID":"20260505170804-ncp1zh8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ncp1zh8","updated":"20260506185321"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"dynamic_cast 的类型检测具体是如何实现的？"}]},{"ID":"20260505170804-lkrw2ap","Type":"NodeParagraph","Properties":{"id":"20260505170804-lkrw2ap","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"dynamic_cast 的安全类型检测依赖于编译器为多态类生成的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"RTTI 运行时类型信息"},{"Type":"NodeText","Data":"实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器会为每一个包含虚函数的类创建唯一的 type_info 结构体"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存储类名、继承关系、类层级等元数据，并将其与虚函数表绑定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个多态对象通过内存头部的虚表指针 找到自身真实类型信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行 dynamic_cast 时，程序会通过虚表指针获取对象的 RTTI，与目标类型进行运行时匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当出现"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"基类无虚函数、类之间无继承关系、或实际对象类型与目标类型不匹配"},{"Type":"NodeText","Data":"时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类型检测失败，转换指针返回 nullptr，转换引用则抛出 bad_cast 异常"}]},{"ID":"20260505170804-otih0n0","Type":"NodeParagraph","Properties":{"id":"20260505170804-otih0n0","updated":"20260506185315"},"Children":[{"Type":"NodeText","Data":"第二种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"基于 虚函数表偏移查找"},{"Type":"NodeText","Data":"（无完整 RTTI / 裁剪模式）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"部分编译器 / 关闭完整 RTTI 场景下，不靠完整类型信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只依靠虚表结构、继承偏移量做判断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遍历父子类继承链、计算基类内存偏移，校验父子继承合法性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只做继承关系校验，不做完整类型比对，完成转型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特点：不依赖完整 RTTI 数据，体积小、效率高，常见于嵌入式、关闭 RTTI 优化场景"}]},{"ID":"20260505170804-w1wlf8z","Type":"NodeParagraph","Properties":{"id":"20260505170804-w1wlf8z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自己实现动态类型转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"手动判断 + 强制转换（自己实现动态转型）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不依赖 dynamic_cast，依靠类型判断 + static_cast/reinterpret_cast 强转"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用手段："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自定义类型标记、基类写获取类型 ID 的虚函数，运行时先判断对象实际类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先判类型再强转，模拟动态转换逻辑，无 RTTI 也能用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但需要自己维护类型判断，容易写错，安全性低"}]},{"ID":"20260505170804-010aqx5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-010aqx5","updated":"20260508232646"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"动态类型转换支持交叉转换\t\t\u003e\u003e"}]},{"ID":"20260505170804-ytw3j5o","Type":"NodeParagraph","Properties":{"id":"20260505170804-ytw3j5o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"交叉转换指的是：在菱形继承、多继承结构中，从一个基类指针，直接转换到同一继承层级的另一个兄弟基类指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"dynamic_cast 能够通过运行时类型信息（RTTI），查找到完整对象的实际类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再安全地转到目标兄弟基类子对象，因此支持这种转换"}]},{"ID":"20260505170804-p6h5ooq","Type":"NodeParagraph","Properties":{"id":"20260505170804-p6h5ooq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但它必须满足几个条件："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目标类型必须是多态类型（至少含有一个虚函数）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"转换的必须是指针或引用，并且源指针指向的完整对象确实同时包含这两个基类子对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果不满足，指针转换会返回 nullptr，引用转换则抛出异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比之下，static_cast 不做运行时检查，不支持交叉转换，强行转换会导致未定义行为"}]},{"ID":"20260505170804-s8lyhfr","Type":"NodeParagraph","Properties":{"id":"20260505170804-s8lyhfr","updated":"20260508232643"},"Children":[{"Type":"NodeText","Data":"有虚函数才有类型信息，有指针/引用才能偏移地址，对象同时继承才能找到两个基类，这三条缺一不可"}]},{"ID":"20260508232651-c2h93ip","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508232651-c2h93ip","updated":"20260508151420"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 类里面一个类的构造函数可以为私有的吗"}]},{"ID":"20260508232638-0d8x2a4","Type":"NodeParagraph","Properties":{"id":"20260508232638-0d8x2a4","updated":"20260508232644"},"Children":[{"Type":"NodeText","Data":"C++ 类的构造函数可以声明成 private 私有。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"禁止外部直接创建对象，不能用 类名 对象; 这种方式实例化；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般用来实现单例模式、或者只允许类内部 / 友元创建对象；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"私有化构造后，只能通过类里的静态成员函数来创建和获取对象。"}]},{"ID":"20260505170804-9f9jr38","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9f9jr38","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 模版\t\t\u003e\u003e"}]},{"ID":"20260505170804-d7y4dq8","Type":"NodeParagraph","Properties":{"id":"20260505170804-d7y4dq8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 模板是实现"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"泛型编程"},{"Type":"NodeText","Data":"的核心机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"template"},{"Type":"NodeText","Data":" 关键字定义通用的函数或类，让代码与具体数据类型无关"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只需编写一套逻辑就能支持 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"int"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"string"},{"Type":"NodeText","Data":" 等多种类型，实现代码复用且"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保证编译期类型安全"}]},{"ID":"20260505170804-ftvi912","Type":"NodeParagraph","Properties":{"id":"20260505170804-ftvi912","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实现时用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"template \u0026lt;typename T\u0026gt;"},{"Type":"NodeText","Data":" 声明类型参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在函数 / 类中使用通用类型 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"T"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器会在编译期根据传入的实际类型自动生成对应代码，主要分为函数模板和类模板两类"}]},{"ID":"20260505170804-rhyihyb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rhyihyb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是模板？如何实现？\t\u003e\u003e"}]},{"ID":"20260505170804-31cnryr","Type":"NodeParagraph","Properties":{"id":"20260505170804-31cnryr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"创建类或者函数的蓝图或者公式，分为函数模版和类模版"}]},{"ID":"20260505170804-3k6tdpq","Type":"NodeParagraph","Properties":{"id":"20260505170804-3k6tdpq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"函数模板是用于生成通用函数的模板，使用 template \u003ctypename T\u003e 定义，能处理任意同类型参数，一套代码支持 int/double 等多种类型，编译器自动推导类型并生成对应函数，实现代码复用与类型安全。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类模板是用于生成通用类的模板，同样以 template 声明，可定义通用成员变量和成员函数，常用于实现容器（如栈、数组），使用时需显式指定具体类型。"}]},{"ID":"20260505170804-ek4wpac","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ek4wpac","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 函数模板：求两个数的最小值\ntemplate \u003ctypename T\u003e\nT getMin(T a, T b) {\n    return a \u003c b ? a : b;\n}\nint main() {\n    // int类型\n    cout \u003c\u003c getMin(5, 3) \u003c\u003c endl;\n    // double类型\n    cout \u003c\u003c getMin(2.5, 1.8) \u003c\u003c endl;\n    // 字符串类型\n    cout \u003c\u003c getMin\u003cstring\u003e(\"zoo\", \"apple\") \u003c\u003c endl;\n    return 0;\n}\n\n// 类模板：通用数组类\ntemplate \u003ctypename T\u003e\nclass MyArray {\nprivate:\n    T data[5];\npublic:\n    // 设置值\n    void set(int idx, T val) {\n        data[idx] = val;\n    }\n    // 获取值\n    T get(int idx) {\n        return data[idx];\n    }\n};\nint main() {\n    // 存储int\n    MyArray\u003cint\u003e arr1;\n    arr1.set(0, 10);\n    cout \u003c\u003c arr1.get(0) \u003c\u003c endl;\n\n    // 存储字符串\n    MyArray\u003cstring\u003e arr2;\n    arr2.set(0, \"test\");\n    cout \u003c\u003c arr2.get(0) \u003c\u003c endl;\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-kx8bm9s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kx8bm9s","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"函数模版和类模版的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-tb2wpag","Type":"NodeParagraph","Properties":{"id":"20260505170804-tb2wpag","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"函数模板主要用来生成通用函数，比如比较大小、加减运算这种独立功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它最大的特点是编译器能根据你传进去的实参，自动推导出模板类型，调用起来很方便，不用手动指定类型"}]},{"ID":"20260505170804-pnwgegi","Type":"NodeParagraph","Properties":{"id":"20260505170804-pnwgegi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"类模板是用来生成通用的类，比如容器、栈、队列这种需要封装数据和方法的结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不能自动推导类型，使用时必须显式指定具体类型"}]},{"ID":"20260505170804-hzlxalm","Type":"NodeParagraph","Properties":{"id":"20260505170804-hzlxalm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而且类模板支持偏特化，函数模板不支持，在处理复杂场景时类模板会更灵活"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数本身可以重载，编译器已经能通过参数匹配找到最合适的版本，不需要再设计一套偏特化规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果允许函数偏特化，会和函数重载产生歧义，编译器不知道该选哪个，语法上就干脆禁止了"}]},{"ID":"20260505170804-85slsls","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-85slsls","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"template \u003ctypename T\u003e\nT add(T a, T b) { ... }\nadd(10, 20);\n\ntemplate \u003ctypename T\u003e\nclass MyClass {\n    T value;  // 这个 T 是成员变量的类型\n};\nMyClass obj;  // 错误！编译器懵了：T 是什么？\n\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3hi12fs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3hi12fs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"特化偏特化\t\t\u003e\u003e"}]},{"ID":"20260505170804-6cxkqe4","Type":"NodeTable","Data":"|特性|全特化|偏特化|\n| --------| -----------------| --------------------|\n|模板参数|\u003cspan data-type=\"code\"\u003etemplate \u0026lt;\u0026gt;\u003c/span\u003e 空|\u003cspan data-type=\"code\"\u003etemplate \u0026lt;typename T\u0026gt;\u003c/span\u003e 保留部分|\n|匹配范围|\u003cspan data-type=\"strong\"\u003e精确匹配一个类型\u003c/span\u003e|匹配\u003cspan data-type=\"strong\"\u003e一类类型\u003c/span\u003e|\n|支持范围|类模板 + 函数模板|\u003cspan data-type=\"strong\"\u003e仅类模板\u003c/span\u003e|\n|优先级|最高|高于通用，低于全特化|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-6cxkqe4","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"特性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"全特化"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"偏特化"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模板参数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"template \u0026lt;\u0026gt;"},{"Type":"NodeText","Data":" 空"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"template \u0026lt;typename T\u0026gt;"},{"Type":"NodeText","Data":" 保留部分"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"匹配范围"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"精确匹配一个类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"匹配"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一类类型"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"支持范围"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"类模板 + 函数模板"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"仅类模板"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"优先级"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"最高"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高于通用，低于全特化"}]}]}]},{"ID":"20260505170804-ozs8mpx","Type":"NodeParagraph","Properties":{"id":"20260505170804-ozs8mpx","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特化（全特化）"},{"Type":"NodeText","Data":" 是为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"某一种具体类型"},{"Type":"NodeText","Data":"提供专属实现，用来处理通用模板无法满足的特殊逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"例如我们实现一个比较大小的通用模板，对大多数类型都适用，但针对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"bool"},{"Type":"NodeText","Data":" 类型需要特殊处理，就可以对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"bool"},{"Type":"NodeText","Data":" 进行全特化，单独实现符合布尔语义的逻辑，避免通用逻辑出错。"}]},{"ID":"20260505170804-60kvb2w","Type":"NodeParagraph","Properties":{"id":"20260505170804-60kvb2w","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"偏特化"},{"Type":"NodeText","Data":"则是为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一类具有相同特征的类型"},{"Type":"NodeText","Data":"定制实现，只指定部分模板参数或约束类型特征，只支持类模板。最典型的场景是处理指针、引用类型，比如通用模板处理普通类型，而偏特化版本专门匹配 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"T*"},{"Type":"NodeText","Data":" 指针类型，在实现中可以直接操作指针指向的内容，让模板对普通类型和指针类型都能正确工作。"}]},{"ID":"20260505170804-5ub0q6j","Type":"NodeParagraph","Properties":{"id":"20260505170804-5ub0q6j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它们的核心价值是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在保持模板通用性的同时，为特殊类型提供优化和定制能力"},{"Type":"NodeText","Data":"。STL 中的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"iterator_traits"},{"Type":"NodeText","Data":" 迭代器萃取就是经典应用：通过偏特化区分原生指针、迭代器等不同类型，自动匹配最优的算法实现；而全特化常用于精确匹配某个基础类型，做极致的性能优化或特殊逻辑处理。"}]},{"ID":"20260505170804-pjp4ule","Type":"NodeParagraph","Properties":{"id":"20260505170804-pjp4ule","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"偏特化"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不影响通用模板的功能"},{"Type":"NodeText","Data":"。它只是为一类特定类型（如指针、引用）新增一个独立的实现版本，通用模板原本支持的类型和逻辑完全保持不变，编译器只会在匹配到偏特化条件时才使用它，不匹配则继续使用通用模板。"}]},{"ID":"20260505170804-imnajg9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-imnajg9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模板编程 和 模板元编程的区别\t\u003e\u003e"}]},{"ID":"20260505170804-s8g99uy","Type":"NodeParagraph","Properties":{"id":"20260505170804-s8g99uy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模板编程，就是用模板写通用代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如写一个通用的容器、通用的函数，让它支持 int、double、自定义类型等等，目的是少写重复代码，主要干活是在运行时"}]},{"ID":"20260505170804-kk9x6hm","Type":"NodeParagraph","Properties":{"id":"20260505170804-kk9x6hm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模板元编程，是把模板当成一种编译期计算的工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不在运行时做事，而是让编译器在编译阶段就把类型判断、简单计算、分支逻辑都做完，结果直接编译进程序里，让运行时更快、更安全。像 STL 里的 is_pointer、is_same 这些，都是典型的模板元编程"}]},{"ID":"20260505170804-gsqwovz","Type":"NodeParagraph","Properties":{"id":"20260505170804-gsqwovz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模板元编程就是：用模板递归做计算，用特化做终止，让编译器在编译阶段把逻辑全部算完，运行时直接拿结果"}]},{"ID":"20260505170804-6m8k7zi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-6m8k7zi","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 模板：通用情况\ntemplate \u003cint N\u003e\nstruct Factorial {\n    enum { value = N * Factorial\u003cN - 1\u003e::value };\n};\n\n// 模板特化：递归终止条件\ntemplate \u003c\u003e\nstruct Factorial\u003c0\u003e {\n    enum { value = 1 };\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-uucz5l6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uucz5l6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲一下模板特化和偏特化和函数重载之间的区别\t\t\u003e\u003e"}]},{"ID":"20260505170804-idg8s20","Type":"NodeParagraph","Properties":{"id":"20260505170804-idg8s20","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，模板特化 / 偏特化是编译期就确定的。它们都属一个模板家族，是给模板的某些特定情况做的 “定制版”。编译器在编译的时候，会根据你传入的类型，自动选择最匹配的模板版本 —— 要么用通用模板，要么用特化、偏特化。它们不是独立函数，而是模板的分支，共用一套名字、一套语义，只是针对某些类型做了特殊实现。"}]},{"ID":"20260505170804-5zpv6on","Type":"NodeParagraph","Properties":{"id":"20260505170804-5zpv6on","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而函数重载是多个完全独立的函数，只是名字相同而已。它们之间没有任何父子、分支关系，每个重载函数都是单独编写、单独编译的。编译器匹配的时候，是根据参数个数、类型、顺序来选最合适的那个普通函数。重载发生在函数层面，和模板没有关系。"}]},{"ID":"20260505170804-rzw7oj2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rzw7oj2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 设计原则\t\t\u003e\u003e"}]},{"ID":"20260505170804-cyj8lb9","Type":"NodeParagraph","Properties":{"id":"20260505170804-cyj8lb9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单一职责："},{"Type":"NodeText","Data":"一个类只干一件事，修改只影响一个功能；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"开闭原则："},{"Type":"NodeText","Data":"扩展加代码，不修改原有代码，靠多态实现；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"里氏替换："},{"Type":"NodeText","Data":"子类可替换父类，不改变程序逻辑；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"依赖倒置："},{"Type":"NodeText","Data":"依赖抽象不依赖具体，降低耦合；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接口隔离："},{"Type":"NodeText","Data":"接口小而专，避免冗余方法；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"迪米特法则："},{"Type":"NodeText","Data":"只和直接朋友交流，减少依赖"}]},{"ID":"20260505170804-tgdnh8d","Type":"NodeParagraph","Properties":{"id":"20260505170804-tgdnh8d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合成复用原则："},{"Type":"NodeText","Data":"尽量使用合成/聚合的方式，而不是使用继承"}]},{"ID":"20260505170804-6jhetkl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6jhetkl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 设计模式"}]},{"ID":"20260505170804-sr50bw6","Type":"NodeParagraph","Properties":{"id":"20260505170804-sr50bw6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"创建型模式"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对象怎么造出来"},{"Type":"NodeText","Data":"，对类的实例化过程进行抽象,不用自己动手 “new”，而是交给专门的地方去 “造”，只管拿来用。"}]},{"ID":"20260505170804-lzqiu6g","Type":"NodeParagraph","Properties":{"id":"20260505170804-lzqiu6g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单例模式：一个类只能造唯一一个对象，全局共用这一个，不重复创建。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工厂模式：把 new 对象交给工厂，你只管要产品，不用管怎么造。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抽象工厂模式：超级工厂，能造一整套产品，比如造 “小米全家桶” 。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"建造者模式：一步步拼装复杂对象，像搭乐高一样，分步组装。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原型模式：直接复制已有的对象来生成新对象，不用重新从头创建，快又省事。"}]},{"ID":"20260505170804-vrhbmho","Type":"NodeParagraph","Properties":{"id":"20260505170804-vrhbmho","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"行为型模式"},{"Type":"NodeText","Data":": "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对象怎么配合干活"},{"Type":"NodeText","Data":"，关注对象之间 怎么通信、怎么分工、怎么协作"}]},{"ID":"20260505170804-0obvvf0","Type":"NodeParagraph","Properties":{"id":"20260505170804-0obvvf0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中介者模式：大家不直接互相调用，都找中介传话，减少耦合。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"观察者模式：一个变，所有依赖它的都自动收到通知、自动更新。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命令模式：把请求封装成命令，可撤销、可排队、可记录。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"策略模式：同一个任务，换不同算法 / 方案，想换就换，互不影响。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"模板方法：模式流程骨架定好，细节交给子类自己实现。"}]},{"ID":"20260505170804-vo29ntc","Type":"NodeParagraph","Properties":{"id":"20260505170804-vo29ntc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"迭代器模式：不用管内部结构，挨个遍历元素就行。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"责任链模式：事情一层层传，谁能处理谁处理，不行就传给下一个。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"状态模式：根据状态不同，自动切换行为。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"备忘录模式：给对象做个备份，需要时能恢复回去。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"访问者模式：数据结构不变，可以灵活增加新的操作逻辑。"}]},{"ID":"20260505170804-ozkvzas","Type":"NodeParagraph","Properties":{"id":"20260505170804-ozkvzas","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结构型模式"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对象怎么搭结构，"},{"Type":"NodeText","Data":"关注怎么把类 / 对象组装成更大的结构，让结构更灵活、更易用、还能兼容老代码。"}]},{"ID":"20260505170804-bctcmtm","Type":"NodeParagraph","Properties":{"id":"20260505170804-bctcmtm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"适配器：转接头，兼容不兼容的接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"装饰器：动态加功能，不改原代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代理：替你做事，控制访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外观：一键开关，把复杂系统包成简单接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"桥接：把两个变化维度分开（如 品牌 + 颜色）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"组合：树状结构，整体和单个对象一样用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"享元：共享对象，节省内存（如线程池、字符串常量池）"}]},{"ID":"20260505170804-z98rm9x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z98rm9x","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"代理模式"}]},{"ID":"20260505170804-6jgwwaq","Type":"NodeParagraph","Properties":{"id":"20260505170804-6jgwwaq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代理模式就是给真实对象设一个中间人代理，外部不直接访问目标对象，由代理来接管请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代理在调用真实业务前后，可以加日志、权限校验、事务、缓存这些增强逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用修改原有业务代码，做到解耦和功能扩展"}]},{"ID":"20260505170804-cfot8uh","Type":"NodeParagraph","Properties":{"id":"20260505170804-cfot8uh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分两种："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态代理要手动写代理类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态代理在运行时自动生成代理，更灵活，Spring AOP 底层就是用的动态代理。"}]},{"ID":"20260505170804-kwp2x4t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kwp2x4t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"观察者模式的优缺点"}]},{"ID":"20260505170804-jkb08yx","Type":"NodeParagraph","Properties":{"id":"20260505170804-jkb08yx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"观察者模式定义了一对多的依赖关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当一个主题对象状态发生变化时，会主动通知所有订阅它的观察者"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"观察者再各自执行对应的逻辑"}]},{"ID":"20260505170804-l8ye6s5","Type":"NodeParagraph","Properties":{"id":"20260505170804-l8ye6s5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主题和观察者完全解耦，主题不需要知道观察者是谁、有多少个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只负责发送通知即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新增、删除观察者都不会改动主题代码，满足开闭原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时事件通知逻辑清晰，职责分离"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合实现事件监听、消息通知、回调处理等业务场景"}]},{"ID":"20260505170804-u39v2pm","Type":"NodeParagraph","Properties":{"id":"20260505170804-u39v2pm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先是通知顺序不可控，观察者执行顺序不确定，容易出现逻辑问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果观察者很多，通知遍历会消耗性能，造成通知卡顿"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次观察者之间相互不知情，容易出现循环依赖、循环通知，导致系统死循环"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时调试难度较高，事件触发链路不直观，出问题不好排查"}]},{"ID":"20260505170804-figrro5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-figrro5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单例"}]},{"ID":"20260505170804-jwsq2dq","Type":"NodeParagraph","Properties":{"id":"20260505170804-jwsq2dq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"懒汉式"}]},{"ID":"20260505170804-g3b3quf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Yysr","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-g3b3quf","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Yysr"},{"Type":"NodeCodeBlockCode","Data":"class CSingleton {\nprivate:\n\tCSingleton():m_a(1){}\n\tCSingleton(const CSingleton\u0026) = delete;\t//删除拷贝构造\n    CSingleton\u0026 operator=(const CSingleton\u0026) = delete;\n\t~CSingleton(){}\npublic:\n\t// 静态成员函数：提供全局访问点，返回单例实例（懒汉式实现）\n\tstatic CSingleton* CreateSingleton() {\n\t\t// 局部静态变量：首次调用该函数时初始化，且仅初始化一次\n\t\tstatic CSingleton sin;\n\t\treturn \u0026sin;\n\t}\n\tint m_a;\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-36lvn0h","Type":"NodeParagraph","Properties":{"id":"20260505170804-36lvn0h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"饿汉式"}]},{"ID":"20260505170804-ilmm8eo","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ilmm8eo","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"class CSingleton {\nprivate:\n\tCSingleton():m_a(1){}\n\tCSingleton(const CSingleton\u0026) = delete;\t//删除拷贝构造\n     CSingleton\u0026 operator=(const CSingleton\u0026) = delete;\n\t~CSingleton(){}\n\tstatic CSingleton sin ;\npublic:\n\t// 在多线程下，不会创建多个单例对象 return0；\n\tstatic CSingleton* CreateSingleton() {\n\t\treturn \u0026sin;\n\t}\n\tint m_a;\n};\n//类外定义\nCSingleton CSingleton::sin;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-439itjh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-439itjh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"实现懒汉式单例设计模式的线程安全"}]},{"ID":"20260505170804-j6rouuw","Type":"NodeParagraph","Properties":{"id":"20260505170804-j6rouuw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"双重检查锁定："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先检查实例是否已经创建，如果已经创建，则直接返回实例。如果实例尚未创建，才进行锁定操作。在锁定的情况下再次检查实例是否已经创建，以防止其他线程在等待锁定时已经创建了实例。如果实例仍未创建，才创建并返回实例。"}]},{"ID":"20260505170804-bw9ol6w","Type":"NodeParagraph","Properties":{"id":"20260505170804-bw9ol6w","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++11 后使用局部静态变量初始化保证线程安全"}]},{"ID":"20260505170804-k6hrbhk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k6hrbhk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"双检锁为什么不安全？"}]},{"ID":"20260505170804-yibl2ip","Type":"NodeParagraph","Properties":{"id":"20260505170804-yibl2ip","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因为指令重排"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象创建分 3 步：分配内存、调用构造函数初始化、指针指向内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器 / CPU 可能会优化成："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分配内存、指针先指向内存、再调用构造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时候：别的线程拿到了指针，但对象还没构造完 一旦使用就崩溃"}]},{"ID":"20260505170804-q5mcjuc","Type":"NodeParagraph","Properties":{"id":"20260505170804-q5mcjuc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以给静态单例指针加上 volatile 关键字。volatile 可以防止编译器对该变量的读写操作进行指令重排"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"volatile 就是告诉编译器这个变量可能会被意外改变，别优化它，每次都老老实实去内存里读，不要用寄存器里的缓存值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"static volatile Singleton* m_inst;"}]},{"ID":"20260505170804-12iixes","Type":"NodeParagraph","Properties":{"id":"20260505170804-12iixes","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用 atomic 原子操作，把单例指针定义为 std::atomic 原子类型，使用 load 读取，store 写入，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过原子操作 + 内存序禁止指令重排，它能让指针的读写变成原子操作，不会被线程打断"}]},{"ID":"20260505170804-bsgdcx1","Type":"NodeParagraph","Properties":{"id":"20260505170804-bsgdcx1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"volatile 管编译器优化，保证从内存读"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"atomic 管原子操作，内存序管 CPU 重排"}]},{"ID":"20260505170804-57cyt9f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-57cyt9f","updated":"20260506154151"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单例模式的缺点"}]},{"ID":"20260505170804-hco7htq","Type":"NodeParagraph","Properties":{"id":"20260505170804-hco7htq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单例模式因为全局只有一个实例，会让代码之间的依赖关系不明显"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"别人看代码不知道你依赖了谁，只能翻内部实现，维护成本极高，可读性和维护性都不太好"}]},{"ID":"20260505170804-n2duq7t","Type":"NodeParagraph","Properties":{"id":"20260505170804-n2duq7t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多线程下如果处理不好还会有线程安全问题，同时它强制只能有一个实例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后期想扩展成多个实例会很麻烦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"扩展性差，也不符合开闭原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实例的生命周期也没法灵活控制，还会一直占用内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且它全局共享状态，很难用模拟假对象来做单元测试，测试之间容易相互影响"}]},{"ID":"20260505170804-l7lx1st","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-l7lx1st","updated":"20260506154151"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"如何解决"}]},{"ID":"20260505170804-tulu730","Type":"NodeParagraph","Properties":{"id":"20260505170804-tulu730","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"别自己手写静态单例，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"交给框架去统一管理对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"构造方法注入"},{"Type":"NodeText","Data":"代替到处调用 getInstance，依赖一眼就能看清"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量让对象"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无状态、不变"},{"Type":"NodeText","Data":"，就不会有线程安全问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要多实例直接改配置，测试时也能轻松替换成模拟对象，再别让单例拿着不该持有的资源"}]},{"ID":"20260505170804-7wbwshm","Type":"NodeParagraph","Properties":{"id":"20260505170804-7wbwshm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局唯一、无状态、造多浪费———–用单例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存数据、有状态、要测试、业务类————绝对不用"}]},{"ID":"20260506154149-5nmofyd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260506154149-5nmofyd","updated":"20260506165227"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单例模式跟纯粹的声明静态变量有什么区别"}]},{"ID":"20260506154154-jxpcgxp","Type":"NodeParagraph","Properties":{"id":"20260506154154-jxpcgxp","updated":"20260506164243"},"Children":[{"Type":"NodeText","Data":"静态变量只是全局共享的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而单例模式是保证类全局只有一个实例"}]},{"ID":"20260506164243-e4ejnr5","Type":"NodeParagraph","Properties":{"id":"20260506164243-e4ejnr5","updated":"20260506164457"},"Children":[{"Type":"NodeText","Data":"构造权限不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单例会把构造方法私有化，外部不能随意 new，从根源保证实例唯一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态变量所在类构造一般是公开的，别人仍能 new 出新对象"}]},{"ID":"20260506164500-d9eesdh","Type":"NodeParagraph","Properties":{"id":"20260506164500-d9eesdh","updated":"20260506164640"},"Children":[{"Type":"NodeText","Data":"初始化时机有差异"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态变量随类加载直接初始化，不管用不用都占用内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单例可以实现懒加载，等到第一次使用时才创建，更省资源"}]},{"ID":"20260506165049-klj3m9p","Type":"NodeParagraph","Properties":{"id":"20260506165049-klj3m9p","updated":"20260506165227"},"Children":[{"Type":"NodeText","Data":"职责与管控能力不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单例可以在创建时加初始化逻辑、线程安全控制、资源销毁等统一管控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态变量只能单纯存值，没法封装复杂创建和业务逻辑"}]},{"ID":"20260505170804-ol0oft2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ol0oft2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"工厂模式"}]},{"ID":"20260505170804-kf17j38","Type":"NodeParagraph","Properties":{"id":"20260505170804-kf17j38","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单工厂 ：一个工厂，生产多种同类产品"}]},{"ID":"20260505170804-w3noglx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-w3noglx","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 产品抽象\nclass Fruit {\npublic:\n    virtual void show() = 0;\n};\n\n// 具体产品\nclass Apple : public Fruit {\npublic:\n    void show() { cout \u003c\u003c \"我是苹果\" \u003c\u003c endl; }\n};\n\nclass Banana : public Fruit {\npublic:\n    void show() { cout \u003c\u003c \"我是香蕉\" \u003c\u003c endl; }\n};\n// 简单工厂（只有一个工厂）\nclass FruitFactory {\npublic:\n    static Fruit* createFruit(string type) {\n        if (type == \"apple\") return new Apple();\n        if (type == \"banana\") return new Banana();\n        return nullptr;\n    }\n};\n// 使用\nint main() {\n    Fruit* f = FruitFactory::createFruit(\"apple\");\n    f-\u003eshow();\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-lltahpo","Type":"NodeParagraph","Properties":{"id":"20260505170804-lltahpo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工厂方法 :一个工厂只生产一种产品"}]},{"ID":"20260505170804-pf07531","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-pf07531","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 产品\nclass Fruit {\npublic:\n    virtual void show() = 0;\n};\nclass Apple : public Fruit {\npublic:\n    void show() { cout \u003c\u003c \"苹果\" \u003c\u003c endl; }\n};\nclass Banana : public Fruit {\npublic:\n    void show() { cout \u003c\u003c \"香蕉\" \u003c\u003c endl; }\n};\n\n// 工厂抽象\nclass Factory {\npublic:\n    virtual Fruit* createFruit() = 0;\n};\n// 苹果工厂（只造苹果）\nclass AppleFactory : public Factory {\npublic:\n    Fruit* createFruit() { return new Apple(); }\n};\n// 香蕉工厂（只造香蕉）\nclass BananaFactory : public Factory {\npublic:\n    Fruit* createFruit() { return new Banana(); }\n};\n// 使用\nint main() {\n    Factory* f = new AppleFactory();\n    Fruit* fruit = f-\u003ecreateFruit();\n    fruit-\u003eshow();\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-4ulkunk","Type":"NodeParagraph","Properties":{"id":"20260505170804-4ulkunk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"抽象工厂 :一个工厂生产一整套产品"}]},{"ID":"20260505170804-3uxk4m9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-3uxk4m9","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003ciostream\u003e\nusing namespace std;\n// 产品族：手机 + 耳机\nclass Phone {\npublic:\n    virtual void show() = 0;\n};\n\nclass Earphone {\npublic:\n    virtual void show() = 0;\n};\n\n// 小米产品\nclass XiaomiPhone : public Phone {\npublic:\n    void show() { cout \u003c\u003c \"小米手机\" \u003c\u003c endl; }\n};\n\nclass XiaomiEarphone : public Earphone {\npublic:\n    void show() { cout \u003c\u003c \"小米耳机\" \u003c\u003c endl; }\n};\n// 华为产品\nclass HuaweiPhone : public Phone {\npublic:\n    void show() { cout \u003c\u003c \"华为手机\" \u003c\u003c endl; }\n};\n\nclass HuaweiEarphone : public Earphone {\npublic:\n    void show() { cout \u003c\u003c \"华为耳机\" \u003c\u003c endl; }\n};\n\n// 抽象工厂（能造整套产品：手机+耳机）\nclass AbstractFactory {\npublic:\n    virtual Phone* createPhone() = 0;\n    virtual Earphone* createEarphone() = 0;\n};\n// 小米工厂\nclass XiaomiFactory : public AbstractFactory {\npublic:\n    Phone* createPhone() { return new XiaomiPhone(); }\n    Earphone* createEarphone() { return new XiaomiEarphone(); }\n};\n// 华为工厂\nclass HuaweiFactory : public AbstractFactory {\npublic:\n    Phone* createPhone() { return new HuaweiPhone(); }\n    Earphone* createEarphone() { return new HuaweiEarphone(); }\n};\n// 使用\nint main() {\n    AbstractFactory* f = new XiaomiFactory();\n    f-\u003ecreatePhone()-\u003eshow();\n    f-\u003ecreateEarphone()-\u003eshow();\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-io3erts","Type":"NodeParagraph","Properties":{"id":"20260505170804-io3erts","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单工厂：违反开闭原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工厂方法：完全符合开闭原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抽象工厂：横向扩品牌（等级）开闭友好，纵向扩同品牌产品（族）破坏开闭。"}]},{"ID":"20260505170804-b6p00k0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b6p00k0","updated":"20260506191157"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"静态库和动态库"}]},{"ID":"20260505170804-e5z2gwm","Type":"NodeParagraph","Properties":{"id":"20260505170804-e5z2gwm","updated":"20260506190921"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态库"},{"Type":"NodeText","Data":"：编译链接时，库代码直接拷贝到程序中，运行时不依赖外部文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"体积大、更新需重编译，独立可运行，在可执行文件中"}]},{"ID":"20260506190923-uydjk40","Type":"NodeParagraph","Properties":{"id":"20260506190923-uydjk40","updated":"20260506190930"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动态库"},{"Type":"NodeText","Data":"：编译链接"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"仅记录依赖"},{"Type":"NodeText","Data":"，运行时由系统加载到内存共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"体积小更新无需重编程序，依赖库文件存在才能运行，不在可执行文件中"}]},{"ID":"20260505170804-vuia7jw","Type":"NodeParagraph","Properties":{"id":"20260505170804-vuia7jw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"静态库的优点：移动或分享时只移动可执行文件即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态库的缺点：移动和分享的时候不仅需要提供可执行文件还需要提供 dll\t执行效率会比静态库慢一些"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态库的优点：如果库里代码进行修改不需要重新编译可执行文件，用户重新下载新的动态库的包就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多个可执行文件依赖一个动态库的时候，只需要内存中拷贝一份动态库"}]},{"ID":"20260505170804-fv0zcfp","Type":"NodeParagraph","Properties":{"id":"20260505170804-fv0zcfp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用静态库的步骤：1.包含头文件\t2.导入依赖库 "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"pragma"},{"Type":"NodeText","Data":" comment"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用动态库的步骤：1.包含头文件\t2.导入依赖库 (链接库.lib)#pragma comment\t3.dll 拷贝到 exe 相同路径下"}]},{"ID":"20260505170804-28p942t","Type":"NodeParagraph","Properties":{"id":"20260505170804-28p942t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"加载方式分两种："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态加载"},{"Type":"NodeText","Data":"也叫隐式加载，是指程序在启动时就自动加载依赖的 DLL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用这种方式需要同时准备 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".h"},{"Type":"NodeText","Data":" 头文件、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".lib"},{"Type":"NodeText","Data":" 导入库和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".dll"},{"Type":"NodeText","Data":" 动态库文件，调用方式和普通函数几乎一样，非常简单直观"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它的缺点也很明显：如果缺少对应的 DLL，程序会直接无法启动，依赖关系强，灵活性较差"}]},{"ID":"20260505170804-qolvsmm","Type":"NodeParagraph","Properties":{"id":"20260505170804-qolvsmm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":".h 头文件是函数声明，提供接口说明"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":".lib 导入库是索引文件，帮助程序找到 DLL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":".dll 动态库是真正存放功能代码的文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态加载需要这三个文件一起配合使用"}]},{"ID":"20260505170804-i62s1sh","Type":"NodeParagraph","Properties":{"id":"20260505170804-i62s1sh","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动态加载"},{"Type":"NodeText","Data":"也叫显式加载，是在程序运行过程中手动控制 DLL 的加载与卸载，只需要 .dll 文件即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心通过 Windows API 实现：用 LoadLibrary() 加载 DLL，GetProcAddress() 获取函数地址，FreeLibrary() 卸载 DLL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种方式更灵活，即使 DLL 缺失，程序也能通过异常处理继续运行，健壮性更高，因此在上位机开发中更常用，适合需要按需加载功能模块的场景"}]},{"ID":"20260505170804-6rihowu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6rihowu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"动态链接库怎么装载到内存的？\t\u003e\u003e"}]},{"ID":"20260505170804-4sz3oor","Type":"NodeParagraph","Properties":{"id":"20260505170804-4sz3oor","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"程序启动时，动态链接器先读取可执行文件的依赖信息，找到对应的 .so/.dll 库文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着通过 mmap（Linux）或内存映射 API（Windows）将库文件映射到进程的虚拟地址空间，让进程 “看到” 库的代码和数据段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此时库代码并未真正加载到物理内存，只有当进程访问到某段代码时，才通过缺页中断按需加载到物理内存，同时完成符号解析与地址重定位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把库中的函数地址绑定到进程的调用处，最终让程序能正常调用库函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种方式既实现了多进程共享同一份库代码、节省内存，又保证了加载效率与模块化更新"}]},{"ID":"20260505170804-us6us9x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-us6us9x","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是内存泄漏？内存泄漏的本质是什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-nmsvx0z","Type":"NodeParagraph","Properties":{"id":"20260505170804-nmsvx0z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存泄漏，简单说就是程序向系统申请使用了内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当这块内存不再需要时，却没有正常释放还给系统，导致这部分内存一直被无效占用\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有长生命周期持有短生命周期 、无用对象仍被引用无法回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"随着程序运行时间变长，泄漏的内存越来越多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可用内存越来越少，最终可能造成程序卡顿甚至崩溃"}]},{"ID":"20260505170804-nkt0ao0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nkt0ao0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单例有内存泄漏的问题吗？"},{"Type":"NodeText","Data":"\t\t\u003e\u003e"}]},{"ID":"20260505170804-wnjb6dg","Type":"NodeParagraph","Properties":{"id":"20260505170804-wnjb6dg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单例本身不会产生内存泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它本身就是与应用同生命周期的常驻对象，本该一直存在内存中"}]},{"ID":"20260505170804-hfmkamq","Type":"NodeParagraph","Properties":{"id":"20260505170804-hfmkamq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但单例极易引发内存泄漏，核心原因就是它作为长生命周期对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果持有了 Activity、Context、View 这类短生命周期对象的引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就会导致这些对象本该被销毁回收时却无法释放，进而造成内存泄漏"}]},{"ID":"20260505170804-734u4cd","Type":"NodeParagraph","Properties":{"id":"20260505170804-734u4cd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"安卓"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Activity 是手机上的一个页面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Context 是页面的环境上下文\t\t\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"View 是页面上的按钮、文本等控件，它们都是页面关闭就该释放的短生命周期对象"}]},{"ID":"20260505170804-bwfsc9i","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-bwfsc9i","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 单例，长生命周期\nclass Singleton {\npublic:\n    static Singleton\u0026 instance() {\n        static Singleton ins;\n        return ins;\n    }\n    // 保存一个外部对象的指针\n    void setData(int* data) {\n        m_data = data;\n    }\nprivate:\n    Singleton() {}\n    int* m_data;\n};\n\nvoid func() {\n    // 局部对象，短生命周期\n    int* local_val = new int(123);\n    // 关键：把短生命周期对象交给长生命周期单例持有\n    Singleton::instance().setData(local_val);\n\n    // 函数结束，local_val 这个局部指针没了\n    // 但堆上的 int 被单例一直拿着 → 内存泄漏\n}\nint main() {\n    func();\n    // 程序结束前，这块内存永远泄漏\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-bad2tfz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bad2tfz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单例对象本身是不是长生命周期对象？为什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-6xbddf1","Type":"NodeParagraph","Properties":{"id":"20260505170804-6xbddf1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单例对象本身就是长生命周期对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为单例在整个应用运行过程中只会创建一次，并且会一直存活在内存里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直到应用进程结束才会被销毁，生命周期和应用完全一致"}]},{"ID":"20260505170804-sq2ea1d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-sq2ea1d","updated":"20260524141152"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"局部变量的内存为什么会被泄露？\t\t\t\u003e\u003e"}]},{"ID":"20260505170804-02k6plg","Type":"NodeParagraph","Properties":{"id":"20260505170804-02k6plg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"局部变量本身在方法执行完毕、离开作用域后，其引用会自动失效，不会直接造成内存泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但如果局部变量将创建的对象赋值给了静态变量、单例、长生命周期集合或后台线程等长寿对象持有"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"即便方法结束、局部变量消失，被传递出去的对象依然被强引用保留，变成无用却无法回收的对象，最终形成内存泄漏"}]},{"ID":"20260524141152-cmeiir7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524141152-cmeiir7","updated":"20260524141301"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对同一个资源释放两次会发生什么"}]},{"ID":"20260524141225-aju6j6n","Type":"NodeParagraph","Properties":{"id":"20260524141225-aju6j6n","updated":"20260524141244"},"Children":[{"Type":"NodeText","Data":"对同一个资源释放两次，一般属于 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未定义行为"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最常见的后果是程序崩溃、内存破坏、野指针问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"严重时还可能表现成“这次没事，下次随机炸”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为第二次释放时，这块资源其实已经不归你管理了"}]},{"ID":"20260524141225-9x5x6f2","Type":"NodeParagraph","Properties":{"id":"20260524141225-9x5x6f2","updated":"20260524141301"},"Children":[{"Type":"NodeText","Data":"如果是内存，比如 delete 或 free 同一块地址两次，底层内存管理器的数据结构可能会被破坏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是文件句柄、socket、锁这类资源，也可能导致句柄失效、状态错乱，甚至影响后续逻辑"}]},{"ID":"20260505170804-m7tv0sn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m7tv0sn","updated":"20260524141150"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存泄漏"}]},{"ID":"20260505170804-tmljexr","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-tmljexr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"哪些情况会导致内存泄漏？"}]},{"ID":"20260505170804-4lrtv5c","Type":"NodeParagraph","Properties":{"id":"20260505170804-4lrtv5c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"手动申请空间 没释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"打开的文件没关闭"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"打开库没卸载"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚析构没写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"套接字没关闭"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设备没关闭"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"僵尸进程"}]},{"ID":"20260505170804-fy99qkw","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-fy99qkw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"如何避免？"}]},{"ID":"20260505170804-777ui70","Type":"NodeParagraph","Properties":{"id":"20260505170804-777ui70","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自动管理内存：用 智能指针、STL 容器 代替 new/delete，出作用域自动释放。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"资源配对：手动开的文件、套接字等，谁开谁关，一一对应不遗漏。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类设计规范：基类析构函数写成虚函数，防止释放时析构不完整。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工具检测：用 Valgrind、AddressSanitizer 查内存泄漏。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免僵尸进程：父进程用 wait 收尸，或处理 SIGCHLD 信号。"}]},{"ID":"20260505170804-zex781b","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-zex781b","updated":"20260506191323"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"如何检测？"}]},{"ID":"20260505170804-332wntx","Type":"NodeParagraph","Properties":{"id":"20260505170804-332wntx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代码自查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加日志记录申请 / 释放，核对配对；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"封装 new/malloc 统计次数。"}]},{"ID":"20260505170804-huftmuc","Type":"NodeParagraph","Properties":{"id":"20260505170804-huftmuc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统监控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux 用 top、Windows 看任务管理器，内存只涨不降就是泄漏。"}]},{"ID":"20260505170804-e4lezn2","Type":"NodeParagraph","Properties":{"id":"20260505170804-e4lezn2","updated":"20260506191322"},"Children":[{"Type":"NodeText","Data":"工具检测"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"qt 项目开启 DEBUG 模式，程序正常退出时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Qt 会自动打印未释放的对象，直接在控制台输出泄漏信息"}]},{"ID":"20260506191323-6n1oys1","Type":"NodeParagraph","Properties":{"id":"20260506191323-6n1oys1","updated":"20260506191323"},"Children":[{"Type":"NodeText","Data":"Linux：用 Valgrind、ASAN；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Windows：用 VS 自带检测器、Windbg"}]},{"ID":"20260505170804-l3v8zxn","Type":"NodeParagraph","Properties":{"id":"20260505170804-l3v8zxn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用 Valgrind 时，给程序加上调试信息编译后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"valgrind --leak-check=full"},{"Type":"NodeText","Data":" 命令运行程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会自动检测并输出未释放的内存位置、大小及调用栈"}]},{"ID":"20260505170804-95zwl1v","Type":"NodeParagraph","Properties":{"id":"20260505170804-95zwl1v","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ASAN"},{"Type":"NodeText","Data":" 使用更简单，编译时添加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"-fsanitize=address"},{"Type":"NodeText","Data":" 选项"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"运行程序后控制台会直接打印泄漏、越界等错误信息，检测速度比 Valgrind 更快"}]},{"ID":"20260505170804-hmcvr4d","Type":"NodeParagraph","Properties":{"id":"20260505170804-hmcvr4d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Windows 环境下，我会使用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"VS 自带的内存诊断工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在调试模式下运行程序，通过快照对比直观查看内存增长与泄漏点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也会使用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"WinDbg"},{"Type":"NodeText","Data":" 进行高级调试，结合页堆分析定位复杂的内存问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这几种工具能高效覆盖不同场景下的内存泄漏检测需求"}]},{"ID":"20260505170804-xp0vju0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xp0vju0","updated":"20260526102657"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Valgrind 的底层实现"}]},{"ID":"20260505170804-jmzirl0","Type":"NodeParagraph","Properties":{"id":"20260505170804-jmzirl0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Valgrind = 模拟 CPU 执行 + 影子内存状态跟踪 + 内存分配释放监控"}]},{"ID":"20260505170804-5efv9ea","Type":"NodeParagraph","Properties":{"id":"20260505170804-5efv9ea","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Valgrind 底层核心是通过模拟 CPU 执行来实现内存检测的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会为程序的每一块内存维护一套影子内存（shadow memory）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来标记这块内存的状态：是否可访问、是否已初始化、归属哪个 malloc"}]},{"ID":"20260505170804-09bw2ro","Type":"NodeParagraph","Properties":{"id":"20260505170804-09bw2ro","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在程序运行时，Valgrind 会逐条指令拦截并检查所有内存操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦出现越界访问、使用野指针、读取未初始化内存等非法行为，就立刻报错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时它会全程跟踪 malloc/free/new/delete，记录每块堆内存的生命周期"}]},{"ID":"20260505170804-235pgx2","Type":"NodeParagraph","Properties":{"id":"20260505170804-235pgx2","updated":"20260506191633"},"Children":[{"Type":"NodeText","Data":"程序退出前，Valgrind 会扫描所有堆内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把已经分配但没有释放、也没有指针指向的内存标记为内存泄漏，最终汇总输出泄漏报告"}]},{"ID":"20260526102652-1qaoodi","Type":"NodeParagraph","Properties":{"id":"20260526102652-1qaoodi","updated":"20260526102657"},"Children":[{"Type":"NodeText","Data":"它不是假跑，程序是真跑了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但也不是直接跑在原始指令上，而是先被 Valgrind 接管、翻译、插桩后再执行"}]},{"ID":"20260505170804-ei897q9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ei897q9","updated":"20260506191535"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"OOM"}]},{"ID":"20260505170804-6otxkzl","Type":"NodeParagraph","Properties":{"id":"20260505170804-6otxkzl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"OOM 就是 Out Of Memory，指内存溢出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序申请内存时，系统已经没有足够的空闲内存可以分配，导致程序崩溃或者被系统直接杀掉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常见场景比如一直创建对象不释放、内存泄漏越积越多、加载超大图片或数据、缓存无限制增长，都会触发 OOM"}]},{"ID":"20260505170804-2c1xeiz","Type":"NodeParagraph","Properties":{"id":"20260505170804-2c1xeiz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"出现 OOM 一般从这几方面排查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先看日志定位是堆溢出、栈溢出还是直接内存溢出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再用内存分析工具查看对象引用情况，找出泄漏点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后优化代码，比如及时释放资源、避免无限创建对象、合理使用缓存、控制大内存对象生命周期，从根源避免内存持续占用导致溢出"}]},{"ID":"20260505170804-62z4krt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-62z4krt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 内存分为几个区域？\t\u003e\u003e"}]},{"ID":"20260505170804-r4tpmme","Type":"NodeParagraph","Properties":{"id":"20260505170804-r4tpmme","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"栈区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由编译器自动分配和释放，用于存放函数的参数值、局部变量等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存分配连续且效率高，遵循后进先出原则，函数执行结束后相关内存会自动回收"}]},{"ID":"20260505170804-6vgqt1y","Type":"NodeParagraph","Properties":{"id":"20260505170804-6vgqt1y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"堆区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由程序员手动分配和释放，通过 new/malloc 申请、delete/free 释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若不主动释放会造成内存泄漏，堆空间不连续、分配灵活，但效率相对较低"}]},{"ID":"20260505170804-qw6nfje","Type":"NodeParagraph","Properties":{"id":"20260505170804-qw6nfje","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局 / 静态区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存放全局变量和静态变量，程序运行期间一直存在，初始化的全局和静态变量在一块区域"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"未初始化的在另一块相邻区域，程序结束后由系统释放"}]},{"ID":"20260505170804-qwpl6dq","Type":"NodeParagraph","Properties":{"id":"20260505170804-qwpl6dq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常量区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要存放字符串常量、const 修饰的常量等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这块内存不允许修改，程序结束后由系统回收"}]},{"ID":"20260505170804-ckjousw","Type":"NodeParagraph","Properties":{"id":"20260505170804-ckjousw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代码区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用于存放程序执行的二进制机器指令，这部分区域通常是只读的，防止被意外修改，程序运行时指令从这里加载执行"}]},{"ID":"20260505170804-4emyfo8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4emyfo8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存分区和分段是一个意思吗？\t\t\u003e\u003e"}]},{"ID":"20260505170804-azaamsu","Type":"NodeParagraph","Properties":{"id":"20260505170804-azaamsu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存分区"},{"Type":"NodeText","Data":"，是写程序时，从"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"逻辑和语言层面"},{"Type":"NodeText","Data":"对虚拟地址空间做的划分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如代码区、全局静态区、栈区、堆区这些"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它主要是为了管理不同数据的生命周期、访问权限和存储方式，是编译器和程序运行时的概念"}]},{"ID":"20260505170804-6vk8our","Type":"NodeParagraph","Properties":{"id":"20260505170804-6vk8our","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存分段"},{"Type":"NodeText","Data":"，是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"操作系统和硬件底层"},{"Type":"NodeText","Data":"的内存管理机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如早期的代码段、数据段、栈段这种硬件分段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它是 CPU 用来做地址隔离、权限控制、寻址的一种方式，属于系统底层怎么管理物理内存的问题"}]},{"ID":"20260505170804-jvoyhdy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jvoyhdy","updated":"20260506191947"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 代码异常 core dump 会生成一个栈，里面内容是什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-w0o95ct","Type":"NodeParagraph","Properties":{"id":"20260505170804-w0o95ct","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"栈内容就是程序崩溃前的 “现场录像”，能帮你顺着调用链找到哪里出了问题，以及当时的变量状态"}]},{"ID":"20260505170804-2ud8zdf","Type":"NodeParagraph","Properties":{"id":"20260505170804-2ud8zdf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主要包含这些信息："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数调用链：从崩溃的那个函数开始，一层层往上列所有调用它的函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 A 调用 B，B 调用 C，C 崩溃了，栈里就会显示 C → B → A 的顺序，能看出 “崩溃是从哪个入口一步步走到这里的”"}]},{"ID":"20260505170804-8fvgczu","Type":"NodeParagraph","Properties":{"id":"20260505170804-8fvgczu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每个函数的地址：记录每个函数在内存中的具体地址（比如 0x400520 ）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结合编译时的符号表（如果没被 strip 掉），就能对应到具体是哪个函数（比如 main () 、 func () ）"}]},{"ID":"20260505170804-oda7wss","Type":"NodeParagraph","Properties":{"id":"20260505170804-oda7wss","updated":"20260506191947"},"Children":[{"Type":"NodeText","Data":"函数的参数和局部变量："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个函数调用时传入的参数值、以及函数内部定义的临时变量（比如 int a=5 中的 a ）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会按栈的顺序保存"}]},{"ID":"20260505170804-f3wb8yn","Type":"NodeParagraph","Properties":{"id":"20260505170804-f3wb8yn","updated":"20260506191942"},"Children":[{"Type":"NodeText","Data":"这能帮你排查 “是不是参数传错了”“变量值是不是异常了”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈指针位置：记录崩溃时栈顶的位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"告诉你当前栈用到了哪里，有没有溢出（比如栈被写满了）"}]},{"ID":"20260505170804-ijd0gsl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ijd0gsl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"临界区是什么\t\t\u003e\u003e"}]},{"ID":"20260505170804-solkbps","Type":"NodeParagraph","Properties":{"id":"20260505170804-solkbps","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"临界区是指并发程序中，多个线程会竞争访问的共享数据或代码区域"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同一时间只允许一个线程进入执行，否则会导致数据竞争、结果错乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以必须用互斥锁、信号量等同步机制保护"}]},{"ID":"20260505170804-jshdhin","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jshdhin","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Main 函数之前怎么运行一个函数\t\t\u003e\u003e"}]},{"ID":"20260505170804-5mvv5b3","Type":"NodeParagraph","Properties":{"id":"20260505170804-5mvv5b3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 C++ 中，全局对象、静态全局对象的构造函数，会在 main 函数执行之前自动调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这是 C++ 标准规定的初始化顺序"}]},{"ID":"20260505170804-mgq6393","Type":"NodeParagraph","Properties":{"id":"20260505170804-mgq6393","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"所以可以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"把需要提前执行的逻辑封装在类的构造函数里，定义一个全局对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就能实现 main 之前运行代码"}]},{"ID":"20260505170804-n4s0yft","Type":"NodeParagraph","Properties":{"id":"20260505170804-n4s0yft","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次还可以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"利用全局变量初始化表达式，在全局变量赋值时直接调用函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++11 及以上还能"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用 lambda 匿名函数简化写法"},{"Type":"NodeText","Data":"，实现同样的前置执行效果，但这种写法可读性稍差。"}]},{"ID":"20260505170804-8ge4lxg","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ge4lxg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外 GCC 编译器提供 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"__attribute__((constructor))"},{"Type":"NodeText","Data":" 扩展属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以直接标记函数在 main 前执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过它是非标准语法、不跨平台，Windows VS 无法使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试里一定要说明它是编译器特性，不是 C++ 标准"}]},{"ID":"20260505170804-q18fm6q","Type":"NodeParagraph","Properties":{"id":"20260505170804-q18fm6q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局对象构造 →main 执行 →main 结束 → 全局对象析构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前置执行逻辑不能依赖其他未初始化全局变量，容易出现静态初始化顺序问题"}]},{"ID":"20260505170804-f35u407","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f35u407","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"大端存储、小端存储\t\t\u003e\u003e"}]},{"ID":"20260505170804-1qx4jax","Type":"NodeParagraph","Properties":{"id":"20260505170804-1qx4jax","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大端和小端，是多字节数据在内存里的存放顺序，也就是主机字节序"}]},{"ID":"20260505170804-go2qdwo","Type":"NodeParagraph","Properties":{"id":"20260505170804-go2qdwo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大端存储是高位字节放在低地址，低位字节放在高地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络字节序就是标准大端序"}]},{"ID":"20260505170804-qvirk2b","Type":"NodeParagraph","Properties":{"id":"20260505170804-qvirk2b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"小端存储是低位字节放在低地址，高位字节放在高地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"x86、ARM 主流 PC 和手机 CPU 全都是小端序"}]},{"ID":"20260505170804-pqvquqe","Type":"NodeParagraph","Properties":{"id":"20260505170804-pqvquqe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因为 CPU 硬件设计原因，运算效率更高，但肉眼看内存完全是反的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络传输必须统一转成大端，否则不同字节序的主机通信会数据错乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以发送数据前主机序转网络大端，接收后网络大端转回本机小端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IP、端口、长度字段都要这么处理"}]},{"ID":"20260505170804-k402bip","Type":"NodeParagraph","Properties":{"id":"20260505170804-k402bip","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 为什么用小端？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 设计成小端，是为了硬件运算效率更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 做加减法、进位运算时，都是从低位字节开始计算，小端把低位字节放在内存低地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"硬件读取、进位判断、字节扩展都更快更简单，电路设计也更简单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且现代 x86、ARM 处理器全都是小端，这是主机本地存储的默认规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络为什么必须用大端？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络字节序强制大端，是为了协议可读性、兼容性、解析顺序统一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络数据是一段一段流式接收的，先收到的字节就是高位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和我们平时书写数字、阅读报文的顺序完全一致"}]},{"ID":"20260505170804-tagp17g","Type":"NodeParagraph","Properties":{"id":"20260505170804-tagp17g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"设备拿到报文不用判断对方是什么 CPU、什么字节序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接按从前到后的顺序解析高位到低位，就能得到正确数值"}]},{"ID":"20260505170804-7hj3uzw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7hj3uzw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网络字节序\t\t\u003e\u003e"}]},{"ID":"20260505170804-aei276y","Type":"NodeParagraph","Properties":{"id":"20260505170804-aei276y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"网络字节序本质上就是大端字节序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 TCP/IP 协议统一规定的网络传输标准"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同 CPU 主机字节序不一样，有的小端有的大端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果直接发送内存数据，对方收到就会解析错误，所以网络传输必须统一字节序"}]},{"ID":"20260505170804-bbsgqzm","Type":"NodeParagraph","Properties":{"id":"20260505170804-bbsgqzm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主机字节序是本机 CPU 存储数据的顺序，x86 架构电脑都是小端序，低位字节存在低地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而网络强制规定所有数据发送前，都要转换成大端序（高位字节在前）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收方再转回主机字节序"}]},{"ID":"20260505170804-0eo32sc","Type":"NodeParagraph","Properties":{"id":"20260505170804-0eo32sc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编程中用 htonl、htons 等库函数完成主机序转网络序，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"tohl、ntohs 完成网络序转主机序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要涉及网络收发整型数据，端口、IP 地址、长度字段都必须字节序转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接拷贝内存发送一定会出现数据错乱问题"}]},{"ID":"20260505170804-podpc44","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-podpc44","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"不用程序的 main 函数的虚拟地址是一样的吗"}]},{"ID":"20260505170804-sxphlfn","Type":"NodeParagraph","Properties":{"id":"20260505170804-sxphlfn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不同程序的虚拟地址"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不一样"}]},{"ID":"20260505170804-piidlak","Type":"NodeParagraph","Properties":{"id":"20260505170804-piidlak","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每个程序运行都是独立进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统会给每个进程分配"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"独立隔离"},{"Type":"NodeText","Data":"的虚拟地址空间，天然互不通用"}]},{"ID":"20260505170804-315p8tn","Type":"NodeParagraph","Properties":{"id":"20260505170804-315p8tn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"即便都没有 main 函数，内存布局结构相似"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但系统的地址随机化机制会让基地址不同，所以虚拟地址不会相同"}]},{"ID":"20260505170804-nkpfdwk","Type":"NodeParagraph","Properties":{"id":"20260505170804-nkpfdwk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"地址随机化（ASLR）是操作系统的安全机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序每次运行时，会随机化代码段、库、栈、堆等内存基地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目的是破坏固定地址，防止黑客利用固定内存地址发起溢出、漏洞攻击"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就算代码一致，每次运行虚拟地址都不一样"}]},{"ID":"20260505170804-8kdrcrm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8kdrcrm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"知道代码的坏味道吗"}]},{"ID":"20260505170804-bl6fxk3","Type":"NodeParagraph","Properties":{"id":"20260505170804-bl6fxk3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代码坏味道，就是代码写法不规范、结构差、隐藏隐患，看着没问题，但难维护、难扩展"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常见表现：代码冗余、重复代码、函数过长、类职责混乱、变量命名随意、嵌套太深"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有魔法数值、大量硬编码、参数过多、耦合度高、注释缺失这些问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质是设计不合理、缺乏封装和解耦，长期会导致改 bug 容易出新问题，维护成本暴增"}]},{"ID":"20260505170804-xm243vd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xm243vd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"回调函数了解吗?"}]},{"ID":"20260505170804-vfcxm5l","Type":"NodeParagraph","Properties":{"id":"20260505170804-vfcxm5l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"回调函数，就是把函数地址当作参数，传给另一个函数，不主动调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由对方在合适时机自动执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心作用是解耦业务逻辑，提高代码复用性和灵活性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用于异步处理、事件触发、定时器、网络请求、框架底层逻辑，不需要循环等待，效率更高"}]},{"ID":"20260505170804-zy61mwq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-zy61mwq","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n// 回调函数\nvoid task(int num)\n{\n    printf(\"回调执行，数字：%d\\n\", num);\n}\n\n// 注册并触发回调的函数\nvoid handle(int x, void (*cb)(int))\n{\n    // 满足条件时，主动调用传进来的函数\n    if (x \u003e 5)\n    {\n        cb(x); \n    }\n}\nint main()\n{\n    // 把task函数地址传进去，作为回调\n    handle(10, task);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-nq0e2jf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nq0e2jf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 常见的异常和泄露场景以及解决方案"}]},{"ID":"20260505170804-0k5rhql","Type":"NodeParagraph","Properties":{"id":"20260505170804-0k5rhql","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"日常最容易出问题的就是空指针、野指针和数组越界，直接访问就会程序崩溃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后是除零运算、非法的动态类型转换，还有容器下标越界、文件打开失败这类 IO 错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"态场景下错误调用虚函数也会触发异常崩溃"}]},{"ID":"20260505170804-ba7mf3n","Type":"NodeParagraph","Properties":{"id":"20260505170804-ba7mf3n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常见内存与资源泄露场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要是手动 new 申请内存后没 delete、中途 return 或抛异常跳过释放逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次是循环里频繁创建堆对象不回收、类里裸指针成员析构函数没释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有文件句柄、套接字、锁、数据库连接这类系统资源，打开加锁后没关闭解锁"}]},{"ID":"20260505170804-d9vmhu9","Type":"NodeParagraph","Properties":{"id":"20260505170804-d9vmhu9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优先用智能指针 unique_ptr、shared_ptr 代替裸指针，自动管理内存，不用手动释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"关键代码块用 try-catch 捕获异常，避免异常打断资源释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"临界资源用 RAII 思想，对象生命周期绑定资源，自动析构回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"访问指针先判空，容器尽量用 at 方法做边界检查，减少越界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类析构严格释放成员资源，杜绝中途漏释放，文件、锁、网络资源用完立刻主动关闭释放"}]},{"ID":"20260505170804-ograc31","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ograc31","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"代码编译后只剩二进制，程序崩溃怎么排查根源"}]},{"ID":"20260505170804-289lpk6","Type":"NodeParagraph","Properties":{"id":"20260505170804-289lpk6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"程序编译后崩溃 99% 是这 4 类原因："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"空指针 / 野指针访问（最常见）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数组越界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈溢出（递归死循环、超大局部变量）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存重复释放 /double free"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二进制无源码时，目标是找到崩溃的内存地址、调用栈、触发条件"}]},{"ID":"20260505170804-fjgwuy6","Type":"NodeParagraph","Properties":{"id":"20260505170804-fjgwuy6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"无源码二进制崩溃排查，按这个顺序来："}]},{"ID":"20260505170804-a5hg4pn","Type":"NodeParagraph","Properties":{"id":"20260505170804-a5hg4pn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"拿崩溃现场：core/dmp 文件、崩溃地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查地址映射：addr2line/VS 直接定位函数 / 行号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调试器分析：GDB/WinDbg 看调用栈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"黑盒工具：strace/valgrind 辅助定位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对照特征：快速判断空指针 / 越界 / 栈溢出"}]},{"ID":"20260505170804-5lygb1x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5lygb1x","updated":"20260506192500"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"自我销毁-delete this 会发生什么情况"}]},{"ID":"20260505170804-faukg2t","Type":"NodeParagraph","Properties":{"id":"20260505170804-faukg2t","updated":"20260506192500"},"Children":[{"Type":"NodeText","Data":"delete this 是类成员函数里销毁自身对象，会调用析构函数并释放堆内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行后 this 指针立即失效，后续再访问成员就是未定义行为"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能用于 new 出来的堆对象，不能用在栈对象、全局对象和 new [] 数组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"严禁在析构函数内部调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"delete 第一步就是调用析构函数，会递归死循环、栈溢出崩溃，开发里尽量少用"}]},{"ID":"20260505170804-hadiz8y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hadiz8y","updated":"20260506165254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果在栈对象上 destroy 会发生什么"}]},{"ID":"20260505170804-qd96yet","Type":"NodeParagraph","Properties":{"id":"20260505170804-qd96yet","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"栈对象本身由系统自动分配、自动回收，不能手动 delete"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果强行对栈对象执行 delete 或 delete this："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会重复释放内存，破坏栈内存布局，直接触发未定义行为"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大概率程序崩溃、栈损坏、内存越界"}]},{"ID":"20260506165254-24kdn6x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260506165254-24kdn6x","updated":"20260509092550"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对代码规范的看法"}]},{"ID":"20260506165442-t8a3mfa","Type":"NodeParagraph","Properties":{"id":"20260506165442-t8a3mfa","updated":"20260506165633"},"Children":[{"Type":"NodeText","Data":"代码规范是团队开发的基础"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先统一编码风格、命名格式、注释标准，能让每个人写的代码可读性都差不多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"别人接手、翻看老代码不用重新适应风格，节省大量沟通和理解成本"}]},{"ID":"20260506165442-ezjclf4","Type":"NodeParagraph","Properties":{"id":"20260506165442-ezjclf4","updated":"20260506165642"},"Children":[{"Type":"NodeText","Data":"其次代码规范能提前规避很多低级 bug"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如变量定义、异常捕获、资源释放这些都按统一标准来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能减少漏写、不规范写法带来的隐患，也方便后续代码审查、排查问题"}]},{"ID":"20260506165442-fs5tc15","Type":"NodeParagraph","Properties":{"id":"20260506165442-fs5tc15","updated":"20260506165711"},"Children":[{"Type":"NodeText","Data":"另外规范也利于项目维护和迭代"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后期扩容、重构、多人协作开发时，有统一标准就不会越写越乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"方便做版本管理、单元测试和后续交接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单说，代码规范不是约束个人，而是为了团队高效协作、项目长期稳定"}]},{"ID":"20260509092550-r2s9cwl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260509092550-r2s9cwl","updated":"20260516090219"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"windbg 有用过吗"}]},{"ID":"20260509092550-gnflfz0","Type":"NodeParagraph","Properties":{"id":"20260509092550-gnflfz0","updated":"20260509092117"},"Children":[{"Type":"NodeText","Data":"用过，WinDbg 是 Windows 平台下用户态和内核态都能用的调试器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用来分析崩溃 dump、死锁、内存越界、蓝屏这类底层问题"}]},{"ID":"20260509092550-djvlgds","Type":"NodeParagraph","Properties":{"id":"20260509092550-djvlgds","updated":"20260509092131"},"Children":[{"Type":"NodeText","Data":"平时用得最多的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"离线分析 dmp"},{"Type":"NodeText","Data":"："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".sympath"},{"Type":"NodeText","Data":" ​设符号路径、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".reload"},{"Type":"NodeText","Data":" ​加载符号，再用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" ​自动分析崩溃原因"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能直接定位到出错的函数和调用栈"}]},{"ID":"20260509092550-o6fonq8","Type":"NodeParagraph","Properties":{"id":"20260509092550-o6fonq8","updated":"20260509092138"},"Children":[{"Type":"NodeText","Data":"也会用来"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动态 attach 进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设断点、单步执行（t/p）、看线程栈（"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"~"}]},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"*"}]},{"Type":"NodeText","Data":"kb）、查内存（d 命令）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定位死循环、死锁、句柄泄漏这类问题"}]},{"ID":"20260509092550-7kv5boj","Type":"NodeParagraph","Properties":{"id":"20260509092550-7kv5boj","updated":"20260509092448"},"Children":[{"Type":"NodeText","Data":"和 VS 调试相比，它更适合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无源码调试、生产环境问题、内核 / 驱动调试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命令行能力强、可脚本化，适合复杂底层问题排查"}]},{"ID":"20260516090219-8oujxxv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516090219-8oujxxv","updated":"20260516091409"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 如何阻止类被实例化"}]},{"ID":"20260516090219-6gc6cit","Type":"NodeParagraph","Properties":{"id":"20260516090219-6gc6cit","updated":"20260516090125"},"Children":[{"Type":"NodeText","Data":"第一种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把构造函数设为私有，外部调不了构造函数就没法创建对象"}]},{"ID":"20260516090219-dz6h3wg","Type":"NodeParagraph","Properties":{"id":"20260516090219-dz6h3wg","updated":"20260516090147"},"Children":[{"Type":"NodeText","Data":"第二种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给类加一个纯虚函数，让它变成抽象类，语法上就禁止实例化"}]},{"ID":"20260516090219-4hmu6dn","Type":"NodeParagraph","Properties":{"id":"20260516090219-4hmu6dn","updated":"20260516090149"},"Children":[{"Type":"NodeText","Data":"一般工具类用私有构造，接口类用抽象类就行"}]},{"ID":"20260516091409-yscc5zd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516091409-yscc5zd","updated":"20260516130652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"构造函数析构函数是否能抛出异常"}]},{"ID":"20260516091409-tj94xcp","Type":"NodeParagraph","Properties":{"id":"20260516091409-tj94xcp","updated":"20260516090502"},"Children":[{"Type":"NodeText","Data":"构造函数：允许抛异常，也推荐抛"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"构造失败（资源申请失败、参数非法）时，抛出异常能保证对象不生效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 会自动回收已分配内存，安全可靠"}]},{"ID":"20260516091409-rh9ac0c","Type":"NodeParagraph","Properties":{"id":"20260516091409-rh9ac0c","updated":"20260516090918"},"Children":[{"Type":"NodeText","Data":"析构函数：禁止抛异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"析构函数异常会直接导致程序崩溃、资源泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果析构里可能出错，必须内部 catch 吞掉，绝对不能往外抛"}]},{"ID":"20260516091409-pqxfepk","Type":"NodeParagraph","Properties":{"id":"20260516091409-pqxfepk","updated":"20260516090938"},"Children":[{"Type":"NodeText","Data":"首先，程序出异常时会自动销毁一堆对象，这个过程叫栈展开"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果析构函数这时候再抛出新异常，等于一个异常还没处理完"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"又来一个，C++ 直接判定没法救，程序直接崩"}]},{"ID":"20260516091409-8k5jlqs","Type":"NodeParagraph","Properties":{"id":"20260516091409-8k5jlqs","updated":"20260516090953"},"Children":[{"Type":"NodeText","Data":"其次，析构就是用来清理资源、收尾的。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"收尾的时候还抛异常，资源释放就乱套了，内存泄漏、锁没释放这些问题都会来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且新标准里析构默认是不允许抛异常的，抛了直接报错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以析构里有问题，自己内部处理掉，千万别往外抛"}]},{"ID":"20260516130652-lsmm05t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516130652-lsmm05t","updated":"20260519163926"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 异常处理的方法"}]},{"ID":"20260516130652-8zp93xt","Type":"NodeParagraph","Properties":{"id":"20260516130652-8zp93xt","updated":"20260516125415"},"Children":[{"Type":"NodeText","Data":"C++ 异常处理核心就是用 try、catch、throw 三个关键字"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理程序运行时的非预期错误，让程序不直接崩溃，还能优雅回收资源、提示问题"}]},{"ID":"20260516130652-0egq9ba","Type":"NodeParagraph","Properties":{"id":"20260516130652-0egq9ba","updated":"20260516130304"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"首先 throw 抛出异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数里遇到非法操作（比如除零、空指针、文件打不开），不用返回错误码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接 throw 抛出自定义异常，终止当前代码执行"}]},{"ID":"20260516130652-18hndv9","Type":"NodeParagraph","Properties":{"id":"20260516130652-18hndv9","updated":"20260516130420"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"try 捕获异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把可能出错的代码包在 try 代码里，一旦块内 throw 异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就会立刻跳转到匹配的 catch，不会继续执行 try 里的后续代码"}]},{"ID":"20260516130652-gkba39w","Type":"NodeParagraph","Properties":{"id":"20260516130652-gkba39w","updated":"20260516130551"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最后 catch 处理异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"catch 按异常类型匹配捕获，能精准处理对应错误，还可以写多个 catch 处理不同异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后用 catch(...)捕获所有未知异常兜底，避免程序闪退"}]},{"ID":"20260516130652-2e17xi4","Type":"NodeParagraph","Properties":{"id":"20260516130652-2e17xi4","updated":"20260516130637"},"Children":[{"Type":"NodeText","Data":"还有两个关键点："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异常安全"},{"Type":"NodeText","Data":"，用 RAII（智能指针、容器）自动释放内存、锁等资源，防止异常导致资源泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不要滥用"},{"Type":"NodeText","Data":"，异常只处理运行时错误，别用来控制正常流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也别在析构函数里抛异常，会触发程序终止"}]},{"ID":"20260519163926-b2rap21","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519163926-b2rap21","updated":"20260519164011"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"从汇编角度看虚函数的调用全过程"}]},{"ID":"20260519163926-l574o9f","Type":"NodeParagraph","Properties":{"id":"20260519163926-l574o9f","updated":"20260519125346"},"Children":[{"Type":"NodeText","Data":"从汇编角度看，虚函数调用本质就三步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先拿对象里的虚表指针 vptr，再去虚表 vtable 里按偏移取出目标函数地址，最后做一次间接调用 call"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它和普通函数最大的区别是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通函数基本是直接 call 固定地址，虚函数是运行时查表之后再调用"}]},{"ID":"20260519163926-iypdih0","Type":"NodeParagraph","Properties":{"id":"20260519163926-iypdih0","updated":"20260519125559"},"Children":[{"Type":"NodeText","Data":"虚函数的性能开销主要就来自一次取 vptr、一次查虚表、一次间接跳转"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上是一点运时开销换动态绑定能力"}]},{"ID":"20260519163926-f7h889j","Type":"NodeParagraph","Properties":{"id":"20260519163926-f7h889j","updated":"20260519125725"},"Children":[{"Type":"NodeText","Data":"call 的作用有两个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是把下一条指令地址压栈保存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是跳转到目标函数执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数结束后通过 ret 回到原来的位置"}]},{"ID":"20260519164011-jr5x9u8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164011-jr5x9u8","updated":"20260519141209"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 中的 inline 关键字有什么作用？有什么缺点？是否可以用于虚函数"}]},{"ID":"20260519164011-c390yc7","Type":"NodeParagraph","Properties":{"id":"20260519164011-c390yc7","updated":"20260519140951"},"Children":[{"Type":"NodeText","Data":"inline 的核心作用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一是建议编译器把函数调用展开，减少函数调用开销\n二是允许函数定义放在头文件里，避免多个源文件包含时出现重复定义"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":" 所以它不只是“性能优化关键字”，还有链接层面的作用"}]},{"ID":"20260519164011-1o59kwx","Type":"NodeParagraph","Properties":{"id":"20260519164011-1o59kwx","updated":"20260519141014"},"Children":[{"Type":"NodeText","Data":"它的缺点也比较明显"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第一，inline"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只是建议，编译器不一定真的内联\n第二，如果函数体比较大，强行内联可能让代码膨胀，反而影响缓存命中率\n第三，调试时也可能没普通函数直观"},{"Type":"NodeText","Data":"\t 所以它更适合短小、频繁调用的函数"}]},{"ID":"20260519164011-7zmy7oo","Type":"NodeParagraph","Properties":{"id":"20260519164011-7zmy7oo","updated":"20260519141209"},"Children":[{"Type":"NodeText","Data":"至于能不能用于虚函数，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"语法上可以，定义虚函数时也能写"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"inline\n但是如果是通过基类指针或引用发生动态绑定，那这种调用通常没法在编译期直接内联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它调用哪个函数要等运行时才能确定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有在编译器已经明确知道对象真实类型、可以去虚拟化的时候，才有可能内联"}]},{"ID":"20260519164011-tx0nq8o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164011-tx0nq8o","updated":"20260519143408"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"在头文件里定义一个全局静态变量，它存在进程地址空间的哪里？如果被多个源文件包含会怎样？"}]},{"ID":"20260519164011-bxkr6lk","Type":"NodeParagraph","Properties":{"id":"20260519164011-bxkr6lk","updated":"20260519142022"},"Children":[{"Type":"NodeText","Data":"在头文件里定义一个全局变量，比如 static int g_val=10;"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"那它一般放在静态存储区，具体看是否初始化，通常是在.data 段或.bss 段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"生命周期是整个程序运行期间一直存在"}]},{"ID":"20260519164011-8wn9q3d","Type":"NodeParagraph","Properties":{"id":"20260519164011-8wn9q3d","updated":"20260519143229"},"Children":[{"Type":"NodeText","Data":"但它前面的 static 很关键，它表示内部链接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以这个头文件如果被多个.cpp 包含"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个源文件都会各自生成一份独立的 g_val"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"他们的名字一样，但其实不是同一个变量，彼此互不影响"}]},{"ID":"20260519164011-379nlrm","Type":"NodeParagraph","Properties":{"id":"20260519164011-379nlrm","updated":"20260519143042"},"Children":[{"Type":"NodeText","Data":"内部链接就是“名字不对外暴露，只在当前编译单元有效”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外部链接就是“别的源文件也能通过声明访问到它”"}]},{"ID":"20260519164011-q97b4y0","Type":"NodeParagraph","Properties":{"id":"20260519164011-q97b4y0","updated":"20260519143408"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头文件里也不能随便定义普通全局变量\n因为一旦被多个源文件包含，会造成多重定义\n正确做法一般是在头文件里"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"extern"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"声明，在某一个"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":".cpp"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"里真正定义"}]},{"ID":"20260519164011-gchcym3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164011-gchcym3","updated":"20260519164031"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 程序代码为什么要经过 4 个阶段才能执行？"}]},{"ID":"20260519164011-74ve48o","Type":"NodeParagraph","Properties":{"id":"20260519164011-74ve48o","updated":"20260519144746"},"Children":[{"Type":"NodeText","Data":"因为 C++ 是高级语言，而 CPU 只能执行机器指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以必须经过“处理源码、生成目标代码、转换机器指令、整合所有模块”这几步"}]},{"ID":"20260519164031-ve2xg7t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164031-ve2xg7t","updated":"20260519164045"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 代码怎么管理对象的内存"}]},{"ID":"20260519164031-ox3o7n4","Type":"NodeParagraph","Properties":{"id":"20260519164031-ox3o7n4","updated":"20260519145628"},"Children":[{"Type":"NodeText","Data":"C++ 里对象内存管理，核心就三种："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栈上对象、堆上对象、静态存储区对象"}]},{"ID":"20260519164031-ke88z4o","Type":"NodeParagraph","Properties":{"id":"20260519164031-ke88z4o","updated":"20260519145644"},"Children":[{"Type":"NodeText","Data":"最常见的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栈上对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如函数里直接定义一个局部对象，它会随着作用域结束自动析构，这种方式最安全，成本也低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"堆上对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 new 创建，生命周期由程序员控制，需要手动 delete，或者更常见地交给智能指针管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不然就容易内存泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全局对象、静态对象"},{"Type":"NodeText","Data":"，它们放在静态存储区，程序启动时分配，程序结束时释放"}]},{"ID":"20260519164031-w9o1vbs","Type":"NodeParagraph","Properties":{"id":"20260519164031-w9o1vbs","updated":"20260519145700"},"Children":[{"Type":"NodeText","Data":"现在更强调 RAII，也就是把资源生命周期绑定到对象生命周期"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量少直接  new/delete，优先用栈对象、容器和智能指针来管理内存"}]},{"ID":"20260519164045-9011a9z","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164045-9011a9z","updated":"20260519164103"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是垃圾回收机制"}]},{"ID":"20260519164045-du9rtni","Type":"NodeParagraph","Properties":{"id":"20260519164045-du9rtni","updated":"20260519150008"},"Children":[{"Type":"NodeText","Data":"垃圾回收机制，就是程序自动识别“哪些内存已经没人用了”，然后自动把它释放掉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":" 也就是说，程序员申请了内存之后，不需要自己手动 free 或 delete，运行时系统会帮你回收"}]},{"ID":"20260519164045-g4g5hgp","Type":"NodeParagraph","Properties":{"id":"20260519164045-g4g5hgp","updated":"20260519150018"},"Children":[{"Type":"NodeText","Data":"它的核心目标是解决两个问题："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少内存泄漏，还有避免手动释放带来的悬空指针、重复释放这类错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像 Java、Go 这类语言里，垃圾回收比较常见"}]},{"ID":"20260519164045-bh02zwc","Type":"NodeParagraph","Properties":{"id":"20260519164045-bh02zwc","updated":"20260519150028"},"Children":[{"Type":"NodeText","Data":"如果放到 C++ 里说，C++ 默认没有传统意义上的 GC，它主要靠程序员自己管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者靠 RAII、智能指针、容器这些方式做资源管理"}]},{"ID":"20260519164045-fy09juz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164045-fy09juz","updated":"20260519164226"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"移动构造函数与移动赋值运算符的区别是什么？"}]},{"ID":"20260519164045-gk7172g","Type":"NodeParagraph","Properties":{"id":"20260519164045-gk7172g","updated":"20260519150242"},"Children":[{"Type":"NodeText","Data":"核心区别是发生时机不一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"移动构造是用一个右值去创建一个新对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"移动赋值是一个已经存在的对象，用右值给他重新赋值"}]},{"ID":"20260519164045-pyge0ra","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260519164045-pyge0ra","updated":"20260519150404"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"String a =std::move(b);\t//移动构造\na=str::move(c);\t\t//移动赋值\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260519164226-htgzu8m","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-htgzu8m","updated":"20260519155748"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++20 和 C++17 有什么新功能"}]},{"ID":"20260519164226-mpp170r","Type":"NodeParagraph","Properties":{"id":"20260519164226-mpp170r","updated":"20260519155748"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C++17"},{"Type":"NodeText","Data":" 主要是让 C++ ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"更好写了"},{"Type":"NodeText","Data":"​。比如写判断更灵活了，有结构化绑定可以像“拆包”一样拿数据，标准库里也多了 optional、variant、文件系统这些常用工具，意思就是很多以前要自己封装的东西，标准库开始直接给你了。"}]},{"ID":"20260519164226-dcpuo0i","Type":"NodeParagraph","Properties":{"id":"20260519164226-dcpuo0i","updated":"20260519155748"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C++20"},{"Type":"NodeText","Data":" 就不只是“更好写”，而是 ​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"更现代了"},{"Type":"NodeText","Data":"​。比如 concepts 可以给模板加约束，让模板报错更清楚；coroutine 可以更方便地写异步逻辑；ranges 让容器处理更顺手；还有模块 modules、三路比较运算符 "},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003c"}]},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"="}]},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":" 这些，都是在提升代码表达能力和工程体验。"}]},{"ID":"20260519164226-r0g84f5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-r0g84f5","updated":"20260519160509"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"动态库是什么时候加载的，怎么知道应用程序依赖了哪个动态库"}]},{"ID":"20260519164226-zl2pcly","Type":"NodeParagraph","Properties":{"id":"20260519164226-zl2pcly","updated":"20260519160509"},"Children":[{"Type":"NodeText","Data":"动态库既可能在程序启动时由加载器自动加载，也可能在运行时由程序主动加载"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用依赖哪些动态库，是通过可执行文件里的导入表或动态段这些元信息提前记录好的"}]},{"ID":"20260519164226-29jwgn9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-29jwgn9","updated":"20260519160623"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"比如两个.o 文件里存在两个同名的符号，int a=1;int a=2 在链接时候会发生什么事情"}]},{"ID":"20260519164226-krqtqaf","Type":"NodeParagraph","Properties":{"id":"20260519164226-krqtqaf","updated":"20260519160612"},"Children":[{"Type":"NodeText","Data":"如果两个 .o 文件里都定义了同名的全局符号，比如一个是 int a = 1;，另一个是 int a = 2;，那链接阶段通常会直接报“重复定义”错误，因为链接器发现全局符号 a 出现了两个强定义，不知道该用哪个"}]},{"ID":"20260519164226-c71mw7n","Type":"NodeParagraph","Properties":{"id":"20260519164226-c71mw7n","updated":"20260519160616"},"Children":[{"Type":"NodeText","Data":"这里的关键是，int a = 1; 和 int a = 2; 都属于已定义的全局变量，本质上是两个强符号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"链接器在合并符号表时要求这种全局定义通常只能有一个，所以会报错，而不是帮你自动选一个"}]},{"ID":"20260519164226-algdjda","Type":"NodeParagraph","Properties":{"id":"20260519164226-algdjda","updated":"20260519160623"},"Children":[{"Type":"NodeText","Data":"如果只是声明 extern int a; 不会有问题，因为那不是定义"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正出问题的是多个目标文件里都出现了同名的全局定义。 这样答会更完整"}]},{"ID":"20260519164226-g5dsbvg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-g5dsbvg","updated":"20260519161046"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"return a，这个 a 是右值吗"}]},{"ID":"20260519164226-pnlmfwf","Type":"NodeParagraph","Properties":{"id":"20260519164226-pnlmfwf","updated":"20260519161009"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"return a"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"里的"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"a"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"本身不是右值，它还是左值，因为它是个有名字的变量"}]},{"ID":"20260519164226-xlrmj8j","Type":"NodeParagraph","Properties":{"id":"20260519164226-xlrmj8j","updated":"20260519161013"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有名字、能取地址、能反复用的东西，一般就是左值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":" a 明显符合这个特点，所以它不是右值"}]},{"ID":"20260519164226-4vg2eoj","Type":"NodeParagraph","Properties":{"id":"20260519164226-4vg2eoj","updated":"20260519161046"},"Children":[{"Type":"NodeText","Data":"只不过在 return a; 这个场景下"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编译器可能觉得这个对象马上就要结束作用域了，可以“顺手把资源搬走”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以有时候会走移动构造，或者直接优化掉拷贝"}]},{"ID":"20260519164226-ep4vtr1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-ep4vtr1","updated":"20260519161338"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"函数参数是值传递好还是引用传递好，功能和性能两方面"}]},{"ID":"20260519164226-ujix13q","Type":"NodeParagraph","Properties":{"id":"20260519164226-ujix13q","updated":"20260519161338"},"Children":[{"Type":"NodeText","Data":"小对象用值传递，大对象用 const 引用 传递，这是最常见也最稳的做法"}]},{"ID":"20260519164226-x5bbeo8","Type":"NodeParagraph","Properties":{"id":"20260519164226-x5bbeo8","updated":"20260519161400"},"Children":[{"Type":"NodeText","Data":"从功能上说，值传递会拷贝一份，函数里怎么改都不影响外面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"引用传递相当于直接操作原对象，如果不想改原对象，一般就用 const T\u0026"}]},{"ID":"20260519164226-q879syy","Type":"NodeParagraph","Properties":{"id":"20260519164226-q879syy","updated":"20260519161408"},"Children":[{"Type":"NodeText","Data":"从性能上说，int、double 这种小类型拷贝成本很低，值传递更直接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"string、vector 这种大对象如果值传递，可能有额外拷贝开销，所以更适合用引用"}]},{"ID":"20260519164226-yf403h0","Type":"NodeParagraph","Properties":{"id":"20260519164226-yf403h0","updated":"20260519161423"},"Children":[{"Type":"NodeText","Data":"现代 C++ 里如果函数内部本来就要拷贝一份参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"那直接值传递也可以，因为传右值时能利用移动语义"}]},{"ID":"20260519164226-j7z8cw7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-j7z8cw7","updated":"20260519123622"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"函数调用的时候，传参是怎么传的"}]},{"ID":"20260519164226-edp1buy","Type":"NodeParagraph","Properties":{"id":"20260519164226-edp1buy","updated":"20260519161622"},"Children":[{"Type":"NodeText","Data":"函数调用传参，本质上就是调用方把参数按照调用约定放到指定位置，再由被调函数去取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":" 这个“指定位置”一般就是寄存器和栈"}]},{"ID":"20260519164226-who1mjh","Type":"NodeParagraph","Properties":{"id":"20260519164226-who1mjh","updated":"20260519161716"},"Children":[{"Type":"NodeText","Data":"现在大多数平台上，前几个参数优先走寄存器，因为快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果参数太多，或者有些类型不适合放寄存器，就会放到栈上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数进入之后，再按照约定从寄存器或栈里把这些参数取出来使用"}]},{"ID":"20260519164226-7n0zuni","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164226-7n0zuni","updated":"20260521124420"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果此时定义了一个析构函数，拷贝构造和移动构造会被编译器删除吗（都删除还是删一个）"}]},{"ID":"20260519164226-dts1ksg","Type":"NodeParagraph","Properties":{"id":"20260519164226-dts1ksg","updated":"20260519162648"},"Children":[{"Type":"NodeText","Data":"这个要分开说，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不是“都删除”"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260519164226-ae5pkom","Type":"NodeParagraph","Properties":{"id":"20260519164226-ae5pkom","updated":"20260519162651"},"Children":[{"Type":"NodeText","Data":"如果你"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自己定义了析构函数"},{"Type":"NodeText","Data":"，编译器"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不会删掉拷贝构造和拷贝赋值"},{"Type":"NodeText","Data":"，它们通常还是会生成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"移动构造和移动赋值一般就不会再自动帮你生成了"},{"Type":"NodeText","Data":"，可以理解成被抑制了，你如果需要移动语义，通常要自己写"}]},{"ID":"20260519164226-v2byk10","Type":"NodeParagraph","Properties":{"id":"20260519164226-v2byk10","updated":"20260519162651"},"Children":[{"Type":"NodeText","Data":"所以面试里可以直接答："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"定义析构函数后，不是拷贝和移动全删，而是拷贝通常还在，自动生成的移动构造和移动赋值会受影响，一般不会再隐式生成"}]},{"ID":"20260521124420-ynbvahp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124420-ynbvahp","updated":"20260521232558"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何关闭内存对齐或指定对齐字节数"}]},{"ID":"20260521124420-v3q84a6","Type":"NodeParagraph","Properties":{"id":"20260521124420-v3q84a6","updated":"20260521105613"},"Children":[{"Type":"NodeText","Data":"在 C++ 里常用做法是用\t#pragma pack(n)设置结构体按 n 字节对齐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 # pragma pack(1)\t就是 1 字节对齐\t常用于网络包、协议头"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用完记得恢复，比如 # pragma pack()"}]},{"ID":"20260521124420-uvtts65","Type":"NodeParagraph","Properties":{"id":"20260521124420-uvtts65","updated":"20260521105639"},"Children":[{"Type":"NodeText","Data":"如果是 C++11 以后，也可以用 alignas(n)指定某个对象的对齐字节数"}]},{"ID":"20260521232558-kj4gpae","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521232558-kj4gpae","updated":"20260604210207"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"连续内存更快的具体原因是什么"}]},{"ID":"20260521232558-9wz6m8y","Type":"NodeParagraph","Properties":{"id":"20260521232558-9wz6m8y","updated":"20260521232433"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 缓存命中率高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连续内存数据扎堆存放，一次缓存加载就能读一大片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后续读取直接走高速缓存，不用频繁访问低速内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"寻址开销极小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数组靠下标就能直接算出内存地址，瞬间定位数据，无额外查找消耗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"硬件预读机制加持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统会预判读取相邻数据，连续内存刚好契合预读逻辑，批量读取效率大幅提升"}]},{"ID":"20260604210207-gyw3zmz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260604210207-gyw3zmz","updated":"20260604210209"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模版函数用虚函数修饰有什么问题"}]},{"ID":"20260604210207-y49i1tf","Type":"NodeParagraph","Properties":{"id":"20260604210207-y49i1tf","updated":"20260604204414"},"Children":[{"Type":"NodeText","Data":"语法不允许，模板成员函数不能加 virtual，直接编译报错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚表编译期就要定好大小，模板会随不同类型生成多个实例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没法提前确定虚函数数量，虚表构建不了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚函数是运行时多态，模板是编译期多态，机制冲突"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"想用就套一层普通虚函数，内部调用模板"}]},{"ID":"20260604210209-tg6lc0g","Type":"NodeParagraph","Properties":{"id":"20260604210209-tg6lc0g","updated":"20260604210209"}},{"ID":"20260505170804-v8dfxrg","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-v8dfxrg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"STL"}]},{"ID":"20260505170804-gw2ty52","Type":"NodeParagraph","Properties":{"id":"20260505170804-gw2ty52","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"STL 是一套用 C++ 模板实现的、通用的、高效的  数据结构 + 算法  库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把容器、迭代器、算法三者完全解耦，彼此独立又能无缝配合"}]},{"ID":"20260505170804-b36w3jx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b36w3jx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于容器"}]},{"ID":"20260505170804-wv4w8r3","Type":"NodeParagraph","Properties":{"id":"20260505170804-wv4w8r3","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"序列式容器"},{"Type":"NodeText","Data":"：按插入的先后顺序存数据，讲究排列顺序，比如 vector、list、deque"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关联式容器"},{"Type":"NodeText","Data":"：用 key 存数据，会自动排序或快速查找，讲究快速检索，比如 set、map、unordered_map"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"容器适配器"},{"Type":"NodeText","Data":"：不自己实现底层，改造别的容器提供特定接口，比如栈 stack、队列 queue"}]},{"ID":"20260505170804-sjtsob9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-sjtsob9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常用 STL 底层实现？"}]},{"ID":"20260505170804-8ql7yr6","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ql7yr6","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260308223517131"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260308223517131.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-7f0nvj4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7f0nvj4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"STL 是线程安全的吗？怎么样在多线程的环境下使用容器？\t\t\u003e\u003e"}]},{"ID":"20260505170804-fohvxoc","Type":"NodeParagraph","Properties":{"id":"20260505170804-fohvxoc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"STL 容器本身不是线程安全的。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它只保证读安全，但同时读写、多个线程写，会出现数据错乱、崩溃。"}]},{"ID":"20260505170804-g3tte6u","Type":"NodeParagraph","Properties":{"id":"20260505170804-g3tte6u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同一时间，只允许一个线程写，其他线程要么读，要么等待；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给容器操作加互斥锁，读写都加锁保护；"}]},{"ID":"20260505170804-mlkne2u","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mlkne2u","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"出于什么原因 STL 不设计成线程安全的？\t\t\u003e\u003e"}]},{"ID":"20260505170804-znvcx3l","Type":"NodeParagraph","Properties":{"id":"20260505170804-znvcx3l","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加锁有开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果每个容器操作都自带锁的话，会严重降低效率；而且并非每个用到 STL 的地方都是单线程的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"锁的粒度不好控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"STL 不知道你的业务是单次操作，还是一连串复合操作，内置锁解决不了业务级的线程安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保持轻量、通用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"STL 定位是高效基础容器，不是线程安全组件，线程安全交给用户自己控制更灵活"}]},{"ID":"20260505170804-a4p27i3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a4p27i3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"迭代器的 ++it、it++ 哪个好？\t\u003e\u003e"}]},{"ID":"20260505170804-x5yog9e","Type":"NodeParagraph","Properties":{"id":"20260505170804-x5yog9e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"++it 前置递增效率更高，因为它直接对迭代器进行递增操作，不需要创建临时对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"it++ 后置递增必须先复制自己，再自增，再返回旧值，多了一次临时对象拷贝需要创建临时对象，效率较低"}]},{"ID":"20260505170804-d82l8i7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d82l8i7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"STL 迭代器和指针有什么区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-ux01t20","Type":"NodeParagraph","Properties":{"id":"20260505170804-ux01t20","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"指针是内存地址；迭代器是包装指针的 “智能访问器”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全性：指针不安全，越界直接崩；迭代器更安全，有边界检查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通用性：指针只能遍历连续内存；迭代器能遍历所有 STL 容器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遍历方式：指针靠地址加减；迭代器统一用 ++/--，不用关心底层结构"}]},{"ID":"20260505170804-sho6ion","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-sho6ion","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"使用迭代器怎么删除一个元素\t\t\u003e\u003e"}]},{"ID":"20260505170804-04iov05","Type":"NodeParagraph","Properties":{"id":"20260505170804-04iov05","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"顺序容器（vector、deque）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用迭代器删元素时，erase 会让当前及之后所有迭代器失效，不能用 erase(it++)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正确写法是 it = c.erase(it)，靠 erase 返回的下一个有效迭代器继续遍历"}]},{"ID":"20260505170804-b1cgk7u","Type":"NodeParagraph","Properties":{"id":"20260505170804-b1cgk7u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关联容器（map、set）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"erase 只会让被删元素的迭代器失效，其他都有效，且 erase 返回 void"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正确写法是 c.erase(it++)，后置自增先传当前迭代器副本，再后移，不影响遍历"}]},{"ID":"20260505170804-8aqpzkw","Type":"NodeParagraph","Properties":{"id":"20260505170804-8aqpzkw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"补充（list）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"list 是节点式容器，两种写法都能用，既可以 it = c.erase(it)，也可以 c.erase(it++)，都安全"}]},{"ID":"20260505170804-hp0obfz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hp0obfz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"迭代器失效情况\t\t\u003e\u003e"}]},{"ID":"20260505170804-v86skny","Type":"NodeParagraph","Properties":{"id":"20260505170804-v86skny","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"迭代器相当于指向数据的 “索引” ，数据位置变了、内存搬了、被删了，迭代器就失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据地址没变–\u003e 指针 / 引用有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"迭代器靠索引定位，索引变了–\u003e 迭代器失效"}]},{"ID":"20260505170804-eh8lbht","Type":"NodeParagraph","Properties":{"id":"20260505170804-eh8lbht","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"vector"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间插 / 删：全失效；尾插：扩容全失效，不扩容仅尾后失效；尾删：仅尾后失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在中间插入删除会导致元素挪动，所有迭代器、指针、引用全部失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"头尾插入时，中控数组可能扩容，迭代器失效，但原有元素的地址不变，所以指针和引用仍然有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"头尾删除时，只有被删除的那个元素失效，其他迭代器、指针、引用都保持有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"list/forward_list"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插：全有效；删：仅被删元素迭代器失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"set/map/ 无序容器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插：全有效；删：仅被删元素迭代器失效"}]},{"ID":"20260505170804-rhb9ggs","Type":"NodeParagraph","Properties":{"id":"20260505170804-rhb9ggs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"头尾插入时迭代器为什么一定失效？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 deque 迭代器不是简单指针，它内部结构更复杂，通常要记录："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当前在哪个缓冲区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在缓冲区里的偏移"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中控数组的位置"}]},{"ID":"20260505170804-5nk17d4","Type":"NodeParagraph","Properties":{"id":"20260505170804-5nk17d4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"避免失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"增删后，用函数返回值重新赋值迭代器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不要保存 end ()，每次重新获取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遍历过程不做插入 / 删除，先记录位置再批量操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用下标访问代替迭代器（vector/string）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"list/map 这类节点容器，只影响当前节点，可安全删除"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提前 reserve 空间，避免 vector 扩容"}]},{"ID":"20260505170804-ih8r023","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ih8r023","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector 底层实现\t\t\u003e\u003e"}]},{"ID":"20260505170804-cpql66g","Type":"NodeParagraph","Properties":{"id":"20260505170804-cpql66g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"vector 底层是连续的动态数组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部用三个指针控制：起始指针、当前元素末尾指针、容量末尾指针。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当插入元素空间不足时，会以 1.5 倍或 2 倍自动扩容，重新申请更大内存，把旧数据拷贝过去，再释放旧内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"vector 提供高效的随机访问性能，插入和删除操作在末尾最高效，在中间效率低"}]},{"ID":"20260505170804-ulqkanh","Type":"NodeParagraph","Properties":{"id":"20260505170804-ulqkanh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"vector 在默认构造时是空的，大小为 0，不会分配任何内存"}]},{"ID":"20260505170804-eztdajr","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-eztdajr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么需要起始指针"}]},{"ID":"20260505170804-fmnprx7","Type":"NodeParagraph","Properties":{"id":"20260505170804-fmnprx7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"vector 是动态扩容的连续数组，扩容时会重新申请更大内存并迁移所有元素，数组起始地址会发生变化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以需要 start 指针始终记录当前内存块的首地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时 size()计算、[]随机访问、迭代器实现等核心操作，都依赖 start 作为基准地址与 finish 做指针运算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有它就无法定位元素位置和计算有效元素个数"}]},{"ID":"20260505170804-jprz3mz","Type":"NodeParagraph","Properties":{"id":"20260505170804-jprz3mz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么还分 1.5 倍和 2 倍"}]},{"ID":"20260505170804-naafucm","Type":"NodeParagraph","Properties":{"id":"20260505170804-naafucm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不同编译器（比如 GCC、VS、MSVC）选择不一样，本质就是在时间和空间之间做不同权衡"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux 下 vector 用 2 倍扩容，因为 2 倍更契合 Linux 内存伙伴系统（2 的幂次分配），扩容次数更少、均摊效率更高，但内存浪费更大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux（GCC/libstdc++）：2 倍"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Windows（MSVC）：1.5 倍"}]},{"ID":"20260505170804-uz4p4vf","Type":"NodeParagraph","Properties":{"id":"20260505170804-uz4p4vf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"2 倍扩容优点是扩容次数少，插入效率高，适合追求速度的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是每次扩容都会翻倍，容易造成内存浪费，而且旧空间几乎无法复用，长期会产生内存碎片"}]},{"ID":"20260505170804-52a5m7w","Type":"NodeParagraph","Properties":{"id":"20260505170804-52a5m7w","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.5 倍扩容优点是扩容更温和，内存浪费更少，而且多次扩容后，旧内存空间有机会被后续新空间复用，内存利用率更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是扩容次数会比 2 倍稍多一点"}]},{"ID":"20260505170804-4lisvng","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4lisvng","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector 的 resize()和 reserve()区别?"}]},{"ID":"20260505170804-l0l6vwx","Type":"NodeParagraph","Properties":{"id":"20260505170804-l0l6vwx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"resize 用于改变 vector 的大小，并且如果新大小 大于原大小，会初始化新元素"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"reserve 用于预分配内存，但不改变 vector 的大小，仅改变容量，以减少多次分配内存的开销"}]},{"ID":"20260505170804-e0z8un1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e0z8un1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector 中 push_back 和 emplace_back 的区别？"}]},{"ID":"20260505170804-dztu193","Type":"NodeParagraph","Properties":{"id":"20260505170804-dztu193","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"push_back 拷贝或移动元素，emplace_back 直接在容器内原地构造，效率更高"}]},{"ID":"20260505170804-twr6ah4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-twr6ah4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector::at()与 vector::operator[]的区别是什么？"}]},{"ID":"20260505170804-zj4c3bf","Type":"NodeParagraph","Properties":{"id":"20260505170804-zj4c3bf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"at()：提供边界检查，如果访问越界会抛出 std::out_of_range 异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"operator[]：不提供边界检查，访问越界会导致未定义行为"}]},{"ID":"20260505170804-ptbfguk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ptbfguk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Vector 扩容后只使用小部分，怎么释放后面的空间？"}]},{"ID":"20260505170804-8vqtlrl","Type":"NodeParagraph","Properties":{"id":"20260505170804-8vqtlrl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.创建一个新的 vector 对象，使用当前 vector 的内容初始化，与原 vector 交换内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.C++11 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"shrink_to_fit()"},{"Type":"NodeText","Data":"，把多余的容量还给系统"}]},{"ID":"20260505170804-bcyhxzj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bcyhxzj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何优化大量数据的插入处理，特别是在 std::vector 中？"}]},{"ID":"20260505170804-v87e73m","Type":"NodeParagraph","Properties":{"id":"20260505170804-v87e73m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先 reserve 预分配，避免反复扩容拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量尾插，少用中间插入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 emplace_back 原地构造，少拷贝"}]},{"ID":"20260505170804-f87baoh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f87baoh","updated":"20260516132954"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector clear() 是清空所有元素还是清空内存？"}]},{"ID":"20260505170804-q21omix","Type":"NodeParagraph","Properties":{"id":"20260505170804-q21omix","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"clear()操作销毁容器中的所有元素，但并不释放已分配的内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过调用每个元素的析构函数来销毁元素，然后将 vector 的 size 设置为 0。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然而，vector 的 capacity()值保持不变，表示内存空间依旧被保留，以避免重新分配内存所需的开销"}]},{"ID":"20260516132954-2ovjp3u","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516132954-2ovjp3u","updated":"20260521124437"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"频繁调用 push_back 的影响"}]},{"ID":"20260516132954-emqg6tp","Type":"NodeParagraph","Properties":{"id":"20260516132954-emqg6tp","updated":"20260516132633"},"Children":[{"Type":"NodeText","Data":"不只是扩容次数多，还包括对象拷贝或移动的成本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"vector 会重新申请更大的内存，再把原来所有元素拷贝或者移动到新空间里"}]},{"ID":"20260516132954-v00bl08","Type":"NodeParagraph","Properties":{"id":"20260516132954-v00bl08","updated":"20260516132635"},"Children":[{"Type":"NodeText","Data":"如果元素类型比较大，或者拷贝构造代价，那这个开销会很明显"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果类还没实现效的移动语义，性能损失会更大"}]},{"ID":"20260516132954-b7lhafq","Type":"NodeParagraph","Properties":{"id":"20260516132954-b7lhafq","updated":"20260516132821"},"Children":[{"Type":"NodeText","Data":"另外 push_back 传入一个对象时，本身也可能发生一次拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果写成 push_back(obj)，通常会走拷贝或移动构造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比之下，emplace_back 可以直接原地构造，某些场景下能减少一次临时对象开销"}]},{"ID":"20260521124437-66m9upa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124437-66m9upa","updated":"20260521112427"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"vector 存大对象排序，如何减少拷贝优化"}]},{"ID":"20260521124437-bon2sje","Type":"NodeParagraph","Properties":{"id":"20260521124437-bon2sje","updated":"20260521110906"},"Children":[{"Type":"NodeText","Data":"首先不要直接存大对象本身，优先在 vector 里存对象指针、智能指针或者下标索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"排序时只移动轻量地址，彻底避开大对象整体拷贝"}]},{"ID":"20260521124437-8ttu1ju","Type":"NodeParagraph","Properties":{"id":"20260521124437-8ttu1ju","updated":"20260521111504"},"Children":[{"Type":"NodeText","Data":"改用 vector\u003c 移动语义容器 \u003e 让大对象实现移动构造、移动赋值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"排序交换元素时优先触发移动而非深拷贝，大幅降低内存开销与耗时"}]},{"ID":"20260521124437-5jbvew1","Type":"NodeParagraph","Properties":{"id":"20260521124437-5jbvew1","updated":"20260521111803"},"Children":[{"Type":"NodeText","Data":"排序时尽量使用原地排序，避免临时容器中转"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时选用更高效排序写法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"std::stable_sort\t稳定排序"},{"Type":"NodeText","Data":"，保证"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相等元素的原始相对顺序不变"}]},{"ID":"20260521124437-x8e5nim","Type":"NodeParagraph","Properties":{"id":"20260521124437-x8e5nim","updated":"20260521111919"},"Children":[{"Type":"NodeText","Data":"提前 reserve 预留足够容量，避免排序前后 vector 频繁扩容触发整体元素搬迁拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从底层减少内存重排带来的对象复制损耗"}]},{"ID":"20260521124437-odcbel3","Type":"NodeParagraph","Properties":{"id":"20260521124437-odcbel3","updated":"20260521112155"},"Children":[{"Type":"NodeText","Data":"还可以把大对象拆分为轻量排序键 + 实体数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只用键完成排序逻辑，最后再映射回原数据，全称只操作小字段，完全规避大对象移动"}]},{"ID":"20260505170804-t5nw9nj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t5nw9nj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"List 的底层实现"}]},{"ID":"20260505170804-y5xwin2","Type":"NodeParagraph","Properties":{"id":"20260505170804-y5xwin2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::list 底层采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"双向循环链表"},{"Type":"NodeText","Data":"结构实现，内存空间不连续，节点都是独立分散分配的"}]},{"ID":"20260505170804-96pjcc4","Type":"NodeParagraph","Properties":{"id":"20260505170804-96pjcc4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每个链表节点除了存储有效数据，还包含两个指针，一个指向前驱节点，一个指向后继节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持从任意节点向前、向后双向遍历"}]},{"ID":"20260505170804-znchcde","Type":"NodeParagraph","Properties":{"id":"20260505170804-znchcde","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它和普通双向链表最大区别是首尾相连"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尾节点的后继指向头节点，头节点的前驱指向尾节点，形成闭环，没有真正意义上的末尾"}]},{"ID":"20260505170804-25k3ks5","Type":"NodeParagraph","Properties":{"id":"20260505170804-25k3ks5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因为是链表结构，它任意位置插入、删除元素只需要修改指针指向，不用搬迁数据，效率很高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但不支持随机访问，只能逐个遍历，也利用不上 CPU 缓存局部性，查询性能较差"}]},{"ID":"20260505170804-nax4fes","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nax4fes","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"deque 的实现"}]},{"ID":"20260505170804-4q63vcg","Type":"NodeParagraph","Properties":{"id":"20260505170804-4q63vcg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"deque 是双端队列，支持头尾 O (1) 插入删除，也支持随机访问，底层是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分段连续"},{"Type":"NodeText","Data":"的内存结构。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用多个固定大小的小缓冲区存数据，再用一个叫"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中控器"},{"Type":"NodeText","Data":"的指针数组来管理这些缓冲区。"}]},{"ID":"20260505170804-b6pfieu","Type":"NodeParagraph","Properties":{"id":"20260505170804-b6pfieu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"尾插时，会先判断最后一个缓冲区是否剩余空间，若有则直接存入数据并更新偏移量，若无则新建缓冲区并挂载到中控器尾部，再存入数据；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"头插时，先判断首个缓冲区是否剩余空间，若有则直接存入数据并更新偏移量，若无则新建缓冲区并挂载到中控器头部，再存入数据"}]},{"ID":"20260505170804-0oxzc0g","Type":"NodeParagraph","Properties":{"id":"20260505170804-0oxzc0g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它的迭代器内部有四个指针："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当前元素、缓冲区开头、缓冲区结尾、以及指向中控器的指针，遍历的时候如果一块走完，就自动跳到下一块"}]},{"ID":"20260505170804-kzcr847","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kzcr847","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"list 与 duque 之间的区别？"}]},{"ID":"20260505170804-sh91tah","Type":"NodeParagraph","Properties":{"id":"20260505170804-sh91tah","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"list 是双向链表，内存由分散的节点组成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque 是双端队列，采用分段连续的内存块实现"}]},{"ID":"20260505170804-mmysl2l","Type":"NodeParagraph","Properties":{"id":"20260505170804-mmysl2l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"list 不支持随机访问，访问中间元素只能从头遍历，速度很慢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque 支持高效随机访问，使用起来和数组差不多"}]},{"ID":"20260505170804-4rl6gmf","Type":"NodeParagraph","Properties":{"id":"20260505170804-4rl6gmf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"list 在任意位置插入删除都很快，时间复杂度 O(1)，尤其适合中间操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque 只在首尾增删效率高，中间插入删除性能较差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"deque 底层是中控指针数组 + 多个固定大小的连续缓冲区，属于分段连续内存结构"}]},{"ID":"20260505170804-dkyvs1h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dkyvs1h","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"描述 priority_queue 的底层原理及使用场景?"}]},{"ID":"20260505170804-7fjx71l","Type":"NodeParagraph","Properties":{"id":"20260505170804-7fjx71l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"priority_queue 底层是堆，默认是大顶堆，底层容器用 vector。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它能保证堆顶元素始终优先级最大，插入和弹出操作都是 O (log n)。"}]},{"ID":"20260505170804-ierg3bi","Type":"NodeParagraph","Properties":{"id":"20260505170804-ierg3bi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优先队列主要用于需要动态获取当前最大值 / 最小值、按优先级处理任务的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心是每次都能快速拿到最重要的元素"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"堆不用全量加载，通过维护固定大小的堆实现，来一个数据处理一个，只保留优先级最高的 K 个，其余直接丢弃，不用全量加载，内存占用极小"}]},{"ID":"20260505170804-i330r5c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-i330r5c","updated":"20260511205449"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"map 和 unordered map 有什么区别？"}]},{"ID":"20260505170804-ur1srrl","Type":"NodeParagraph","Properties":{"id":"20260505170804-ur1srrl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"map 采用红黑树实现，元素有序，查找、插入、删除的时间复杂度为 O(log n)；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"unordered_map 采用哈希表实现，元素无序，查找、插入、删除的平均时间复杂度为 O(1)，最坏情况下为 O(n)。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哈希表在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"哈希冲突严重"},{"Type":"NodeText","Data":"时，所有元素会落到同一个位置形成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长链表"},{"Type":"NodeText","Data":"，此时操作需要遍历链表"}]},{"ID":"20260511205449-9qgjicv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511205449-9qgjicv","updated":"20260511171758"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"map 的 key 可以传 class 吗，怎么解决"}]},{"ID":"20260511205449-a8lu8nw","Type":"NodeParagraph","Properties":{"id":"20260511205449-a8lu8nw","updated":"20260511205149"},"Children":[{"Type":"NodeText","Data":"可以，map 的 key 可以是自定义 class，但前提是这个类型必须能比较大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 std::map 底层是有序红黑树，默认用 std::less\u003cKey\u003e，本质上会走 operator\u003c"}]},{"ID":"20260511205449-33vthww","Type":"NodeParagraph","Properties":{"id":"20260511205449-33vthww","updated":"20260511205158"},"Children":[{"Type":"NodeText","Data":"所以最常见的做法，就是给这个类定义 operator\u003c"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 map 知道两个对象谁排前谁排后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如按成员变量依次比较，只要保证这个比较逻辑满足严格弱序就行"}]},{"ID":"20260511205449-u33iknz","Type":"NodeParagraph","Properties":{"id":"20260511205449-u33iknz","updated":"20260511205242"},"Children":[{"Type":"NodeText","Data":"如果你不想在类里面写 operator\u003c，也可以在 map 里额外传一个比较器，比如自定义 struct Compare"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后 map\u003cMyClass, Value, Compare\u003e"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样比较规则就和类本身解耦了，工程里也很常见"}]},{"ID":"20260511205449-us4p6o7","Type":"NodeParagraph","Properties":{"id":"20260511205449-us4p6o7","updated":"20260511205311"},"Children":[{"Type":"NodeText","Data":"std::map 需要“可比较大小”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是 std::unordered_map，那就不是 \u003c 了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是需要你提供 hash 和 =="}]},{"ID":"20260505170804-3aee2u6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3aee2u6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"哈希冲突 stl 怎么解决的?"}]},{"ID":"20260505170804-w035cx4","Type":"NodeParagraph","Properties":{"id":"20260505170804-w035cx4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"开放地址法和拉链法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开放地址法通过线性探测、二次探测等方式找下一个空位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拉链法则是每个数组位置挂一个链表或红黑树，冲突后继续链下去"}]},{"ID":"20260505170804-gz5vhzv","Type":"NodeParagraph","Properties":{"id":"20260505170804-gz5vhzv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"装载因子是哈希表性能关键指标，一般控制在 0.7~0.8 左右，超过就会触发扩容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"扩容需要重新计算所有元素的哈希并迁移数据，所以扩容成本较高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而删除操作在开放地址法中不能直接物理删除，会引入删除标记，影响效率，拉链法就没有这个问题，可以直接删除节点"}]},{"ID":"20260505170804-nnu4ug6","Type":"NodeParagraph","Properties":{"id":"20260505170804-nnu4ug6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"开放地址法靠探测序列查找元素，如果直接物理删除，会打断探测链，导致后续查找时提前终止、找不到本该存在的数据"}]},{"ID":"20260505170804-iyt04nm","Type":"NodeParagraph","Properties":{"id":"20260505170804-iyt04nm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"拉链法在实际工程中应用最广，C++ 和 Java 都采用类似机制：链表过长时会转换成红黑树，进一步降低时间复杂度到 O (log n)。它适合处理元素个数不确定、每个元素占比较小的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而线性探测适合元素较少、空间占用较大的情况"}]},{"ID":"20260505170804-rudy0uu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rudy0uu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ 自定义对象正确做 map 和哈希运算"}]},{"ID":"20260505170804-g4ny22k","Type":"NodeParagraph","Properties":{"id":"20260505170804-g4ny22k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"放进 map 的话，因为它底层是红黑树，需要排序，所以只要给自定义类重载小于号 \u003c 运算符"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并且写成 const 成员函数，定义好对象之间的比较规则就行"}]},{"ID":"20260505170804-9n0lxs3","Type":"NodeParagraph","Properties":{"id":"20260505170804-9n0lxs3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"放进 unordered_map 这种哈希容器，就需要做哈希运算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一方面要重载等于号 == 用来判断两个对象是否相等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另一方面要提供哈希函数,一般是给 std::hash 做特化，把对象里的多个成员哈希值合理组合起来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证相等的对象哈希值一定相同，这样才能正常查找和去重"}]},{"ID":"20260505170804-dfxxucq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dfxxucq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"STL 中 count()和 find()的区别\t\t\u003e\u003e"}]},{"ID":"20260505170804-2tkrv5p","Type":"NodeParagraph","Properties":{"id":"20260505170804-2tkrv5p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"find：找有没有，找到就停，返回迭代器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"count：数有多少个，要遍历完，返回个数"}]},{"ID":"20260505170804-q2vkhiy","Type":"NodeParagraph","Properties":{"id":"20260505170804-q2vkhiy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"find 的作用是查找元素是否存在，它会从头开始遍历，一旦找到目标元素就立即返回迭代器，不会继续往下找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"count 是统计元素出现的次数，必须遍历完整个容器，把所有匹配的元素都数一遍才会结束"}]},{"ID":"20260505170804-s5xi4z2","Type":"NodeParagraph","Properties":{"id":"20260505170804-s5xi4z2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 vector、list 这类顺序容器里，两者效率差距很明显"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"find 最好情况 O (1)，最坏 O (n)，平均情况下往往很快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 count 不管元素在哪个位置，都一定是 O (n) 时间复杂度，所以只判断存在性时，find 明显更快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 set、map 这类关联容器中，底层是红黑树，查找都是 O (log n)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但 find 找到就返回，count 依然要遍历所有等值节点，所以即使复杂度相同，find 实际执行也会更快一些"}]},{"ID":"20260505170804-xumah7w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xumah7w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"erase (迭代器) vs erase (值)\t\t\u003e\u003e"}]},{"ID":"20260505170804-uaeuuy6","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-uaeuuy6","updated":"20260505170804"},"Children":[{"ID":"20260505170804-df5x9dt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-df5x9dt","updated":"20260505170804"},"Children":[{"ID":"20260505170804-t637xn7","Type":"NodeParagraph","Properties":{"id":"20260505170804-t637xn7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"erase (it)：删单个，效率高"}]}]},{"ID":"20260505170804-oyhuf4v","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-oyhuf4v","updated":"20260505170804"},"Children":[{"ID":"20260505170804-ve1v2iu","Type":"NodeParagraph","Properties":{"id":"20260505170804-ve1v2iu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"erase (val)：删所有匹配，遍历全容器"}]}]},{"ID":"20260505170804-ld0sara","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-ld0sara","updated":"20260505170804"},"Children":[{"ID":"20260505170804-7p19mpo","Type":"NodeParagraph","Properties":{"id":"20260505170804-7p19mpo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"vector 尽量用迭代器版删除"}]}]}]},{"ID":"20260505170804-m8f7n0s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m8f7n0s","updated":"20260516133334"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"c++ 的 STL 的算法中有 sort 排序函数，这个底层是怎么实现的？\t\t\u003e\u003e"}]},{"ID":"20260505170804-tqhbipc","Type":"NodeParagraph","Properties":{"id":"20260505170804-tqhbipc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"STL 的 std::sort 并不是单一的排序算法，而是经过高度工程化的混合排序算法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心是针对不同数据规模、数据特征做了极致优化"}]},{"ID":"20260505170804-ftdm47k","Type":"NodeParagraph","Properties":{"id":"20260505170804-ftdm47k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它的底层实现可以总结为三点："}]},{"ID":"20260505170804-jq30icq","Type":"NodeParagraph","Properties":{"id":"20260505170804-jq30icq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，数据量较大时，优先使用快速排序的改进版（Introsort，内省排序）核心是动态切换策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它解决了普通快排最坏时间复杂度 O(n2) 的缺陷"}]},{"ID":"20260505170804-k92omah","Type":"NodeParagraph","Properties":{"id":"20260505170804-k92omah","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先以快排为主进行分区排序，当递归深度超过阈值时（通常是 2logn）会自动降级为堆排序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证最坏时间复杂度稳定在 O(nlogn)，兼顾效率和稳定性"}]},{"ID":"20260505170804-i43g5i1","Type":"NodeParagraph","Properties":{"id":"20260505170804-i43g5i1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，数据量较小时，直接切换为插入排序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当快排 / 堆排序分区后，子数组元素个数小于阈值（一般是 16~20 个）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插入排序的常数级开销远小于快排的递归和分区开销，这一步能大幅提升小数据量的排序性能，是工程优化的关键细节"}]},{"ID":"20260516133334-d0i21o1","Type":"NodeParagraph","Properties":{"id":"20260516133334-d0i21o1","updated":"20260516133334"}},{"ID":"20260505170804-g0ys76l","Type":"NodeParagraph","Properties":{"id":"20260505170804-g0ys76l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后，实现中还做了大量细节优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如快排的基准值选择采用三数取中法，避免极端数据导致性能退化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持自定义比较函数，不局限于默认升序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个算法是不稳定排序（相等元素的相对顺序可能改变）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果需要稳定排序可以用 stable_sort，它底层基于归并排序实现"}]},{"ID":"20260505170804-dzqwdo9","Type":"NodeParagraph","Properties":{"id":"20260505170804-dzqwdo9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"常数极小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插入排序虽然时间复杂度是 O (n²)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"理论上不如快排堆排，但它没有递归、没有复杂的分区计算，只有简单的比较和元素挪动操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一步执行成本很低、CPU 执行效率高，这种单次操作的开销就叫常数开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"插入排序的常数开销远小于快排和堆排"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以在数据量很小的时候，它的实际运行速度反而更快，这也是 STL sort 会在小数组时切换成插入排序的原因"}]},{"ID":"20260505170804-tfszlpz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-tfszlpz","updated":"20260507193556"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"C++11"}]},{"ID":"20260505170804-qunjo9b","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qunjo9b","updated":"20260507193556"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"智能指针"}]},{"ID":"20260505170804-c8xcdmp","Type":"NodeParagraph","Properties":{"id":"20260505170804-c8xcdmp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 智能指针是基于 RAII 思想实现的模板类\t\tRAII 机制—— 利用栈上对象自动析构的特性，来管理堆内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心作用是自动管理堆内存，在指针对象生命周期结束时自动释放内存，从根本上避免内存泄漏和野指针问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++11 废弃了不安全的 auto_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目前常用的智能指针有三种：unique_ptr、shared_ptr 和 weak_ptr。"}]},{"ID":"20260505170804-1ldkys0","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ldkys0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"unique_ptr 是独占式智能指针，同一时间只能有一个指针管理资源，不支持拷贝赋值，只能通过移动语义转移所有权，没有引用计数带来的额外开销，执行效率最高，还能管理数组，是单所有权场景的首选。"}]},{"ID":"20260505170804-xk818h7","Type":"NodeParagraph","Properties":{"id":"20260505170804-xk818h7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"shared_ptr 是共享式智能指针，通过原子引用计数实现资源共享，多个指针可以指向同一块内存，当引用计数归零时资源会被自动释放。但它存在循环引用问题，两个对象互相持有对方的 shared_ptr 会导致计数永远无法归零，造成内存泄漏。"}]},{"ID":"20260505170804-1v9intj","Type":"NodeParagraph","Properties":{"id":"20260505170804-1v9intj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"weak_ptr 是专门解决 shared_ptr 循环引用的弱引用指针，它不增加引用计数、不控制资源生命周期，仅作为观察者存在，使用时需要通过 lock() 转换为有效的 shared_ptr 才能访问资源。"}]},{"ID":"20260505170804-ghisfde","Type":"NodeParagraph","Properties":{"id":"20260505170804-ghisfde","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程安全方面，智能指针并非完全线程安全，只有 shared_ptr 的引用计数操作是线程安全的，而指针指向的资源对象的读写操作，都需要手动加锁才能保证线程安全"}]},{"ID":"20260507193556-cw9o0jo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507193556-cw9o0jo","updated":"20260507200900"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"智能指针除了解决内存泄漏，还有什么弊端？"}]},{"ID":"20260507193556-5bkum8u","Type":"NodeParagraph","Properties":{"id":"20260507193556-5bkum8u","updated":"20260507192445"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有额外性能开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"shared_ptr 要维护引用计数，拷贝赋值时要用原子操作，本身比裸指针慢，还多占用内存 unique_ptr 虽开销小，但也有轻微封装损耗，高频调用、性能苛刻场景会有影响"}]},{"ID":"20260507193556-4wkg4mp","Type":"NodeParagraph","Properties":{"id":"20260507193556-4wkg4mp","updated":"20260507192459"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"容易出现循环引用问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两个类互相用 shared_ptr 持有对方，引用计数永远降不到零"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反而照样内存泄漏，还得额外用 weak_ptr 打破循环，增加了代码复杂度和维护成本"}]},{"ID":"20260507193556-kq2wkyx","Type":"NodeParagraph","Properties":{"id":"20260507193556-kq2wkyx","updated":"20260507192623"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用坑多、极易出错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不能用同一个裸指针初始化多个智能指针，也不能托管栈对象，否则会重复析构崩溃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且 shared_ptr 默认不支持数组，要自己定制删除器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和 C 语言裸指针接口混用时也容易引发双重释放隐患"}]},{"ID":"20260507193556-t4a4l0q","Type":"NodeParagraph","Properties":{"id":"20260507193556-t4a4l0q","updated":"20260507193354"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多线程有安全陷阱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能指针只保证引用计数线程安全，不保护指向的对象，多线程并发访问仍要自己加锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时模板类型复杂，报错信息晦涩，引用计数、生命周期排查起来比裸指针难很多"}]},{"ID":"20260507200900-b0vvm6a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507200900-b0vvm6a","updated":"20260507165049"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"智能指针的开销主要集中在哪些方面？"}]},{"ID":"20260507200900-6nhvkiu","Type":"NodeParagraph","Properties":{"id":"20260507200900-6nhvkiu","updated":"20260507194016"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存空间开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"unique"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 要封装原生指针，带模板删除器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 开销更大，除了对象指针，还要单独开一块"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存引用计数、弱引用计数和删除器，占用额外内存"}]},{"ID":"20260507200900-fbuekzz","Type":"NodeParagraph","Properties":{"id":"20260507200900-fbuekzz","updated":"20260507194126"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"运行时时间开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 拷贝、赋值、析构时，要"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原子操作修改引用计数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原子指令比普通读写慢，多线程下还会有缓存竞争、锁等待损耗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪怕 unique"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 没有计数开销，也多了一层封装间接调用，有轻微指令开销"}]},{"ID":"20260507200900-sw9hrnc","Type":"NodeParagraph","Properties":{"id":"20260507200900-sw9hrnc","updated":"20260507195603"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"间接带来的编译器与优化开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能指针是模板封装，类型更复杂，部分场景会限制编译器极致优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且自定义删除器、类型擦除，也会增加额外执行逻辑，带来隐性开销"}]},{"ID":"20260507200900-2lspw6o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507200900-2lspw6o","updated":"20260507192417"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何避免智能指针的循环引用问题？"}]},{"ID":"20260507200900-0fl2vvz","Type":"NodeParagraph","Properties":{"id":"20260507200900-0fl2vvz","updated":"20260507193528"},"Children":[{"Type":"NodeText","Data":"weak_ptr 是专门解决 shared_ptr 循环引用的弱引用指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不增加引用计数、不控制资源生命周期，仅作为观察者存在"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用时需要通过 lock() 转换为有效的 shared_ptr 才能访问资源"}]},{"ID":"20260507200900-66wjgs7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507200900-66wjgs7","updated":"20260524141655"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"智能指针适合在哪些场景下使用？"}]},{"ID":"20260507200900-iu1fpyu","Type":"NodeParagraph","Properties":{"id":"20260507200900-iu1fpyu","updated":"20260507200149"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优先用 unique_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"独占所有权场景最合适"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如类成员指针、函数内部动态申请对象、不用共享资源的地方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"零引用计数开销，自动析构省心，还能避免内存泄漏"}]},{"ID":"20260507200900-k30snbm","Type":"NodeParagraph","Properties":{"id":"20260507200900-k30snbm","updated":"20260507200202"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"需要共享所有权用 shared_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多个地方同时持有同一个对象、没法确定谁最后释放的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如缓存资源、订阅回调、复杂对象依赖、树形结构节点共享"}]},{"ID":"20260507200900-b7ufm5t","Type":"NodeParagraph","Properties":{"id":"20260507200900-b7ufm5t","updated":"20260507200221"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"配合 weak_ptr 解决循环引用"}]},{"ID":"20260507200900-halka84","Type":"NodeParagraph","Properties":{"id":"20260507200900-halka84","updated":"20260507200240"},"Children":[{"Type":"NodeText","Data":"RAII 资源托管场景："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不光管堆内存，文件句柄、网络套接字、锁资源等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"都可以封装删除器用智能指针，离开作用域自动释放，不用手动写释放逻辑"}]},{"ID":"20260507200900-rry095f","Type":"NodeParagraph","Properties":{"id":"20260507200900-rry095f","updated":"20260507200251"},"Children":[{"Type":"NodeText","Data":"容器存放动态对象："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"vector、map 里存堆对象指针，用智能指针替代裸指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用手动遍历释放，容器销毁时自动回收内存，代码更安全简洁"}]},{"ID":"20260524141650-ca4qmee","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524141650-ca4qmee","updated":"20260524142019"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"A* a = new A();  shared_ptr\u003cA\u003e sp1(a), sp2(a);这两行代码有啥问题"}]},{"ID":"20260524141733-0fje8rk","Type":"NodeParagraph","Properties":{"id":"20260524141733-0fje8rk","updated":"20260524141955"},"Children":[{"Type":"NodeText","Data":"问题在于 sp1(a) 和 sp2(a) 分别用同一个裸指针 a 构造了两个独立的 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样会生成 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"两个互不关联的控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它们都会认为自己独占这块内存的释放权"}]},{"ID":"20260524141733-rp41agr","Type":"NodeParagraph","Properties":{"id":"20260524141733-rp41agr","updated":"20260524142005"},"Children":[{"Type":"NodeText","Data":"结果就是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当 sp1 和 sp2 析构时，都会各自对 a 调一次 delete"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终造成 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重复释放"},{"Type":"NodeText","Data":"，这是未定义行为，程序很容易崩溃"}]},{"ID":"20260524141742-s5e3wpe","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260524141742-s5e3wpe","updated":"20260524142019"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"正确写法应该让多个 shared_ptr 共享同一个控制块，比如：\n\nauto sp1 = std::make_shared\u003cA\u003e();\nauto sp2 = sp1;\n\n或者：\n\nshared_ptr\u003cA\u003e sp1(new A());\nshared_ptr\u003cA\u003e sp2 = sp1;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260511175543-ey0n9fq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511175543-ey0n9fq","updated":"20260511180827"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"weak_ptr::lock 的检测机制怎么做的"}]},{"ID":"20260511175543-smn7lpo","Type":"NodeParagraph","Properties":{"id":"20260511175543-smn7lpo","updated":"20260511173519"},"Children":[{"Type":"NodeText","Data":"本质上就是看它指向的控制块里，share 引用计数还在不在"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"weak_ptr 自己不管理对象生命周期，它只是拿着控制块的信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以每次 lock（） 时，不是直接看裸指针，而是去检查控制块里的强引用计数是不是大于 0"}]},{"ID":"20260511175543-3u3n63p","Type":"NodeParagraph","Properties":{"id":"20260511175543-3u3n63p","updated":"20260511174527"},"Children":[{"Type":"NodeText","Data":"如果强引用计数大于 0，说明对象还活着，这时候 lock()会尝试把强引用计数原子的 +1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"成功了就返回一个新的 shared_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样可以保证“检查对象还活着”和\"拿到所有权\"是一个安全过程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免多线程下刚判断完对象有效、对象就被别的线程释放掉的问题"}]},{"ID":"20260511175543-uvlez0w","Type":"NodeParagraph","Properties":{"id":"20260511175543-uvlez0w","updated":"20260511174858"},"Children":[{"Type":"NodeText","Data":"如果强引用计数已经是 0，就说明对象已经析构了，这时候 lock()会直接返回一个空的 shared_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 的“检测”不是单独暴露一个布尔判断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是通过 lock() 这个动作，把“判断是否存活”和“安全获取 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr”合并在一起做"}]},{"ID":"20260511175543-sqx1fgz","Type":"NodeParagraph","Properties":{"id":"20260511175543-sqx1fgz","updated":"20260511175506"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"直接赋值"},{"Type":"NodeText","Data":" "},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"="}]},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"shared_ptr"},{"Type":"NodeText","Data":"​ → "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"shared_ptr"},{"Type":"NodeText","Data":"​ 赋值给 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"weak_ptr"},{"Type":"NodeText","Data":"​（放弃所有权）  强引用不-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为你没有放弃所有权，只是复制了一个弱引用"}]},{"ID":"20260511175543-283n9ay","Type":"NodeParagraph","Properties":{"id":"20260511175543-283n9ay","updated":"20260511175524"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补充"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"expired() 也能判断对象是否过期，但它只适合做状态查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正安全的用法还是 lock()，因为它能避免并发场景下的 TOCTOU 问题"}]},{"ID":"20260511180827-a5bnao3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511180827-a5bnao3","updated":"20260511171645"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"weakptr 怎么去构造的，依赖什么"}]},{"ID":"20260511180827-aio4g4q","Type":"NodeParagraph","Properties":{"id":"20260511180827-aio4g4q","updated":"20260511175908"},"Children":[{"Type":"NodeText","Data":"它通常依赖一个已经存在的 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 本身不拥有对象，它只是“弱引用”这个对象对应的控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以它的构造前提，是系统里已经有一套 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 管理该对象的控制块"}]},{"ID":"20260511180827-964hbqe","Type":"NodeParagraph","Properties":{"id":"20260511180827-964hbqe","updated":"20260511180501"},"Children":[{"Type":"NodeText","Data":"weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 构造时核心不是拷贝对象指针，而是拿到 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 背后的控制块地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并把控制块里的弱引用计数加一"}]},{"ID":"20260511180827-ybgffdk","Type":"NodeParagraph","Properties":{"id":"20260511180827-ybgffdk","updated":"20260511180514"},"Children":[{"Type":"NodeText","Data":"这个控制块里通常会维护两套计数："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个是强引用计数，控制对象何时析构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个是弱引用计数，控制控制块自己何时释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 依赖的就是这套控制块机制"}]},{"ID":"20260511180827-fzsjzss","Type":"NodeParagraph","Properties":{"id":"20260511180827-fzsjzss","updated":"20260511180800"},"Children":[{"Type":"NodeText","Data":"make"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"shared 和直接用 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr(new T) 的创建方式不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但最终都会让 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 关联一个控制块"}]},{"ID":"20260511180827-fk3tdh9","Type":"NodeParagraph","Properties":{"id":"20260511180827-fk3tdh9","updated":"20260511180809"},"Children":[{"Type":"NodeText","Data":"weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 绑定的其实不是对象本身，而是这个控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以本质上，weak"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 依赖的是 shared"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ptr 的控制块，而不是单纯依赖裸指针"}]},{"ID":"20260505170804-3x0ps9c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3x0ps9c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"手写智能指针的思路"}]},{"ID":"20260505170804-c17p8hb","Type":"NodeParagraph","Properties":{"id":"20260505170804-c17p8hb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"unique_ptr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现 unique_ptr 的核心思路是独占式智能指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证同一时间只有一个指针管理对象、不能拷贝、只能移动、自动析构、不产生野指针"}]},{"ID":"20260505170804-xwgovdy","Type":"NodeParagraph","Properties":{"id":"20260505170804-xwgovdy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"整体思路："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部封装一个原始指针 T* ptr 作为成员变量，保存指向的对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"禁用拷贝构造和拷贝赋值，因为 unique_ptr 是独占所有权，不能共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现移动构造和移动赋值，把对象管理权从一个指针转移给另一个，置空原指针，避免重复释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"析构函数里自动 delete 托管的对象，保证离开作用域自动释放内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重载 * 和 -\u003e 运算符，让它用起来和普通指针一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提供 get() 获取原始指针、reset() 释放对象、release() 释放所有权并返回指针"}]},{"ID":"20260505170804-cexpj0p","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-cexpj0p","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 3. 禁用拷贝\n    my_unique_ptr(const my_unique_ptr\u0026) = delete;\n    my_unique_ptr\u0026 operator=(const my_unique_ptr\u0026) = delete;\n// 4. 支持移动（核心：转移所有权）\n    my_unique_ptr(my_unique_ptr\u0026\u0026 other) noexcept {\n        _ptr = other._ptr;\n        other._ptr = nullptr;\n    }\n    my_unique_ptr\u0026 operator=(my_unique_ptr\u0026\u0026 other) noexcept {\n        if (this == \u0026other) return *this;\n        // 先释放自己的资源\n        if (_ptr) delete _ptr;\n        // 接管资源\n        _ptr = other._ptr;\n        other._ptr = nullptr;\n        return *this;\n    }\n// 5. 指针行为重载\n    T\u0026 operator*() const { return *_ptr; }\n    T* operator-\u003e() const { return _ptr; }\n\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ytgsaup","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ytgsaup","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"shared_ptr 底层原理\t\t\u003e\u003e"}]},{"ID":"20260505170804-489s0fn","Type":"NodeParagraph","Properties":{"id":"20260505170804-489s0fn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"shared_ptr 的底层核心是通过引用计数来实现自动管理对象的生命周期"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它内部本质上保存了两个关键指针：一个指向托管的对象，另一个指向堆上分配的引用控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个控制块是一个独立的堆对象，里面不只包含引用计数，还会存储删除器、分配器等信息，同时也包含了 weak_ptr 用到的弱引用计数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有指向同一个对象的 shared_ptr 都会共享这同一个控制块"}]},{"ID":"20260505170804-l43qyj7","Type":"NodeParagraph","Properties":{"id":"20260505170804-l43qyj7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当拷贝 shared_ptr 时，控制块里的强引用计数会原子性加一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当 shared_ptr 被销毁或者重置时，计数会原子性减一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用原子操作是为了保证多线程环境下引用计数不会出现并发错误，让 shared_ptr 的计数管理具备线程安全性"}]},{"ID":"20260505170804-01jkwwh","Type":"NodeParagraph","Properties":{"id":"20260505170804-01jkwwh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"只有当强引用计数减到 0 时，才说明没有任何智能指针在管理这个对象了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时才会真正释放托管的对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而控制块本身则要等到弱引用计数也变为 0 时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"才会最终被释放，从而完整避免内存泄漏"}]},{"ID":"20260505170804-e2plud7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e2plud7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么要使用 make_shared 来创建 shareptr\t\t\u003e\u003e"}]},{"ID":"20260505170804-bcyt1bs","Type":"NodeParagraph","Properties":{"id":"20260505170804-bcyt1bs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优先使用 make_shared，主要是因为它更高效、更安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"make_shared 会把对象内存和引用计数的控制块一次性分配在一起，少一次内存申请和释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"效率更高，也减少内存碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比直接用 shared_ptr\u003cT\u003e(new T) 这种方式，make_shared 还能避免异常安全问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果先 new 再构造智能指针，中间万一抛异常就会造成内存泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 make_shared 是一步创建，不会出现这种漏洞，代码也更简洁"}]},{"ID":"20260505170804-vaf8a96","Type":"NodeParagraph","Properties":{"id":"20260505170804-vaf8a96","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"创建智能指针主要有三种方式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 make_shared/make_unique、通过裸指针直接构造、以及从其他智能指针拷贝或移动生成"}]},{"ID":"20260505170804-bejt3nt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bejt3nt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"shareptr_ptr 的引用计数实现机制"}]},{"ID":"20260505170804-crydthz","Type":"NodeParagraph","Properties":{"id":"20260505170804-crydthz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"shared_ptr 的核心是通过引用计数实现多个智能指针共享同一块堆内存，并在无人使用时自动释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它内部包含两个关键部分："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个指向托管对象的原始指针，另一个指向堆上分配的引用计数对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个引用计数是所有共享同一对象的 shared_ptr 所共有的，而不是每个指针单独持有"}]},{"ID":"20260505170804-bew6ct7","Type":"NodeParagraph","Properties":{"id":"20260505170804-bew6ct7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当进行拷贝构造或赋值操作时，共享的引用计数会原子加 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当智能指针析构或重置时，计数会原子减 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"引用计数使用原子操作，是为了保证多线程下计数更新的安全"}]},{"ID":"20260505170804-1aplx17","Type":"NodeParagraph","Properties":{"id":"20260505170804-1aplx17","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强引用计数由 shared_ptr 维护，每拷贝一个 shared_ptr 强引用计数加 1，析构时减 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当强引用计数降到 0 时，会立即释放托管的对象内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而弱引用计数由 weak_ptr 使用，用来安全地观测对象，不影响对象生命周期"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有当强引用计数和弱引用计数都变为 0 时，才会释放引用计数结构体本身所占的内存"}]},{"ID":"20260505170804-khd0gl8","Type":"NodeParagraph","Properties":{"id":"20260505170804-khd0gl8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"删除器和分配器"},{"Type":"NodeText","Data":"\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"控制块中存储删除器是为了让 shared_ptr 可以自定义对象的释放方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不再局限于默认的 delete，从而能管理文件指针、套接字、malloc 内存等各类资源"}]},{"ID":"20260505170804-4d2phea","Type":"NodeParagraph","Properties":{"id":"20260505170804-4d2phea","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存储分配器则是用于定制控制块自身的内存申请与释放逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适配内存池等特殊内存管理需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 shared_ptr 的使用更加灵活通用"}]},{"ID":"20260505170804-qams0b6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qams0b6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"weak_ptr 检测资源是否失效，是在调用 lock 之前还是 lock 内部？\t\u003e\u003e"}]},{"ID":"20260505170804-us17ddw","Type":"NodeParagraph","Properties":{"id":"20260505170804-us17ddw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"weak_ptr 本身并不直接持有资源，也不会实时监测资源状态，它是通过指向 shared_ptr 共享的控制块，在调用 lock() 的时候，才去查看里面的强引用计数是否为 0，以此判断资源是否还存在"}]},{"ID":"20260505170804-14betvn","Type":"NodeParagraph","Properties":{"id":"20260505170804-14betvn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"检测是在 lock 内部发生的，而且是原子操作："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先判断 expired ()，如果资源有效，就把 weak_ptr 提升为一个有效的 shared_ptr 并返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果资源已经释放，就返回一个空的 shared_ptr，避免出现悬空访问"}]},{"ID":"20260505170804-9sxzuz5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9sxzuz5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Lambda 表达式\t\t\u003e\u003e"}]},{"ID":"20260505170804-4r6i7wf","Type":"NodeParagraph","Properties":{"id":"20260505170804-4r6i7wf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Lambda 表达式是 C++11 的匿名函数，语法简洁、就地定义，能捕获变量，极大简化 STL、线程、回调等代码，提升可读性和开发效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是过度捕获会造成变量生命周期异常、内存泄漏，复杂逻辑会降低可读性，且无法重载、无法默认缺省参数，调试难度略高于普通函数"}]},{"ID":"20260505170804-e1yhpx4","Type":"NodeParagraph","Properties":{"id":"20260505170804-e1yhpx4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[]"},{"Type":"NodeText","Data":" 不捕获，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[=]"},{"Type":"NodeText","Data":" 值捕获外部变量，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[\u0026amp;]"},{"Type":"NodeText","Data":" 引用捕获，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[this]"},{"Type":"NodeText","Data":" 捕获类对象。"}]},{"ID":"20260505170804-6vyuk7s","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-6vyuk7s","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"[捕获列表]（参数列表）-\u003e返回类型，可以省略{\n函数体\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-89b4dc6","Type":"NodeParagraph","Properties":{"id":"20260505170804-89b4dc6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"注意："}]},{"ID":"20260505170804-iq4an1z","Type":"NodeParagraph","Properties":{"id":"20260505170804-iq4an1z","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"引用捕获的生命周期问题"},{"Type":"NodeText","Data":"：若 lambda 表达式的生命周期超过捕获变量的生命周期，会导致"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"野引用"},{"Type":"NodeText","Data":"，访问已释放的内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（如在子线程中引用主线程的局部变量）；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"值捕获的不可修改性"},{"Type":"NodeText","Data":"：值捕获的变量默认是 const 的，若需在 lambda 中修改，需添加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mutable"},{"Type":"NodeText","Data":" 关键字；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"捕获 this 指针"},{"Type":"NodeText","Data":"：类中使用 lambda 时，捕获 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":" 可访问类的成员，本质是引用捕获，需注意 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":" 指向对象的生命周期。"}]},{"ID":"20260505170804-8ma0ibp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8ma0ibp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"lambda 表达式和 const 连用会有问题吗？和智能指针连用会有问题吗？\t\u003e\u003e"}]},{"ID":"20260505170804-9e4aq8o","Type":"NodeParagraph","Properties":{"id":"20260505170804-9e4aq8o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 C++ 里，lambda 表达式和 const 一起使用是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"完全没问题的"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 lambda 本质上就是一个编译器生成的匿名函数对象，用 const 修饰只是让这个对象本身变成只读，并不会影响它的调用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过要注意一点，lambda 默认不能修改捕获的变量，如果确实需要修改，需要加上 mutable 关键字"}]},{"ID":"20260505170804-8gypzj2","Type":"NodeParagraph","Properties":{"id":"20260505170804-8gypzj2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"lambda 和智能指针一起使用时，大部分场景也是安全的，但有两个关键点需要注意"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对于 shared_ptr，优先使用值捕获"},{"Type":"NodeText","Data":"，这样会增加引用计数，能把对象的生命周期延长到和 lambda 一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量不要用引用捕获，否则很容易出现智能指针已经释放、lambda 调用时悬空指针的问题"}]},{"ID":"20260505170804-6snu3wz","Type":"NodeParagraph","Properties":{"id":"20260505170804-6snu3wz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"unique_ptr 因为不能拷贝，只能做移动捕获"},{"Type":"NodeText","Data":"，把所有权转移给 lambda，不能直接值捕获"}]},{"ID":"20260505170804-30qljmu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-30qljmu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"lambda 表达式底层是怎么实现的\t\u003e\u003e"}]},{"ID":"20260505170804-0ghvrhc","Type":"NodeParagraph","Properties":{"id":"20260505170804-0ghvrhc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"lambda 表达式底层本质就是一个仿函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器会自动把 lambda 生成一个匿名的类重载 operator ()，调用时和普通类、普通函数完全一样"}]},{"ID":"20260505170804-l19y7v1","Type":"NodeParagraph","Properties":{"id":"20260505170804-l19y7v1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"lambda 本质 ：编译器自动生成的匿名类 + 重载 operator ()"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"捕获变量 = 成为这个匿名类的成员变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调用 lambda = 调用这个类的 operator ()"}]},{"ID":"20260505170804-zdddzjq","Type":"NodeParagraph","Properties":{"id":"20260505170804-zdddzjq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编译器看到 lambda，会自动生成一个没有名字的类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 lambda 捕获变量，这些变量就会变成类的成员变量，在构造时初始化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lambda 的函数体，就是这个类里 operator () 的实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"值捕获、引用捕获，只是成员变量是值拷贝还是引用的区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有捕获的 lambda，还能隐式转换成函数指针"}]},{"ID":"20260505170804-e1k9ql0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e1k9ql0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"仿函数对比普通函数的优缺点\t\t\u003e\u003e"}]},{"ID":"20260505170804-auq977h","Type":"NodeParagraph","Properties":{"id":"20260505170804-auq977h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"仿函数比普通函数能存状态，可以在多次调用之间记住数据，不用全局变量，更安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且它是类类型，配合 STL 和模板更好用，编译器优化也更强，效率更高"}]},{"ID":"20260505170804-p70jbim","Type":"NodeParagraph","Properties":{"id":"20260505170804-p70jbim","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"缺点就是写起来麻烦，要定义类、重载括号运算符，代码比普通函数啰嗦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单功能用起来没必要，可读性也差一点"}]},{"ID":"20260505170804-q5dfjwf","Type":"NodeParagraph","Properties":{"id":"20260505170804-q5dfjwf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"匿名类"},{"Type":"NodeText","Data":"\t\t\u003e\u003e"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++ 匿名类就是没有类名、只能在定义时直接创建对象的临时类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般用在只需要一次性使用、不需要复用的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不能被继承，也不能再定义新对象，常用来封装临时数据或简单逻辑，用完就销毁，代码更简洁"}]},{"ID":"20260505170804-wub5vpl","Type":"NodeTable","Data":"|对比维度|普通函数|Lambda 表达式|仿函数（Functor）|\n| --------| ----------------------| ----------------------------| ------------------------------|\n|\u003cspan data-type=\"strong\"\u003e本质\u003c/span\u003e|普通函数|匿名函数对象|重载 \u003cspan data-type=\"code\"\u003e()\u003c/span\u003e 的类对象|\n|\u003cspan data-type=\"strong\"\u003e保存状态\u003c/span\u003e|不能保存（无成员变量）|可捕获，但临时、不可复用|\u003cspan data-type=\"strong\"\u003e可持久保存状态\u003c/span\u003e（成员变量）|\n|\u003cspan data-type=\"strong\"\u003e复用性\u003c/span\u003e|可复用|一次性使用，难以跨作用域复用|\u003cspan data-type=\"strong\"\u003e高度复用、可继承、可多态\u003c/span\u003e|\n|\u003cspan data-type=\"strong\"\u003e使用灵活性\u003c/span\u003e|固定逻辑|轻量、就地使用|最灵活，可配置、可扩展|\n|\u003cspan data-type=\"strong\"\u003e典型场景\u003c/span\u003e|通用、无状态逻辑|简单回调、临时逻辑|复杂策略、有状态计算、STL 谓词|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-wub5vpl","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比维度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"普通函数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Lambda 表达式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仿函数（Functor）"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"本质"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"普通函数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"匿名函数对象"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"重载 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"()"},{"Type":"NodeText","Data":" 的类对象"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保存状态"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不能保存（无成员变量）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可捕获，但临时、不可复用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"可持久保存状态"},{"Type":"NodeText","Data":"（成员变量）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"复用性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可复用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"一次性使用，难以跨作用域复用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高度复用、可继承、可多态"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用灵活性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"固定逻辑"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"轻量、就地使用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"最灵活，可配置、可扩展"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"典型场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"通用、无状态逻辑"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"简单回调、临时逻辑"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"复杂策略、有状态计算、STL 谓词"}]}]}]},{"ID":"20260505170804-8lz1465","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8lz1465","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"lambda 表达式捕获 this 指针，this 会有什么情况？\t\t\u003e\u003e"}]},{"ID":"20260505170804-ns410tb","Type":"NodeParagraph","Properties":{"id":"20260505170804-ns410tb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 C++ 中，lambda 表达式捕获 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":"，本质上是捕获当前对象的指针，而不是拷贝对象本身"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这意味着 lambda 内部访问类成员变量、成员函数，都是通过这个原始指针操作的"}]},{"ID":"20260505170804-3q24l8t","Type":"NodeParagraph","Properties":{"id":"20260505170804-3q24l8t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这种捕获方式最大的问题是生命周期安全风险"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 lambda 被异步执行，比如放到线程、定时器或者回调函数里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而当前对象已经被销毁了，lambda 再去访问成员就会出现悬空指针，导致程序崩溃或未定义行为"}]},{"ID":"20260505170804-s9siz15","Type":"NodeParagraph","Properties":{"id":"20260505170804-s9siz15","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外要注意，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[=]"},{"Type":"NodeText","Data":" 值捕获默认会隐式包含 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":"，所以即使写了值捕获，访问类成员依然是操作原对象，并不会拷贝对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正安全的值捕获方式是 C++14 引入的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[*this]"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会拷贝整个对象到 lambda 内部，和原对象脱离关系，避免悬空指针问题"}]},{"ID":"20260505170804-cn5i3bu","Type":"NodeParagraph","Properties":{"id":"20260505170804-cn5i3bu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时，捕获 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"this"},{"Type":"NodeText","Data":" 还存在线程安全问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果多个线程通过同一个 this 指针读写成员变量，不加同步机制就会产生数据竞争，导致逻辑错误"}]},{"ID":"20260505170804-8fwsdve","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8fwsdve","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"移动构造和移动赋值运算符"}]},{"ID":"20260505170804-fgmxejo","Type":"NodeParagraph","Properties":{"id":"20260505170804-fgmxejo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++11 的移动构造和移动赋值是移动语义的核心，专门用来处理临时对象，也就是右值。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有带资源的类对象，用 \u0026\u0026 或 move 转移资源时，才叫移动构造。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"移动构造是在创建新对象时，直接接管临时对象的资源，不做深拷贝；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"移动赋值是给已有对象赋值时，先释放自身资源，再转移临时对象的资源。"}]},{"ID":"20260505170804-xypousf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-xypousf","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"  String(String\u0026\u0026 other) noexcept {\n        // 1. 直接拿走对方的资源指针\n        m_data = other.m_data;\n        // 2. 把源对象置空，防止被析构释放\n        other.m_data = nullptr;\n        cout \u003c\u003c \"移动构造(偷资源): \" \u003c\u003c m_data \u003c\u003c endl;\n    }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-o1y8xrn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-o1y8xrn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常引用和右值引用 都能接收右值的绑定 有什么区别？"}]},{"ID":"20260505170804-chhh2mx","Type":"NodeParagraph","Properties":{"id":"20260505170804-chhh2mx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"const 引用只能读临时值，不能改，用来避免拷贝、延长生命周期；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右值引用可以修改、接管临时值的资源，专门实现移动语义。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const 引用能绑左值、右值；右值引用只能绑右值，左值要靠 move 转。"}]},{"ID":"20260505170804-lmmks0h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lmmks0h","updated":"20260512123556"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"右值引用都有什么作用？\t\u003e\u003e"}]},{"ID":"20260505170804-e22dxoc","Type":"NodeParagraph","Properties":{"id":"20260505170804-e22dxoc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"除了延长常量对象生命周期外，还包括"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是实现移动语义，把临时对象的资源直接转移给新对象，避免不必要的深拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是实现完美转发，在模板中保持参数原本的左值、右值属性，精确传递给下层函数"}]},{"ID":"20260505170804-dmbzlrq","Type":"NodeParagraph","Properties":{"id":"20260505170804-dmbzlrq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"移动语义依靠移动构造函数和移动赋值运算符实现，函数参数为右值引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现时，直接把临时对象的资源指针赋值给当前对象，再将原对象指针置空，防止资源被重复释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比深拷贝需要重新分配内存，移动语义只做资源所有权转移，复杂度从 O (n) 降到 O (1)，效率大幅提升"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当传入临时对象、匿名对象或用 std::move 转换后的左值时，编译器会优先调用移动版本的函数，从而优化性能"}]},{"ID":"20260512123556-7xt9zdx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512123556-7xt9zdx","updated":"20260512123324"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"右值引用场景"}]},{"ID":"20260512123556-1s1yzbo","Type":"NodeParagraph","Properties":{"id":"20260512123556-1s1yzbo","updated":"20260512123406"},"Children":[{"Type":"NodeText","Data":"常见场景有三个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"移动构造和移动赋值"},{"Type":"NodeText","Data":"，比如类里有堆内存、文件句柄、socket 这类资源时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以通过 T(T\u0026\u0026) 和 operator"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"="}]},{"Type":"NodeText","Data":"(T\u0026\u0026) 把资源转移走"}]},{"ID":"20260512123556-2e84074","Type":"NodeParagraph","Properties":{"id":"20260512123556-2e84074","updated":"20260512123419"},"Children":[{"Type":"NodeText","Data":"第二，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"std::move"},{"Type":"NodeText","Data":"，把一个左值显式转成右值，告诉编译器“这个对象后面我不再用了，可以搬走”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"模板里的完美转发"},{"Type":"NodeText","Data":"，比如 std::forward"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证传进来的参数左值还是左值、右值还是右值，避免语义丢失"}]},{"ID":"20260505170804-izv29pp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-izv29pp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"谈一下你对移动构造函数的理解\t\u003e\u003e"}]},{"ID":"20260505170804-70godur","Type":"NodeParagraph","Properties":{"id":"20260505170804-70godur","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"移动构造函数是 C++11 引入的一种特殊构造函数，主要用来"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"转移对象资源的所有权"},{"Type":"NodeText","Data":",而不是像拷贝构造那样复制数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心思想是：对于即将销毁的临时对象，我们没必要完整拷贝一份，直接把它的资源 “偷” 过来就行，这样能大幅提升性能"}]},{"ID":"20260505170804-0qjxakg","Type":"NodeParagraph","Properties":{"id":"20260505170804-0qjxakg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"移动构造的参数通常是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"右值引用"},{"Type":"NodeText","Data":"，比如 T\u0026\u0026"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在函数内部，我们会把源对象的指针、数组、文件句柄等资源直接赋值给当前对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后把源对象的指针置空，避免它析构时把资源释放掉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样既完成了对象构造，又避免了昂贵的内存拷贝"}]},{"ID":"20260505170804-uthag0v","Type":"NodeParagraph","Properties":{"id":"20260505170804-uthag0v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和拷贝构造相比，移动构造是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"浅拷贝 + 所有权转移"},{"Type":"NodeText","Data":"，而拷贝构造是深拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 STL 容器里，移动构造尤其重要，如果一个类实现了 noexcept 的移动构造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"容器在扩容、插入时会优先使用移动，性能会比拷贝高很多"}]},{"ID":"20260505170804-1ko87cy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1ko87cy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"资源转移后， 被移动后的对象处于什么状态？\t\u003e\u003e"}]},{"ID":"20260505170804-j88q2qx","Type":"NodeParagraph","Properties":{"id":"20260505170804-j88q2qx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有效未指定状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"置空指针的目的不仅是避免重复释放资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更核心的是保证被移动的对象仍然能够被安全地析构或重新赋值"}]},{"ID":"20260505170804-3naa5oa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-3naa5oa","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":" // 普通构造\n    String(const char* str) {\n        size_t len = strlen(str) + 1;\n        data = new char[len];\n        memcpy(data, str, len);\n        std::cout \u003c\u003c \"构造函数\" \u003c\u003c std::endl;\n    }\n    // 拷贝构造（深拷贝）\n    String(const String\u0026 other) {\n        size_t len = strlen(other.data) + 1;\n        data = new char[len];\n        memcpy(data, other.data, len);\n        std::cout \u003c\u003c \"拷贝构造（深拷贝）\" \u003c\u003c std::endl;\n    }\n    // 移动构造（右值引用，转移资源）\n    String(String\u0026\u0026 other) noexcept {\n        // 直接“偷走”资源\n        data = other.data;\n        // 置空源对象，避免重复释放\n        other.data = nullptr;\n        std::cout \u003c\u003c \"移动构造（资源转移）\" \u003c\u003c std::endl;\n    }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-d467wva","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d467wva","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"左值、右值、和 move"}]},{"ID":"20260505170804-k420xuh","Type":"NodeParagraph","Properties":{"id":"20260505170804-k420xuh","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"左值就是有名字、有内存地址、能长期存在的变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 int a 里的 a，可以取地址、可以被赋值"}]},{"ID":"20260505170804-a4u58hn","Type":"NodeParagraph","Properties":{"id":"20260505170804-a4u58hn","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"右值是临时值，用完就销毁，没有固定地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如字面量 10、函数返回的临时对象，不能取地址，也不能放在等号左边赋值"}]},{"ID":"20260505170804-oo2pvpz","Type":"NodeParagraph","Properties":{"id":"20260505170804-oo2pvpz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"左值引用 \u0026 只能绑定左值，代表一个对象的别名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右值引用 \u0026\u0026 只能绑定右值，目的是把临时对象 “抓住”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右值引用一绑定，临时对象的寿命就会延长到和引用本身一样长"}]},{"ID":"20260505170804-35kso74","Type":"NodeParagraph","Properties":{"id":"20260505170804-35kso74","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::move 底层本质就是一个类型转换，它不移动任何数据，只是把一个左值强制转成右值引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正完成移动操作的，是移动构造函数或移动赋值运算符，它们直接把原对象的指针、内存等资源 “转移” 过来，再把原对象置空，全程不用拷贝数据，所以效率极高"}]},{"ID":"20260505170804-cmv84h4","Type":"NodeParagraph","Properties":{"id":"20260505170804-cmv84h4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"再配上万能引用 T\u0026\u0026 和引用折叠，C++ 实现了完美转发 std::forward，保证参数在多层函数调用里，左值还是左值、右值还是右值，不丢失属性"}]},{"ID":"20260505170804-fhs1hud","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fhs1hud","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"完美转发"}]},{"ID":"20260505170804-cyfhx65","Type":"NodeParagraph","Properties":{"id":"20260505170804-cyfhx65","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::forward 完美转发的核心作用，是把上层函数收到的参数，原封不动地转发给下层函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保留它原本是左值还是右值的属性，避免不必要的拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的实现主要依赖两个关键机制："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"万能引用 T\u0026\u0026"},{"Type":"NodeText","Data":"，可以同时接收左值和右值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另一个是 C++ 中的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"引用折叠规则"},{"Type":"NodeText","Data":"，通过模板类型推导，把参数还原成原本的值类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上 std::forward 就是一个有条件的类型转换，根据推导结果返回对应的左值引用或右值引用，从而实现完整的属性保留"}]},{"ID":"20260505170804-dmdqagr","Type":"NodeParagraph","Properties":{"id":"20260505170804-dmdqagr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"完美转发在实际项目里用得非常多"}]},{"ID":"20260505170804-t7j4ra3","Type":"NodeParagraph","Properties":{"id":"20260505170804-t7j4ra3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"典型场景包括各种工厂函数，把参数直接转发给构造函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有像 emplace_back、make_shared 这类需要原地构造的接口，内部都依赖完美转发来避免拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外，在封装线程、异步调用、通用代理函数时，也会用它把参数高效、无损地传递到目标函数，保证性能和语义一致"}]},{"ID":"20260505170804-h9jibj1","Type":"NodeParagraph","Properties":{"id":"20260505170804-h9jibj1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"至于限制，完美转发必须依赖模板推导，所以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只能在模板函数里使用，普通函数是做不到的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为普通函数没有类型推导，无法判断参数是左值还是右值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"除此之外，它也不能完美转发花括号初始化列表，对 NULL、0 这种空指针、重载函数的转发也会出现推导异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完美转发最害怕 int 伪装成指针（NULL）和 无名的一堆函数（重载名）"}]},{"ID":"20260505170804-k6xkuel","Type":"NodeParagraph","Properties":{"id":"20260505170804-k6xkuel","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时，因为依赖模板，它也不能用于虚函数，这些都是实际使用中需要注意的地方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为虚函数是运行时多态，依靠虚表来动态绑定调用哪个函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而模板是编译期展开的，编译器在编译时就要确定类型、生成具体函数"}]},{"ID":"20260505170804-ht2rydl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ht2rydl","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"void func(int\u0026\u0026 arg) {\n    // 这里只能接收右值\n}\nvoid test(int\u0026\u0026 arg) {\n    // 传进去已经变成左值了！转发失败\n    func(arg);\n}\nint main() {\n    test(10); // 报错：无法将左值绑定到右值引用\n}\n\ntest 是普通函数，参数类型写死 int\u0026\u0026\n虽然你传的是右值 10，但进入函数后，arg 有名字 → 变成左值\n再传给 func(arg) 就传不过去了\n普通函数没有推导，不知道你原来传的是左值还是右值\n    \n    void func(int\u0026)  { cout \u003c\u003c \"左值\" \u003c\u003c endl; }\nvoid func(int\u0026\u0026) { cout \u003c\u003c \"右值\" \u003c\u003c endl; }\n\ntemplate\u003ctypename T\u003e\nvoid test(T\u0026\u0026 arg) {\n    // 靠推导 + 引用折叠，知道原来是什么类型\n    func(std::forward\u003cT\u003e(arg));\n}\n\nint main() {\n    int a = 10;\n    test(a);   // 推导 T=int\u0026 转发左值\n    test(20);  // 推导 T=int  转发右值\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ngmhv7e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ngmhv7e","updated":"20260506195640"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"引用折叠"}]},{"ID":"20260505170804-81c2qra","Type":"NodeParagraph","Properties":{"id":"20260505170804-81c2qra","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为什么会出现 T\u0026 \u0026\u0026 这种东西？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为模板自动推导 + 万能引用 T\u0026\u0026，撞在一起了"}]},{"ID":"20260505170804-d16hx6n","Type":"NodeParagraph","Properties":{"id":"20260505170804-d16hx6n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 自动把多层引用合并成一层规则：有 \u0026 就是 \u0026，全是 \u0026\u0026 才是 \u0026\u0026"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 T\u0026\u0026 变成万能引用，让 forward 能完美转发"}]},{"ID":"20260506194848-26ne5xa","Type":"NodeParagraph","Properties":{"id":"20260506194848-26ne5xa","updated":"20260506194926"},"Children":[{"Type":"NodeText","Data":"T\u0026\u0026 靠模板推导 + 引用折叠："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自动匹配实参是左值还是右值，把值类别完整保留下来。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但有个坑："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"形参 arg 本身有名字，在函数体内永远是左值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪怕外面传的是右值，进到函数里 arg 也变成左值了，直接传会变成值丢失、转发不完美。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以必须第三步。std::forward"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003c"}]},{"Type":"NodeText","Data":"T"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":"(arg)"}]},{"ID":"20260506194849-4bmb6im","Type":"NodeParagraph","Properties":{"id":"20260506194849-4bmb6im","updated":"20260506195640"},"Children":[{"Type":"NodeText","Data":"forward = 用 static_cast\u003cT\u0026\u0026\u003e + 引用折叠，把参数还原成原来的左值或右值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 T 是左值引用类型 → forward 转成左值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 T 是普通类型 → forward 转成右值"}]},{"ID":"20260506195325-g4gef67","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260506195325-g4gef67","updated":"20260506195339"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"template\u003ctypename T\u003e\nvoid wrapper(T\u0026\u0026 arg) {\n    target( std::forward\u003cT\u003e(arg) );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-6ki5ylj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6ki5ylj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"std::move"}]},{"ID":"20260505170804-ea0pnri","Type":"NodeParagraph","Properties":{"id":"20260505170804-ea0pnri","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"本质：把左值强制转为右值引用，不移动任何资源；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用：让对象调用移动构造 / 赋值，替代深拷贝，优化堆资源对象的性能；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"注意：移动后原对象成空壳不可用，仅对 C++ 自带的基本类型（没有堆资源）有效。"}]},{"ID":"20260505170804-2wlwwyx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-2wlwwyx","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003ciostream\u003e\n#include \u003cstring\u003e\n#include \u003cutility\u003e // 包含std::move\nusing namespace std;\n\nint main() {\n    string a = \"hello world\"; // 左值，持有堆内存资源\n    // 不用move：调用拷贝构造，深拷贝（分配新内存）\n    string b = a; \n    cout \u003c\u003c \"拷贝后 a: \" \u003c\u003c a \u003c\u003c endl; // 输出：hello world（a仍有资源）\n\n    // 用move：将a转为右值引用，调用移动构造（转移资源）\n    string c = std::move(a);\n    cout \u003c\u003c \"移动后 c: \" \u003c\u003c c \u003c\u003c endl; // 输出：hello world（c接管资源）\n    cout \u003c\u003c \"移动后 a: \" \u003c\u003c a \u003c\u003c endl; // 输出空（a的资源已被转移，变为空壳）\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-zhff3m0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zhff3m0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"move 的底层"}]},{"ID":"20260505170804-1k0ie7i","Type":"NodeParagraph","Properties":{"id":"20260505170804-1k0ie7i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::move 的本质并不是真正移动数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它本身没有任何运行时开销，底层只是一个编译期的类型转换函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用是把一个左值强制转换成右值引用，从而让编译器优先匹配移动构造或移动赋值函数，实现资源转移而非深拷贝"}]},{"ID":"20260505170804-eg6tpia","Type":"NodeParagraph","Properties":{"id":"20260505170804-eg6tpia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它的实现核心就是利用万能引用接收参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再通过类型萃取 std::remove_reference 去掉引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后用 static_cast 强转为右值引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个过程只发生在编译阶段，不会申请、释放内存，也不会拷贝数据"}]},{"ID":"20260505170804-2cvwnpb","Type":"NodeParagraph","Properties":{"id":"20260505170804-2cvwnpb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"真正完成移动操作的，是对应类的移动构造函数或移动赋值运算符"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 vector、string 这些容器，移动时会直接接管原对象的内部指针，再把原对象置空，实现零拷贝的高效资源转移"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外要注意，被 const 修饰的对象即使经过 move，也无法触发移动语义，只能走拷贝"}]},{"ID":"20260505170804-3z2wkmz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3z2wkmz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"std::move 失效场景 \u0026 实际场景\t\t\u003e\u003e"}]},{"ID":"20260505170804-9q1s4vs","Type":"NodeParagraph","Properties":{"id":"20260505170804-9q1s4vs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::move 本身不会执行移动操作，它仅仅是把左值强制转换成右值引用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能不能真正移动，还要看编译器能不能匹配到移动构造 / 移动赋值函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"满足条件才移动，否则依然退化为拷贝，这就是 move 失效"}]},{"ID":"20260505170804-8dy9kfr","Type":"NodeParagraph","Properties":{"id":"20260505170804-8dy9kfr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"move 后再次使用原变量，会变回左值失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对 const 对象 move，无法匹配移动函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器 RVO 返回优化会直接忽略 move"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"类没有移动构造、移动可能抛异常，也都会降级拷贝"}]},{"ID":"20260505170804-qlp3z4s","Type":"NodeParagraph","Properties":{"id":"20260505170804-qlp3z4s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实际开发场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平时写代码最常见："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"转移 vector、string 大资源后又访问原变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lambda 值捕获后再 move"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const 对象强行 move，都会出现写了 move 但依然深拷贝，性能变差"}]},{"ID":"20260505170804-q3fokat","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-q3fokat","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"auto 和 decltype\t\t\u003e\u003e"}]},{"ID":"20260505170804-clg7g7o","Type":"NodeParagraph","Properties":{"id":"20260505170804-clg7g7o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"auto 用来推导变量类型，必须初始化，会自动去掉顶层 const 和引用，用起来最简洁，适合日常写代码简化类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"decltype 用来推导表达式类型，不需要初始化，完整保留 const 和引用，推导更精准，多用于模板、返回值这类严谨场景"}]},{"ID":"20260505170804-wol98ti","Type":"NodeParagraph","Properties":{"id":"20260505170804-wol98ti","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"变量类型：这个变量本来是什么类型，写代码时就定死了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"表达式类型：把变量扔到一行代码里参与运算，这行代码算出来的结果是什么类型"}]},{"ID":"20260505170804-x1x2nt3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-x1x2nt3","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"int x = 10;\nconst int\u0026 rx = x;\n\nauto a = rx;\ndecltype(rx) b = x;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-etabn44","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-etabn44","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"const 与 constexpr"}]},{"ID":"20260505170804-307b38n","Type":"NodeParagraph","Properties":{"id":"20260505170804-307b38n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"const: 主要用于指明变量的值在初始化后就不应该被改变"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const 变量的值可以在运行时确定，也可以在编译时确定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"const 变量的初始化可以是任意复杂的表达式"}]},{"ID":"20260505170804-kcgpf8z","Type":"NodeParagraph","Properties":{"id":"20260505170804-kcgpf8z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"constexpr: 是 C++11 新引入的关键字，用于声明表达式为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编译时常量"},{"Type":"NodeText","Data":"，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证了变量或函数在编译时就已经确定了值，使得它们可以用在需要编译时常量表达式的场景中，例如数组的大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"constexpr 变量或函数必须在编译时就能确定其值或结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"constexpr 可以用于函数和构造函数，可以创建在编译时就能计算出结果的函数和对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"constexpr 变量或函数的初始化表达式必须足够简单，以便编译器能够在编译时求值"}]},{"ID":"20260505170804-v1nql2c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-v1nql2c","updated":"20260512123732"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"std::forward 完美转发\t\t\t\u003e\u003e"}]},{"ID":"20260505170804-8iuh35u","Type":"NodeParagraph","Properties":{"id":"20260505170804-8iuh35u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::forward = 完美转发核心"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用：模板传参时，原样保留参数是左值还是右值，不丢失属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原理：靠引用折叠，左值保持左值，右值保持右值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用法：只配合万能引用 T\u0026\u0026 使用"}]},{"ID":"20260505170804-8s1k1hh","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-8s1k1hh","updated":"20260512123732"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003ciostream\u003e\n#include \u003cutility\u003e   // std::forward 完美转发需要\n\nvoid print(int\u0026 x) {\n    std::cout \u003c\u003c \"左值版本: \" \u003c\u003c x \u003c\u003c std::endl;\n}\n\nvoid print(int\u0026\u0026 x) {\n    std::cout \u003c\u003c \"右值版本: \" \u003c\u003c x \u003c\u003c std::endl;\n}\n\n// ================== 完美转发模板函数 ==================\n\n如果你传进来的是左值，T 会被推导成 T\u0026，整个参数类型会折叠成左值引用\n如果传进来的是右值，T 才会推导成普通类型，参数变成右值引用\n\n问题在于：函数里的 arg 这个名字一旦存在，它本身永远是左值\n// T\u0026\u0026：万能引用，可以接收 左值 或 右值\ntemplate \u003ctypename T\u003e\nvoid forward(T\u0026\u0026 arg) {\n    print(std::forward\u003cT\u003e(arg));\n}\n\nint main() {\n    int a = 10;        // a 是左值\n\n    forward(a);        // 传入左值转发后调用 print(int\u0026)\n    forward(20);       // 传入右值转发后调用 print(int\u0026\u0026)\n\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-m1dszf5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m1dszf5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++ atomic"}]},{"ID":"20260505170804-oqg76by","Type":"NodeParagraph","Properties":{"id":"20260505170804-oqg76by","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::atomic 是 C++11 提供的原子类型模板，主要用来在多线程环境下对单个变量实现无锁的线程安全访问，避免数据竞争"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不需要手动加锁解锁，底层依靠 CPU 原子指令和缓存一致性协议来保证操作不可分割，相比互斥锁开销更小，性能更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它最常用在计数器、状态标志位这类简单场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持原子读写 load/store、加减 fetch_add/fetch_sub、交换 exchange 以及 CAS 比较并交换操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时 atomic 还支持内存序控制，从宽松的 memory_order_relaxed 到最强的顺序一致性 memory_order_seq_cst"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以在保证可见性和有序性的同时做性能优化"}]},{"ID":"20260505170804-1r577f5","Type":"NodeParagraph","Properties":{"id":"20260505170804-1r577f5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用上要注意它只适用于单个变量的简单原子操作，不能直接用于复杂数据结构和多步骤逻辑，这种场景还是要用 mutex"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外它本身不可拷贝赋值，一般会定义成全局变量或成员变量使用"}]},{"ID":"20260505170804-itc0f3j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-itc0f3j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于算法"}]},{"ID":"20260505170804-ac5llks","Type":"NodeParagraph","Properties":{"id":"20260505170804-ac5llks","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260214150223118"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260214150223118.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-qy64c7o","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-qy64c7o","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"C++11 特性"}]},{"ID":"20260505170804-9k8ljzm","Type":"NodeParagraph","Properties":{"id":"20260505170804-9k8ljzm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"智能指针："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::unique_ptr：独占所有权，不可拷贝，可移动，轻量级，替代 auto_ptr；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::shared_ptr：共享所有权，通过引用计数管理，线程安全（引用计数操作原子性）；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::weak_ptr：解决 shared_ptr 循环引用问题，不增加引用计数；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Lambda 表达式："},{"Type":"NodeText","Data":"匿名函数，简化回调、STL 算法使用，无需定义独立函数/函数对象；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"范围 for："},{"Type":"NodeText","Data":"for(int num: vec){cout\u003c\u003cnums;}"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"auto 类型推导："},{"Type":"NodeText","Data":"编译器自动推导变量类型，减少冗长的类型书写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"\u0026\u0026右值引用："},{"Type":"NodeText","Data":"解决深拷贝的性能问题，配合 std::move 使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"完美转发："},{"Type":"NodeText","Data":"通过 std::forward 保持参数的左值/右值属性，主要用于模版函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"emplace 系列函数："},{"Type":"NodeText","Data":"直接在容器内构造对象，减少一次拷贝/移动"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"并发编程（现代 C++ 必备）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原生支持多线程，无需依赖第三方库。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::thread：原生线程类，替代 pthread 等平台相关接口；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::mutex/lock_guard：互斥锁，解决线程安全问题，lock_guard 是 RAII 风格的锁，自动释放；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::condition_variable：条件变量，实现线程间通信；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"std::atomic：原子操作，替代手动加锁，实现高效的线程安全变量；"}]},{"ID":"20260505170804-k41ygz4","Type":"NodeParagraph","Properties":{"id":"20260505170804-k41ygz4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C++11 还引入了 std::function，统一函数、Lambda、函数指针的调用接口；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"std::initializer_list 支持列表初始化（如 vector"}]},{"ID":"20260505170804-yip84oh","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-yip84oh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"智能指针是线程安全的吗"}]},{"ID":"20260505170804-naovm6e","Type":"NodeParagraph","Properties":{"id":"20260505170804-naovm6e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"智能指针本身不是绝对线程安全的。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能指针的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"引用计数是线程安全的"},{"Type":"NodeText","Data":"，但"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"指针本身和管理的对象都不安全"},{"Type":"NodeText","Data":"。多线程操作同一个智能指针变量会出问题，必须加锁；如果只是每个线程复制一份独立使用，则安全。读写共享资源必须加锁。"}]},{"ID":"20260505170804-3jjr04e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3jjr04e","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"子类不能继承父类的函数有哪些？"}]},{"ID":"20260505170804-owra9hb","Type":"NodeParagraph","Properties":{"id":"20260505170804-owra9hb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"构造、析构、拷贝构造、赋值运算符"},{"Type":"NodeText","Data":"都和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"类的结构、初始化、销毁、复制强相关"},{"Type":"NodeText","Data":"，每个类的成员不同，因此不能继承；而私有成员是父类的内部实现，受封装保护，子类无权继承和访问。"}]},{"ID":"20260505170804-ei9fxhc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ei9fxhc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么模板类一般都是放在一个 h 文件中？"}]},{"ID":"20260505170804-ptrdy4a","Type":"NodeParagraph","Properties":{"id":"20260505170804-ptrdy4a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"(1)"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"模板类在编译期实例化"},{"Type":"NodeText","Data":"：模板类的实例化发生在编译期，编译器需要在实例化模板时看到模板的完整定义和实现。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"(2)"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头文件包含完整定义和实现"},{"Type":"NodeText","Data":"：将模板类的定义和实现都放在头文件中，确保编译器在实例化模板时能访问到完整信息，避免链接错误。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"(3)"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"避免链接错误"},{"Type":"NodeText","Data":"：如果将模板类的实现放在源文件中，可能会导致链接错误，因为编译器在链接阶段无法找到模板实例化的具体实现。"}]},{"ID":"20260505170804-u5bdj0w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-u5bdj0w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"using 关键字、对比旧 typedef"}]},{"ID":"20260505170804-m2m6yqt","Type":"NodeParagraph","Properties":{"id":"20260505170804-m2m6yqt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"using 是 C++11 及以后的类型别名关键字"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"语法直观易读，支持模板别名，还能用于引入命名空间、继承构造函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"旧的 typedef 只能给普通类型起别名，不支持模板，语法可读性差，容易歧义"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"现代 C++ 一律优先使用 using 替代 typedef"}]},{"ID":"20260505170804-ke0wwqf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ke0wwqf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C++11 常用新特性"}]},{"ID":"20260505170804-0st4fej","Type":"NodeParagraph","Properties":{"id":"20260505170804-0st4fej","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"nullptr：替代 NULL，解决空指针二义性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"auto / decltype：自动类型推导，代码更简洁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"范围 for 循环：遍历容器更方便"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右值引用 \u0026 移动语义：避免深拷贝，大幅提升性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lambda 表达式：匿名函数，配合 STL 非常方便"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能指针：unique_ptr、shared_ptr、weak_ptr，自动管理内存，防止泄漏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并发支持：thread、mutex、atomic，原生多线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"初始化列表：统一初始化方式，更简洁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"override / final：明确虚函数重写，防止出错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"constexpr：编译期常量，性能更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"emplace_back：直接构造，避免拷贝，比 push_back 高效"}]},{"ID":"20260505170804-jfg3aas","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jfg3aas","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"lock_guard 底层实现原理"}]},{"ID":"20260505170804-plp2qev","Type":"NodeParagraph","Properties":{"id":"20260505170804-plp2qev","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"专门管理互斥锁，依靠 RAII 机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进入代码块自动加锁，离开代码块自动解锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用手动写解锁，防止忘记解锁、异常崩溃导致死锁，保证线程安全"}]},{"ID":"20260505170804-ivqzsyd","Type":"NodeParagraph","Properties":{"id":"20260505170804-ivqzsyd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::lock_guard 基于 RAII 思想实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"构造函数：接收互斥锁，自动调用 lock () 加锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"析构函数：对象出作用域销毁时，自动调用 unlock () 解锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"禁止拷贝、禁止移动，只能独占绑定一把锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"全程不用手动解锁，哪怕函数异常、提前 return，析构也一定会执行，杜绝死锁和漏解锁"}]},{"ID":"20260505170804-9keq1j1","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-9keq1j1","updated":"20260505170804"}},{"ID":"20260505170804-rqtk3fr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-rqtk3fr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"网络"}]},{"ID":"20260505170804-tpmsu3l","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-tpmsu3l","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"何为网络"}]},{"ID":"20260505170804-4ot00kr","Type":"NodeParagraph","Properties":{"id":"20260505170804-4ot00kr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"网络是把多台设备通过传输介质、协议连接起来的集合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心目的：数据传输、资源共享、信息交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"依靠统一网络规则，实现不同设备之间跨距离通信"}]},{"ID":"20260505170804-3q0rw4j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3q0rw4j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"send 和 recv 函数需要导入什么库"}]},{"ID":"20260505170804-dtugobn","Type":"NodeParagraph","Properties":{"id":"20260505170804-dtugobn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"send 和 recv 是网络套接字通信函数，属于系统提供的网络编程接口"}]},{"ID":"20260505170804-olfn5zi","Type":"NodeParagraph","Properties":{"id":"20260505170804-olfn5zi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"windows 下需要包含 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"winsock2.h"},{"Type":"NodeText","Data":",链接 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ws2_32.lib"},{"Type":"NodeText","Data":" 库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用前必须先调用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"WSAStartup"},{"Type":"NodeText","Data":" 初始化套接字环境"}]},{"ID":"20260505170804-13gyyhb","Type":"NodeParagraph","Properties":{"id":"20260505170804-13gyyhb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 下需要包含 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"sys/socket.h"},{"Type":"NodeText","Data":",直接用就行，不需要额外初始化"}]},{"ID":"20260505170804-f6d0z3d","Type":"NodeParagraph","Properties":{"id":"20260505170804-f6d0z3d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这两个函数专门用于 TCP 网络数据发送和接收，是服务端、客户端网络通信最核心的函数"}]},{"ID":"20260505170804-tv92qgq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-tv92qgq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"七层网络模型\t\u003e\u003e"}]},{"ID":"20260505170804-zg7vh9x","Type":"NodeParagraph","Properties":{"id":"20260505170804-zg7vh9x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"应用层：给软件提供统一的上网接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"表示层：把数据转成双方都能看懂的格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会话层：负责建立、维护和断开两边的通话连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传输层：负责两台机器之间可靠的数据传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络层：负责给数据包指路、路由和转发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据链路层：把数据打包成帧，做差错校验，用 MAC 地址找设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"物理层：负责在网线、光纤等物理介质上传信号"}]},{"ID":"20260505170804-o6257ft","Type":"NodeParagraph","Properties":{"id":"20260505170804-o6257ft","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260404113006630"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260404113006630.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4hnhqdd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4hnhqdd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP/IP 协议"}]},{"ID":"20260505170804-x1fvpj8","Type":"NodeParagraph","Properties":{"id":"20260505170804-x1fvpj8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP/IP 是互联网整套通信协议簇，采用四层架构，是网络通信的基础"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用层、传输层、网络层、网络接口层"}]},{"ID":"20260505170804-49f8ynk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-49f8ynk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 连接建立后，客户端与服务端之间传输的是 TCP 报文还是 HTTP 报文？二者的封装关系是什么？\t\u003e\u003e"}]},{"ID":"20260505170804-li1z7l8","Type":"NodeParagraph","Properties":{"id":"20260505170804-li1z7l8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 连接建立后，应用层之间传输的是 HTTP 报文，而网络上实际传输的是封装了 HTTP 数据的 TCP 报文段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP 作为应用层报文会被作为数据部分，加上 TCP 头部后封装成 TCP 报文段，再继续封装 IP 头、MAC 头进行网络传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单说就是 HTTP 被包裹在 TCP 内部传输"}]},{"ID":"20260505170804-xchcq32","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xchcq32","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 解析的过程？\t\u003e\u003e"}]},{"ID":"20260505170804-khu5eah","Type":"NodeParagraph","Properties":{"id":"20260505170804-khu5eah","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DNS 端口是 53 端口"}]},{"ID":"20260505170804-annysne","Type":"NodeParagraph","Properties":{"id":"20260505170804-annysne","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260317122655128"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260317122655128.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-7q9i7o0","Type":"NodeParagraph","Properties":{"id":"20260505170804-7q9i7o0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"（递归查询）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先查客户端缓存，浏览器自己有没有存过对应的 IP，有就直接用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果没有，就去查操作系统缓存，再没有就去看本地的 hosts 文件，这个文件是手动绑定域名和 IP 的，优先级比 DNS 还高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要是这些都找不到，就会去找本地 DNS 服务器，一般是运营商或者公司的 DNS，它会先看自己缓存里有没有"}]},{"ID":"20260505170804-25udvvj","Type":"NodeParagraph","Properties":{"id":"20260505170804-25udvvj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"(迭代查询)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还没有的话，本地 DNS 就去问根 DNS 服务器，根服务器会告诉你该去问哪个顶级域名服务器，比如 .com 这种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后再去问顶级域名服务器，它会告诉你去哪个权威 DNS 服务器查。最后权威 DNS 把真实的 IP 地址返回给本地 DNS，本地 DNS 再把 IP 缓存下来，还给浏览器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器拿到 IP 之后，就可以跟服务器建立连接，发请求，拿到网页内容了"}]},{"ID":"20260505170804-gnshag9","Type":"NodeParagraph","Properties":{"id":"20260505170804-gnshag9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"根域 → 顶级域（.com/.cn） → 二级域（baidu/zhihu） → 子域（www/blog）"}]},{"ID":"20260505170804-y1867s1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-y1867s1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 怎么依次找到各个服务器的\t\u003e\u003e"}]},{"ID":"20260505170804-tivv2jl","Type":"NodeParagraph","Properties":{"id":"20260505170804-tivv2jl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"靠本地 DNS 服务器帮一层层去问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先，本地 DNS 服务器里面，内置了全球 13 个根服务器的地址，这是系统自带的，所以它一上来就知道根服务器在哪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它先去问根服务器：“我想查某个域名”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"根服务器说：“我不知道具体 IP，你去问对应的顶级域服务器(例如.com 顶级域服务器)”，并把顶级域服务器的地址告诉它"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后本地 DNS 再去问顶级域服务器，比如 .com 对应的服务器，顶级域服务器再把该域名的权威 DNS 服务器地址返回给它"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后本地 DNS 去问权威 DNS 服务器，这台服务器里存着域名真正的 IP，直接把结果返回"}]},{"ID":"20260505170804-lx4grqm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lx4grqm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"根服务器的分布\t\u003e\u003e"}]},{"ID":"20260505170804-23dzbc6","Type":"NodeParagraph","Properties":{"id":"20260505170804-23dzbc6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"根服务器从逻辑上看全球就 13 组，其中 10 组主节点在美国，另外 3 组在英国、瑞典、日本。但它不是只存在这几个地方，而是通过 任播技术，在全世界包括中国都部署了大量镜像节点，我们实际访问的都是离自己最近的那个节点"}]},{"ID":"20260505170804-chh5dbi","Type":"NodeParagraph","Properties":{"id":"20260505170804-chh5dbi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"任播就是多个物理服务器共用同一个 IP 地址，网络会自动把你路由到最近、最快的那一台"}]},{"ID":"20260505170804-uffvhd7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uffvhd7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 用哪个协议进行查询\t\u003e\u003e"}]},{"ID":"20260505170804-qs7n9mk","Type":"NodeParagraph","Properties":{"id":"20260505170804-qs7n9mk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DNS 查询优先用 UDP，端口 53"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有查询内容特别大、或者需要可靠传输的时候，才会切到 TCP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正常域名解析都是小包，UDP 速度快、开销小，足够用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有像区域传输、或者 DNS 响应超过 UDP 报文长度限制时，才用 TCP 保证可靠"}]},{"ID":"20260505170804-fobpnxk","Type":"NodeParagraph","Properties":{"id":"20260505170804-fobpnxk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"尽管 UDP 存在丢包和数据包损坏的风险，但在 DNS 的设计中，这些风险是可以被容忍的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DNS 使用了一些机制来提高可靠性，例如查询超时重传、请求重试、缓存等，以确保数据传输的可靠性和正确性"}]},{"ID":"20260505170804-lkmtc9w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lkmtc9w","updated":"20260508232343"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 的两种查询方式\t\t\u003e\u003e"}]},{"ID":"20260505170804-eapcfwz","Type":"NodeParagraph","Properties":{"id":"20260505170804-eapcfwz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"递归查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端向 DNS 服务器发起请求后，该 DNS 服务器会全程负责查询过程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主动向根、顶级、权威等各级 DNS 服务器逐层查询，直至获取域名对应的 IP 地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若查询失败，也会直接向客户端返回失败结果，全程无需客户端再与其他 DNS 服务器交互"}]},{"ID":"20260505170804-2q9jdko","Type":"NodeParagraph","Properties":{"id":"20260505170804-2q9jdko","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"迭代查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本地 DNS 服务器接收到客户端请求后，不会直接返回最终结果，而是逐层指引查询方向"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先告知客户端根域名服务器地址，客户端向根服务器查询后，根服务器再指引至顶级域名服务器，顶级域名服务器继续指引至权威域名服务器，最终由客户端从权威域名服务器获取 IP 地址，查询过程由客户端主动向各级服务器依次发起"}]},{"ID":"20260508232343-23xwqbg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508232343-23xwqbg","updated":"20260508145600"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 劫持"}]},{"ID":"20260508232343-ar3ddxt","Type":"NodeParagraph","Properties":{"id":"20260508232343-ar3ddxt","updated":"20260508231216"},"Children":[{"Type":"NodeText","Data":"DNS 劫持简单说，就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"篡改域名解析"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输正规网址，本该跳官方服务器，被坏人改了 DNS 解析结果，直接给你导到假网站"}]},{"ID":"20260508232343-tytsfsh","Type":"NodeParagraph","Properties":{"id":"20260508232343-tytsfsh","updated":"20260508231225"},"Children":[{"Type":"NodeText","Data":"它利用传统 DNS 明文不加密、没校验的漏洞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间人很容易拦截请求、伪造返回 IP"}]},{"ID":"20260508232343-u8mx020","Type":"NodeParagraph","Properties":{"id":"20260508232343-u8mx020","updated":"20260508231245"},"Children":[{"Type":"NodeText","Data":"常见就是改电脑本地配置、蹭公共 WiFi 被中间人劫持、路由器被攻破改 DNS 这几种情况"}]},{"ID":"20260508232343-99w7p9x","Type":"NodeParagraph","Properties":{"id":"20260508232343-99w7p9x","updated":"20260508231306"},"Children":[{"Type":"NodeText","Data":"危害主要是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"钓鱼盗号、弹恶意广告、植入病毒"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防护就换靠谱公共 DNS、开加密 DNS、不乱连陌生 WiFi、正常网站认准 HTTPS 安全锁"}]},{"ID":"20260508232343-13hxdi3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508232343-13hxdi3","updated":"20260508145608"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么防范 DNS 劫持"}]},{"ID":"20260508232343-3dyc61g","Type":"NodeParagraph","Properties":{"id":"20260508232343-3dyc61g","updated":"20260508232124"},"Children":[{"Type":"NodeText","Data":"防范 DNS 劫持主要从终端、网络、服务端、协议加固四方面入手："}]},{"ID":"20260508232343-af2la0a","Type":"NodeParagraph","Properties":{"id":"20260508232343-af2la0a","updated":"20260508232326"},"Children":[{"Type":"NodeText","Data":"手机电脑别用运营商自动 DNS，换成阿里、腾讯这种靠谱公共 DNS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开加密 DNS，不让解析数据裸奔被人篡改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"改路由器默认密码，别让别人偷偷改你路由器 DNS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不乱下软件、不乱点链接，防止恶意程序篡改本地 Hosts"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正规网站开启 DNSSEC，给 DNS 解析加一层真伪校验"}]},{"ID":"20260505170804-dz3km5g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dz3km5g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 请求报文和响应报文的核心组成部分有哪些？\u003e\u003e"}]},{"ID":"20260505170804-da78mbn","Type":"NodeParagraph","Properties":{"id":"20260505170804-da78mbn","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP 请求报文核心组成"}]},{"ID":"20260505170804-v9xandq","Type":"NodeParagraph","Properties":{"id":"20260505170804-v9xandq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 请求报文主要由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"请求行、请求头、空行、请求体"},{"Type":"NodeText","Data":"四部分构成"}]},{"ID":"20260505170804-t7z71k7","Type":"NodeParagraph","Properties":{"id":"20260505170804-t7z71k7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"请求行包含请求方法、请求 URL、HTTP 协议版本，用于告诉服务器本次请求的类型与目标"}]},{"ID":"20260505170804-v1lnld1","Type":"NodeParagraph","Properties":{"id":"20260505170804-v1lnld1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"请求头是一系列键值对，用于传递客户端信息、缓存控制、身份标识等，比如 Host、User-Agent、Cookie、Content-Type 等"}]},{"ID":"20260505170804-hkywup5","Type":"NodeParagraph","Properties":{"id":"20260505170804-hkywup5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"空行是必须存在的分隔符，用于区分请求头和请求体"}]},{"ID":"20260505170804-jefgpna","Type":"NodeParagraph","Properties":{"id":"20260505170804-jefgpna","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"请求体存放 POST、PUT 等方法提交的数据，如表单数据、JSON 参数，GET 请求一般没有请求体"}]},{"ID":"20260505170804-pgl2zq8","Type":"NodeParagraph","Properties":{"id":"20260505170804-pgl2zq8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP 响应报文核心组成"}]},{"ID":"20260505170804-5pg86l5","Type":"NodeParagraph","Properties":{"id":"20260505170804-5pg86l5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 响应报文同样由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"状态行、响应头、空行、响应体"},{"Type":"NodeText","Data":"四部分组成"}]},{"ID":"20260505170804-7sg2dzf","Type":"NodeParagraph","Properties":{"id":"20260505170804-7sg2dzf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"状态行包含 HTTP 版本、响应状态码、状态描述，比如 200 表示成功、304 表示未修改、404 表示资源不存在"}]},{"ID":"20260505170804-0yyinvb","Type":"NodeParagraph","Properties":{"id":"20260505170804-0yyinvb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"响应头也是键值对，用于返回服务器信息、资源类型、缓存策略、Cookie 设置等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常见的有 Server、Content-Type、Cache-Control、ETag 等"}]},{"ID":"20260505170804-69lb2z6","Type":"NodeParagraph","Properties":{"id":"20260505170804-69lb2z6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"空行同样用于分隔响应头和响应体"}]},{"ID":"20260505170804-c0a3cyy","Type":"NodeParagraph","Properties":{"id":"20260505170804-c0a3cyy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"响应体则是服务器返回的实际数据，比如 HTML 页面、JSON 数据、图片资源等，是浏览器最终渲染或前端使用的核心内容"}]},{"ID":"20260505170804-k9faksm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k9faksm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"http 请求常用的 header？哪些你最常用？"}]},{"ID":"20260505170804-wh89ioy","Type":"NodeParagraph","Properties":{"id":"20260505170804-wh89ioy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Host"},{"Type":"NodeText","Data":"：指定请求的目标域名和端口，服务器靠它区分虚拟主机"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IP 找服务器，Host 找服务器上具体哪个网站"}]},{"ID":"20260505170804-d1h5hxc","Type":"NodeParagraph","Properties":{"id":"20260505170804-d1h5hxc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"User-Agent"},{"Type":"NodeText","Data":"：标识客户端身份，是什么浏览器、系统、设备"}]},{"ID":"20260505170804-1bsz4vp","Type":"NodeParagraph","Properties":{"id":"20260505170804-1bsz4vp","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Content-Type"},{"Type":"NodeText","Data":"：告诉服务器请求体的数据格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 application/json、form 表单、multipart 文件上传"}]},{"ID":"20260505170804-bj6obtk","Type":"NodeParagraph","Properties":{"id":"20260505170804-bj6obtk","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Accept"},{"Type":"NodeText","Data":"：客户端能接收哪些响应数据格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Accept-Encoding"},{"Type":"NodeText","Data":"：支持的压缩方式，gzip、deflate，用来传输压缩提速"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Accept-Language"},{"Type":"NodeText","Data":"：客户端偏好的语言"}]},{"ID":"20260505170804-r9f7w9h","Type":"NodeParagraph","Properties":{"id":"20260505170804-r9f7w9h","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Cookie"},{"Type":"NodeText","Data":"：携带用户会话标识、登录凭证、自定义缓存信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Referer"},{"Type":"NodeText","Data":"：当前请求是从哪个页面跳转过来的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Authorization"},{"Type":"NodeText","Data":"：身份认证，放 Token、Basic 认证信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Content-Length"},{"Type":"NodeText","Data":"：请求体字节长度"}]},{"ID":"20260505170804-xdkxji5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xdkxji5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"URL 的组成部分\t\t\u003e\u003e"}]},{"ID":"20260505170804-xcchwwy","Type":"NodeParagraph","Properties":{"id":"20260505170804-xcchwwy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"URL 主要由协议、域名、端口、路径、查询参数、锚点六部分组成"}]},{"ID":"20260505170804-khhm9ks","Type":"NodeParagraph","Properties":{"id":"20260505170804-khhm9ks","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"协议规定访问方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"域名定位服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"端口是服务入口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路径定位资源文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查询参数携带数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"锚点用于页面内跳转"}]},{"ID":"20260505170804-80xsin7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"aHR0cA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-80xsin7","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aHR0cA=="},{"Type":"NodeCodeBlockCode","Data":"https://www.baidu.com:8080/index.html?id=1#top\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-6fan9ez","Type":"NodeParagraph","Properties":{"id":"20260505170804-6fan9ez","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"https：传输协议，告诉浏览器用加密安全的方式访问网站"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"www.baidu.com：域名，找到对应的服务器地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"8080：端口号，服务器上对应的服务入口（http 默认 80 可以省略）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"/index.html：资源路径，服务器里具体哪个文件 / 页面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"?id=1：查询参数，传给后端的数据，用来筛选、查询内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"top：锚点，页面内部跳转，回到页面顶部"}]},{"ID":"20260505170804-ulh7ljm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ulh7ljm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网络层逐层封包，HTTPS 他是封装在 SSL 上面还是 SSL 封装在 HTTP 上？\t\t\u003e\u003e"}]},{"ID":"20260505170804-mqg5gmv","Type":"NodeParagraph","Properties":{"id":"20260505170804-mqg5gmv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTPS 本质是 HTTP 加上 SSL/TLS 加密层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在协议封装上是 SSL/TLS 封装 HTTP，数据先由 HTTP 生成明文报文，再交给 SSL/TLS 进行加密、握手等处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后再封装到 TCP 报文段中，经过网络层、链路层逐层封包传输，从而实现安全的 HTTP 通信"}]},{"ID":"20260505170804-qojmqvd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qojmqvd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对称加密和非对称加密的区别？（性能方面，安全性方面等）\t\u003e\u003e"}]},{"ID":"20260505170804-32a099p","Type":"NodeParagraph","Properties":{"id":"20260505170804-32a099p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对称加密只用同一把密钥加解密，计算极快、性能高，适合大量数据加密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但密钥传输易泄露，安全性依赖密钥保管"}]},{"ID":"20260505170804-zuekx23","Type":"NodeParagraph","Properties":{"id":"20260505170804-zuekx23","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"非对称加密用公钥、私钥配对，公钥公开、私钥保密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无需传递私钥，安全性更高，但加密速度慢、计算开销大，只适合小数据如密钥交换"}]},{"ID":"20260505170804-4rm5od2","Type":"NodeParagraph","Properties":{"id":"20260505170804-4rm5od2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实际 HTTPS 等场景会结合使用："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非对称加密安全传输对称密钥，再用对称加密高效传输业务数据"}]},{"ID":"20260505170804-w16131q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w16131q","updated":"20260521125710"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTPS 和 HTTP 个版本对比"}]},{"ID":"20260505170804-g7x4g8d","Type":"NodeParagraph","Properties":{"id":"20260505170804-g7x4g8d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP/1.0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它用的是 TCP，每次请求都要重新建立连接，用完就断，性能特别差，现在基本不用了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"然后是 HTTP/1.1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最常用的版本，支持长连接，一个 TCP 连接可以发多个请求，还支持缓存、断点续传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它的问题很明显，队头阻塞，一个请求卡住，后面全都堵着，而且请求头是明文、冗余也大"}]},{"ID":"20260521125520-94bq2gq","Type":"NodeParagraph","Properties":{"id":"20260521125520-94bq2gq","updated":"20260521125521"},"Children":[{"Type":"NodeText","Data":"HTTP1.1 断点续传就是客户端记下已下载字节位置，请求时带上 Range 头指定起始位置，服务器确认支持后返回 206 状态码，只传回剩余文件片段，本地拼接就能接着下载，不用从头重来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接下来是 HTTP/2.0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 TCP 之上做了优化，用二进制分帧和多路复用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个连接能同时并行很多请求，解决了应用层的队头阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还加了头部压缩和服务端推送，速度比 1.1 快很多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它还是基于 TCP，所以 TCP 层的队头阻塞依然存在"}]},{"ID":"20260505170804-k3u3khi","Type":"NodeParagraph","Properties":{"id":"20260505170804-k3u3khi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP/2.0 的服务端推送，是服务器预判客户端请求资源后可能需要的关联资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在客户端未请求时主动推送，减少请求次数、提升资源加载效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最后是 HTTP/3.0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接换掉了 TCP，用 UDP 上的 QUIC 协议,彻底解决了队头阻塞，握手更快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持连接迁移，手机切换网络也不中断，延迟最低、抗丢包最强，而且默认就带加密,唯一缺点就是目前兼容性还在普及中"}]},{"ID":"20260505170804-l1264d9","Type":"NodeParagraph","Properties":{"id":"20260505170804-l1264d9","updated":"20260521125710"},"Children":[{"Type":"NodeText","Data":"QUIC 实现连接迁移，核心是用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Connection ID 唯一标识连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不再依赖 TCP 的四元组（IP + 端口）来区分会话"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当客户端切换网络导致 IP / 端口变化时，只需在新路径发送探测包验证连通性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器通过 CID 识别出是原连接，直接更新传输路径，应用层连接不中断、无需重新握手"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从而实现无缝切换"}]},{"ID":"20260505170804-kh4tftx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kh4tftx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"http3 什么时候出来的，现代一般用 http 几?"}]},{"ID":"20260505170804-iiv4rqq","Type":"NodeParagraph","Properties":{"id":"20260505170804-iiv4rqq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP/3：2022 年正式发布"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"现在主流是 HTTP/1.1 + HTTP/2，HTTP/3 正在快速推广"}]},{"ID":"20260505170804-i607krm","Type":"NodeParagraph","Properties":{"id":"20260505170804-i607krm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTPS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不是独立版本，而是在 HTTP 外面套了一层 TLS 加密，保证传输不被窃听、不被篡改、身份可信。不管是 1.1、2.0 还是 3.0 都可以用 HTTPS，只是多了一点握手开销，但线上环境基本全是 HTTPS。"}]},{"ID":"20260505170804-b4yo7ju","Type":"NodeParagraph","Properties":{"id":"20260505170804-b4yo7ju","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 的版本升级核心围绕 “提升性能、降低延迟”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从 1.0 的短连接到 1.1 的长连接，再到 2.0 的 TCP 多路复用，最终 3.0 基于 QUIC 彻底解决队头阻塞；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 HTTPS 则是在所有 HTTP 版本基础上，新增安全层，实现数据的加密传输，是生产环境的标配"}]},{"ID":"20260505170804-keqmfcn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-keqmfcn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 CA 机构"}]},{"ID":"20260505170804-qii07sl","Type":"NodeParagraph","Properties":{"id":"20260505170804-qii07sl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CA 就是数字证书认证机构，是互联网里权威的第三方可信机构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心作用是身份认证和办法数字证书"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给网站、企业、个人做身份背书，证明你就是你，防止冒充伪造"}]},{"ID":"20260505170804-t2cdkme","Type":"NodeParagraph","Properties":{"id":"20260505170804-t2cdkme","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时 CA 会用非对称加密给证书签名，保证数据传输不被篡改，不被窃听"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像我们平时访问 HTTPS 网站，浏览器校验证书，背后就是 CA 机构在做信任担保"}]},{"ID":"20260505170804-vm3h3sr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vm3h3sr","updated":"20260517201132"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"CA 不能被造假吗"}]},{"ID":"20260505170804-k8rlmlq","Type":"NodeParagraph","Properties":{"id":"20260505170804-k8rlmlq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"理论上可以伪造证书，但正规 CA 体系下几乎造不了假，有多层防护"}]},{"ID":"20260505170804-kpkq33q","Type":"NodeParagraph","Properties":{"id":"20260505170804-kpkq33q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一，根证书内置在操作系统和浏览器里，是权威预装的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通人拿不到根 CA 的私钥，没法伪造合法签名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有根 CA 私钥，签出来的假证书，浏览器一校验签名就直接失败，立马报不安全。"}]},{"ID":"20260505170804-mrv3t4t","Type":"NodeParagraph","Properties":{"id":"20260505170804-mrv3t4t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二，正规 CA 签发前要严格审核域名和企业资质，不是谁想申请就能随便拿别人域名的证书。就算自己做一个假证书，只能自己本地用，全网浏览器都不认。"}]},{"ID":"20260505170804-ajqew3z","Type":"NodeParagraph","Properties":{"id":"20260505170804-ajqew3z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三，就算有中间 CA 被攻破，还有证书吊销、跨级签名校验、浏览器安全策略兜底，一旦发现非法证书直接拉黑拦截。"}]},{"ID":"20260505170804-33pmcl8","Type":"NodeParagraph","Properties":{"id":"20260505170804-33pmcl8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"补充一句：自己本地搭服务可以自建 CA、自签名证书，但只能自己手动信任，外网浏览器一律不认可，算不上真正造假。"}]},{"ID":"20260505170804-jgu635h","Type":"NodeParagraph","Properties":{"id":"20260505170804-jgu635h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"真正难攻破的核心是：根私钥不泄露 + 浏览器内置根证书校验机制"}]},{"ID":"20260517201132-q3gfkbw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517201132-q3gfkbw","updated":"20260517201200"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么知道不是冒充的，CA 校验"}]},{"ID":"20260517201132-1iwi08u","Type":"NodeParagraph","Properties":{"id":"20260517201132-1iwi08u","updated":"20260517201200"},"Children":[{"Type":"NodeText","Data":"客户端通过 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"证书链校验"},{"Type":"NodeText","Data":" 来确认服务端身份"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"具体会检查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，证书是否由受信任的 CA 签发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二，证书是否在有效期内"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三，域名是否匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四，证书签名是否正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第五，是否被吊销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有这些都通过，客户端才认为服务端可信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以不是“服务端自己说自己是谁”，而是 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第三方 CA 背书 + 客户端校验"}]},{"ID":"20260505170804-a94p969","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a94p969","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关联性操作用 http1.0 好吗\t\t\u003e\u003e"}]},{"ID":"20260505170804-crnech2","Type":"NodeParagraph","Properties":{"id":"20260505170804-crnech2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关联性操作不适合使用 HTTP 1.0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为关联性操作通常是多个存在上下文依赖、需要顺序执行或保持会话状态的连续请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 HTTP 1.0 默认采用短连接，每次请求完成后就会断开 TCP 连接，无法复用连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会带来大量重复的握手开销，同时也难以稳定维持请求之间的上下文与顺序，导致性能差、可靠性低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 HTTP 1.1 及以上支持持久连接、管道化等特性，更适合处理这类关联性操作"}]},{"ID":"20260505170804-3tyxxlf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3tyxxlf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP KeepAlive\t\t\u003e\u003e"}]},{"ID":"20260505170804-j36f4a7","Type":"NodeParagraph","Properties":{"id":"20260505170804-j36f4a7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP Keep-Alive 实现长连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心是在同一个 TCP 连接上复用多个 HTTP 请求与响应，避免每次请求都重新建立和关闭 TCP 连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端和服务端通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Connection: keep-alive"},{"Type":"NodeText","Data":" 头部协商开启长连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP/1.1 中默认启用，不需要额外配置"}]},{"ID":"20260505170804-ljspz2u","Type":"NodeParagraph","Properties":{"id":"20260505170804-ljspz2u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"长连接能正常工作必须准确标识每个 HTTP 响应的结束边界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端必须通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content-Length"},{"Type":"NodeText","Data":" 指明响应体长度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Transfer-Encoding: chunked"},{"Type":"NodeText","Data":" 分块传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让客户端能精准识别一次响应的结束位置，而不用依赖关闭 TCP 连接来判断"}]},{"ID":"20260505170804-t9a3nig","Type":"NodeParagraph","Properties":{"id":"20260505170804-t9a3nig","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在确定边界后，TCP 连接会在请求结束后继续保持打开状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端可以直接在该连接上发送下一个请求，直到达到服务端设置的最大请求数或空闲超时时间，才会正常关闭连接"}]},{"ID":"20260505170804-ewsnw09","Type":"NodeParagraph","Properties":{"id":"20260505170804-ewsnw09","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP Keep-Alive 是应用层短超时（几十秒），控制连接复用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP Keepalive 是传输层兜底（2 小时），检测死连接释放资源"}]},{"ID":"20260505170804-hzdvtor","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hzdvtor","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 队头阻塞\t\u003e\u003e"}]},{"ID":"20260505170804-t4pbkfj","Type":"NodeParagraph","Properties":{"id":"20260505170804-t4pbkfj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 收到了后面的数据包，但因为前面一个包丢了，TCP 遵守 “必须按顺序交付”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以把后面已经到的数据全部缓存住，不给你应用层"}]},{"ID":"20260505170804-oo1ch0e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-oo1ch0e","updated":"20260521125735"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么 HTTP/2.0 还是没彻底解决队头阻塞"}]},{"ID":"20260505170804-diw3h3y","Type":"NodeParagraph","Properties":{"id":"20260505170804-diw3h3y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 HTTP/1.1 里，虽然是长连接，但请求是排队走的，一个请求堵在那，后面所有请求都得等着，这就是队头阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP/2.0,它把一个 TCP 连接当成一条高速公路，然后把每个请求拆成很小的二进制帧，这些帧是乱序传输的。同一个连接里，可以同时传输多个请求的帧，到了对端再按编号重新组装起来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP/2 用多路复用解决了应用层的队头阻塞，但因为底层还是 TCP，只要 TCP 丢包，整个连接都会阻塞等待重传，所以没有彻底解决。直到 HTTP/3 换成 QUIC 协议，才真正把这个问题干掉"}]},{"ID":"20260505170804-xsg15o6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xsg15o6","updated":"20260521125737"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP/2 解决队头阻塞"}]},{"ID":"20260505170804-hdfpruw","Type":"NodeParagraph","Properties":{"id":"20260505170804-hdfpruw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"二进制分帧 + 流 ID + 接收端缓冲区重新排序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送端把多个请求拆成带流 ID 的二进制帧，在同一个 TCP 连接里乱序、交错发送"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收端收到这些乱序帧后，不会直接处理，而是先放到对应流的接收缓冲区里，根据帧里的序号，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在缓冲区中排序、组装，等一整包消息完整了，再向上交给应用层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为每个请求有独立的流 ID 和独立缓冲区，所以一个请求丢包、慢了，只会阻塞自己这一个流，不会阻塞其他流"}]},{"ID":"20260505170804-g8leme1","Type":"NodeParagraph","Properties":{"id":"20260505170804-g8leme1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP/2 的二进制分帧是在应用层内部实现的，HTTP 语义下，用来把消息拆成二进制帧，不依赖传输层"}]},{"ID":"20260505170804-q8srdwf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-q8srdwf","updated":"20260521125742"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP/2.0 的多路复用中，如何区分不同的流？组装数据的原理是什么？"}]},{"ID":"20260505170804-p8txv6c","Type":"NodeParagraph","Properties":{"id":"20260505170804-p8txv6c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"靠每个二进制帧头部的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"流 ID"},{"Type":"NodeText","Data":" 来区分不同请求的，每个请求对应一个唯一的流 ID，发送的时候把不同请求的帧混在一起传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收端拿到帧后，先根据流 ID 把数据分到对应流的缓冲区里，再按帧的序列号"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"排序、拼接"},{"Type":"NodeText","Data":"，把属于同一个请求的数据重新组装起来，这样就能在一个连接里同时传输多个请求，还不会乱"}]},{"ID":"20260505170804-uyidxlc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uyidxlc","updated":"20260521125743"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP2.0 头部压缩"}]},{"ID":"20260505170804-3jvuips","Type":"NodeParagraph","Properties":{"id":"20260505170804-3jvuips","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP/2 采用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HPACK 算法"},{"Type":"NodeText","Data":"对头部进行压缩"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端和服务端会共同维护一张静态表和动态表，对于常见头部字段直接用索引编号代替完整字符串，避免重复传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对无法索引的头部值再使用哈夫曼编码进一步压缩，从而大幅减小头部体积、提升传输效率"}]},{"ID":"20260511143300-gjsenwh","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511143300-gjsenwh","updated":"20260511143300"},"Children":[{"ID":"20260511143300-ag1st2a","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511143300-ag1st2a","updated":"20260511143300"},"Children":[{"ID":"20260511143300-eqd1t3r","Type":"NodeParagraph","Properties":{"id":"20260511143300-eqd1t3r","updated":"20260511143300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态字典"},{"Type":"NodeText","Data":"内置常用头部键值对（比如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":":method:GET"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"content-type"},{"Type":"NodeText","Data":"​），直接用索引代替长文本，不用每次完整传输。"}]}]},{"ID":"20260511143300-tr7cuof","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511143300-tr7cuof","updated":"20260511143300"},"Children":[{"ID":"20260511143300-b6sgwfv","Type":"NodeParagraph","Properties":{"id":"20260511143300-b6sgwfv","updated":"20260511143300"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动态字典"},{"Type":"NodeText","Data":"客户端和服务端各自维护一张表，把本次请求里出现过的新头部缓存下来，下次直接复用索引。还会用霍夫曼编码对剩余数据进一步压缩"}]}]}]},{"ID":"20260505170804-mm50deb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mm50deb","updated":"20260518152021"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTPS 的工作原理\t\t\u003e\u003e"}]},{"ID":"20260505170804-wcnezpz","Type":"NodeParagraph","Properties":{"id":"20260505170804-wcnezpz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"SSL/TLS 是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保障 HTTPS 安全的协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SSL 是老版本，TLS 是升级后的，更安全，现在基本都用 TLS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心就是帮我们做到：加密传输、确认对方身份、保证数据不被篡改。"}]},{"ID":"20260505170804-g4g6t4q","Type":"NodeParagraph","Properties":{"id":"20260505170804-g4g6t4q","updated":"20260518152021"},"Children":[{"Type":"NodeText","Data":"第一步，客户端先给服务器发消息，相当于 “打招呼”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"告诉服务器我支持哪些 TLS 版本、哪些加密方式，再发一个随机数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二步，服务器回应，选好合适的版本和加密方式，也发一个随机数，同时把自己的证书发过去，证书里有服务器的公钥，还有权威机构的签名，证明自己是正规的"}]},{"ID":"20260505170804-j8hdavo","Type":"NodeParagraph","Properties":{"id":"20260505170804-j8hdavo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"(第三步，如果需要的话，服务器再发额外的密钥交换信息，然后告诉客户端 “我这边打招呼结束了”)"}]},{"ID":"20260505170804-h1imbsy","Type":"NodeParagraph","Properties":{"id":"20260505170804-h1imbsy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第四步，客户端就生成一个 “预主密钥”，用服务器证书里的公钥加密，发给服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器用自己的私钥解密，拿到这个预主密钥"}]},{"ID":"20260505170804-p4sqjuo","Type":"NodeParagraph","Properties":{"id":"20260505170804-p4sqjuo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第五步，客户端和服务器，都用之前各自发的随机数，加上这个预主密钥，生成一样的会话密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个会话密钥，就是后面双方传数据时，用来加密和解密的关键"}]},{"ID":"20260505170804-kegut5t","Type":"NodeParagraph","Properties":{"id":"20260505170804-kegut5t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第六步，客户端先发一个 “完成” 消息，证明自己握手没问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器收到后，也发一个 “完成” 消息，确认自己这边也没问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后，双方就用之前生成的会话密钥，加密传输所有数据，这样数据就不会被窃听、篡改了"}]},{"ID":"20260505170804-x58xf0b","Type":"NodeParagraph","Properties":{"id":"20260505170804-x58xf0b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 是非对称 + 对称配合使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非对称加密：只用在握手阶段，负责安全交换密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对称加密：用在真正传输数据，负责高效加密通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为通信双方初始无共享密钥，必须依靠非对称加密的公私钥机制，实现密文安全传递对称密钥，同时完成服务器身份认证，防止密钥被中间人窃取和伪造"}]},{"ID":"20260505170804-pfw46gu","Type":"NodeParagraph","Properties":{"id":"20260505170804-pfw46gu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 不属于标准 OSI 七层中的任何一层，它是介于应用层和传输层之间的安全层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP 跑在应用层，TCP 在传输层，TLS 夹在中间，对上层 HTTP 数据进行加密，再交给下层 TCP 传输"}]},{"ID":"20260505170804-jz4lz9j","Type":"NodeParagraph","Properties":{"id":"20260505170804-jz4lz9j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 TLS 握手第二步中，服务器发送的证书本质是一张由权威 CA 机构颁发的 “身份证明”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"里面包含了服务器的公钥、域名、有效期等信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而签名是 CA 用自己的私钥对证书内容做的加密摘要，作用是防篡改、防伪造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端拿到证书后，会用系统内置的 CA 公钥验证签名是否合法 |"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以此确认证书没被篡改、服务器身份真实可信，之后才能安全使用证书里的公钥进行后续密钥交换，避免中间人伪造服务器窃取信息"}]},{"ID":"20260510203842-ngp257r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510203842-ngp257r","updated":"20260510203904"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTPS 里 ECDHE‑RSA 完整流程"}]},{"ID":"20260510203845-fobpriz","Type":"NodeParagraph","Properties":{"id":"20260510203845-fobpriz","updated":"20260510203856"},"Children":[{"Type":"NodeText","Data":"RSA 负责：证明服务器身份（签名验签）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ECDHE 负责：协商出对称加密密钥（安全传密钥）"}]},{"ID":"20260510203859-5gtoi2o","Type":"NodeParagraph","Properties":{"id":"20260510203859-5gtoi2o","updated":"20260510203900"},"Children":[{"Type":"NodeText","Data":"完整握手步骤（TLS1.2）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端发起连接，告诉服务端：我支持 ECDHE 密钥交换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器拿出 RSA 证书（公钥），生成临时 ECDHE 公私钥对"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器用自己的 RSA 私钥 对 ECDHE 公钥做签名，发给客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端用服务器 RSA 公钥验签"}]},{"ID":"20260510203903-xiurhua","Type":"NodeParagraph","Properties":{"id":"20260510203903-xiurhua","updated":"20260510203904"},"Children":[{"Type":"NodeText","Data":"验签通过 → 确认对方是真服务器，身份可信（RSA 完成身份认证）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端也生成自己的临时 ECDHE 公钥，发给服务端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双方用各自 ECDHE 公私钥，算出同一个会话密钥（AES 密钥）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后通信全部用 AES 对称加密传输"}]},{"ID":"20260505170804-edmbf21","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-edmbf21","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTPS 如何防止中间人篡改、替换攻击\t\u003e\u003e"}]},{"ID":"20260505170804-04rfinx","Type":"NodeParagraph","Properties":{"id":"20260505170804-04rfinx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTPS 依靠 TLS 协议对 HTTP 进行加密与安全增强核心通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"身份认证、数据加密、完整性校验"},{"Type":"NodeText","Data":"三道防线"}]},{"ID":"20260505170804-2yqqzi6","Type":"NodeParagraph","Properties":{"id":"20260505170804-2yqqzi6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端与服务端建立连接时，服务端会下发由权威 CA 机构签发的数字证书，客户端使用系统内置的根证书公钥验证证书合法性，确认服务器真实身份，避免中间人伪造服务器进行欺骗"}]},{"ID":"20260505170804-1qu10hg","Type":"NodeParagraph","Properties":{"id":"20260505170804-1qu10hg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在身份验证通过后，双方协商出唯一的会话密钥，后续所有通信数据都使用该对称密钥加密传输"}]},{"ID":"20260505170804-6pzkm1t","Type":"NodeParagraph","Properties":{"id":"20260505170804-6pzkm1t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中间人即使截获数据包，没有密钥也无法解密内容，更无法对数据进行修改后重新加密发送，从根本上杜绝了数据被替换或篡改的可能。"}]},{"ID":"20260505170804-6fzdswi","Type":"NodeParagraph","Properties":{"id":"20260505170804-6fzdswi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时，TLS 会对每条消息计算哈希摘要并生成消息认证码，接收方收到数据后会重新校验摘要"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦数据在传输中被篡改，摘要比对就会失败，连接会直接异常中断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再加上序列号、防重放等机制，中间人无法随意修改、重放或乱序数据包，从而完整保证了传输过程的真实性与完整性"}]},{"ID":"20260505170804-56l1rm2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-56l1rm2","updated":"20260510203507"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"RSA/DH / DHE / ECDHE\t\t\u003e\u003e"}]},{"ID":"20260505170804-aeruco0","Type":"NodeParagraph","Properties":{"id":"20260505170804-aeruco0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"RSA 方式：客户端造密钥 → 公钥加密 → 网络传输 → 服务器解密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DH/ECDHE 方式：双方交换公钥材料 → 各自本地计算 → 得出相同密钥"}]},{"ID":"20260505170804-7zdz76n","Type":"NodeParagraph","Properties":{"id":"20260505170804-7zdz76n","updated":"20260510203507"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"RSA 算法"},{"Type":"NodeText","Data":"是经典的非对称加密算法，主要用于身份认证和签名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RSA 签名"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不加密原文"},{"Type":"NodeText","Data":"，只加密摘要，用来做身份认证和防篡改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它的缺陷很明显：不支持前向保密，一旦服务器私钥泄露，所有历史会话都会被破解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时大整数运算开销大、性能差，还面临量子计算威胁，所以现在基本不用它做密钥交换"}]},{"ID":"20260505170804-mv2qef7","Type":"NodeParagraph","Properties":{"id":"20260505170804-mv2qef7","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DH 算法"},{"Type":"NodeText","Data":"它是最早的密钥交换协议，能让双方在不安全网络上协商出共享密钥，但同样不支持前向保密，且大素数运算性能差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DH 算法能在不安全网络上协商出共享密钥，核心是利用离散对数数学难题，双方不直接传递密钥本身，只交换一些公开参数，各自在本地算出相同的密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DHE"},{"Type":"NodeText","Data":" 通过 “一次会话一套临时密钥、用完即毁” 的方式，让历史会话密钥与长期私钥彻底解绑"}]},{"ID":"20260505170804-0qjjgq2","Type":"NodeParagraph","Properties":{"id":"20260505170804-0qjjgq2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ECDHE 算法"},{"Type":"NodeText","Data":"，用椭圆曲线替换了大素数运算，在同等安全强度下，密钥更短、速度更快、资源占用更少，还完整继承了前向保密特性"}]},{"ID":"20260505170804-hlqgqwd","Type":"NodeParagraph","Properties":{"id":"20260505170804-hlqgqwd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 TLS 握手中，它配合 RSA 做身份认证，兼顾安全、性能和前向保密，是现代通信的首选密钥交换方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ECDHE 负责密钥交换，RSA 负责身份认证"}]},{"ID":"20260505170804-bf0bh70","Type":"NodeParagraph","Properties":{"id":"20260505170804-bf0bh70","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 里：RSA 做身份认证，ECDHE 做密钥交换，AES 做数据加密"}]},{"ID":"20260505170804-dckz5f1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dckz5f1","updated":"20260514134334"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ECDHE 握手\t\t\u003e\u003e"}]},{"ID":"20260505170804-t9a6vc8","Type":"NodeParagraph","Properties":{"id":"20260505170804-t9a6vc8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ECDHE 握手就是 TLS 里用 RSA 做身份认证、ECDHE 做密钥交换的流程，目的是安全协商出会话密钥，同时实现前向保密"}]},{"ID":"20260505170804-pwpumoe","Type":"NodeParagraph","Properties":{"id":"20260505170804-pwpumoe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端先发送支持的 TLS 版本、密码套件（比如 ECDHE-RSA-AES）和随机数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器回应选中的套件、自己的随机数，再把证书发给客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端验证证书，确认服务器身份合法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器生成临时 ECDHE 密钥对，用自己的 RSA 私钥对这个公钥做签名，发给客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端也生成自己的临时 ECDHE 密钥对，把公钥发给服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双方用：自己私钥 + 对方公钥，在本地算出相同的预主密钥，再结合之前的随机数生成最终会话密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后所有通信都用这个密钥做 AES 对称加密，握手完成"}]},{"ID":"20260514134334-28q4mnp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260514134334-28q4mnp","updated":"20260514133656"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"RSA 通常用来做什么加密，ECDHE 通常用来做什么加密"}]},{"ID":"20260514134334-ar9f111","Type":"NodeParagraph","Properties":{"id":"20260514134334-ar9f111","updated":"20260514134258"},"Children":[{"Type":"NodeText","Data":"RSA 属于传统非对称加密，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主要用于密钥加密、身份验签"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般在 TCP 握手里，客户端用服务端公钥加密会话密钥发给服务端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端私钥解密拿到密钥，也常用来做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"证书签名校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是不能前向保密，一旦私钥泄露，所有历史通信都会被破解，现在 IM、长连接里用得越来越少"}]},{"ID":"20260514134334-a4vujye","Type":"NodeParagraph","Properties":{"id":"20260514134334-a4vujye","updated":"20260514134310"},"Children":[{"Type":"NodeText","Data":"ECDHE 是椭圆曲线的密钥交换算法，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只做密钥协商，不直接加密数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"双方各自生成临时公私钥，交换公钥后算出相同的会话密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它最大优势是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"前向保密"},{"Type":"NodeText","Data":"，就算长期私钥泄露，之前的会话密钥也破解不了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且速度快、占用带宽小，现在移动端 IM、TLS 握手基本优先用 ECDHE"}]},{"ID":"20260505170804-hbws4sf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hbws4sf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"市场主流的 tls 特点，tls1.2 和 1.3 与之前 1.1 区别\t\t\u003e\u003e"}]},{"ID":"20260505170804-7zqgv7j","Type":"NodeParagraph","Properties":{"id":"20260505170804-7zqgv7j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 1.2 对比之前的 TLS 1.1 支持了更强的加密套件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 AES-GCM 这种既能加密又能防篡改的 AEAD 模式，把 SHA-1、3DES 这些弱算法都排除了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时也支持 ECDHE 密钥交换，能实现前向保密，就算密钥泄露，以前的通信也不会被破解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过它的握手需要两次网络来回，建立连接的速度还是偏慢"}]},{"ID":"20260505170804-4v89sd0","Type":"NodeParagraph","Properties":{"id":"20260505170804-4v89sd0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 1.3 相比 1.2 和 1.1 改动非常大"}]},{"ID":"20260505170804-ulmc4pz","Type":"NodeParagraph","Properties":{"id":"20260505170804-ulmc4pz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先就是速度快很多，握手只需要 1-RTT，甚至支持 0-RTT 快速重连，延迟大大降低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次它做了 “减法”，直接删掉了所有不安全的旧算法和冗余流程，只留下最安全的几种加密方式并且强制用 ECDHE，保证前向保密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样一来，攻击面变小，配置更不容易出错，安全性和性能都全面领先，只是对一些特别老的设备兼容性差一点"}]},{"ID":"20260505170804-avr1lwz","Type":"NodeParagraph","Properties":{"id":"20260505170804-avr1lwz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS 1.3 实现 0-RTT 主要是依靠会话票据和预共享密钥 PSK，客户端第一次和服务器完成正常握手后，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器会下发一个会话票据，客户端本地保存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"下次重连时，客户端直接用之前协商好的密钥加密数据，连同票据一起放在第一条握手消息里发给服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"旧密钥 + 新随机数 → 算出本次新密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器验证票据有效后不用再走完整密钥协商，就能直接解密并处理数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个握手过程没有额外往返，从而实现 0-RTT 快速连接"}]},{"ID":"20260505170804-mdr6kuc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mdr6kuc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TLS1.3 的 1RTT 和 0RTT 握手\t\t\u003e\u003e"}]},{"ID":"20260505170804-uqthtgl","Type":"NodeParagraph","Properties":{"id":"20260505170804-uqthtgl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLS1.3 里的 1RTT 握手，就是相比之前的版本大幅简化了流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把密钥交换、证书、参数这些内容都塞到一条消息里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端和服务端只需要一来一回就能完成握手，建立加密连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"延迟更低，速度更快，也减少了网络交互带来的开销，是正常建立连接时最常用的模式"}]},{"ID":"20260505170804-1ze85xh","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ze85xh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"0RTT 则是在已经建立过连接、有会话复用信息的前提下实现的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端可以直接在上次协商好的密钥基础上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第一次发消息就带上业务数据"},{"Type":"NodeText","Data":"，不用等待握手完成，真正做到 0 往返延迟"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过它有安全限制，不能提供前向保密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也容易受到重放攻击，所以一般只用来传一些幂等、不重要的请求"}]},{"ID":"20260505170804-d8bonqh","Type":"NodeParagraph","Properties":{"id":"20260505170804-d8bonqh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"前向保密 ECDHE：每次联网都换新的根密钥，用完就扔"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就算服务器私钥泄露，以前的聊天记录也解不开"}]},{"ID":"20260505170804-viyts5i","Type":"NodeParagraph","Properties":{"id":"20260505170804-viyts5i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"报文密钥滚动 HKDF：一次连接里根密钥不变，每发一条数据就换一次加密密钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止当下数据被破解"}]},{"ID":"20260505170804-cfru0t7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cfru0t7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"tls 握手后就一定安全么"}]},{"ID":"20260505170804-nxvl7zn","Type":"NodeParagraph","Properties":{"id":"20260505170804-nxvl7zn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不一定安全，TLS 握手成功只能保证传输链路加密、数据防篡改，并不能做到绝对安全"}]},{"ID":"20260505170804-tncrnjj","Type":"NodeParagraph","Properties":{"id":"20260505170804-tncrnjj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"握手只是建立了加密通道，如果证书校验不严格"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如忽略证书过期、非法 CA、自签名证书，就很容易遭遇中间人攻击，被劫持流量解密数据"}]},{"ID":"20260505170804-wtbudyj","Type":"NodeParagraph","Properties":{"id":"20260505170804-wtbudyj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外如果使用老旧的 TLS 低版本协议、弱加密算法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者服务器私钥泄露，加密链路也会被破解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且 TLS 只管传输层安全，防不住应用层的 SQL 注入、XSS 这类业务漏洞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以握手通过不代表整体系统就安全"}]},{"ID":"20260505170804-ssk3sd3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ssk3sd3","updated":"20260518151557"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么分发证书和申请证书"}]},{"ID":"20260505170804-pqr2v9r","Type":"NodeParagraph","Properties":{"id":"20260505170804-pqr2v9r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"申请方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自己先生成一对钥匙，一个公钥一个私钥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"私钥自己留着，公钥和自己的身份信息一起发给服务端，申请证书"}]},{"ID":"20260505170804-3wjvwjp","Type":"NodeParagraph","Properties":{"id":"20260505170804-3wjvwjp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分发方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确认这个客户端是可信的之后，就用自己的证书给这个公钥做签名生成一张数字证书发回去"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后这张证书就相当于客户端的合法身份凭证，直接用这张证通信就行"}]},{"ID":"20260505170804-xzz91a5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xzz91a5","updated":"20260518151559"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果是别人自己生成的证书，你怎么去校验"}]},{"ID":"20260505170804-0nsyt8v","Type":"NodeParagraph","Properties":{"id":"20260505170804-0nsyt8v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"别人自己随便生成的证书，就是自签证书，没有经过我们认可的机构签名"}]},{"ID":"20260505170804-l1nzdl6","Type":"NodeParagraph","Properties":{"id":"20260505170804-l1nzdl6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"校验的时候，我会先看证书是不是我们信任的颁发者签发的，不在信任列表里直接不认"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再验证证书上的签名对不对，签名对不上、过期了，或者是自己随便生成的，一律判定不合法，拒绝连接"}]},{"ID":"20260505170804-c3k58qf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c3k58qf","updated":"20260518151611"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果是别人自己生成的证书，怎么校验"}]},{"ID":"20260505170804-ymp5u3m","Type":"NodeParagraph","Properties":{"id":"20260505170804-ymp5u3m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先看证书是不是由我们信任的 CA 签发的，也就是验证证书的签发者是否在信任列表里。然后验证证书上的签名，用 CA 的公钥解密签名，对比证书内容是否一致。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还要检查证书的有效期、吊销状态，如果是自己随便生成的自签证书，不在信任列表里，签名验证直接失败，就判定为非法证书，拒绝连接。"}]},{"ID":"20260505170804-xor4tb9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xor4tb9","updated":"20260517172455"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 WebSocket？\t\u003e\u003e"}]},{"ID":"20260505170804-95sackv","Type":"NodeParagraph","Properties":{"id":"20260505170804-95sackv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"WebSocket 是基于 TCP 的全双工长连接协议，支持客户端和服务器双向实时主动通信，适合聊天、游戏、股票推送等实时场景"}]},{"ID":"20260505170804-n9gqhcq","Type":"NodeParagraph","Properties":{"id":"20260505170804-n9gqhcq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它保证消息可靠，靠的是端到端保障"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"消息先本地缓存防丢失，通过长连接发给服务端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端收到后持久化再转发，对方接收后返回回执"}]},{"ID":"20260505170804-z1lgnhp","Type":"NodeParagraph","Properties":{"id":"20260505170804-z1lgnhp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每条消息有唯一 ID 和状态，两端双重存储 + 确认回执，确保不丢"}]},{"ID":"20260505170804-36abykb","Type":"NodeParagraph","Properties":{"id":"20260505170804-36abykb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"丢包多因网络波动、客户端闪退、服务端故障等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层靠 TCP 保证传输可靠，客户端做断线重连和弱网优化；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端用消息队列、集群防止故障丢消息，未确认消息会缓存，网络恢复后自动补发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重传靠超时机制，按递增间隔重试并限制次数，避免拥堵"}]},{"ID":"20260505170804-roychp3","Type":"NodeParagraph","Properties":{"id":"20260505170804-roychp3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用消息 ID 去重，防止重复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还会配合系统推送备用通道、多副本备份和监控告警，让 IM 消息稳定不丢"}]},{"ID":"20260505170804-mt8l2pg","Type":"NodeParagraph","Properties":{"id":"20260505170804-mt8l2pg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"WebSocket 核心就是解决 HTTP 做实时通信的三大痛点：单向、短连接、轮询费资源"}]},{"ID":"20260505170804-tg9np2w","Type":"NodeParagraph","Properties":{"id":"20260505170804-tg9np2w","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"从单向变双向全双工 HTTP 只能客户端问、服务器答，WebSocket 连上后两边能随时主动发消息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从短连接变真正长连接 HTTP 一次请求一次响应，连了断、断了连"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WebSocket 一次握手一直连着，不用重复建连"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据头更小、更省流量 HTTP 每次都带一大串请求头"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WebSocket 只有握手用 HTTP，之后数据帧极轻量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用轮询，资源消耗低以前实时功能只能靠不停发请求刷数据；WebSocket 有数据服务器直接推送，不做无效请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原生支持心跳，连接更稳自带心跳保活，比 HTTP 自己实现更可靠，还兼容 80/443 端口，好部署"}]},{"ID":"20260517172455-mzcwgpf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517172455-mzcwgpf","updated":"20260517172608"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"websocket 和 http1.1 的区别"}]},{"ID":"20260517172503-qhw5pck","Type":"NodeParagraph","Properties":{"id":"20260517172503-qhw5pck","updated":"20260517172559"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP/1.1 是半双工通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能客户端主动请求、服务端被动响应，服务端没法主动推送数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"想要实时只能靠轮询或长轮询，延迟高、头部开销大、带宽浪费"}]},{"ID":"20260517172503-fw91sg7","Type":"NodeParagraph","Properties":{"id":"20260517172503-fw91sg7","updated":"20260517172608"},"Children":[{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"WebSocket 基于 HTTP 完成握手后升级为长连接，全双工通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连接持续保持，客户端和服务端可以互相主动发消息，传输头部小、延迟低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合腾讯会议这类实时信令、IM、音视频场景"}]},{"ID":"20260505170804-dlr6ky3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dlr6ky3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 缓存机制"}]},{"ID":"20260505170804-9swkktm","Type":"NodeParagraph","Properties":{"id":"20260505170804-9swkktm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强制缓存和协商缓存是浏览器缓存的两种核心策略，主要根据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"资源是否频繁变动"},{"Type":"NodeText","Data":"来选择使用"}]},{"ID":"20260505170804-za9bp5d","Type":"NodeParagraph","Properties":{"id":"20260505170804-za9bp5d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"强制缓存"},{"Type":"NodeText","Data":"适用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内容长期不更新、不需要校验"},{"Type":"NodeText","Data":"的静态资源，比如图片、固定 JS/CSS 文件、版本化的静态资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特点是浏览器直接从本地缓存读取，不向服务器发送任何请求，响应速度最快，能最大程度减轻服务器压力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要资源稳定不变，就优先用强制缓存"}]},{"ID":"20260505170804-gtd58e2","Type":"NodeParagraph","Properties":{"id":"20260505170804-gtd58e2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强制缓存过期后触发协商缓存"}]},{"ID":"20260505170804-sperlm9","Type":"NodeParagraph","Properties":{"id":"20260505170804-sperlm9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"协商缓存"},{"Type":"NodeText","Data":"适用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内容可能变化、需要确保新鲜度"},{"Type":"NodeText","Data":"的资源，比如接口数据、HTML 页面、经常更新的配置文件强制缓存过期后触发协商缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不会直接使用缓存，而是先向服务器发送请求带上缓存标识，由服务器判断资源是否更新：没更新就返回 304 让浏览器用缓存，更新了就返回新内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当资源不确定是否变动、需要保证用户拿到最新版本时，使用协商缓存"}]},{"ID":"20260505170804-mcxfb5t","Type":"NodeParagraph","Properties":{"id":"20260505170804-mcxfb5t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"304 Not Modified 是 HTTP 状态码，专门用在协商缓存里。意思是资源没有被修改，直接用本地缓存就行"}]},{"ID":"20260505170804-ugkwiuq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ugkwiuq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"协商缓存两种方式\t\t\u003e\u003e"}]},{"ID":"20260505170804-qeatq8o","Type":"NodeParagraph","Properties":{"id":"20260505170804-qeatq8o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"协商缓存主要有两种实现方式，分别是基于时间的和基于文件标识"}]},{"ID":"20260505170804-ws2pdmp","Type":"NodeParagraph","Properties":{"id":"20260505170804-ws2pdmp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一种是 Last-Modified 和 If-Modified-Since"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器在返回资源时会带上最后修改时间，浏览器下次请求时带上这个时间去询问服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果资源没更新，就返回 304，浏览器直接用缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果更新了就返回新资源"}]},{"ID":"20260505170804-yg5j8a2","Type":"NodeParagraph","Properties":{"id":"20260505170804-yg5j8a2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二种是 ETag 和 If-None-Match"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器会给资源生成一个唯一标识，类似文件指纹"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器下次请求时带上这个标识，服务器对比后发现没变就返回 304，变了就返回新内容"}]},{"ID":"20260505170804-e7pohya","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e7pohya","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 状态码\t\t\u003e\u003e"}]},{"ID":"20260505170804-du70sqe","Type":"NodeParagraph","Properties":{"id":"20260505170804-du70sqe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 状态码用来表示服务器对请求的处理结果，主要分为五大类"}]},{"ID":"20260505170804-3gxrls7","Type":"NodeParagraph","Properties":{"id":"20260505170804-3gxrls7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1xx 是信息类，表示请求正在处理，比如 101 协议切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2xx 是成功类，代表请求正常处理完成，常见的有 200 成功、204 无响应体、206 断点续传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3xx 是重定向类，需要进一步操作，比如 301 永久重定向、302 临时重定向，还有 304 协商缓存未修改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4xx 是客户端错误，比如 400 参数错误、401 未授权、403 禁止访问、404 资源不存在"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5xx 是服务器错误，比如 500 服务器内部错误、502 网关错误、504 网关超时"}]},{"ID":"20260505170804-o3zv4i7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-o3zv4i7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"重定向是什么\t\u003e\u003e"}]},{"ID":"20260505170804-wvsv65j","Type":"NodeParagraph","Properties":{"id":"20260505170804-wvsv65j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"重定向就是服务器告诉浏览器，你访问的这个地址已经变了，去新地址请求资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器收到 3xx 状态码和新的 URL 后，会自动发起第二次请求，跳转到新地址，这个过程就叫重定向"}]},{"ID":"20260505170804-ryaj3k3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ryaj3k3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"限流对应的 HTTP 状态码是什么？为什么是该状态码？\t\t\u003e\u003e"}]},{"ID":"20260505170804-22ci85t","Type":"NodeParagraph","Properties":{"id":"20260505170804-22ci85t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"限流一般返回 429 Too Many Requests 状态码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它专门表示客户端在单位时间内请求次数过多，服务器拒绝服务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属于客户端侧的频率控制类错误，既不是服务器故障，也不是资源不存在，用 429 最标准、语义最清晰"}]},{"ID":"20260505170804-b4l2vvy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b4l2vvy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 层请求的类型有哪些？\t\u003e\u003e"}]},{"ID":"20260505170804-u7xttjz","Type":"NodeParagraph","Properties":{"id":"20260505170804-u7xttjz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"GET：用于请求获取指定资源，通常用于获取数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HEAD：类似于 GET 请求，但只返回资源的头部信息，用于获取资源的元数据而不获取实际内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST：用于向服务器提交数据，通常用于提交表单数据或进行资源的创建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"PUT：用于向服务器更新指定资源，通常用于更新已存在的资源是全量覆盖、幂等\t\t\t\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"PATCH：局部更新资源，和 PUT 区别：PUT 全量、PATCH 增量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 管 “加”，PUT 管 “改”"}]},{"ID":"20260505170804-dq8nwin","Type":"NodeParagraph","Properties":{"id":"20260505170804-dq8nwin","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DELETE：用于请求服务器删除指定资源"}]},{"ID":"20260505170804-7z94xr2","Type":"NodeParagraph","Properties":{"id":"20260505170804-7z94xr2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"OPTIONS：查询服务器支持哪些请求方法、跨域预检"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TRACE：回显请求路径，调试用，一般服务器禁用"}]},{"ID":"20260505170804-4rjmg8s","Type":"NodeParagraph","Properties":{"id":"20260505170804-4rjmg8s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 请求协议就按顺序写三部分："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最上面写请求行\t\t      说明本次请求的方式、地址和协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间写一堆请求头\t       带一些环境和配置信息\t告诉服务器我是谁、我能接受什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"空一行，下面写请求体（GET 一般没有）\t\t\t放真正要传给后端的业务数据"}]},{"ID":"20260505170804-8vgzdvt","Type":"NodeParagraph","Properties":{"id":"20260505170804-8vgzdvt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"整个就是一段文本，通过网络发给服务器，服务器按这个格式解析"}]},{"ID":"20260505170804-o0v8v8h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"aHR0cA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-o0v8v8h","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"aHR0cA=="},{"Type":"NodeCodeBlockCode","Data":"POST /login HTTP/1.1\nHost: www.test.com\nContent-Type: application/x-www-form-urlencoded\n\nusername=admin\u0026password=123456\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-g1fksy8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-g1fksy8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 重定向、location 字段"}]},{"ID":"20260505170804-yxt9m1y","Type":"NodeParagraph","Properties":{"id":"20260505170804-yxt9m1y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 重定向就是服务器不直接返回资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过响应头 Location 字段告诉浏览器资源的新地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由浏览器自动重新发起请求跳转到新地址，属于客户端行为，不是服务器内部转发"}]},{"ID":"20260505170804-dcpxuqv","Type":"NodeParagraph","Properties":{"id":"20260505170804-dcpxuqv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其中 301 是永久重定向，浏览器会缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"302 是临时重定向，不缓存但可能把 POST 改成 GET"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"307 是严格临时重定向，会保持原请求方法和请求体不变"}]},{"ID":"20260505170804-6j06oeu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6j06oeu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 缓存：强制缓存、协商缓存、实现字段"}]},{"ID":"20260505170804-m0lsv0w","Type":"NodeParagraph","Properties":{"id":"20260505170804-m0lsv0w","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"强制缓存"},{"Type":"NodeText","Data":"适用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内容长期不更新、不需要校验"},{"Type":"NodeText","Data":"的静态资源，比如图片、固定 JS/CSS 文件、版本化的静态资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特点是浏览器直接从本地缓存读取，不向服务器发送任何请求，响应速度最快，能最大程度减轻服务器压力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要资源稳定不变，就优先用强制缓存"}]},{"ID":"20260505170804-40zxlc0","Type":"NodeParagraph","Properties":{"id":"20260505170804-40zxlc0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强制缓存过期后触发协商缓存"}]},{"ID":"20260505170804-c7ocmmw","Type":"NodeParagraph","Properties":{"id":"20260505170804-c7ocmmw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"协商缓存"},{"Type":"NodeText","Data":"适用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内容可能变化、需要确保新鲜度"},{"Type":"NodeText","Data":"的资源，比如接口数据、HTML 页面、经常更新的配置文件强制缓存过期后触发协商缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不会直接使用缓存，而是先向服务器发送请求带上缓存标识，由服务器判断资源是否更新：没更新就返回 304 让浏览器用缓存，更新了就返回新内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当资源不确定是否变动、需要保证用户拿到最新版本时，使用协商缓存"}]},{"ID":"20260505170804-l519cxz","Type":"NodeParagraph","Properties":{"id":"20260505170804-l519cxz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"协商缓存分两种实现字段"}]},{"ID":"20260505170804-g8f9rff","Type":"NodeParagraph","Properties":{"id":"20260505170804-g8f9rff","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一组 Last-Modified / If-Modified-Since"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器返回资源修改时间，下次请求浏览器带上这个时间问服务器，没变就返回 304"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是按时间判断，不够精准"}]},{"ID":"20260505170804-mh9owet","Type":"NodeParagraph","Properties":{"id":"20260505170804-mh9owet","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二组 ETag / If-None-Match"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器返回资源内容指纹，浏览器下次带上指纹询问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它按内容判断，更准确，优先级比时间缓存更高"}]},{"ID":"20260505170804-xst3mcf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xst3mcf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"预读失效、缓存污染"}]},{"ID":"20260505170804-6uec9sg","Type":"NodeParagraph","Properties":{"id":"20260505170804-6uec9sg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"预读失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器会提前预加载资源做缓存，但资源后续实际请求地址、参数变了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"预读缓存匹配不上，就无法复用，这就是预读失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质是预缓存和真实请求不一致，缓存白存了"}]},{"ID":"20260505170804-oafvlu3","Type":"NodeParagraph","Properties":{"id":"20260505170804-oafvlu3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"缓存污染"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器返回了错误、过期、不该缓存的资源，被浏览器正常缓存下来。之后每次都命中错误缓存，一直加载错误内容，刷新也没用，必须清缓存才恢复，这就是缓存污染"}]},{"ID":"20260505170804-lvr35vc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lvr35vc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"get 和 post 都封装成什么传数据"}]},{"ID":"20260505170804-oa1kbxu","Type":"NodeParagraph","Properties":{"id":"20260505170804-oa1kbxu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"GET 把数据封装成 URL 后面的查询字符串"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 把数据封装到请求体里，可以是表单键值对，也可以是 JSON"}]},{"ID":"20260505170804-vd5io7t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vd5io7t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 中的 GET 和 POST"}]},{"ID":"20260505170804-xss1sbc","Type":"NodeParagraph","Properties":{"id":"20260505170804-xss1sbc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"语义与用途"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 用于查询、获取资源，是只读操作，不会修改服务器数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 用于提交数据、新增 / 修改资源，会对服务端资源产生变更"}]},{"ID":"20260505170804-3vunc8b","Type":"NodeParagraph","Properties":{"id":"20260505170804-3vunc8b","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"参数携带方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 参数拼接在 URL 地址栏中，明文可见"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 参数放在请求体里，不会暴露在地址栏"}]},{"ID":"20260505170804-dv0htk7","Type":"NodeParagraph","Properties":{"id":"20260505170804-dv0htk7","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长度与缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 受 URL 长度限制，传参数据量小；浏览器默认缓存 GET 请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 无固定长度限制，可传大量数据、文件；默认不缓存"}]},{"ID":"20260505170804-1vmdsjo","Type":"NodeParagraph","Properties":{"id":"20260505170804-1vmdsjo","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"安全性与书签"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 明文传输，安全性低，可收藏书签、历史记录保留"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 请求体加密性更好，相对安全，无法收藏书签"}]},{"ID":"20260505170804-3nbzepu","Type":"NodeParagraph","Properties":{"id":"20260505170804-3nbzepu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幂等性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 是幂等，多次请求结果一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 非幂等，多次提交可能产生重复数据"}]},{"ID":"20260505170804-wv5g4z7","Type":"NodeParagraph","Properties":{"id":"20260505170804-wv5g4z7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在实际开发中，查询、列表展示等只读操作通常用 GET"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"涉及新增、修改、删除或敏感数据传输时，优先使用 POST"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时配合 HTTPS 进一步保证传输安全"}]},{"ID":"20260505170804-ij2yrxs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ij2yrxs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"post 会更安全是吗？可以用 post 完全代替 get 吗?"}]},{"ID":"20260505170804-q0wmz91","Type":"NodeParagraph","Properties":{"id":"20260505170804-q0wmz91","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"POST 并不比 GET 更安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 的参数拼在 URL 地址栏里，会保留在浏览器历史、访问日志中，容易泄露"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"POST 参数放在请求体里，不会暴露在地址栏和历史记录，只是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相对隐蔽"}]},{"ID":"20260505170804-d2z4b3k","Type":"NodeParagraph","Properties":{"id":"20260505170804-d2z4b3k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但二者本身都是明文传输，抓包都能轻松看到内容，都没有加密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正的安全只能依靠 HTTPS，和请求方式本身无关"}]},{"ID":"20260505170804-0vx0unj","Type":"NodeParagraph","Properties":{"id":"20260505170804-0vx0unj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不能用 POST 完全替代 GET"}]},{"ID":"20260505170804-f1rw2yx","Type":"NodeParagraph","Properties":{"id":"20260505170804-f1rw2yx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"二者设计语义本身不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"GET 是用来查询获取数据，属于只读操作，具备幂等性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持浏览器缓存、可以收藏链接、刷新不会产生副作用"}]},{"ID":"20260505170804-xsruyz3","Type":"NodeParagraph","Properties":{"id":"20260505170804-xsruyz3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而 POST 是用来提交、修改、新增数据，不默认缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"刷新页面容易造成重复提交，也不适合做链接分享和缓存"}]},{"ID":"20260505170804-vc105u4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vc105u4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP、SOCKET 和 TCP 的区别\t\u003e\u003e"}]},{"ID":"20260505170804-rcze57b","Type":"NodeParagraph","Properties":{"id":"20260505170804-rcze57b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 是传输层协议，负责可靠传输、三次握手、数据分片与重传，是网络通信的基础机制"}]},{"ID":"20260505170804-rhkw7ba","Type":"NodeParagraph","Properties":{"id":"20260505170804-rhkw7ba","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Socket 不是协议，而是传输层的编程接口，是程序用来操作 TCP/UDP 的一套 API"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我们常说的 Socket 编程，本质就是基于 TCP 或 UDP 实现网络通信"}]},{"ID":"20260505170804-y7640xw","Type":"NodeParagraph","Properties":{"id":"20260505170804-y7640xw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 是应用层协议，基于 TCP 封装，定义了请求响应格式、请求方法、状态码等规则，默认使用长连接复用 TCP 传输数据"}]},{"ID":"20260505170804-m1an5nc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m1an5nc","updated":"20260528180909"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"QUIC 如何实现 UDP 的可靠传输的？"}]},{"ID":"20260505170804-ebdel8y","Type":"NodeParagraph","Properties":{"id":"20260505170804-ebdel8y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"QUIC 是基于 UDP 实现的可靠传输协议，把 TCP 的可靠传输、流量控制、拥塞控制，都在用户态重新实现了一遍。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它给每个数据包编唯一递增的 Packet Number，接收方收到就回 ACK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪个编号没确认，就知道丢包了，直接快速重传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时用 Stream 多路复用：一条连接里开多个逻辑通道，不同请求互不影响，一个丢包不堵其他请求，彻底解决队头阻塞，还支持 0-RTT、连接迁移。所以 QUIC 又快又可靠，比 TCP 强很多"}]},{"ID":"20260505170804-zwzqvy2","Type":"NodeParagraph","Properties":{"id":"20260505170804-zwzqvy2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TCP 必须 3 次握手"},{"Type":"NodeText","Data":"：为了"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防止历史重复连接报文"},{"Type":"NodeText","Data":"，确保连接有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"QUIC 只要 1-RTT"},{"Type":"NodeText","Data":"：因为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加密 + Connection ID"},{"Type":"NodeText","Data":" 天然防旧包，不需要第三次确认"}]},{"ID":"20260505170804-0nmuk5j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0nmuk5j","updated":"20260528180910"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"QUIC 解决 TCP 队头阻塞原理"}]},{"ID":"20260505170804-gi7x0mi","Type":"NodeParagraph","Properties":{"id":"20260505170804-gi7x0mi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先 TCP 是面向连接、有序、单字节流，所有数据共用一条管道"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦前面一个数据包丢了，后面所有包都要等待重传，这就是队头阻塞"}]},{"ID":"20260505170804-0yjd0fz","Type":"NodeParagraph","Properties":{"id":"20260505170804-0yjd0fz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"QUIC 基于 UDP，底层不再是单一流，而是一个连接里划分多个独立数据流 Stream"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同 Stream 之间完全独立，互不影响"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同流可以承载不同业务数据，互相分开"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个流传视频数据、一个流传音频、一个流传信令控制消息、一个流传心跳"}]},{"ID":"20260505170804-v7fl8xb","Type":"NodeParagraph","Properties":{"id":"20260505170804-v7fl8xb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当其中一个流丢包阻塞时，只会阻塞当前这一个流，其他正常数据流可以继续发送、继续接收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不会整体卡住，从根源解决了 TCP 传输层队头阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时 QUIC 自带 0-RTT/1-RTT 握手、连接迁移、内置 TLS 加密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还在应用层实现拥塞控制，配合 UDP 无连接特性，进一步降低延迟，非常适合直播、短视频、实时通信场景"}]},{"ID":"20260505170804-xe36uay","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xe36uay","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"QUIC  0-RTT"}]},{"ID":"20260505170804-3gqm78x","Type":"NodeParagraph","Properties":{"id":"20260505170804-3gqm78x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"QUIC 之所以支持 0-RTT，是因为它内置了 TLS 1.3，并且在第一次连接成功后，客户端会缓存一个会话凭据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"下次重连时，客户端不用等待握手完成，直接用缓存的凭据加密数据，第一个包就把业务数据发出去，不需要额外往返，所以能实现 0-RTT 建连"}]},{"ID":"20260505170804-vurft6c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vurft6c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"说一下 KCP？"}]},{"ID":"20260505170804-o59te1p","Type":"NodeParagraph","Properties":{"id":"20260505170804-o59te1p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它保留 UDP 的快，又加了 TCP 的可靠传输、流量控制、拥塞控制，能保证数据传到位、不拥塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最核心的是它的激进重传策略：丢包了不怎么等超时，收到 3 个重复 ACK 就立马重传，还能只重传丢的那个包，不浪费资源；而且丢包时不会像 TCP 那样大幅降速，传输更稳、延迟更低，还能调得更灵活，适配实时应用的需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和 TCP 比，TCP 是系统自带的传输层协议，KCP 在应用层自己实现，虽然要手动管理，但效率更高、延迟更低，更适合实时场景"}]},{"ID":"20260505170804-t2ky282","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t2ky282","updated":"20260528183149"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对比一下 QUIC 和 KCP"}]},{"ID":"20260505170804-q0etdnx","Type":"NodeParagraph","Properties":{"id":"20260505170804-q0etdnx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"KCP 和 QUIC 都是基于 UDP 实现的可靠传输协议，都解决了 UDP 不可靠、TCP 延迟高、队头阻塞的问题，但定位、功能和使用场景差别很大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"KCP 更偏向极简、极致低延迟，它只专注做一件事：在 UDP 上实现快速、可靠的数据传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它有非常激进的重传和拥塞控制，丢包不等待、不降速太狠，专门为游戏、实时语音视频这种对延迟敏感的场景设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但 KCP 本身不带加密、没有连接迁移、没有多路复用，功能比较单一，需要自己搭配加密和业务逻辑使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"QUIC 则是一套完整、标准化、安全的通用传输协议，专门为 HTTP/3 设计。它不仅实现了可靠传输、拥塞控制，还内置了 TLS 加密，天生安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持 Stream 多路复用，彻底解决队头阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还能做到 0-RTT 快速握手 和 连接迁移，切换网络不断线。它功能更全、更通用，适合网页、APP、接口等大部分互联网场景"}]},{"ID":"20260528183149-jhffnso","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260528183149-jhffnso","updated":"20260528183236"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 的 sack"}]},{"ID":"20260528183155-gm9cbns","Type":"NodeParagraph","Properties":{"id":"20260528183155-gm9cbns","updated":"20260528183211"},"Children":[{"Type":"NodeText","Data":"TCP 默认是累积确认，ACK 只能表示连续的数据已收到，没法区分乱序到达的报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦中间丢包，发送方会把丢包及后续所有数据一并重传，造成带宽浪费"}]},{"ID":"20260528183212-fypydh1","Type":"NodeParagraph","Properties":{"id":"20260528183212-fypydh1","updated":"20260528183236"},"Children":[{"Type":"NodeText","Data":"开启 SACK 选择性确认后，接收方会在 ACK 里附带已收到的乱序数据区间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方就能精准定位丢失部分，只重传缺失报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但 SACK 只是优化了重传策略，无法解决 TCP 固有的队头阻塞问题"}]},{"ID":"20260505170804-rlof3hp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rlof3hp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"HTTP 到底是不是无状态的？\t\u003e\u003e"}]},{"ID":"20260505170804-qayp6ki","Type":"NodeParagraph","Properties":{"id":"20260505170804-qayp6ki","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTP 是无状态的，这意味着每个请求都是独立的，服务器不会在多个请求之间保留关于客户端状态的信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在每个 HTTP 请求中，服务器不会记住之前的请求或会话状态，因此每个请求都是相互独立的"}]},{"ID":"20260505170804-1k3lue3","Type":"NodeParagraph","Properties":{"id":"20260505170804-1k3lue3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虽然 HTTP 本身是无状态的，但可以通过一些机制来实现状态保持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其中最常见的方式是使用 Cookie 和 Session 来跟踪用户状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过在客户端存储会话信息或状态信息，服务器可以识别和跟踪特定用户的状态，以提供一定程度的状态保持功能"}]},{"ID":"20260505170804-p0v550b","Type":"NodeParagraph","Properties":{"id":"20260505170804-p0v550b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虽然 Cookie 是 HTTP 协议簇的一部分，但是 HTTP 协议在设计初衷上仍然保持无状态特性，即每个请求都是相互独立的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用 Cookie 只是在无状态协议下的一种补充机制，用于在客户端存储状态信息以实现状态保持"}]},{"ID":"20260505170804-2aietpq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2aietpq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"http 无状态优劣一 cookie"}]},{"ID":"20260505170804-7mn7wib","Type":"NodeParagraph","Properties":{"id":"20260505170804-7mn7wib","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务器不会记录客户端上一次的请求信息，每次请求都是独立互不关联的"}]},{"ID":"20260505170804-c68kcpg","Type":"NodeParagraph","Properties":{"id":"20260505170804-c68kcpg","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无状态优点"},{"Type":"NodeText","Data":"："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器不用保存客户端状态，压力小、负载低，架构简单好横向扩容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"故障隔离性好，单次请求失败不影响其他请求"}]},{"ID":"20260505170804-r693c6a","Type":"NodeParagraph","Properties":{"id":"20260505170804-r693c6a","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无状态缺点"},{"Type":"NodeText","Data":"："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没法记住用户登录、购物车、浏览记录这类会话信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次请求都要重新带身份标识，没法维持连续会话"}]},{"ID":"20260505170804-hamrmeq","Type":"NodeParagraph","Properties":{"id":"20260505170804-hamrmeq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为解决无状态缺陷，引入 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Cookie"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由服务器下发、浏览器本地存储，后续每次请求自动带上 Cookie"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器就能识别同一个用户、维持会话状态，弥补了 HTTP 无状态的短板"}]},{"ID":"20260505170804-8rh5pnr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8rh5pnr","updated":"20260511130707"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"cookie 和 Session 有什么区别"}]},{"ID":"20260505170804-rm0nzko","Type":"NodeParagraph","Properties":{"id":"20260505170804-rm0nzko","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Cookie 存在客户端浏览器，Session 存在服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Cookie 是本地小文本，容量小、不安全；Session 服务端存储，更安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Session 依赖 Cookie：服务器生成 sessionid，存在 Cookie 里带回客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Cookie 可以长期保存，Session 默认会话结束就销毁"}]},{"ID":"20260505170804-kd80x2h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kd80x2h","updated":"20260511130709"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Session 和 Cookie，举例子"}]},{"ID":"20260505170804-fyxhq7v","Type":"NodeParagraph","Properties":{"id":"20260505170804-fyxhq7v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Cookie 是服务器生成并保存在浏览器的一小段数据，每次请求时浏览器会自动携带"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如登录一个网站时，服务器会把用户标识写入 Cookie 存到本地，下次访问时浏览器带上这个 Cookie，服务器就能识别用户身份，不用重复登录"}]},{"ID":"20260505170804-wk1l9xh","Type":"NodeParagraph","Properties":{"id":"20260505170804-wk1l9xh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Session 是保存在服务器端的用户会话数据，每个会话对应一个唯一的 SessionID"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户登录后，服务器把用户信息、登录状态等存在 Session 里，只把 SessionID 发给浏览器存在 Cookie 中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后续请求带上 SessionID，服务器就能找到对应的会话信息，完成身份验证"}]},{"ID":"20260505170804-jr4h8b8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jr4h8b8","updated":"20260511130604"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Token"}]},{"ID":"20260505170804-lur02cr","Type":"NodeParagraph","Properties":{"id":"20260505170804-lur02cr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Token 一般就是一段加密字符串，常见的用 JWT 来实现"}]},{"ID":"20260505170804-yi7eftk","Type":"NodeParagraph","Properties":{"id":"20260505170804-yi7eftk","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户第一次登录时，输入账号密码请求登录接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后端验证账号密码正确后，生成对应的 Token，然后直接在响应里返回给前端，一般放在响应体或者 HTTP 头里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端拿到 Token 后，会存在 localStorage、sessionStorage 或者 Cookie 里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后每次请求接口，前端都自动把 Token 带到请求头里带给后端，完成身份传递"}]},{"ID":"20260505170804-ve8jpsk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ve8jpsk","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"怎么去校验合法用户"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端每次请求都会带上 Token，后端先拦截这个 Token"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先看 Token 格式对不对、有没有过期，然后用服务器保存的密钥验证签名是否正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果签名合法、没过期，就解析出里面的用户信息，确认用户存在并且状态正常，就认为是合法用户，放行接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要是签名不对、过期或者用户被禁用，就直接拒绝访问"}]},{"ID":"20260505170804-nx02999","Type":"NodeParagraph","Properties":{"id":"20260505170804-nx02999","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和 Session 不同，JWT 这类 Token 不占用服务器内存，不需要在服务端存储会话信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器只需要验证签名就能确认身份，更适合分布式、跨域和前后端分离项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如登录 App 后拿到 JWT，之后调用个人中心、订单接口时都带上它，服务器验证通过就放行，不用再查询会话状态"}]},{"ID":"20260505170804-mjax3nc","Type":"NodeParagraph","Properties":{"id":"20260505170804-mjax3nc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Session 适用场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统单体项目、前后端不分离的网站，比如电商后台管理系统、PC 端官网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这类项目服务单一、集群少，用 Session 配合 Cookie 即可快速实现登录状态管理，开发简单，适合对跨域、分布式需求不高的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Token 适用场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前后端分离、分布式、微服务、跨端项目，比如 App、小程序、第三方登录接口、高并发的大型网站"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Token 不依赖 Cookie、不占用服务器存储，支持多服务共享验证，扩展性更强，适合跨域、多服务器、移动端等场景"}]},{"ID":"20260505170804-0n9lnjq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0n9lnjq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"token 的来源"}]},{"ID":"20260505170804-cw3mrmi","Type":"NodeParagraph","Properties":{"id":"20260505170804-cw3mrmi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Token 不是服务器凭空生成的，是客户端登录成功后，由服务端颁发签发的身份凭证"}]},{"ID":"20260505170804-1yx6lgm","Type":"NodeParagraph","Properties":{"id":"20260505170804-1yx6lgm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户第一次输入账号密码登录，服务端校验账号密码正确后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会按照加密规则生成 Token 返回给前端"}]},{"ID":"20260505170804-229ky87","Type":"NodeParagraph","Properties":{"id":"20260505170804-229ky87","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"前端把 Token 存储在本地，之后每次请求接口，都在请求头里带上这个 Token"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端验证 Token 合法有效，就识别出当前登录用户"}]},{"ID":"20260505170804-gnybhj7","Type":"NodeParagraph","Properties":{"id":"20260505170804-gnybhj7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Token 本质一般是 JWT 加密字符串，包含用户信息、过期时间、签名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端不需要在数据库保存 Token，只需验证签名是否正确即可"}]},{"ID":"20260505170804-jzbprul","Type":"NodeParagraph","Properties":{"id":"20260505170804-jzbprul","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它的来源就是：用户登录认证通过 → 服务端加密签发发放"}]},{"ID":"20260505170804-lzcflmt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lzcflmt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"token 的校验和更新"}]},{"ID":"20260505170804-6io9hy4","Type":"NodeParagraph","Properties":{"id":"20260505170804-6io9hy4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务端校验 Token 时，主要验证签名是否正确、有没有过期、信息是否被篡改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"校验通过才放行接口请求"}]},{"ID":"20260505170804-8zf13fx","Type":"NodeParagraph","Properties":{"id":"20260505170804-8zf13fx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Token 更新一般使用双 Token 机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Access Token 有效期短，用于正常接口访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Refresh Token 有效期长，用于刷新令牌"}]},{"ID":"20260505170804-n2xbr5o","Type":"NodeParagraph","Properties":{"id":"20260505170804-n2xbr5o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当 Access Token 过期，前端携带 Refresh Token 请求后端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"校验通过后后端下发新的 Access Token，无需用户重新登录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Refresh Token 过期，则需要重新登录认证"}]},{"ID":"20260505170804-uxjv3sh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uxjv3sh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"有 token 就一定合法吗"}]},{"ID":"20260505170804-gms3iw8","Type":"NodeParagraph","Properties":{"id":"20260505170804-gms3iw8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有 Token 不代表一定合法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先 Token 可能已经过期失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次 Token 可能签名错误、被篡改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有 Token 可能是别人盗用的、伪造的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"甚至用户已经被后台注销、禁用、下线了"}]},{"ID":"20260505170804-wpalox9","Type":"NodeParagraph","Properties":{"id":"20260505170804-wpalox9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务端必须完整校验："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"签名是否正确、是否过期、账号状态是否正常，全部通过，才是真正合法有效的 Token"}]},{"ID":"20260505170804-p5yi7qn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-p5yi7qn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"长连接和短连接场景下的 token"}]},{"ID":"20260505170804-avm0inu","Type":"NodeParagraph","Properties":{"id":"20260505170804-avm0inu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"短连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"短连接每次请求建立新连接、用完就断开，连接不保持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以 Token 一般放在请求头 Authorization 里，每次请求都要携带 Token 做鉴权"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端无状态，不保存连接，每次都重新校验 Token 签名、过期、合法性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长连接建立后一直不断开，不会每次新建"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连接建立第一次握手时携带 Token 鉴权，校验通过就保持连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后续消息通信不需要每次都带 Token，服务端标记当前连接已登录授权即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长连接还要处理 Token 过期问题：Token 到期要重新认证刷新，不然服务端会断开连接下线"}]},{"ID":"20260505170804-otnjcxb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-otnjcxb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"token 需要携带什么信息"}]},{"ID":"20260505170804-dje41lu","Type":"NodeParagraph","Properties":{"id":"20260505170804-dje41lu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"头部：加密算法类型，告诉服务端用什么方式验签"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"载荷：非敏感身份信息，比如用户 ID、角色权限、过期时间，用来识别用户"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"签名：头部 + 载荷 + 密钥加密生成，用来防篡改"}]},{"ID":"20260505170804-eb3aas4","Type":"NodeParagraph","Properties":{"id":"20260505170804-eb3aas4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"额外注意："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"密码、手机号、身份证等敏感隐私信息绝对不能放 Token"}]},{"ID":"20260505170804-u9ex2xa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-u9ex2xa","updated":"20260511130643"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JWT"}]},{"ID":"20260505170804-mnr6n0a","Type":"NodeParagraph","Properties":{"id":"20260505170804-mnr6n0a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Token 是身份凭证的统称，JWT 是其中一种自带信息和签名的 Token"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通 Token 需要服务器存起来校验，而 JWT 本身就包含用户信息，服务器不用存会话，直接验证签名就能确认身份，更适合分布式和前后端分离项目"}]},{"ID":"20260505170804-v5hxfbz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-v5hxfbz","updated":"20260511130645"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JWT 令牌都有哪些字段？"}]},{"ID":"20260505170804-ywm4u20","Type":"NodeParagraph","Properties":{"id":"20260505170804-ywm4u20","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"JWT 结构分为三部分："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"头部 Header、载荷 Payload、签名 Signature，用点隔开"}]},{"ID":"20260505170804-8fhwo08","Type":"NodeParagraph","Properties":{"id":"20260505170804-8fhwo08","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"头部是 JSON 格式，存签名算法（比如 HS256）和令牌类型 JWT，Base64 编码后就是第一部分"}]},{"ID":"20260505170804-4xwlse8","Type":"NodeParagraph","Properties":{"id":"20260505170804-4xwlse8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"载荷也是 JSON，存用户信息、过期时间这些自定义声明"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如用户 ID、角色、iat 签发时间、exp 过期时间，同样 Base64 编码成第二部分"}]},{"ID":"20260505170804-6gnjpbu","Type":"NodeParagraph","Properties":{"id":"20260505170804-6gnjpbu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"签名是把头部、载荷和服务器密钥，用头部指定的算法加密生成的，用来验证令牌没被篡改，这三部分拼起来就是完整的 JWT"}]},{"ID":"20260505170804-gbu2xp5","Type":"NodeParagraph","Properties":{"id":"20260505170804-gbu2xp5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总结"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Header：说明这是 JWT、用什么算法签名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Payload：真正的业务数据，用户信息、权限、过期时间都在这"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Signature：用来防篡改，保证没被人改过"}]},{"ID":"20260505170804-uqh67ri","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uqh67ri","updated":"20260511130647"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JWT 令牌为什么能解决集群部署？什么是集群部署？"}]},{"ID":"20260505170804-p1d9wqd","Type":"NodeParagraph","Properties":{"id":"20260505170804-p1d9wqd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"集群部署，就是多台服务器一起跑同一个服务，分担压力、提高可用性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统 Session 方案的问题是，会话信息存在单台服务器内存里，用户请求打到不同服务器，就会因为没 Session 要重新登录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就算用 Redis 共享 Session，也多了一层依赖，增加复杂度和性能开销"}]},{"ID":"20260505170804-y3r5yos","Type":"NodeParagraph","Properties":{"id":"20260505170804-y3r5yos","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"JWT 能解决这个问题，核心就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无状态、自包含"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"JWT 把所有身份信息都存在令牌里，服务器不用存会话，不管用户请求打到集群里哪台服务器，只要用密钥验证令牌合法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就能直接拿到用户信息，不用依赖共享存储，每台服务器都能独立处理请求"}]},{"ID":"20260505170804-cfa7yvh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cfa7yvh","updated":"20260511130649"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JWT 的缺点是什么？"}]},{"ID":"20260505170804-0indnu0","Type":"NodeParagraph","Properties":{"id":"20260505170804-0indnu0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"JWT 最大的缺点就是一旦签发，到期前无法主动撤销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不像 Session，服务器可以直接删会话让用户下线，JWT 只要没过期，就一直有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要是用户登出、改密码，令牌还能用，有安全风险"}]},{"ID":"20260505170804-o7x6b1o","Type":"NodeParagraph","Properties":{"id":"20260505170804-o7x6b1o","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加额外逻辑，最常用的就是黑名单机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 Redis 存失效的 JWT，每次请求先查黑名单，在黑名单里就拒绝访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但这又绕回了服务器存储，相当于牺牲了部分无状态的优势，而且黑名单要维护过期清理，不然会占内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外 JWT 本身是 Base64 编码，不是加密，载荷信息能被解码，绝对不能存密码这类敏感数据"}]},{"ID":"20260505170804-fiy2yls","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fiy2yls","updated":"20260511130651"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JWT 令牌如果泄露了，怎么解决？JWT 是怎么做的？"}]},{"ID":"20260505170804-tfkeyns","Type":"NodeParagraph","Properties":{"id":"20260505170804-tfkeyns","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"JWT 泄露的核心问题是，泄露的令牌没过期就能被冒用"}]},{"ID":"20260505170804-w7pjk3z","Type":"NodeParagraph","Properties":{"id":"20260505170804-w7pjk3z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"泄漏："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"JWT 泄漏通常是通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异常登录、异地访问、非正常业务"},{"Type":"NodeText","Data":"操作等行为发现的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如同一账号在陌生设备频繁请求、出现非本人操作，或是接口日志里出现大量异常调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦泄漏，他人可直接冒用身份访问接口，而 JWT 无法主动作废，只能依靠设置较短过期时间来降低风险"}]},{"ID":"20260505170804-x34bioi","Type":"NodeParagraph","Properties":{"id":"20260505170804-x34bioi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先最直接的就是及时失效令牌，用刚才说的黑名单，把泄露的令牌加入 Redis 黑名单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次请求先校验，直接拦截同时要缩短令牌有效期，就算泄露，也很快就失效，降低风险"}]},{"ID":"20260505170804-2fxoai3","Type":"NodeParagraph","Properties":{"id":"20260505170804-2fxoai3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后是刷新令牌机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给用户发两个令牌："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"短有效期的 Access Token 用来访问接口，长有效期的 Refresh Token 用来刷新 Access Token"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦 Access Token 泄露，它很快就过期，而且可以把 Refresh Token 拉黑，让用户没法刷新，强制重新登录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外还要配合 HTTPS 传输，防止令牌在传输过程中被截获，从源头减少泄露风险"}]},{"ID":"20260505170804-nt35siy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nt35siy","updated":"20260511130654"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"前端是如何存储 JWT 的？"}]},{"ID":"20260505170804-rxwcvsa","Type":"NodeParagraph","Properties":{"id":"20260505170804-rxwcvsa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LocalStorage（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"本地存储"},{"Type":"NodeText","Data":"） 存在本地，空间大，不会自动跟着请求发出去，也不容易弄脏日志"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但最怕 XSS 攻击，恶意脚本能直接把令牌偷走"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SessionStorage（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"会话存储"},{"Type":"NodeText","Data":"） 和它差不多，区别是只在当前页面有效，关掉页面就没了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"XSS 风险小一点，但是刷新页面或开新标签就要重新登录，体验不好"}]},{"ID":"20260505170804-us3wq5u","Type":"NodeParagraph","Properties":{"id":"20260505170804-us3wq5u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最安全稳妥的还是用带 HttpOnly 的 Cookie"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设置 HttpOnly （"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Cookie 的一个安全属性"},{"Type":"NodeText","Data":"）之后，JS 就没法读取，能有效防 XSS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再配上 Secure 只走 HTTPS、SameSite 防 CSRF，安全性最高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是 Cookie 只有 4KB 大小，而且每次请求都会自动带上，稍微影响一点性能，但正式项目基本都这么用"}]},{"ID":"20260505170804-2t192jh","Type":"NodeParagraph","Properties":{"id":"20260505170804-2t192jh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"XSS：跨站脚本攻击，攻击者往网页注入恶意 JS 代码，用来偷用户数据、偷登录令牌"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"JS 脚本就是浏览器里能跑的代码，用来控制网页内容、做交互、读数据"}]},{"ID":"20260505170804-clpgkrs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-clpgkrs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么保证 UDP 下帧与帧间的有序性？"}]},{"ID":"20260505170804-l3cqmh6","Type":"NodeParagraph","Properties":{"id":"20260505170804-l3cqmh6","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260309171420308"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260309171420308.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-nqrmq1o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nqrmq1o","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"滑动窗口"}]},{"ID":"20260505170804-8opcb3j","Type":"NodeParagraph","Properties":{"id":"20260505170804-8opcb3j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"发送窗口：可以发出去、但还没被确认的数据范围。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收窗口：接收方当前能收下的数据量。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方会根据接收方的窗口大小，动态调整自己发多少。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"窗口太大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：带宽利用高、发得快，适合网速好、延迟低的场景。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：网络差、丢包多时，没确认的数据堆太多，一丢就要重传一大片，容易更堵。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"窗口太小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：没确认的数据少，丢包重传压力小，网络更稳。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：网速好时也不敢多发，一直等确认，带宽用不满，速度上不去。"}]},{"ID":"20260505170804-9443e1s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9443e1s","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"tcp 流量控制？即我怎么决定发 100 个包还是 1k 个包"}]},{"ID":"20260505170804-k125evw","Type":"NodeParagraph","Properties":{"id":"20260505170804-k125evw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 流量控制，本质是接收端告诉发送端自己还能收多少数据"}]},{"ID":"20260505170804-tpymszx","Type":"NodeParagraph","Properties":{"id":"20260505170804-tpymszx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心靠滑动窗口 + 接收窗口 rwnd 实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收方每次返回 ACK 时，会带上自己剩余缓冲区大小，也就是接收窗口"}]},{"ID":"20260505170804-t2i3xkk","Type":"NodeParagraph","Properties":{"id":"20260505170804-t2i3xkk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"发 100 个包还是 1000 个包，逻辑很简单："}]},{"ID":"20260505170804-fgy6xan","Type":"NodeParagraph","Properties":{"id":"20260505170804-fgy6xan","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"发送方看接收窗口剩余容量，窗口能容纳多少字节，就最多发多少"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没收到新 ACK、窗口不更新，就不再多发，避免溢出"}]},{"ID":"20260505170804-mjyu022","Type":"NodeParagraph","Properties":{"id":"20260505170804-mjyu022","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"流量控制是端到端，管接收端能不能接住"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拥塞控制是全局网络，管路上会不会堵，两个不一样"}]},{"ID":"20260505170804-egewzt2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-egewzt2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 是如何实现可靠传输的?"}]},{"ID":"20260505170804-c5uvxgr","Type":"NodeParagraph","Properties":{"id":"20260505170804-c5uvxgr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"确认应答 + 超时重传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方发数据后等待接收方 ACK 确认，超时没收到就自动重传，解决数据丢失问题"}]},{"ID":"20260505170804-twfn7aa","Type":"NodeParagraph","Properties":{"id":"20260505170804-twfn7aa","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"序列号和确认号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给每个报文段编号，既能按顺序重组数据，又能剔除重复收到的冗余报文，解决乱序和重复问题"}]},{"ID":"20260505170804-rheprdp","Type":"NodeParagraph","Properties":{"id":"20260505170804-rheprdp","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滑动窗口机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"做流量控制，根据接收方接收能力调整发送速度，防止接收缓冲区溢出"}]},{"ID":"20260505170804-alsr09y","Type":"NodeParagraph","Properties":{"id":"20260505170804-alsr09y","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拥塞控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过慢启动、拥塞避免、快重传、快恢复四个算法，感知网络拥堵"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主动降低发送速率，避免网络拥塞导致丢包，从整体上保障传输可靠"}]},{"ID":"20260505170804-zzoghlo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zzoghlo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 首部长度范围\t\t\u003e\u003e"}]},{"ID":"20260505170804-llngpgl","Type":"NodeParagraph","Properties":{"id":"20260505170804-llngpgl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 首部长度字段占 4 位，表示以 4 字节为单位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最小值：5 ———首部长度 20 字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最大值：15 —— 首部长度 60 字节"}]},{"ID":"20260505170804-usqt0g5","Type":"NodeParagraph","Properties":{"id":"20260505170804-usqt0g5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多出来的那部分，是 TCP 选项字段，用来实现各种高级功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"剩下最多 40 字节全是选项，常用用途有这些："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MSS（最大报文段长度）告诉对方自己一次最多能收多大的 TCP 数据段，避免分片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"窗口扩大因子让滑动窗口从最大 65535 字节扩大到更大，提升高速网络传输效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时间戳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"计算更精准的 RTT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止序列号回绕，避免旧报文干扰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SACK（选择性确认）丢包时只重传真正丢失的段，不用全部重传，大幅提升丢包场景下的效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"NOP（空操作）用来填充对齐，保证选项总长度是 4 字节的整数倍"}]},{"ID":"20260505170804-5msbdjs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5msbdjs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 为何是字节流协议？UDP 为何是数据报协议？\t\u003e\u003e"}]},{"ID":"20260505170804-t1d8pxn","Type":"NodeParagraph","Properties":{"id":"20260505170804-t1d8pxn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 把传输的数据看作一串连续无边界的字节流，不保留消息之间的边界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送端可以分多次写，接收端也可以分多次读，TCP 只保证字节按顺序、完整到达，不关心这些字节原本是几条消息，所以需要应用层自己处理分包和粘包问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不保留消息边界，把数据当成连续字节处理，发送方可以根据当前网络拥塞情况、接收方窗口大小灵活拆分或合并数据，以尽可能填满窗口传输，避免小包过多导致效率低下"}]},{"ID":"20260505170804-qfwpzqm","Type":"NodeParagraph","Properties":{"id":"20260505170804-qfwpzqm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"UDP 则是数据报协议，它以独立的数据报为单位传输，一条数据报就是一个完整消息，有明确的边界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送端发一次，接收端就收一次，既不会拆包也不会合并，不会出现粘包问题，但是不保证有序、不保证一定送达，也不保证不重复"}]},{"ID":"20260505170804-ulp7kmz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ulp7kmz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"浏览器下可以进行 udp 操作吗?\t/webRTC"}]},{"ID":"20260505170804-pkrizx6","Type":"NodeParagraph","Properties":{"id":"20260505170804-pkrizx6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"浏览器普通网页环境不能直接原生操作 UDP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"出于安全沙箱和同源策略限制，浏览器只开放受控协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"沙箱管底层系统权限，同源策略，协议、域名、端口三者完全相同才叫同源，管网站之间互相访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"禁止网页直接创建底层 UDP 套接字，防止端口扫描、恶意发包等安全风险"}]},{"ID":"20260505170804-rbx99ys","Type":"NodeParagraph","Properties":{"id":"20260505170804-rbx99ys","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"只有特定受限环境可以用 UDP，比如 Chrome 插件能调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sockets.udp"},{"Type":"NodeText","Data":" 接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有部分浏览器实验性的隔离 Web 应用支持 UDPSocket"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但都不属于普通前端网页范畴，生产基本不用"}]},{"ID":"20260505170804-bwssg4o","Type":"NodeParagraph","Properties":{"id":"20260505170804-bwssg4o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实际开发里有两种主流替代方案："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是用 WebRTC DataChannel，底层基于 UDP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"低延迟、支持不可靠传输，适合实时音视频场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是 WebSocket 加后端 UDP 代理，前端走 WebSocket 连服务端，服务端转发 UDP 报文，适配所有浏览器，是对接 UDP 设备最常用的方案"}]},{"ID":"20260505170804-hjp48b0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hjp48b0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 滑动窗口中接收方的区域划分、指针数量"}]},{"ID":"20260505170804-o6xb8i5","Type":"NodeParagraph","Properties":{"id":"20260505170804-o6xb8i5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"接收方会把自己的缓冲区分成三块："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"已处理区"},{"Type":"NodeText","Data":"：数据已经被应用拿走，确认过，不用管。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"待处理区"},{"Type":"NodeText","Data":"：也就是窗口里的数据，要么已经收到但还没处理，要么还没收到但可以收。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不可接收区"},{"Type":"NodeText","Data":"：超出窗口范围，发过来也直接丢掉。"}]},{"ID":"20260505170804-mfcj7wj","Type":"NodeParagraph","Properties":{"id":"20260505170804-mfcj7wj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"靠"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"左右两个指针"},{"Type":"NodeText","Data":"来控制："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"左指针：标记已经处理完、可以确认的位置。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"右指针：标记最多还能收多少数据。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两个指针相减，就是当前接收窗口大小"}]},{"ID":"20260505170804-hcmrfh6","Type":"NodeParagraph","Properties":{"id":"20260505170804-hcmrfh6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"应用每处理完一批数据，左指针就往右滑，窗口跟着动，再告诉发送方现在还能发多少。"}]},{"ID":"20260505170804-9jv6ypl","Type":"NodeParagraph","Properties":{"id":"20260505170804-9jv6ypl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这样一边收、一边滑、一边确认，既可靠又不溢出。"}]},{"ID":"20260505170804-wwk6dvc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wwk6dvc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"粘包问题"}]},{"ID":"20260505170804-ak9jhtg","Type":"NodeParagraph","Properties":{"id":"20260505170804-ak9jhtg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"固定长度：简单快，但容易浪费或截断数据，适合简单、短报文场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特殊分隔符：用特殊符号表示包结束，很灵活，但内容里遇到符号要转义，适合文本协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长度字段：先告诉对方整个包总长度，必须等数据全部准备好才能发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分块传输：把数据切成小块，每块带长度，最后用 0 结束，支持流式传输，适合大文件、动态内容"}]},{"ID":"20260505170804-abe30j2","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-abe30j2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"http 如何解决粘包问题"}]},{"ID":"20260505170804-315bga0","Type":"NodeParagraph","Properties":{"id":"20260505170804-315bga0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"短连接：连接断开就算一包，靠断开当边界，不会粘。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长连接：第一种是先告诉对方数据总共有多大，收够长度就算一个完整包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二种是数据切成小块发，每块带长度，最后用 0 表示发完了"}]},{"ID":"20260505170804-rbkibna","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rbkibna","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"UDP 是如何实现广播和多播(组播)的"}]},{"ID":"20260505170804-pirz8fj","Type":"NodeParagraph","Properties":{"id":"20260505170804-pirz8fj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"UDP 无连接、不可靠的传输协议，它支持广播和多播，TCP 不支持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"广播就是发给同一网段内所有主机，UDP 直接使用广播地址（比如 255.255.255.255）作为目的 IP，数据包会被局域网内所有设备接收处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多播主要是依靠 IP 层的多播机制 + 和应用层加入多播组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先多播使用的是 D 类 IP 地址，范围是 224.0.0.0 到 239.255.255.255 这类地址不代表某一台主机，而是代表一个组。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方只需要把 UDP 数据包的目的 IP 设为这个多播地址，目的端口设为对应端口，直接发送出去就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收方想要收到这个数据，必须通过 IGMP 协议 主动加入这个多播组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路由器会维护多播组成员信息，只把多播包转发给确实加入了该组的主机，没加入的主机即使收到也会直接丢弃"}]},{"ID":"20260505170804-kyk5yn4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kyk5yn4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"两种广播地址\t\t\u003e\u003e"}]},{"ID":"20260505170804-xr6tyhu","Type":"NodeParagraph","Properties":{"id":"20260505170804-xr6tyhu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一种是有限广播地址 255.255.255.255，用于向当前本地网段内所有主机发送广播，路由器不会转发该数据包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另一种是直接广播地址，格式为网络号加全 1 的主机号，用于向指定目标网段内所有主机发送广播，默认情况下路由器也不转发，开启相关功能后可实现跨网段广播"}]},{"ID":"20260505170804-frrxu5c","Type":"NodeParagraph","Properties":{"id":"20260505170804-frrxu5c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有限广播地址 255.255.255.255，永远只在当前局域网内发送，路由器绝对不转发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接广播地址，就是把主机位全设为 1，比如 192.168.1.0/24 的广播地址是 192.168.1.255"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虽然理论上可以跨网段，但现实中路由器默认都会禁止转发，所以它也只能在本网段内使用"}]},{"ID":"20260505170804-fq7cx8x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fq7cx8x","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"绑定 0.0.0.0 和绑定 127.0.0.1 的区别是什么？"}]},{"ID":"20260505170804-984e4sw","Type":"NodeParagraph","Properties":{"id":"20260505170804-984e4sw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"绑定 0.0.0.0 表示监听本机所有可用的网卡 IP，不管是内网 IP、外网 IP 还是 127.0.0.1，只要访问这个端口，都能收到，相当于对外开放服务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"绑定 127.0.0.1 表示只监听本机回环地址，只有本机自己能访问，外部设备、其他主机完全连不进来，相当于只给本机内部用，不对外提供服务"}]},{"ID":"20260505170804-bohaz7w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bohaz7w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"半连接队列和全连接队列"}]},{"ID":"20260505170804-4iikspf","Type":"NodeParagraph","Properties":{"id":"20260505170804-4iikspf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用来管理还没建立好、以及已经建立好的连接。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端收到客户端的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SYN"},{"Type":"NodeText","Data":" 时，会回复 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SYN+ACK"},{"Type":"NodeText","Data":"，并把这个连接放到"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半连接队列"},{"Type":"NodeText","Data":"里。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时连接还只完成前两次握手，处于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"半连接状态"},{"Type":"NodeText","Data":"，还不能被应用层使用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"等客户端回复 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ACK"},{"Type":"NodeText","Data":"，三次握手全部完成，连接就从半连接队列移到"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全连接队列"},{"Type":"NodeText","Data":"。此时连接已经完全建立，等待应用程序调用 accept 来取走。"}]},{"ID":"20260505170804-8f63vt1","Type":"NodeParagraph","Properties":{"id":"20260505170804-8f63vt1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果没有半连接队列，服务端收到 SYN 后，没地方存这个连接，它既不能直接丢，又不能直接当成已完成连接，就会直接丢掉这个请求，连接根本建立不起来。"}]},{"ID":"20260505170804-s6mtbpz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-s6mtbpz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"拔掉网线 TCP 会断开连接吗\t\u003e\u003e"}]},{"ID":"20260505170804-bwyh27s","Type":"NodeParagraph","Properties":{"id":"20260505170804-bwyh27s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"拔掉网线并不会立刻断开 TCP 连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 本身没有实时感知物理链路状态的机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当网络中断时，双方不会立即收到通知，连接在协议层依然会保持已建立的状态"}]},{"ID":"20260505170804-f40peb7","Type":"NodeParagraph","Properties":{"id":"20260505170804-f40peb7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在没有心跳机制的情况下"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有当某一方发送数据，经过多次重传失败并超时后，才会判定连接断开"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果双方一直没有数据交互，这个 “假存活” 的连接会持续存在，无法及时感知掉线"}]},{"ID":"20260505170804-q8w07e3","Type":"NodeParagraph","Properties":{"id":"20260505170804-q8w07e3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果开启了应用层心跳机制，情况就完全不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过定时发送心跳包探测对端是否在线，一旦连续几次心跳无响应，就能快速判断连接失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"及时释放资源或触发重连，远比单纯依靠 TCP 自带的保活机制更灵敏、更可靠"}]},{"ID":"20260505170804-4xcjoba","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4xcjoba","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 在哪\t\t\u003e\u003e"}]},{"ID":"20260505170804-6elpwx3","Type":"NodeParagraph","Properties":{"id":"20260505170804-6elpwx3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 是在内核空间实现的，我们写代码时用的 socket、connect、send、recv 这些函数，其实都是用户态调用，真正的三次握手、滑动窗口、重传、拥塞控制这些核心逻辑，全都是操作系统内核在处理。应用程序只负责读写数据，不用关心底层怎么保证可靠，内核帮我们把这些复杂逻辑都封装好了，所以我们才能直接用简单的 API 完成网络通信"}]},{"ID":"20260505170804-batotm2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-batotm2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 的时间戳选项 (PAWS 机制) 如何解决序列号回绕问题？\t\t\u003e\u003e"}]},{"ID":"20260505170804-ohu58sl","Type":"NodeParagraph","Properties":{"id":"20260505170804-ohu58sl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 序列号是 32 位，传输数据量大时序列号会循环用完重新开始，也就是序列号回绕"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"旧的过期报文和新报文序列号一样，接收方无法区分，就会造成数据错乱"}]},{"ID":"20260505170804-716t4bh","Type":"NodeParagraph","Properties":{"id":"20260505170804-716t4bh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 时间戳 PAWS 机制，给每个报文带上发送时间戳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收方记录最近收到的有效时间戳，收到报文时先对比时间戳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时间戳更早的旧报文直接丢弃，不用再看序列号，从而解决序列号回绕导致的报文混淆问题"}]},{"ID":"20260505170804-r17d2rk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-r17d2rk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 连接超时时间的设置及优化？\t\u003e\u003e"}]},{"ID":"20260505170804-noz3dkn","Type":"NodeParagraph","Properties":{"id":"20260505170804-noz3dkn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 连接超时主要由内核 SYN 重传次数、重传超时时间控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"默认重试次数多、等待时间长，连接失败会阻塞很久"}]},{"ID":"20260505170804-qn2ozxj","Type":"NodeParagraph","Properties":{"id":"20260505170804-qn2ozxj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优化可以适当减小 SYN 重传次数、缩短 connect 超时时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开启快速重传快速恢复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时调小 tcp_fin_timeout、开启 syn cookies"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少无效等待，加快失败断开速度，提升网络响应效率"}]},{"ID":"20260505170804-oq22u25","Type":"NodeParagraph","Properties":{"id":"20260505170804-oq22u25","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"SYN Cookies 是 TCP "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防 SYN 洪水攻击"},{"Type":"NodeText","Data":"的机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器收到 SYN 请求后不立刻保存半连接资源，而是用加密算法生成 Cookie 序列号返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有客户端正确回复 ACK 完成握手，服务器才正式建立连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以此避免半连接耗尽服务器内存资源。"}]},{"ID":"20260505170804-9h028yv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9h028yv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 协议内核实现，包含传输控制块 TCB、拥塞控制算法底层实现\t\t\u003e\u003e"}]},{"ID":"20260505170804-x5tou9x","Type":"NodeParagraph","Properties":{"id":"20260505170804-x5tou9x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 在内核中为每个连接维护传输控制块 TCB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来保存连接状态、序列号、ACK 号、窗口大小、重传定时器、拥塞控制参数等所有连接信息"}]},{"ID":"20260505170804-f3s62c3","Type":"NodeParagraph","Properties":{"id":"20260505170804-f3s62c3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核通过 TCB 管理三次握手、四次挥手、重传机制、流量控制"}]},{"ID":"20260505170804-tszthgz","Type":"NodeParagraph","Properties":{"id":"20260505170804-tszthgz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"拥塞控制在内核底层基于 TCB 里的 cwnd 拥塞窗口、ssthresh 慢启动阈值实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分为慢启动、拥塞避免、快重传、快恢复四个阶段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"根据网络丢包、延迟动态调整发送速率，避免网络拥塞"}]},{"ID":"20260505170804-uejcnqh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uejcnqh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何解决服务端重启时端口已经占用的问题?\t\u003e\u003e"}]},{"ID":"20260505170804-2f94c37","Type":"NodeParagraph","Properties":{"id":"20260505170804-2f94c37","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 服务进程重启时,它会发起关闭连接的操作这个操作会经过四次挥于的过程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在四次挥手过程中,主动方会进入 TIME WAIT 状态,并且会在这个状态中停留大约 2MSL 的时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在这个时间内,这个四元组仍然被视为一个有效的组合,此时 bind()，就会返回 Address alreadyinuse 错误"}]},{"ID":"20260505170804-kzoyy4i","Type":"NodeParagraph","Properties":{"id":"20260505170804-kzoyy4i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"设置 SO_REUSEADDR(只在一个进程中有效)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"表示：这个端口我要复用，即使还有旧的 TIME_WAIT 连接也没关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样服务重启就能立刻绑定端口，不会报 Address already in use"}]},{"ID":"20260505170804-4311db8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4311db8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多个 TCP 服务可以绑定同一个端口吗?\t\t\u003e\u003e"}]},{"ID":"20260505170804-2fjyrnw","Type":"NodeParagraph","Properties":{"id":"20260505170804-2fjyrnw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以设置 SO_REUSEPORT(支持多个进程/线程共享同一端口)"}]},{"ID":"20260505170804-3i0i89q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3i0i89q","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是端口号？常见的端口号有哪些？"}]},{"ID":"20260505170804-3p8zgb8","Type":"NodeParagraph","Properties":{"id":"20260505170804-3p8zgb8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"端口号，就是用来区分同一台机器上不同服务的号码。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常见端口号："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1）HTTP (80)：用于 Web 浏览的超文本传输协议。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2）HTTPS (443)：用于安全 Web 浏览的超文本传输协议。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3）FTP (21)：用于文件传输协议。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4）SSH (22)：用于安全外壳协议。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5）DNS (53)：用于域名系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DHCP(客户端 68，服务端 67)"}]},{"ID":"20260505170804-m7qm94x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m7qm94x","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"端口有效范围是多少到多少？"}]},{"ID":"20260505170804-t118vg0","Type":"NodeParagraph","Properties":{"id":"20260505170804-t118vg0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"0～1023 是系统端口，给那些公认的服务用，比如 HTTP 80、HTTPS 443、FTP 21、SSH 22，一般我们自己不用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1024～49151 是用户端口，我们自己写的服务、部署的应用，基本都用这段。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"49152～65535 是动态端口，也叫临时端口，客户端发起连接时，系统会自动分配，用完就释放"}]},{"ID":"20260505170804-isx4rxu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-isx4rxu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么会出现端口耗尽？"}]},{"ID":"20260505170804-rz0peiu","Type":"NodeParagraph","Properties":{"id":"20260505170804-rz0peiu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"短连接建得太频繁，TIME_WAIT 太多，端口占着不释放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而系统能用的临时端口本来就不多，只有一万多个，很容易用光"}]},{"ID":"20260505170804-m0jjivb","Type":"NodeParagraph","Properties":{"id":"20260505170804-m0jjivb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优化："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让处于 TIME_WAIT 的端口赶紧复用给新连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"扩大临时端口范围，多分配一些可用端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缩短 TIME_WAIT 的超时时间，让端口更快释放"}]},{"ID":"20260505170804-my08i6y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-my08i6y","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"解释网络带宽的概念及其优化方法？"}]},{"ID":"20260505170804-algwcoz","Type":"NodeParagraph","Properties":{"id":"20260505170804-algwcoz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"指网络最大传输速率，单位 bps，带宽越大，传输能力越强。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优化：升级硬件与带宽、对数据进行压缩、通过负载均衡分散流量、利用缓存减少重复传输，同时做好流量控制避免拥塞"}]},{"ID":"20260505170804-m0r2rmi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m0r2rmi","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"本机向本机发送请求，IP 填 127.0.0.1 和网卡 ip 地址有区别吗？"}]},{"ID":"20260505170804-1ujodf5","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ujodf5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"127.0.0.1 是本地回环地址，数据包只在内核里走一圈，不经过物理网卡，速度快、不占外网带宽，一般用于本地测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网卡 IP 是本机真实 IP，数据包会经过物理网卡，走完整的网络协议栈，和访问外部机器的流程一样"}]},{"ID":"20260505170804-owngfiy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-owngfiy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 MTU？如何处理 MTU 的问题？"}]},{"ID":"20260505170804-pwluzg5","Type":"NodeParagraph","Properties":{"id":"20260505170804-pwluzg5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MTU 就是网络链路一次能传输的最大数据包大小，以太网默认 1500 字节。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MSS 是去掉 IP 头和 TCP 头后，真正能传的业务数据大小。1500-20-20"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据包超过 MTU 就会分片，分片容易丢包、效率低、还可能重组失败。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 PMTUD 自动探测路径 MTU，或者手动设置合理 MTU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也可以通过调整 MSS 避免大包超过限制"}]},{"ID":"20260505170804-votauzu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-votauzu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 分片，UDP 分片"}]},{"ID":"20260505170804-ejp5bgg","Type":"NodeParagraph","Properties":{"id":"20260505170804-ejp5bgg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"UDP 自身不处理分片，报文超过 MTU 时由 IP 层被动分片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UDP 无序号、确认与重传机制，分片独立传输，任意分片丢失则整包丢弃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上层无法感知也不会重传，乱序还会直接重组失败"}]},{"ID":"20260505170804-lohysxh","Type":"NodeParagraph","Properties":{"id":"20260505170804-lohysxh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 是传输层主动分段（MSS 控制），超出 MTU 才由 IP 分片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 报文自带序号确认，可靠面向连接，仅重传丢失分片 / 分段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自动处理乱序按序交付，上层无感知"}]},{"ID":"20260505170804-smfkr8o","Type":"NodeParagraph","Properties":{"id":"20260505170804-smfkr8o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"总结："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UDP=IP 被动分片，丢一则全丢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP = 传输层分段 + IP 分片，可靠按需重传有序"}]},{"ID":"20260505170804-xs3gaoa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xs3gaoa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IP 分片会导致 什么"}]},{"ID":"20260505170804-s5m7b58","Type":"NodeParagraph","Properties":{"id":"20260505170804-s5m7b58","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"IP 分片会造成分片乱序到达、重组失败，还会增加额外头部开销，浪费带宽"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UDP 下只要丢一个分片，整包数据就直接作废，UDP 不会感知也不会重传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 看不到底层 IP 分片，丢一个分片就会重传报文段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"产生大量无效重传，严重影响性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外很多防火墙会直接丢弃分片报文，进一步提高丢包概率"}]},{"ID":"20260505170804-l67dpk0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-l67dpk0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IP 分片是什么？为什么需要 IP 分片？"}]},{"ID":"20260505170804-4ns33fp","Type":"NodeParagraph","Properties":{"id":"20260505170804-4ns33fp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"IP 分片：将大于 MTU 的数据包分割成多个小包传输，在接收方重新组装成完整的数据包。"}]},{"ID":"20260505170804-xkjxjjz","Type":"NodeParagraph","Properties":{"id":"20260505170804-xkjxjjz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"需要 IP 分片的原因："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适应不同 MTU，不同网络设备可能有不同的 MTU，分片确保数据包能够通过所有网络设备。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免数据包丢弃，如果数据包过大而无法通过某个网络设备，分片可以避免数据包被丢弃。"}]},{"ID":"20260505170804-zi5i4wt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zi5i4wt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你了解 IP 分类和 IP 无分类地址吗\t\t\u003e\u003e"}]},{"ID":"20260505170804-2scybdg","Type":"NodeParagraph","Properties":{"id":"20260505170804-2scybdg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"IP 分类就是早期的有类别编址，把 IPv4 地址分成 A、B、C、D、E 五类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"A、B、C 类用于主机地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"D 类是组播，E 类保留"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分类地址里网络位和主机位是固定的，比如 A 类默认 8 位网络位，B 类 16 位，C 类 24 位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点是简单好记，缺点很明显，地址浪费严重"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个公司申请一个 B 类地址，会有大量 IP 闲置"}]},{"ID":"20260505170804-ydjq99w","Type":"NodeParagraph","Properties":{"id":"20260505170804-ydjq99w","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"无分类地址就是 CIDR，打破了固定分类的限制，不再按 A、B、C 类划分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是用子网掩码前缀灵活指定网络位长度，比如 /24、/16"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它支持可变长子网掩码，可以按需分配网段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"极大提高 IP 地址利用率，还能做路由聚合，减少路由表条目"}]},{"ID":"20260505170804-0529zvg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0529zvg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"NAT 原理与作用"}]},{"ID":"20260505170804-90sy1tc","Type":"NodeParagraph","Properties":{"id":"20260505170804-90sy1tc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"NAT 就是地址转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"家里、公司的设备，都是内网私有 IP，上不了互联网，得靠路由器把它换成公网 IP 才能上网"}]},{"ID":"20260505170804-ic4g9mk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ic4g9mk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内网设备发请求时，路由器会把它的内网 IP 藏起来，换成路由器自己的公网 IP，再发出去"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外面返回数据时，路由器再根据记录，把数据转回给内网那台设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"省公网 IP，一个公网 IP，能让一堆设备同时上网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全，外面看不到你内网真实地址，没法直接攻击你设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单方便，内网随便加设备，不用再申请新的公网 IP"}]},{"ID":"20260505170804-5odgogm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5odgogm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么解决 NAT 的缺点"}]},{"ID":"20260505170804-2molymn","Type":"NodeParagraph","Properties":{"id":"20260505170804-2molymn","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"NAT 核心缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"端到端通信破坏、内网主机无法被主动访问、四层端口资源有限、路由追踪失效、P2P 穿透难"}]},{"ID":"20260505170804-8c0f9pa","Type":"NodeParagraph","Properties":{"id":"20260505170804-8c0f9pa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"端到端通信破坏，核心意思：NAT 改写了 IP 和端口，把原本双方直连的身份和通路给打断了"}]},{"ID":"20260505170804-j1fq10u","Type":"NodeParagraph","Properties":{"id":"20260505170804-j1fq10u","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决思路"}]},{"ID":"20260505170804-t6znezr","Type":"NodeParagraph","Properties":{"id":"20260505170804-t6znezr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"部署公网 IPv6，从根源解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IPv6 地址充足，不用做地址转换，直接端到端可达"}]},{"ID":"20260505170804-xb7pkhx","Type":"NodeParagraph","Properties":{"id":"20260505170804-xb7pkhx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"端口映射 / 静态 NAT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在路由器上把公网端口固定映射到内网某台主机 IP + 端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外网就能主动访问内网服务，适合服务器、监控、业务服务发布，解决主动访问不通的问题"}]},{"ID":"20260505170804-rgdqgtz","Type":"NodeParagraph","Properties":{"id":"20260505170804-rgdqgtz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"NAT 穿透技术"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决 P2P 场景打不通的问题，常用 STUN 先获取外网映射地址和端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TURN 做中继转发，打不通就走中继"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有 UPnP 自动端口映射，设备自动向路由器申请开放端口，不用手动配置"}]},{"ID":"20260505170804-kqnkhwq","Type":"NodeParagraph","Properties":{"id":"20260505170804-kqnkhwq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"部署 DMZ 隔离区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把需要外网访问的服务器单独放 DMZ 区域"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"既解决外网主动访问，又隔离内网和外网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提升安全，避免内网直接暴露风险"}]},{"ID":"20260505170804-8aul32g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8aul32g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"NAT 模式和桥接模式"}]},{"ID":"20260505170804-qj8caod","Type":"NodeParagraph","Properties":{"id":"20260505170804-qj8caod","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"NAT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚拟机共享宿主机的 IP 上网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚拟机在内网里，外面访问不到它"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用占新 IP，配置简单，安全、省心"}]},{"ID":"20260505170804-peb4a43","Type":"NodeParagraph","Properties":{"id":"20260505170804-peb4a43","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"桥接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚拟机相当于独立一台机器，和宿主机在同一个局域网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚拟机会自己拿一个独立 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"局域网里其他电脑都能直接访问它"}]},{"ID":"20260505170804-aybt5c9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-aybt5c9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"LVS 的 NAT 和 DR 模式"}]},{"ID":"20260505170804-w691610","Type":"NodeParagraph","Properties":{"id":"20260505170804-w691610","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LVS 就是 Linux 上高性能的四层负载均衡，用来分流、扛高并发。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此 NAT 跟上面的不是一个，用于负载均衡转发用"}]},{"ID":"20260505170804-63looe5","Type":"NodeParagraph","Properties":{"id":"20260505170804-63looe5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"NAT 模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过地址转换实现负载均衡，客户端请求和服务器响应都经过负载均衡器，LVS 会修改数据包的源 IP 和目的 IP。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种模式配置简单，支持跨网段部署，对后端服务器没有特殊要求，但所有流量都经过 LVS，在高并发场景下容易成为性能瓶颈。"}]},{"ID":"20260505170804-spqdzq5","Type":"NodeParagraph","Properties":{"id":"20260505170804-spqdzq5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DR 模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"即直接路由模式，是生产里性能最高的模式。LVS 只修改目的 MAC 地址，不改变 IP 地址，请求经过负载均衡器，而响应包由后端服务器直接返回给客户端，不需要再经过 LVS。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它要求调度器和后端服务器在同一网段，需要配置 VIP 和抑制 ARP，但吞吐量极高，适合高并发大流量场景。"}]},{"ID":"20260505170804-0vg73lv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0vg73lv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"VIP 和抑制 ARP"}]},{"ID":"20260505170804-n7ouvxa","Type":"NodeParagraph","Properties":{"id":"20260505170804-n7ouvxa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"VIP 就是虚拟 IP，不是真实机器的 IP，集群对外的统一 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户访问的时候，只需要记这个 VIP 就行，不用管后面有多少台服务器，LVS 和后端服务器都会绑定这个 VIP，这样流量才能统一进 LVS、再分流"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抑制 ARP，DR 模式里 LVS 和后端都有同一个 VIP，要是不抑制 ARP，后端服务器就会抢着回应“这个 VIP 是我的”，流量就绕开 LVS 了"}]},{"ID":"20260505170804-v9puvna","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-v9puvna","updated":"20260518154844"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 ICMP 协议？它的作用是什么？"}]},{"ID":"20260505170804-ge5l3pj","Type":"NodeParagraph","Properties":{"id":"20260505170804-ge5l3pj","updated":"20260518154844"},"Children":[{"Type":"NodeText","Data":"ICMP 就是网络里的控制与报错协议，属于网络层，用来在设备之间传状态和错误信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用来做两件事："}]},{"ID":"20260505170804-k3kgf0c","Type":"NodeParagraph","Properties":{"id":"20260505170804-k3kgf0c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"报错："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络不通，通知网络不可达、数据包 TTL 超时，告诉你超时、数据包格式不对，报参数错误、路由器发现更好的路，发重定向让你换路"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来做网络诊断："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最典型的就是 ping，发一个探测包，对方回一个应答，用来测通不通、延迟多少"}]},{"ID":"20260505170804-vi54oh1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vi54oh1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IGMP 工作机制"}]},{"ID":"20260505170804-5956y4n","Type":"NodeParagraph","Properties":{"id":"20260505170804-5956y4n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"IGMP 是组播管理协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用是让路由器知道局域网里哪些主机想要接收哪个组播组的数据"}]},{"ID":"20260505170804-or1isx6","Type":"NodeParagraph","Properties":{"id":"20260505170804-or1isx6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主机想加入组播时，会向路由器发送加入报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"离开组播时发送离开报文"}]},{"ID":"20260505170804-dmcql2v","Type":"NodeParagraph","Properties":{"id":"20260505170804-dmcql2v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"路由器收到加入报文，就会把对应组播流转发到这个局域网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进入局域网后，不是单播发给每个主机，而是以组播广播形式在二层局域网内发送"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有之前加入该组播组的主机网卡才会接收，没加入的直接丢弃"}]},{"ID":"20260505170804-m0koebc","Type":"NodeParagraph","Properties":{"id":"20260505170804-m0koebc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"路由器还会周期性发送查询报文，探测网段内还有没有主机需要该组播"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没人回应就停止转发组播流量"}]},{"ID":"20260505170804-2mfu413","Type":"NodeParagraph","Properties":{"id":"20260505170804-2mfu413","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"整体工作模式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主机主动加入 / 退出，路由器周期性查询维护组成员关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只给有需求的网段下发组播数据，避免全网广播浪费带宽"}]},{"ID":"20260505170804-xz4m785","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xz4m785","updated":"20260518154948"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"PING 工作原理"}]},{"ID":"20260505170804-cn2uqnq","Type":"NodeParagraph","Properties":{"id":"20260505170804-cn2uqnq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"PING 是用来测试网络连通性和网络延迟的常用工具，它基于 ICMP 协议 工作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是互联网控制报文协议"}]},{"ID":"20260505170804-l37tapg","Type":"NodeParagraph","Properties":{"id":"20260505170804-l37tapg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工作过程大致分为三步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先，源主机会向目标 IP 发送 ICMP 回显请求报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包里会携带序号、时间戳和测试数据，用于后续计算时延和校验"}]},{"ID":"20260505170804-y8mlzuz","Type":"NodeParagraph","Properties":{"id":"20260505170804-y8mlzuz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"目标主机如果正常收到且没有被防火墙拦截"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就会原路返回一个 ICMP 回显应答报文，把收到的内容原样返回"}]},{"ID":"20260505170804-fsdogg9","Type":"NodeParagraph","Properties":{"id":"20260505170804-fsdogg9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当源主机收到应答后，通过对比发送和接收的时间戳，计算出 往返时延 RTT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时根据丢包情况判断网络是否通畅、是否稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个过程不需要 TCP 连接，属于无连接的探测机制"}]},{"ID":"20260505170804-716nv6p","Type":"NodeParagraph","Properties":{"id":"20260505170804-716nv6p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ping 基于网络层 ICMP 协议，无端口、无 TCP/UDP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过请求应答报文检测网络连通性与延迟"}]},{"ID":"20260505170804-0ftqhaq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0ftqhaq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ping 的底层"}]},{"ID":"20260505170804-4l1n1d3","Type":"NodeParagraph","Properties":{"id":"20260505170804-4l1n1d3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"PING 是用来测试网络连通性和网络延迟的常用工具，它基于 ICMP 协议 工作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是互联网控制报文协议"}]},{"ID":"20260505170804-ix6adaj","Type":"NodeParagraph","Properties":{"id":"20260505170804-ix6adaj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工作过程大致分为三步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先，源主机会向目标 IP 发送 ICMP 回显请求报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包里会携带序号、时间戳和测试数据，用于后续计算时延和校验"}]},{"ID":"20260505170804-c1pwdsz","Type":"NodeParagraph","Properties":{"id":"20260505170804-c1pwdsz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"目标主机如果正常收到且没有被防火墙拦截"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就会原路返回一个 ICMP 回显应答报文，把收到的内容原样返回"}]},{"ID":"20260505170804-mwo2llj","Type":"NodeParagraph","Properties":{"id":"20260505170804-mwo2llj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当源主机收到应答后，通过对比发送和接收的时间戳，计算出 往返时延 RTT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时根据丢包情况判断网络是否通畅、是否稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个过程不需要 TCP 连接，属于无连接的探测机制"}]},{"ID":"20260505170804-s1bhmzi","Type":"NodeParagraph","Properties":{"id":"20260505170804-s1bhmzi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ping 基于网络层 ICMP 协议，无端口、无 TCP/UDP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过请求应答报文检测网络连通性与延迟"}]},{"ID":"20260505170804-iqnbjsq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-iqnbjsq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ping 成功的话可以理解目标主机提供服务吗"}]},{"ID":"20260505170804-gn17coi","Type":"NodeParagraph","Properties":{"id":"20260505170804-gn17coi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ping 成功只能说明 IP 网络层链路是通的，三层 IP 可达"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但目标主机的端口没开放、服务没启动、防火墙拦截应用层、服务挂掉，ping 依然能通"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ping 只检测网络连通性，不检测 TCP 端口、不检测应用服务是否可用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能 ping 通 ≠ 服务能访问"}]},{"ID":"20260505170804-xk2phv5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xk2phv5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ping 会用到通信中的那些层"}]},{"ID":"20260505170804-veqwfqd","Type":"NodeParagraph","Properties":{"id":"20260505170804-veqwfqd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ping 用到物理层、数据链路层、网络层；不经过传输层和应用层，无端口"}]},{"ID":"20260505170804-ix1xdmw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ix1xdmw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ARP 攻击与防范"}]},{"ID":"20260505170804-65xuj41","Type":"NodeParagraph","Properties":{"id":"20260505170804-65xuj41","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ARP 攻击就是有人伪造 IP 和 MAC 地址对应关系，骗交换机或其他设备，把流量引到自己这里，用来窃听、断网。"}]},{"ID":"20260505170804-nt1j3ks","Type":"NodeParagraph","Properties":{"id":"20260505170804-nt1j3ks","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"防范："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 arpwatch 这类工具盯着 ARP 记录，发现同一个 IP 对应不同 MAC 地址就立刻报警拦截"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在交换机上开启端口安全，每个端口只允许一个 MAC 地址，超出就直接关闭端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还可以用入侵检测系统 NIDS 全局监控流量，发现异常 ARP 包直接拦住"}]},{"ID":"20260505170804-f0nd3g2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f0nd3g2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DHCP 动态主机配置协议"}]},{"ID":"20260505170804-utlx6qx","Type":"NodeParagraph","Properties":{"id":"20260505170804-utlx6qx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DHCP 就是自动给设备分配 IP 地址的协议。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"手机、电脑连上网，不用手动填 IP，它会自动拿到 IP、网关、DNS，直接就能上网，靠的就是 DHCP"}]},{"ID":"20260505170804-anlwbhn","Type":"NodeParagraph","Properties":{"id":"20260505170804-anlwbhn","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发现：DHCP Discover"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端刚上网，不知道 DHCP 服务器在哪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发广播包：谁是 DHCP？给我个 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DHCP Offer 提供"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器收到，单播 / 广播回复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给客户端预分配一个 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"告诉客户端：我可以给你这个 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"请求：DHCP Request"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端选一个 Offer"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发广播告诉服务器：我要这个 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时告诉其他服务器：你们的 IP 我不要了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"确认：DHCP ACK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器正式确认"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把 IP、掩码、网关、DNS、租期 发给客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端可以上网了"}]},{"ID":"20260505170804-d9085av","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d9085av","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IPv4 和 IPv6 的区别？"}]},{"ID":"20260505170804-n5cog0m","Type":"NodeTable","Data":"||IPv4|IPv6|\n| --------| ------------| ----------|\n|地址长度|32 位地址|128 位地址|\n|地址数量|地址耗尽|地址丰富|\n|安全性|无内置安全性|内置 IPsec|\n|NAT 需求|需 NAT 支持|无需 NAT|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-n5cog0m","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell"},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"IPv4"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"IPv6"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址长度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"32 位地址"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"128 位地址"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址数量"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址耗尽"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址丰富"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"安全性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无内置安全性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内置 IPsec"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"NAT 需求"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"需 NAT 支持"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无需 NAT"}]}]}]},{"ID":"20260505170804-qjjn5v1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qjjn5v1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"说一下 Linux 内核网络的连接队列？"}]},{"ID":"20260505170804-tf7n422","Type":"NodeParagraph","Properties":{"id":"20260505170804-tf7n422","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260309212304574"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260309212304574.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-xjifkoy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xjifkoy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"linux 内核收包流程？"}]},{"ID":"20260505170804-36360ga","Type":"NodeParagraph","Properties":{"id":"20260505170804-36360ga","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260318153956428"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260318153956428.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-zpy5o4p","Type":"NodeParagraph","Properties":{"id":"20260505170804-zpy5o4p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据包到达网卡 、DMA 写入内存 、硬中断通知 、 软中断收包 、 协议栈处理 、 放入 socket 队列 、 唤醒用户进程。"}]},{"ID":"20260505170804-xx5k8mm","Type":"NodeParagraph","Properties":{"id":"20260505170804-xx5k8mm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"硬中断是网卡给 CPU 发的通知，只做快速标记和调度软中断，不处理具体数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"软中断是内核异步执行的真正收包逻辑，负责从 RingBuffer 取包、封装 skb、走协议栈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分开是为了让硬中断更快，不阻塞系统，提升高并发下的网络性能"}]},{"ID":"20260505170804-p6nnntf","Type":"NodeParagraph","Properties":{"id":"20260505170804-p6nnntf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"硬中断：硬件喊 CPU，快救急，只干最急的事"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"软中断：内核自己安排，处理复杂耗时的活"}]},{"ID":"20260505170804-x8vlqkn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-x8vlqkn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"负载均衡"}]},{"ID":"20260505170804-lz1aewe","Type":"NodeParagraph","Properties":{"id":"20260505170804-lz1aewe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"负载均衡的核心作用，就是把大量的用户请求均匀地分发到后端多台服务器上，避免单台服务器压力过大，从而提高系统的并发能力、可用性和稳定性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"负载均衡=智能调度 + 状态共享"}]},{"ID":"20260505170804-z9s17kb","Type":"NodeParagraph","Properties":{"id":"20260505170804-z9s17kb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我理解负载均衡，一般从四层、七层、调度算法、健康检查，还有实际应用场景这几个方面来说。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先说"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"层级"},{"Type":"NodeText","Data":"，分四层和七层："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"四层是在传输层，只看 IP 和端口转发，速度快、性能高，比如 LVS；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"七层在应用层，能看 URL、请求头这些细节，能做更精细的路由，功能更强，比如 Nginx、HAProxy。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"调度算法"},{"Type":"NodeText","Data":"，常用的就是轮询、加权轮询、最少连接数、IP 哈希"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"根据业务选，比如要保持会话就用 IP 哈希，长连接多就用最少连接数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"健康检查"},{"Type":"NodeText","Data":"，这是保证高可用的关键，负载均衡器会定期查后端服务好不好，坏了就自动踢出去，修好了再加回来，不让请求发到故障的机器上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际项目里，我们一般用多层架构，外层用 LVS 或者云厂商的 SLB 做四层转发，内层用 Nginx 做七层路由、动静分离、卸 SSL，再把流量分到应用集群，外层 LVS 负责 “快”，内层 Nginx 负责 “细”，两层搭配，又能扛海量流量，又能做复杂控制，还高可用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总的来说"},{"Type":"NodeText","Data":"，负载均衡就是分布式系统的基础，靠分发流量、隔离故障、横向扩展，让系统能扛住大量访问。"}]},{"ID":"20260505170804-5kigk0d","Type":"NodeParagraph","Properties":{"id":"20260505170804-5kigk0d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"IP 哈希就是：根据客户端的 IP 地址，算一个固定值，让同一个 IP 永远落在同一台后端服务器上。"}]},{"ID":"20260505170804-e694iug","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e694iug","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 CDN？它的工作原理是什么？"}]},{"ID":"20260505170804-s5wp19e","Type":"NodeParagraph","Properties":{"id":"20260505170804-s5wp19e","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260309221538121"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260309221538121.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-2y27ads","Type":"NodeParagraph","Properties":{"id":"20260505170804-2y27ads","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 内容分发网络  是一种通过在全球范围内部署多个服务器节点，帮助用户更快速、更稳定地访问网站内容的技术。CDN 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主要目标是提高内容传输的速度和可靠性，减小服务器负载"},{"Type":"NodeText","Data":"，提升用户体验"}]},{"ID":"20260505170804-rnavdm4","Type":"NodeParagraph","Properties":{"id":"20260505170804-rnavdm4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优势"},{"Type":"NodeText","Data":"：加速内容传输(内容缓存到靠近用户的节点)、减轻源站负载(大量请求由 CDN 节点处理)、提高可用性(即使某些节点发生故障，其他节点仍可以继续提供服务)、安全性增强(提供 DDoS 攻击防护、WAF)、带宽优化"}]},{"ID":"20260505170804-a99sg9j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a99sg9j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"cdn"}]},{"ID":"20260505170804-ycz0wf0","Type":"NodeParagraph","Properties":{"id":"20260505170804-ycz0wf0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 即内容分发网络，它通过把静态资源缓存到遍布各地的边缘节点，使用户就近访问。用户请求时，CDN 通过智能调度分配最优节点，命中缓存就直接返回，不命中则回源拉取并缓存。它能"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加速访问、减轻源站压力、提升稳定性"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-l51gbqa","Type":"NodeParagraph","Properties":{"id":"20260505170804-l51gbqa","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存穿透"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"请求的数据根本不存在，缓存和后端都没有，每次都直接打到数据库，容易把库压垮。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：缓存空值、过滤非法请求、用 WAF 拦截。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存击穿"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个热点缓存突然过期，大量请求同时直接访问数据库，把库打挂。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：加互斥锁、热点数据永不过期、主动刷新。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存雪崩"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大量缓存同一时间失效，或缓存集群挂了，所有请求全都压到数据库，直接雪崩。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：过期时间加随机值、多级缓存、集群部署、限流降级。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"回源风暴"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多节点同时去源站拉同一个文件，把源站带宽 / CPU 打满。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：分层回源、资源预热、单文件只允许一个请求回源。"}]},{"ID":"20260505170804-kc3i1jx","Type":"NodeParagraph","Properties":{"id":"20260505170804-kc3i1jx","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CDN"},{"Type":"NodeText","Data":" 缓存规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态资源（图/JS/CSS）：长缓存（7-30 天）；动态接口/HTML：不缓存/短缓存；按后缀、路径配置，用 Cache-Control 控制。"}]},{"ID":"20260505170804-qtlhbi7","Type":"NodeParagraph","Properties":{"id":"20260505170804-qtlhbi7","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"提高缓存命中率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动静分离、静态资源加哈希指纹、长缓存 + 热点预热、合并小文件、避免 URL 带随机参数。"}]},{"ID":"20260505170804-uiewauj","Type":"NodeParagraph","Properties":{"id":"20260505170804-uiewauj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CDN"},{"Type":"NodeText","Data":" 实现 HTTPS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"控制台上传证书私钥，用户-CDN 走 HTTPS，CDN-源站可 HTTP/HTTPS；开启 TLS1.2/1.3 及会话复用，实现 HTTPS 卸载。"}]},{"ID":"20260505170804-fizbv0d","Type":"NodeParagraph","Properties":{"id":"20260505170804-fizbv0d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CDN"},{"Type":"NodeText","Data":" 调度原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于 GSLB 全局负载均衡，通过 DNS 解析，根据用户地域、运营商、节点负载/健康状态，调度至最优边缘节点。"}]},{"ID":"20260505170804-cbr00bp","Type":"NodeParagraph","Properties":{"id":"20260505170804-cbr00bp","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CDN"},{"Type":"NodeText","Data":" 与反向代理区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反向代理：单点/集群，侧重负载均衡、安全；CDN：分布式节点，侧重就近加速、跨地域传输优化。"}]},{"ID":"20260505170804-7uwe6pj","Type":"NodeParagraph","Properties":{"id":"20260505170804-7uwe6pj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CDN"},{"Type":"NodeText","Data":" 适用/不适用场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适用：静态资源、视频点播/直播、大文件下载；不适用：高频动态接口、高机密隐私数据。"}]},{"ID":"20260505170804-a72745n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a72745n","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"CDN 的核心工作原理是什么？什么类型的资源适合上 CDN？CDN 如何缓解源站压力？\t\u003e\u003e"}]},{"ID":"20260505170804-zdt11qt","Type":"NodeParagraph","Properties":{"id":"20260505170804-zdt11qt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 的核心工作原理，是把源站的静态资源缓存到分布在全国各地甚至全球的边缘节点上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当用户访问资源时，系统会根据用户的地理位置、网络状况，调度到最近、最优的边缘节点获取内容，而不是直接回源到中心服务器整个过程依靠智能调度、节点缓存、路由优化来实现加速"}]},{"ID":"20260505170804-7h9o81t","Type":"NodeParagraph","Properties":{"id":"20260505170804-7h9o81t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"适合放到 CDN 上的资源主要是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态不变或很少变化的内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如图片、CSS、JS 静态脚本、音频视频文件、安装包、文档、HTML 静态页面等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这类资源重复访问率高、体积大、更新频率低，能最大程度发挥缓存效益"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而接口数据、动态页面、用户个人信息这类频繁变化的动态内容，则不适合上 CDN"}]},{"ID":"20260505170804-1644djt","Type":"NodeParagraph","Properties":{"id":"20260505170804-1644djt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 缓解源站压力主要体现在三个方面："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是大量请求直接由边缘节点响应，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大幅减少回源请求量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是大文件、高并发流量被分散到各个节点，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"避免源站带宽和服务器被打满"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三是节点承担了大部分网络攻击和异常流量，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"源站只需要处理少量回源和动态请求"},{"Type":"NodeText","Data":"，整体负载显著降低，稳定性更强"}]},{"ID":"20260505170804-u5rfe3p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-u5rfe3p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"CDN 缓存策略\t\t\u003e\u003e"}]},{"ID":"20260505170804-a35vnze","Type":"NodeParagraph","Properties":{"id":"20260505170804-a35vnze","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 主要根据响应头缓存，比如 Cache-Control、Expires 控制缓存过期时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"资源未过期直接命中缓存返回，过期才回源站重新拉取更新"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时对动态内容不缓存、静态资源长期缓存，实现命中率最大化"}]},{"ID":"20260505170804-2nhq8ty","Type":"NodeParagraph","Properties":{"id":"20260505170804-2nhq8ty","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CDN 还有协商缓存策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"资源过期后不会直接回源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是带标识问源站：资源有没有更新，没更新就继续用缓存，更新了才重新下载"}]},{"ID":"20260505170804-a1vqxrc","Type":"NodeParagraph","Properties":{"id":"20260505170804-a1vqxrc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外还有强制缓存、缓存键规则、缓存刷新、缓存预热、忽略缓存策略"}]},{"ID":"20260505170804-cx53eo3","Type":"NodeParagraph","Properties":{"id":"20260505170804-cx53eo3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主流使用 LRU 最近最少使用淘汰算法，优先淘汰最长时间没被访问的资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"热门高频资源会一直保留，冷门过期资源优先清理，保证缓存命中率不会下降"}]},{"ID":"20260505170804-87qwz32","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-87qwz32","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"FEC 前向纠错码"}]},{"ID":"20260505170804-y9suvs3","Type":"NodeParagraph","Properties":{"id":"20260505170804-y9suvs3","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260309201338137"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260309201338137.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-cvz7fya","Type":"NodeParagraph","Properties":{"id":"20260505170804-cvz7fya","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"前向纠错码和信道编码是在传输信道可靠性不高、强噪声干扰信道中进行数据传输时，用来控制接收数据包误码率（丢包、乱码）的一项技术。"}]},{"ID":"20260505170804-mc2h4v8","Type":"NodeParagraph","Properties":{"id":"20260505170804-mc2h4v8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"发送端对一组原始数据包做线性编码，生成冗余校验包，和原始包一起发送；接收端只要收到足够数量的包（原始 + 冗余），就能通过数学计算还原出丢失的包，不需要重传，不等待确认，时延极低。"}]},{"ID":"20260505170804-52rpx35","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-52rpx35","updated":"20260517174625"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"WebRTC"}]},{"ID":"20260505170804-c1lt7gf","Type":"NodeParagraph","Properties":{"id":"20260505170804-c1lt7gf","updated":"20260517174429"},"Children":[{"Type":"NodeText","Data":"WebRTC 则是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"浏览器原生支持的实时音视频通信技术"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用来实现"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"端到端的视频通话、语音连麦、屏幕共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如网页版视频会议、直播连麦"}]},{"ID":"20260517174429-1aohh0m","Type":"NodeParagraph","Properties":{"id":"20260517174429-1aohh0m","updated":"20260517174440"},"Children":[{"Type":"NodeText","Data":"它不需要插件，支持 P2P 直连，延迟极低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心包括音视频采集、P2P 连接建立、NAT 穿透和实时传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和 WebSocket 不同，WebRTC 更专注"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"音视频流"},{"Type":"NodeText","Data":"，而 WebSocket 更适合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实时消息"}]},{"ID":"20260517174625-pr0rph9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517174625-pr0rph9","updated":"20260517174734"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"WebRTC 做 P2P 直连"}]},{"ID":"20260517174627-10fsu0s","Type":"NodeParagraph","Properties":{"id":"20260517174627-10fsu0s","updated":"20260517174641"},"Children":[{"Type":"NodeText","Data":"双方通过信令服务器交换 SDP，协商音视频编码、格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 ICE+STUN 获取公网地址，做 NAT 打洞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连通后音视频数据直接端到端传输，不走业务服务器"}]},{"ID":"20260517174727-z1tfjnk","Type":"NodeParagraph","Properties":{"id":"20260517174727-z1tfjnk","updated":"20260517174734"},"Children":[{"Type":"NodeText","Data":"(先靠信令服务器互相打个招呼，说好视频格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 STUN 服务器拿到各自的外网地址，突破家里 / 公司路由器限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两边直接连上，视频音频直接互相发，不经过中间服务器转发)"}]},{"ID":"20260505170804-pn5c5i3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-pn5c5i3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是防火墙？它的基本原理是什么？"}]},{"ID":"20260505170804-ywnjp1e","Type":"NodeParagraph","Properties":{"id":"20260505170804-ywnjp1e","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防火墙：用于监控和控制进出网络流量的安全设备"}]},{"ID":"20260505170804-d0xop2d","Type":"NodeParagraph","Properties":{"id":"20260505170804-d0xop2d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"包过滤防火墙：基于 IP 地址和端口的规则过滤数据包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"状态检测防火墙：跟踪每个连接的状态，根据状态进行过滤"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用层防火墙：对应用层数据进行深度检测和过滤"}]},{"ID":"20260505170804-4jfxs1k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4jfxs1k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 VPN？它是如何工作的？"}]},{"ID":"20260505170804-zvfyflv","Type":"NodeParagraph","Properties":{"id":"20260505170804-zvfyflv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"VPN（虚拟专用网络）是一种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通过公共网络（如互联网）建立加密连接的技术"},{"Type":"NodeText","Data":"，使用户能够"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在不安全的网络环境中安全地传输数据"},{"Type":"NodeText","Data":"，就像他们直接连接到一个私人网络一样。VPN 主要用于保护数据传输的隐私和安全，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"同时可以绕过地理限制和防火墙访问受限资源。"}]},{"ID":"20260505170804-hu8d90s","Type":"NodeParagraph","Properties":{"id":"20260505170804-hu8d90s","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"VPN 的主要功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1）隐私保护：VPN 加密用户的数据，并隐藏其真实 IP 地址，保护用户的隐私。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2）安全传输：通过加密隧道，确保数据在公共网络上传输时不会被窃听或篡改。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3）绕过限制：通过连接到不同国家的 VPN 服务器，用户可以访问被地理限制的内容。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4）远程访问：允许用户通过 VPN 安全地连接到企业内部网络，支持远程办公。"}]},{"ID":"20260505170804-rpsx51y","Type":"NodeParagraph","Properties":{"id":"20260505170804-rpsx51y","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"VPN 的工作原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"VPN 的工作原理可以简化为以下几个步骤："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1）建立连接：用户启动 VPN 客户端，并选择连接到特定的 VPN 服务器。客户端和服务器之间通过互联网建立初始连接。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2）隧道建立：客户端和服务器之间建立一个加密的隧道"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（把数据变成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乱码"},{"Type":"NodeText","Data":"；在原来的数据包外面，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"再包一层 IP 头"},{"Type":"NodeText","Data":"；在公网上走但全程"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加密、密封"},{"Type":"NodeText","Data":"，到达对端才拆开。）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3）数据加密：用户的数据在发送到公共网络之前，通过加密算法进行加密（如 AES）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加密后的数据通过加密隧道传输到 VPN 服务器。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4）数据传输和解密：VPN 服务器接收到加密的数据后进行解密，然后将数据发送到目标服务器。目标服务器返回的数据通过相同的路径反向传输，VPN 服务器加密数据并发送回 VPN 客户端，客户端解密数据后呈现给用户。"}]},{"ID":"20260505170804-gw0rh1a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-gw0rh1a","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"解释 FTP、SMTP、IMAP 和 POP3 的基本原理和应用场景？"}]},{"ID":"20260505170804-b6y4p54","Type":"NodeTable","Data":"|协议|基本原理|应用场景|\n| ----| ----------------------------------------------------------------------| --------------------------------|\n|FTP|用于在客户端和服务器之间传输文件，使用控制连接和数据连接。|文件上传下载、文件共享、数据备份|\n|SMTP|用于在电子邮件服务器之间传输电子邮件，使用简单文本命令和响应进行通信。|电子邮件发送、邮件中继|\n|IMAP|用于从邮件服务器读取电子邮件，允许多设备同步访问，邮件存储在服务器上。|多设备同步、服务器端存储|\n|POP3|用于从邮件服务器下载电子邮件，通常下载后会从服务器删除。|单设备访问、离线访问|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-b6y4p54","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"协议"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"基本原理"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"应用场景"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"FTP"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用于在客户端和服务器之间传输文件，使用控制连接和数据连接。"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"文件上传下载、文件共享、数据备份"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"SMTP"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用于在电子邮件服务器之间传输电子邮件，使用简单文本命令和响应进行通信。"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"电子邮件发送、邮件中继"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"IMAP"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用于从邮件服务器读取电子邮件，允许多设备同步访问，邮件存储在服务器上。"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多设备同步、服务器端存储"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"POP3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用于从邮件服务器下载电子邮件，通常下载后会从服务器删除。"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"单设备访问、离线访问"}]}]}]},{"ID":"20260505170804-yym4t93","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yym4t93","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常见的网络攻击方式有哪些？"}]},{"ID":"20260505170804-euvwztg","Type":"NodeParagraph","Properties":{"id":"20260505170804-euvwztg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DDoS 攻击：分布式拒绝服务攻击，通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大量请求使目标服务器无法正常服务。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间人攻击：攻击者"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"截获并篡改通信双方的数据"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SQL 注入：通过在输入字段中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"插入恶意 SQL 代码"},{"Type":"NodeText","Data":"，攻击数据库。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跨站脚本攻击（XSS）：在网页中注入恶意脚本代码，盗取用户信息。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跨站请求伪造（CSRF）：伪造用户请求，执行未授权操作。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"钓鱼攻击：伪装成可信网站或邮件，诱骗用户输入敏感信息。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缓冲区溢出：通过向应用程序输入超出其处理能力的数据，执行恶意代码。"}]},{"ID":"20260505170804-yuq3j2p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yuq3j2p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"中间人攻击\t\t\u003e\u003e"}]},{"ID":"20260505170804-et4axwu","Type":"NodeParagraph","Properties":{"id":"20260505170804-et4axwu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中间人攻击，简单说就是攻击者悄悄处在通信双方中间，截获、篡改甚至伪造双方的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而通信双方还以为自己是在直接对话"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如客户端和服务器本来要安全通信，结果数据先经过攻击者，他既可以偷看内容，也可以偷偷改掉数据再转发"}]},{"ID":"20260505170804-fqlxfmi","Type":"NodeParagraph","Properties":{"id":"20260505170804-fqlxfmi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常见的场景就是 HTTP 明文传输，或者没有正确校验证书的 HTTPS 通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"攻击者通过 ARP 欺骗、DNS 劫持、伪造热点等方式，让流量走到自己这里，然后实现窃听、会话劫持、插入恶意内容等攻击"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像平时用的 Fiddler 抓包，其实原理上就是一种合法的中间人代理"}]},{"ID":"20260505170804-568zf8y","Type":"NodeParagraph","Properties":{"id":"20260505170804-568zf8y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"防范中间人攻击最主要的方式就是使用 HTTPS，并严格校验证书，不跳过证书验证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时避免连接不安全的公共 Wi‑Fi，客户端做证书固定，服务端开启 HSTS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确保通信链路加密且不可篡改，这样即使流量被截获，攻击者也无法解密和伪造数据"}]},{"ID":"20260505170804-iritlvv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-iritlvv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"抓包原理\t\t\u003e\u003e"}]},{"ID":"20260505170804-6wa4t6u","Type":"NodeParagraph","Properties":{"id":"20260505170804-6wa4t6u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"抓包的核心原理，就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在网络通信的路径上插入一个代理程序，截获并转发数据包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以 Fiddler 这类 HTTP 抓包工具为例，它会在本地启动一个代理服务，默认监听 8888 端口，然后把系统的网络请求都指向这个代理"}]},{"ID":"20260505170804-1oq31az","Type":"NodeParagraph","Properties":{"id":"20260505170804-1oq31az","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当我们发起网络请求时，数据不会直接发给服务器，而是先发到抓包工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工具把请求内容完整记录下来，再原封不动转发给服务器；服务器返回响应时，同样先经过抓包工具，工具记录响应内容后再交给应用整个过程相当于一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"合法的中间人"},{"Type":"NodeText","Data":"，实现对流量的监听和查看"}]},{"ID":"20260505170804-8nz1j0o","Type":"NodeParagraph","Properties":{"id":"20260505170804-8nz1j0o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对于 HTTPS 加密流量，单纯拦截只能看到密文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时候抓包工具会通过安装根证书，和客户端、服务器分别建立加密通道，实现数据解密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样就能把加密内容转成明文展示，方便我们调试接口、查看参数和返回数据"}]},{"ID":"20260505170804-5v0vzg4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5v0vzg4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"子网掩码的作用？如何计算子网网络地址？\t\t\u003e\u003e"}]},{"ID":"20260505170804-ex0a0bn","Type":"NodeParagraph","Properties":{"id":"20260505170804-ex0a0bn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"子网掩码主要用来区分 IP 地址里网络部分和主机部分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"判断两台主机是不是在同一个局域网，同时也能用来划分子网、隔离广播域，避免网络混乱"}]},{"ID":"20260505170804-moz4goj","Type":"NodeParagraph","Properties":{"id":"20260505170804-moz4goj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"把 IP 地址和子网掩码二进制逐位做与运算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"得出的结果就是子网网络地址"}]},{"ID":"20260505170804-0g63sds","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0g63sds","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网关的作用？路由器和交换机的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-so9z4zd","Type":"NodeParagraph","Properties":{"id":"20260505170804-so9z4zd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"网关是不同网段之间数据出口，同一网段内主机不用网关"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跨网段访问外网、访问其他子网时，数据都要先发给网关转发，相当于局域网对外的大门"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主机把数据发给网关后，网关也就是路由器，会先判断目标地址是不是本地网段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果不是本地网段，路由器就查路由表，把数据包转发到下一跳，最终跨网段送到目标主机"}]},{"ID":"20260505170804-0t5km6o","Type":"NodeParagraph","Properties":{"id":"20260505170804-0t5km6o","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"路由器和交换机区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"交换机工作在二层，只能同网段内部转发数据、连接多台电脑组网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路由器工作在三层，可以跨网段转发、连接不同网络、自带网关功能、能上外网"}]},{"ID":"20260505170804-1g40d7h","Type":"NodeParagraph","Properties":{"id":"20260505170804-1g40d7h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"交换机工作在数据链路层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能连接同一个局域网里的电脑，负责内网设备之间互相转发数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不能跨网段、不能上网，只认识 MAC 地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设备之间互相传文件、局域网通信，都是交换机在工作"}]},{"ID":"20260505170804-nzcdxep","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nzcdxep","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是跨域？如何解决跨域问题 (CORS、JSONP)?\t\t\u003e\u003e"}]},{"ID":"20260505170804-g8hmq4s","Type":"NodeParagraph","Properties":{"id":"20260505170804-g8hmq4s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"跨域是浏览器的同源策略限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当协议、域名、端口任意一个不同时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器不允许当前页面请求另一个地址的数据，目的是安全防盗刷、防窃取信息"}]},{"ID":"20260505170804-ubwfwfk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ubwfwfk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最常用的是 CORS 跨域资源共享，由后端配置响应头"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"允许指定前端域名访问，安全且支持所有请求方式"}]},{"ID":"20260505170804-94yqgsy","Type":"NodeParagraph","Properties":{"id":"20260505170804-94yqgsy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次是 JSONP，利用 script 标签不受同源限制的特点发送 GET 请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点简单兼容好，但只支持 GET 请求，安全性差"}]},{"ID":"20260505170804-3u7blp5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3u7blp5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"grpc"}]},{"ID":"20260505170804-84yv3wb","Type":"NodeParagraph","Properties":{"id":"20260505170804-84yv3wb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"gRPC 是谷歌开源、基于 HTTP/2 + Protobuf 的高性能跨语言 RPC 框架，微服务常用"}]},{"ID":"20260505170804-7p72h7d","Type":"NodeParagraph","Properties":{"id":"20260505170804-7p72h7d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 Protobuf 定义接口和数据，编译生成多语言代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层走 HTTP/2，二进制序列化，代替 JSON 文本通信"}]},{"ID":"20260505170804-283cdhu","Type":"NodeParagraph","Properties":{"id":"20260505170804-283cdhu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四种调用模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通一对一、服务端流、客户端流、双向流式 RPC"}]},{"ID":"20260505170804-izgg2yw","Type":"NodeParagraph","Properties":{"id":"20260505170804-izgg2yw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"比 REST 好在哪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二进制体积小、速度快；强类型编译校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP/2 多路复用、头部压缩"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原生支持流式通信，适合微服务和实时场景"}]},{"ID":"20260505170804-5370fqg","Type":"NodeParagraph","Properties":{"id":"20260505170804-5370fqg","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"适用场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"微服务内部调用、跨语言服务通信、IoT 设备上报、实时流传输、AI 推理流式调用"}]},{"ID":"20260505170804-jv5nqtx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jv5nqtx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网络通信常见名词"}]},{"ID":"20260505170804-pfeidum","Type":"NodeParagraph","Properties":{"id":"20260505170804-pfeidum","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"基础通用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IP：设备网络唯一逻辑地址，负责跨网段通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"端口：区分电脑上不同程序的入口，范围 0–65535"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MAC：网卡物理硬件地址，局域网内设备通信标识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网关：内网访问外网的出口转发设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子网掩码：划分 IP 的网络位和主机位，判断是否同网段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DNS：域名解析系统，把域名转为 IP 地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DHCP：自动给设备分配 IP、网关、DNS，无需手动配置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"NAT：网络地址转换，内网 IP 转为公网 IP，节省公网地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"局域网 LAN：小范围本地网络（家里、公司内网）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"广域网 WAN：大范围跨区域网络，即互联网"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TTL：数据包生存时间，限制转发次数，防止路由环路"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ARP：IP 地址解析为 MAC 地址，局域网通信必备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ICMP：网络探测协议，ping、tracert 底层依赖它"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单播：一对一传输；广播：发给全网段所有设备；组播：发给指定一组设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路由：跨网段数据包转发路径选择"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路由环路：数据包在路由器之间循环转发，导致网络瘫痪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"传输层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP：面向连接、可靠、有序、有重传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UDP：无连接、不可靠、速度快，适合直播、游戏、语音"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RTT：数据往返一次的时间，网络延迟核心指标"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RTO：重传超时时间，超时没收到 ACK 就重传报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SYN/ACK/FIN/RST：TCP 控制标志位，用于建连、断连、异常重置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RST 是复位、强制断开连接的标识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"应用层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP：超文本传输协议，明文传输，不安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTPS：HTTP+SSL/TLS 加密，安全加密传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Cookie：存在客户端，记录用户临时信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Session：存在服务端，保存用户会话数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Token：令牌，无状态身份验证，常用于前后端分离"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SSL/TLS：加密传输协议，保障数据防窃听、防篡改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CA 证书：证明网站身份合法，防止中间人攻击"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正向代理：代理客户端（翻墙、访问外网）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反向代理：代理服务端（nginx、负载均衡）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CDN：内容分发网络，就近访问，加速静态资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防火墙：隔离内外网，过滤恶意流量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DDoS：分布式拒绝服务，海量请求打垮服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对称加密：加密解密用同一个密钥，速度快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非对称加密：公钥加密、私钥解密，安全性高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哈希算法：单向不可逆，用于数据完整性校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间人攻击：拦截篡改双方传输数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高可用 \u0026 容灾运维"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RTO：故障后业务恢复的时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RPO：故障后允许丢失的数据量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"负载均衡：流量分给多台服务器，提升并发与容错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"集群：多台服务器协同工作，提高可用性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络性能指标"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"带宽：单位时间最大传输数据量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"吞吐量：实际稳定传输的数据量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时延：数据传输耗时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"丢包率：传输中丢失数据包比例。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络抖动：延迟忽高忽低，影响音视频、游戏。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"QPS：每秒请求数，服务器并发核心指标"}]},{"ID":"20260505170804-x59uxk0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-x59uxk0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"send+epoll"}]},{"ID":"20260505170804-a7o7cl0","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-a7o7cl0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么网络通信中不能直接发送带指针的结构体？"}]},{"ID":"20260505170804-0vk1oze","Type":"NodeParagraph","Properties":{"id":"20260505170804-0vk1oze","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因为网络传输的是实际数据内容，不是内存地址。指针本质是内存地址，发送结构体时，只会把地址值发过去，不会把指针指向的数据发过去。接收方拿到这个地址在自己进程里是无效的，会导致乱码或程序崩溃。"}]},{"ID":"20260505170804-amcnujv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-amcnujv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"send 和 epoll 为什么要配合使用？核心是什么？"}]},{"ID":"20260505170804-mjhpiga","Type":"NodeParagraph","Properties":{"id":"20260505170804-mjhpiga","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"send 是发送数据的系统调用，epoll 是 IO 多路复用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：用 epoll 监听 socket 的可写事件（EPOLLOUT），让非阻塞的 send 只在缓冲区有空时才发送数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样既不阻塞线程，也不会空轮询浪费 CPU，是高并发网络模型的关键"}]},{"ID":"20260505170804-tyzn366","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-tyzn366","updated":"20260516133944"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么不能一直监听 EPOLLOUT？"}]},{"ID":"20260505170804-bm7ljri","Type":"NodeParagraph","Properties":{"id":"20260505170804-bm7ljri","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果一直监听 EPOLLOUT，只要发送缓冲区有空闲，epoll 就会不断触发事件，导致 CPU 空转。正确做法：只有 send 发送失败返回 EAGAIN 时，才临时监听 EPOLLOUT；数据发完就立即移除监听，这样效率最高。"}]},{"ID":"20260516133944-twxrk9j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516133944-twxrk9j","updated":"20260516135105"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是微服务"}]},{"ID":"20260516133944-vxwj24j","Type":"NodeParagraph","Properties":{"id":"20260516133944-vxwj24j","updated":"20260516133858"},"Children":[{"Type":"NodeText","Data":"微服务简单来说，就是把传统的单体应用，拆分成多个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"职责单一、独立运行"},{"Type":"NodeText","Data":"的小型服务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个服务只负责一块业务，比如用户、订单、支付，独立开发、独立部署、独立扩容"}]},{"ID":"20260516133944-fic27fz","Type":"NodeParagraph","Properties":{"id":"20260516133944-fic27fz","updated":"20260516133915"},"Children":[{"Type":"NodeText","Data":"服务之间通过 RPC 或者 HTTP 通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"配合注册中心、网关、熔断降级这些组件，实现分布式协作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比单体架构，它解耦性更好，方便团队并行开发，也能针对高压力模块单独扩容"}]},{"ID":"20260516133944-5ua5n27","Type":"NodeParagraph","Properties":{"id":"20260516133944-5ua5n27","updated":"20260516133921"},"Children":[{"Type":"NodeText","Data":"但微服务也会带来复杂度提升"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如网络调用、分布式事务、服务治理等问题，需要配套的中间件和架构方案来解决"}]},{"ID":"20260516135105-utcj14n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516135105-utcj14n","updated":"20260517195950"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么有 HTTP 协议了?还要用 RPC"}]},{"ID":"20260516135105-uqjiau0","Type":"NodeParagraph","Properties":{"id":"20260516135105-uqjiau0","updated":"20260516134112"},"Children":[{"Type":"NodeText","Data":"HTTP 和 RPC 解决的问题层次不一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"HTTP 更像一种通用通信协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RPC 更像一种“像掉本地函数一样调远程服务”的调用方式"}]},{"ID":"20260516135105-bivp2lt","Type":"NodeParagraph","Properties":{"id":"20260516135105-bivp2lt","updated":"20260516134341"},"Children":[{"Type":"NodeText","Data":"HTTP 的优点是通用、标准化、跨语言、生态成熟，特别适合对外接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如浏览器访问、开放平台、前后端交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但如果放在内部服务调用场景，它就不一定是最优的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它通常更偏“传输协议”层面，接口语义、序列化方式、服务发现、超时重试这些能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多都要自己补"}]},{"ID":"20260516135105-flkcehw","Type":"NodeParagraph","Properties":{"id":"20260516135105-flkcehw","updated":"20260516135029"},"Children":[{"Type":"NodeText","Data":"RPC 更适合微服务内部调用，原因主要有三点："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调用抽象更好：开发时更像在调本地方法，效率高，接口管理也更清晰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"性能通常更好：可以配合二进制序列化、长连接、多路复用，开销比传统 HTTP+JSON 更小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"治理能力更强：很多 RPC 框架自带服务注册发现、负载均衡、限流、熔断、超时控制这些能力"}]},{"ID":"20260516135105-b5bmlmq","Type":"NodeParagraph","Properties":{"id":"20260516135105-b5bmlmq","updated":"20260516135048"},"Children":[{"Type":"NodeText","Data":"所以不是有了 HTTP 就不需要 RPC，而是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对外开放、强调通用性，常用 HTTP；服务内部调用、强调性能和治理，常用 RPC"}]},{"ID":"20260517195955-0he6h45","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517195955-0he6h45","updated":"20260517200001"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"seq 是随机的还是固定的，为什么"}]},{"ID":"20260517195956-lxc9h9l","Type":"NodeParagraph","Properties":{"id":"20260517195956-lxc9h9l","updated":"20260517200001"},"Children":[{"Type":"NodeText","Data":"seq 不是固定的，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"初始序列号 ISN 一般是近似随机/时间相关生成的"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原因主要有两个："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，避免历史连接中的旧报文被误认为是当前连接的数据；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二，提高安全性，降低被预测和伪造报文的风险。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以它不是随便设，而是为了 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"连接隔离和安全性"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-u07mzju","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-u07mzju","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"三阶段"}]},{"ID":"20260505170804-ickw5r3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ickw5r3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"协议 protocol:双方规定好的，数据在网络传输中需要遵守协议"}]},{"ID":"20260505170804-pt4pmci","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-pt4pmci","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"七层网络模型：物理层，数据链路层，网络层，传输层，会话层，表示层，应用层"}]},{"ID":"20260505170804-eiin8lb","Type":"NodeParagraph","Properties":{"id":"20260505170804-eiin8lb","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251115101945296"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:\\Users\\zhanr\\AppData\\Roaming\\Typora\\typora-user-images\\image-20251115101945296.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-t87kdn2","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-t87kdn2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"应用层"}]},{"ID":"20260505170804-ufd625i","Type":"NodeParagraph","Properties":{"id":"20260505170804-ufd625i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"提供应用程序进行数据传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP/HTTPS 协议："},{"Type":"NodeText","Data":"浏览器使用的协议 \tHTTPS 中的 S 是 SSL 加密，更安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"FTP 协议："},{"Type":"NodeText","Data":"文件传输协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DNS 协议:"},{"Type":"NodeText","Data":"域名解析协议  域名：俗称网址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DHCP 协议："},{"Type":"NodeText","Data":"动态获取网络配置  自动分配 IP"}]},{"ID":"20260505170804-82wkmf4","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-82wkmf4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"表示层"}]},{"ID":"20260505170804-s9aulof","Type":"NodeParagraph","Properties":{"id":"20260505170804-s9aulof","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据加解密\t数据解压缩\t图片/视频编解码"}]},{"ID":"20260505170804-rsn5i38","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-rsn5i38","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"会话层"}]},{"ID":"20260505170804-hfkf0yr","Type":"NodeParagraph","Properties":{"id":"20260505170804-hfkf0yr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"session 会话管理\t服务器验证用户登录\t断点续传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"session 会话管理：Session 是服务器通过 Session ID（通常存于客户端 Cookie）关联用户跨请求状态、解决 HTTP 无状态问题的会话管理机制。 \t例：跳转网页时不需要重新登录"}]},{"ID":"20260505170804-a46rd8h","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-a46rd8h","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"传输层"}]},{"ID":"20260505170804-2ag2bqx","Type":"NodeParagraph","Properties":{"id":"20260505170804-2ag2bqx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"操作系统提供的，用户需要告诉操作系统用哪一个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP\tUDP\t线程\t端口\tsocket"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"端口号："},{"Type":"NodeText","Data":"一个端口号只能被一个应用程序绑定 一个应用程序能绑定多个端口号。\tIP 决定数据到达设备 端口号决定数据到达应用程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"socket:"},{"Type":"NodeText","Data":"套接字，是通信的基石，是支持 TCP/IP 协议的网络通信包含进行网络通信必须的五种信息："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连接使用的协议，本地主机的 IP 地址，本地进程的协议端口，远地主机的 IP 地址，远地进程的协议端口"}]},{"ID":"20260505170804-o83sstl","Type":"NodeParagraph","Properties":{"id":"20260505170804-o83sstl","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TCP:"},{"Type":"NodeText","Data":"面向连接，可靠的，基于字节流的\t需要数据稳定性和可靠性比较高的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"UDP："},{"Type":"NodeText","Data":"无连接的，高效率，低可靠性的数据传输服务\t需要数据时效性比较高的场景多使用 UDP 协议"}]},{"ID":"20260505170804-k3kg2ap","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-k3kg2ap","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"网络层"}]},{"ID":"20260505170804-8zjo7ia","Type":"NodeParagraph","Properties":{"id":"20260505170804-8zjo7ia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ARP\tRARP\tIP  防火墙\t路由器(通过网络地址)"}]},{"ID":"20260505170804-m3nncpw","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-m3nncpw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"数据链路层"}]},{"ID":"20260505170804-7rq2xw2","Type":"NodeParagraph","Properties":{"id":"20260505170804-7rq2xw2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"网卡  MAC 地址(物理地址)\t交换机(通过物理地址)"}]},{"ID":"20260505170804-qvd7e58","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-qvd7e58","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"物理层"}]},{"ID":"20260505170804-fw0rpkd","Type":"NodeParagraph","Properties":{"id":"20260505170804-fw0rpkd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"把数字信号转换成电信号和光信号\t网线和光缆"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251115112305747"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251115112305747.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4ztyynv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4ztyynv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"C/S 架构对比 B/S"}]},{"ID":"20260505170804-gqx2qd7","Type":"NodeParagraph","Properties":{"id":"20260505170804-gqx2qd7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C/S:客户端 服务器\t\t1.每一个应用程序有自己独立专门的客户端\t2.客户端，服务端可以使用任意的网络传输协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"B/S:浏览器 服务器\t\t1.客户端不固定，使用任何一款浏览器\t\t\t2.协议固定\thttp/https"}]},{"ID":"20260505170804-nvvfr7x","Type":"NodeParagraph","Properties":{"id":"20260505170804-nvvfr7x","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251115134709972"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251115134709972.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-tx6pkhm","Type":"NodeParagraph","Properties":{"id":"20260505170804-tx6pkhm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加载库\t创建套接字\t绑定 IP 和端口号\t接消息：recvfrom()\t回消息：sendto()\t关闭套接字\t卸载库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"绑定 IP 和端口号：为了让操作系统知道当前进程使用的是哪个 ip 和端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端先接收消息"}]},{"ID":"20260505170804-spyocky","Type":"NodeParagraph","Properties":{"id":"20260505170804-spyocky","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"静态库"},{"Type":"NodeText","Data":"：编译链接时，库代码直接拷贝到程序中，运行时不依赖外部文件，体积大、更新需重编译，独立可运行。在可执行文件中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动态库"},{"Type":"NodeText","Data":"：编译链接仅记录依赖，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"运行时由系统加载到内存共享"},{"Type":"NodeText","Data":"，体积小更新无需重编程序，依赖库文件存在才能运行。不在可执行文件中"}]},{"ID":"20260505170804-4c8p6oi","Type":"NodeParagraph","Properties":{"id":"20260505170804-4c8p6oi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"静态库的优点：移动或分享时只移动可执行文件即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态库的缺点：移动和分享的时候不仅需要提供可执行文件还需要提供 dll\t执行效率会比静态库慢一些"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态库的优点：如果库里代码进行修改不需要重新编译可执行文件，用户重新下载新的动态库的包就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多个可执行文件依赖一个动态库的时候，只需要内存中拷贝一份动态库"}]},{"ID":"20260505170804-wxwq6r4","Type":"NodeParagraph","Properties":{"id":"20260505170804-wxwq6r4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用静态库的步骤：1.包含头文件\t2.导入依赖库 "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"pragma"},{"Type":"NodeText","Data":" comment"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用动态库的步骤：1.包含头文件\t2.导入依赖库 (链接库.lib)#pragma comment\t3.dll 拷贝到 exe 相同路径下"}]},{"ID":"20260505170804-h8m6ar7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-h8m6ar7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"UDP Server"}]},{"ID":"20260505170804-ze8kc0c","Type":"NodeParagraph","Properties":{"id":"20260505170804-ze8kc0c","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sockaddr"},{"Type":"NodeText","Data":" 是通用地址接口，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sockaddr_in"},{"Type":"NodeText","Data":" 是 IPv4 专用地址结构，强转是为了： 1. 统一 socket 函数（bind/connect 等）的参数类型； 2. 兼容 IPv4/IPv6 等多种地址类型，靠结构中地址族字段区分解析。"}]},{"ID":"20260505170804-ua7hq5n","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ua7hq5n","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#define _WINSOCK_DEPRECATED_NO_WARNINGS\n#include\u003ciostream\u003e\nusing namespace std;\n#include\u003cWinSock2.h\u003e\n//导入依赖库\n#pragma comment(lib,\"Ws2_32.lib\")\nint main() {\n\t//1.加载库\n\tWORD version = MAKEWORD(2,2);\n\tWSADATA data = {};\n\tint err=WSAStartup(version, \u0026data);\n\tif (err != 0) {\n\t\tcout \u003c\u003c \"WSAStartup error\" \u003c\u003c endl;\n\t\treturn 1;\n\t}\n\t\t//判断加载成功的库的版本号是否正确（因为加载上来的版本号可能不是2，2）\n\tif (HIBYTE(data.wVersion)==2\u0026\u0026LOBYTE(data.wVersion)==2) {\n\t\tcout \u003c\u003c \"WSAStartup success\" \u003c\u003c endl;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"WSAStartup version error\" \u003c\u003c endl;\n\t\treturn 1;\n\t}\n\t//2.创建套接字\n\tSOCKET sock= socket(AF_INET/*address family IPV4*/,SOCK_DGRAM/*socket类型 UDP*/,IPPROTO_UDP/*协议类型*/);\n\tif (INVALID_SOCKET==sock) {\n\t\tcout \u003c\u003c \"socket fail:\" \u003c\u003cWSAGetLastError\u003c\u003c endl;\n\t\t//卸载库\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"socket success\" \u003c\u003c endl;\n\t}\n\t//3.绑定ip和端口\n\tsockaddr_in addr;\n\taddr.sin_family = AF_INET;\t//ip地址类型\n\taddr.sin_port = htons(34567);\t\t//大端小端,网络字节序（大端），PC是小端存储，需要转换成网络字节序\n\taddr.sin_addr.S_un.S_addr = INADDR_ANY;\t//绑定所有网卡\n\terr = bind(sock,(sockaddr*) \u0026 addr,sizeof(addr));\n\tif (SOCKET_ERROR==err) {\n\t\tcout \u003c\u003c \"bind fail:\" \u003c\u003c WSAGetLastError \u003c\u003c endl;\n\t\t//关闭套接字\n\t\tclosesocket(sock);\n\t\t//卸载库\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"bind success\" \u003c\u003c endl;\n\t}\n\twhile (true) {\n\t\tchar recvBuf[4096] = \"\";\n\t\tchar sendBuf[4096] = \"\";\n\t\t//对端的地址信息\n\t\tsockaddr_in addrClient = {};\t//输出参数不用赋初值\n\t\tint size = sizeof(addrClient);\n\t\tint nRecvNum = 0;\n\t\tint nSendNum = 0;\n\t\twhile (true) {\n\t\t\t//4.接收数据\n\t\t\tnRecvNum=recvfrom(sock, recvBuf, sizeof(recvBuf), 0, (sockaddr*)\u0026addrClient, \u0026size);\n\t\t\tif (nRecvNum \u003e 0) {\n\t\t\t\t//接收成功，打印接收到的数据和对端的ip\n\t\t\t\tcout \u003c\u003c inet_ntoa(addrClient.sin_addr)\u003c\u003c \":\" \u003c\u003crecvBuf\u003c\u003c endl;\n\t\t\t}\n\t\t\telse {\n\t\t\t\tcout \u003c\u003c \"recvfrom error\" \u003c\u003c endl;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t\t//5.发送数据\n\t\t\tcin \u003e\u003e sendBuf;\n\t\t\tnSendNum=sendto(sock,sendBuf,sizeof(sendBuf),0, (sockaddr*)\u0026addrClient,size);\n\t\t\tif (SOCKET_ERROR == nSendNum) {\n\t\t\t\tcout \u003c\u003c \"sendto error:\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\t//6.关闭套接字\n\tclosesocket(sock);\n\t//7.卸载库\n\tWSACleanup();\n\treturn 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-7lm01sc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-7lm01sc","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"//ip两类：1.十进制四等分字符串类型；2.ulong类型\n//\tinet_ntoa():从ulong类型转到字符串类型--显示的时候一般使用字符串类型\n//\tinet_addr():从字符串类型转换到ulong类型--赋值使用\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-x8j1wqm","Type":"NodeParagraph","Properties":{"id":"20260505170804-x8j1wqm","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118195333147"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118195333147.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-46lkze2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-46lkze2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"数据包在传输过程中的变化"}]},{"ID":"20260505170804-gawynpe","Type":"NodeParagraph","Properties":{"id":"20260505170804-gawynpe","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118195740280"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118195740280.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-30e7d5d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-30e7d5d","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单播组播和广播"}]},{"ID":"20260505170804-4twuptv","Type":"NodeParagraph","Properties":{"id":"20260505170804-4twuptv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单播：一个设备发给一个设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"广播：一个设备发，很多个设备收，关注的是范围"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"组播：一个设备发，很多个设备收，关注的是设备"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118200904858"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118200904858.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-10j4ars","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-10j4ars","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ARP 协议"}]},{"ID":"20260505170804-p8js5vy","Type":"NodeParagraph","Properties":{"id":"20260505170804-p8js5vy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"地址解析协议，是根据 IP 地址获取物理地址的一个 TCP/IP 协议（TCPIP 协议族）"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118201319257"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118201319257.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-0bv4q7f","Type":"NodeParagraph","Properties":{"id":"20260505170804-0bv4q7f","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发 ARP 请求"},{"Type":"NodeText","Data":" \t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发送广播请求"},{"Type":"NodeText","Data":" \t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"目标设备响应"},{"Type":"NodeText","Data":"\t "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"更新缓存并通信"}]},{"ID":"20260505170804-eupgnzd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-eupgnzd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"ARP 代理"}]},{"ID":"20260505170804-33zgx7e","Type":"NodeParagraph","Properties":{"id":"20260505170804-33zgx7e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t当发送端广播 ARP 请求时，本地网络上不会有主机回应（因为 IP 地址是外网的），此时路由器将会回应该请求，则发送源误认为路由器就是目的主机，会将报文全部转发给它，再由路由器转发报文到外网，则该路由器就被称为 ARP 代理"}]},{"ID":"20260505170804-91thq63","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-91thq63","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"免费 ARP"}]},{"ID":"20260505170804-k7u09xd","Type":"NodeParagraph","Properties":{"id":"20260505170804-k7u09xd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t在主机开机配置时，会发送一个目的 IP 地址为自己 IP 地址的 ARP 请求报文，该报文成为免费 ARP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用：1.让主机确认本地网络上是否有与自己 IP 地址相同的主机，若有则返回一个错误报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t\t   2.告诉整个广播域，目前某个 IP 所对应的 MAC 地址是什么  更新局域网 ARP 缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缓存：因为空间有限\t老化机制:长时间不使用的数据就删掉，给新的数据腾空间"}]},{"ID":"20260505170804-x32xl8d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-x32xl8d","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DNS 协议"}]},{"ID":"20260505170804-tcjz09v","Type":"NodeParagraph","Properties":{"id":"20260505170804-tcjz09v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"域名解析，DNS 服务器将好记的域名解析成 IP 地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118205214110"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118205214110.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-yden0f3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yden0f3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"路由数据转发过程"}]},{"ID":"20260505170804-kvaonr3","Type":"NodeParagraph","Properties":{"id":"20260505170804-kvaonr3","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251118205644412"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251118205644412.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ktotown","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ktotown","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IP 地址分类"}]},{"ID":"20260505170804-55t4ukh","Type":"NodeParagraph","Properties":{"id":"20260505170804-55t4ukh","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119111349773"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119111349773.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-dtmu0o3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dtmu0o3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"子网掩码"}]},{"ID":"20260505170804-ss5r3nk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ss5r3nk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"又叫网络掩码，地址掩码，子网络遮罩，就是说把子网络遮起来了，不让外界窥探到。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IP 地址与子网掩码按位与"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"某主机的网络地址（对外的 IP 地址）  主机号被隐藏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119112715545"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119112715545.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-0l2q9cv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-0l2q9cv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"非默认子网掩码"}]},{"ID":"20260505170804-ztg3iar","Type":"NodeParagraph","Properties":{"id":"20260505170804-ztg3iar","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在默认子网掩码上多加了几个 1"}]},{"ID":"20260505170804-m0oekyp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m0oekyp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网关"}]},{"ID":"20260505170804-p7hx2rl","Type":"NodeParagraph","Properties":{"id":"20260505170804-p7hx2rl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"又称网间连接器，协议转换器。网间连接器，就是连接两个子网之间的设备或软件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119112957173"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119112957173.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-3oepash","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3oepash","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"广播地址"}]},{"ID":"20260505170804-xe99dcz","Type":"NodeParagraph","Properties":{"id":"20260505170804-xe99dcz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用于向网络中的所有设备进行广播。具有正常的网络号部分，而主机号部分全为 1 的 IP 地址称之为广播地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送直接广播地址数据，会将数据发送给改子网内所有主机。"}]},{"ID":"20260505170804-9vknzs7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-9vknzs7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"有限广播地址"}]},{"ID":"20260505170804-mcojdj7","Type":"NodeParagraph","Properties":{"id":"20260505170804-mcojdj7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"指的是 32 位全位 1（255.255.255.255）的 IP 地址，用于本网广播。"}]},{"ID":"20260505170804-829idrr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-829idrr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"子网划分"}]},{"ID":"20260505170804-rljatv9","Type":"NodeParagraph","Properties":{"id":"20260505170804-rljatv9","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119114941737"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119114941737.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-dymdhj0","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-dymdhj0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"子网划分练习题"}]},{"ID":"20260505170804-rwuuqr2","Type":"NodeParagraph","Properties":{"id":"20260505170804-rwuuqr2","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119120012932"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119120012932.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-rvdx3jj","Type":"NodeParagraph","Properties":{"id":"20260505170804-rvdx3jj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一. \t210.33.5.0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二.\t255.224.0.0 → 二进制（第二段）："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"11100000"},{"Type":"NodeText","Data":"   x=3  子网个数:2^3=8;（每个子网包含主机数需-2）\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"步长：256-224=32；20.32.0.0\t20.64.0.0\t20.96.0.0 …….. 共 8 个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三.\t"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119121115847"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119121115847.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-h7tfj73","Type":"NodeParagraph","Properties":{"id":"20260505170804-h7tfj73","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"四.\t"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119121656618"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119121656618.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-8mpeka7","Type":"NodeParagraph","Properties":{"id":"20260505170804-8mpeka7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t步长：256-248=8"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t\t\t\t"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119122048758"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119122048758.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251119122243506"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251119122243506.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-b2r48nt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b2r48nt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"代码"}]},{"ID":"20260505170804-fszzp7y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-fszzp7y","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"客户端中\n\n//直接广播：把发送地址的ip改为直接广播地址\nserverAddr.sin_addr.S_un.S_addr = inet_addr(\"10.58.229.255\");\n\n//有限广播：需要先申请权限再发广播\nBOOL val = true;\nsetsockopt(sock,SOL_SOCKET,SO_BROADCAST,(char*)\u0026val,sizeof(val));\nserverAddr.sin_addr.S_un.S_addr = inet_addr(\"255.255.255.255\");\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ulxu7le","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ulxu7le","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"阻塞和非阻塞"}]},{"ID":"20260505170804-89va9gg","Type":"NodeParagraph","Properties":{"id":"20260505170804-89va9gg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"阻塞：老王烧水，把水壶放在炉子上，在旁边看着直到水开——事情发生的时候第一时间知道，等待的时候进程是挂起的不占用 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非阻塞： 老王烧水，把水壶放在炉子上，去看电视了，每隔一段时间回来看看水开没开"}]},{"ID":"20260505170804-i2cq5sf","Type":"NodeParagraph","Properties":{"id":"20260505170804-i2cq5sf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"sock 默认是阻塞的，接收和发送都是阻塞的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把 socket 设置成非阻塞的"}]},{"ID":"20260505170804-2biclly","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-2biclly","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"u_long iMode=1;\nioctlsocket(sock,FIONBIO,\u0026iMode);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-7gtmp0m","Type":"NodeParagraph","Properties":{"id":"20260505170804-7gtmp0m","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发送的阻塞和非阻塞："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"阻塞发送：发送缓冲区空间不足够大时，等待缓冲区空间足够大以后再发送"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非阻塞发送：当发送缓冲区空间不足够大时，有多大空间，就往里拷贝多少数据，剩余数据由进程自行处理（可以根据 sendto 返回值来判断）"}]},{"ID":"20260505170804-z2u0uyp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z2u0uyp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"缓冲区"}]},{"ID":"20260505170804-feoq9mv","Type":"NodeParagraph","Properties":{"id":"20260505170804-feoq9mv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"exe 可执行文件：不运行时：保存在磁盘里\t\t运行时：调用到内存里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"虚拟内存：1.虚拟内存的核心是操作系统为进程提供的独立逻辑地址空间，屏蔽物理内存细节并实现进程隔离；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.其具体实现是利用磁盘空间补充物理内存，通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页面换入换出"},{"Type":"NodeText","Data":"扩展可用内存容量。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.虚拟内存的地址并不是真正的地址，需要做一个运算映射到真实地址"}]},{"ID":"20260505170804-0ob5o2d","Type":"NodeParagraph","Properties":{"id":"20260505170804-0ob5o2d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核空间是共用的，用户空间是自用的（代码中的 recvBuf sendBuf 进程自己的）"}]},{"ID":"20260505170804-bae5zrb","Type":"NodeParagraph","Properties":{"id":"20260505170804-bae5zrb","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251121133600151"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251121133600151.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-jlgv1pb","Type":"NodeParagraph","Properties":{"id":"20260505170804-jlgv1pb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓冲区："},{"Type":"NodeText","Data":"创建 socket 的时候，操作系统会在内核空间给每一个 socket 分配两个缓冲区（发送缓冲区，接收缓冲区）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接收数据："},{"Type":"NodeText","Data":"当数据到达操作系统，操作系统会根据目的端口号找到之前绑定的 socket，把数据写入到 socket 对应的接收缓冲区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t应用程序调用 recvfrom 函数时，就是从 socket 对应的接收缓冲区中拷贝数据到自己的空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"发送数据:"},{"Type":"NodeText","Data":"进程调用 sendto 函数，把 sendBuf 中的数据拷贝到 socket 对应的发送缓冲区中，操作系统会把发送缓冲区中的数据发送出去"}]},{"ID":"20260505170804-ugw9mxe","Type":"NodeParagraph","Properties":{"id":"20260505170804-ugw9mxe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"*"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"查看发送缓冲区和接收缓冲区的大小：getsockopt(sock,SOL_SOCKET, SO_RCVBUF,(char"},{"Type":"NodeText","Data":")\u0026recvSize,\u0026s);"}]},{"ID":"20260505170804-0n8997k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0n8997k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"UDP 协议特点总结"}]},{"ID":"20260505170804-2cvrhz3","Type":"NodeParagraph","Properties":{"id":"20260505170804-2cvrhz3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"面向非连接，创建的 socket 可以接收任意人发来的数据，可以是一对一，也可以是一对多（广播，组播）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通讯方式：数据报文的通讯方式，数据不可拆分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传输效率高（跟 TCP 协议对比）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会产生丢包，也可能出现乱序，因为没有检查和校验，没有解决这些问题"}]},{"ID":"20260505170804-oalp182","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-oalp182","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"以太网帧结构"}]},{"ID":"20260505170804-mt6bw5h","Type":"NodeParagraph","Properties":{"id":"20260505170804-mt6bw5h","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251121144023680"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251121144023680.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-m7vmvr4","Type":"NodeParagraph","Properties":{"id":"20260505170804-m7vmvr4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MTU：一个网络包的最大长度，以太网中为 1500 字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MSS：除去 IP 和 TCP 头部之后，一个网络包所能容纳的 TCP 数据的最大长度"}]},{"ID":"20260505170804-whollah","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-whollah","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"IP 协议格式"}]},{"ID":"20260505170804-tf1fy7g","Type":"NodeParagraph","Properties":{"id":"20260505170804-tf1fy7g","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251121144428497"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251121144428497.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-po7jwmp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-po7jwmp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP"}]},{"ID":"20260505170804-fn8a1a8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fn8a1a8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP server"}]},{"ID":"20260505170804-vimixrg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-vimixrg","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#define _WINSOCK_DEPRECATED_NO_WARNING\n#include\u003ciostream\u003e\nusing namespace std;\n#include\u003cWinSock2.h\u003e\n#pragma comment(lib,\"Ws2_32.lib\")\nint main() {\n//1.加载库\n\tWORD version = MAKEWORD(2, 2);\n\tWSADATA data = {};\n\tint err=WSAStartup(version,\u0026data);\n\tif (err != 0) {\n\t\tcout \u003c\u003c \"WSAStartup fail\" \u003c\u003c endl;\n\t\treturn 1;\n\t}\n\t\t//判断版本号是否正确\n\tif (2 != HIBYTE(data.wVersion) || 2 != LOBYTE(data.wVersion)) {\n\t\tcout \u003c\u003c \"WSAStartup version error\" \u003c\u003c endl;\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"WSAStartup success\" \u003c\u003c endl;\n\t}\n//2.创建套接字(TCP协议的套接字)\n\tSOCKET sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n\tif (INVALID_SOCKET==sock) {\n\t\tcout \u003c\u003c \"socket error:\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"socket success\" \u003c\u003c endl;\n\t}\n//3.绑定IP和端口号\n\tsockaddr_in addr;\n\taddr.sin_family = AF_INET;\n\taddr.sin_port = htons(67890);\t//转换成网络字节序\n\taddr.sin_addr.S_un.S_addr = ADDR_ANY;\t//绑定所有网卡\n\terr = bind(sock,(sockaddr*)\u0026addr,sizeof(addr));\n\tif (SOCKET_ERROR == err) {\n\t\tcout \u003c\u003c \"bind error:\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\tclosesocket(sock);\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"bind success\" \u003c\u003c endl;\n\t}\n//4.监听\n\terr=listen(sock,100);\t//第二个参数是等待连接队列的最大长度\n\tif (SOCKET_ERROR == err) {\n\t\tcout \u003c\u003c \"listen error\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\tclosesocket(sock);\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\tcout \u003c\u003c \"listen success\" \u003c\u003c endl;\n\t}\n//5.接受连接\n\tsockaddr_in addrClient;\n\tint size = sizeof(addrClient);\n\t//接受连接成功返回的socket只能用来跟当前来连接的客户端进行数据收发\n\tSOCKET sockTalk = accept(sock,(sockaddr*) \u0026 addrClient,\u0026size);//监听用哪个socket接受连接就用哪个socket\n\tif (INVALID_SOCKET == sockTalk) {\n\t\tcout \u003c\u003c \"accept error:\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\tclosesocket(sock);\n\t\tWSACleanup();\n\t\treturn 1;\n\t}\n\telse {\n\t\t//连接成功打印IP地址\n\t\tcout \u003c\u003c \"ip: \"\u003c\u003cinet_ntoa(addrClient.sin_addr)\u003c\u003cendl;\n\t}\n\tint nRecvNum = 0;\n\tint nSendNum = 0;\n\tchar recvBuf[4096] = \"\";\n\tchar sendBuf[4096] = \" \";\n\twhile (true) {\n//6. 接收数据\n\t\tnRecvNum = recv(sockTalk,recvBuf,sizeof(recvBuf),0);\n\t\tif (nRecvNum \u003e 0) {\n\t\t\t//接收数据成功，打印接收到的数据\n\t\t\tcout \u003c\u003c \"client say:\" \u003c\u003c recvBuf \u003c\u003c endl;\n\t\t}\n\t\telse {\n\t\t\t//接收失败，打印错误码，结束循环\n\t\t\tcout \u003c\u003c \"recv error:\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\t\tbreak;\n\t\t}\n//7.发送数据\n\t\tcin \u003e\u003e sendBuf;\n\t\tnSendNum=send(sockTalk,sendBuf,sizeof(sendBuf),0);\n\t\tif (SOCKET_ERROR == nSendNum) {\n\t\t\tcout \u003c\u003c \"send error \" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n\t\t\tbreak;\n\t\t}\n\t}\n//8.关闭套接字\n\tclosesocket(sock);\n\tclosesocket(sockTalk);\n//9.卸载库\n\tWSACleanup();\n\treturn 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-4h3p4ys","Type":"NodeParagraph","Properties":{"id":"20260505170804-4h3p4ys","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP client"}]},{"ID":"20260505170804-klk5axh","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-klk5axh","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#define _WINSOCK_DEPRECATED_NO_WARNINGS\n\n#include \u003ciostream\u003e\n#include \u003cWinSock2.h\u003e\n#pragma comment(lib, \"Ws2_32.lib\")\nusing namespace std;\nint main() {\n// 1. 加载库\n    WORD version = MAKEWORD(2, 2);  // 兼容服务端的2.2版本\n    WSADATA wsaData = {};\n    int err = WSAStartup(version, \u0026wsaData);\n    if (err != 0) {\n        cout \u003c\u003c \"WSAStartup失败，错误码：\" \u003c\u003c err \u003c\u003c endl;\n        return 1;\n    }\n    if (HIBYTE(wsaData.wVersion) != 2 || LOBYTE(wsaData.wVersion) != 2) {\n        cout \u003c\u003c \"Winsock版本不兼容\" \u003c\u003c endl;\n        WSACleanup();\n        return 1;\n    }\n    cout \u003c\u003c \"WSAStartup初始化成功\" \u003c\u003c endl;\n// 2. 创建TCP套接字\n    SOCKET clientSock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n    if (clientSock == INVALID_SOCKET) {\n        cout \u003c\u003c \"创建套接字失败，错误码：\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n        WSACleanup();\n        return 1;\n    }\n    cout \u003c\u003c \"套接字创建成功\" \u003c\u003c endl;\n// 3. 连接服务端\n            //配置服务端地址信息\n    sockaddr_in serverAddr = {};\n    serverAddr.sin_family = AF_INET;                  // IPv4协议\n    serverAddr.sin_port = htons(67890);               // 服务端端口（必须与服务端一致）\n    serverAddr.sin_addr.S_un.S_addr = inet_addr(\"10.58.229.237\"); \n    err = connect(clientSock, (sockaddr*)\u0026serverAddr, sizeof(serverAddr));\n    if (err == SOCKET_ERROR) {\n        cout \u003c\u003c \"连接服务端失败，错误码：\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n        closesocket(clientSock);\n        WSACleanup();\n        return 1;\n    }\n    cout \u003c\u003c \"成功连接到服务端！\" \u003c\u003c endl;\n    cout \u003c\u003c \"提示：输入消息发送给服务端，服务端会回复你（关闭窗口退出）\" \u003c\u003c endl;\n//4.发送数据\n    char recvBuf[4096] = {};  // 接收缓冲区（与服务端一致）\n    char sendBuf[4096] = {};  // 发送缓冲区（与服务端一致）\n    int recvLen = 0;\n    int sendLen = 0;\n    while (true) {\n        // 发送数据给服务端\n        cin \u003e\u003e sendBuf;\n        sendLen = send(clientSock, sendBuf,sizeof(sendBuf), 0);  // +1包含字符串结束符\n        if (sendLen == SOCKET_ERROR) {\n            cout \u003c\u003c \"发送消息失败，错误码：\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n            break;\n        }\n        cout \u003c\u003c \"已发送：\" \u003c\u003c sendBuf \u003c\u003c endl;\n//5.接收数据\n        recvLen = recv(clientSock, recvBuf, sizeof(recvBuf), 0);\n        if (recvLen \u003e 0) {\n            // 接收成功\n            cout \u003c\u003c \"服务端回复：\" \u003c\u003c recvBuf \u003c\u003c endl;\n        }\n        else {\n            // 接收失败\n            cout \u003c\u003c \"接收消息失败，错误码：\" \u003c\u003c WSAGetLastError() \u003c\u003c endl;\n            break;\n        }\n    }\n// 6. 关闭资源\n    closesocket(clientSock);\n    WSACleanup();\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-v9i7auw","Type":"NodeParagraph","Properties":{"id":"20260505170804-v9i7auw","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251123211049715"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251123211049715.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-2ottm9j","Type":"NodeParagraph","Properties":{"id":"20260505170804-2ottm9j","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"seq:"},{"Type":"NodeText","Data":"序号，保证有序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ack:"},{"Type":"NodeText","Data":"确认号，可靠"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"首部长度："},{"Type":"NodeText","Data":"标识 TCP 首部边界，定位应用数据起始位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"紧急指针："},{"Type":"NodeText","Data":"指向数据需要优先处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窗口："},{"Type":"NodeText","Data":"TCP 窗口通过动态调整数据发送量，实现流量控制与拥塞避免，提升传输效率与稳定性。"}]},{"ID":"20260505170804-aevuo0c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-aevuo0c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ACK 机制"}]},{"ID":"20260505170804-ja0ph3i","Type":"NodeParagraph","Properties":{"id":"20260505170804-ja0ph3i","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251123211934584"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251123211934584.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-cbfbl6c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cbfbl6c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"超时重传"}]},{"ID":"20260505170804-xlfn05b","Type":"NodeParagraph","Properties":{"id":"20260505170804-xlfn05b","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251123212019451"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251123212019451.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-o181wd1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-o181wd1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 传输控制协议"}]},{"ID":"20260505170804-y4tp4pj","Type":"NodeParagraph","Properties":{"id":"20260505170804-y4tp4pj","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251123212126644"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251123212126644.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-fbdrxmw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fbdrxmw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"四次挥手"}]},{"ID":"20260505170804-wzyuq77","Type":"NodeParagraph","Properties":{"id":"20260505170804-wzyuq77","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端可以作为主动方，服务端也可以作为被动方"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124111643915"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124111643915.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-w3fn4d1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w3fn4d1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"RTT 往返时延"}]},{"ID":"20260505170804-k2ww8l8","Type":"NodeParagraph","Properties":{"id":"20260505170804-k2ww8l8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t在计算机网络中他是一个重要的性能指标，表示从发送端发送数据开始，到发送端收到来自接收端的确认，总共经历的时延。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"RTT 由三个部分决定："},{"Type":"NodeText","Data":"即链路的传播时间，末端系统的处理时间，以及路由器的缓存中的排队和处理时间。"}]},{"ID":"20260505170804-3u19r28","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-3u19r28","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"RTO 超时重传时间"}]},{"ID":"20260505170804-7jlglo9","Type":"NodeParagraph","Properties":{"id":"20260505170804-7jlglo9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\tTCP 每发送一个报文段，就对此报文段设置一个超时重传计时器。此计时器设置的超时重传时间 RTO 应当略大于 TCP 报文段的平均往返时延 RTT，一般可取 RTO=2RTT。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t但是，也可以根据具体情况人为调整 RTO 的值，例如可以设置此超时重传时间 RTO=90 秒。当超过了规定的超时重传时间还未收到对此 TCP 报文段的预期确认信息，则必须重新传输此 TCP 报文段。"}]},{"ID":"20260505170804-e77agey","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e77agey","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"累计应答"}]},{"ID":"20260505170804-f6ahpzd","Type":"NodeParagraph","Properties":{"id":"20260505170804-f6ahpzd","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124120902452"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124120902452.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-2m453fn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2m453fn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 流量控制———滑动窗口"}]},{"ID":"20260505170804-2eixs6v","Type":"NodeParagraph","Properties":{"id":"20260505170804-2eixs6v","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窗口的概念："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 每发送一个数据，都要进行一次确认应答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当上一个数据包收到了应答了，再发送下一个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个模式就有点像我和你面对面聊天，你一句我一句"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但这种方式的缺点是效率比较低的"}]},{"ID":"20260505170804-flzlexu","Type":"NodeParagraph","Properties":{"id":"20260505170804-flzlexu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有了窗口，就可以指定窗口大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"窗口大小就是指无需等待确认应答，而可以继续发送数据的最大值"}]},{"ID":"20260505170804-pirp0cd","Type":"NodeParagraph","Properties":{"id":"20260505170804-pirp0cd","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窗口大小由哪一方决定？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三次握手的时候，会交换窗口大小，通常窗口的大小是由接收方的窗口大小来决定的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方发送的数据大小不能超过接收方的窗口大小，否则接收方就无法正常接收到数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124124347170"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124124347170.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-su1kybm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-su1kybm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"流量控制"}]},{"ID":"20260505170804-mx5yqk8","Type":"NodeParagraph","Properties":{"id":"20260505170804-mx5yqk8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主要是接收方传递信息给发送方，使其不要发送数据太快，是一种端到端的控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要的方式就是返回的 ACK 中会包含自己的接收窗口的大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并且利用窗口大小来控制发送方的数据发送多少"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124124819656"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124124819656.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-27fa0ez","Type":"NodeParagraph","Properties":{"id":"20260505170804-27fa0ez","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124125227537"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124125227537.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-i6xv97o","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-i6xv97o","updated":"20260505170804"},"Children":[{"ID":"20260505170804-l1qpvpk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-l1qpvpk","updated":"20260505170804"},"Children":[{"ID":"20260505170804-tc85j5p","Type":"NodeParagraph","Properties":{"id":"20260505170804-tc85j5p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"发送方"}]}]},{"ID":"20260505170804-bp6o0pb","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-bp6o0pb","updated":"20260505170804"},"Children":[{"ID":"20260505170804-5ne8xxy","Type":"NodeParagraph","Properties":{"id":"20260505170804-5ne8xxy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"SND_UNA`：已发送但未确认的数据起始序号；"}]}]},{"ID":"20260505170804-t2o05p7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-t2o05p7","updated":"20260505170804"},"Children":[{"ID":"20260505170804-epx1x0q","Type":"NodeParagraph","Properties":{"id":"20260505170804-epx1x0q","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SND_NXT"},{"Type":"NodeText","Data":"：下一个待发送数据的序号；"}]}]},{"ID":"20260505170804-4zpu85o","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-4zpu85o","updated":"20260505170804"},"Children":[{"ID":"20260505170804-8hjmrsm","Type":"NodeParagraph","Properties":{"id":"20260505170804-8hjmrsm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SND_WND"},{"Type":"NodeText","Data":"：当前可用的发送窗口（由接收方窗口决定）；"}]}]},{"ID":"20260505170804-x82ndyi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-x82ndyi","updated":"20260505170804"},"Children":[{"ID":"20260505170804-16qxnuj","Type":"NodeParagraph","Properties":{"id":"20260505170804-16qxnuj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Usable"},{"Type":"NodeText","Data":"：实际可发送的剩余数据量。"}]}]},{"ID":"20260505170804-obrurxd","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-obrurxd","updated":"20260505170804"},"Children":[{"ID":"20260505170804-cqp4gvh","Type":"NodeParagraph","Properties":{"id":"20260505170804-cqp4gvh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"接收方"}]}]},{"ID":"20260505170804-umo52tx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-umo52tx","updated":"20260505170804"},"Children":[{"ID":"20260505170804-dkz9zm5","Type":"NodeParagraph","Properties":{"id":"20260505170804-dkz9zm5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RCV_NXT"},{"Type":"NodeText","Data":"：下一个待接收数据的序号；"}]}]},{"ID":"20260505170804-jmw4a32","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-jmw4a32","updated":"20260505170804"},"Children":[{"ID":"20260505170804-rj9qgrr","Type":"NodeParagraph","Properties":{"id":"20260505170804-rj9qgrr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RCV_WND"},{"Type":"NodeText","Data":"：当前可用的接收窗口（由自身缓冲区空闲空间决定）。"}]}]}]},{"ID":"20260505170804-xp83580","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xp83580","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"粘包问题"}]},{"ID":"20260505170804-yldk74p","Type":"NodeParagraph","Properties":{"id":"20260505170804-yldk74p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\ttcp 是字节流传输，是一种没有边界的，可以合并的传输数据方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t合并就要能拆开，拆不开就是粘包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决办法："},{"Type":"NodeText","Data":"1.设置标志位（起始标志位/结束标志位）\t2.固定包大小\t3.先发数据长度，然后再发数据包\t4.短连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124130907806"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124130907806.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-v2535l8","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-v2535l8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"心跳机制"}]},{"ID":"20260505170804-kt8aonn","Type":"NodeParagraph","Properties":{"id":"20260505170804-kt8aonn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t在长连接下，有可能很长一段时间都没有数据往来。理论上说，这个连接是一直保持连接的，但是实际情况中，如果中间节点出现什么故障是难以知道的。更要命的是，有的节点（防火墙）会自动把一定时间之内没有数据交互的连接给断掉。在这个时候，就需要我们的心跳包了，用于维持长连接，保活。"}]},{"ID":"20260505170804-va6ezzi","Type":"NodeParagraph","Properties":{"id":"20260505170804-va6ezzi","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"什么是心跳机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就是每隔几分钟发送一个固定信息给服务端，服务端收到后回复一个固定信息。如果服务端几分钟内没有收到客户端信息则视客户端断开。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"心跳包的发送，通常有两种技术："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用层自己实现的心跳包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用 SO_KEEPALIVE 套接字选项"}]},{"ID":"20260505170804-sxapu7q","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-sxapu7q","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Nagle 算法"}]},{"ID":"20260505170804-6xeoact","Type":"NodeParagraph","Properties":{"id":"20260505170804-6xeoact","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Nagle 算法就是为了尽可能发送大块数据，避免网络中充斥着许多小数据块。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Nagle 算法的规则："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（1）如果包长度达到 MSS（最大报文段长度），则允许发送；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（2）如果该包含有 FIN，则允许发送；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（3）设置了 TCP_NODELAY 选项，则允许发送；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（4）未设置 TCP_CORK 选项时，若所有发出去的小数据包（包长度小于 MSS）均被确认，则允许发送；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（5）上述条件都未满足，但发生了超时（一般为 200ms），则立即发送。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Nagle 算法默认是打开的，如果对于一些需要小数据包交互的场景的程序，比如，telnet 或 ssh 这样的交互性比较强的程序，则需要关闭 Nagle 算法。"}]},{"ID":"20260505170804-smyuhcu","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-smyuhcu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"拥塞控制"}]},{"ID":"20260505170804-nibui2l","Type":"NodeParagraph","Properties":{"id":"20260505170804-nibui2l","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124131951690"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124131951690.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-jgaoomr","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-jgaoomr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"慢开始与拥塞控制"}]},{"ID":"20260505170804-2s648ep","Type":"NodeParagraph","Properties":{"id":"20260505170804-2s648ep","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124132219041"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124132219041.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-p8vk6nq","Type":"NodeParagraph","Properties":{"id":"20260505170804-p8vk6nq","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124132443902"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124132443902.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-kdtqn22","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-kdtqn22","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"快重传"}]},{"ID":"20260505170804-4ao66ru","Type":"NodeParagraph","Properties":{"id":"20260505170804-4ao66ru","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124132630101"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124132630101.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-5t5layk","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5t5layk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"快恢复"}]},{"ID":"20260505170804-zil1nyg","Type":"NodeParagraph","Properties":{"id":"20260505170804-zil1nyg","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20251124132810462"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20251124132810462.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-zwige2s","Type":"NodeParagraph","Properties":{"id":"20260505170804-zwige2s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"触发快重传时也会触发快恢复"}]},{"ID":"20260505170804-r4me9cf","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-r4me9cf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"TCP 协议总结"}]},{"ID":"20260505170804-toxnvuw","Type":"NodeParagraph","Properties":{"id":"20260505170804-toxnvuw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"面向连接的，可靠的传输，基于字节流的传输方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面向连接指发送数据之前必须在双端建立连接，建立连接使用“三次握手”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可靠传输：seq 和 ack"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于字节流的传输：粘包问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方案：1.设置标志位（起始标志位/结束标志位）\t2.固定包大小\t3.先发数据长度，然后再发数据包\t4.短连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为什么 TCP 是可靠的？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.三次握手和四次握手"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.重传和确认机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.合理的分段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.校验重新排序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.滑动窗口——流量控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6.拥塞控制——4 种拥塞控制算法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 可以发广播吗？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 是一对一传输的，理论上是不能发广播的"}]},{"ID":"20260505170804-wi03ec5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wi03ec5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"数据库"}]},{"ID":"20260505170804-b4aogb3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-b4aogb3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"什么是数据库"}]},{"ID":"20260505170804-9bxqvu1","Type":"NodeParagraph","Properties":{"id":"20260505170804-9bxqvu1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据库是 “按照数据结构来组织、存储和管理数据的仓库”。是一个长期存储在计算机内的、有组织的、可共享的、统一管理的大量数据的集合。"}]},{"ID":"20260505170804-88ehmnj","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-88ehmnj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据库的由来？"}]},{"ID":"20260505170804-bq7kleq","Type":"NodeParagraph","Properties":{"id":"20260505170804-bq7kleq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"规范化的本地存储 加密 共享"}]},{"ID":"20260505170804-zn89jnj","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-zn89jnj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据库的分类"}]},{"ID":"20260505170804-wolg4lv","Type":"NodeParagraph","Properties":{"id":"20260505170804-wolg4lv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关系型数据库：其实就是二维表，典型代表 mysql(不区分大小写),oracle,SQL Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非关系型数据库：也叫 NoSQL，是一维映射 key-value 典型代表 redis，MongoDB"}]},{"ID":"20260505170804-7aw2b2u","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-7aw2b2u","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"运行 sql 语句"}]},{"ID":"20260505170804-mabg64x","Type":"NodeParagraph","Properties":{"id":"20260505170804-mabg64x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.带光标的闪电：运行光标所在行的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.不带光标的闪电：没有选择任何 sql 语句时，从文件开头执行所有 sql 语句（如果中间有执行失误，停止执行）；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"选择了一条或者多条 sql 语句，就是执行所用选择的 sql 语句"}]},{"ID":"20260505170804-pycxx7i","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-pycxx7i","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"数据类型"}]},{"ID":"20260505170804-tqpjonm","Type":"NodeParagraph","Properties":{"id":"20260505170804-tqpjonm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.char(45):\t一个字符占一个字节，固定长度 45，无论字符串多少都占 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.nchar(45):\t采用宽字符集，一个字符占两个字节，无论字符串多少，都占 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.varchar(45):\t一个字符占一个字节，最大长度 45，实际存多长数据，就占多少字节，不能超过 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.nvarchar(45):\t采用宽字符集，一个字符占两个字节，实际存多少数据就占多少字节，不能超过 45 个字节"}]},{"ID":"20260505170804-aqdamvu","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-aqdamvu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"建表约束"}]},{"ID":"20260505170804-lhz6nht","Type":"NodeParagraph","Properties":{"id":"20260505170804-lhz6nht","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.主键："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"primary key"},{"Type":"NodeText","Data":" 每个表中只能有一列是主键列，主键列的值不允许重复，并且不能为空（数据库会给主键列创建索引查找速度快）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.唯一："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"unique"},{"Type":"NodeText","Data":" 数据不允许重复，但是可以为空"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.不为空："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"not null"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.默认值："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"default"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.自增："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"auto_increment"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6.外键约束："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"foreign key"},{"Type":"NodeText","Data":" 跟其他表里的某一列或某几列有关系 通过一些计算公式算出来的结果"}]},{"ID":"20260505170804-tdr80wp","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-tdr80wp","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#注释使用\n#sql以分号为结尾\n#设置默认使用的库（查表的时候就不用专门指定库了，没有指定库的时候就在默认使用的库中查找表）\nuse 20240318test;\n\n#创建表\ncreate table 表名(列名 数据类型 建表约束,列名 数据类型 建表约束,...);\n#例子\ncreate table studentInfo(\n\tid int primary key auto_increment,\n\tname varchar(20) unique not null,\n\tsex enum('男','女'),\n\tage int default 18\n);\n\n#修改表\nalter table 表名 ...;\n#增加列\nalter table 表名 add column 列名 数据类型 建表约束;\n#增加列的属性：\nalter table 表名 modify 列名 数据类型 建表约束;\n#删除列：\nalter table 表名 drop 列名;\n#删除表：\ndrop table 表名;\n\n#查询数据\nselect 列名1，列名2... from 表名;\n#查询所有列的数据\nselect * from 表名;\n#给查询的列名起别名\nselect 列名1 别名1,列名2 别名2... from 表名;\n\n#插入数据\n#插入所有列的数据(要求数据的顺序必须和表中列的顺序一致)\ninsert into 表名 values(值1，值2，值3...);\n#插入部分列的数据\ninsert into 表名 (列名1，列名2，列名3...)values(值1，值2，值3...);\n\n#更新数据\nupdate 表名 set 列名 = 值 where 条件表达式;\n\n#删除表中的所有数据\ndelete from 表名;\n#删除表中满足条件行的数据\ndelete from 表名 where 条件表达式;\n\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ta7g6nm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ta7g6nm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"数据库范式"}]},{"ID":"20260505170804-ph1gi88","Type":"NodeParagraph","Properties":{"id":"20260505170804-ph1gi88","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常见名词"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属性-\u003e 特征-\u003e 表中的一列-\u003e 字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"元组：表的一行就叫一个元组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"码：表中唯一确定一个元组的属性，码不止一个，叫这些为候选码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主码：从候选码挑选出来一个主要确定这一行的属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主属性：只要在任何一个候选码中出现过，这个属性就叫主属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非主属性：没有在任何一个候选码中出现过"}]},{"ID":"20260505170804-psqio8p","Type":"NodeParagraph","Properties":{"id":"20260505170804-psqio8p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据库范式"}]},{"ID":"20260505170804-je2xco8","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-je2xco8","updated":"20260505170804"},"Children":[{"ID":"20260505170804-xho1drp","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-xho1drp","updated":"20260505170804"},"Children":[{"ID":"20260505170804-pw3zdyi","Type":"NodeParagraph","Properties":{"id":"20260505170804-pw3zdyi","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1NF（原子性）"},{"Type":"NodeText","Data":"：列值不可再分，比如 “联系方式” 拆为 “手机号 + 邮箱”。"}]}]},{"ID":"20260505170804-b34ea7n","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-b34ea7n","updated":"20260505170804"},"Children":[{"ID":"20260505170804-t53shy6","Type":"NodeParagraph","Properties":{"id":"20260505170804-t53shy6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2NF（消除部分依赖）"},{"Type":"NodeText","Data":"：非主键列需完全依赖主键，用拆分表解决复合主键的部分依赖（如拆 “学生 - 课程 - 成绩” 为学生表、课程表、成绩表）。"}]}]},{"ID":"20260505170804-fy24xti","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-fy24xti","updated":"20260505170804"},"Children":[{"ID":"20260505170804-c9o77xw","Type":"NodeParagraph","Properties":{"id":"20260505170804-c9o77xw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3NF（消除传递依赖）"},{"Type":"NodeText","Data":"：非主键列不能依赖其他非主键列（如 “学生表” 去掉 “班级名称”，单独建班级表关联）。"}]}]},{"ID":"20260505170804-rkmw16p","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-rkmw16p","updated":"20260505170804"},"Children":[{"ID":"20260505170804-tvvvtc6","Type":"NodeParagraph","Properties":{"id":"20260505170804-tvvvtc6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"BCNF（鲍依斯-科得范式）"},{"Type":"NodeText","Data":"：不存在关键字段决定关键字段（如 仓库管理系统（仓库 ID 存储物品 ID 管理员 ID 数量）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"改进：仓库管理：仓库 ID，管理员 ID        仓库：仓库 ID 存储物品 ID 数量"}]}]}]},{"ID":"20260505170804-hrllo1w","Type":"NodeTable","Data":"|条件类型|语法格式|说明（含兼容性）|示例（表名：\u003cspan data-type=\"code\"\u003estudent\u003c/span\u003e，列：\u003cspan data-type=\"code\"\u003eid\u003c/span\u003e/\u003cspan data-type=\"code\"\u003eage\u003c/span\u003e/\u003cspan data-type=\"code\"\u003ename\u003c/span\u003e）|\n| ------------| -------------------------------------| ---------------------------------------------| ----------------------|\n|相等|列名 = 值|精确匹配（值为字符串需加单引号）|\u003cspan data-type=\"code\"\u003eWHERE id = 101\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name = '张三'\u003c/span\u003e|\n|不相等|列名！= 值 或 列名 \u003c\u003e 值|\u003cspan data-type=\"code\"\u003e\u0026lt;\u0026gt;\u003c/span\u003e 是标准语法（所有数据库兼容），\u003cspan data-type=\"code\"\u003e!=\u003c/span\u003e 仅 MySQL 支持|\u003cspan data-type=\"code\"\u003eWHERE age != 18\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name \u0026lt;\u0026gt; '李四'\u003c/span\u003e|\n|大于|列名 \u003e 值|-|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt; 20\u003c/span\u003e|\n|小于|列名 \u003c 值|-|\u003cspan data-type=\"code\"\u003eWHERE score \u0026lt; 60\u003c/span\u003e|\n|大于等于|列名 \u003e= 值|-|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt;= 18\u003c/span\u003e|\n|小于等于|列名 \u003c= 值|-|\u003cspan data-type=\"code\"\u003eWHERE score \u0026lt;= 100\u003c/span\u003e|\n|或者|条件 1 OR 条件 2 或 条件 1 \\|\\| 条件 2|两者等价，\u003cspan data-type=\"code\"\u003eOR\u003c/span\u003e 更通用|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt; 20 OR score \u0026gt;= 90\u003c/span\u003e|\n|并且|条件 1 AND 条件 2 或 条件 1 \u0026\u0026 条件 2|两者等价，\u003cspan data-type=\"code\"\u003eAND\u003c/span\u003e 更通用|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt;= 18 AND name = '张三'\u003c/span\u003e|\n|介于两者之间|列名 BETWEEN 值 1 AND 值 2|闭区间（包含值 1 和值 2），等价于 \u003cspan data-type=\"code\"\u003e\u0026gt;= AND \u0026lt;=\u003c/span\u003e|\u003cspan data-type=\"code\"\u003eWHERE age BETWEEN 18 AND 25\u003c/span\u003e（等价于 \u003cspan data-type=\"code\"\u003eage \u0026gt;=18 AND age \u0026lt;=25\u003c/span\u003e）|\n|在范围内|列名 IN (值 1, 值 2, ..., 值 N)|匹配括号内任意一个值，支持多值|\u003cspan data-type=\"code\"\u003eWHERE id IN (101, 102, 103)\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name IN ('张三', '王五')\u003c/span\u003e|\n|不在范围内|列名 NOT IN (值 1, 值 2, ..., 值 N)|与 \u003cspan data-type=\"code\"\u003eIN\u003c/span\u003e 相反，不匹配括号内任何值|\u003cspan data-type=\"code\"\u003eWHERE age NOT IN (16, 17, 19)\u003c/span\u003e|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-hrllo1w","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"语法格式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说明（含兼容性）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"示例（表名："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"student"},{"Type":"NodeText","Data":"，列："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"id"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"age"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"name"},{"Type":"NodeText","Data":"）"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"相等"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 = 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"精确匹配（值为字符串需加单引号）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE id = 101"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name = '张三'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不相等"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名！= 值 或 列名 \u003c\u003e 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":" 是标准语法（所有数据库兼容），"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!="},{"Type":"NodeText","Data":" 仅 MySQL 支持"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age != 18"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name \u0026lt;\u0026gt; '李四'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003e 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt; 20"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003c 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE score \u0026lt; 60"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大于等于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003e= 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt;= 18"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小于等于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003c= 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE score \u0026lt;= 100"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"或者"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件 1 OR 条件 2 或 条件 1 "},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"|"}]},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"|"}]},{"Type":"NodeText","Data":" 条件 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"两者等价，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OR"},{"Type":"NodeText","Data":" 更通用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt; 20 OR score \u0026gt;= 90"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"并且"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件 1 AND 条件 2 或 条件 1 \u0026\u0026 条件 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"两者等价，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AND"},{"Type":"NodeText","Data":" 更通用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt;= 18 AND name = '张三'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"介于两者之间"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 BETWEEN 值 1 AND 值 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"闭区间（包含值 1 和值 2），等价于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\u0026gt;= AND \u0026lt;="}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age BETWEEN 18 AND 25"},{"Type":"NodeText","Data":"（等价于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"age \u0026gt;=18 AND age \u0026lt;=25"},{"Type":"NodeText","Data":"）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"在范围内"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 IN (值 1, 值 2, ..., 值 N)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"匹配括号内任意一个值，支持多值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE id IN (101, 102, 103)"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name IN ('张三', '王五')"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不在范围内"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 NOT IN (值 1, 值 2, ..., 值 N)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"IN"},{"Type":"NodeText","Data":" 相反，不匹配括号内任何值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age NOT IN (16, 17, 19)"}]}]}]},{"ID":"20260505170804-e03dmcq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-e03dmcq","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#查询年龄超过15岁的女同学\nselect * from studentinfo where age\u003e15 and sex='女';\n#年龄超过18岁，或者性别是男的同学\nselect * from studentinfo where age \u003e18 or sex='男';\n#查询年龄在18岁到20岁之间的同学\nselect * from sutdentinfo where age between 18 and 20;  (是闭合区间)\n#查询年龄在15,18,20范围内的同学\nselect * from studentinfo where age not in(15,18,20);\n\n#模糊查询\nwhere 列名 like 模糊表达式;\n#模糊表达式\n\t%:匹配0~n个字符\n\t_:匹配1个字符\n#查询班级中姓朱的同学\nselect * from studentinfo where name like '朱%';\n\n#分页查找\nlimit a,b;\t(a是起始行数,从0开始计算;b是总共显示多少行数据)\nselect * from studentinfo limit 3,5;\n\n#聚合函数\t统计个数(查行数)\ncount()\n统计班级中有多少名同学(查询student表中有多少行数据)\nselect count(*) from student;\n单独查name列有多少行\nselect count(name) from student;\n#求和\t\nsum()\n#计算最大值\nmax()\n#计算最小值\nmin()\n#计算平均值\navg()\n\n#分组(计算每个):\t\ngroup by 列名\n计算每门科目的总分\nselect C,sum(score) \n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3nnqncr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-3nnqncr","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#查询总成绩高于200分的学生的编号\n#\t1.查询每个学生的总成绩\t2.加条件：总成绩高于200分 3.根据学生的编号查询学生的信息\nselect S,sum(score) from sc having sum(score)\u003e200; # 1 2\nselect * from student where S in (select S,sum(score) from sc having sum(score)\u003e200);# 3\n\n#添加条件：where or having\n#当作为条件的列是表中原来就有的，就使用where加条件\n#当作为条件的列不是表中原来就有的，使用having来加条件\n\n#排序：\norder by 列名 排序规则(升序asc/降序desc);\t\t#如果不写排序规则 默认是升序排列\n#给学生编号按照平均成绩降序排列\n#1. 计算每个同学的平均成绩\t2.按照平均成绩降序排列\t\nselect S,avg(score)from sc group by S order by avg(score) desc;\n\n#练习：\n#1.查询每门课程被选修的学生数\nselect C,count(*) from sc group by C;\n\n#2.检索至少选修两门课程的学生学号\n\t#查询每个学生选修的课程个数,个数\u003e=2\nselect S,count(*)from sc group by S having count(*)\u003e=2;\n\n#3.求这些学号对应的个人信息\nselect * from student where S in(select S,count(*)from sc group by S having count(*)\u003e=2);\n\n#4.查询选修了全部课程的学生信息\n\t#查询每个同学选修课程的个数\t查询总的课程的个数\t=\t查询这些学生个信息\nselect * from student where S in (select S from sc group by S having count(*)=(select count(*) from course));\n\n#5.查询没有学全部课程的学生信息\nselect * from student where S not in (select S from sc group by S having count(*)=(select count(*) from course));\n\n#6.查询学过张三老师授课的同学的信息\nselect * from student where \n\tS in(select S from sc where C in (select C from course where T =(select T from teacher where Tname='张三')));\n\n#7.查询没学过张三老师授课的同学的信息\nselect * from student where S not in\n\t(select S from sc where C in (select C from course where T =(select T from teacher where Tname='张三')));\n\n#8.查询每个同学01课程的成绩，包括个人信息\n\t#查询每个同学01课程的成绩\nselect S,score from sc where C='01';\n\t#查询每个同学的个人信息\nselect *from student;\n\t#把列拼接到一张表中\nselect *,(select S,score from sc where C='01'and sc.S=student.S) 01score from student;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-1khhy8z","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1khhy8z","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"联表查询"}]},{"ID":"20260505170804-ybfxj3i","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ybfxj3i","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"内联:  select * from 表1 inner join 表2 on 连接条件 (inner join.....);\n左联： select * from 表1 left join 表2 on 连接条件 (left join.....);\n右联： select * from 表1 right join 表2 on 连接条件 (right join.....);\n笛卡尔积： select * from 表1 , 表2 where 连接条件;\n\n区别：\n\t内联：去两个表的交集进行连接，不会出现空属性\n\t左联：以左边的表为基准，匹配行，如果没有相应属性就是空\n\t右联：以右边的表为基准，匹配行，如果没有相应属性就是空\n 笛卡尔积：结果和内联结果一致 采用先排列组合，在按照条件筛选结果，执行效率低，不推荐使用\n \n 去重： distinct\n select distinct s,c from sc;\n \n 联合： select 语句1 union all select 语句2; (两个select的结果列要相同) \n # 查询男生和女生的人数\nselect count(*) from student where Ssex='男'\nunion all\nselect count(*) from student where Ssex='女'\n\n做题三步骤：1.联表 2.加条件 3.筛选显示的列\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-x6n24x3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-x6n24x3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"视图"}]},{"ID":"20260505170804-9crbbpz","Type":"NodeParagraph","Properties":{"id":"20260505170804-9crbbpz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"view，为了简化复杂的 sql 查询语句而提出来的概念。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"视图是一个表或者多个表导出的虚拟表，不是真实存在的，所以不需要满足范式的要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"视图创建以后就永久的保存在数据库中，可以按照表名规则使用视图，达到一个简化的目的"}]},{"ID":"20260505170804-ioueggo","Type":"NodeParagraph","Properties":{"id":"20260505170804-ioueggo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用视图：跟表的使用方式一样（但是只能查询数据）"}]},{"ID":"20260505170804-tley8ji","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-tley8ji","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"创建视图\tcreate view 视图名 as (select 语句);\n删除视图\tdrop view 视图名;\n\n视图的优点：sql语句在网络中传输，使用视图可以减少流量，更安全。\n视图的缺点：执行效率不会提高，执行的还是原来的sql语句\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-uh71zyn","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-uh71zyn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"函数"}]},{"ID":"20260505170804-mk4araj","Type":"NodeParagraph","Properties":{"id":"20260505170804-mk4araj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自定义函数:function"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重新声明结束标志：delimiter  // \t\t\t\t\t\t\t声明//为新的结束标志"}]},{"ID":"20260505170804-2koxab8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-2koxab8","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"创建函数语法：\ndelimiter //\t    #声明//为结束标志\ncreate function 函数名(参数1 数据类型,参数2 数据类型, ...)\nreturns 返回值类型\nbegin\n函数语句;\n函数语句;\n...\nend //\ndelimiter ;\t\t\t#重新声明;为结束标志\n\n调用函数： select 函数名(参数列表);\n删除：\t   drop function 函数名;\n先判断是否存在，再删除: drop function if exists 函数名;\n\n#例子：实现一个加法函数\ndelimiter //\ncreate function myadd(a int,b int)\nreturns int\nbegin\n\tdeclare c int default 0;\n\tset c=a+b;\n\treturn c;\nend //\ndelimiter;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-s3e2dk4","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-s3e2dk4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"变量"}]},{"ID":"20260505170804-zj9xmd5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-zj9xmd5","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"局部变量：\n会话变量：本次会话有效，不需要定义声明，直接使用\nset @x=10;\nselect @x;\n系统变量：也叫全局变量-需要root权限才能操作\n#查看全部系统变量\nshow global variables;\n#查看具体系统变量\nselect @@concurrent_insert;\n\n选择\n#if选择：\nif(表达式) then 执行语句;执行语句;执行语句;\nelseif (表达式) then 执行语句;执行语句;执行语句;\nelse 执行语句;执行语句;执行语句;\nend if;\n#case选择：\n#语法1：\ncase 变量 when 值1 then 执行语句;执行语句;...\n\t\t when 值2 then 执行语句;执行语句;...\n\t\t when 值3 then 执行语句;执行语句;...\nend case;\n#语法2：\ncase when 表达式1 then 执行语句;执行语句;...\n\t when 表达式2 then 执行语句;执行语句;...\n\t when 表达式3 then 执行语句;执行语句;...\n\t else 执行语句;执行语句;...\nend case;\n\n循环\n#while循环语法：\nwhile 循环条件\ndo\n\t执行语句;\n\t执行语句;\n\t执行语句;\nend while;\n\n#其他循环：mysql中没有for循环，有repeat和loop循环\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-gghcrh7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-gghcrh7","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#青蛙爬井\ndrop function if exists qwpj;\ndelimiter //\ncreate function qwpj(nHigh int)\nreturns int\nbegin\n\tdeclare nDay int default 0;\n\tdeclare m int default 0;\n\twhile 1\n\tdo\n\t\tset nDay=nDay+1;\n\t\tset m=m+5;\n\t\tif m\u003e=nHigh then return nDay;\n\t\tend if;\n\t\tset m=m-4;\n\tend while\nend //\ndelimiter ;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-uu83jjo","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-uu83jjo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"存储过程"}]},{"ID":"20260505170804-jhh5uwp","Type":"NodeParagraph","Properties":{"id":"20260505170804-jhh5uwp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"procedure,是在大型数据库中，一组为了完成特定功能的 sql 语句集合。一次编译永久有效。|"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有返回值，如果需要返回数据，使声明参数的类型(IN,OUT,INOUT)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：减少流量，更安全：运行在数据库的服务器端，减少与客户机的交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"增强了代码的重用性和共享性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加快系统运行速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用灵活"}]},{"ID":"20260505170804-13is72u","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-13is72u","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#创建存储过程语法：\ndelimiter //\ncreate procedure 存储过程名(参数1,类型,参数2,类型...)\nbegin\nsql 语句;\nsql 语句;\n...\nend //\ndelimiter;\n\n#执行存储过程\ncall 过程名(参数列表);\n\n#删除存储过程\ndrop procedure if exists 过程名;\n\n\n----------------------------------------------------------------------------------------------------------\n#例子\t创建一个分页查询的存储过程\n#参数\t当前是第几页，每页显示多少行，固定查询student表\ndrop procedure if exists limitpro;\ndelimiter //\ncreate procedure limitpro(nPage int,nCount int)\nbegin\n\tdeclare a int default 0;\n\tset a=(nPage-1)*nCount;\n\tselect* from student limit a,nCount;\nend\ndelimiter ;\ncall limitpro(3,3);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-j7jxous","Type":"NodeParagraph","Properties":{"id":"20260505170804-j7jxous","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存储过程和函数的区别："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数有且仅有一个返回值；存储过程没有返回值，可以通过设置参数为 OUT 或者 INOUT 类型返回数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数中的 SQL 核心用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据查询计算"},{"Type":"NodeText","Data":"（SELECT 赋值给变量），而非执行修改操作；若需增删改 / 返回结果集，优先用存储过程。"}]},{"ID":"20260505170804-c5haa3p","Type":"NodeTable","Data":"|对比维度|存储过程|函数|\n| -------------| -----------------------------| ---------------------------------|\n|返回值|可选（0 / 多个，靠 OUT 参数）|必须有且仅有 1 个|\n|调用方式|独立 CALL 调用|可嵌入 SQL（如 SELECT）或独立调用|\n|核心用途|批量增删改、业务逻辑封装|数据计算、值转换、查询过滤|\n|参数类型|支持 IN/OUT/INOUT|仅 IN（部分库支持 OUT 但不推荐）|\n|事务 / 结果集|支持事务、可返回多个结果集|无事务、仅返回单个值（无结果集）|\n|SQL 兼容性|不能嵌入 SQL 语句|可作为 SQL 子句一部分使用|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-c5haa3p","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比维度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"存储过程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"函数"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"返回值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可选（0 / 多个，靠 OUT 参数）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"必须有且仅有 1 个"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"调用方式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独立 CALL 调用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可嵌入 SQL（如 SELECT）或独立调用"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"核心用途"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"批量增删改、业务逻辑封装"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据计算、值转换、查询过滤"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"参数类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"支持 IN/OUT/INOUT"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仅 IN（部分库支持 OUT 但不推荐）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"事务 / 结果集"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"支持事务、可返回多个结果集"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无事务、仅返回单个值（无结果集）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"SQL 兼容性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不能嵌入 SQL 语句"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可作为 SQL 子句一部分使用"}]}]}]},{"ID":"20260505170804-bga1tyl","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-bga1tyl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"触发器"}]},{"ID":"20260505170804-baj3drw","Type":"NodeParagraph","Properties":{"id":"20260505170804-baj3drw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"trigger,是一种特殊的存储过程，当值指定事件发生时，系统自动调用。"}]},{"ID":"20260505170804-nkkp2w2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-nkkp2w2","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#创建触发器的语法\ndelimiter //\ncreate trigger 触发器\nafter/before 操作名\t#在xxx操作之前或者之后\non 表名\t\t\t\t#触发操作的表\nfor each row\t\t  #影响每一行\nbegin\t\t\t\t \n\tsql语句;\t\t    #要执行的sql语句\nend\ndelimiter ;\n\n#删除\ndrop trigger if exists 触发器名;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-5ka6el7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5ka6el7","updated":"20260519164241"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"事务"}]},{"ID":"20260505170804-q79jmyf","Type":"NodeParagraph","Properties":{"id":"20260505170804-q79jmyf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"transaction"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库事务是作为单个逻辑单元执行的一系列的 qsl 语句集合，操作要么都执行成功，要么都执行失败"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特性："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原子性：事务是最小的工作单元，不可拆分，要么都执行成功，要么都不执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一致性：数据库的完整性约束不能被破坏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"隔离性：并行执行的事务之间是隔离的，保证多个事务之间互相不影响"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"持久性：事务提交以后，改变永久保存到数据库中"}]},{"ID":"20260505170804-4j9c8uw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-4j9c8uw","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#使用事务语法：\nstart transaction;\t#开启事务\nsql 语句;\nsql 语句;\n...\ncommit;\t#提交\nrollback; #回滚\n#提交和回滚只能二选一，不能既要又要\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260519164241-mdrmo2k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164241-mdrmo2k","updated":"20260521124408"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"文件上传跟普通的 post 有什么区别"}]},{"ID":"20260519164241-l8wxag2","Type":"NodeParagraph","Properties":{"id":"20260519164241-l8wxag2","updated":"20260519162731"},"Children":[{"Type":"NodeText","Data":"本质上文件上传也是 POST，区别不在“是不是 POST”，而在于请求体的组织方式不一样"}]},{"ID":"20260519164241-wwdf3tg","Type":"NodeParagraph","Properties":{"id":"20260519164241-wwdf3tg","updated":"20260519163236"},"Children":[{"Type":"NodeText","Data":"普通 POST 一般传的是表单字段或者 JSON，请求体比较简单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件上传通常用的是 multipart/form-data"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会把普通字段和文件内容分成多个部分来传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一部分都有自己的头信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如字段名、文件名、内容类型这些"}]},{"ID":"20260521124408-73x51zi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124408-73x51zi","updated":"20260521103611"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Windows Socket 服务端编程从建立到关闭的主要步骤"}]},{"ID":"20260521124408-pwlac1r","Type":"NodeParagraph","Properties":{"id":"20260521124408-pwlac1r","updated":"20260521102343"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"初始化网络环境"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"windows 下不能直接用 socket，先要调用 WSAStartup 启动 Winsock，指定版本号，确认网络库可用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相当于把 Socket 运行环境先准备好"}]},{"ID":"20260521124408-6k5euuf","Type":"NodeParagraph","Properties":{"id":"20260521124408-6k5euuf","updated":"20260521102510"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"创建服务端套接字并绑定地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先用 socket 创建监听 socket，然后用 bind 绑定本机的 IP 和端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再调用 listen 进入监听状态\t到这一步，服务端就已经在某个端口上等客户端连接了"}]},{"ID":"20260521124408-wsvu2bn","Type":"NodeParagraph","Properties":{"id":"20260521124408-wsvu2bn","updated":"20260521102759"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接收连接并收发数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端一般通过 accept 接收客户端连接，成功后会得到一个新的通信 socket"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这里通常有两个 socket:一个负责监听，一个负责和具体客户端通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后面就可以用 recv 接收数据、用 send 回发数据"}]},{"ID":"20260521124408-4sbk11l","Type":"NodeParagraph","Properties":{"id":"20260521124408-4sbk11l","updated":"20260521102903"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关闭连接和清理资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通信结束后，先用 closesocket 关闭客户端通信 socket"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不再服务时再关闭监听 socket，最后调用 WSACleanup 释放 Winsock 环境"}]},{"ID":"20260521124408-r48jkog","Type":"NodeParagraph","Properties":{"id":"20260521124408-r48jkog","updated":"20260521103611"},"Children":[{"Type":"NodeText","Data":"TCP 面向连接，所以有监听和连接之分；UDP 无连接，所以没有 accept 出来的连接套接字"}]},{"ID":"20260521124408-gb2v1qp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124408-gb2v1qp","updated":"20260521103929"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TCP 流式套接字和 UDP 数据报套接字的主要区别"}]},{"ID":"20260521124408-ipjgmls","Type":"NodeParagraph","Properties":{"id":"20260521124408-ipjgmls","updated":"20260521103721"},"Children":[{"Type":"NodeText","Data":"TCP 是流式的，UDP 是数据报的"}]},{"ID":"20260521124408-2m1iwm2","Type":"NodeParagraph","Properties":{"id":"20260521124408-2m1iwm2","updated":"20260521103838"},"Children":[{"Type":"NodeText","Data":"TCP 面向连接，先建立连接再通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传输时把数据当成“连续字节流”，没有消息边界，可能粘包或拆包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但保证可靠、有序、重传、流控"}]},{"ID":"20260521124408-8i75163","Type":"NodeParagraph","Properties":{"id":"20260521124408-8i75163","updated":"20260521103929"},"Children":[{"Type":"NodeText","Data":"UDP 不需要建连，发送的是一条条独立数据报，保留消息边界，收发简单、延迟低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但不保证一定到达，也不保证顺序"}]},{"ID":"20260521124408-f3enmbn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124408-f3enmbn","updated":"20260521105331"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ACK 确认机制怎么做"}]},{"ID":"20260521124408-14h8p4e","Type":"NodeParagraph","Properties":{"id":"20260521124408-14h8p4e","updated":"20260521104510"},"Children":[{"Type":"NodeText","Data":"TCP 里 ACK 是“确认收到”的机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发送方发出数据后，会给每个字节编序号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接收方收到后返回 ACK，告诉发送方“我已经收到哪一个序号之前的数据了”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 通常用累计确认，比如 ACK"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"="}]},{"Type":"NodeText","Data":"1001，表示 1000 及之前的字节都收到了"}]},{"ID":"20260521124408-h4z2vka","Type":"NodeParagraph","Properties":{"id":"20260521124408-h4z2vka","updated":"20260521105331"},"Children":[{"Type":"NodeText","Data":"如果发送方一直收不到 ACK，或者超时了，就会认为丢包，触发重传"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若收到重复 ACK，还可能提前判断中间有包丢了，走快速重传"}]},{"ID":"20260505170804-1a9uzqb","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-1a9uzqb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"网络场景题"}]},{"ID":"20260505170804-4aemrk6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4aemrk6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"当键入网址后到网页显示，其间发生了什么\t\u003e\u003e"}]},{"ID":"20260505170804-g8756aa","Type":"NodeParagraph","Properties":{"id":"20260505170804-g8756aa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"输入网址后，浏览器先检查网址合法与否，拆出协议、域名、端口这些信息"}]},{"ID":"20260505170804-lesovu0","Type":"NodeParagraph","Properties":{"id":"20260505170804-lesovu0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"接着查 HTTP 强制缓存，命中且没过期，直接用本地缓存，不做任何网络操作；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没命中，就继续往下走。"}]},{"ID":"20260505170804-pa0izls","Type":"NodeParagraph","Properties":{"id":"20260505170804-pa0izls","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果是域名，就走 DNS 解析，先查浏览器、系统、路由器、运营商的缓存，都没有就问根 DNS、顶级域名 DNS、权威 DNS，最终拿到服务器 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 IP 就直接用"}]},{"ID":"20260505170804-ycwwa3h","Type":"NodeParagraph","Properties":{"id":"20260505170804-ycwwa3h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"拿到 IP 后，浏览器用 80（HTTP）或 443（HTTPS）端口，通过 TCP 三次握手和服务器建立连接"}]},{"ID":"20260505170804-exp012r","Type":"NodeParagraph","Properties":{"id":"20260505170804-exp012r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"（"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层封装：每个报文都会经过："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主机构建 IP 数据报，确定源 IP 和目标 IP，查路由表找下一跳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 ARP 获取下一跳 MAC 地址，先查 ARP 缓存，没有则发 ARP 请求，交换机根据 MAC 地址转发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再给 IP 数据报加 MAC 头部，变成数据帧"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后把数据帧转成电信号、光信号或无线信号，通过物理介质以比特流形式传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"）"}]},{"ID":"20260505170804-rmeutxj","Type":"NodeParagraph","Properties":{"id":"20260505170804-rmeutxj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果是 HTTPS，在 TCP 三次握手之后，会多一步 TLS 握手，协商加密、验证证书、生成密钥，保证安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连接建立好，浏览器发送 HTTP 请求，带上请求方法、请求头、Cookie，以及协商缓存标识"}]},{"ID":"20260505170804-e3xqkqh","Type":"NodeParagraph","Properties":{"id":"20260505170804-e3xqkqh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务器判断资源是否更新，没更新就返回 304，浏览器继续使用本地缓存；更新了就返回 200 和新内容"}]},{"ID":"20260505170804-ym232jm","Type":"NodeParagraph","Properties":{"id":"20260505170804-ym232jm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"请求会经过负载均衡、Nginx，再到后端服务处理业务、查数据库，最后服务器返回响应结果和页面内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据传完，用 TCP 四次挥手断开连接，也可以用长连接复用"}]},{"ID":"20260505170804-samw02g","Type":"NodeParagraph","Properties":{"id":"20260505170804-samw02g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"浏览器拿到页面内容后，解析 HTML 生成 DOM 树，解析 CSS 生成样式树，合并成渲染树，经过布局、绘制，展示出页面。加载时，CSS 阻塞渲染，JS 默认阻塞解析和渲染，图片、视频异步加载，不影响页面显示"}]},{"ID":"20260505170804-lsts9se","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lsts9se","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"三次握手四次挥手场景题"}]},{"ID":"20260505170804-3drzh2i","Type":"NodeParagraph","Properties":{"id":"20260505170804-3drzh2i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端 -\u003e 服务端：发 SYN 客户端状态：CLOSED → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SYN_SENT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端 -\u003e 客户端：回 SYN + ACK 服务端状态：LISTEN → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SYN_RCVD"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端 -\u003e 服务端：发 ACK 客户端状态：SYN_SENT → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ESTABLISHED"},{"Type":"NodeText","Data":" 服务端收到后：SYN_RCVD → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ESTABLISHED"}]},{"ID":"20260505170804-cw37k2g","Type":"NodeParagraph","Properties":{"id":"20260505170804-cw37k2g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主动方 -\u003e 被动方：发 FIN 主动方：ESTABLISHED → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"FIN_WAIT1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"被动方 -\u003e 主动方：回 ACK 被动方：ESTABLISHED → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CLOSE_WAIT"},{"Type":"NodeText","Data":" 主动方收到：FIN_WAIT1 → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"FIN_WAIT2"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"被动方 -\u003e 主动方：发 FIN（自己也要关）被动方："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CLOSE_WAIT"},{"Type":"NodeText","Data":" → "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"LAST_ACK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主动方 -\u003e 被动方：回 ACK 主动方：FIN_WAIT2 → TIME_WAIT 等 2MSL 后 → CLOSED 被动方收到 ACK → LAST_ACK → CLOSED"}]},{"ID":"20260505170804-23g0k4t","Type":"NodeParagraph","Properties":{"id":"20260505170804-23g0k4t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"三次握手双方都要确认序列号是新的"}]},{"ID":"20260505170804-1ytf3hn","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1ytf3hn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"三次握手时，客户端发送的 SYN 包丢失，会发生什么？"}]},{"ID":"20260505170804-2mv84zt","Type":"NodeParagraph","Properties":{"id":"20260505170804-2mv84zt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端启动重传定时器，如果超时未收到 SYN+ACK 重传 SYN 包，通常重传 3-5 次；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端因未收到 SYN，不会有任何响应，也不会分配连接资源；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若客户端多次重传仍无结果，会判定连接建立失败，终止三次握手流程，不会建立 TCP 连接。"}]},{"ID":"20260505170804-8w26qw5","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-8w26qw5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"三次握手时，服务端回复的 SYN+ACK 丢失，会怎样？"}]},{"ID":"20260505170804-82j6e76","Type":"NodeParagraph","Properties":{"id":"20260505170804-82j6e76","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端没收到，会重传 SYN；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端发完会重传 SYN+ACK，一直没等到 ACK 就释放半连接；"}]},{"ID":"20260505170804-8iqsypx","Type":"NodeParagraph","Properties":{"id":"20260505170804-8iqsypx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"此外，这种场景若被滥用（伪造 SYN），会导致服务端半连接队列满，引发 SYN Flood 攻击"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为了记住握手状态，等客户端 ACK，需要普通半连接队列。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用解决方案是开启 SYN Cookie，不存半连接，用加密算法把信息藏在序列号里。"}]},{"ID":"20260505170804-nbcs05t","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-nbcs05t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"三次握手完成后，客户端突然断电，服务端会怎样？"}]},{"ID":"20260505170804-60joyme","Type":"NodeParagraph","Properties":{"id":"20260505170804-60joyme","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一开始还是 ESTABLISHED 状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有两种情况会发现："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端自己要发数据了 ，发出去没人回 ，重传 ，发现断了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一直没数据发 ， 等 TCP 保活定时器超时 ，发探针 ，发现断了"}]},{"ID":"20260505170804-6d7gky8","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-6d7gky8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"四次挥手时，客户端发送 FIN 后，服务端未立即发送 FIN，为什么？"}]},{"ID":"20260505170804-btdjswu","Type":"NodeParagraph","Properties":{"id":"20260505170804-btdjswu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端发 FIN，只是关掉自己发数据的方向"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务端可能还有数据没发完，所以先回 ACK，等发完了，再发自己的 FIN 关掉另一个方向，这就是四次挥手的原因。"}]},{"ID":"20260505170804-0rke2yc","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-0rke2yc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"四次挥手时，客户端发送的最后一个 ACK 丢失，会发生什么？"}]},{"ID":"20260505170804-34vcl6r","Type":"NodeParagraph","Properties":{"id":"20260505170804-34vcl6r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务端重传 FIN"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端在 TIME_WAIT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果收到了服务端重传的 FIN，客户端会重新发一次 ACK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果没收到重传的 FIN，客户端什么都不发，只等 2MSL 超时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不管最后那个 ACK 有没有到，服务端最终一定会关掉连接，只是比客户端晚一点。"}]},{"ID":"20260505170804-1971ctt","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1971ctt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么 TIME_WAIT 状态需要等待 2MSL？"}]},{"ID":"20260505170804-7hwmhux","Type":"NodeParagraph","Properties":{"id":"20260505170804-7hwmhux","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一是确保最后那个 ACK 能让服务端收到，如果丢了，服务端重传的 FIN 能在这段时间里到达，客户端可以再发一次 ACK；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是让网络里旧的数据包彻底消失，避免干扰后面的连接。"}]},{"ID":"20260505170804-5j8n9uk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5j8n9uk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"高并发短连接场景下，服务器出现大量 TIME_WAIT 是什么原因？\t\u003e\u003e"}]},{"ID":"20260505170804-prryuxz","Type":"NodeParagraph","Properties":{"id":"20260505170804-prryuxz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在高并发短连接场景下，服务端是主动关闭连接的一方，按照 TCP 协议，主动关闭端会进入 TIME_WAIT 状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要等待 2MSL 才能释放端口和文件句柄"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"短连接本身请求完就关闭，高并发下大量连接不断进入 TIME_WAIT 并堆积，最终占用大量端口和 fd，导致新连接无法建立"}]},{"ID":"20260505170804-rx3fa42","Type":"NodeParagraph","Properties":{"id":"20260505170804-rx3fa42","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决思路主要从内核参数优化和业务架构两方面入手："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"参数上，开启 tcp_tw_reuse=1 允许复用 TIME_WAIT 端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开启 tcp_tw_recycle=1 开启 TIME_WAIT 快速回收，加快主动关闭连接的释放速度\t\t\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把 tcp_fin_timeout=30  把 FIN 等待超时从默认 60 秒调低到 30 秒，让连接在半关闭状态下更快释放资源"}]},{"ID":"20260505170804-cd7eba6","Type":"NodeParagraph","Properties":{"id":"20260505170804-cd7eba6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时扩大端口范围 ip_local_port_range，并调高文件描述符上限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"业务层面尽量使用长连接和连接池，减少频繁建连断连，从根源上减少 TIME_WAIT 的产生"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调大系统端口范围和文件描述符上限，提升并发承载能力"}]},{"ID":"20260505170804-ohtt1ud","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ohtt1ud","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于心跳的场景题"}]},{"ID":"20260505170804-gmk44et","Type":"NodeParagraph","Properties":{"id":"20260505170804-gmk44et","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 心跳主要用来保住长连接，解决 TCP 本身感知不到断开的问题。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 自带内核 Keep‑Alive，但默认 2 小时才探测，太慢不实用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平时说的心跳，一般指应用层自己发的检测包，更灵活、更可控。"}]},{"ID":"20260505170804-ds7xgm1","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ds7xgm1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"应用层心跳，设置 5 秒发送一次、10 秒未回复则断连，是否合理？为什么？"}]},{"ID":"20260505170804-bz18bg0","Type":"NodeParagraph","Properties":{"id":"20260505170804-bz18bg0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不合理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是网络抖动时，心跳包延迟会被误判为断连，导致正常连接被误关；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是高并发场景下，高频心跳会产生大量无效包，占用带宽和 CPU。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"合理配置要满足：周期 ≥2-3 倍网络 RTT，超时时间 ≥2-3 倍周期，同时心跳包要轻量化，平衡感知速度和资源开销。"}]},{"ID":"20260505170804-ppqtj0s","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ppqtj0s","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"服务端收到客户端的心跳包，但回复的心跳响应丢失，服务端会怎么处理？客户端呢？"}]},{"ID":"20260505170804-enj3a1t","Type":"NodeParagraph","Properties":{"id":"20260505170804-enj3a1t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务端不会重传响应，会等待客户端下一个心跳，连续多次收不到才判定断连"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端会触发心跳重试，重试失败后主动断连重连"}]},{"ID":"20260505170804-k54p8xm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-k54p8xm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"高并发长连接场景（如百万级 WebSocket/IM 连接），如何设计心跳机制？避免心跳压垮服务端？"}]},{"ID":"20260505170804-lpu6lux","Type":"NodeParagraph","Properties":{"id":"20260505170804-lpu6lux","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一是服务端批量广播心跳，减少包量；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是核心连接短周期、普通连接长周期，差异化配置；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三是被动心跳，有业务数据时顺带发心跳；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时结合服务端限流和内核 Keep-Alive，平衡感知速度和资源开销，避免心跳压垮服务端。"}]},{"ID":"20260505170804-gyth5c7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-gyth5c7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"心跳机制中，为什么要区分 “应用层心跳” 和 “内核层 TCP Keep-Alive”？两者如何配合？"}]},{"ID":"20260505170804-abhf2pr","Type":"NodeParagraph","Properties":{"id":"20260505170804-abhf2pr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"两者是互补关系，而非替代。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核 TCP Keep-Alive 是基础保活，轻量但感知慢、不灵活"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用层心跳是业务侧的增强方案，可自定义周期和逻辑，秒级感知异常。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际开发中，核心连接用应用层心跳保证感知速度，普通连接用内核 Keep-Alive 降低开销，两者配合，兼顾可靠性和资源效率。"}]},{"ID":"20260505170804-1qub1lv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1qub1lv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"客户端重连后，服务端如何区分 “新连接” 和 “旧连接的重连”？心跳机制如何辅助？"}]},{"ID":"20260505170804-gpzr321","Type":"NodeParagraph","Properties":{"id":"20260505170804-gpzr321","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"重连时靠唯一标识设备 ID / 会话 ID 区分新旧连接："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端带上标识，服务端一查就知道是同一个用户重连，直接踢掉旧连接、建新连接；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"心跳包也带上这个标识，防止新旧连接混乱"}]},{"ID":"20260505170804-ck9czs9","Type":"NodeParagraph","Properties":{"id":"20260505170804-ck9czs9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"扩展"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"心跳优先级低于业务包，拥塞时先传业务，心跳可延后。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"心跳超时避免重复重连：用幂等、限流、指数退避防止雪崩。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不靠 FIN 判断连接：断电、断网时不会发 FIN，必须用心跳主动检测。"}]},{"ID":"20260505170804-xsgh1fq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xsgh1fq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网页非常慢转圈圈的时候，要定位问题需要从哪些角度？\t\u003e\u003e"}]},{"ID":"20260505170804-x294e77","Type":"NodeParagraph","Properties":{"id":"20260505170804-x294e77","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"抓包排查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先确定是服务端的问题，还是客户端的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先确认浏览器是否可以访问其他网站，如果不可以，说明客户端网络自身的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后检查客户端网络配置（连接 wifi 正不正常，有没有插网线）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果可以正常其他网页，说明客户端网络是可以正常上网的"}]},{"ID":"20260505170804-0ac4896","Type":"NodeParagraph","Properties":{"id":"20260505170804-0ac4896","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果客户端网络没问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就抓包确认 DNS 是否解析出了 IP 地址，如果没有解析出来，说明域名写错了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果解析出了 IP 地址，抓包确认有没有和服务端建立三次握手，如果能成功建立三次握手，并且发出了 HTTP 请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但是就是没有显示页面，可以查看服务端返回的响应码："}]},{"ID":"20260505170804-lsg3wfg","Type":"NodeParagraph","Properties":{"id":"20260505170804-lsg3wfg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果是 404 错误码，检查输入的 url 是否正确；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是 500，说明服务器此时有问题；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是 200，F12 看看前端代码有问题导致浏览器没有渲染出页面"}]},{"ID":"20260505170804-wsgcanp","Type":"NodeParagraph","Properties":{"id":"20260505170804-wsgcanp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果客户端网络是正常的，但是访问速度很慢，导致很久才显示出来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时候要看客户端的网口流量是否太大的了，导致 tcp 发生丢包之类的问题"}]},{"ID":"20260505170804-dhv5blc","Type":"NodeParagraph","Properties":{"id":"20260505170804-dhv5blc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"总之就是一层一层有没有插网线，网络配置是否正确、DNS 有没有解析出 IP 地址、"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 有没有三次握手、HTTP 返回的响应码是什么"}]},{"ID":"20260505170804-u3dzfpf","Type":"NodeParagraph","Properties":{"id":"20260505170804-u3dzfpf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"抓包我一般分两种场景：日常快速排查用浏览器 F12 开发者工具，打开 Network 面板刷新页面，就能直接看到 DNS 解析是否成功、TCP 连接状态和 HTTP 响应码；如果要做底层链路排查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就用 Wireshark，选对应网卡后，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dns"},{"Type":"NodeText","Data":" 过滤看域名是否解析出 IP，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tcp"},{"Type":"NodeText","Data":" 过滤确认三次握手是否完成，再用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"http"},{"Type":"NodeText","Data":" 过滤查看请求和服务端返回的响应码，逐层定位问题。"}]},{"ID":"20260505170804-37z2il0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-37z2il0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"server a 和 server b，如何判断两个服务器正常连接？出错怎么办？\t\t\u003e\u003e"}]},{"ID":"20260505170804-xtnebc7","Type":"NodeParagraph","Properties":{"id":"20260505170804-xtnebc7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"判断两台服务器是否正常连接，采用分层排查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先用 ping 测网络层连通性，确认基础网络没问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再用 telnet 或 nc 测目标端口，看 TCP 能不能正常三次握手建立连接\t\ttelnet 目标 IP 端口号\t\tnc -zv 目标 IP 端口号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时结合 TCP 保活机制，定期发探测报文，避免出现假连接、死连接占用资源的情况"}]},{"ID":"20260505170804-ookg7oo","Type":"NodeParagraph","Properties":{"id":"20260505170804-ookg7oo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TCP 保活机制补充"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TCP 保活是 Linux 系统自带的机制，默认空闲 2 小时后，会每隔 75 秒发探测报文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连续 9 次没响应就断开连接，总共要 2 小时 11 分 15 秒"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"注意应用层必须手动开启 SO_KEEPALIVE 选项，这个机制才会生效"}]},{"ID":"20260505170804-y3q7knc","Type":"NodeParagraph","Properties":{"id":"20260505170804-y3q7knc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"出错后的排查 \u0026 解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果连接出错，我会按网络 → 传输 → 应用层排查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先查防火墙、安全组有没有拦端口，路由通不通"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再抓包看 TCP 握手有没有异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后看服务是否正常启动、端口是否被占用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外，TCP 保活默认时间太长，生产环境我会在应用层加自定义心跳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 HTTP 长连接设 60 秒超时，没响应就主动断连重连，更快发现故障"}]},{"ID":"20260505170804-c9gemih","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c9gemih","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"服务端正常启动了，但是客户端请求不到有哪些原因?  如何排查?\t\t\u003e\u003e"}]},{"ID":"20260505170804-1s20uv6","Type":"NodeParagraph","Properties":{"id":"20260505170804-1s20uv6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"遇到接口没响应或者报错，分两步排查："}]},{"ID":"20260505170804-v08fen5","Type":"NodeParagraph","Properties":{"id":"20260505170804-v08fen5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"完全没响应的情况："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先 ping 接口 IP 确认网络通不通，再 telnet 端口看能不能连上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后查服务器防火墙有没有拦端口，客户端有没有开代理导致请求发不出去"}]},{"ID":"20260505170804-rpyqhw6","Type":"NodeParagraph","Properties":{"id":"20260505170804-rpyqhw6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"有响应但返回错误码："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4xx 是客户端问题，400 是参数错，401 是缺 token，403 是权限不够，404 是 URL 不对"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5xx 是服务端问题，500 看服务器日志，502/503/504 是服务挂了或者压力太大、超时了"}]},{"ID":"20260505170804-i67p4hc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-i67p4hc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"服务器 ping 不通但是 http 能请求成功，会出现这种情况吗?什么原因造成的?\t\t\u003e\u003e"}]},{"ID":"20260505170804-6zkjkpd","Type":"NodeParagraph","Properties":{"id":"20260505170804-6zkjkpd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ping 走的是 icmp 协议，http 走的是 tcp 协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有可能服务器的防火墙禁止 icmp 协议，但是 tcp 协议没有禁止，就会出现服务器 ping 不通，但是 http 能请求成果"}]},{"ID":"20260505170804-8g8fryo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8g8fryo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"重放攻击\t\t\u003e\u003e"}]},{"ID":"20260505170804-lrt14pk","Type":"NodeParagraph","Properties":{"id":"20260505170804-lrt14pk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"HTTPS 里的重放攻击，简单说就是有人把你之前发过的合法请求截下来，不破解加密"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接原封不动再发一遍，让服务器误以为是你本人操作，从而干坏事，比如重复转账、重复下单"}]},{"ID":"20260505170804-n8t8skc","Type":"NodeParagraph","Properties":{"id":"20260505170804-n8t8skc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决办法最常用的就是加一次性随机数（nonce）+ 时间戳"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心就是给请求加一个 “过期时间”，防止被无限期重放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次请求都带一个只用一次的随机串，服务器验证过就立刻作废"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时加上很短的有效期，就算被截走也没法再用第二次"}]},{"ID":"20260505170804-v5dh9wa","Type":"NodeParagraph","Properties":{"id":"20260505170804-v5dh9wa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"再配合会话令牌、签名校验，把请求参数一起加密签名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要参数或随机数被改动过，服务器直接拒绝，重放的包就过不了校验，基本就能防住重放攻击了"}]},{"ID":"20260505170804-t2e3wlz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t2e3wlz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果租约的 DHCP 的 IP 地址快过期了会怎么办\t\t\u003e\u003e"}]},{"ID":"20260505170804-9r28qdt","Type":"NodeParagraph","Properties":{"id":"20260505170804-9r28qdt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当 DHCP 客户端的 IP 地址租期快要到期时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设备会主动向之前分配地址的 DHCP 服务器发送"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"续租请求"},{"Type":"NodeText","Data":"，优先尝试续约原来的 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果续租成功，就继续使用该 IP 并刷新租期"}]},{"ID":"20260505170804-onuw5ue","Type":"NodeParagraph","Properties":{"id":"20260505170804-onuw5ue","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果第一次续租没收到服务器响应"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设备会在租期过半、到达 7/8 等关键时间点多次重试"}]},{"ID":"20260505170804-yarb5l4","Type":"NodeParagraph","Properties":{"id":"20260505170804-yarb5l4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"要是一直联系不上原 DHCP 服务器，等到租期彻底到期后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"客户端会放弃当前 IP，重新发送 DHCP Discover 广播"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"去寻找可用的 DHCP 服务器重新获取 IP 地址，避免 IP 失效导致网络断开"}]},{"ID":"20260505170804-3gk40d5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3gk40d5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"DHCP 依赖广播，路由器不转发广播，那是否每个网段都要单独配 DHCP 服务器？\t\t\u003e\u003e"}]},{"ID":"20260505170804-9nr0j5i","Type":"NodeParagraph","Properties":{"id":"20260505170804-9nr0j5i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不是每个网段都必须单独部署 DHCP 服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际中我们会在网关或三层交换机上配置 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"DHCP 中继（DHCP Relay）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"来解决跨网段分配地址的问题"}]},{"ID":"20260505170804-rf4dx2j","Type":"NodeParagraph","Properties":{"id":"20260505170804-rf4dx2j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"DHCP 中继会把客户端发的广播报文转换成单播"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"转发给远端的 DHCP 服务器，再把服务器的响应回传给客户端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样只需要一台集中的 DHCP 服务器，就能为多个不同网段统一分配 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"既简化管理，也不用每个局域网都单独部署服务器"}]},{"ID":"20260505170804-mn7txd2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mn7txd2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"在文件里有大量 ipv4 地址，怎么去找到重复数量最多的 ipv4 地址\t\t\u003e\u003e"}]},{"ID":"20260505170804-nmnhmfp","Type":"NodeParagraph","Properties":{"id":"20260505170804-nmnhmfp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先用哈希表做统计，key 存 IP 字符串，value 存它出现的次数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后一行一行读文件，每读到一个 IP，就把对应计数加一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"全部读完之后，再遍历一遍哈希表，找到计数最大的那个 key，就是重复最多的 IPv4 地址"}]},{"ID":"20260505170804-idgt1i5","Type":"NodeParagraph","Properties":{"id":"20260505170804-idgt1i5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果数据量特别大、内存放不下，就用分治法："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先按 IP 哈希取模，分成多个小文件\t例如：hash(IP) % 3"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证相同 IP 一定在同一个文件里然后对每个小文件单独统计频率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后汇总所有结果再比较最大值就行"}]},{"ID":"20260505170804-ipctn2y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ipctn2y","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"搜谷歌却显示百度，可能的原因\t\t\u003e\u003e"}]},{"ID":"20260505170804-5xtl2my","Type":"NodeParagraph","Properties":{"id":"20260505170804-5xtl2my","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一种可能是本地 hosts 文件被篡改，把 google 的域名解析指向了百度的 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种情况常见于恶意软件、某些优化工具或者手动改过配置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"浏览器访问谷歌域名，实际请求发到了百度服务器"}]},{"ID":"20260505170804-ubaiu6e","Type":"NodeParagraph","Properties":{"id":"20260505170804-ubaiu6e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二种是 DNS 被劫持或污染"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"路由器、运营商或公共 DNS 出了问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查询谷歌 IP 时，返回的却是百度的地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不管是手动设错 DNS，还是网络层面劫持，都会导致访问域名跳转到别的站点"}]},{"ID":"20260505170804-0564lil","Type":"NodeParagraph","Properties":{"id":"20260505170804-0564lil","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三种可能是浏览器被插件或扩展劫持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安装了某些恶意扩展、广告软件，会强制重定向网址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪怕输入正确网址，也会被拦截跳转到百度或其他页面"}]},{"ID":"20260505170804-b1k64f4","Type":"NodeParagraph","Properties":{"id":"20260505170804-b1k64f4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"还有一种是代理或 VPN 配置异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开启了代理但规则出错，或者代理节点本身做了跳转"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"导致谷歌请求被转发到百度，表现出来就是搜谷歌却打开百度页面"}]},{"ID":"20260505170804-d8pdzqv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d8pdzqv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"分布式系统中的网络延迟优化方法 (数据分片、协议压缩)?\t\t\u003e\u003e"}]},{"ID":"20260505170804-gd686qy","Type":"NodeParagraph","Properties":{"id":"20260505170804-gd686qy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分布式网络延迟优化，首先通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据分片"},{"Type":"NodeText","Data":"把大数据拆分成小块并行传输"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"降低单包传输耗时、避免网络拥塞"}]},{"ID":"20260505170804-3y8gqti","Type":"NodeParagraph","Properties":{"id":"20260505170804-3y8gqti","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次对传输数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"协议压缩序列化"},{"Type":"NodeText","Data":"，减小数据包体积，减少网络传输流量与时延"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时结合就近部署、CDN、批量发送、减少网络往返次数，进一步降低分布式系统网络延迟"}]},{"ID":"20260505170804-l0v83np","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-l0v83np","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"网络协议中的流量整形 (Traffic Shaping) 技术？\t\t\u003e\u003e"}]},{"ID":"20260505170804-b09e1o0","Type":"NodeParagraph","Properties":{"id":"20260505170804-b09e1o0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"流量整形是一种主动限速平滑流量的拥塞控制技术"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会把突发、忽快忽慢的数据包缓存排队，按照平稳均匀的速率发送出去"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免网络瞬间拥塞、丢包抖动"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用令牌桶、漏桶算法实现，能平滑突发流量、稳定带宽，提升网络传输稳定性"}]},{"ID":"20260505170804-ynfq1xk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ynfq1xk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何使用 Wireshark 抓取和分析 TCP/UDP 数据包？\t\t\u003e\u003e"}]},{"ID":"20260505170804-sf1lzw5","Type":"NodeParagraph","Properties":{"id":"20260505170804-sf1lzw5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"打开 Wireshark 选择对应网卡开始抓包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先用过滤语句筛选 TCP 或 UDP 数据包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再通过三次握手、四次挥手分析 TCP 连接建立断开流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查看序列号、ACK、窗口大小、时间戳等字段"}]},{"ID":"20260505170804-s3lbaqy","Type":"NodeParagraph","Properties":{"id":"20260505170804-s3lbaqy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"UDP 则直接分析无连接、不可靠、报文短小的特点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时可追踪 TCP 流、查看重传丢包、延迟、乱序等网络异常问题"}]},{"ID":"20260505170804-wnj7xo2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wnj7xo2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"假设客户端和服务器通过 TCP 通信，这时客户端突然断电，服务器是如何关闭这个连接的？"}]},{"ID":"20260505170804-dafjig7","Type":"NodeParagraph","Properties":{"id":"20260505170804-dafjig7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"客户端突然断电，本机系统直接宕掉，没法发出任何 TCP 挥手包"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务器这边连接还停留在建立状态，感知不到对方下线"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能依赖 TCP 保活机制，空闲一段时间后，服务器内核主动发保活探测包"}]},{"ID":"20260505170804-w7f1jnn","Type":"NodeParagraph","Properties":{"id":"20260505170804-w7f1jnn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"连续多次探测都收不到应答，服务器就判定连接已失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接发送 RST 复位包强制断连，回收资源，不走正常四次挥手"}]},{"ID":"20260505170804-86zca3q","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-86zca3q","updated":"20260505170804"}},{"ID":"20260505170804-iyu1y1u","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-iyu1y1u","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"Linux"}]},{"ID":"20260505170804-673mi8b","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-673mi8b","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"Github"}]},{"ID":"20260505170804-fxfr1la","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fxfr1la","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Git 关联设置"}]},{"ID":"20260505170804-jb7r6ro","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-jb7r6ro","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1.设备与 github 账号关联"}]},{"ID":"20260505170804-pen3a5v","Type":"NodeParagraph","Properties":{"id":"20260505170804-pen3a5v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1）ssh -T git@github.com\t#测试本机是否与某个账号绑定过"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2）git config –list  \t\t\t\t#查看 git 相关配置文件列表\tgit config –global user.name 用户名\tgit config –global user.email 邮箱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3）git  init 创建本地仓库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4）ssh-keygen -t  rsa -C “邮箱”\t#生成本地密文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5）git remote add origin ssh 地址\t#为仓库 ssh 创建别名，名 origin"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6）git remote remov origin   \t\t#删除别名"}]},{"ID":"20260505170804-wmv23hd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-wmv23hd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.git 三要素"}]},{"ID":"20260505170804-jffopfk","Type":"NodeParagraph","Properties":{"id":"20260505170804-jffopfk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1）仓库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个仓库中存储一个工程，包含工程的源代码，工程资源文件，配置文件，许可证，自述文档，逻辑存储结构"}]},{"ID":"20260505170804-g7zanms","Type":"NodeParagraph","Properties":{"id":"20260505170804-g7zanms","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"2）分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分支用于存储工程实际内容，实际存储单元，每个仓库都会自带一个默认的主分支，可能 master，也可能是 main"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般分支用于多人协作开发，包含分支创建，分支删除，分支合并，分支选择等\tbrach 相关命令"}]},{"ID":"20260505170804-xu9z42f","Type":"NodeParagraph","Properties":{"id":"20260505170804-xu9z42f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"3）提交"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"commit 提交习惯，可以帮助开发者很好的备份代码，有完整的开发的流程和脉络，可以保证开发进度，而且配备份代码，可能回溯"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要拥有良好的提交习惯"}]},{"ID":"20260505170804-o60he98","Type":"NodeParagraph","Properties":{"id":"20260505170804-o60he98","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3.了解掌握 git 命令，才能很好的使用 git 软件进行版本控制"}]},{"ID":"20260505170804-xbaehsu","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-xbaehsu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"4.本地内容上传云端仓库的过程"}]},{"ID":"20260505170804-nc1igdt","Type":"NodeParagraph","Properties":{"id":"20260505170804-nc1igdt","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260106204631652"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260106204631652.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-3ujn2hd","Type":"NodeParagraph","Properties":{"id":"20260505170804-3ujn2hd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"git add test.cpp \t#向缓冲区添加数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git rm test.cpp\t   "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"将数据从缓冲区删除"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git restore file \t   "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"将数据还原"}]},{"ID":"20260505170804-6c71bpq","Type":"NodeParagraph","Properties":{"id":"20260505170804-6c71bpq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果云端的版本与本地不一致，导致本地内容无法成功 push，这时先 pull，将版本一致化，而后再推"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git pull –rebase origin master"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三种方式处理：\tgit rebase –skip\tgit rebase –continue\tgit rebase –abort"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git push origin master\t#版本处理完毕之后"}]},{"ID":"20260505170804-67kg7cn","Type":"NodeParagraph","Properties":{"id":"20260505170804-67kg7cn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"删除"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"rm 代码  -rf"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git rm 代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git commit"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git push\t\t\t\t\t\t\t\t本地仓库内容删除，会同步到云端"}]},{"ID":"20260505170804-2lof81q","Type":"NodeParagraph","Properties":{"id":"20260505170804-2lof81q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"git clone HTTPS 地址\t\t#打包下载开源工程"}]},{"ID":"20260505170804-cekxugi","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-cekxugi","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"正则技术"}]},{"ID":"20260505170804-s4osjwc","Type":"NodeParagraph","Properties":{"id":"20260505170804-s4osjwc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一般用于数据查询，数据匹配，采用贪心算法完成数据的匹配模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统 str 函数，strcmp,strncmp,strstr"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正则语句由特殊符号和表达式构成的特殊语句，采用这个语句匹配目标数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持绝对查询，支持模糊查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正则语句是一个描述数据规则的字符串，数据的规则越清晰，使用正则越方便"}]},{"ID":"20260505170804-l8mck37","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-l8mck37","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"正则表达式符号"}]},{"ID":"20260505170804-fl0v8jo","Type":"NodeParagraph","Properties":{"id":"20260505170804-fl0v8jo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"grep\t‘表达式’\t文件名"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"grep  -v \t输出"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不包含"},{"Type":"NodeText","Data":"指定匹配模式的所有行"}]},{"ID":"20260505170804-xa51e8m","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"c2hlbGw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-xa51e8m","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"c2hlbGw="},{"Type":"NodeCodeBlockCode","Data":"* \t一般以前一个表达式为参照，表示该表达式出现0次或多次\ngrep 'a*' test\t\n\n\\+   以前一个表达式为参照，表示该表达式出现1次或多次    #必须使用转义\ngrep 'a\\+' test\n\n.\t无需参照物，可以表示任意字符一次\n\n？\t表示字符0次或1次\n\n^\t以后一个表达式为参照，该表达式为行首\ngrep '^h' test\n\n$\t以前一个表达式为参照，该表达式为行尾最后一个字符\ngrep 'l$' test\n\n[]\t表达式集合(字符集合)，集合中可以有多个原子，当此集合出现时 表示任意一个元素\ngrep '[abc]' test\ngrep '[a-zA-Z0-9]ood' test\ngrep '[^A-Z]' test\na-z A-Z 0-9 表示不同集合 [^]集合元素取非\n\n\\{n\\}\t 以前一个表达式为参照，表示该表达式连续出现n次\n\\{n,m\\}\t指定频率，n最少连续出现次数，m最大次数\t按最大m匹配，从大到小\n\n\\(power\\)\\+\t创建表达式\ngrep '\\(power\\)\\+'  test\ngrep '^\\(power\\)\\+$'  test\t找行头行尾power\n\ngrep '^1[3-9][0-9]\\{9\\}$'\t找正确手机号\ngrep '^[a-zA-Z0-9]\\{8,15}@[^\\.]\\+\\.(com\\)$'\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-4oo7key","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-4oo7key","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"匹配模式"}]},{"ID":"20260505170804-1b9nayv","Type":"NodeParagraph","Properties":{"id":"20260505170804-1b9nayv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"贪婪模式，非贪婪模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"贪婪模式：尽可能匹配多个结果返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非贪婪模式：匹配一个结果返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"？可以用于切换非贪婪"}]},{"ID":"20260505170804-63c7xis","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-63c7xis","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"程序中使用正则表达式"}]},{"ID":"20260505170804-60rs9gq","Type":"NodeParagraph","Properties":{"id":"20260505170804-60rs9gq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include"},{"Type":"NodeText","Data":" \u003cregex.h\u003e"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"regex_t \t#正则类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260127142926560"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260127142926560.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"成功返回 0，如果没有结果返回 REG_NOMATCH"}]},{"ID":"20260505170804-mpusgvk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-mpusgvk","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cfcntl.h\u003e\n#include \u003csys/mman.h\u003e\n#include \u003csys/stat.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cregex.h\u003e\n\nint main(void)\n{\n    // 定义正则表达式字符串，用于匹配HTML中的\u003ca\u003e标签\n    // 正则解读：\n    // \u003ca[^\u003e]+        匹配\u003ca开头，后面跟任意非\u003e的字符（至少1个）\n    // \\?href=\"       匹配href=\"（转义是为了符合C语言字符串语法，实际正则中是href=\"）\n    // \\([^\\\"]\\+\\?\\)  捕获组1：匹配href属性内的内容（任意非\"的字符，至少1个），对应链接地址\n    // \"[^\u003e]+\\?\u003e      匹配href闭合后的剩余标签内容，直到\u003e结束\n    // \u003c\\([^\u003c]\\+\\?\\)  捕获组2：捕获\u003ca\u003e标签内的文本内容，对应链接标题\n    // \u003c/a\u003e           匹配\u003c/a\u003e闭合标签\n    char * regstr = \"\u003ca[^\u003e]+\\\\?href=\\\"\\\\([^\\\"]\\\\+\\\\?\\\\)\\\"[^\u003e]+\\\\?\u003e\u003c\\\\([^\u003c]\\\\+\\\\?\\\\)\u003c/a\u003e\";\n    // -------------- 第一步：文件操作 - 打开文件并获取文件大小 --------------\n    int fd;\n    fd = open(\"test\",O_RDWR);\n    // 通过将文件指针移动到文件末尾，获取文件的总字节大小（lseek返回偏移量，即文件大小）\n    int size = lseek(fd,0,SEEK_END);\n    // -------------- 第二步：内存映射 - 将文件数据映射到进程内存空间 --------------\n    // 定义指向映射内存区域的指针，初始化为NULL\n    char * data = NULL;\n    data = mmap(NULL,size,PROT_READ|PROT_WRITE,MAP_PRIVATE,fd,0);\n    // 文件映射完成后，文件描述符可关闭，不影响已建立的内存映射\n    close(fd);//关闭文件描述符，释放文件相关资源\n    // -------------- 第三步：正则表达式初始化 - 编译正则表达式 --------------\n    // 定义regex_t类型变量，用于存储编译后的正则表达式数据\n    regex_t reg;\n    // 定义正则匹配的捕获组数量（捕获组0是整个匹配的内容，1和2是自定义捕获组，共3个）\n    int regnum = 3;\n    // 定义regmatch_t数组，用于存储每个捕获组的匹配结果（起始偏移量和结束偏移量）\n    regmatch_t match[regnum];\n    regcomp(\u0026reg,regstr,0);\n    // -------------- 第四步：数据存储 - 定义数组存储提取的href和标题 --------------\n    char href[8192];\n    char title[1024];\n    // -------------- 第五步：循环匹配 - 遍历内存中的文件数据，提取所有符合条件的\u003ca\u003e标签 --------------\n    // regexec函数：执行正则匹配，返回0表示匹配成功\n    // 循环条件：只要能从当前data指针位置匹配到符合正则的内容，就继续循环\n    while((regexec(\u0026reg,data,regnum,match,0))==0)\n    {\n        // 匹配成功，先清空href和title数组的原有数据（避免残留脏数据）\n        bzero(href,sizeof(href));  // bzero：将指定内存区域填充为0（字符串结束符'\\0'）\n        bzero(title,sizeof(title));\n        // 提取捕获组1的内容（href链接地址）到href数组\n        // match[1].rm_so：捕获组1匹配内容的起始偏移量（相对于当前data指针）\n        // match[1].rm_eo：捕获组1匹配内容的结束偏移量\n        // 第三个参数：缓冲区大小（匹配内容长度+1，预留字符串结束符位置）\n        // data+match[1].rm_so：指向捕获组1匹配内容的起始地址\n        snprintf(href,match[1].rm_eo - match[1].rm_so + 1,\"%s\",data+match[1].rm_so);\n        // 提取捕获组2的内容（\u003ca\u003e标签内标题文本）到title数组\n        snprintf(title,match[2].rm_eo - match[2].rm_so + 1,\"%s\",data+match[2].rm_so);\n        // 打印提取到的href链接和标题，用制表符分隔\n        printf(\"%s\\t%s\\n\",href,title);\n        data+=match[0].rm_eo;\n    }\n\n    // -------------- 第六步：资源释放 - 释放编译正则表达式占用的内存 --------------\n    regfree(\u0026reg);\n\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-984bg7l","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-984bg7l","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"Process 进程基础"}]},{"ID":"20260505170804-2u9jd6e","Type":"NodeParagraph","Properties":{"id":"20260505170804-2u9jd6e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单任务操作系统(单进程模式，一个时刻只能执行一个任务)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果要在古早时期电脑中执行多个软件， 需要将当前占用的交换出来存储在软盘中，而后执行新任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要让电脑中多个执行单位合理共享使用硬件资源，这也是多任务操作系统的前提"}]},{"ID":"20260505170804-686uzy5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-686uzy5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Process 进程"}]},{"ID":"20260505170804-1jduonw","Type":"NodeParagraph","Properties":{"id":"20260505170804-1jduonw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"操作系统默认的执行单元，可以使用 CPU，内存，磁盘等等系统设备完成特定任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在早期操作系统中，进程确实是最经典的调度单位，在现代操作系统中，线程才是最经典的调度单位"}]},{"ID":"20260505170804-ff3tjf1","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ff3tjf1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"进程的创建"}]},{"ID":"20260505170804-reg79t7","Type":"NodeParagraph","Properties":{"id":"20260505170804-reg79t7","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260107221313891"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260107221313891.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-rzzu0e4","Type":"NodeParagraph","Properties":{"id":"20260505170804-rzzu0e4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可执行文件启动后创建进程\t\t进程是程序的动态表现，进程创建后占用系统资源，完成特定任务"}]},{"ID":"20260505170804-9zlmka4","Type":"NodeParagraph","Properties":{"id":"20260505170804-9zlmka4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程属于系统中的逻辑单位，没有实体"}]},{"ID":"20260505170804-vxp8mwv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-vxp8mwv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"进程的生存空间"}]},{"ID":"20260505170804-u4z1k60","Type":"NodeParagraph","Properties":{"id":"20260505170804-u4z1k60","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260107223231870"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260107223231870.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ypak6hf","Type":"NodeParagraph","Properties":{"id":"20260505170804-ypak6hf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"PCB 进程控制块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"PCB 中包含了 384 项进程信息，其中 pid 是进程 id 操作系统唯一的进程身份标识 ps aux"}]},{"ID":"20260505170804-1bspsrx","Type":"NodeParagraph","Properties":{"id":"20260505170804-1bspsrx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核空间：存储身份信息\t\t\t\t用户空间：存储执行信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程创建时分配的内存地址是虚拟地址"}]},{"ID":"20260505170804-mq27evc","Type":"NodeParagraph","Properties":{"id":"20260505170804-mq27evc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存的基本单位是 Page，1 页等于 4096 字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"四种内存的基本权限，PROT_READ（读） \tPROT_WRITE（写）\tPROT_EXEC（执行权限）\tPROT_NONE（无）"}]},{"ID":"20260505170804-at9boqi","Type":"NodeParagraph","Properties":{"id":"20260505170804-at9boqi","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260107230049947"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260107230049947.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-dar7vjk","Type":"NodeParagraph","Properties":{"id":"20260505170804-dar7vjk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"32 位操作系统内存申请时采用 3 级间接寻页(GB)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"64 位采用 4 级(TB)"}]},{"ID":"20260505170804-vbmaekh","Type":"NodeParagraph","Properties":{"id":"20260505170804-vbmaekh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统中庞杂的映射关系存储在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"虚拟内存映射表"},{"Type":"NodeText","Data":"中，内存管理器负责"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"维护和修改"}]},{"ID":"20260505170804-vb60dka","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-vb60dka","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"保存与恢复处理器现场"}]},{"ID":"20260505170804-em5l4gq","Type":"NodeParagraph","Properties":{"id":"20260505170804-em5l4gq","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260107231057708"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260107231057708.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-1ancz88","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ancz88","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分时复用原则"},{"Type":"NodeText","Data":"结合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保存和恢复现场"},{"Type":"NodeText","Data":"才算是一个合格的多任务系统"}]},{"ID":"20260505170804-0v2gx2c","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-0v2gx2c","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"面试：什么是进程什么是线程？"}]},{"ID":"20260505170804-7e6uma3","Type":"NodeParagraph","Properties":{"id":"20260505170804-7e6uma3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"答：进程，线程就是寄存器和栈，能使用寄存器表示能使用 CPU，CPU 遵循分时复用原则，栈表示 PCB 的内核栈,既可以依照分时复用原则使用 CPU 又可以保存和恢复现场,表示这个东西是一个合格的执行和调度单位"}]},{"ID":"20260505170804-s76b9y1","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-s76b9y1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Linux 进程状态"}]},{"ID":"20260505170804-mkfn3dj","Type":"NodeParagraph","Properties":{"id":"20260505170804-mkfn3dj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"就绪态，运行态，睡眠态，挂起态，终止态，僵尸态，孤儿态"}]},{"ID":"20260505170804-1sygh69","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1sygh69","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Linux 进程开发，进程源语"}]},{"ID":"20260505170804-gu4s7dm","Type":"NodeParagraph","Properties":{"id":"20260505170804-gu4s7dm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"操作系统提供的一系列 API 函数接口，开发者可以使用完成进程功能开发任务、"}]},{"ID":"20260505170804-8bjdb6a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8bjdb6a","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"fork()"},{"Type":"NodeText","Data":"\t//进程创建调用一次创建一个进程"}]},{"ID":"20260505170804-673mrog","Type":"NodeParagraph","Properties":{"id":"20260505170804-673mrog","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260107234032894"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260107234032894.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gksi4ff","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-gksi4ff","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"int main(void)\n{\n    pid_t pid;\n    pid = fork();\n    //fork创建成功，在父进程中返回子进程的pid\n    //在子进程中返回0，如果创建失败返回-1\n    //pid == 33366\n    if(pid \u003e 0){\n        //父进程工作区\n        printf(\"parent Runing...\\n\");\n        while(1);\n    }\n    //pid == 0\n    else if(pid == 0){\n        //子进程工作区\n        printf(\"Child Runing....\\n\");\n        while(1);\n    }else{\n        perror(\"fork call failed\");\n        exit(0);\n    }\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-9cw6z00","Type":"NodeParagraph","Properties":{"id":"20260505170804-9cw6z00","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关于父子进程一起执行 fork 函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108111127733"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108111127733.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"父子进程可以共享 fork 函数栈帧，一人执行函数的一部分，得到两个不同的返回值，便于区分父子进程任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不允许子进程踏出自己的工作区（else if 代码块），子进程执行完自己的代码块通过 exit()结束进程"}]},{"ID":"20260505170804-5xelnk5","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5xelnk5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"父子进程的继承与拷贝"}]},{"ID":"20260505170804-5o6plxx","Type":"NodeParagraph","Properties":{"id":"20260505170804-5o6plxx","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108131542942"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108131542942.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4bvidud","Type":"NodeParagraph","Properties":{"id":"20260505170804-4bvidud","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一版 fork：父进程创建子进程后，将所有的用户层资源拷贝给子进程，如果子进程不需要拷贝继承用户数据，父进程进行了拷贝，这些拷贝开销对子进程，没有任何意义，无意义开销"}]},{"ID":"20260505170804-6e0loxk","Type":"NodeParagraph","Properties":{"id":"20260505170804-6e0loxk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二版 vfork：通过 vfork 创建的子进程是没有 0~3G 用户层数据的，需要使用者自行准备加载进程 0 ~3G 之后才可以使用，vfork 结合 exec 一起使用"}]},{"ID":"20260505170804-se1vmrh","Type":"NodeParagraph","Properties":{"id":"20260505170804-se1vmrh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三版 fork: "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读时共享，写时复制"},{"Type":"NodeText","Data":"机制对父子进程都有效，父进程修改映射数据也要进行复制操作"}]},{"ID":"20260505170804-vz67a44","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-vz67a44","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"关于多次执行 fork，进程创建数量"}]},{"ID":"20260505170804-ile1v97","Type":"NodeParagraph","Properties":{"id":"20260505170804-ile1v97","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork();fork(); fork(); fork();\t答：二的三次方减一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108151858523"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108151858523.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-137yp0d","Type":"NodeParagraph","Properties":{"id":"20260505170804-137yp0d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork();"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"fork()\u0026\u0026fork()||fork()；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"fork();\t\t\t\t\t\t\t\t\t\t\t\t答：23"}]},{"ID":"20260505170804-qfd8jvy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qfd8jvy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"execl()"},{"Type":"NodeText","Data":"\t//进程重载"}]},{"ID":"20260505170804-s3th9tv","Type":"NodeParagraph","Properties":{"id":"20260505170804-s3th9tv","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108152540328"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108152540328.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-q01efyh","Type":"NodeParagraph","Properties":{"id":"20260505170804-q01efyh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"execl(const char*path,”firefox”,”www.baidu.com”,NULL)\t\t//进程重载，最后一个参数一定要传 NULL，表示命令参数传递完毕，不写函数失败"}]},{"ID":"20260505170804-yomlyot","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-yomlyot","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"zombie process 僵尸进程"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108204159201"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108204159201.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-lpc1iu2","Type":"NodeParagraph","Properties":{"id":"20260505170804-lpc1iu2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"子进程退出，资源没有清理完毕(PCB 残留)，子进程为僵尸进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"僵尸进程危害："},{"Type":"NodeText","Data":"\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.内存泄漏，进程结束后内存没有释放完毕，其他人使用此内存产生异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.每个僵尸进程会持续占用一个 PCB，影响新进程创建"}]},{"ID":"20260505170804-ne86m9c","Type":"NodeParagraph","Properties":{"id":"20260505170804-ne86m9c","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"wait 函数在释放 PCB 之前可以从 PCB 中提取子进程退出信息，父进程可以进行验尸操作，进行校验"}]},{"ID":"20260505170804-aunexfq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-aunexfq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"wait()"},{"Type":"NodeText","Data":"\t //进程回收"}]},{"ID":"20260505170804-hq8k1qe","Type":"NodeParagraph","Properties":{"id":"20260505170804-hq8k1qe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"wait 函数是一个阻塞函数，父进程执行后，阻塞等待子进程结束，子进程结束后，wait 回收成功，释放 PCB 资源，返回僵尸进程的 pid"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 wait 返回-1，表示回收失败，例如没有子进程却尝试回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子进程成为僵尸进程，父进程也退出，系统会回收僵尸进程"}]},{"ID":"20260505170804-cjnm2t6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Yw==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-cjnm2t6","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Yw=="},{"Type":"NodeCodeBlockCode","Data":"int main(void)\n{\n    pid_t pid;\n    pid_t zpid;\n    pid=fork();\n    if(pid\u003e0){\n        printf(\"Parent pid %d Waiting\\n\",getpid());\n        zpid=wait(NULL);\n        printf(\"Parent wait success,zpid %d\\n\",zpid);\n        while(1)sleep(1);\n    }else if(pid==0){\n        printf(\"Child pid %d Running\\n\",getpid());\n        sleep(5);\n          exit(0);\n    }else{\n        perror(\"fork call failed\");\n        exit(0);\n    }\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-dlqty5q","Type":"NodeParagraph","Properties":{"id":"20260505170804-dlqty5q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"wait 函数，阻塞回收子进程(僵尸进程)，主动回收方案，阻塞回收会影响父进程任务的执行，在等待过程中无法进行其他操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"zpid=wait(int * status)\t//进程回收，调用一次只回收一个僵尸进程，如果有多个僵尸进程，需要循环调用 wait"}]},{"ID":"20260505170804-m5gijb6","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-m5gijb6","updated":"20260505170804"}},{"ID":"20260505170804-cl3yocq","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-cl3yocq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"waitpid()"},{"Type":"NodeText","Data":"\t//进程回收"}]},{"ID":"20260505170804-q05nx4c","Type":"NodeParagraph","Properties":{"id":"20260505170804-q05nx4c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"pid_t zpid=waitpid(pid_t pid ,int *status,int opt)\t//进程回收"}]},{"ID":"20260505170804-cow09fq","Type":"NodeParagraph","Properties":{"id":"20260505170804-cow09fq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pid \t指定回收方式"},{"Type":"NodeText","Data":"\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"pid\u003e0,指定一个子进程 pid，回收这个子进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-1,回收任意子进程\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108220613603"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108220613603.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-vyz2j66","Type":"NodeParagraph","Properties":{"id":"20260505170804-vyz2j66","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"0，同组回收，只能回收掉与父进程同组的所有子进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"\u003c-1,指定组 id，实现跨组回收"}]},{"ID":"20260505170804-9jlssj0","Type":"NodeParagraph","Properties":{"id":"20260505170804-9jlssj0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"*"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"int"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em em","TextMarkTextContent":"status,暂时传 null"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260108222829020"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260108222829020.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-hjn5qfy","Type":"NodeParagraph","Properties":{"id":"20260505170804-hjn5qfy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"int opt , 工作模式"},{"Type":"NodeText","Data":" \t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WNOHANG,非阻塞关键字，可以让 waitpid 进行非阻塞回收\t非阻塞回收，可以让父进程在回收过程中穿插执行自身的任务"}]},{"ID":"20260505170804-j913qti","Type":"NodeParagraph","Properties":{"id":"20260505170804-j913qti","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"waitpid 返回值，\t\u003e0 表示回收成功，\t-1 表示回收失败，非阻塞返回 0"}]},{"ID":"20260505170804-ieoeake","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Yw==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ieoeake","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Yw=="},{"Type":"NodeCodeBlockCode","Data":"while((zpid=waitpid(-1,NULL,WNOHANG))!=-1){\n    if(zpid==0){\n        //执行一次父进程\n    }else if(zpid\u003e0){\n        printf(\"回收成功，僵尸进程pid %d\\n\",zpid);\n        break;\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-atcru7a","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-atcru7a","updated":"20260505170804"}},{"ID":"20260505170804-7gx9q52","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-7gx9q52","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"实践：多进程拷贝 Demo"}]},{"ID":"20260505170804-3wbmz6g","Type":"NodeParagraph","Properties":{"id":"20260505170804-3wbmz6g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"process_copy\t#代码编译后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"./process_copy 1.jpg 2.jpg 进程数量(缺省值)\t*用户不填写进程数量创建 5 个进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260109131426346"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260109131426346.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-epmaist","Type":"NodeParagraph","Properties":{"id":"20260505170804-epmaist","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"并发程序：根据进程的数量计算任务量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260109131537140"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260109131537140.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-t1foo1x","Type":"NodeParagraph","Properties":{"id":"20260505170804-t1foo1x","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260109172516374"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260109172516374.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gzxrjp7","Type":"NodeParagraph","Properties":{"id":"20260505170804-gzxrjp7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主控型 makefile 复制跳转到变异型 makefile 位置并执行"}]},{"ID":"20260505170804-m6hejqa","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-m6hejqa","updated":"20260505170804"}},{"ID":"20260505170804-fub5ka3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-fub5ka3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"IPC 进程间通信"}]},{"ID":"20260505170804-uo3nhby","Type":"NodeParagraph","Properties":{"id":"20260505170804-uo3nhby","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程间通信的简写是 IPC，可以利用这种技术完成多个进程间的数据传递，信息收发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260110201058507"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110201058507.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-o4wj23g","Type":"NodeParagraph","Properties":{"id":"20260505170804-o4wj23g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"匿名管道(pipe)\t有名管道(fifo)\tPosix 消息队列\tSystemV 消息队列\tMMAP 内存共享映射\tSignal 信号\tSocket 套接字技术"}]},{"ID":"20260505170804-8n6rpdl","Type":"NodeParagraph","Properties":{"id":"20260505170804-8n6rpdl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"绝大多数的进程间通信技术都是利用内核层实现的(内核层共享内存)"}]},{"ID":"20260505170804-1a237u9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1a237u9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"PIPE 匿名管道"}]},{"ID":"20260505170804-iugmfn7","Type":"NodeParagraph","Properties":{"id":"20260505170804-iugmfn7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.流通性(传输介质)\t2.方向性\t3.暂存能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道：先进先出，暂存能力\t\t老版本的 ubuntu 管道大小都是 64k"}]},{"ID":"20260505170804-13d8fdo","Type":"NodeParagraph","Properties":{"id":"20260505170804-13d8fdo","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260110221102310"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110221102310.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-qfmyum5","Type":"NodeParagraph","Properties":{"id":"20260505170804-qfmyum5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"管道创建成功，系统将读写管道的两个文件描述符传出到 fds 中，让用户可以读写适用管道"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"匿名管道具有亲源限制，只有亲源进程间可以利用完成进程通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道使用前要确定通信方向，管道要单工使用，让进程关闭无用的描述符\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*单工：定义通信方向，不可改变，非读即写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*可调节单工：在一个时刻非读即写，不同时刻可切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*全双工：可以同时读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一个指向管道的描述符都是一个引用计数，当管道引用计数为 0，系统会自行释放管道空间"}]},{"ID":"20260505170804-6txsz9a","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Q1BQ","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-6txsz9a","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Q1BQ"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003csys/wait.h\u003e\n#define MSG \"Can u here Me?\"\nint main(void){\n    int fds[2];\n    pipe(fds);\n    pid_t pid;\n    pid=fork();\n    if(pid\u003e0){\n        printf(\"parent %d Send Msg\\n\",getpid());\n        close(fds[0]);\n        write(fds[1],MSG,strlen(MSG));\n        wait(NULL);\n        close(fds[1]);\n    }else if(pid==0){\n         close(fds[1]);\n         char buffer[1024];\n         bzero(buffer,sizeof(buffer));\n         read(fds[0],buffer,sizeof(buffer));\n         printf(\"child Read MSG=%s\\n\",buffer);\n         close(fds[0]);\n         exit(0);\n    }else{\n        perror(\"fork call failed\");\n    }\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-9ndasdr","Type":"NodeParagraph","Properties":{"id":"20260505170804-9ndasdr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"管道为空，写端未写数据，读端读取管道，读阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道为满，读端未读数据，写端写管道，写阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写端关闭，如果管道有数据，读端读取完管道剩余数据后再次读取返回 0；管道为空，直接返回 0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道读端关闭，写端尝试向管道写数据，系统会向写端进程发送 SIGPIPE，杀死写端进程"}]},{"ID":"20260505170804-qauk9z3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-qauk9z3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"面试题：编写一个服务端客户端模型(CS)，可以进行连接和基本数据收发，客户端异常退出，服务器也异常退出，为什么？"}]},{"ID":"20260505170804-5p5c95s","Type":"NodeParagraph","Properties":{"id":"20260505170804-5p5c95s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"send(int sockfd,buffer,len,MSG_NOSIGNAL)\t//如果系统给服务端(写端)发送 SIGPIPE 信号，可以利用 MSG_NOSIGNAL 忽略信号"}]},{"ID":"20260505170804-ocuklg0","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ocuklg0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"匿名管道的缺点"}]},{"ID":"20260505170804-jvrz2hu","Type":"NodeParagraph","Properties":{"id":"20260505170804-jvrz2hu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"亲源限制，只能亲源进程可以使用其完成通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"默认情况下管道使用无格式字节流传输，需要用户自行封装"}]},{"ID":"20260505170804-mxeuxy8","Type":"NodeParagraph","Properties":{"id":"20260505170804-mxeuxy8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"管道这种进程间通信方式，效率较好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在所有的 unix 或 linux 系统，管道都是可以使用的，但是其他系统？"}]},{"ID":"20260505170804-t8n29aq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t8n29aq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"FIFO 有名管道"}]},{"ID":"20260505170804-lccyt3n","Type":"NodeParagraph","Properties":{"id":"20260505170804-lccyt3n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"mkfifo 测试管道\t\t\t//创建管道文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道文件没有存储能力，无法编辑\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"创建管道文件后，系统会在内核层创建一个管道缓冲区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管道文件被删除，立即清理释放管道缓冲区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命名管道使用时也是单工方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"匿名管道的四种情况适用于有名管道"}]},{"ID":"20260505170804-ifm72mz","Type":"NodeParagraph","Properties":{"id":"20260505170804-ifm72mz","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260110231521153"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110231521153.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-c34xsto","Type":"NodeParagraph","Properties":{"id":"20260505170804-c34xsto","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110234559102.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-8gmbo1k","Type":"NodeParagraph","Properties":{"id":"20260505170804-8gmbo1k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"访问命名管道必须满足两种权限(读，写)，才可以成功的打开和使用管道，如果只有一种访问权限，会阻塞等待另一种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单进程只要满足两种访问权限(O_RDWR)，可以直接打开和使用管道"}]},{"ID":"20260505170804-aurr241","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-aurr241","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"有名管道使用时的特殊情况"}]},{"ID":"20260505170804-9es2v3i","Type":"NodeParagraph","Properties":{"id":"20260505170804-9es2v3i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​\t\t权限要求，有名管道要求满足两种访问权限才可以打开使用管道，否则要阻塞等待另一种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"​\t\t如果在一个进程中有多个读序列，阻塞只会对第一个读序列生效，其他都会设置非阻塞（多线程为进程读取数据，一个线程阻塞等待即可，其他线程设置非阻塞立即返回，执行其他任务，避免阻塞开销）"}]},{"ID":"20260505170804-in4f7y9","Type":"NodeParagraph","Properties":{"id":"20260505170804-in4f7y9","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260110232752209"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110232752209.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ylz5mcb","Type":"NodeParagraph","Properties":{"id":"20260505170804-ylz5mcb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"​       "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原子使用管道"},{"Type":"NodeText","Data":" (传输速度较慢，但是数据的完整性比较好) 和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"非原子使用管道"},{"Type":"NodeText","Data":" (传输效率高，无法保证数据的完整性)"}]},{"ID":"20260505170804-6y74w5s","Type":"NodeParagraph","Properties":{"id":"20260505170804-6y74w5s","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260110235558267"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260110235558267.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-zdt4frq","Type":"NodeParagraph","Properties":{"id":"20260505170804-zdt4frq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"原子写管道，一次写的大小小于等于管道大小(原子访问)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统会检测管道余量，如果写端的大小大于管道余量，系统会挂起写端进程，等管道余量满足写需求大小，再唤醒写端继续写"}]},{"ID":"20260505170804-uqchfsg","Type":"NodeParagraph","Properties":{"id":"20260505170804-uqchfsg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"非原子写管道，每次写的大小大于等于管道大小，非原子访问情况下，系统不会控制写端，只要管道缓冲区有余量，写端可以立即写入数据。管道满时才挂起。传输效率高，但是读端读取数据后要校验完整性，避免数据包的异常"}]},{"ID":"20260505170804-97b5gx5","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-97b5gx5","updated":"20260505170804"}},{"ID":"20260505170804-fn67p18","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-fn67p18","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"MMAP 文件共享映射"}]},{"ID":"20260505170804-mooswk1","Type":"NodeParagraph","Properties":{"id":"20260505170804-mooswk1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"void *ptr =mmap(NULL,映射大小，PROT_READ|PROT_WRITE ，映射方式，文件描述符，映射偏移量)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113143817550"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113143817550.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-z9a6djf","Type":"NodeParagraph","Properties":{"id":"20260505170804-z9a6djf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"私有映射：拷贝映射，将映射文件的数据拷贝一份到映射内存，两份数据独立无关联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享映射：同步映射，将映射文件的数据映射一份给进程，两份数据建立同步机制，对一份数据的修改马上更新给另一份"}]},{"ID":"20260505170804-jwjubh6","Type":"NodeParagraph","Properties":{"id":"20260505170804-jwjubh6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.映射内存的地址，如果传 null，系统自行分配映射内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.映射内存大小一般是文件大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.映射内存的权限 PROT_READ|PROT_WRITE|PROT_EXEC|PROT_NONE"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.共享映射(MAP_SHARED)\t私有映射(MAP_PRIVATE)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.映射文件的描述符，映射时使用访问磁盘数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6.映射偏移量，mmap 支持偏移映射，每次映射一部分"}]},{"ID":"20260505170804-3gwbp50","Type":"NodeParagraph","Properties":{"id":"20260505170804-3gwbp50","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"释放映射：munmap(void *ptr,映射大小)"}]},{"ID":"20260505170804-1qxqw7o","Type":"NodeParagraph","Properties":{"id":"20260505170804-1qxqw7o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用 mmap 完成通信，也是确定通信方向，一个负责编辑修改映射内存，一个负责显示打印映射内存数据，不要让两端同时修改访问映射内存，会出现数据异常"}]},{"ID":"20260505170804-66zuk9e","Type":"NodeParagraph","Properties":{"id":"20260505170804-66zuk9e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"映射成功返回 ptr，映射内存地址，失败返回 MAP_FAILED 关键字"}]},{"ID":"20260505170804-bm23wly","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-bm23wly","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"int main(void){\n    int fd = open(\"Map_File\", O_RDWR);\n    int size;\n    size = lseek(fd, 0, SEEK_END);//获取文件大小\n    int * ptr = NULL;\n    if((ptr = mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0))==MAP_FAILED){\n        perror(\"mmap call failed\");\n        exit(0);\n    }\n    close(fd);\n    //修改映射内存数据， 让它同步给文件\n    ptr[0] = 0x34333231;\n    munmap(ptr,size);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3ak2fc8","Type":"NodeParagraph","Properties":{"id":"20260505170804-3ak2fc8","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113160637459"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113160637459.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-9u6nyxb","Type":"NodeParagraph","Properties":{"id":"20260505170804-9u6nyxb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MMAP 是否可以读写映射，取决于文件的打开权限，如果打开文件时有足够的权限，那么可以进行读写映射，映射的权限小于等于文件的权限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113161844989"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113161844989.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-f6z5j8l","Type":"NodeParagraph","Properties":{"id":"20260505170804-f6z5j8l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"/0 截断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"映射文件拓展为结构体消息大小。\t想缓存 4K 条数据：结构体大小乘 4096"}]},{"ID":"20260505170804-07vqbhi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-07vqbhi","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"写端代码\n//0x1000 = 4096\n//0x10000 = 65536\n//0x100000 = 1m\n\ntypedef struct\n{\n    int id;\n    char date[1024];\n}msg_t;\n\nint main(void){\n    int fd = open(\"Map_File\",O_RDWR);\n    //拓展文件\n    ftruncate(fd,sizeof(msg_t));\n    msg_t * ptr = NULL;\n    if((ptr = mmap(NULL,sizeof(msg_t),PROT_READ|PROT_WRITE,MAP_SHARED,fd, 0))==MAP_FAILED){\n        perror(\"mmap call failed\");\n        exit(0);\n    }\n    close(fd);\n    //持续向映射内存写入数据\n    ptr-\u003eid = 0;\n    bzero(ptr-\u003edate,1024);\n    while(1){\n        ++(ptr-\u003eid);\n        sprintf(ptr-\u003edate,\"test message , msg id %d\",ptr-\u003eid);\n        sleep(1);\n    }\n    munmap(ptr,sizeof(msg_t));\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-py69oqh","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-py69oqh","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"读端\ntypedef struct\n{\n    int id;\n    char date[1024];\n}msg_t;\n\nint main(void){\n    int fd = open(\"Map_File\",O_RDWR);\n\n    msg_t * ptr = NULL;\n    if((ptr = mmap(NULL,sizeof(msg_t),PROT_READ|PROT_WRITE,MAP_SHARED,fd, 0))==MAP_FAILED){\n        perror(\"mmap call failed\");\n        exit(0);\n    }\n    close(fd);\n\n    //持续显示映射内存数据\n    while(1){\n        printf(\"msgid = %d , msg = %s\\n\",ptr-\u003eid,ptr-\u003edate);\n        sleep(1);\n    }\n    munmap(ptr,sizeof(msg_t));\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-myjbklw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-myjbklw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于 MMAP 的同步机制"}]},{"ID":"20260505170804-qg0o5qi","Type":"NodeParagraph","Properties":{"id":"20260505170804-qg0o5qi","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113202032446"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113202032446.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-5kuz5zu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5kuz5zu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"从文件中读取数据 read"}]},{"ID":"20260505170804-8g80gxd","Type":"NodeParagraph","Properties":{"id":"20260505170804-8g80gxd","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113203000212"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113203000212.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-36p05io","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-36p05io","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ZERO-COPY 零拷贝"}]},{"ID":"20260505170804-8zsdhx2","Type":"NodeParagraph","Properties":{"id":"20260505170804-8zsdhx2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"零拷贝技术在网络通信时可以减少网络开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Send File"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260113210312800"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260113210312800.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-n22p3ku","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-n22p3ku","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"使用 mmap 引发的异常"}]},{"ID":"20260505170804-gs784jq","Type":"NodeParagraph","Properties":{"id":"20260505170804-gs784jq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"映射内存的大小不要大于文件实际大小，因为在映射时要加载文件大小来设置映射内存的可用大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在进行映射时，一般要看映射文件的大小，如果映射内存与映射文件大小不符，在访问内存时产生总线错误，系统向进程发送 SIGBUS，杀死进程"}]},{"ID":"20260505170804-gyrzgrk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-gyrzgrk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"进程关系"}]},{"ID":"20260505170804-5as70hb","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5as70hb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"亲缘关系"}]},{"ID":"20260505170804-my5djtp","Type":"NodeParagraph","Properties":{"id":"20260505170804-my5djtp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 操作系统下，进程间的关系是强亲缘(父子),弱亲缘(爷孙)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"爷爷进程与孙子进程最低限度亲缘(继承关系)"}]},{"ID":"20260505170804-7zmx2rh","Type":"NodeParagraph","Properties":{"id":"20260505170804-7zmx2rh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强亲缘关系(父子进程),子进程被父进程创建,子进程的任务被父进程指定，继承父进程数据，子进程结束后，父进程负责回收避免僵尸进程问题，整个子进程的生命周期父进程要全程参与"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114202520098"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260114202520098.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-s8rx2io","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-s8rx2io","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Process Group 组关系"}]},{"ID":"20260505170804-1gmdtju","Type":"NodeParagraph","Properties":{"id":"20260505170804-1gmdtju","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一个进程组一般由一个组长进程和若干组员进程构成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"组长被创建出来，就产生一个进程组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"终端进程被创建，默认为进程组的组长进程(系统会分配一个进程组)"}]},{"ID":"20260505170804-3m7u71c","Type":"NodeParagraph","Properties":{"id":"20260505170804-3m7u71c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"组长进程的唯一标志： 组 ID==进程 ID"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114204334543"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260114204334543.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gwo0j6z","Type":"NodeParagraph","Properties":{"id":"20260505170804-gwo0j6z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"getpid()\t//返回进程 pid"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"getppid()\t//返回父进程 id"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"getpgrp()\t//返回进程进程组 id"}]},{"ID":"20260505170804-kfazw11","Type":"NodeParagraph","Properties":{"id":"20260505170804-kfazw11","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进程组的销毁："},{"Type":"NodeText","Data":"组中的最后一个进程结束或转移，进程组中没有进程时，系统会释放进程组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"就近原则："},{"Type":"NodeText","Data":"子进程被创建后，默认归纳到父进程同组成为组员"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子进程一定是父进程的组员进程，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"这个概念是错误的"},{"Type":"NodeText","Data":"，因为组员是可以变动的，可以将组员进程转移到其他组中去"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"组长是不允许转移的"}]},{"ID":"20260505170804-sdyyp0k","Type":"NodeParagraph","Properties":{"id":"20260505170804-sdyyp0k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"组长进程无法创建进程组，组员进程可以创建新租，脱离原有进程组成为新组长"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"子进程成立新组后，亲缘关系不变，子进程结束后依然由父进程回收(子进程脱离原有进程组，父进程可以通过 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"waitpid"},{"Type":"NodeText","Data":" 跨组回收)"}]},{"ID":"20260505170804-32w3l60","Type":"NodeParagraph","Properties":{"id":"20260505170804-32w3l60","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"setpgid(pid_t pid , pid_t gid)"},{"Type":"NodeText","Data":"\t可以让组员创建新组，也可以让组成员转移到其他组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"组转移时目标必须存在，需要对目标组有访问权限才可以完成转移"}]},{"ID":"20260505170804-pezufiq","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-pezufiq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Process Session 会话关系"}]},{"ID":"20260505170804-1gyo0zi","Type":"NodeParagraph","Properties":{"id":"20260505170804-1gyo0zi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"会话是一种终端进程管理的组织结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114212743971"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260114212743971.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会话发起者结束时，会以组为单位杀死全部的会话参与者；会话发起者这杀一组，瞄准终端子进程的一组。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会话发起者结束，终端子进程必然被杀死"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会话发起者杀死是按组杀死，如果子进程创建新组可以存活，但它并没有脱离会话"}]},{"ID":"20260505170804-3vgmw29","Type":"NodeParagraph","Properties":{"id":"20260505170804-3vgmw29","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"让子进程脱离会话，创建新会话，避免被终端杀死(脱离控制终端)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"getsid(getpid());\t//返回会话 sid"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"setsid();\t创建进程组并创建新会话，脱离控制终端"}]},{"ID":"20260505170804-hkou5op","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-hkou5op","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Orphan 孤儿进程"}]},{"ID":"20260505170804-8ukp6lf","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ukp6lf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"孤儿进程：父进程先于子进程退出，子进程被托管给托管进程，子进程属性活态进程，失去管理"}]},{"ID":"20260505170804-lfq6pnd","Type":"NodeParagraph","Properties":{"id":"20260505170804-lfq6pnd","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114225036181"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260114225036181.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"孤儿进程这种活态进程的危害是有弹性的，取决于孤儿进程的作业，如果孤儿进程被设置大量频繁的申请占用系统资源，那么这种孤儿进程危害极大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"孤儿进程是异常多进程模型的残留，会影响新进程的创建与使用"}]},{"ID":"20260505170804-lf0prke","Type":"NodeParagraph","Properties":{"id":"20260505170804-lf0prke","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"开发者创建父子进程模型，让父进程退出，子进程变为守护进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114232932954"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260114232932954.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-tj794ja","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-tj794ja","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Deamon Process 守护进程/精灵进程"}]},{"ID":"20260505170804-myeg5gk","Type":"NodeParagraph","Properties":{"id":"20260505170804-myeg5gk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"shell 设置进程开机启动"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"守护进程是经典的后台服务进程，持续在后台执行完成特定服务，执行特定功能，不干预前台任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通的软件进程随用户的使用持续，生命周期较短"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"守护进程生命周期较长，开机启动关机结束，持续服务于后台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"守护进程不能持续占用系统资源(cpu,内存等)，长时间处于低开销模式"}]},{"ID":"20260505170804-lllpbxr","Type":"NodeParagraph","Properties":{"id":"20260505170804-lllpbxr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"守护进程的工作模式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"间隔执行(sleep)\t定时启动，条件触发，低消模式(大多数时间进程处于睡眠态)"}]},{"ID":"20260505170804-mt66ndk","Type":"NodeParagraph","Properties":{"id":"20260505170804-mt66ndk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"后台服务进程不允许访问前台，标准输入标准输出不使用，标准出错(dup2 实现重定向)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"守护进程其实是孤儿进程，人为的孤儿进程"}]},{"ID":"20260505170804-hyi8bzt","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-hyi8bzt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"守护进程的实现流程"}]},{"ID":"20260505170804-5ydfeb3","Type":"NodeParagraph","Properties":{"id":"20260505170804-5ydfeb3","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260115111620726"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260115111620726.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-x4sklyy","Type":"NodeParagraph","Properties":{"id":"20260505170804-x4sklyy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"初次启动进程的工作路径在 USB 中，修改到目标主机中根目录下即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程默认的工作路径在 USB 中，要将路径改为用户主机，对 USB 接触占用"}]},{"ID":"20260505170804-68jx41r","Type":"NodeParagraph","Properties":{"id":"20260505170804-68jx41r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"改变守护进程的 umask 掩码，避免进程执行因不同平台 umask 不同导致文件权限异常"}]},{"ID":"20260505170804-w4biyes","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-w4biyes","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"创建一个守护进程 Demo"}]},{"ID":"20260505170804-mysebys","Type":"NodeParagraph","Properties":{"id":"20260505170804-mysebys","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.创建一个 Deamon_process 文件夹，在此文件夹中开发守护进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.编译后，守护进程的程序名为 Deamon_process"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.守护进程创建日志文件，文件名为 time.log"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.守护进程间隔执行，每间隔 3s 向日志文件中写入系统时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.守护进程后台运行"}]},{"ID":"20260505170804-193gtci","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-193gtci","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003csys/stat.h\u003e\n#include \u003cfcntl.h\u003e\n#include \u003cstring.h\u003e\n#include \u003ctime.h\u003e\n#include \u003cerrno.h\u003e\n#include \u003csys/types.h\u003e\n\n// 守护进程的业务逻辑：每隔3秒将当前时间写入time.log文件\nvoid Daemon_business(void)\n{\n    int fd;\n    time_t tm; // 时间种子类型\n    char time_buffer[1024];\n    // 打开/创建日志文件，权限为0664\n    if((fd = open(\"time.log\", O_RDWR|O_CREAT, 0664)) == -1){\n        perror(\"open failed\");\n        exit(0);\n    }\n    while(1){\n        bzero(time_buffer, sizeof(time_buffer)); // 清空缓冲区\n        tm = time(NULL); // 获取当前时间戳\n        ctime_r(\u0026tm, time_buffer); // 线程安全的时间格式化函数\n        write(fd, time_buffer, strlen(time_buffer)); // 写入日志文件\n        sleep(3); // 每隔3秒执行一次\n    }\n    close(fd); // 理论上不会执行到这里，仅做规范补充\n}\n\n// 创建守护进程的核心函数\nvoid Daemon_create(void)\n{\n     // 1. 创建子进程，父进程退出，脱离终端控制\n    pid_t pid;\n    pid = fork();\n    if(pid \u003e 0){\n        exit(0); // 父进程退出\n    }else if(pid == 0){\n        // 2. 创建新会话，彻底脱离原终端会话\n        setsid();\n        // 3. 改变进程工作目录（这里设为当前目录，也可改为绝对路径如/var/log）\n        chdir(\"./\");\n        // 4. 修改进程umask，让创建的文件权限更灵活\n        umask(0002);\n        // 5. 关闭无用的文件描述符，释放资源\n        close(STDIN_FILENO);  // 关闭标准输入\n        close(STDOUT_FILENO); // 关闭标准输出\n        // 可选：将标准错误重定向到日志文件（补充原代码缺失部分）\n        int err_fd = open(\"daemon_err.log\", O_RDWR|O_CREAT|O_APPEND, 0664);//创建重定向错误文件\n        if(err_fd != -1){\n            dup2(err_fd, STDERR_FILENO);\n            close(err_fd);\n        }\n        // 6. 执行守护进程的核心业务\n        Daemon_business();\n        //7.守护进程退出处理\n    }else{\n        perror(\"fork call failed\");\n        exit(EXIT_FAILURE);\n    }\n}\n\n// 主函数：程序入口\nint main(void)\n{\n    Daemon_create();\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-vp996wd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-vp996wd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"重定向"}]},{"ID":"20260505170804-v8jv3bn","Type":"NodeParagraph","Properties":{"id":"20260505170804-v8jv3bn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"STDIN_FILENO\t标准输入流\t读取外部数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"STDOUT_FILENO\t标准输出流\t显示数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"STDERR_FILENO\t标准出错流"}]},{"ID":"20260505170804-ftj2qew","Type":"NodeParagraph","Properties":{"id":"20260505170804-ftj2qew","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260115121234413"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260115121234413.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-o6ezca4","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-o6ezca4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"开机启动"}]},{"ID":"20260505170804-o9ndc2i","Type":"NodeParagraph","Properties":{"id":"20260505170804-o9ndc2i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"shell 脚本是一个逻辑和命令的集合，可以将大量的命令封装到脚本中，批量执行"}]},{"ID":"20260505170804-98dcqnj","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"c2hlbGw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-98dcqnj","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"c2hlbGw="},{"Type":"NodeCodeBlockCode","Data":"#!/bin/bash\n# 脚本名称：基础系统信息查看脚本\n# 功能：展示常用的Linux系统操作命令示例\n# 作者：自定义\n# 日期：2026-01-15\n\n# ==================== 脚本核心功能区 ====================\ndata\n\nls-a\n\nps aux\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-urfop7m","Type":"NodeParagraph","Properties":{"id":"20260505170804-urfop7m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"创建完 shell 文件不能立即执行，需要 sudo chmod 0775 文件名"}]},{"ID":"20260505170804-b5tnwov","Type":"NodeParagraph","Properties":{"id":"20260505170804-b5tnwov","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"开机启动："}]},{"ID":"20260505170804-2xaczsg","Type":"NodeParagraph","Properties":{"id":"20260505170804-2xaczsg","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260115123511840"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260115123511840.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-6ikpbau","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"c2hlbGw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-6ikpbau","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"c2hlbGw="},{"Type":"NodeCodeBlockCode","Data":"#!/bin/bash\n### BEGIN INIT INFO\n# Provides:          shell_start\n# Required-Start:    $remote_fs $syslog\n# Required-Stop:     $remote_fs $syslog\n# Default-Start:     2 3 4 5\n# Default-Stop:      0 1 6\n# Short-Description: set upstart shell\n# Description:       Provide a socket for X11, hald and others to multiplex kernel ACPI events.\n### END INIT INFO\n\n#跳转位置，到程序路径\ncd \"/home/colin/colinSoft/20220524/IPC/Daemon_process\"\n./Daemon_process\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-fr4hv2z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"c2hlbGw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-fr4hv2z","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"c2hlbGw="},{"Type":"NodeCodeBlockCode","Data":"此外执行\t\nsudo cp shell_start /etc/init.d\t\t#把当前目录下的`shell_start`脚本文件，复制到`/etc/init.d/`目录下\nsudo update -rc.d shell_start start 99 2. \t#让`shell_start`服务在运行级别 2 下，以优先级 99（较晚）开机启动。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-h952nqa","Type":"NodeParagraph","Properties":{"id":"20260505170804-h952nqa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统开机启动脚本序列\t/etc/init.d/"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.将其他脚本的启动块信息，复制到自定义脚本中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.将自定义脚本复制到/etc/init.d/目录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.通过命令将脚本加入开机启动序列 \tsudo update -rc.d shell_start start 99 2."}]},{"ID":"20260505170804-kr2frsi","Type":"NodeParagraph","Properties":{"id":"20260505170804-kr2frsi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"通过命令删除开机启动序列中的脚本\tsudo update-rc.d shell_start remove"}]},{"ID":"20260505170804-nmoypoa","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-nmoypoa","updated":"20260505170804"}},{"ID":"20260505170804-nss1zd6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-nss1zd6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"信号"}]},{"ID":"20260505170804-1f0muo3","Type":"NodeParagraph","Properties":{"id":"20260505170804-1f0muo3","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"信号是 Linux 系统下的经典技术，一般操作系统利用信号杀死违规进程，典型进程干预手段，信号除了杀死进程外也可以挂起进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"kill\t-l "},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"查看系统支持的信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"32,33 号预留给线程库 NTPL"}]},{"ID":"20260505170804-by5gisg","Type":"NodeParagraph","Properties":{"id":"20260505170804-by5gisg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"两种信号:\t经典信号/实时信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"31 是 unix 经典信号，软件开发工程师使用，例如进程通信，信号捕捉等等 34"},{"Type":"NodeText","Data":"64 是自定义信号，一般驱动开发使用，偏底层"}]},{"ID":"20260505170804-gew5uyy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-gew5uyy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号触发的几种方式"}]},{"ID":"20260505170804-ae2drf6","Type":"NodeParagraph","Properties":{"id":"20260505170804-ae2drf6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1、终端组合按键触发信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ctl+c \t(SIGINT/2)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"终端组合按键触发的信号会发给唯一的前台进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260116121057596"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260116121057596.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-scx4ln4","Type":"NodeParagraph","Properties":{"id":"20260505170804-scx4ln4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ctl+/ \t(SIGQUIT/3) \t系统向唯一的前台进程发送 3 号信号，杀死目标进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ctr+z\t(SIGTSTP/20)\t系统向唯一的前台进程发送 20 号新号，挂起目标进程"}]},{"ID":"20260505170804-ivaqsza","Type":"NodeParagraph","Properties":{"id":"20260505170804-ivaqsza","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2.命令发送信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"kill\t-signo \tpid \t#此命令可以向任意进程发送任意信号"}]},{"ID":"20260505170804-1g38jc2","Type":"NodeParagraph","Properties":{"id":"20260505170804-1g38jc2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3.函数发送信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include"},{"Type":"NodeText","Data":" \u003csignal.h\u003e"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"kill(pid_t pid , int signo)\t#向任意进程发送任意信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"raise (int signo)\t#向自身进程发送任意信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"void abort(void)\t#向自身进程发送 sigabrt/6 号信号"}]},{"ID":"20260505170804-ieh3ez3","Type":"NodeParagraph","Properties":{"id":"20260505170804-ieh3ez3","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4.硬件异常产生信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.对只读内存进行写操作，属于违规操作硬件，系统向违规进程发送 SIGSEGV(11)信号，杀死违规进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SIGSEGV 信号可能是系统发出，也有可能是其他用户发出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.SIGBUS(总线错误)，越界访问，无效访问内存，系统向违规进程发送 SIGBUS(7)信号，杀死违规进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.SIGFPE(浮点数例外)\tcpu 违规运算，运算异常，系统向违规进程发送 SIGFPE(8),杀死进程"}]},{"ID":"20260505170804-1g9vjzz","Type":"NodeParagraph","Properties":{"id":"20260505170804-1g9vjzz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5.软条件触发信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.Alarm 定时器\t\t\t\t\talarm(10)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"软条件触发信号，在使用系统某个组件时，例如定时器，定时到时触发软条件，系统向进程发送信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.管道读端结束，写端向管道写数据(触发软条件)系统向写端进程发送 SIGPIPE13 信号杀死写端进程"}]},{"ID":"20260505170804-ga8vg5j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ga8vg5j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号的三大行为，与五种处理动作"}]},{"ID":"20260505170804-qqge8kh","Type":"NodeParagraph","Properties":{"id":"20260505170804-qqge8kh","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260116133634326"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260116133634326.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-851itwy","Type":"NodeParagraph","Properties":{"id":"20260505170804-851itwy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"默认行为 SIG_DFL"}]},{"ID":"20260505170804-3iaasiu","Type":"NodeParagraph","Properties":{"id":"20260505170804-3iaasiu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TERM：直接杀死目标进程\tSIGKILL SIGINT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CORE：直接杀死进程，但是转储核心处理文件\t(dump core)，SIGQUIT ，SIGSEGV SIGFPE SIGBUS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IGN：通知回收信号\tSIGCHLD 忽略信号，发到进程不会影响进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"STOP：挂起进程，SIGSTP，SIGTSTP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CONT：唤醒进程，SIGCONT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号处置进程后，可以通过结果分析信号的默认动作"}]},{"ID":"20260505170804-hv9y6v1","Type":"NodeParagraph","Properties":{"id":"20260505170804-hv9y6v1","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"忽略行为 SIG_IGN"}]},{"ID":"20260505170804-ok5vf5d","Type":"NodeParagraph","Properties":{"id":"20260505170804-ok5vf5d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"忽略行为没有处理动作，直接丢弃，不会影响进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"忽略行为的优先级比动作要高"}]},{"ID":"20260505170804-f32oaio","Type":"NodeParagraph","Properties":{"id":"20260505170804-f32oaio","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"捕捉行为 SIG_ACTION"}]},{"ID":"20260505170804-nz4n6z3","Type":"NodeParagraph","Properties":{"id":"20260505170804-nz4n6z3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自定义动作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"捕捉函数：    例 printf(“hahaha\\n”);"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"捕捉行为可以实现信号绑定自定义任务，信号触发执行捕捉函数，执行自定义任务"}]},{"ID":"20260505170804-tijfm36","Type":"NodeParagraph","Properties":{"id":"20260505170804-tijfm36","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"捕捉技术在开发中广泛使用"}]},{"ID":"20260505170804-x4vqexg","Type":"NodeParagraph","Properties":{"id":"20260505170804-x4vqexg","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"让信号失效的三种方式：屏蔽，忽略，捕捉"}]},{"ID":"20260505170804-y1u5nwp","Type":"NodeParagraph","Properties":{"id":"20260505170804-y1u5nwp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统保留高权级信号，这类信号无法被屏蔽，捕捉和忽略，服务于内核，只要发出必然递达"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SIGKILL(9)，无法被屏蔽，捕捉，忽略，只要发出必然杀死"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SIGSTOP(19)，无法被屏蔽，捕捉，忽略，只要发出必然挂起"}]},{"ID":"20260505170804-xo68d8q","Type":"NodeParagraph","Properties":{"id":"20260505170804-xo68d8q","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"信号的传递过程"}]},{"ID":"20260505170804-k9xd7xm","Type":"NodeParagraph","Properties":{"id":"20260505170804-k9xd7xm","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260116235109550.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-wyqe433","Type":"NodeParagraph","Properties":{"id":"20260505170804-wyqe433","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号集是一个位图，每一位表示一个信号，位码是 0 或者 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果信号无法通过未决信号集，位码是 1，此信号直接丢弃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果信号通过未决信号集，系统将对应的位码设置 1，标记为未决态信号，表示此信号正在传递，还未处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"屏蔽字信号集，用户自行设置，可以屏蔽阻塞信号，使其无法递达"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号屏蔽字对应的位变为 1，可以实现阻塞信号"}]},{"ID":"20260505170804-g6qt0mg","Type":"NodeParagraph","Properties":{"id":"20260505170804-g6qt0mg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果信号通过屏蔽字进入 handler 处理流程，系统会将未决信号集对应位码翻转回 0，表示从未决态信号切换为递达态信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号屏蔽是延迟处理，此信号未消失，某一刻屏蔽解除，此信号马上递达，处置进程"}]},{"ID":"20260505170804-o1v4abk","Type":"NodeParagraph","Properties":{"id":"20260505170804-o1v4abk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"忽略信号，信号没有处理流程，只传递不处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以实现自定义动作，也可以捕捉函数为空"}]},{"ID":"20260505170804-zc9rur7","Type":"NodeParagraph","Properties":{"id":"20260505170804-zc9rur7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"unix 经典信号 不支持信号排队"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自定义信号实现了排队序列，多个相同信号触发也可以排队依次处理"}]},{"ID":"20260505170804-42eotga","Type":"NodeParagraph","Properties":{"id":"20260505170804-42eotga","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统为了避免相同的信号同时进入处理流程所以进行临时屏蔽，只让一个信号抵达"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"捕捉函数\t1.扫描磁盘\t2.缓存垃圾文件位置\t3.批处理删除文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"捕捉函数中访问共享数据，嵌套执行产生冲突"}]},{"ID":"20260505170804-rlj00ad","Type":"NodeParagraph","Properties":{"id":"20260505170804-rlj00ad","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"经典信号因为系统设置临时屏蔽的关系，两个相同信号触发，可以最大排队一次"}]},{"ID":"20260505170804-w34cg9f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w34cg9f","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号屏蔽实现"}]},{"ID":"20260505170804-0h4jw40","Type":"NodeParagraph","Properties":{"id":"20260505170804-0h4jw40","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include\u0026lt;signal.h\u0026gt;\tsigset_t"},{"Type":"NodeText","Data":" oldset"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigset_t set;\t//信号集类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigempty(sigset_t * set);\t//将 set 信号集中所有位初始化为 0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigfillset(sigset_t * set);\t//将 set 信号集中所有位初始化为 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigaddset(sigset_t *set,int signo);\t//将 set 集合中某个信号的对应位设置为 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigdelset(sigset "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"set, int signo);\t//将 set 集合中某个信号的对应位设置为 0bitcode=sigismember(sigset_t * set,int signo);\t//查看某个信号集中，对应信号的位码并直接返回 0 or 1sigprocmask(SIG_SETMASK , sigset_t"},{"Type":"NodeText","Data":" newset , \u0026oldset);\t//可以替换进程信号集,并将原有的 oldset 传出保存，便于复位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设置方式：\tint how = SIG_SETMASK(替换覆盖)\tSIG_BLOCK(位或)  SIG_UNBLOCK(取反求与)"}]},{"ID":"20260505170804-5gs1ycc","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5gs1ycc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"查看信号的屏蔽情况"}]},{"ID":"20260505170804-sx82p5q","Type":"NodeParagraph","Properties":{"id":"20260505170804-sx82p5q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号已经被发出，递达进程，进程中被屏蔽，要观察这种已触发被屏蔽的信号只能查看未决信号集"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"获取进程的未决信号集，而后输出未决的每一位，0 or 1 查看信号屏蔽"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sigpending(\u0026pset)\t//调用此函数，系统将进程的未决信号集传出到 pset 中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用遍历循环结合 sigismember，查看每一位的情况并输出"}]},{"ID":"20260505170804-rx4p20y","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-rx4p20y","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstring.h\u003e\n#include \u003csignal.h\u003e\n// 查看信号的屏蔽情况，遍历打印未决信号集\nvoid print_pset(sigset_t pset)\n{\n    int i=1;\n    for(i; i\u003c32; i++){\n        if((sigismember(\u0026pset, i))){\n            putchar('1');\n        }else{\n            putchar('0');\n        }\n    }\n    putchar('\\n');\n}\nint main(void)\n{\n    sigset_t set, oset, pset;\n    sigemptyset(\u0026set); // 初始化 0\n    sigaddset(\u0026set, SIGINT); // 设置屏蔽SIGINT\n    sigaddset(\u0026set, SIGQUIT); // 设置屏蔽SIGQUIT\n    sigprocmask(SIG_SETMASK, \u0026set, \u0026oset);\n    while(1){\n        sigpending(\u0026pset);\n        print_pset(pset);\n        sleep(1);\n    }\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-p3fr4qn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-p3fr4qn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号行为修改"}]},{"ID":"20260505170804-aksrj22","Type":"NodeParagraph","Properties":{"id":"20260505170804-aksrj22","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"struct sigaction act;\t//信号行为结构体"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"act.sa_handler=SIG_DFL(默认行为) | SIG_IGN(忽略行为) | 传递函数指针 -\u003e 自定义捕捉函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"act.sa_flags=0\t//此成员与行为接口绑定，如果使用 sa_handler 那么 sa_flags 为 0，如果使用 sa_sigaction ,flags 为 SA_SIGINFO"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"act.sa_mask \t//sigset_t 信号集类型，为临时屏蔽字，使用 sigemptyset 初始化"}]},{"ID":"20260505170804-qm32c26","Type":"NodeParagraph","Properties":{"id":"20260505170804-qm32c26","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"sigaction(int signo(要设置处理规则的信号编号),struct sigacion *newact ,sigacion *oldact);\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"//替换进程的信号行为结构体，用 newact 替换，传出 oldact(进程原有结构体)"}]},{"ID":"20260505170804-h79gwel","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-h79gwel","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstring.h\u003e\n#include \u003csignal.h\u003e\n// 自定义捕捉函数\n// sa_handler = void (*sa_handler)(int)\n// sa_handler是一个函数指针类型，但是捕捉函数定义必须与其一致\nvoid sig_do(int n){\n    // 系统调用捕捉函数时，系统向n传递捕捉的信号编号\n    printf(\"SIGINT %d 捕捉成功..\\n\", n);\n}\n// 修改信号行为\nint main(void)\n{\n    struct sigaction act, oact;\n    // act.sa_handler = SIG_DFL; // 默认行为\n    // act.sa_handler = SIG_IGN; // 忽略行为\n    act.sa_handler = sig_do;    // 捕捉行为\n    act.sa_flags = 0;\n    sigemptyset(\u0026act.sa_mask);\n    sigaction(SIGINT, \u0026act, \u0026oact); // 行为替换\n    while(1){\n        sleep(1);\n    }\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-xjrvrsw","Type":"NodeParagraph","Properties":{"id":"20260505170804-xjrvrsw","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117001645786"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117001645786.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ai9tcox","Type":"NodeParagraph","Properties":{"id":"20260505170804-ai9tcox","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为了避免不同信号绑定相同的捕捉函数引发冲突\t设置临时屏蔽字 SA_MASK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在进程处理某一个信号时，可以使用 SA_MASK 临时屏蔽其他信号，等信号处理完再解除屏蔽，避免不同信号调用相同捕捉的冲突"}]},{"ID":"20260505170804-8l5xd00","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-8l5xd00","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Dump Core"}]},{"ID":"20260505170804-2fagkuf","Type":"NodeParagraph","Properties":{"id":"20260505170804-2fagkuf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号的默认行为中有五种处理动作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TERM CORE IGN STOP CONT"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CORE：杀死进程的同时，传储核心文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果进程因硬件异常被系统杀死，那么会(Dump Core),错误原因 xxx(核心已转储)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ulimit -a 查看系统限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ulimit -c 4096(允许生成 core)\t让进程产生错误，生成 core 文件，后续调试通过 gdp app core"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在编译阶段 gcc *.c -g -o app ,编译时加入调试信息才可以使用 gdb"}]},{"ID":"20260505170804-a4v5emm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a4v5emm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号回收"}]},{"ID":"20260505170804-w31a08u","Type":"NodeParagraph","Properties":{"id":"20260505170804-w31a08u","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117105820021"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117105820021.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-lgzppte","Type":"NodeParagraph","Properties":{"id":"20260505170804-lgzppte","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"wait()\t//阻塞回收(主动回收)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"waitpid()\t//非阻塞回收(主动回收)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号回收(被动回收方案)"}]},{"ID":"20260505170804-w5f2zzh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w5f2zzh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"捕捉函数执行流程"}]},{"ID":"20260505170804-2idiv3j","Type":"NodeParagraph","Properties":{"id":"20260505170804-2idiv3j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号的处理是实时的吗？\t信号的处理不是实时的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117110407529"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117110407529.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-adk449r","Type":"NodeParagraph","Properties":{"id":"20260505170804-adk449r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"软件中断触发层级转换，系统调用触发层级转换，软件异常调用层级转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.进程在用户层执行逻辑单元"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.系统发送信号到内核层(等待处理)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.进程要触发层级转化，从用户空间切换到内核空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.切换到内核层后先完成系统调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.完成调用后，返回用户空间前，检测一下是否有未处理信号，有则处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6.察觉信号的处理行为为捕捉行为，携高权限切换到用户层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"7.捕捉执行完毕，SIG_RETURN 指令，返回内核空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"8.系统调用完毕，返回用户空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"9.从 main 被中断的位置继续执行"}]},{"ID":"20260505170804-j2rdbhh","Type":"NodeParagraph","Properties":{"id":"20260505170804-j2rdbhh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核切换到用户层执行捕捉函数，使用进程本身资源(时间片或内存)"}]},{"ID":"20260505170804-il1yymo","Type":"NodeParagraph","Properties":{"id":"20260505170804-il1yymo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一般 main 先执行，过程中产生信号，系统执行捕捉函数，捕捉函数先执行完，稍后回到主函数继续执行"}]},{"ID":"20260505170804-u7qg8uk","Type":"NodeParagraph","Properties":{"id":"20260505170804-u7qg8uk","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117115439291"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117115439291.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-8ysvl6i","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ysvl6i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"cup 环路设计"}]},{"ID":"20260505170804-xbvzy46","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-xbvzy46","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"关于捕捉函数的可重入不可重入问题"}]},{"ID":"20260505170804-ywk7se3","Type":"NodeParagraph","Properties":{"id":"20260505170804-ywk7se3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局变量\tint a =1024，此数据被捕捉函数和主函数同时使用\t全局变量会引发不可重入问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117121452292"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117121452292.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-22aip6t","Type":"NodeParagraph","Properties":{"id":"20260505170804-22aip6t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"捕捉函数和 main 函数同时使用全局链表的 insert 操作，必然引发内存泄漏，链表中的节点异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用全局资源或静态资源的函数称为不可重入函数，这种函数信号捕捉函数与主函数同时使用会引发异常"}]},{"ID":"20260505170804-bnflkwj","Type":"NodeParagraph","Properties":{"id":"20260505170804-bnflkwj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可重入概念：访问的数据也好，函数也罢，都不访问共享资源，不会引发冲突，这种函数称为可重入函数，信号使用可重入内容是安全的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号捕捉开发不允许使用不可重入内容"}]},{"ID":"20260505170804-6c4jtuv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6c4jtuv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"时序竞态(不常考)"}]},{"ID":"20260505170804-v3a8g35","Type":"NodeParagraph","Properties":{"id":"20260505170804-v3a8g35","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117161101536"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117161101536.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117161205574"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117161205574.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ia6duw5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ia6duw5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程间通信\t(用信号)"}]},{"ID":"20260505170804-at45fiz","Type":"NodeParagraph","Properties":{"id":"20260505170804-at45fiz","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117123030545"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117123030545.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-1mc0oc4","Type":"NodeParagraph","Properties":{"id":"20260505170804-1mc0oc4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用时选择一种数据进行通信"}]},{"ID":"20260505170804-bw5l3nv","Type":"NodeParagraph","Properties":{"id":"20260505170804-bw5l3nv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"info-\u003esi_int\t接收整形数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"info-\u003esi_ptr\t接收指针数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"act.sa_flags =SA_SIGINFO"}]},{"ID":"20260505170804-fok8b58","Type":"NodeParagraph","Properties":{"id":"20260505170804-fok8b58","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"父进程中屏蔽 SIGUSR1 然后将这个屏蔽继承给子进程，子进程被创建就默认屏蔽 SIGUSR1，然后子进程完成信号捕捉，捕捉设定完毕"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解除 SIGUSR1 屏蔽，这样就可以避免子进程没有捕捉完毕，信号递达，杀死子进程"}]},{"ID":"20260505170804-f7n61dk","Type":"NodeParagraph","Properties":{"id":"20260505170804-f7n61dk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号通信亲缘间使用比较简单，但是不相干的进程要想办法获取目标 pid"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"父进程关于子进程 pid 的问题，可以将 pid 存储在全局变量，便于捕捉函数使用，也可以使用 getpid()+1，定位子进程"}]},{"ID":"20260505170804-hlo7cv8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-hlo7cv8","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e      // 标准输入输出库\n#include \u003cstdlib.h\u003e     // 标准库（exit等函数）\n#include \u003cstring.h\u003e     // 字符串处理库\n#include \u003cunistd.h\u003e     // 系统调用库（fork、getpid、usleep等）\n#include \u003csignal.h\u003e     // 信号处理库\npid_t child_pid;  // 全局变量：保存子进程PID，供父进程信号处理函数使用\nvoid Parent_sig(int n, siginfo_t *info, void *arg)\n{\n    // 打印父进程PID和接收到的数值\n    printf(\"Parent pid [%d] , %d\\n\", getpid(), info-\u003esi_int);\n    // 定义信号携带数据的联合体（sigqueue要求使用该类型传递数据）\n    union sigval val;\n    val.sival_int = ++(info-\u003esi_int);  // 数值自增   \n    // 向子进程发送SIGUSR1信号，并携带自增后的数值\n    sigqueue(child_pid, SIGUSR1, val);\n    usleep(50000);  // 休眠50毫秒，避免信号发送过快导致输出刷屏\n}\nvoid Child_sig(int n, siginfo_t *info, void *arg)\n{\n    // 打印子进程PID和接收到的数值\n    printf(\"Child pid [%d] , %d\\n\", getpid(), info-\u003esi_int);\n    // 定义信号携带数据的联合体\n    union sigval val;\n    val.sival_int = ++(info-\u003esi_int);  // 数值自增\n    // 向父进程发送SIGUSR2信号，并携带自增后的数值（getppid()获取父进程PID）\n    sigqueue(getppid(), SIGUSR2, val);\n    usleep(50000);  // 休眠50毫秒\n}\nint main(void)\n{\n    pid_t pid;  // 保存fork返回的进程ID\n    // ===================== 父进程信号配置：捕捉SIGUSR2 =====================\n    struct sigaction act, oact;  // 信号动作结构体（act：新规则，oact：旧规则）\n    act.sa_sigaction = Parent_sig;  // 指定SIGUSR2的处理函数\n    act.sa_flags = SA_SIGINFO;     // 开启\"带详细信息\"模式，支持传递附加数据\n    sigemptyset(\u0026act.sa_mask);     // 清空信号屏蔽集（处理函数执行时不屏蔽其他信号）\n    sigaction(SIGUSR2, \u0026act, \u0026oact);  // 生效：设置SIGUSR2的处理规则\n    // ===================== 父进程信号屏蔽：屏蔽SIGUSR1 =====================\n    sigset_t set, oset;            // 信号集（set：新屏蔽集，oset：旧屏蔽集）\n    sigemptyset(\u0026set);             // 清空信号集\n    sigaddset(\u0026set, SIGUSR1);      // 将SIGUSR1加入屏蔽集\n    // 生效：设置进程的信号屏蔽字，子进程会继承该屏蔽集\n    sigprocmask(SIG_SETMASK, \u0026set, \u0026oset);\n    // ===================== 创建子进程 =====================\n    pid = fork();\n    if (pid \u003e 0)  // 父进程分支\n    {\n        // 初始化信号携带的数据（起始值为1）\n        union sigval val;\n        val.sival_int = 1;\n        child_pid = pid;  // 保存子进程PID到全局变量        \n        // 父进程主动发送第一个信号：向子进程发送SIGUSR1，携带数值1\n        sigqueue(pid, SIGUSR1, val);\n        // 无限循环：保持父进程存活，等待子进程的信号\n        while (1)\n        {\n            sleep(1);  // 休眠等待，避免CPU空转\n        }\n    }\n    else if (pid == 0)  // 子进程分支\n    {\n        // ===================== 子进程信号配置：捕捉SIGUSR1 =====================\n        struct sigaction act, oact;\n        act.sa_sigaction = Child_sig;  // 指定SIGUSR1的处理函数\n        act.sa_flags = SA_SIGINFO;     // 开启\"带详细信息\"模式\n        sigemptyset(\u0026act.sa_mask);     // 清空屏蔽集\n        sigaction(SIGUSR1, \u0026act, \u0026oact);  // 生效：设置SIGUSR1的处理规则\n        // ===================== 子进程解除屏蔽：取消SIGUSR1屏蔽 =====================\n        // 用空的屏蔽集（act.sa_mask）替换当前屏蔽集，解除SIGUSR1的屏蔽\n        sigprocmask(SIG_SETMASK, \u0026act.sa_mask, NULL);\n        // 无限循环：保持子进程存活，等待父进程的信号\n        while (1)\n        {\n            sleep(1);  // 休眠等待\n        }\n    }\n    else  // fork失败分支\n    {\n        perror(\"fork call failed\");  // 打印错误信息\n        exit(0);                     // 退出程序\n    }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-nl9ihtw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nl9ihtw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"实现进程的外部控制"}]},{"ID":"20260505170804-fl919gt","Type":"NodeParagraph","Properties":{"id":"20260505170804-fl919gt","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260117162646212"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260117162646212.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-sdtorwg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-sdtorwg","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003csys/types.h\u003e\n#include \u003csys/stat.h\u003e\n#include \u003csys/fcntl.h\u003e\n#include \u003cpthread.h\u003e\n#include \u003csignal.h\u003e\n// 捕捉SIGUSR1信号\nvoid sig_stop(int n)\n{\n    pause();\n}\nvoid sig_cont(int n)\n{\n    // null\n}\nvoid server_sigaction(void)\n{\n    struct sigaction act, bct, oact;\n    act.sa_handler = sig_stop;\n    act.sa_flags = 0;\n    sigemptyset(\u0026act.sa_mask);\n    sigaction(SIGUSR1, \u0026act, \u0026oact);\n    bct.sa_handler = sig_cont;\n    bct.sa_flags = 0;\n    sigemptyset(\u0026bct.sa_mask);\n    sigaction(SIGUSR2, \u0026bct, NULL);\n}\nint main(void)\n{\n    server_sigaction(); // 捕捉设定\n    while(1)\n    {\n        // 服务器主要业务\n        printf(\"Server service Demo , version 0.0.1 , Listen epoll , Wait Client...\\n\");\n        sleep(1);\n    }\n}\n\n信号注册：程序启动时注册两个自定义信号的处理规则：\n收到 SIGUSR1 信号 → 执行 sig_stop()，调用 pause() 暂停进程；\n收到 SIGUSR2 信号 → 执行空函数 sig_cont()，仅唤醒被暂停的进程（无额外操作）。\n主逻辑：无限循环打印服务器运行提示（模拟业务），每秒输出一次，保持进程一直运行。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-9fot9la","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-9fot9la","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于阻塞函数和信号处理冲突"}]},{"ID":"20260505170804-d844y42","Type":"NodeParagraph","Properties":{"id":"20260505170804-d844y42","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"阻塞函数处于等待状态，等待系统通知或事件消息"}]},{"ID":"20260505170804-cxwb317","Type":"NodeParagraph","Properties":{"id":"20260505170804-cxwb317","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118101159969"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118101159969.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4ljfev1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-4ljfev1","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstring.h\u003e\n#include \u003csignal.h\u003e\n#include \u003cerrno.h\u003e\nvoid sig_int(int n)\n{\n    printf(\"成功捕捉SIGINT %d 信号\\n\", n);\n}\nint main(void){\n    int len;\n    struct sigaction act, oact;\n    act.sa_handler = sig_int;\n    act.sa_flags = 0;\n    sigemptyset(\u0026act.sa_mask);\n    sigaction(SIGINT, \u0026act, \u0026oact);\n    char buf[1024];\n    bzero(buf, sizeof(buf));\ntryagain:\n    while((len = read(STDIN_FILENO, buf, sizeof(buf))) \u003e 0)\n    {\n        write(STDOUT_FILENO, buf, strlen(buf));\n        bzero(buf, sizeof(buf));\n    }\n    if(len == -1){\n        if(errno == EINTR){\n            printf(\"read函数被强制中断，TryAgain..\\n\");\n            goto tryagain;\n        }\n    }\n}\n\n信号捕捉：程序会捕捉 SIGINT（Ctrl+C 触发）信号，收到后执行 sig_int() 函数，打印捕捉成功的提示。\n中断恢复：read() 系统调用在被信号中断时会返回 -1，并将 errno 设置为 EINTR。代码检测到这个情况后，会通过 goto tryagain 重新进入 read() 循环，保证程序不会因为 Ctrl+C 而退出。\n回显功能：程序从标准输入读取内容，并原样输出到标准输出，类似一个简单的回显程序。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-5r9t0br","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-5r9t0br","updated":"20260505170804"}},{"ID":"20260505170804-9rjol0x","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-9rjol0x","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"线程"}]},{"ID":"20260505170804-uhjfozz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uhjfozz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程基本概述"}]},{"ID":"20260505170804-p9i79hq","Type":"NodeParagraph","Properties":{"id":"20260505170804-p9i79hq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"经典的并发模型 多进程模型 占用大量的内存开销，庞大的进程间调度开销，提供一种开销更小，更轻量的并发解决方案，多线程技术"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118103946243"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118103946243.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-779115a","Type":"NodeParagraph","Properties":{"id":"20260505170804-779115a","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程在进程中，与进程共享资源和数据，进程是容器，线程是执行单元，进程退出可能导致所有线程退出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程是最小的资源分配单位，线程最小的执行单位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程就是寄存器和栈"}]},{"ID":"20260505170804-js8i2kb","Type":"NodeParagraph","Properties":{"id":"20260505170804-js8i2kb","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118105144446"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118105144446.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-0c8ze8f","Type":"NodeParagraph","Properties":{"id":"20260505170804-0c8ze8f","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多线程"}]},{"ID":"20260505170804-na9okq8","Type":"NodeParagraph","Properties":{"id":"20260505170804-na9okq8","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118105502940"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118105502940.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-8h7jw3t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8h7jw3t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程的 CPU 分配"}]},{"ID":"20260505170804-73uieqf","Type":"NodeParagraph","Properties":{"id":"20260505170804-73uieqf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内核级线程"}]},{"ID":"20260505170804-tjsey5v","Type":"NodeParagraph","Properties":{"id":"20260505170804-tjsey5v","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118110721290"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118110721290.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-82b87sr","Type":"NodeParagraph","Properties":{"id":"20260505170804-82b87sr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"操作系统中每创建一个线程，系统都会为其创建一个内核对象，此线程系统可以识别支持，会为线程执行资源(时间片)"}]},{"ID":"20260505170804-nf02d56","Type":"NodeParagraph","Properties":{"id":"20260505170804-nf02d56","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户级线程"}]},{"ID":"20260505170804-fne3kv9","Type":"NodeParagraph","Properties":{"id":"20260505170804-fne3kv9","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118111741239"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118111741239.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-jxrxa7n","Type":"NodeParagraph","Properties":{"id":"20260505170804-jxrxa7n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户级线程，可以利用第三方库的形式在不支持线程技术的系统下安装和使用线程，用户级线程的调度开销更小，因为大部分的操作都在用户层完成，无需内核干预"}]},{"ID":"20260505170804-qcoukaj","Type":"NodeParagraph","Properties":{"id":"20260505170804-qcoukaj","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118112803139"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118112803139.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-p0pr0nk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-p0pr0nk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程的蜕化"}]},{"ID":"20260505170804-0egsf7r","Type":"NodeParagraph","Properties":{"id":"20260505170804-0egsf7r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程内资源的独占，不与其他人共享，进程是独立的调度单位(无需考虑线程问题)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程中出现了多个执行单元，讨论考虑线程问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"讨论和分析的蜕化，讨论线程，进程的讨论变为主线程和普通线程的讨论(讨论点的转移)"}]},{"ID":"20260505170804-0vil9m3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0vil9m3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多线程在进程中的资源共享"}]},{"ID":"20260505170804-0dn99rn","Type":"NodeParagraph","Properties":{"id":"20260505170804-0dn99rn","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118114913452"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118114913452.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-pr5k65q","Type":"NodeParagraph","Properties":{"id":"20260505170804-pr5k65q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"PCB 是共享空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程栈的栈空间非共享，每个线程创建后，会分配 8M 线程栈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"库资源共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享堆空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"全局资源共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码段共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件描述符表共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号的处理行为共享(某个线程改变信号行为)对所有线程生效\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"信号屏蔽字非共享，普通线程拥有独立的屏蔽字，拷贝继承于主线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TCB 非共享，每个线程拥有独立的线程控制块，独立的 tid"}]},{"ID":"20260505170804-ldu4j5k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ldu4j5k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程开发相关的 API 接口"}]},{"ID":"20260505170804-q66scfu","Type":"NodeParagraph","Properties":{"id":"20260505170804-q66scfu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"NPTL 线程库是典型的内核级线程库，创建的线程可以被系统识别分配 cpu 资源(轻量级进程)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"(nativ Posix thread library)"}]},{"ID":"20260505170804-63kawn6","Type":"NodeParagraph","Properties":{"id":"20260505170804-63kawn6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ps aus 进程查看  \tps ajx 进程关系查看\tps -elf 所有线程查看\tps -Lf pid 进程中线程查看"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个线程都会被系统分配 lwp 调度编号，便于系统管理调度线程，但是线程拥有独立的 tid 线程 id"}]},{"ID":"20260505170804-t45j6so","Type":"NodeParagraph","Properties":{"id":"20260505170804-t45j6so","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"tag","TextMarkTextContent":"include\u0026lt;pthread.h\u0026gt;"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"pthread_t tid;\t//线程 tid 类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"int err=pthread_create(pthread_t * tid,NULL,void"},{"Type":"NodeText","Data":"( "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"thread_job)(void"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em em","TextMarkTextContent":"),void * arg)"},{"Type":"NodeText","Data":"\t//线程创建并指定任务"}]},{"ID":"20260505170804-sd10pk0","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-sd10pk0","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cpthread.h\u003e\n#include \u003csignal.h\u003e\n// 线程工作函数\nvoid * thread_job(void * arg)\n{\n    printf(\"普通线程被创建，参数为 %d\\n\", *(int *)arg);\n    return NULL;\n}\n// 主线程（主控线程）\nint main(void)\n{\n    pthread_t tid;\n    int code = 1024;\n    // 创建新线程\n    pthread_create(\u0026tid, NULL, thread_job, (void*)\u0026code);\n    printf(\"主线程创建普通线程成功...\\n\");\n    // 主线程进入无限休眠，防止进程退出\n    while(1)\n        sleep(1);\n    return 0;\n}\n\n编译时需链接动态库 gcc thread_create.c -lpthread -o app\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-nosn61j","Type":"NodeParagraph","Properties":{"id":"20260505170804-nosn61j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关于线程函数的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"错误处理"},{"Type":"NodeText","Data":"，线程函数会返回错误号(err\u003e0),使用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"char * errstr=strerror(err);"}]},{"ID":"20260505170804-c0w3go1","Type":"NodeParagraph","Properties":{"id":"20260505170804-c0w3go1","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_join(pthread_t tid,void  reval);"},{"Type":"NodeText","Data":"\t//线程回收函数，可以回收线程资源的同时获取线程的返回值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*经典的阻塞回收函数，会一致等待普通线程结束后，进行回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_cancel(pthread_t tid);"},{"Type":"NodeText","Data":"\t\t//指定线程 tid，取消结束线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_testcancel(void);"},{"Type":"NodeText","Data":"\t//产生一次系统调用"}]},{"ID":"20260505170804-ebj7zy8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ebj7zy8","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003csys/types.h\u003e\n#include \u003csys/stat.h\u003e\n#include \u003csys/fcntl.h\u003e\n#include \u003cpthread.h\u003e\n#include \u003csignal.h\u003e\n// 普通线程的工作函数\nvoid * thread_job(void * arg)\n{\n    while(1)\n    {\n        printf(\"普通线程Running...\\n\");\n        sleep(1);\n    }\n    return (void*)126;\n}\n// 主线程（主控线程）\nint main(void)\n{\n    pthread_t tid;\n    int code = 1024;\n    int flags = 0;\n    int err;\n    void * reval = NULL;\n    // 创建新线程，并检查是否创建成功\n    if((err = pthread_create(\u0026tid, NULL, thread_job, (void*)\u0026code)) \u003e 0)\n    {\n        printf(\"pthread_create call failed: %s\\n\", strerror(err));\n        exit(0); // 创建失败则退出进程\n    }\n   \tprintf(\"Monster thread 0x%x, 普通线程id 0x%x\\n\", (unsigned int)pthread_self(), (unsigned int)tid);\n\tsleep(5);\n\tpthread_cancel(tid);\n\t//pthread_join(tid,\u0026reval);\n\t//printf(\"thread exit code %ld\\n\", (long int)reval);\nwhile(1)\n    sleep(1);\nreturn 0;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-6dylbv9","Type":"NodeParagraph","Properties":{"id":"20260505170804-6dylbv9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号处理的三个切换条件：系统调用，软件中断，软件异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"cancel 取消事件的处理条件，必须有系统调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程指定退出码时不允许用-1，保留给 pthread_cancel"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118222506486"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118222506486.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gu1iuig","Type":"NodeParagraph","Properties":{"id":"20260505170804-gu1iuig","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"修改线程退出状态，从回收态改为分离态，此操作不可逆，不能将分离线程变为回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果对一个分离态线程进行回收操作，pthread_join 会失败返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不允许对一个已经处于回收阶段(join 已经开始阻塞等待了)的线程设置分离，分离设置失败"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个自行回收，一个系统回收，一个可以得到线程退出码，一个无法得到"}]},{"ID":"20260505170804-bvvjs7t","Type":"NodeParagraph","Properties":{"id":"20260505170804-bvvjs7t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"pthread_detach(pthread_t tid);\t//将一个线程设置为分离态线程"}]},{"ID":"20260505170804-sjd7sig","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-sjd7sig","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 普通线程的工作函数\nvoid * thread_job(void * arg)\n{\n    // 将当前线程设置为分离状态，结束后自动释放资源\n    pthread_detach(pthread_self());\n    printf(\"普通线程 tid 0x%x 被创建\\n\", (unsigned int)pthread_self());\n    return (void*)126;\n}\n// 主线程（主控线程）\nint main(void)\n{\n    pthread_t tid;\n    int code = 1024;\n    int flags = 0;\n    int err;\n    void * reval = NULL;\n    // 创建新线程，并检查是否创建成功\n    if((err = pthread_create(\u0026tid, NULL, thread_job, (void*)\u0026code)) \u003e 0)\n    {\n        printf(\"pthread_create call failed: %s\\n\", strerror(err));\n        exit(0); // 创建失败则退出进程\n    }\n    // 打印主线程和新创建线程的ID\n    printf(\"Monster thread 0x%x, 普通线程id 0x%x\\n\", (unsigned int)pthread_self(), (unsigned int)tid);\n    // 等待普通线程结束，并获取其返回值\n    if((err = pthread_join(tid, \u0026reval)) \u003e 0)\n    {\n        printf(\"join failed: %s\\n\", strerror(err));\n        exit(0);\n    }\n    // 打印普通线程的退出码\n    printf(\"thread exit code %ld\\n\", (long int)reval);\n    // 主线程进入无限休眠，保持进程运行\n    while(1)\n        sleep(1);\n    return 0;\n}\n\n子线程 thread_job 中调用了 pthread_detach(pthread_self())，将自己设置为分离状态。\n主线程随后又调用了 pthread_join(tid, \u0026reval)，尝试等待并回收这个线程。\n在 POSIX 线程标准中，分离状态的线程是不能被 pthread_join 的，这会导致 pthread_join 调用失败，程序会打印 join failed: Invalid argument 并退出。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-o3sm8gf","Type":"NodeParagraph","Properties":{"id":"20260505170804-o3sm8gf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以通过线程属性，批量创建分离态线程，这些线程诞生即是分离态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_attr_setdetachstate(\u0026amp;attr, PTHREAD_CREATE_DETACHED)"},{"Type":"NodeText","Data":"：设置线程为分离态（另一个取值是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PTHREAD_CREATE_JOINABLE"},{"Type":"NodeText","Data":"，默认可连接态）；"}]},{"ID":"20260505170804-4hz34lj","Type":"NodeParagraph","Properties":{"id":"20260505170804-4hz34lj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em em","TextMarkTextContent":"pthread_exit((void"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":")126);"},{"Type":"NodeText","Data":"*\t//线程退出函数，结束当前线程，与进程无关，退出码可以被 join 获取"}]},{"ID":"20260505170804-ulkdn8s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ulkdn8s","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程的退出方式"}]},{"ID":"20260505170804-rreojpn","Type":"NodeParagraph","Properties":{"id":"20260505170804-rreojpn","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260118230927261"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260118230927261.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ydu4ndt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ydu4ndt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程属性"}]},{"ID":"20260505170804-r7su7e5","Type":"NodeParagraph","Properties":{"id":"20260505170804-r7su7e5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"pthread_create(\u0026tid,pthread_attr_t * attr,thread_job,NULL);"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"pthread_attr_t * attr;\t线程属性类型"}]},{"ID":"20260505170804-wzaytyv","Type":"NodeParagraph","Properties":{"id":"20260505170804-wzaytyv","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"本段内容作为指引性介绍，默认的线程属性已经能满足绝大多数开发要求，只有极特殊情况可能修改属性"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119103355789"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119103355789.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-rbgr9rl","Type":"NodeParagraph","Properties":{"id":"20260505170804-rbgr9rl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"本段内容作为指引性介绍，默认的线程属性已经能满足绝大多数开发要求，只有极特殊情况可能修改属性"}]},{"ID":"20260505170804-82w1d0b","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-82w1d0b","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"线程安全"}]},{"ID":"20260505170804-5biq0zb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5biq0zb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"访问互斥"}]},{"ID":"20260505170804-8tt9aqm","Type":"NodeParagraph","Properties":{"id":"20260505170804-8tt9aqm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多线程访问全局资源或静态资源，多线程访问文件数据，多线程适用共享数据引发异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程产生的开销占用的资源没有任何意义"}]},{"ID":"20260505170804-dgs0zif","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-dgs0zif","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"互斥锁"}]},{"ID":"20260505170804-nqfzviw","Type":"NodeParagraph","Properties":{"id":"20260505170804-nqfzviw","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119112046085"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119112046085.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-yjjcrz8","Type":"NodeParagraph","Properties":{"id":"20260505170804-yjjcrz8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_t lock"},{"Type":"NodeText","Data":"\t//互斥锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_init(\u0026lock,NULL)"},{"Type":"NodeText","Data":"\t//互斥锁初始化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_destroy(\u0026lock)"},{"Type":"NodeText","Data":"\t//释放互斥锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_lock(\u0026lock);"},{"Type":"NodeText","Data":"\t//申请锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_trylock();"},{"Type":"NodeText","Data":"\t//非阻塞申请，锁被占用不会阻塞，立即返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_mutex_unlock(\u0026lock);"},{"Type":"NodeText","Data":"\t//释放锁"}]},{"ID":"20260505170804-i9mh1yg","Type":"NodeParagraph","Properties":{"id":"20260505170804-i9mh1yg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"加锁的位置问题，可能改变线程执行流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*参考：只有全局资源读写时需要上锁"}]},{"ID":"20260505170804-d2lf64r","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-d2lf64r","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cpthread.h\u003e\n#include \u003csignal.h\u003e\n// 全局共享变量\nint number;\n// 互斥锁，保护共享变量\npthread_mutex_t lock;\n// 线程工作函数\nvoid * thread_job(void * arg)\n{\n    int tmp;\n    // 将当前线程设置为分离态，结束后自动释放资源\n    pthread_detach(pthread_self());\n    // 循环5000次，对共享变量进行累加操作\n    for(int i=0; i\u003c5000; i++)\n    {\n        // 加锁，确保同一时间只有一个线程访问共享变量\n        pthread_mutex_lock(\u0026lock);\n        tmp = number;\n        printf(\"thread 0x%x ++number %d\\n\", (unsigned int)pthread_self(), ++tmp);\n        number = tmp;\n        // 解锁，允许其他线程访问共享变量\n        pthread_mutex_unlock(\u0026lock);\n    }\n    // 线程退出\n    pthread_exit(NULL);\n}\n// 主线程\nint main(void)\n{\n    pthread_t tid;\n    // 初始化互斥锁\n    pthread_mutex_init(\u0026lock, NULL);\n    // 创建两个线程，执行同一个工作函数\n    pthread_create(\u0026tid, NULL, thread_job, NULL);\n    pthread_create(\u0026tid, NULL, thread_job, NULL);\n    // 主线程进入无限休眠，保持进程运行\n    while(1)\n        sleep(1);\n    // 销毁互斥锁（注：由于while(1)，这行代码永远不会执行）\n    pthread_mutex_destroy(\u0026lock);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-5iz6ld3","Type":"NodeParagraph","Properties":{"id":"20260505170804-5iz6ld3","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119115729364"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119115729364.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ubw42e8","Type":"NodeParagraph","Properties":{"id":"20260505170804-ubw42e8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"惊群问题：多线程争抢资源，因资源有限，未捡到的线程付出了无意义的系统开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"flag 标记在某线程占用锁资源时自动分发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*就近原则：某个线程释放了锁立即申请，它还会占用锁"}]},{"ID":"20260505170804-j12pef6","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-j12pef6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"读写锁"}]},{"ID":"20260505170804-rhgefer","Type":"NodeParagraph","Properties":{"id":"20260505170804-rhgefer","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"互斥锁不允许多个线程同时访问资源，资源的利用率较低，读写锁可以解决这个问题，它支持一个线程写资源，多个线程可以同时读资源，提高资源利用率\t\t读写锁读写互斥"}]},{"ID":"20260505170804-so387hn","Type":"NodeParagraph","Properties":{"id":"20260505170804-so387hn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"读共享，写独占，读写互斥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"// 定义读写锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_rwlock_t lock;"},{"Type":"NodeText","Data":" // 读写锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"**pthread_rwlock_init(\u0026lock, NULL);\t**\t// 初始化读写锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_rwlock_rdlock(\u0026lock);"},{"Type":"NodeText","Data":"\t\t// 申请读锁（允许多个线程同时持有读锁）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"**pthread_rwlock_wrlock(\u0026lock);\t**\t// 申请写锁（同一时间只能有一个线程持有写锁）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"pthread_rwlock_unlock(\u0026lock);"},{"Type":"NodeText","Data":"\t\t// 释放锁（读锁和写锁都用同一个 unlock 函数释放）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"**pthread_rwlock_destroy(\u0026lock);\t**\t// 销毁读写锁，释放资源"}]},{"ID":"20260505170804-5z7usoi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-5z7usoi","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003cpthread.h\u003e\n// 全局共享变量和读写锁\nint number = 0;\npthread_rwlock_t lock;\n// 写线程函数\nvoid * thread_wr(void * arg)\n{\n    while (1)\n    {\n        // 申请写锁（互斥访问）\n        pthread_rwlock_wrlock(\u0026lock);\n        printf(\"write thread 0x%x ++number = %d\\n\", (unsigned int)pthread_self(), ++number);\n        // 释放锁\n        pthread_rwlock_unlock(\u0026lock);\n        // 模拟写操作间隔\n        usleep(100000);\n    }\n    return NULL;\n}\n// 读线程函数\nvoid * thread_rd(void * arg)\n{\n    while (1)\n    {\n        // 申请读锁（共享访问）\n        pthread_rwlock_rdlock(\u0026lock);\n        printf(\"read thread 0x%x number = %d\\n\", (unsigned int)pthread_self(), number);\n        // 释放锁\n        pthread_rwlock_unlock(\u0026lock);\n        // 模拟读操作间隔\n        usleep(100000);\n    }\n    return NULL;\n}\nint main(void)\n{\n    pthread_t tids[8];\n    int i;\n    // 初始化读写锁\n    pthread_rwlock_init(\u0026lock, NULL);\n    // 创建 3 个写线程\n    for(i=0; i\u003c3; i++)\n    {\n        pthread_create(\u0026tids[i], NULL, thread_wr, NULL);\n    }\n    // 创建 5 个读线程\n    for(; i\u003c8; i++)\n    {\n        pthread_create(\u0026tids[i], NULL, thread_rd, NULL);\n    }\n    // 主线程等待所有子线程结束（防止进程提前退出）\n    for (i = 0; i \u003c 8; i++)\n    {\n        pthread_join(tids[i], NULL);\n    }\n    // 销毁读写锁\n    pthread_rwlock_destroy(\u0026lock);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-hbs7zrt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hbs7zrt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"读写锁是怎么实现的？"}]},{"ID":"20260505170804-ecba266","Type":"NodeParagraph","Properties":{"id":"20260505170804-ecba266","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"读写锁核心：读共享、写独占，基于互斥锁 + 两个条件变量 + 读写计数实现"}]},{"ID":"20260505170804-z67n1q6","Type":"NodeParagraph","Properties":{"id":"20260505170804-z67n1q6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用一把互斥锁保护所有计数和状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"维护读等待数、当前读线程数、写等待数、是否正在写 几个变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加读锁：有正在写或有等待写线程，就阻塞等待；否则读计数 + 1，直接进入读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解读锁：读计数减到 0，唤醒所有等待的写线程。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加写锁：有在读或正在写，就阻塞等待；否则标记写占用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解写锁：释放写标记，优先唤醒写等待线程，再唤醒所有读线程，避免写饥饿。"}]},{"ID":"20260505170804-n03xyi4","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-n03xyi4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"旋转锁/自旋锁"}]},{"ID":"20260505170804-bbycy9g","Type":"NodeParagraph","Properties":{"id":"20260505170804-bbycy9g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不会挂起等待锁，一直重复请求，直到获取成功位置，请求旋转锁的线程不会挂起，一直处于运行态 R"}]},{"ID":"20260507215500-ffh99ec","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507215500-ffh99ec","updated":"20260507215617"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"从需求角度看，什么场景必须用自旋锁？"}]},{"ID":"20260507215500-vi25a5s","Type":"NodeParagraph","Properties":{"id":"20260507215500-vi25a5s","updated":"20260507215219"},"Children":[{"Type":"NodeText","Data":"临界区执行时间极短"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码很快就能执行完释放锁，原地空等比线程切换开销更小"}]},{"ID":"20260507215500-zr5reus","Type":"NodeParagraph","Properties":{"id":"20260507215500-zr5reus","updated":"20260507215300"},"Children":[{"Type":"NodeText","Data":"锁竞争不激烈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大概率一次就能抢到锁，不会长时间空转浪费 CPU"}]},{"ID":"20260507215500-l3k9e8e","Type":"NodeParagraph","Properties":{"id":"20260507215500-l3k9e8e","updated":"20260507215445"},"Children":[{"Type":"NodeText","Data":"不能线程休眠阻塞的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如内核中断、底层数据结构，不允许线程挂起切换，只能用自旋锁"}]},{"ID":"20260507215500-mksnq0v","Type":"NodeParagraph","Properties":{"id":"20260507215500-mksnq0v","updated":"20260507215452"},"Children":[{"Type":"NodeText","Data":"追求低延迟，不想触发内核态上下文切换，需要快速抢锁、快速释放"}]},{"ID":"20260507215617-3cxe0bb","Type":"NodeParagraph","Properties":{"id":"20260507215617-3cxe0bb","updated":"20260507215540"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"操作系统 / 内核"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"硬软中断处理（网卡、定时器、外设中断）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统全局计数、设备状态位更新"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核网络 / 日志 / IO 环形队列读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Per-CPU 私有数据并发保护"}]},{"ID":"20260507215617-zdinr6f","Type":"NodeParagraph","Properties":{"id":"20260507215617-zdinr6f","updated":"20260507215548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"后端高并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络框架 TCP 连接、FD 映射表管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存池 / 对象池节点存取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"QPS 限流、令牌桶、熔断状态计数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"高性能无锁队列头尾指针保护"}]},{"ID":"20260507215617-n4ixkyv","Type":"NodeParagraph","Properties":{"id":"20260507215617-n4ixkyv","updated":"20260507215550"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中间件组件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本地缓存 LRU 链表维护"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时间轮定时任务挂载与摘除"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程池、连接池空闲状态与链表管理"}]},{"ID":"20260507215617-djfu6r4","Type":"NodeParagraph","Properties":{"id":"20260507215617-djfu6r4","updated":"20260507215556"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"客户端 / 嵌入式 / 游戏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UI 线程与工作线程共享状态、进度、开关标记"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"嵌入式传感器、串口实时高频数据采集"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"游戏帧同步、角色 Buff / 状态、对象池、网络帧队列"}]},{"ID":"20260505170804-sm7p7nm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-sm7p7nm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"文件读写锁"}]},{"ID":"20260505170804-rldkm9j","Type":"NodeParagraph","Properties":{"id":"20260505170804-rldkm9j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一把写锁，N 把读锁，读共享，写独占，读写互斥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119143153362"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119143153362.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-zitsp22","Type":"NodeParagraph","Properties":{"id":"20260505170804-zitsp22","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"文件锁通过修改文件锁属性实现上锁和解锁效果，用户需要自定义锁结构体并赋值，而后对文件默认锁结构进行替换，实现文件锁操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"fcntl(fd,F_GETLK,struct flock * lock);"},{"Type":"NodeText","Data":"\t//将文件默认的锁结构体传出到 lock 变量中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"fcntl(fd,F_SETLK,struct flock * newlock);"},{"Type":"NodeText","Data":"\t//将自定义的 newlock 替换文件原有的结构体，实现上锁效果\tF_SETLK 是非阻塞上锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"F_SETLKW \t//阻塞上锁关键字，如果文件锁被占用，则会挂起等待"}]},{"ID":"20260505170804-cdb16gd","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-cdb16gd","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"A代码\nint main(void)\n{\n    // 判断文件锁属性，查看是否可以上锁\n    struct flock old;\n    int fd = open(\"pthread_test.c\", O_RDWR);\n    fcntl(fd, F_GETLK, \u0026old);\n    if(old.l_type == F_UNLCK)\n    {\n        printf(\"process A %d get flock successfully , lock status is unlock.\\n\",getpid());\n        struct flock new;\n        new.l_type = F_WRLCK;\n        new.l_whence = SEEK_SET;\n        new.l_start = 0;\n        new.l_len = 0;\n        fcntl(fd, F_SETLKW, \u0026new);\n        printf(\"process A %d Set write lock successfully.\\n\",getpid());\n        sleep(10);\n        new.l_type = F_UNLCK;\n        fcntl(fd, F_SETLKW, \u0026new);\n        printf(\"process A %d unlock\\n\",getpid());\n    }\n    else\n    {\n        printf(\"pthread_test lock status is not unlock.\\n\");\n    }\n    return 0;\n}\n\nB代码\nint main(void)\n{\n    // 判断文件锁属性，查看是否可以上锁\n    struct flock old;\n    int fd = open(\"pthread_test.c\", O_RDWR);\n    fcntl(fd, F_GETLK, \u0026old);\n    if(old.l_type == F_UNLCK)\n    {\n        printf(\"process A %d get flock successfully , lock status is unlock.\\n\",getpid());\n        struct flock new;\n        new.l_type = F_WRLCK;\n        new.l_whence = SEEK_SET;\n        new.l_start = 0;\n        new.l_len = 0;\n        fcntl(fd, F_SETLKW, \u0026new);\n        printf(\"process A %d Set write lock successfully.\\n\",getpid());\n        sleep(10);\n        new.l_type = F_UNLCK;\n        fcntl(fd, F_SETLKW, \u0026new);\n        printf(\"process A %d unlock\\n\",getpid());\n    }\n    else\n    {\n        printf(\"pthread_test lock status is not unlock.\\n\");\n    }\n    return 0;\n}\n\n这是两个独立的程序，用于演示 fcntl 文件锁的抢占和互斥效果。\n进程 A 会先检查文件是否解锁，如果是就加写锁，持有 10 秒后再释放。\n进程 B 会直接尝试加写锁，如果文件已被进程 A 锁住，它会阻塞等待直到锁被释放。\nF_SETLKW 中的 W 表示 “等待（wait）”，如果锁被占用则阻塞，直到获取到锁。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-38mysdb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-38mysdb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"死锁问题"}]},{"ID":"20260505170804-3dgkamq","Type":"NodeParagraph","Properties":{"id":"20260505170804-3dgkamq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"锁资源有限，但多线程相互请求锁资源导致线程永久阻塞，这种现象称为死锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119152821097"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119152821097.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-d5jflge","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-d5jflge","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"死锁发生的四个必要条件"}]},{"ID":"20260505170804-if8a0ul","Type":"NodeParagraph","Properties":{"id":"20260505170804-if8a0ul","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"请求与保持条件"},{"Type":"NodeText","Data":"：\t某个线程在占用一把锁后还要请求新锁，容易引发死锁问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不可剥夺条件"},{"Type":"NodeText","Data":"：\t    除了占用资源的线程外，其他人无法解锁资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互斥条件"},{"Type":"NodeText","Data":"：\t\t\t   某个线程占用锁资源后，其他线程申请则挂起等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"环路等待条件"},{"Type":"NodeText","Data":"：\t\t每个线程都在等待相邻线程手中的资源，这种称为等待环路"}]},{"ID":"20260505170804-xw5behz","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-xw5behz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"死锁处理"}]},{"ID":"20260505170804-9btanra","Type":"NodeParagraph","Properties":{"id":"20260505170804-9btanra","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"产生死锁后，杀死死锁线程，解除死锁，而后再创建\t(死锁频繁，创建销毁线程开销较大)"}]},{"ID":"20260505170804-fwv1480","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-fwv1480","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"死锁检测"}]},{"ID":"20260505170804-f02xdo2","Type":"NodeParagraph","Properties":{"id":"20260505170804-f02xdo2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有向图检测"},{"Type":"NodeText","Data":"\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"广度，深度优先算法\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以通过图遍历算法，检测出图中是否出现环路，如果是则已发生死锁，可以通过杀死线程的方式杀死某个节点，解除死锁"}]},{"ID":"20260505170804-4v7swtl","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-4v7swtl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"死锁预防"}]},{"ID":"20260505170804-t2j771m","Type":"NodeParagraph","Properties":{"id":"20260505170804-t2j771m","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260119155324250"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260119155324250.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4xctas3","Type":"NodeParagraph","Properties":{"id":"20260505170804-4xctas3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"哲学家只有两种工作模式：思考和进食\t\t思考不占资源，进餐时每个哲学家先获取左手的筷子，再获取右手的筷子"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"死锁现象："},{"Type":"NodeText","Data":"5 名哲学家同时进餐，分别拿起左手筷子，等待获取右手的筷子，产生死锁问题，永久挂起"}]},{"ID":"20260505170804-txieeiw","Type":"NodeParagraph","Properties":{"id":"20260505170804-txieeiw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"礼貌策略："},{"Type":"NodeText","Data":"当某个哲学家拿起左手的资源，发现无法获取右手的资源，它会放下左手资源，让其他人进餐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"活锁问题：如果哲学家同时频繁触发礼貌机制，导致所有哲学家拿起放下餐具，无法进食，饿死"}]},{"ID":"20260505170804-idiswsq","Type":"NodeParagraph","Properties":{"id":"20260505170804-idiswsq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高权级策略:"},{"Type":"NodeText","Data":"选中一名哲学家提高权限，此哲学家要进餐时，向相邻哲学家发送通知，让其放下资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"高权策略，由于优先级转换，可能导致多数时间，只有超级哲学家在进食"}]},{"ID":"20260505170804-bkt04rc","Type":"NodeParagraph","Properties":{"id":"20260505170804-bkt04rc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多线程情景下，资源有限，多线程合理的规避问题，合理使用资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"服务者模式："},{"Type":"NodeText","Data":"\t服务者记录资源占用情况\t\t\t\t每一个哲学家进餐时要询问服务者是否可以，允许则获取资源，不允许放弃本次进餐，进入下一轮行为选择"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"银行家算法"},{"Type":"NodeText","Data":"\t银行家算法将资源都抽象为银行资产，每个用户借款，银行进行借款风险评估，如果风险超出阈值，禁止放款"}]},{"ID":"20260505170804-n2rqzs8","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-n2rqzs8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"线程控制（条件变量）"}]},{"ID":"20260505170804-vuvgfrh","Type":"NodeParagraph","Properties":{"id":"20260505170804-vuvgfrh","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260120114844396"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260120114844396.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-entl1ss","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-entl1ss","updated":"20260505170804"},"Children":[{"ID":"20260505170804-c36eq6b","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-c36eq6b","updated":"20260505170804"},"Children":[{"ID":"20260505170804-15crllu","Type":"NodeParagraph","Properties":{"id":"20260505170804-15crllu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"条件变量技术实现线程的挂起和唤醒"}]}]},{"ID":"20260505170804-sz5yxya","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-sz5yxya","updated":"20260505170804"},"Children":[{"ID":"20260505170804-wg4vhno","Type":"NodeParagraph","Properties":{"id":"20260505170804-wg4vhno","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为线程指定执行条件，按执行条件挂起唤醒控制线程"}]}]}]},{"ID":"20260505170804-qtme5bq","Type":"NodeParagraph","Properties":{"id":"20260505170804-qtme5bq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_cond_t cd"},{"Type":"NodeText","Data":" // 条件变量类型，线程可以挂起在条件变量中，也可以从中唤醒"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_cond_init(pthread_cond_t * cd,NULL);"},{"Type":"NodeText","Data":"// 初始化条件变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_cond_destroy(pthread_cond_t * cd);"},{"Type":"NodeText","Data":" // 销毁释放条件变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"pthread_cond_wait(pthread_cond_t * cd ,pthread_mutex_t * lock)"}]},{"ID":"20260505170804-ymeqhk7","Type":"NodeList","ListData":{"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-ymeqhk7","updated":"20260505170804"},"Children":[{"ID":"20260505170804-e92mfnd","Type":"NodeListItem","Data":"-","ListData":{"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-e92mfnd","updated":"20260505170804"},"Children":[{"ID":"20260505170804-dw0e16y","Type":"NodeParagraph","Properties":{"id":"20260505170804-dw0e16y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"两次执行："}]},{"ID":"20260505170804-ohdbsb7","Type":"NodeParagraph","Properties":{"id":"20260505170804-ohdbsb7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程第一次执行 wait 函数，挂起线程的同时解锁互斥锁"}]},{"ID":"20260505170804-i5u4806","Type":"NodeParagraph","Properties":{"id":"20260505170804-i5u4806","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程被唤醒执行 cond_wait，上锁互斥锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_cond_signal(pthread_cond_t * cd);"},{"Type":"NodeText","Data":"// 唤醒一个挂起在 cd 中的线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pthread_cond_broadcast(pthread_cond_t * cd);"},{"Type":"NodeText","Data":"// 唤醒所有挂起在 cd 中的线程"}]}]},{"ID":"20260505170804-zmgqysn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260505170804-zmgqysn","updated":"20260505170804"},"Children":[{"ID":"20260505170804-o02vqt7","Type":"NodeParagraph","Properties":{"id":"20260505170804-o02vqt7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"signal 函数的误唤醒，如果系统是多核处理器 cpu，signal 函数可能唤醒多个线程，导致误唤醒"}]}]}]},{"ID":"20260505170804-4u2bqnb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-4u2bqnb","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 全局变量：0表示夜晚，1表示白天\nint day_night = 1; // 初始化为白天\npthread_mutex_t lock;\npthread_cond_t cd;\n\n// 线程A：白天执行巡逻任务，夜间休息\nvoid *thread_a(void *arg)\n{\n    // 白天执行巡逻任务，夜间休息\n    while (1) {\n        pthread_mutex_lock(\u0026lock);\n        // 等待条件：如果是夜晚（day_night == 0）则挂起\n        while (day_night == 0) {\n            pthread_cond_wait(\u0026cd, \u0026lock);\n        }\n        printf(\"thread_A cid 0x%x , 白天 %d 完成巡逻任务\\n\", \n               (unsigned int)pthread_self(), day_night);\n        // 切换到夜晚\n        day_night = 0;\n        pthread_mutex_unlock(\u0026lock);\n        // 唤醒等待在条件变量上的线程B\n        pthread_cond_signal(\u0026cd);\n        sleep(1); // 模拟任务执行时间\n    }\n    return NULL;\n}\n// 线程B：夜间执行巡逻任务，白天休息\nvoid *thread_b(void *arg)\n{\n    // 夜间执行巡逻任务，白天休息\n    while (1) {\n        pthread_mutex_lock(\u0026lock);\n        // 等待条件：如果是白天（day_night != 0）则挂起\n        while (day_night) {\n            pthread_cond_wait(\u0026cd, \u0026lock);\n        }\n        printf(\"thread_B cid 0x%x , 夜间 %d 完成巡逻任务\\n\", \n               (unsigned int)pthread_self(), day_night);\n        // 切换到白天\n        day_night = 1;\n        pthread_mutex_unlock(\u0026lock);\n        // 唤醒等待在条件变量上的线程A\n        pthread_cond_signal(\u0026cd);\n        sleep(1); // 模拟任务执行时间\n    }\n    return NULL;\n}\nint main(void)\n{\n    pthread_t tid_a, tid_b;\n    // 初始化互斥锁和条件变量\n    pthread_mutex_init(\u0026lock, NULL);\n    pthread_cond_init(\u0026cd, NULL);\n    // 创建线程\n    pthread_create(\u0026tid_a, NULL, thread_a, NULL);\n    pthread_create(\u0026tid_b, NULL, thread_b, NULL);\n    // 等待线程结束（这里用死循环保持主线程运行）\n    while (1) {\n        sleep(1);\n    }\n    // 销毁资源（实际不会执行到这里，仅作示范）\n    pthread_mutex_destroy(\u0026lock);\n    pthread_cond_destroy(\u0026cd);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-n89asc3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-n89asc3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"生产者消费者模型"}]},{"ID":"20260505170804-nvpnqyp","Type":"NodeParagraph","Properties":{"id":"20260505170804-nvpnqyp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"经典的数据传递或任务传递模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260120115035672"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260120115035672.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-umyx3qw","Type":"NodeParagraph","Properties":{"id":"20260505170804-umyx3qw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"环形队列，设置头尾索引，\t遍历时也要环形队列"}]},{"ID":"20260505170804-y3332dr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-y3332dr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"Socket 套接字"}]},{"ID":"20260505170804-jenzyga","Type":"NodeParagraph","Properties":{"id":"20260505170804-jenzyga","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一般用于网络应用开发，系统提供的一套 API 函数接口，称为套接字函数，网络应用开发是软件工程师开发必备技能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"everything is file,将所有的设备访问方式抽象为文件，可以通过文件描述符访问大多数 Linux 设备"}]},{"ID":"20260505170804-iv8ssca","Type":"NodeParagraph","Properties":{"id":"20260505170804-iv8ssca","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260120150141678"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260120150141678.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-6ikbhda","Type":"NodeParagraph","Properties":{"id":"20260505170804-6ikbhda","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"int sockfd = socket(AF_INET,SOCK_STREAM,int protocol);\t//成功返回 sock_fd,失败返回-1,errno 被设置"}]},{"ID":"20260505170804-pgad2yu","Type":"NodeParagraph","Properties":{"id":"20260505170804-pgad2yu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"struct sockaddr_in addr\t//网络信息结构体类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"addr.sin_family =AF_INET\t\t\t\t\t\t\t\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"addr.sin_port =大端(8080)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"addr.sin_addr.s_addr=大端(ip)"}]},{"ID":"20260505170804-cppc89j","Type":"NodeParagraph","Properties":{"id":"20260505170804-cppc89j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"bind(sock_fd,struct sockaddr * addr,socklen_t addrlen);\t//成功返回 0 失败返回-1\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"绑定可以对 socket 设置自定义的 ip 和端口号，其次当绑定某端口的进程退出，可以临时禁用端口号，时长为 2MSL"}]},{"ID":"20260505170804-4trrceh","Type":"NodeParagraph","Properties":{"id":"20260505170804-4trrceh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"listen(int sockfd,int backlog)\t//成功返回 0\t失败返回-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"//backlog:监听序列数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260120153751840"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260120153751840.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-oluzrot","Type":"NodeParagraph","Properties":{"id":"20260505170804-oluzrot","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"htons()\t小端转大端端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"htonl()\t小端转大端 IP"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ntohs()\t大端转小端端口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ntohl()\t大端转小端 IP"}]},{"ID":"20260505170804-7hvvcer","Type":"NodeParagraph","Properties":{"id":"20260505170804-7hvvcer","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"inet_pton(AF_INET,char *ip,void *addr)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"inet_ntop(AF_INET,void *addr ,char *ip,16)"}]},{"ID":"20260505170804-nb8bjza","Type":"NodeParagraph","Properties":{"id":"20260505170804-nb8bjza","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"connect(int sockfd,struct sockaddr* dest ,socklen_t addrlen);\t//请求连接函数，成功返回 0 失败返回-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"int Csockfd=accept(int Ssockfd, struct sockaddr* addr, socklen_t *addrlen);\t//成功返回 sockfd，失败返回-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ssize_t recv (int sockfd,void * buf ,size_t *size ,int flag);\tMSG_DONTWAIT , 成功返回读取的数据量，失败返回-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ssize_t send(int sockfd,void *buf ,size_t size ,int flag);\t MSG_NOSIGNAL(避免信号杀死)"}]},{"ID":"20260505170804-6dcoqqh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-6dcoqqh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"服务器"}]},{"ID":"20260505170804-pfg71z4","Type":"NodeParagraph","Properties":{"id":"20260505170804-pfg71z4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"服务器是经典的后台服务软件，各个互联网公司与产品都需要后台服务器进行支持，提供业务支持，数据支持等等，服务后台相关领域提供大量就业岗位，服务器概念也是互联网不可或缺的一部分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260121105212788"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260121105212788.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-0w72dtl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0w72dtl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"服务器操作系统"}]},{"ID":"20260505170804-sa5774f","Type":"NodeParagraph","Properties":{"id":"20260505170804-sa5774f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Unix，Linux，Windows Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在服务器基础系统领域，Linux 和 unix 还是独占较大的市场份额"}]},{"ID":"20260505170804-q6g4zei","Type":"NodeParagraph","Properties":{"id":"20260505170804-q6g4zei","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Apache Nginx tomcate\t经典的 Web 服务器，用于网页网站的后台支持"}]},{"ID":"20260505170804-hon7ysd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hon7ysd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"集群概念/分布式结构"}]},{"ID":"20260505170804-cijgeqf","Type":"NodeParagraph","Properties":{"id":"20260505170804-cijgeqf","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260121111508424"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260121111508424.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gssep9y","Type":"NodeParagraph","Properties":{"id":"20260505170804-gssep9y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分布式概念是一种硬件的横向扩展策略，可以提高集群主机的物理性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分布式策略可以通过 socket 技术将各种设备连接起来，统一调度，资源管理，资源共享"}]},{"ID":"20260505170804-tlr0jtf","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-tlr0jtf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"APUE 经典的几种服务器软件开发模式"}]},{"ID":"20260505170804-1t7rsgt","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-1t7rsgt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"1.单进程服务器(本章节样例)"}]},{"ID":"20260505170804-yzi1zus","Type":"NodeParagraph","Properties":{"id":"20260505170804-yzi1zus","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260121114413717"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260121114413717.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-q9kpj0n","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-q9kpj0n","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"2.多进程并发模型"}]},{"ID":"20260505170804-6hjeav0","Type":"NodeParagraph","Properties":{"id":"20260505170804-6hjeav0","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260121144701178.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现一对多处理业务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"父子进程实现业务分离，父进程负责连接，子进程负责处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多进程稳定性更强"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统开销较大(进程开销)，处理进程随用户持续，频繁创建销毁进程开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"僵尸回收较为麻烦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺乏进程管理，并发数量是进程数量"}]},{"ID":"20260505170804-uopqked","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-uopqked","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"3.多线程并发模型"}]},{"ID":"20260505170804-bnmzxy8","Type":"NodeParagraph","Properties":{"id":"20260505170804-bnmzxy8","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260121154849321"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260121154849321.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-t5ka2up","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-t5ka2up","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"4.IO 复用模型/多路 IO 转接：可以同时监听多个 socket 事件"}]},{"ID":"20260505170804-jcggsa9","Type":"NodeParagraph","Properties":{"id":"20260505170804-jcggsa9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关于 recv 和 accept 工作流程"}]},{"ID":"20260505170804-lejwl9c","Type":"NodeParagraph","Properties":{"id":"20260505170804-lejwl9c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"传统阻塞监听，处理就绪"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122110449878"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122110449878.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122110512109"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122110512109.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122110555343"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122110555343.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"*? 监听到 socket 事件就绪后，直接调用 accept 或 recv 即可，直接完成 tcp 连接或者数据读取，两个函数不会阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以实现单进程一对多效果，但是没有使用并发效果，处理的业务复杂度不能过高，要在极短时间内处理若干任务，处理第二次监听"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理的业务复杂度不能过高，要在极短的时间内处理若干任务，投入第二次监听"}]},{"ID":"20260505170804-bydyxiv","Type":"NodeParagraph","Properties":{"id":"20260505170804-bydyxiv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"传统阻塞：线程和单个 socket “强绑定”，只能串行处理，无并发能力；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IO 复用：线程和内核 epoll “交互”，内核替线程管理所有 socket，就绪才通知处理，实现高并发 + 高效 CPU 利用。"}]},{"ID":"20260505170804-p39m44k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-p39m44k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"select 模型"}]},{"ID":"20260505170804-hruqvpk","Type":"NodeParagraph","Properties":{"id":"20260505170804-hruqvpk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最大监听数量 1024 个(实际达不到 1024 个)\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"fd_set set;\t//监听集合类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122120013749"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122120013749.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件描述符与监听集合有对应关系，基础描述符占用监听位，导致 socket 监听集合中最大只能监听 1021 个用户 socket"}]},{"ID":"20260505170804-as62zbt","Type":"NodeParagraph","Properties":{"id":"20260505170804-as62zbt","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Select 模型的工作流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122151657845"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122151657845.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-p3mv7vg","Type":"NodeParagraph","Properties":{"id":"20260505170804-p3mv7vg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"struct timeval val;\t//时间结构体"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"timeval * val =NULL\t//阻塞监听"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定义时间结构体初始化为 0，传入，则表达式非阻塞工作，定义时间结构体，设定固定时长，实现定时阻塞"}]},{"ID":"20260505170804-tk21pjk","Type":"NodeParagraph","Properties":{"id":"20260505170804-tk21pjk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"int\tready = select(maxfd+1,\u0026set ,\u0026set,\u0026set，NULL);\t//\u0026set 传时间(读，写，异常)\t最后一个参数传工作方式"}]},{"ID":"20260505170804-u1yyxko","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-u1yyxko","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e          // 标准输入输出头文件\n#include \u003cunistd.h\u003e         // Unix 标准函数头文件 (close, read, write 等)\n#include \u003cstring.h\u003e         // 字符串处理函数头文件 (memset, strcmp 等)\n#include \u003csys/socket.h\u003e     // socket 相关函数头文件\n#include \u003carpa/inet.h\u003e      // 网络地址转换相关函数头文件 (inet_ntop, htons 等)\n#include \u003cstdlib.h\u003e         // 标准库函数头文件 (exit, malloc 等)\n#include \u003csys/time.h\u003e       // 时间相关函数头文件 (select 依赖)\n#include \u003ctime.h\u003e           // 时间处理函数头文件 (time, ctime 等)\n\n// 服务器运行状态标记: 1-运行中, 0-停止\nint Shutdown = 1;\n// 客户端 socket 数组, 存储所有已连接的客户端文件描述符\n// 初始值设为 -1 (无效值), 最大支持 1020 个客户端连接\nint client_array[1020];\nint socket_init(void);\nint return_response(int clientfd, const char *clientip);\n\n//拼接包含客户端 IP 地址的欢迎字符串，并将该字符串发送给刚建立连接的客户端\nint return_response(int clientfd, const char *clientip) {\n    char response[4096]; // 存储欢迎消息的缓冲区\n    bzero(response, sizeof(response)); // 清空缓冲区\n    // 拼接欢迎消息 (包含客户端 IP)\n    sprintf(response, \"hi %s welcome test TCP server!\\n\", clientip);\n    // 发送欢迎消息给客户端 (最后一个参数 0 表示默认发送方式)\n    send(clientfd, response, strlen(response), 0);\n    return 0;\n}\n    \nint socket_init(void) {\n    int sockfd;                     // 监听 socket 描述符\n    struct sockaddr_in sockaddr;    // 服务器地址结构体\n    // 清空地址结构体内存 (等同于 memset(\u0026sockaddr, 0, sizeof(sockaddr)))\n    bzero(\u0026sockaddr, sizeof(sockaddr));\n    sockaddr.sin_family = AF_INET;  // 设置地址族为 IPv4\n    sockaddr.sin_port = htons(8080); // 设置监听端口 8080 (htons 转换为网络字节序)\n    // 设置监听的 IP 地址为 0.0.0.0 (INADDR_ANY), 即监听所有网卡\n    sockaddr.sin_addr.s_addr = htonl(INADDR_ANY);\n    // 创建 TCP socket (SOCK_STREAM 表示流式套接字, 对应 TCP)\n    if ((sockfd = socket(AF_INET, SOCK_STREAM, 0)) == -1) {\n        perror(\"socket call failed\"); // 打印 socket 创建失败原因\n        exit(0);                      // 退出程序\n    }\n    // 将 socket 绑定到指定的 IP 和端口\n    if ((bind(sockfd, (struct sockaddr *)\u0026sockaddr, sizeof(sockaddr))) == -1) {\n        perror(\"bind call failed\"); // 打印 bind 失败原因\n        exit(0);                    // 退出程序\n    }\n    // 开始监听 socket, 最大待处理连接数为 128\n    listen(sockfd, 128);\n    return sockfd; // 返回监听 socket 描述符\n}\n\nint main(void) {\n    int serverfd;          // 服务器监听 socket 描述符\n    int maxfd;             // 用于 select 的最大文件描述符 (select 需监听 maxfd+1 个描述符)\n    int clientfd;          // 新连接的客户端 socket 描述符\n    int ready;             // select 返回的就绪文件描述符数量\n    struct sockaddr_in clientaddr; // 客户端地址结构体\n    socklen_t addrlen;     // 客户端地址结构体长度\n    char recv_buf[1500];    // 接收客户端数据的缓冲区\n    char client_ip[16];    // 存储客户端 IP 地址 (IPv4 地址最长 15 位 + 结束符)\n    time_t t;              // 时间戳变量\n    char time_buf[1024];   // 存储时间字符串的缓冲区\n    fd_set set, oset;      // select 用的文件描述符集合: \n                           // oset-原始集合 (保存所有需要监听的描述符), set-临时集合 (每次 select 前拷贝)\n    // 初始化监听 socket\n    serverfd = socket_init();\n    // 清空文件描述符集合\n    FD_ZERO(\u0026oset);\n    // 将监听 socket 加入原始集合 (监听新连接)\n    FD_SET(serverfd, \u0026oset);\n    // 初始化客户端 socket 数组 (所有元素设为 -1, 表示无有效连接)\n    for (int i = 0; i \u003c 1020; i++) {\n        client_array[i] = -1;\n    }\n    // 初始最大文件描述符为监听 socket\n    maxfd = serverfd;\n    // 打印服务器启动提示\n    printf(\"testing Select server service Running...\\n\");\n    // 服务器主循环 (Shutdown 为 1 时持续运行)\n    while (Shutdown) {\n        // 每次 select 前, 将原始集合拷贝到临时集合 (select 会修改传入的集合)\n        set = oset;\n        if ((ready = select(maxfd + 1, \u0026set, NULL, NULL, NULL)) == -1) {\n            perror(\"select call failed\"); // 打印 select 失败原因\n            exit(0);                      // 退出程序\n        }\n        // 处理所有就绪的文件描述符 (ready 为就绪数量, 处理一个减一个)\n        while (ready) {\n            // 1. 处理新客户端连接 (监听 socket 就绪)\n            if (FD_ISSET(serverfd, \u0026set)) {\n                addrlen = sizeof(clientaddr); // 设置地址结构体长度\n                // 接受新连接 (返回客户端 socket 描述符)\n                if ((clientfd = accept(serverfd, (struct sockaddr *)\u0026clientaddr, \u0026addrlen)) == -1) {\n                    perror(\"accept call failed\"); // 打印 accept 失败原因\n                    exit(0);                      // 退出程序\n                }\n                // 将客户端网络字节序的 IP 转换为字符串格式 (存储到 client_ip)\n                inet_ntop(AF_INET, \u0026clientaddr.sin_addr.s_addr, client_ip, 16);\n                // 打印客户端连接信息 (IP + 端口, ntohs 转换为主机字节序)\n                printf(\"Listen server socket success, call Accept, client ip %s client prot %d\\n\", \n                       client_ip, ntohs(clientaddr.sin_port));\n                // 向新客户端发送欢迎消息\n                return_response(clientfd, client_ip);\n                // 更新最大文件描述符 (select 需要)\n                if (maxfd \u003c clientfd) {\n                    maxfd = clientfd;\n                }\n                // 将新客户端 socket 加入客户端数组 (找第一个空闲位置)\n                for (int i = 0; i \u003c 1020; i++) {\n                    if (client_array[i] == -1) {\n                        client_array[i] = clientfd;\n                        break;\n                    }\n                }\n                // 将新客户端 socket 加入原始集合 (监听其读事件)\n                FD_SET(clientfd, \u0026oset);\n                ready--; // 就绪数减 1\n            } \n            // 2. 处理已连接客户端的读事件 (客户端发数据/断开连接)\n            else {\n                // 遍历客户端数组, 找到就绪的客户端 socket\n                for (int i = 0; i \u003c 1020; i++) {\n                    // 跳过无效连接, 检查当前客户端 socket 是否在就绪集合中\n                    if (client_array[i] != -1 \u0026\u0026 FD_ISSET(client_array[i], \u0026set)) {\n                        // 接收客户端数据 (recvlen 为实际接收的字节数)\n                        ssize_t recvlen = recv(client_array[i], recv_buf, sizeof(recv_buf), 0);\n                        // 情况1: 成功接收数据 (recvlen \u003e 0)\n                        if (recvlen \u003e 0) {\n                            recv_buf[recvlen] = '\\0'; // 手动添加字符串结束符 (避免乱码)                            \n                            // 判断客户端是否发送 \"gettime\\n\" 命令 (获取当前时间)\n                            if (strcmp(recv_buf, \"gettime\\n\") == 0) {\n                                bzero(time_buf, sizeof(time_buf)); // 清空时间缓冲区\n                                t = time(NULL);                   // 获取当前时间戳\n                                ctime_r(\u0026t, time_buf);            // 将时间戳转换为字符串 (线程安全版本)\n                                // 发送时间字符串给客户端\n                                send(client_array[i], time_buf, strlen(time_buf), 0);\n                                bzero(time_buf, sizeof(time_buf)); // 清空缓冲区\n                            } \n                            // 其他命令: 提示重试\n                            else {\n                                send(client_array[i], \"Please Try Again...\\n\", 20, 0);\n                            }\n                        } \n                        // 情况2: 客户端断开连接 (recvlen == 0)\n                        else if (recvlen == 0) {\n                            // 从原始集合中移除该客户端 socket (不再监听)\n                            FD_CLR(client_array[i], \u0026oset);\n                            close(client_array[i]); // 关闭客户端 socket\n                            client_array[i] = -1;    // 标记为无效连接\n                            printf(\"User exiting, delete this listen item.\\n\"); // 打印断开提示\n                        }\n                        ready--; // 就绪数减 1\n                    }\n                }\n            }\n        }\n    }\n    // 服务器停止: 打印提示并关闭监听 socket\n    printf(\"server down...\\n\");\n     // 优化：关闭所有客户端连接\n    for (int i = 0; i \u003c 1020; i++) {\n        if (client_array[i] != -1) {\n            close(client_array[i]);\n        }\n    }\n    close(serverfd);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-4zyzkgm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-4zyzkgm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"select 模型利弊"}]},{"ID":"20260505170804-4cbmpcn","Type":"NodeParagraph","Properties":{"id":"20260505170804-4cbmpcn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以通过简单的代码实现一对多效果，比较轻量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 模型拥有很强的兼容性，各个平台和语言都有实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持微秒级别的定时阻塞监听，如果对时间精度有需求，select 可以满足"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"较为适合监听数量较小(局域网)等场景"}]},{"ID":"20260505170804-uwpust9","Type":"NodeParagraph","Properties":{"id":"20260505170804-uwpust9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"缺点："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"监听数量较小，最大只能监听 1024，无法满足高并发需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"轮询问题，随着轮询数量的增长，IO 处理性能呈线性下降"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户需要对传入传出监听集合进行分离设置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 只返回就绪的数量，没有反馈就绪的 socket，需要用户自行遍历查找，开销较大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 可以监听的事件较少，select 设置监听是批处理以集合为单位的，无法对不同的 socket 设置不同的事件监听"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 多轮使用会出现大量重复的拷贝开销和挂载监听开销"}]},{"ID":"20260505170804-p4625tt","Type":"NodeParagraph","Properties":{"id":"20260505170804-p4625tt","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260122230305941"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260122230305941.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-eld1bps","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-eld1bps","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"POLL 模型"}]},{"ID":"20260505170804-sj66ax1","Type":"NodeParagraph","Properties":{"id":"20260505170804-sj66ax1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"poll 模型允许用户自定义长度数组，作为监听集合，每个元素都是 struct pollfd node"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"struct pollfd listen_array[100000];\t//自定义长度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"struct pollfd node;"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"node.fd=sockfd;\t//存储监听的 socket,取消监听设成-1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"node.event=POLLIN || POLLOUT || POLLERR\t//设置要监听的 socket 事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"node.revents= POLLIN\t//当 socket 就绪后，传出就绪事件，后续使用 revents 判断 socket 就绪"}]},{"ID":"20260505170804-vuzs5yt","Type":"NodeParagraph","Properties":{"id":"20260505170804-vuzs5yt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"int ready=poll(listen_array, int nfds, int timeout);\ttimeout(-1 阻塞)\t(\u003e0 定时阻塞)\t(0 非阻塞)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"//poll 默认阻塞监听，监听到就绪后返回就绪的数量，用户处理就绪即可"}]},{"ID":"20260505170804-igb43lm","Type":"NodeParagraph","Properties":{"id":"20260505170804-igb43lm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以用 poll 的监听数组，存储所有客户端 socket"}]},{"ID":"20260505170804-3ui23if","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-3ui23if","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e          // 标准输入输出头文件\n#include \u003cunistd.h\u003e         // Unix 标准函数头文件 (close, read, write 等)\n#include \u003cstring.h\u003e         // 字符串处理函数头文件 (memset, strcmp 等)\n#include \u003csys/socket.h\u003e     // socket 相关函数头文件\n#include \u003carpa/inet.h\u003e      // 网络地址转换相关函数头文件 (inet_ntop, htons 等)\n#include \u003cstdlib.h\u003e         // 标准库函数头文件 (exit, malloc 等)\n#include \u003cpoll.h\u003e           // poll 模型核心头文件 (替代 sys/time.h)\n#include \u003ctime.h\u003e           // 时间处理函数头文件 (time, ctime 等)\n// 服务器运行状态标记: 1-运行中, 0-停止\nint Shutdown = 1;\n// 最大支持的连接数\t\n#define MAX_CONNECTIONS 4000\n// pollfd 结构体数组: 存储所有要监听的文件描述符及事件 (替代 select 的 fd_set 和 client_array)\nstruct pollfd fds[MAX_CONNECTIONS];\t\t//即是监听集合又是socket数组\n// 已连接的客户端数量 (用于维护 pollfd 数组)\nint client_count = 0;\nint socket_init(void);\nint return_response(int clientfd, const char *clientip);\n// 拼接包含客户端 IP 地址的欢迎字符串，并将该字符串发送给刚建立连接的客户端\n\nint return_response(int clientfd, const char *clientip) {\n    char response[4096]; // 存储欢迎消息的缓冲区\n    bzero(response, sizeof(response)); // 清空缓冲区\n    // 拼接欢迎消息 (包含客户端 IP)\n    sprintf(response, \"hi %s welcome test TCP server!\\n\", clientip);\n    // 发送欢迎消息给客户端 (最后一个参数 0 表示默认发送方式)\n    send(clientfd, response, strlen(response), 0);\n    return 0;\n}\n\nint socket_init(void) {\n    int sockfd;                     // 监听 socket 描述符\n    struct sockaddr_in sockaddr;    // 服务器地址结构体\n    // 清空地址结构体内存 (等同于 memset(\u0026sockaddr, 0, sizeof(sockaddr)))\n    bzero(\u0026sockaddr, sizeof(sockaddr));\n    sockaddr.sin_family = AF_INET;  // 设置地址族为 IPv4\n    sockaddr.sin_port = htons(8080); // 设置监听端口 8080 (htons 转换为网络字节序)\n    // 设置监听的 IP 地址为 0.0.0.0 (INADDR_ANY), 即监听所有网卡\n    sockaddr.sin_addr.s_addr = htonl(INADDR_ANY);\n    // 创建 TCP socket (SOCK_STREAM 表示流式套接字, 对应 TCP)\n    if ((sockfd = socket(AF_INET, SOCK_STREAM, 0)) == -1) {\n        perror(\"socket call failed\"); // 打印 socket 创建失败原因\n        exit(0);                      // 退出程序\n    }\n    // 将 socket 绑定到指定的 IP 和端口\n    if ((bind(sockfd, (struct sockaddr *)\u0026sockaddr, sizeof(sockaddr))) == -1) {\n        perror(\"bind call failed\"); // 打印 bind 失败原因\n        exit(0);                    // 退出程序\n    }\n    // 开始监听 socket, 最大待处理连接数为 128\n    listen(sockfd, 128);\n    return sockfd; // 返回监听 socket 描述符\n}\n\nint main(void) {\n    int serverfd;          // 服务器监听 socket 描述符\n    int ready;             // poll 返回的就绪文件描述符数量\n    int clientfd;          // 新连接的客户端 socket 描述符\n    struct sockaddr_in clientaddr; // 客户端地址结构体\n    socklen_t addrlen;     // 客户端地址结构体长度\n    char recv_buf[1500];   // 接收客户端数据的缓冲区\n    char client_ip[16];    // 存储客户端 IP 地址 (IPv4 地址最长 15 位 + 结束符)\n    time_t t;              // 时间戳变量\n    char time_buf[1024];   // 存储时间字符串的缓冲区\n    // 1. 初始化监听 socket\n    serverfd = socket_init();\n    // 2. 初始化 pollfd 数组 (核心改造点：替代 select 的 fd_set)\n    // 先清空整个 pollfd 数组\n    bzero(fds, sizeof(fds));\n    // 配置监听 socket 的 pollfd 结构体 (数组第 0 位固定给监听 socket)\n    fds[0].fd = serverfd;\n    fds[0].events = POLLIN; // 监听读事件 (新连接到来属于读事件)\n    fds[0].revents = 0;     // 实际发生的事件，由 poll 填充，初始化为 0\n    \n    // 3. 初始化剩余 pollfd 项 (fd = -1 表示该位置空闲，不监听)\n    for (int i = 1; i \u003c MAX_CONNECTIONS; i++) {\n        fds[i].fd = -1;\n        fds[i].events = 0;\n        fds[i].revents = 0;\n    }\n    // 4. 打印服务器启动提示\n    printf(\"testing Poll server service Running...\\n\");\n    // 5. 服务器主循环 (Shutdown 为 1 时持续运行)\n    while (Shutdown) {\n        // 调用 poll 监听所有有效文件描述符 (核心改造点：替代 select)\n        // 参数说明：\n        // 1. fds: pollfd 数组首地址\n        // 2. MAX_CONNECTIONS: 要监听的 pollfd 数组长度\n        // 3. -1: 超时时间 (永久阻塞，直到有事件就绪，等同于 select 的 NULL)\n        if ((ready = poll(fds, MAX_CONNECTIONS, -1)) == -1) {\n            perror(\"poll call failed\"); // 打印 poll 失败原因\n            exit(0);                    // 退出程序\n        }        \n        // 6. 处理所有就绪的文件描述符 (遍历 pollfd 数组，处理就绪事件)\n        for (int i = 0; i \u003c MAX_CONNECTIONS \u0026\u0026 ready \u003e 0; i++) {\n            // 跳过空闲的 pollfd 项 (fd = -1)\n            if (fds[i].fd == -1) {\n                continue;\n            }          \n            // 检查当前 pollfd 是否有就绪事件 (revents 与 events 匹配)\n            if (!(fds[i].revents \u0026 POLLIN)) {\n                continue;\n            }           \n            // 就绪数减 1 (处理一个就绪事件)\n            ready--;   \n            // 7. 处理新客户端连接 (监听 socket 就绪，对应 pollfd 数组第 0 位)\n            if (fds[i].fd == serverfd) {\n                addrlen = sizeof(clientaddr); // 设置地址结构体长度\n                // 接受新连接 (返回客户端 socket 描述符)\n                if ((clientfd = accept(serverfd, (struct sockaddr *)\u0026clientaddr, \u0026addrlen)) == -1) {\n                    perror(\"accept call failed\"); // 打印 accept 失败原因\n                    exit(0);                      // 退出程序\n                }              \n                // 将客户端网络字节序的 IP 转换为字符串格式 (存储到 client_ip)\n                inet_ntop(AF_INET, \u0026clientaddr.sin_addr.s_addr, client_ip, 16);               \n                // 打印客户端连接信息 (IP + 端口，ntohs 转换为主机字节序)\n                printf(\"Listen server socket success, call Accept, client ip %s client port %d\\n\", \n                       client_ip, ntohs(clientaddr.sin_port));           \n                // 向新客户端发送欢迎消息\n                return_response(clientfd, client_ip);              \n                // 8. 找到 pollfd 数组中的空闲位置，配置新客户端的监听事件\n                int free_index = -1;\n                for (int j = 1; j \u003c MAX_CONNECTIONS; j++) {\n                    if (fds[j].fd == -1) {\n                        free_index = j;\n                        break;\n                    }\n                }                \n                // 检查是否超出最大连接数\n                if (free_index == -1) {\n                    printf(\"Max connections reached, reject client %s\\n\", client_ip);\n                    close(clientfd);\n                    continue;\n                }               \n                // 配置新客户端的 pollfd 结构体\n                fds[free_index].fd = clientfd;\n                fds[free_index].events = POLLIN; // 监听客户端的读事件 (发数据/断开连接)\n                fds[free_index].revents = 0;\n                // 更新已连接客户端数量\n                client_count++;\n            } \n            // 9. 处理已连接客户端的读事件 (客户端发数据/断开连接)\n            else {\n                // 接收客户端数据 (recvlen 为实际接收的字节数)\n                ssize_t recvlen = recv(fds[i].fd, recv_buf, sizeof(recv_buf) - 1, 0); // 留 1 位给 '\\0'\n                // 情况1: 成功接收数据 (recvlen \u003e 0)\n                if (recvlen \u003e 0) {\n                    recv_buf[recvlen] = '\\0'; // 手动添加字符串结束符 (避免乱码)                    \n                    // 判断客户端是否发送 \"gettime\\n\" 命令 (获取当前时间)\n                    if (strcmp(recv_buf, \"gettime\\n\") == 0) {\n                        bzero(time_buf, sizeof(time_buf)); // 清空时间缓冲区\n                        t = time(NULL);                   // 获取当前时间戳\n                        ctime_r(\u0026t, time_buf);            // 将时间戳转换为字符串 (线程安全版本)\n                        // 发送时间字符串给客户端\n                        send(fds[i].fd, time_buf, strlen(time_buf), 0);\n                        bzero(time_buf, sizeof(time_buf)); // 清空缓冲区\n                    } \n                    // 其他命令: 提示重试\n                    else {\n                        send(fds[i].fd, \"Please Try Again...\\n\", 20, 0);\n                    }\n                } \n                // 情况2: 客户端断开连接 (recvlen == 0) 或接收失败 (recvlen == -1)\n                else {\n                    if (recvlen == 0) {\n                        printf(\"User exiting, delete this listen item.\\n\"); // 打印断开提示\n                    } else {\n                        perror(\"recv call failed\");\n                    }\n                    \n                    // 关闭客户端 socket\n                    close(fds[i].fd);\n                    // 标记该 pollfd 项为空闲 (fd = -1)，不再监听\n                    fds[i].fd = -1;\n                    fds[i].events = 0;\n                    fds[i].revents = 0;\n                    // 更新已连接客户端数量\n                    client_count--;\n                }\n            }\n        }\n    }   \n    // 10. 服务器停止: 关闭所有连接\n    printf(\"server down...\\n\");\n    for (int i = 0; i \u003c MAX_CONNECTIONS; i++) {\n        if (fds[i].fd != -1) {\n            close(fds[i].fd);\n        }\n    }  \n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-h9c5czp","Type":"NodeParagraph","Properties":{"id":"20260505170804-h9c5czp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"命令查看系统可以使用的描述符最大值\tcat /proc/sys/fs/file-max"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sudo vi /etc/security/limits.conf"}]},{"ID":"20260505170804-0xffhb9","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-0xffhb9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"POLL 模型利弊"}]},{"ID":"20260505170804-y6xgad0","Type":"NodeParagraph","Properties":{"id":"20260505170804-y6xgad0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"poll 可以监听的事件数量更丰富"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"poll 可以对不同的 socket 进行不同的监听设置，设置方式更灵活"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进行了传入传出分离设置，event 传入监听的事件，revents 传出就绪事件"}]},{"ID":"20260505170804-5khgnw2","Type":"NodeParagraph","Properties":{"id":"20260505170804-5khgnw2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"轮询问题，随着轮询数量的增长，IO 处理性能呈线性下降？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"poll 只返回就绪的数量，没有反馈就绪的 socket，需要用户自行遍历查找，开销较大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"poll 多轮使用会出现大量重复的拷贝开销和挂载监听开销"}]},{"ID":"20260505170804-kjne732","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-kjne732","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"EPOLL 模型"}]},{"ID":"20260505170804-9rbmb28","Type":"NodeParagraph","Properties":{"id":"20260505170804-9rbmb28","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124132404240"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260124132404240.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无法变更监听的 socket 只能修改监听的事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll 监听到就绪后，会将就绪的节点传出到就绪队列中，用户只需要遍历就绪队列处理这些节点即可"}]},{"ID":"20260505170804-62sws6t","Type":"NodeParagraph","Properties":{"id":"20260505170804-62sws6t","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124132018985"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260124132018985.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124132207425"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260124132207425.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-gk1nlsr","Type":"NodeParagraph","Properties":{"id":"20260505170804-gk1nlsr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll 的监听树在内核层创建，每个监听节点只拷贝一次并且只挂载一次，避免了重复拷贝和挂载的开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"红黑树，双向链表(就绪链表)，等待队列"}]},{"ID":"20260505170804-kqgk4q2","Type":"NodeParagraph","Properties":{"id":"20260505170804-kqgk4q2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"callback 将监听的数据变为 epitem，与网络设备绑定，实现监听"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"pitem"},{"Type":"NodeText","Data":" 不直接和「网络设备（网卡）」绑定，而是和「被监听的文件描述符（socket）」绑定，最终通过内核协议栈、中断机制间接关联到网络设备。"}]},{"ID":"20260505170804-vucf05f","Type":"NodeParagraph","Properties":{"id":"20260505170804-vucf05f","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"callback(),将就绪的 epitem 传出到就绪链表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll_wait，进行阻塞监听，进程挂起到等待队列中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"**callback(),传出完就绪唤醒等待进程\t**\tpthread_cond 条件变量实现挂起唤醒"}]},{"ID":"20260505170804-2jq68ee","Type":"NodeParagraph","Properties":{"id":"20260505170804-2jq68ee","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"遍历链表，有就绪则拷贝传出\t\t就绪链表使用时，采用 Spinlock 旋转锁"}]},{"ID":"20260505170804-a85682i","Type":"NodeParagraph","Properties":{"id":"20260505170804-a85682i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核层就绪链表传到用户层就绪数组中 epoll_event[ ]\t当就绪链表检测到有可传出数据后，将就绪数据拷贝到用户层数组中，便于处理"}]},{"ID":"20260505170804-o4lc5sf","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-o4lc5sf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"EPOLL 模型利弊"}]},{"ID":"20260505170804-ekq81i4","Type":"NodeParagraph","Properties":{"id":"20260505170804-ekq81i4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 有强大的监听能力，而且没有额外开销，理论上可以监听系统最大描述符数量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll 监听到就绪直接传出就绪的 socket 到用户层，用户直接处理即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll 有丰富的监听事件，设置监听的灵活性更好"}]},{"ID":"20260505170804-s6fgdrw","Type":"NodeParagraph","Properties":{"id":"20260505170804-s6fgdrw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 较为适合高并发低活跃场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 适用于低监听量，高活跃的场景"}]},{"ID":"20260505170804-meezpja","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-meezpja","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"epoll 代码"}]},{"ID":"20260505170804-x0udl7m","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-x0udl7m","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cstdio.h\u003e          // 标准输入输出头文件\n#include \u003cunistd.h\u003e         // Unix 标准函数头文件 (close, read, write 等)\n#include \u003cstring.h\u003e         // 字符串处理函数头文件 (memset, strcmp 等)\n#include \u003csys/socket.h\u003e     // socket 相关函数头文件\n#include \u003carpa/inet.h\u003e      // 网络地址转换相关函数头文件 (inet_ntop, htons 等)\n#include \u003cstdlib.h\u003e         // 标准库函数头文件 (exit, malloc 等)\n#include \u003csys/epoll.h\u003e      // epoll 模型核心头文件\n#include \u003ctime.h\u003e           // 时间处理函数头文件 (time, ctime 等)\n#define MAX_EVENTS 20000\n// 服务器运行状态标记: 1-运行中, 0-停止\nint Shutdown = 1;\nstruct epoll_event client_array[MAX_EVENTS]; // 用于接收就绪事件的队列\n// 拼接包含客户端 IP 地址的欢迎字符串，并将该字符串发送给刚建立连接的客户端\nint return_response(int clientfd, const char *clientip);\nint socket_init(void);\nint return_response(int clientfd, const char *clientip) {\n    char response[4096]; // 存储欢迎消息的缓冲区\n    bzero(response, sizeof(response)); // 清空缓冲区\n    // 拼接欢迎消息 (包含客户端 IP)\n    sprintf(response, \"hi %s welcome test TCP server!\\n\", clientip);\n    // 发送欢迎消息给客户端 (最后一个参数 0 表示默认发送方式)\n    send(clientfd, response, strlen(response), 0);\n    return 0;\n}\n\n// 初始化 socket (保留原核心逻辑，无多余修改)\nint socket_init(void) {\n    int sockfd;                     // 监听 socket 描述符\n    struct sockaddr_in sockaddr;    // 服务器地址结构体\n    bzero(\u0026sockaddr, sizeof(sockaddr));\n    sockaddr.sin_family = AF_INET;  // 设置地址族为 IPv4\n    sockaddr.sin_port = htons(8080); // 设置监听端口 8080 (htons 转换为网络字节序)\n    sockaddr.sin_addr.s_addr = htonl(INADDR_ANY); // 监听所有网卡\n    // 创建 TCP socket\n    if ((sockfd = socket(AF_INET, SOCK_STREAM, 0)) == -1) {\n        perror(\"socket call failed\");\n        exit(0);\n    }\n    // 绑定 IP 和端口\n    if ((bind(sockfd, (struct sockaddr *)\u0026sockaddr, sizeof(sockaddr))) == -1) {\n        perror(\"bind call failed\");\n        exit(0);\n    }\n    // 开始监听 socket, 最大待处理连接数为 128\n    listen(sockfd, 128);\n    return sockfd; // 返回监听 socket 描述符\n}\n\nint main(void) {\n    int serverfd;          // 服务器监听 socket 描述符\n    int epollfd;           // epoll 实例描述符\n    int ready;             // epoll_wait 返回的就绪事件数量\n    int clientfd;          // 新连接的客户端 socket 描述符\n    struct sockaddr_in clientaddr; // 客户端地址结构体\n    socklen_t addrlen = sizeof(clientaddr); // 客户端地址结构体长度\n    char recv_buf[1500];   // 接收客户端数据的缓冲区\n    char client_ip[16];    // 存储客户端 IP 地址 (IPv4 地址最长 15 位 + 结束符)\n    time_t t;              // 时间戳变量\n    char time_buf[1024];   // 存储时间字符串的缓冲区\n    bzero(time_buf,sizeof(time_buf));\n\tbzero(recv_buf,sizeof(recv_buf));\n\tbzero(client_ip,sizeof(client_ip));\n    // epoll 核心：就绪事件队列 (替代原 pollfd 数组)\n    struct epoll_event ev;          // 用于注册事件的结构体\n    // 1. 初始化监听 socket\n    serverfd = socket_init();\n    // 2. 创建 epoll 实例 (参数 \u003e0 即可，内核会忽略具体值，仅用于兼容旧版本)\t创建监听树\n    if ((epollfd = epoll_create(1)) == -1) {\n        perror(\"epoll_create call failed\");\n        exit(0);\n    }\n    // 3. 注册监听 socket 的读事件到 epoll 实例\n    ev.events = EPOLLIN;    // 监听读事件 (新连接到来)\n    ev.data.fd = serverfd;  // 绑定监听 socket 描述符\n    if (epoll_ctl(epollfd, EPOLL_CTL_ADD, serverfd, \u0026ev) == -1) {\n        perror(\"epoll_ctl add serverfd failed\");\n        exit(0);\n    }\n    // 4. 打印服务器启动提示\n    printf(\"testing Epoll server service Running...\\n\");\n    // 5. 服务器主循环 (Shutdown 为 1 时持续运行)\n    while (Shutdown) {\n        // 调用 epoll_wait 等待就绪事件 (核心：替代 poll，填充就绪队列 client_array)\n        // 参数说明：\n        // 1. epollfd: epoll 实例描述符\n        // 2. client_array: 接收就绪事件的缓冲区 (就绪队列)\n        // 3. MAX_EVENTS: 一次最多接收的就绪事件数\n        // 4. -1: 永久阻塞，直到有事件就绪\n        ready = epoll_wait(epollfd, client_array, MAX_EVENTS, -1);\n        if (ready == -1) {\n            perror(\"epoll_wait call failed\");\n            exit(0);\n        }\n        // 6. 遍历就绪队列，处理所有就绪事件\n        for (int i = 0; i \u003c ready; i++) {\n            // 过滤无效事件 (非读事件，直接跳过)\n            if (!(client_array[i].events \u0026 EPOLLIN)) {\n                continue;\n            }\n            // 7. 处理新客户端连接 (监听 socket 就绪)\n            if (client_array[i].data.fd == serverfd) {\n                // 接受新连接\n                clientfd = accept(serverfd, (struct sockaddr *)\u0026clientaddr, \u0026addrlen);\n                if (clientfd == -1) {\n                    perror(\"accept call failed\");\n                    continue;\n                }\n                // 转换客户端 IP 为字符串格式\n                inet_ntop(AF_INET, \u0026clientaddr.sin_addr.s_addr, client_ip, 16);\n                // 打印客户端连接信息\n                printf(\"Listen server socket success, call Accept, client ip %s client port %d\\n\", \n                       client_ip, ntohs(clientaddr.sin_port));\n                // 向新客户端发送欢迎消息\n                return_response(clientfd, client_ip);\n                // 8. 将新客户端 socket 注册到 epoll 实例，监听读事件\n                ev.events = EPOLLIN;\n                ev.data.fd = clientfd;\n                if (epoll_ctl(epollfd, EPOLL_CTL_ADD, clientfd, \u0026ev) == -1) {\n                    perror(\"epoll_ctl add clientfd failed\");\n                    close(clientfd);\n                    continue;\n                }\n            } \n            // 9. 处理已连接客户端的读事件 (客户端发数据/断开连接)\n            else {\n                int connfd = client_array[i].data.fd; // 取出客户端 socket 描述符\n                // 接收客户端数据\n                ssize_t recvlen = recv(connfd, recv_buf, sizeof(recv_buf) - 1, 0);\n                // 情况1: 成功接收数据 (recvlen \u003e 0)\n                if (recvlen \u003e 0) {\n                    recv_buf[recvlen] = '\\0'; // 手动添加字符串结束符 (避免乱码)\n                    // 判断客户端是否发送 \"gettime\\n\" 命令 (获取当前时间)\n                    if (strcmp(recv_buf, \"gettime\\n\") == 0) {\n                        bzero(time_buf, sizeof(time_buf));\n                        t = time(NULL);\n                        ctime_r(\u0026t, time_buf); // 线程安全版本的时间转换\n                        send(connfd, time_buf, strlen(time_buf), 0);\n                    } \n                    // 其他命令: 提示重试\n                    else {\n                        send(connfd, \"Please Try Again...\\n\", 20, 0);\n                    }\n                    // 清空 recv_buf，避免下一次接收残留垃圾数据\n                    memset(recv_buf, 0, sizeof(recv_buf));\n                } \n                // 情况2: 客户端断开连接 (recvlen == 0) 或接收失败 (recvlen == -1)\n                else {\n                    if (recvlen == 0) {\n                        printf(\"User exiting, remove this connection from epoll.\\n\");\n                    } else {\n                        perror(\"recv call failed\");\n                    }\n                    // 从 epoll 实例中删除该客户端连接\n                    epoll_ctl(epollfd, EPOLL_CTL_DEL, connfd, NULL);\n                    // 关闭客户端 socket\n                    close(connfd);\n                }\n            }\n        }\n    }   \n    // 10. 服务器停止: 关闭所有资源\n    printf(\"server down...\\n\");\n    close(serverfd);\n    close(epollfd);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-cv42olh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-cv42olh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"EPOLL+ 线程池模型"}]},{"ID":"20260505170804-9t6jydm","Type":"NodeParagraph","Properties":{"id":"20260505170804-9t6jydm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"强大的 socket 监听能力，可以快速察觉所有套接字的处理能力，大量的用户请求可以快速处理"}]},{"ID":"20260505170804-w8ox53e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w8ox53e","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"负载均衡技术"}]},{"ID":"20260505170804-27c69ym","Type":"NodeParagraph","Properties":{"id":"20260505170804-27c69ym","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260125105018402"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260125105018402.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-v8035bk","Type":"NodeParagraph","Properties":{"id":"20260505170804-v8035bk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大量的用户请求可能导致任务分发不均，导致资源浪费，不能很好的处理和响应"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过预先设定的分发策略，最大的尝试均匀分发业务，让每台处理机都有任务负载"}]},{"ID":"20260505170804-zlhm0np","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-zlhm0np","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"代理服务器"}]},{"ID":"20260505170804-28rxji0","Type":"NodeParagraph","Properties":{"id":"20260505170804-28rxji0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代理服务器是一个数据中转为主要职责的中间件，代理服务器可以将用户的请求中转给处理服务机，也可以将结果反馈给用户，避免用户直接访问服务器主机，提高安全性(安全策略都可以部署在代理服务器中)，还可以进行任务的控制与分发"}]},{"ID":"20260505170804-5lvyij7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5lvyij7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"HA 高可用结构"}]},{"ID":"20260505170804-drogfpv","Type":"NodeParagraph","Properties":{"id":"20260505170804-drogfpv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"某个处理机宕机，可以通过 HA 概念将数据任务转发给正常的处理机"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260125111433919"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260125111433919.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-uh9uee8","Type":"NodeParagraph","Properties":{"id":"20260505170804-uh9uee8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"察觉处理机异常快速反应"}]},{"ID":"20260505170804-88hevcs","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-88hevcs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"线程池"}]},{"ID":"20260505170804-z9geklz","Type":"NodeParagraph","Properties":{"id":"20260505170804-z9geklz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"处理能力——————\u003e 线程池技术"}]},{"ID":"20260505170804-l8esqpx","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-l8esqpx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"线程池设计原则"}]},{"ID":"20260505170804-mq9lvau","Type":"NodeParagraph","Properties":{"id":"20260505170804-mq9lvau","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"提高线程重用性，线程不能与用户绑定，可以重复为多个用户处理业务，避免频繁创建销毁线程，减少不必要开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"预创建，提前准备好部分线程待用，用户发送请求后直接选择线程处理，提高响应速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程管理策略，设定线程池阈值，通过阈值管理调度线程，线程扩容与缩减"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为服务器提供并发处理能力，可以更快处理请求或业务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提高线程池的重用性，用户实现任务，线程池负责执行任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程池使用生产者消费者实现\t任务传递"}]},{"ID":"20260505170804-vz9ycsh","Type":"NodeParagraph","Properties":{"id":"20260505170804-vz9ycsh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"生产者，消费者，管理者"}]},{"ID":"20260505170804-8ep8peu","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ep8peu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为服务器提供了良好的线程并发处理能力，以及多线程管理能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"EPOLL 完成大量 socket 的网络事件监听，将事件转换为业务，投递到线程池中"}]},{"ID":"20260505170804-6t1uf1j","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-6t1uf1j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"线程池工作流程图"}]},{"ID":"20260505170804-lfbd0rn","Type":"NodeParagraph","Properties":{"id":"20260505170804-lfbd0rn","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260126110234864"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260126110234864.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-d9478cu","Type":"NodeParagraph","Properties":{"id":"20260505170804-d9478cu","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260125114618762"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260125114618762.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-66z3ue9","Type":"NodeParagraph","Properties":{"id":"20260505170804-66z3ue9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"管理者：使用线程池最小阈值 min 作为扩容缩减数量"}]},{"ID":"20260505170804-zmv8rjq","Type":"NodeParagraph","Properties":{"id":"20260505170804-zmv8rjq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当前任务量 \u003e=闲置消费者数量\t\t忙线程数量占存活线程数量的 70%"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当前线程数量 + 扩容量 \u003c 最大线程阈值"}]},{"ID":"20260505170804-vt08jt7","Type":"NodeParagraph","Properties":{"id":"20260505170804-vt08jt7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"闲置线程是忙线程的倍速，进行缩减"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当前线程数-缩减量 \u003e=最小阈值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260125160300822.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260125155850099"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260125155850099.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-qhkv212","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-qhkv212","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"EPOLL 的水平触发监听模式"}]},{"ID":"20260505170804-bm87k2o","Type":"NodeParagraph","Properties":{"id":"20260505170804-bm87k2o","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260126163447160"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260126163447160.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-bso6qu5","Type":"NodeParagraph","Properties":{"id":"20260505170804-bso6qu5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll_wait 立即返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"水平触发模式，一轮监听的事件未处理完毕，不允许进行下一轮监听，如果用户使用 epoll_wait ，函数不会阻塞，会立即返回，返回值为未处理完毕的事件数量"}]},{"ID":"20260505170804-hmvwetc","Type":"NodeParagraph","Properties":{"id":"20260505170804-hmvwetc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"水平触发模式是 epoll 的默认监听模式，开销较大但是可以保证数据处理及时性和完整性"}]},{"ID":"20260505170804-44udak4","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-44udak4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"EPOLL 边缘触发模式"}]},{"ID":"20260505170804-kn8tlni","Type":"NodeParagraph","Properties":{"id":"20260505170804-kn8tlni","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"监听到就绪后，只会发送一次处理通知，后续用户是否还会处理与 epoll 无关"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"边缘触发模式下，一次就绪事件未处理完毕，可以使用 epoll_wait 直接进行第二轮监听"}]},{"ID":"20260505170804-l48lx5l","Type":"NodeParagraph","Properties":{"id":"20260505170804-l48lx5l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"设置监听模式以 socket 为单位，比较灵活，不同的 socket 可以用不同的监听模式"}]},{"ID":"20260505170804-xb17a1l","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-xb17a1l","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"EPOLL 线程池代码"}]},{"ID":"20260505170804-et2l6lb","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-et2l6lb","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"server.h"}]},{"ID":"20260505170804-1bhtpbi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-1bhtpbi","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cstdio.h\u003e\n#include \u003cunistd.h\u003e\n#include \u003csignal.h\u003e\n#include \u003cstring.h\u003e\n#include \u003cstdlib.h\u003e\n#include \u003cpthread.h\u003e\n#include\u003cerrno.h\u003e\n#include\u003csys/socket.h\u003e\n#include\u003carpa/inet.h\u003e\n#include\u003csys/epoll.h\u003e\n\n#define TIMEOUT 1\n#define BACKLOG 128\n#define EPOLLMAX 100000\npthread_mutex_t lock;\nint\tepfd;\t//全局监听树描述符\npthread_t ptid;\t//存储输出线程的id信息\n// 任务结构体：存储业务函数指针和函数参数\ntypedef struct\n{\n\t    void *(*busines)(void *);  // 业务函数指针（对应生产者消费者模型的核心）\n\t\t    void *arg;                 // 业务函数的参数\n}bs_t;\n\n// 线程池结构体\ntypedef struct\n{\n\t    int thread_shutdown; // 线程池开关\t1开 0关\n\t    int thread_max;      // 最大线程数\n\t    int thread_min;      // 最小线程数\n\t    int thread_alive;    \n\t    int thread_busy;     // 繁忙线程数\n\t    int kill_number;    // 缩减码（预留字段）\n    \n    //任务队列\n\t    bs_t *queue;         // 任务队列\t环形队列\n\t\tint front;           // 队列头指针\n\t\tint rear;            // 队列尾指针\n\t\tint cur;             // 当前队列中的任务数\n\t\tint max;             // 队列最大容量\n\t\tpthread_cond_t Not_Full;   // 队列不满条件变量（生产者等待）\n\t\tpthread_cond_t Not_Empty;  // 队列不空条件变量（消费者等待）\n\t\tpthread_t * ctids;    // 存储消费者线程ID数组 \n\t\tpthread_t mtid;      // 存储管理者线程ID\n}pool_t; // 线程池类型\n\npool_t * PTR;\n\n// 函数声明（保持原有接口，语法无错误）\npool_t* thread_pool_create(int Max,int Min ,int Qmax); // 线程池创建初始化\nint Producer_add_task(pool_t *p , bs_t bs);        // 生产者添加任务模块，执行一次添加一次任务\nvoid *Customer_thread(void * arg);                 // 消费者线程，参数为线程池地址\nvoid *Manager_thread(void * arg);                  // 管理者线程，参数为线程池地址\nint thread_pool_destroy(pool_t *p);                // 销毁线程池资源\n\nvoid *user_business(void * arg); // 自定义实现业务（用户需自行编写具体逻辑）\nint if_thread_alive(pthread_t tid);\t//测试线程存活\n\nint Net_init(void);\t//网络初始化\nint Epoll_Create(int serverfd);\t//epoll初始化\nint Epoll_Listened(int serverfd);\t//监听\n\nvoid * Busines_Accept(void * arg);\t//连接业务\nvoid * Busines_Retime(void * arg);\t//时间业务\nvoid * print_thread(void * arg);\t//显示线程\nvoid * sig_usr(int);\t//捕捉函数\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-bahqmn6","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-bahqmn6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"thread_pool_create.c"}]},{"ID":"20260505170804-0n95h5o","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-0n95h5o","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\n// 线程池创建与初始化函数\n// 参数：max-最大线程数，min-最小线程数，Qmax-任务队列最大容量\n// 返回值：成功返回线程池指针，失败退出程序\npool_t *thread_pool_create(int max, int min, int Qmax)\n{\n    /* ========== 1. 申请线程池结构体内存 ========== */\n    pool_t *ptr = NULL;\n    if ((ptr = (pool_t *)malloc(sizeof(pool_t))) == NULL)\n    {\n        perror(\"thread_pool_create error, malloc pool Failed\");\n        exit(0);\n    }\n    /* ========== 2. 初始化线程池核心参数 ========== */\n    ptr-\u003ethread_shutdown = 1;      // 线程池初始状态\n    ptr-\u003ethread_max = max;         // 设置最大线程数\n    ptr-\u003ethread_min = min;         // 设置最小线程数\n    ptr-\u003ethread_alive = 0;         // 当前存活线程数初始为0\n    ptr-\u003ethread_busy = 0;          // 当前繁忙线程数初始为0\n    ptr-\u003ekill_number = 0;          // 待销毁的线程数初始为0（预留的缩容字段）\n    /* ========== 3. 初始化任务队列 ========== */\n    // 为任务队列分配内存，容量为 Qmax\n    if ((ptr-\u003equeue = (bs_t *)malloc(sizeof(bs_t) * Qmax)) == NULL)\n    {\n        perror(\"thread_pool_create error, malloc queue Failed\");\n         free(ptr);  // 释放前面已经分配的线程池结构体内存\n    \t ptr = NULL;\n        exit(0);\n    }\n    /* ========== 4. 初始化消费者线程ID数组 ========== */\n    // 为线程ID数组分配内存，容量为最大线程数 max\n    if ((ptr-\u003ectids = (pthread_t *)malloc(sizeof(pthread_t) * max)) == NULL)\n    {\n        perror(\"thread_pool_create, malloc ctids Failed\");\n        exit(0);\n    }\n    // 初始化线程ID数组，清空脏数据\n    bzero(ptr-\u003ectids, sizeof(pthread_t) * max);\n    /* ========== 5. 初始化队列指针与状态 ========== */\n    ptr-\u003efront = 0;    // 队列头指针初始化为0\n    ptr-\u003erear = 0;     // 队列尾指针初始化为0\n    ptr-\u003ecur = 0;      // 当前队列任务数初始化为0\n    ptr-\u003emax = Qmax;   // 队列最大容量设置为 Qmax\n    /* ========== 6. 初始化条件变量 ========== */\n    if (pthread_cond_init(\u0026ptr-\u003eNot_Full, NULL) != 0 || \n        pthread_cond_init(\u0026ptr-\u003eNot_Empty, NULL) != 0||\n        pthread_mutex_init(\u0026lock,NULL)!=0)\n    {\n        printf(\"thread_pool_create err, init Lock or Cond Failed!\\n\");\n        exit(0);\n    }\n    /* ========== 7. 创建最小数量的消费者线程 ========== */\n    int err;\n    for (int i = 0; i \u003c min; i++)\n    {\n        // 创建消费者线程，绑定线程函数 Customer_thread\n        if ((err = pthread_create(\u0026ptr-\u003ectids[i], NULL, Customer_thread, (void *)ptr)) \u003e 0)\n        {\n            printf(\"thread_pool_create error, create customer thread failed:%s\\n\", strerror(err));\n            exit(0);\n        }\n        ptr-\u003ethread_alive++;  // 存活线程数加1\n    }\n    /* ========== 8. 创建管理者线程 ========== */\n    if ((err = pthread_create(\u0026ptr-\u003emtid, NULL, Manager_thread, (void *)ptr)) \u003e 0)\n    {\n        printf(\"thread_pool_create error, create Manager thread failed:%s\\n\", strerror(err));\n        exit(0);\n    }\n    pthread_create(\u0026ptid,NULL,print_thread,(void*)ptr);\n    // 返回初始化完成的线程池指针\n    return ptr;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3hnqgx2","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-3hnqgx2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Producer_add_task.c"}]},{"ID":"20260505170804-vvap34z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-vvap34z","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\n// 生产者添加任务函数\n// 参数：p - 线程池指针；bs - 要添加的任务（包含业务函数和参数）\n// 返回值：成功返回0，失败返回-1（或其他错误码）\nint Producer_add_task(pool_t *p, bs_t bs)\n{\n    // 1. 先检查线程池是否处于运行状态（thread_shutdown为0表示关闭，为1表示运行，这里逻辑与之前修正的保持一致）\n    if (p-\u003ethread_shutdown)\n    {\n        // 2. 加锁，保护任务队列的共享访问\n        pthread_mutex_lock(\u0026lock);\n        // 3. 循环等待：如果任务队列已满，就阻塞在Not_full条件变量上\n        // 使用while而不是if，是为了防止虚假唤醒（被唤醒后再次检查队列是否真的不满）\n        while (p-\u003ecur == p-\u003emax)\n        {\n            // 等待队列不满的信号，等待期间会自动释放lock，被唤醒时重新获取lock\n            pthread_cond_wait(\u0026p-\u003eNot_Full, \u0026lock);\n            // 4. 被唤醒后，再次检查线程池是否已关闭\n            if (!p-\u003ethread_shutdown)\n            {\n                // 线程池已关闭，解锁并退出\n                pthread_mutex_unlock(\u0026lock);\n                printf(\"thread_pool is shutdown, Producer thread exit.\\n\");\n                pthread_exit(NULL);\n            }\n        }\n        // 5. 队列有空闲，添加任务到队列\n        p-\u003equeue[p-\u003efront].busines = bs.busines;  // 复制业务函数指针\n        p-\u003equeue[p-\u003efront].arg = bs.arg;          // 复制业务函数参数\n        // 6. 更新队列状态\n        p-\u003ecur++;                                // 当前任务数+1\n        p-\u003efront = (p-\u003efront + 1) % p-\u003emax;        // 队头指针循环后移\n        // 7. 解锁\n        pthread_mutex_unlock(\u0026lock);\n        pthread_kill(ptid,SIGUSR1);\n        // 8. 唤醒一个等待任务的消费者线程\n        pthread_cond_signal(\u0026p-\u003eNot_Empty);\n        // 打印日志：当前生产者线程ID、添加的业务函数地址\n        printf(\"Producer thread [0x%x] add Business success, business_addr = %p\\n\", \n               (unsigned int)pthread_self(), bs.busines);\n    }\n    else\n    {\n        // 线程池已关闭，无法添加任务\n        printf(\"thread_pool is shutdown, Producer thread exit.\\n\");\n        pthread_exit(NULL);\n    }\n    // 9. 任务添加成功\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-alxv7ka","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-alxv7ka","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Customer_thread.c"}]},{"ID":"20260505170804-34bg7kt","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-34bg7kt","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e  // 引入服务器相关的头文件，包含线程池、业务结构体等定义\n// 消费者线程函数：从线程池的任务队列中取出任务并执行\n// 参数 arg：指向线程池结构体(pool_t)的指针\nvoid *Customer_thread(void * arg)\n{\n    // 将传入的void类型参数转换为线程池结构体指针，方便操作线程池的属性\n    pool_t * ptr = (pool_t *)arg;\n    // 定义业务结构体变量bs，用于暂存从任务队列取出的业务函数和参数\n    bs_t bs;\n    // 设置当前线程为分离状态：线程结束后自动释放资源，无需主线程调用pthread_join回收\n    pthread_detach(pthread_self());\n    // 循环获取任务：thread_shutdown为线程池的运行标志，为真则持续工作\n    while(ptr-\u003ethread_shutdown)\n    {\n        // 加互斥锁：保护任务队列、cur（当前任务数）等共享资源，防止多线程竞争\n        pthread_mutex_lock(\u0026lock);\n        // 当任务队列为空时（cur=0），进入等待状态\n        while(ptr-\u003ecur == 0)\n        {\n            // 等待条件变量Not_Empty：释放锁并阻塞，直到生产者添加任务后唤醒\n            pthread_cond_wait(\u0026ptr-\u003eNot_Empty,\u0026lock);\n            // 被唤醒后先检查线程池是否要关闭（thread_shutdown为假）\n            if(!ptr-\u003ethread_shutdown)\n            {\n                pthread_mutex_unlock(\u0026lock);  // 释放锁，避免死锁\n                // 打印线程退出日志，0x%x格式化输出线程ID（无符号十六进制）\n                printf(\"Customer thread [0x%x] shutdown its 0, exiting.\\n\",(unsigned int)pthread_self());\n                pthread_exit(NULL);  // 退出当前消费者线程\n            }\n        }\n        \tif(ptr-\u003ekill_number)\n\t\t   {\n      \t\t\tif((ptr-\u003ekill_number-1)==0)\n                     \tpthread_kill(ptid,SIGUSR1);\n    \t\t\t--ptr-\u003ethread_alive;\n   \t\t\t\t--ptr-\u003ekill_number;\n    \t\t\t printf(\"Customer thread [0x%x] exit , kill numer %d.\\n\",(unsigned int)pthread_self(),ptr-\t\t\t\t\t\t\u003ekill_number);\n    \t\t\t pthread_mutex_unlock(\u0026lock);\n   \t\t\t      pthread_exit(NULL);\n\t\t   }\n        // -------------------------- 核心逻辑：取出任务 --------------------------\n        // 从任务队列的队尾(rear)取出业务函数指针\n        bs.busines = ptr-\u003equeue[ptr-\u003erear].busines;\n        // 从任务队列的队尾取出业务函数对应的参数\n        bs.arg = ptr-\u003equeue[ptr-\u003erear].arg;\n        --(ptr-\u003ecur);  // 任务队列的当前任务数减1\n        // 队尾指针后移：通过取模实现环形队列，避免数组越界\n        ptr-\u003erear = (ptr-\u003erear + 1) % ptr-\u003emax;\n        ++ptr-\u003ethread_busy;\n        pthread_mutex_unlock(\u0026lock);  // 释放锁，其他线程可操作任务队列\n        // 唤醒生产者线程：任务队列有空闲位置了（Not_Full条件满足）\n        pthread_cond_signal(\u0026ptr-\u003eNot_Full);\n        pthread_kill(ptid,SIGUSR1);\n        // 打印日志：当前线程获取到任务，输出线程ID和业务函数地址\n        printf(\"Customer thread[0x%x] Get business_addr %p , Running.\\n\",(unsigned int)pthread_self(),bs.busines);\n        bs.busines(bs.arg);  // 执行具体的业务逻辑（核心：调用任务函数）\n        pthread_mutex_lock(\u0026lock);\n        --ptr-\u003ethread_busy;\n        pthread_kill(ptid,SIGUSR1);\n        pthread_mutex_unlock(\u0026lock);  \n    }\n    // 线程池关闭（thread_shutdown为假），打印退出日志\n    printf(\"Customer thread [0x%x] shutdown its 0, exiting.\\n\",(unsigned int)pthread_self());\n    pthread_exit(NULL);  // 退出线程\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-xs5bkc8","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-xs5bkc8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Mananger_thread.c"}]},{"ID":"20260505170804-hldrefx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-hldrefx","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cserver.h\u003e // 引入自定义的服务器/线程池相关头文件\n// 管理者线程函数：负责动态调整线程池中的工作线程数量（扩容/缩容）\n// arg：传入线程池的结构体指针（pool_t* 类型）\nvoid *Manager_thread(void *arg)\n{\n    // 将传入的void*参数强转为线程池结构体指针\n    pool_t *ptr = (pool_t *)arg;\n    // 将管理者线程设置为分离态，避免主线程需要回收其资源\n    pthread_detach(pthread_self());\n    // 定义局部变量：\n    // alive：当前线程池存活的总线程数\n    // cur：待处理的任务数（从线程池结构体中读取）\n    // busy：当前正在处理任务的忙碌线程数\n    int alive, cur, busy;\n    // 加互斥锁：保护线程池结构体的共享数据（避免多线程读写冲突）\n    pthread_mutex_lock(\u0026lock);\n    // 从线程池结构体中读取当前存活线程数、忙碌线程数、待处理任务数\n    alive = ptr-\u003ethread_alive;\n    busy = ptr-\u003ethread_busy;\n    cur = ptr-\u003ecur;\n    // 解锁：完成共享数据读取\n    pthread_mutex_unlock(\u0026lock);\n    // 定义局部变量：\n    // flag：循环计数器，用于遍历线程ID数组\n    // add：记录本次需要新增的线程数\n    int flag, add;\n    // 持续循环：管理者线程的核心逻辑（直到线程池收到关闭信号）\n    while(ptr-\u003ethread_shutdown)\n    {\n        // 扩容条件判断：满足以下任一条件则创建新的工作线程\n        // 条件1：待处理任务数 \u003e= 空闲线程数（alive - busy）\n        // 条件2：忙碌线程占比 \u003e=70% 且 当前存活线程数未达上限\n        // 同时要求：存活线程数 \u003e= 最小线程数 且 \u003c= 最大线程数\n        if((cur \u003e= alive - busy || (double)busy / alive * 100 \u003e= 70) \u0026\u0026 alive + ptr-\u003ethread_min \u003c= ptr-\u003ethread_max)\n        {\n            // 初始化计数器：新增线程数add=0，循环标识flag=0\n            for(flag=0, add=0; flag \u003c ptr-\u003ethread_max \u0026\u0026 add \u003c ptr-\u003ethread_min; flag++)\n            {\n                // 检查当前下标对应的线程ID是否有效：\n                // 条件1：线程ID为0（未创建） 或 条件2：线程已死亡（非存活状态）\n                if(ptr-\u003ectids[flag]==0 || !if_thread_alive(ptr-\u003ectids[flag]))\n                {\n                    // 创建新的工作线程（消费者线程）：\n                    // \u0026ptr-\u003ectids[flag]：保存新线程的ID到线程池的ID数组\n                    // NULL：使用默认线程属性\n                    // Customer_thread：工作线程的执行函数（处理具体任务）\n                    // (void *)ptr：给工作线程传入线程池结构体指针\n                    pthread_create(\u0026ptr-\u003ectids[flag], NULL, Customer_thread, (void *)ptr);\n                    add++;          // 新增线程数+1\n                    pthread_mutex_lock(\u0026lock);  // 加锁保护共享变量\n                    ptr-\u003ethread_alive++;        // 线程池存活线程数+1\n                    pthread_mutex_unlock(\u0026lock);// 解锁\n                }\n            }\n        }\n        pthread_kill(ptid,SIGUSR1);\n        // 缩容条件判断：\n        // 忙碌线程数 * 2 \u003c= 空闲线程数（alive - busy）\n        // 且 存活线程数 -最小线程数 \u003e= 最小线程数（保证不缩到低于最小线程数）\n        // （注：原代码条件可简化为 alive \u003e= ptr-\u003ethread_min，逻辑是保证存活数不低于最小值）\n        if(busy * 2 \u003c= alive - busy \u0026\u0026 alive -ptr-\u003ethread_min \u003e= ptr-\u003ethread_min)\n        {\n            pthread_mutex_lock(\u0026lock);\n\t\t   ptr-\u003ekill_number=ptr-\u003ethread_min;\n\t\t   pthread_mutex_unlock(\u0026lock);\n\t\t   for(int i=0;i\u003cptr-\u003ethread_min;i++){\n           \t\t pthread_cond_signal(\u0026ptr-\u003eNot_Empty);\n\t\t   }\n        }\n        // 管理者线程休眠指定时间（TIME_OUT），避免频繁轮询占用CPU\n        sleep(TIMEOUT);\n    }\n    // 线程池收到关闭信号，退出循环，打印退出日志\n    printf(\"thread shutdown its 0 , manager 0x%x exiting..\\n\", (unsigned int)pthread_self());\n    // 管理者线程退出，返回NULL\n    pthread_exit(NULL);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-a92t6fa","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-a92t6fa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"if_thread_alive.c"}]},{"ID":"20260505170804-tpu23wg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-tpu23wg","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cserver.h\u003e\nint if_thread_alive(pthread_t tid){\n    pthread_kill(tid,0);\n    if(errno==ESRCH)\n        return 0;\n    return 1;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-h4oe1vj","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-h4oe1vj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"thread_pool_destroy.c"}]},{"ID":"20260505170804-w2cicvb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-w2cicvb","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\nint thread_pool_destroy(pool_t * ptr)\n{\n    pthread_mutex_destroy(\u0026lock);\n    pthread_cond_destroy(\u0026ptr-\u003eNot_Full);\n    pthread_cond_destroy(\u0026ptr-\u003eNot_Empty);\n    free(ptr-\u003ectids);\n    free(ptr-\u003equeue);\n    free(ptr);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-9umm9bt","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-9umm9bt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"———————————————-"}]},{"ID":"20260505170804-6ms4j1h","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-6ms4j1h","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Net_init.c"}]},{"ID":"20260505170804-de20z3j","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-de20z3j","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cserver.h\u003e\nint Net_init(void)\n{\n    int sockfd;\n    struct sockaddr_in Addr;\n    bzero(\u0026Addr,sizeof(Addr));\n    Addr.sin_family = AF_INET;\n    Addr.sin_port = htons(8080);\n    Addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    if((sockfd = socket(AF_INET,SOCK_STREAM,0))==-1){\n        perror(\"Net init Error, socket call failed\");\n        exit(0);\n    }\n    if((bind(sockfd,(struct sockaddr *)\u0026Addr,sizeof(Addr)))==-1){\n        perror(\"Net_init Error, bind call failed\");\n        exit(0);\n    }\n    listen(sockfd,BACKLOG);\n    return sockfd;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-w5goaq7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-w5goaq7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Epoll_Create.c"}]},{"ID":"20260505170804-eg4nbf6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-eg4nbf6","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cserver.h\u003e\nint Epoll_Create(int sockfd)\n{\n    int epfd;\n    struct epoll_event node;\t//监听节点\n    if((epfd = epoll_create(EPOLLMAX))==-1){\t//创建epoll树\n        perror(\"Epoll_Create error, epoll_create Failed\");\n        exit(0);\n    }\n\n    //在此模型中，所有的socket都采用边缘模式监听，无论是serverfd还是clientfd\n    node.data.fd = sockfd;\n    node.events = EPOLLIN|EPOLLET; //监听读事件\n    if((epoll_ctl(epfd,EPOLL_CTL_ADD,sockfd,\u0026node))==-1){\n        perror(\"Epoll_Create error, Epoll_Ctl First Set sockfd Failed\");\n        exit(0);\n    }\n\n    return epfd;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-di1i4ck","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-di1i4ck","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Epoll_Listen.c"}]},{"ID":"20260505170804-3811cxw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-3811cxw","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\n/**\n * @brief Epoll事件监听核心函数\n * @param sockfd 服务器监听套接字（之前Net_init创建的fd）\n * @param ptr 线程池指针（用于提交任务到线程池处理）\n * @return 正常退出返回0，异常直接exit退出\n * @note 该函数是epoll反应堆模型的核心，循环监听事件并分发任务到线程池\n */\nint Epoll_Listened(int sockfd, pool_t *ptr)\n{\n    // 定义epoll就绪事件数组，存储epoll_wait返回的就绪fd事件\n    struct epoll_event ready_array[EPOLLMAX];\n    int ready;          // 接收epoll_wait返回的就绪事件数量\n    int flag;           // 遍历就绪事件数组的索引\n    bs_t tmp;           // 任务结构体（存储要执行的业务函数+参数）\n    // 打印运行日志，提示epoll监听线程已启动\n    printf(\"Epoll thread server , Epoll_listen Running..\\n\");\n    // 循环监听：ptr-\u003ethread_shutdown为线程池退出标志（非0时持续运行）\n    while (ptr-\u003ethread_shutdown)\n    {\n        /**\n         * epoll_wait：阻塞等待epfd上的事件（-1表示永久阻塞）\n         * @param epfd      epoll实例句柄（之前Epoll_Create返回的值，原代码漏写需确认）\n         * @param ready_array 存储就绪事件的数组\n         * @param EPOLLMAX  数组最大容量\n         * @param -1        超时时间（-1=永久阻塞，0=非阻塞，\u003e0=超时毫秒数）\n         */\n        if ((ready = epoll_wait(epfd, ready_array, EPOLLMAX, -1)) == -1)\n        {\n            // epoll_wait调用失败，打印错误并退出程序\n            perror(\"Epoll Listen error, epoll wait call failed\");\n            exit(0);\n        }\n        flag = 0; // 重置遍历索引\n        // 遍历所有就绪的事件（ready为就绪事件数量）\n        while (ready)\n        {\n            // 判断当前就绪fd是否是服务器监听套接字（有新客户端连接）\n            if (ready_array[flag].data.fd == sockfd)\n            {\n                // 配置任务：处理新连接的业务函数\n                tmp.busines = Busines_Accept;  \n                tmp.arg = (void *)\u0026sockfd;     // 传递监听套接字作为参数\n                Producer_add_task(ptr, tmp);   // 将任务添加到线程池任务队列\n            }\n            else\n            {\n                // 配置任务：处理已连接客户端的读写事件（如数据收发）\n                tmp.busines = Busines_Retime;  \n                // 传递就绪的客户端fd作为参数\n                tmp.arg = (void *)\u0026(ready_array[flag].data.fd);\n                Producer_add_task(ptr, tmp);   // 将任务添加到线程池任务队列\n            }\n            flag++;   // 索引自增，处理下一个就绪事件\n            ready--;  // 就绪事件数递减，直到处理完所有\n        }\n    }\n    // 循环退出（线程池关闭），关闭服务器监听套接字\n    close(sockfd);\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-ml0n50k","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ml0n50k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Busines_Accept.c"}]},{"ID":"20260505170804-etbi4fa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-etbi4fa","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"/*接收客户端的新连接，给这个新连接分配专属的套接字 fd，把这个 fd 加入 epoll 监听（后续能感知客户端的读写事件），最后给客户端发一条包含其 IP 的欢迎消息。*/\n\n#include \"server.h\"\n/**\n * @brief 处理新客户端连接的业务函数（线程池执行）\n * @param arg 传入的参数，实际是服务器监听套接字sockfd的地址\n * @return 返回NULL（符合线程池任务函数的返回值要求）\n * @note 核心逻辑：接收新连接→获取客户端IP→将新fd加入epoll监听→给客户端发送欢迎消息\n */\nvoid *Busines_Accept(void *arg)\n{\n    int sockfd;                  // 服务器监听套接字\n    struct sockaddr_in newaddr;  // 存储新连接客户端的地址信息（IP+端口）\n    struct epoll_event node;     // epoll事件结构体（用于注册新fd的监听事件）\n    char response[1500];         // 存储要发送给客户端的欢迎消息\n    char ip[16];                 // 存储客户端的IP地址（IPv4字符串最长15位+结束符）\n    // 初始化缓冲区：将response数组所有字节置0，避免脏数据\n    bzero(response, sizeof(response));\n    // 初始化IP缓冲区：将ip数组所有字节置0\n    bzero(ip, sizeof(ip));\n    socklen_t addrlen;           // 客户端地址结构体的长度（accept函数需要）\n    // 从传入的void*参数中解析出监听套接字sockfd（强制类型转换+取值）\n    sockfd = *(int *)arg;\n    int newsocket;               // 新连接的客户端套接字fd（每个客户端唯一）\n    addrlen = sizeof(newaddr);   // 初始化地址长度\n    /**\n     * accept函数：从监听套接字的连接队列中取出一个新连接\n     * @param sockfd      服务器监听套接字\n     * @param \u0026newaddr    输出参数，存储客户端的地址信息\n     * @param \u0026addrlen    输入输出参数，传入地址长度，返回实际长度\n     * @return 成功返回新的客户端fd（newsocket），失败返回-1\n     */\n    if ((newsocket = accept(sockfd, (struct sockaddr *)\u0026newaddr, \u0026addrlen)) == -1) {\n        // accept调用失败，打印错误信息并退出\n        perror(\"Bsuines_accept error, accept call failed\");\n        exit(0);\n    }\n    inet_ntop(AF_INET, \u0026newaddr.sin_addr.s_addr, ip, 16);\n    // 配置epoll事件：将新客户端fd存入epoll事件结构体\n    node.data.fd = newsocket;\n    // 监听新客户端fd的读事件（EPOLLIN：客户端发数据/断开时触发）\n    node.events = EPOLLIN|EPOLLET;\n    \n    /**\n     * epoll_ctl函数：将新客户端fd添加到epoll监听集合中\n     * @param epfd        epoll实例句柄（全局变量，需在server.h中定义）\n     * @param EPOLL_CTL_ADD 操作类型：添加fd到epoll监听\n     * @param newsocket   要监听的新客户端fd\n     * @param \u0026node       要监听的事件配置\n     */\n    if ((epoll_ctl(epfd, EPOLL_CTL_ADD, newsocket, \u0026node)) == -1) {\n        // epoll_ctl调用失败，打印错误信息并退出\n        perror(\"Bsuines_accept error, epoll_ctl call failed\");\n        exit(0);\n    }\n\n    // 拼接欢迎消息：包含客户端IP，格式如 \"hi 192.168.1.100 wellcome epoll thread demo..\"\n    sprintf(response, \"hi %s wellcome epoll thread demo..\\n\", ip);\n    /**\n     * send函数：给客户端发送欢迎消息\n     * @param newsocket   客户端fd\n     * @param response    要发送的消息缓冲区\n     * @param strlen(response) 消息长度（不含结束符）\n     * @param MSG_NOSIGNAL 发送失败时不产生SIGPIPE信号（避免程序崩溃）\n     */\n    send(newsocket, response, strlen(response), MSG_NOSIGNAL);\n    \n    // 返回NULL，符合线程池任务函数（void* (*)(void*)）的返回值要求\n    return NULL;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-hb9ykkg","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-hb9ykkg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Busines_Retime.c"}]},{"ID":"20260505170804-1sjzzwz","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-1sjzzwz","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \"server.h\"\n/**\n * @brief 处理已连接客户端数据交互的业务函数（线程池执行）\n * @param arg 传入的参数，实际是客户端套接字fd的地址\n * @return 返回NULL（符合线程池任务函数的返回值要求）\n * @note 核心逻辑：非阻塞接收客户端数据→判断数据类型→响应（时间/提示）或处理客户端断开\n */\nvoid * Busines_Retime(void * arg)\n{\n    time_t tp;                // 存储时间戳（秒级）\n    int sockfd;               // 客户端套接字fd\n    char buffer[1500];        // 接收客户端数据的缓冲区\n    char time_buf[1500];      // 存储格式化后的时间字符串\n    int recvlen;              // recv函数的返回值（接收的字节数/错误码）\n    \n    // 初始化接收缓冲区：置0避免脏数据干扰\n    bzero(buffer,sizeof(buffer));\n    // 初始化时间缓冲区：置0\n    bzero(time_buf,sizeof(time_buf));\n    // 从void*参数中解析出客户端fd（强制类型转换+取值）\t用地址会有问题\n    sockfd = *(int *)arg;\n\n    /**\n     * 非阻塞接收客户端数据：\n     * MSG_DONTWAIT：非阻塞模式，没有数据时立即返回，不会阻塞线程\n     * 循环处理：仅当recv返回-1且错误码是EINTR（被信号中断）时，重试接收\n     */\n    while((recvlen = recv(sockfd,buffer,sizeof(buffer),MSG_DONTWAIT))==-1){\n        // 若错误码是EINTR（recv被信号中断），跳出循环重新尝试\n        if(errno == EINTR){\n            break;\n        }else{\n            // 其他错误（如连接异常），打印错误并退出程序\n            perror(\"Busines_Retime error , recv call failed\");\n            exit(0);\n        }\n    }\n\n    // 分支1：recvlen=0 → 客户端正常关闭连接（主动断开）\n    if(recvlen == 0){\n        close(sockfd);                                      // 关闭客户端fd，释放资源\n        epoll_ctl(epfd,EPOLL_CTL_DEL,sockfd,NULL);          // 从epoll监听集合中删除该fd，避免无效监听\n    }\n    // 分支2：recvlen\u003e0 → 成功接收到客户端发送的数据\n    else if(recvlen \u003e 0){\n        // 判断客户端是否发送了\"time\\n\"指令（查询系统时间）\n        if(strcmp(buffer,\"time\\n\")==0){\n            tp = time(NULL);                                // 获取当前系统时间戳（从1970-01-01到现在的秒数）\n            ctime_r(\u0026tp,time_buf);                          // 线程安全的时间格式化：将时间戳转为字符串（如 \"Mon Jan 26 12:00:00 2026\\n\"）\n            // 给客户端发送格式化后的时间字符串\n            send(sockfd,time_buf,strlen(time_buf),MSG_NOSIGNAL);\n        }\n        // 客户端发送的不是\"time\\n\"指令\n        else{\n            // 给客户端发送错误提示，19是字符串\"Please try Again...\\n\"的字节数\n            send(sockfd,\"Please try Again...\\n\",19,MSG_NOSIGNAL);\n        }\n    }\n    // 返回NULL，符合线程池任务函数（void* (*)(void*)）的返回值要求\n    return NULL;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-czc8yhy","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260505170804-czc8yhy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"——————————————————————————————————————"}]},{"ID":"20260505170804-cpd4mbe","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-cpd4mbe","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"makefile"}]},{"ID":"20260505170804-7af6m6s","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWFrZWZpbGU=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-7af6m6s","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWFrZWZpbGU="},{"Type":"NodeCodeBlockCode","Data":"# 头文件路径\nINCLUDE_PATH=./include/\n# 库文件路径\nLIBRARY_PATH=./library/\n# 安装路径\nINSTALL_PATH=./\n# 编译器\nCC=gcc\n# 编译选项：-I指定头文件路径，-g调试信息，-Wall显示所有警告，-c只编译不链接\nCFLAGS=-I$(INCLUDE_PATH) -g -Wall -c\n# 预处理选项（暂未使用）\nPPFLAGS=\n# 链接选项：-lpthread链接线程库（线程池依赖）\nLDFLAGS=-lpthread\n# 目标可执行文件名称\nTARGET=Thread_Epoll_ServerStart\n# 匹配当前目录下所有.c源文件\nSRCFILE=$(wildcard *.c)\n# 将所有.c文件替换为.o目标文件\nDESTFILE=$(patsubst %.c,%.o,$(SRCFILE))\n# 删除命令\nRM=rm -rf\n# 构建目标：生成可执行文件\n$(TARGET):$(DESTFILE)\n\t$(CC) $^ $(LDFLAGS) -o $@\n\n# 编译规则：将.c文件编译为.o文件\n%.o:%.c\n\t$(CC) $(CFLAGS) $\u003c -o $@\n# 清理规则：删除所有.o文件和可执行文件\nclean:\n\t$(RM) $(DESTFILE) $(TARGET)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-fyovpsc","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-fyovpsc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"main.c"}]},{"ID":"20260505170804-frgcuk7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-frgcuk7","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\n\nint main(void)\n{\n    // -------------------------- 信号屏蔽配置 start --------------------------\n    // 主线程设置对SIGUSR1信号的屏蔽，并继承给所有子线程（避免线程池线程被该信号中断）\n    sigset_t set, oset;       // 信号集：set（要屏蔽的信号）、oset（保存原信号掩码）\n    sigemptyset(\u0026set);        // 初始化信号集，清空所有信号\n    sigaddset(\u0026set, SIGUSR1); // 将SIGUSR1信号加入屏蔽集\n    // 设置进程信号掩码：SIG_SETMASK表示用set替换原掩码，oset保存旧掩码\n    sigprocmask(SIG_SETMASK, \u0026set, \u0026oset);\n\n    // -------------------------- 核心资源初始化 start --------------------------\n    int sockfd;               // 服务器监听套接字fd\n    pool_t *ptr = NULL;       // 线程池指针（pool_t是自定义线程池结构体）\n    sockfd = Net_init();              // 1. 网络初始化：创建+绑定+监听套接字，返回监听fd\n    epfd = Epoll_Create(sockfd);      // 2. 创建epoll实例，将监听fd加入epoll监听\n    // 3. 创建线程池：参数（任务队列最大容量300，工作线程数10，队列满时阻塞超时1000ms）\n    ptr = thread_pool_create(300, 10, 1000);\n    Epoll_Listened(sockfd, ptr);      // 4. 进入epoll事件监听循环（阻塞处理客户端事件）\n    // -------------------------- 资源清理 start --------------------------\n    // 若线程池退出标志为假（线程池需销毁），执行销毁操作\n    if (!ptr-\u003ethread_shutdown) {\n        thread_pool_destroy(ptr);     // 销毁线程池，释放线程/队列资源\n    }\n    printf(\"epoll thread server closing..\\n\"); // 服务器退出提示\n    return 0;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-3ztz4ob","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-3ztz4ob","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"touch print_thread.c"}]},{"ID":"20260505170804-st5g7mq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-st5g7mq","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include \u003cserver.h\u003e\nvoid * print_thread(void * arg)\n{\n    // 1. 将当前线程设置为分离状态\n    // 分离后线程结束时会自动释放资源，无需主线程调用pthread_join\n    pthread_detach(pthread_self());\n    // 2. 将传入的参数转换为线程池结构体指针\n    pool_t * ptr = (pool_t *)arg;\n    // 3. 定义信号处理结构体（用于捕获SIGUSR1信号）\n    struct sigaction act, oact;\n    // 4. 配置信号处理函数：指定SIGUSR1的处理函数为sig_usr\n    act.sa_handler = sig_usr;\n    // 5. 信号标志位：0表示默认行为\n    act.sa_flags = 0;\n    // 6. 清空信号屏蔽集（处理信号时不屏蔽其他信号）\n    sigemptyset(\u0026act.sa_mask);\n    // 7. 设置SIGUSR1信号的捕获规则\n    // 将act配置应用到SIGUSR1，原配置保存到oact\n    sigaction(SIGUSR1, \u0026act, \u0026oact); ////设置捕捉\n    // 8. 解除信号屏蔽：将当前线程的信号屏蔽集设置为act.sa_mask（这里是空集）\n    // 确保SIGUSR1信号不会被屏蔽，能正常被捕获\n    sigprocmask(SIG_SETMASK, \u0026act.sa_mask, NULL); ////解除屏蔽\n    PTR=ptr;\n    // 9. 循环等待退出信号：只要thread_shutdown非0，就持续休眠\n    // 线程会在休眠或运行中等待SIGUSR1信号触发（触发后可能修改thread_shutdown）\n    while (ptr-\u003ethread_shutdown) {\n        sleep(TIMEOUT); ////等待信号\n    }\n    // 10. 线程退出\n    pthread_exit(NULL);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-out3gya","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-out3gya","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"sig_usr.c"}]},{"ID":"20260505170804-czi0v5b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-czi0v5b","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"#include\u003cserver.h\u003e\nvoid sig_usr(int n)\n{\n    // 显示一次阈值信息（打印线程池当前状态）\n    printf(\"[Thread_Epoll_Server Info] [Alive]%d [Busy]%d [Idel]%d [Cur]%d [B/A]%.2f%% [A/M]%.2f%%\\n\",\n           PTR-\u003ethread_alive,        // 当前存活的线程数\n           PTR-\u003ethread_busy,         // 当前忙碌的线程数\n           PTR-\u003ethread_alive - PTR-\u003ethread_busy, // 当前空闲的线程数（存活 - 忙碌）\n           PTR-\u003ecur,                // 可能是当前任务数/连接数（需看pool_t定义）\n           (double)PTR-\u003ethread_busy / PTR-\u003ethread_alive * 100, // 忙碌线程占比（B/A）\n           (double)PTR-\u003ethread_alive / PTR-\u003ethread_max * 100   // 存活线程占最大线程数的比例（A/M）\n          );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-xinnxfa","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-xinnxfa","updated":"20260508230803"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"操作系统"}]},{"ID":"20260505170804-7lhyekh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7lhyekh","updated":"20260508230803"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"用户态和内核态的区别"}]},{"ID":"20260505170804-z250640","Type":"NodeParagraph","Properties":{"id":"20260505170804-z250640","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户态权限较低，只能访问自身进程的虚拟地址空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无法直接操作硬件，进程间相互隔离，单个进程崩溃不会影响系统"}]},{"ID":"20260505170804-8n78jr9","Type":"NodeParagraph","Properties":{"id":"20260505170804-8n78jr9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核态权限最高，可访问全部内存与硬件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"管理系统资源，且内核空间由所有进程共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦内核出错，整个系统都可能崩溃"}]},{"ID":"20260505170804-73xm8da","Type":"NodeParagraph","Properties":{"id":"20260505170804-73xm8da","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户态到内核态的切换通过系统调用、中断、异常触发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"切换时需要保存上下文、切换页表，存在一定开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际开发中会尽量减少频繁切换，避免不必要的性能损耗"}]},{"ID":"20260508230759-2jm8o49","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508230759-2jm8o49","updated":"20260508152128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么要有用户态，用用户态的原因"}]},{"ID":"20260508230759-ag4r776","Type":"NodeParagraph","Properties":{"id":"20260508230759-ag4r776","updated":"20260508225316"},"Children":[{"Type":"NodeText","Data":"权限隔离和内核保护"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户态权限低，只能访问自己和私有内存和受限资源，没法直接操作硬件、篡改内核数据"}]},{"ID":"20260508230759-rpt6th5","Type":"NodeParagraph","Properties":{"id":"20260508230759-rpt6th5","updated":"20260508225347"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保障系统稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有普通应用都跑在用户态，即使应用崩溃、内存越界，也只会自身终止"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不会牵连内核和其他进程，避免整个系统死机蓝屏"}]},{"ID":"20260508230759-eewirde","Type":"NodeParagraph","Properties":{"id":"20260508230759-eewirde","updated":"20260508225414"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"安全和资源管控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户态程序不能随意抢占 CPU、私自管理内存，必须通过系统调用向内核申请资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"既能防止恶意程序破坏系统，也方便操作系统统一调度、隔离各进程资源"}]},{"ID":"20260508230759-iu8f4z7","Type":"NodeParagraph","Properties":{"id":"20260508230759-iu8f4z7","updated":"20260508225927"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"简化应用开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用不用关心底层硬件细节，只需调用系统接口就能使用系统能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时硬件层面从根本上限制了非法高危操作"}]},{"ID":"20260505170804-f7tirs3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f7tirs3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"git 常用操作\t\t\u003e\u003e"}]},{"ID":"20260505170804-jbd5m82","Type":"NodeParagraph","Properties":{"id":"20260505170804-jbd5m82","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"日常开发中最常用的 Git 操作主要包含"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码同步、分支管理、提交推送与冲突处理"}]},{"ID":"20260505170804-yu6pcy8","Type":"NodeParagraph","Properties":{"id":"20260505170804-yu6pcy8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先通过 git clone 克隆远程仓库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"日常更新用 git pull 拉取最新代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编写完代码后，用 git add 添加文件到暂存区，git commit -m 提交到本地仓库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再用 git push 推送到远程"}]},{"ID":"20260505170804-6ry8yi6","Type":"NodeParagraph","Properties":{"id":"20260505170804-6ry8yi6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分支方面，用 git branch 查看分支，git checkout 或 git switch 切换分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git checkout -b 创建并切换新分支"}]},{"ID":"20260505170804-5mgxvm9","Type":"NodeParagraph","Properties":{"id":"20260505170804-5mgxvm9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"合并分支使用 git merge，遇到冲突时手动修改文件后重新提交即可"}]},{"ID":"20260505170804-htel8i5","Type":"NodeParagraph","Properties":{"id":"20260505170804-htel8i5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其他高频命令还有"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"git status 查看文件状态，git log 查看提交历史，git stash 暂存未提交的修改，git reset 回退版本，git revert 安全撤销某次提交，这些基本覆盖了日常开发的绝大部分场景"}]},{"ID":"20260505170804-mo8qd4k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mo8qd4k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对比一下 git 中的 merge 和 rebase\t\t\u003e\u003e"}]},{"ID":"20260505170804-8usskaa","Type":"NodeParagraph","Properties":{"id":"20260505170804-8usskaa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Git 里，merge 和 rebase 都是用来合并分支代码的操作，日常开发里经常放在一起对比"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它们的目的一样，都是把一个分支的改动合到另一个分支，但实现方式和提交历史完全不同"}]},{"ID":"20260505170804-309azyf","Type":"NodeParagraph","Properties":{"id":"20260505170804-309azyf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"merge 是真正意义上的合并操作，执行后会生成一个新的合并提交"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把两个分支的改动整合在一起"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它最大的特点是安全，不会修改已有的提交历史，多人协作开发时用 merge 很稳妥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不会影响别人的代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过缺点也很明显，合并多了之后提交历史会出现很多分叉，看起来比较杂乱"}]},{"ID":"20260505170804-1ivu57p","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ivu57p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"rebase 叫做变基，它不会产生新的合并提交，而是把当前分支的提交重新嫁接到目标分支上，相当于把提交记录拉直。这样最终的提交历史非常干净、线性清晰，方便后续查看和回溯。但 rebase 会改写提交历史，绝对不能在公共分支上使用，否则会导致其他人的代码冲突，甚至提交丢失。"}]},{"ID":"20260505170804-10ilnrm","Type":"NodeParagraph","Properties":{"id":"20260505170804-10ilnrm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单总结一下：想要安全、保留完整历史就用 merge；想要提交记录整洁、适合个人分支整理就用 rebase，千万不要在共享分支上做变基操作。"}]},{"ID":"20260505170804-m002yxe","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m002yxe","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"fork 子进程共享资源吗\t\u003e\u003e"}]},{"ID":"20260505170804-4lhsuo1","Type":"NodeParagraph","Properties":{"id":"20260505170804-4lhsuo1","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260404204743847"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260404204743847.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-bko5ihf","Type":"NodeParagraph","Properties":{"id":"20260505170804-bko5ihf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork 创建子进程时，子进程会复制父进程的地址空间、文件描述符表等资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读时共享、写时复制"},{"Type":"NodeText","Data":"机制，物理内存只读共享，修改时才独立拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件描述符虽被复制但共享文件偏移量，同时继承工作目录、环境变量、信号处理方式等资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而进程 ID、父进程 ID、挂起信号等资源则相互独立"}]},{"ID":"20260505170804-jw9gte2","Type":"NodeParagraph","Properties":{"id":"20260505170804-jw9gte2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork 创建子进程时，子进程会复制父进程的虚拟地址空间并通过写时复制共享物理内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时完整复制文件描述符表并共享文件偏移与状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还会继承信号处理方式、信号掩码、环境变量、工作目录、用户权限、资源限制等上下文资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但进程 ID、挂起信号、文件锁以及资源使用统计等信息相互独立，互不共享"}]},{"ID":"20260505170804-dx91sfr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dx91sfr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"调用一次返回两次 fork\t\t\u003e\u003e"}]},{"ID":"20260505170804-wcu4597","Type":"NodeParagraph","Properties":{"id":"20260505170804-wcu4597","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork 函数的特点是调用一次会返回两次"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会将当前进程完整拷贝，创建出一个新的子进程"}]},{"ID":"20260505170804-uqix0sc","Type":"NodeParagraph","Properties":{"id":"20260505170804-uqix0sc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在父进程中 fork 会返回子进程的 PID，值大于 0"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在子进程中 fork 返回 0，如果创建失败则返回 - 1"}]},{"ID":"20260505170804-aimbh0k","Type":"NodeParagraph","Properties":{"id":"20260505170804-aimbh0k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"正是因为父子进程是两个独立的执行流"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"都会从 fork 调用之后继续执行，所以看起来就像是一次调用出现了两次返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通常根据返回值的不同来区分父子进程，分别编写对应的处理逻辑"}]},{"ID":"20260505170804-lijddq1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lijddq1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"select，poll，epoll 的区别\t\t\u003e\u003e"}]},{"ID":"20260505170804-ajf5dku","Type":"NodeParagraph","Properties":{"id":"20260505170804-ajf5dku","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"select、poll、epoll 都是 Linux 下实现 IO 多路复用的核心技术"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用都是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单线程监听多个文件描述符"}]},{"ID":"20260505170804-ac5o7jw","Type":"NodeParagraph","Properties":{"id":"20260505170804-ac5o7jw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"select 是最基础的多路复用方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它存在文件描述符数量限制（默认 1024）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次调用都需要把所有监听的 fd 集合从用户态拷贝到内核态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核会线性遍历所有 fd 判断是否就绪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就绪后还需要遍历整个集合才能找到就绪 fd，在高并发场景下效率极低"}]},{"ID":"20260505170804-0gbqb7f","Type":"NodeParagraph","Properties":{"id":"20260505170804-0gbqb7f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"poll 做了传入传出分离优化了 select 的数量限制，基于链表存储 fd，无最大 fd 限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它和 select 一样，依旧需要全量拷贝 fd、内核线性遍历、用户态遍历查找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上没有解决高并发下的性能瓶颈"}]},{"ID":"20260505170804-655kacl","Type":"NodeParagraph","Properties":{"id":"20260505170804-655kacl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 是 Linux 特有的高性能方案，彻底解决了前两者的缺陷"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它通过内核事件表缓存 fd，只需首次注册，无需每次全量拷贝(红黑树)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用事件驱动机制，内核会直接返回仅就绪的 fd，不用遍历所有监听描述符(双向链表就绪队列）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并且无 fd 数量限制（受系统文件句柄上限约束）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在百万级并发连接下，性能不会随 fd 数量增加而线性下降"}]},{"ID":"20260505170804-7fu8wsn","Type":"NodeParagraph","Properties":{"id":"20260505170804-7fu8wsn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单概括："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 和 poll 是 “轮询遍历”，性能随连接数增加急剧下降"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll 是 “事件回调”，高性能无瓶颈，是高并发场景的最优选择"}]},{"ID":"20260505170804-24d9rj8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-24d9rj8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"epoll 为什么不用轮询\t\t\u003e\u003e"}]},{"ID":"20260505170804-tkrosb1","Type":"NodeParagraph","Properties":{"id":"20260505170804-tkrosb1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 基于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内核事件回调机制"},{"Type":"NodeText","Data":"实现主动通知"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当我们注册文件描述符时，内核会为其绑定回调函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当硬件数据就绪产生中断时，内核驱动会直接执行回调，将该描述符加入"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"就绪队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"epoll_wait"},{"Type":"NodeText","Data":" 只需读取就绪队列，无需遍历所有监听描述符，因此避免了轮询，性能极高"}]},{"ID":"20260505170804-lik8wtj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-lik8wtj","updated":"20260512225332"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"epoll 为什么没有拷贝开销\t\t\u003e\u003e"}]},{"ID":"20260505170804-6cq5uj1","Type":"NodeParagraph","Properties":{"id":"20260505170804-6cq5uj1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 采用内核事件表 + 共享内存机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过 epoll_ctl 一次性注册文件描述符，内核持久化存储"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll_wait 仅返回就绪事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免了 select/poll 每次调用都需要将全部文件描述符从用户态拷贝到内核态的巨大开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现了高并发场景下的高效 I/O 复用"}]},{"ID":"20260505170804-bnxc2mg","Type":"NodeParagraph","Properties":{"id":"20260505170804-bnxc2mg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 在内核创建一块共享内存，用户空间和内核空间直接共用这块区域存储事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不需要像 select/poll 那样每次都把所有 fd 从用户态拷贝到内核态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有就绪事件会被少量拷贝，所以几乎无拷贝开销"}]},{"ID":"20260512225332-z6yy23d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512225332-z6yy23d","updated":"20260521124624"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"单线程 Epoll 会有读写排队的情况吗？"}]},{"ID":"20260512225332-97qlsph","Type":"NodeParagraph","Properties":{"id":"20260512225332-97qlsph","updated":"20260512224949"},"Children":[{"Type":"NodeText","Data":"单线程 epoll 不会自动并行处理读写，它只是把“哪些 fd 就绪了”通知给你"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正的读写逻辑还是在同一个线程里顺序执行，所以会出现“排队”现象，主要有几种情况："}]},{"ID":"20260512225332-skscmhp","Type":"NodeParagraph","Properties":{"id":"20260512225332-skscmhp","updated":"20260512225038"},"Children":[{"Type":"NodeText","Data":"事件处理顺序上的排队"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同一次 epoll"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"wait 返回多个就绪 fd，线程只能一个一个处理，后面的连接要等前面的处理完"}]},{"ID":"20260512225332-ovtytew","Type":"NodeParagraph","Properties":{"id":"20260512225332-ovtytew","updated":"20260512225045"},"Children":[{"Type":"NodeText","Data":"同一连接的读写排队"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果一个连接同时可读可写，代码通常也是先处理读再处理写，或者反过来，本质还是串行"}]},{"ID":"20260512225332-9rb43p3","Type":"NodeParagraph","Properties":{"id":"20260512225332-9rb43p3","updated":"20260512225050"},"Children":[{"Type":"NodeText","Data":"业务处理导致的排队"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果你在读到数据后做了解包、计算、数据库访问、日志等耗时操作，其他 fd 的读写都会被拖住"}]},{"ID":"20260512225332-hfq4xjs","Type":"NodeParagraph","Properties":{"id":"20260512225332-hfq4xjs","updated":"20260512225146"},"Children":[{"Type":"NodeText","Data":"写缓冲导致的“待发送队列”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非阻塞 socket send 不一定一次发完"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没发完的数据通常要放到应用层发送缓冲区，等下次 EPOLLOUT 再继续发，这本身也是一种写排队"}]},{"ID":"20260512225332-eef7n2f","Type":"NodeParagraph","Properties":{"id":"20260512225332-eef7n2f","updated":"20260512224938"},"Children":[{"Type":"NodeText","Data":"但要区分两层“排队”："}]},{"ID":"20260512225332-f2vhvgc","Type":"NodeParagraph","Properties":{"id":"20260512225332-f2vhvgc","updated":"20260512225152"},"Children":[{"Type":"NodeText","Data":"内核层面：socket 有接收缓冲区、发送缓冲区，数据本来就会排在里面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户层面：单线程事件循环处理事件时，也会形成处理排队"}]},{"ID":"20260521124624-9esk63y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124624-9esk63y","updated":"20260521120012"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"socket 模型都有哪些"}]},{"ID":"20260521124624-r3ikrbj","Type":"NodeParagraph","Properties":{"id":"20260521124624-r3ikrbj","updated":"20260521120118"},"Children":[{"Type":"NodeText","Data":"阻塞模型：最简单，accept/recv/send 会一直等，适合低并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非阻塞模型：调用立刻返回，自己轮询处理，效率比阻塞高，但代码更麻烦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 模型：把多个 socket 放进集合里统一检测，适合中小并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WSAEventSelect 模型：用事件通知，Windows 下比 select 更灵活一些"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WSAAsyncSelect 模型：把网络事件投递到窗口消息里，适合 GUI 程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重叠 IO / IOCP 模型：Windows 高并发首选，性能最好，适合服务器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux 中还有：select、poll、epoll"}]},{"ID":"20260521124624-6tqzr45","Type":"NodeParagraph","Properties":{"id":"20260521124624-6tqzr45","updated":"20260521121213"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"WSAEventSelect 事件通知模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把套接字绑定系统事件，有读写、连接等网络动静，系统就触发事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序靠函数等待事件到来再处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：逻辑清晰，不用轮询死等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：能监听数量有限，并发多了效率一般"}]},{"ID":"20260521124624-3zysxra","Type":"NodeParagraph","Properties":{"id":"20260521124624-3zysxra","updated":"20260521121219"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"WSAAsyncSelect 窗口消息模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络事件直接变成 Windows 窗口消息，丢进消息队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跟着窗口消息流程一起处理网络数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：写桌面 GUI 程序超适配，不用额外开等待线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：必须依赖窗口，纯后台服务器不能用，扛不住高并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一句话区分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"等事件就用事件通知，做界面程序就用消息驱动"}]},{"ID":"20260521124624-4mhxbgf","Type":"NodeParagraph","Properties":{"id":"20260521124624-4mhxbgf","updated":"20260521120954"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重叠 IO / IOCP 是 Windows 服务器最强的模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Overlapped 允许 I/O 发起后立即返回，完成时再通知"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IOCP 则把大量完成事件集中到完成端口，由少量工作线程统一取结果处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心优势是线程数少、吞吐高、扩展性好，特别适合高并发网络服务器"}]},{"ID":"20260521124624-7jsundv","Type":"NodeParagraph","Properties":{"id":"20260521124624-7jsundv","updated":"20260521121036"},"Children":[{"Type":"NodeText","Data":"IOCP 是 Windows 的完成通知模型，epoll 是 Linux 的就绪通知模型"}]},{"ID":"20260521124624-vgnxfdo","Type":"NodeParagraph","Properties":{"id":"20260521124624-vgnxfdo","updated":"20260521121043"},"Children":[{"Type":"NodeText","Data":"IOCP 的特点是“IO 完成后通知你”，适合高并发、少线程、线程池处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll 的特点是“socket 可读/可写了通知你”，你再去 recv/send 处理，属于事件驱动模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两者都适合高并发，但 IOCP 更偏异步完成，epoll 更偏事件分发"}]},{"ID":"20260521124624-6l1d9oq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124624-6l1d9oq","updated":"20260521124635"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何理解 windows 中的“事件”和“窗口”"}]},{"ID":"20260521124624-0r5786b","Type":"NodeParagraph","Properties":{"id":"20260521124624-0r5786b","updated":"20260521122055"},"Children":[{"Type":"NodeText","Data":"事件可以理解成“发生了什么”，比如按键、鼠标、网络数据到达、定时器触发"}]},{"ID":"20260521124624-wn89htj","Type":"NodeParagraph","Properties":{"id":"20260521124624-wn89htj","updated":"20260521122057"},"Children":[{"Type":"NodeText","Data":"窗口可以理解成“消息接收和处理的对象”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统把各种事件转换成消息，发给窗口，窗口再在消息处理函数里响应"}]},{"ID":"20260521124635-ih8uktj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124635-ih8uktj","updated":"20260521113047"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"32 位和 64 位操作系统虚拟地址空间理论上最大是多少，是物理地址的多少倍，有什么科学依据吗"}]},{"ID":"20260521124635-f0vbb4y","Type":"NodeParagraph","Properties":{"id":"20260521124635-f0vbb4y","updated":"20260521122539"},"Children":[{"Type":"NodeText","Data":"首先说虚拟地址空间大小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"32 位操作系统依靠 32 位地址进行寻址，理论最大虚拟地址空间为 4GB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"64 位系统采用 64 位地址寻址，理论寻址范围能达到 2 的 64 次方字节，空间规模极其庞大"}]},{"ID":"20260521124635-6ejyctd","Type":"NodeParagraph","Properties":{"id":"20260521124635-6ejyctd","updated":"20260521122733"},"Children":[{"Type":"NodeText","Data":"其次虚拟地址空间和物理内存没有固定倍数关系，虚拟内存容量不受物理内存大小约束"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不过在实际系统配置中，虚拟内存页面文件通常设置为物理内存的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1.5 至 3 倍"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三倍左右是行业通用最优经验值，用来兼顾运行需求与读写性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它借助分页机制和磁盘交换分区，能够远超实际物理内存容量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只是运行时活跃数据才会载入物理内存"}]},{"ID":"20260521124635-fegu834","Type":"NodeParagraph","Properties":{"id":"20260521124635-fegu834","updated":"20260521122939"},"Children":[{"Type":"NodeText","Data":"最后来讲科学依据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其本质由 CPU 的寻址位数决定，多少位系统就对应多少位寻址能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一位地址都能标识一个独立内存单元"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时实际使用中存在限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"32 位 windows 系统通常划分 2GB 用户空间、2GB 内核空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"32 位 Linux 默认是 3GB 用户空间、1GB 内核空间"}]},{"ID":"20260521124635-ndr1qgw","Type":"NodeParagraph","Properties":{"id":"20260521124635-ndr1qgw","updated":"20260521122948"},"Children":[{"Type":"NodeText","Data":"主流 64 位系统也仅启用 48 位地址寻址，并不会用完全部 64 位地址位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设立虚拟地址空间，也实现了进程地址隔离、内存灵活调度以及大程序运行的核心作用"}]},{"ID":"20260512230443-59xreup","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512230443-59xreup","updated":"20260512230443"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Linux 中一个单进程大概能开多少线程?（32 位和 64 位）"}]},{"ID":"20260512230443-lk1cvjt","Type":"NodeParagraph","Properties":{"id":"20260512230443-lk1cvjt","updated":"20260512230107"},"Children":[{"Type":"NodeText","Data":"32 位 Linux 单进程线程上限很低，一般几百到 1000 左右"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"64 位能开到上万甚至更多，核心受虚拟内存、栈大小、系统参数限制"}]},{"ID":"20260512230443-2maqi8q","Type":"NodeParagraph","Properties":{"id":"20260512230443-2maqi8q","updated":"20260512230120"},"Children":[{"Type":"NodeText","Data":"32 位系统进程整体虚拟地址空间只有 4G，用户态大概 3G"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个线程默认栈 8M，光栈就会占满内存，再加上线程内核结构开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以单进程通常最多几百个线程，极限也就 1000 左右"}]},{"ID":"20260512230443-kdt44hb","Type":"NodeParagraph","Properties":{"id":"20260512230443-kdt44hb","updated":"20260512230424"},"Children":[{"Type":"NodeText","Data":"32 位系统，地址线一共 32 根，每根只有 0 或 1 两种状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2 的 32 次方等于 4294967296 字节，换算过来就是 4GB，这就是 4G 的来源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux 里 32 位进程会把这 4G 虚拟地址空间拆分："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户态 3G，内核态 1G，所以程序实际能用的内存只有 3G，这也是为什么 32 位开不了多少线程"}]},{"ID":"20260512230443-w4dyeoe","Type":"NodeParagraph","Properties":{"id":"20260512230443-w4dyeoe","updated":"20260512230128"},"Children":[{"Type":"NodeText","Data":"64 位虚拟地址空间极大，内存瓶颈基本消失，主要看系统配置："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"默认线程栈 8M，调整 ulimit -s 缩小栈后，单进程轻松开上万线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再调内核参数，极限能到十几万"}]},{"ID":"20260512230443-jxy653p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512230443-jxy653p","updated":"20260512230443"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"64 位操作系统的内存上限大概是多少?"}]},{"ID":"20260512230443-2ofjm5s","Type":"NodeParagraph","Properties":{"id":"20260512230443-2ofjm5s","updated":"20260512230337"},"Children":[{"Type":"NodeText","Data":"64 位地址总线能寻址 16EB，但现代 CPU 实际只用 48 位寻址，也就是 256TB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Linux 系统里，用户态和内核态地址空间拆分，用户程序可用大概 128TB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通服务器主板受硬件、BIOS、芯片组限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际支持一般是几十 TB 以内，家用电脑大多也就支持几百 GB"}]},{"ID":"20260512230133-8snwhjz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512230133-8snwhjz","updated":"20260512223347"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Linux 中一个单进程大概能开多少线程?（32 位和 64 位）"}]},{"ID":"20260512230133-cyhxxm1","Type":"NodeParagraph","Properties":{"id":"20260512230133-cyhxxm1","updated":"20260512230107"},"Children":[{"Type":"NodeText","Data":"32 位 Linux 单进程线程上限很低，一般几百到 1000 左右"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"64 位能开到上万甚至更多，核心受虚拟内存、栈大小、系统参数限制"}]},{"ID":"20260512230133-tp8qe12","Type":"NodeParagraph","Properties":{"id":"20260512230133-tp8qe12","updated":"20260512230120"},"Children":[{"Type":"NodeText","Data":"32 位系统进程整体虚拟地址空间只有 4G，用户态大概 3G"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个线程默认栈 8M，光栈就会占满内存，再加上线程内核结构开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以单进程通常最多几百个线程，极限也就 1000 左右"}]},{"ID":"20260512230133-oyott8b","Type":"NodeParagraph","Properties":{"id":"20260512230133-oyott8b","updated":"20260512230128"},"Children":[{"Type":"NodeText","Data":"64 位虚拟地址空间极大，内存瓶颈基本消失，主要看系统配置："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"默认线程栈 8M，调整 ulimit -s 缩小栈后，单进程轻松开上万线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再调内核参数，极限能到十几万"}]},{"ID":"20260505170804-xhhpk82","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xhhpk82","updated":"20260524195247"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"LT 和 ET"}]},{"ID":"20260505170804-ks7qy1g","Type":"NodeParagraph","Properties":{"id":"20260505170804-ks7qy1g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LT 水平触发是 epoll 默认模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要文件描述符当前处于就绪状态，epoll_wait 就会一直触发通知"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就算数据没读完、连接没处理完，下次调用 epoll_wait 依然会返回就绪事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编程简单宽松，阻塞非阻塞都能用，但触发次数多，性能相对一般"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"listenfd 在 LT 下只要 accept 队列不为空，就会持续触发"}]},{"ID":"20260505170804-axdb24e","Type":"NodeParagraph","Properties":{"id":"20260505170804-axdb24e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ET 边缘触发只有 fd 就绪状态发生跳变的一瞬间才触发一次"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"已经就绪但状态不变就不再通知"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ET 性能最高、触发次数最少，但必须使用非阻塞 fd，并且要一次性把缓冲区数据读完"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"listenfd 在 ET 下必须循环 accept 清空队列，否则会出现漏连接的问题"}]},{"ID":"20260524195247-ewhd4y4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260524195247-ewhd4y4","updated":"20260524193323"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"ET 为什么一定要搭配非阻塞 socket"}]},{"ID":"20260524195247-4op8as3","Type":"NodeParagraph","Properties":{"id":"20260524195247-4op8as3","updated":"20260524195221"},"Children":[{"Type":"NodeText","Data":"ET 模式仅在套接字状态发生跳转时触发一次事件通知，不会重复上报"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果搭配阻塞套接字，单次触发后没能把缓冲区数据全部读写完毕"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"剩余数据就再也收不到事件提醒，进而造成数据丢失或是程序阻塞卡死"}]},{"ID":"20260524195247-5l5y8dm","Type":"NodeParagraph","Properties":{"id":"20260524195247-5l5y8dm","updated":"20260524195227"},"Children":[{"Type":"NodeText","Data":"非阻塞 IO 调用读写接口时不会挂起等待，操作无法继续会立刻返回特定错误标识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"收到 ET 事件后，就能循环执行读写操作，直到缓冲区数据处理干净为止"}]},{"ID":"20260524195247-vrftk8h","Type":"NodeParagraph","Properties":{"id":"20260524195247-vrftk8h","updated":"20260524195234"},"Children":[{"Type":"NodeText","Data":"综上 ET 必须配合非阻塞 socket 使用，以此保证单次事件触发时完整处理全部数据"}]},{"ID":"20260505170804-mxw5cal","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mxw5cal","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"epoll 惊群问题怎么解决\t\t\u003e\u003e"}]},{"ID":"20260505170804-j9xwlij","Type":"NodeParagraph","Properties":{"id":"20260505170804-j9xwlij","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"epoll 的惊群问题，主要出现在多进程或者多线程同时监听同一个 listen 套接字的时候"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当有一个新连接过来，内核会把所有在 epoll 上阻塞等待的进程线程都唤醒，但最终只有一个能成功建立连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其他的都是白白消耗 CPU 资源，这就是惊群"}]},{"ID":"20260505170804-zhwqjgk","Type":"NodeParagraph","Properties":{"id":"20260505170804-zhwqjgk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在实际项目里，我们常用两种方案解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一种比较简单，就是用主线程专门 accept"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只让一个线程去监听新连接，建立好之后再分发给工作线程处理，从根源上避免多个线程同时抢同一个监听 fd，自然就不会惊群"}]},{"ID":"20260505170804-fc15fke","Type":"NodeParagraph","Properties":{"id":"20260505170804-fc15fke","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二种是用内核提供的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"EPOLL_EXCLUSIVE"},{"Type":"NodeText","Data":" 标记，在添加监听 fd 到 epoll 时带上这个标志"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核就只会唤醒一个进程，不会把所有等待的进程都叫醒，也能有效避免惊群"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种方式性能更好，适合高并发场景"}]},{"ID":"20260505170804-doobhsi","Type":"NodeParagraph","Properties":{"id":"20260505170804-doobhsi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单总结就是，要么用单线程 accept 分发，要么用独占标记让内核只唤醒一个，两种方式都能稳定解决惊群问题"}]},{"ID":"20260505170804-6s2531e","Type":"NodeParagraph","Properties":{"id":"20260505170804-6s2531e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在我的项目中，解决 epoll 惊群问题采用的是主线程专门处理 accept 的方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个服务器只有一个主线程运行事件循环，当有新连接时由主线程单独调用 accept_event()函数接受连接并创建客户端套接字"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后将客户端的数据接收事件通过线程池分发给工作线程处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样从根源上避免了多线程同时争抢监听 fd 的情况，既保证了连接处理的唯一性，又简化了代码逻辑，确保了系统的稳定性和可维护性"}]},{"ID":"20260505170804-z60sfmv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z60sfmv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"解释一下 epoll 为什么是同步 IO 异步处理的\t\t\u003e\u003e"}]},{"ID":"20260505170804-kwamiia","Type":"NodeParagraph","Properties":{"id":"20260505170804-kwamiia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，epoll 本身是同步 IO"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为线程还是主动去等待事件就绪，并不是内核主动把数据推给线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程没有完全脱离阻塞等待，所以从 IO 模型划分上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它属于同步多路 IO 就绪通知，不是异步 IO"}]},{"ID":"20260505170804-iy3sm4l","Type":"NodeParagraph","Properties":{"id":"20260505170804-iy3sm4l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后，epoll 是异步处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不会对每个文件描述符单独阻塞等待，而是把大量 fd 统一交给内核"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核异步监听所有事件哪个 fd 可读可写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核再异步通知线程，线程再去处理就绪事件"}]},{"ID":"20260505170804-eg17srl","Type":"NodeParagraph","Properties":{"id":"20260505170804-eg17srl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"卡在 epoll_wait 上等待事件的，是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"专门的 epoll 监听线程（事件分发线程）"},{"Type":"NodeText","Data":"，不是业务工作线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正是这个监听线程主动阻塞调用 epoll_wait，主动等待事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是内核主动推送，所以 epoll 依然属于同步 IO"}]},{"ID":"20260505170804-d4c486g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d4c486g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你项目中为什么用 LT 不用 ET\t\u003e\u003e"}]},{"ID":"20260505170804-z7jdbnm","Type":"NodeParagraph","Properties":{"id":"20260505170804-z7jdbnm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LT 模式的编程模型相对简单，对于我的项目来说更加适合，因为它不需要像 ET 模式那样处理复杂的边缘情况"}]},{"ID":"20260505170804-fykbf0c","Type":"NodeParagraph","Properties":{"id":"20260505170804-fykbf0c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，我的服务器采用了线程池来处理接收事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个连接使用了 EPOLLONESHOT 标志，确保同一个套接字的接收操作是排队处理的，避免了多线程并发问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在这种情况下，LT 模式能够更可靠地触发事件，确保数据不会丢失"}]},{"ID":"20260505170804-4utg0qy","Type":"NodeParagraph","Properties":{"id":"20260505170804-4utg0qy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外，LT 模式的错误处理更加简单直观"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我的 SendData 函数采用了阻塞模式发送数据，不需要监听 EPOLLOUT 事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这简化了代码逻辑，降低了开发和调试的难度"}]},{"ID":"20260505170804-5s45sw7","Type":"NodeParagraph","Properties":{"id":"20260505170804-5s45sw7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后，考虑到我们项目的规模和需求，LT 模式提供了足够的性能，同时大大降低了开发复杂度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对于我这种视频服务器应用来说，稳定性和可维护性比极致的性能优化更为重要，所以选择 LT 模式是一个合理的权衡"}]},{"ID":"20260505170804-xnlv3lh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xnlv3lh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Reactor 和 Proactor\t\t\u003e\u003e"}]},{"ID":"20260505170804-9y0rkrv","Type":"NodeParagraph","Properties":{"id":"20260505170804-9y0rkrv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Reactor 和 Proactor 都是高性能 IO 模型，核心区别在于谁来完成数据的读取与处理"}]},{"ID":"20260505170804-kzjw7m3","Type":"NodeParagraph","Properties":{"id":"20260505170804-kzjw7m3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Reactor 是同步非阻塞模型：它只帮你盯着有没有事件来，比如连接好了、可以读数据了，一旦就绪就通知你，剩下的读写操作都得你自己去做"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Proactor 是异步非阻塞模型：你告诉操作系统要读要写，然后就不用管了，内核自己去完成数据的读写，等全部做完了再通知你直接处理结果，不用再去做 IO 操作"}]},{"ID":"20260505170804-6jkbmy2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6jkbmy2","updated":"20260512231754"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程、线程、协程的区别？\t\u003e\u003e"}]},{"ID":"20260505170804-v2qpgwx","Type":"NodeParagraph","Properties":{"id":"20260505170804-v2qpgwx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程是资源分配的最小单位，拥有独立的地址空间，适合独立的应用程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程是 CPU 调度的最小单位，共享进程的资源，仅独立拥有程序计数器、栈、寄存器、线程私有数据，适合执行并行任务"}]},{"ID":"20260505170804-s56i5rf","Type":"NodeParagraph","Properties":{"id":"20260505170804-s56i5rf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程之间相互独立，一个进程崩溃通常不会影响其他进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"稳定性更高，但切换开销大"}]},{"ID":"20260505170804-q9siol0","Type":"NodeParagraph","Properties":{"id":"20260505170804-q9siol0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程共享同一块地址空间，通信更简单、切换成本低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但一个线程出现异常，比如段错误，很可能导致整个进程直接崩溃"}]},{"ID":"20260505170804-2elj0s7","Type":"NodeParagraph","Properties":{"id":"20260505170804-2elj0s7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外，进程间通信需要管道、消息队列、套接字等机制，比较复杂"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程之间可以直接读写全局变量、堆内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通信成本极低，但必须加锁处理同步问题"}]},{"ID":"20260505170804-4fr4ykf","Type":"NodeParagraph","Properties":{"id":"20260505170804-4fr4ykf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"协程是用户态的轻量级执行单元，不由操作系统调度，运行在线程之上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过用户态的调度实现非阻塞的任务切换，适合处理大量的异步任务"}]},{"ID":"20260505170804-iquo6l4","Type":"NodeTable","Data":"|对比维度|进程 Process|线程 Thread|协程 Coroutine|\n| --------| --------------------------------| ----------------------------| -----------------------------------|\n|调度主体|操作系统内核|操作系统内核|用户态（语言 / 框架）|\n|切换环境|内核态|内核态|用户态|\n|共享资源|完全独立，不共享地址空间|同进程内共享内存、文件、句柄|同线程内完全共享|\n|独立资源|独立页表、文件描述符、内核对象|独有栈、寄存器、TLS|独有用户态栈|\n|内存开销|极大（GB 级虚拟空间）|较大（默认栈～8MB）|极小（栈～2KB）|\n|切换开销|最高（切换页表、刷新 TLB/Cache）|高（上下文切换、内核调度）|极低（寄存器 + 栈切换，无内核陷入）|\n|多核利用|天然多核并行|天然多核并行|本身不能，需配合多线程|\n|阻塞影响|只阻塞自己|只阻塞自己|阻塞整个线程，所有协程卡住|\n|通信成本|高（管道、消息队列、共享内存）|中（需锁、同步原语）|极低（直接读写共享变量）|\n|并发上限|很低（几百个就很重）|中等（几千～上万）|极高（轻松百万级）|\n|稳定性|高，进程崩溃不影响其他|中，线程崩溃可能拖垮进程|低，协程崩溃通常影响整个线程 / 进程|\n|适用场景|独立服务、多程序隔离|CPU 密集、通用并发|IO 密集、高并发网络服务|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-iquo6l4","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比维度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"进程 Process"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"线程 Thread"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"协程 Coroutine"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"调度主体"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"操作系统内核"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"操作系统内核"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用户态（语言 / 框架）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"切换环境"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内核态"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内核态"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"用户态"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"共享资源"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"完全独立，不共享地址空间"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"同进程内共享内存、文件、句柄"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"同线程内完全共享"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独立资源"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独立页表、文件描述符、内核对象"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独有栈、寄存器、TLS"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独有用户态栈"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内存开销"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极大（GB 级虚拟空间）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"较大（默认栈～8MB）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极小（栈～2KB）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"切换开销"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"最高（切换页表、刷新 TLB/Cache）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高（上下文切换、内核调度）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极低（寄存器 + 栈切换，无内核陷入）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多核利用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"天然多核并行"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"天然多核并行"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"本身不能，需配合多线程"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"阻塞影响"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只阻塞自己"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只阻塞自己"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"阻塞整个线程，所有协程卡住"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"通信成本"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高（管道、消息队列、共享内存）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中（需锁、同步原语）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极低（直接读写共享变量）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"并发上限"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"很低（几百个就很重）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中等（几千～上万）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极高（轻松百万级）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"稳定性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高，进程崩溃不影响其他"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中，线程崩溃可能拖垮进程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"低，协程崩溃通常影响整个线程 / 进程"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"适用场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独立服务、多程序隔离"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"CPU 密集、通用并发"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"IO 密集、高并发网络服务"}]}]}]},{"ID":"20260505170804-0snbyx5","Type":"NodeParagraph","Properties":{"id":"20260505170804-0snbyx5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程是资源分配的最小单位，最重、最隔离、开销最大；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程是 CPU 调度的最小单位，同进程内共享资源，轻于进程但仍有内核开销；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程是用户态轻量级执行单元，切换极快、极省内存，但不能阻塞、需语言 runtime 支持。"}]},{"ID":"20260512231754-cpdwc2q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512231754-cpdwc2q","updated":"20260517204729"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程和协程有什么区别"}]},{"ID":"20260512231754-yr8z0ju","Type":"NodeParagraph","Properties":{"id":"20260512231754-yr8z0ju","updated":"20260512231638"},"Children":[{"Type":"NodeText","Data":"线程和协程的核心区别是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程是操作系统调度的，协程是用户态自己调度的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程属于系统资源，创建和切换都比较重"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程更轻，切换通常发生在一个线程内部，所以开销小很多"}]},{"ID":"20260512231754-n29mw5h","Type":"NodeParagraph","Properties":{"id":"20260512231754-n29mw5h","updated":"20260512231654"},"Children":[{"Type":"NodeText","Data":"从并发方式看，线程可以利用多核并行执行，因为多个线程可以同时被 CPU 调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程一般是并发，不一定并行，很多协程其实跑在少量线程上，遇到 IO 时主动让出执行权"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，协程更适合高并发 IO 场景，线程更适合需要真正并行计算的场景"}]},{"ID":"20260512231754-8v4engk","Type":"NodeParagraph","Properties":{"id":"20260512231754-8v4engk","updated":"20260512231740"},"Children":[{"Type":"NodeText","Data":"从使用上看，线程的难点在共享内存带来的锁竞争、线程安全和上下文切换成本；协程的优势是写法轻、切换快、能用同步风格写异步逻辑，但前提是底层要有事件循环或者调度器支持。面试里我一般会总结一句：线程解决的是多核并行问题，协程解决的是高并发调度效率问题，两者不是完全替代关系"}]},{"ID":"20260517204729-g65rzz8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517204729-g65rzz8","updated":"20260517204709"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"协程有自己的栈吗，C++20 协程有独立栈吗"}]},{"ID":"20260517204729-6or0q0v","Type":"NodeParagraph","Properties":{"id":"20260517204729-6or0q0v","updated":"20260517204712"},"Children":[{"Type":"NodeText","Data":"传统协程分为有栈协程和无栈协程。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"C++20 协程本质上是无栈协程"},{"Type":"NodeText","Data":"，它不会像线程那样分配一个完整独立栈，而是把挂起点相关状态保存到一个协程帧里。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以它更轻量，但也意味着它的行为模式和传统有栈协程不完全一样。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"面试里答到“协程帧”通常会比较加分。"}]},{"ID":"20260505170804-h1sihw1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-h1sihw1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程是分配资源的基本单位，那么这个资源指的是什么？\t\u003e\u003e"}]},{"ID":"20260505170804-1iji230","Type":"NodeParagraph","Properties":{"id":"20260505170804-1iji230","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚拟内存、文件句柄、信号量等资源"}]},{"ID":"20260505170804-ta8qyj2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ta8qyj2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"操作系统最小单位是线程，那协程怎么实现？\t\t\u003e\u003e"}]},{"ID":"20260505170804-hzr5glq","Type":"NodeParagraph","Properties":{"id":"20260505170804-hzr5glq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"协程的实现主要在用户态完成，不需要操作系统内核的直接支持"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户代码显式地控制协程的切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程在切换时需要保存当前的执行上下文（如寄存器、栈指针）并在恢复时恢复这些上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个协程有自己的栈，存储协程的局部变量和函数调用信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程的栈通常比线程的栈更小"}]},{"ID":"20260505170804-93r79j5","Type":"NodeParagraph","Properties":{"id":"20260505170804-93r79j5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"协程栈：在堆内存上创建，初始很小"}]},{"ID":"20260505170804-wtfdu7a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wtfdu7a","updated":"20260517204420"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程和线程在上下文切换时发生了 什么、共享了什么？\t\u003e\u003e"}]},{"ID":"20260505170804-yvfbsol","Type":"NodeParagraph","Properties":{"id":"20260505170804-yvfbsol","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"上下文切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"切换进程时，操作系统需要保存当前进程的状态并加载新进程的状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程切换涉及完整的硬件地址空间切换，包括页表、缓存清空等，因此开销较大"}]},{"ID":"20260505170804-c06ukin","Type":"NodeParagraph","Properties":{"id":"20260505170804-c06ukin","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"切换线程时，主要保存和恢复寄存器状态、程序计数器、栈的指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相较于进程切换，线程切换的开销小，因为不需要切换内存地址空间"}]},{"ID":"20260505170804-x7o1d2t","Type":"NodeParagraph","Properties":{"id":"20260505170804-x7o1d2t","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"资源共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个进程拥有独立的内存空间和系统资源，进程之间相互隔离，仅共享内核资源与硬件资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程共享进程的内存空间，但各自持有独立的栈、寄存器状态和程序计数器"}]},{"ID":"20260517204420-0qvllj9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517204420-0qvllj9","updated":"20260517204313"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程什么时候发生上下文切换"}]},{"ID":"20260517204420-fpj6dhf","Type":"NodeParagraph","Properties":{"id":"20260517204420-fpj6dhf","updated":"20260517204316"},"Children":[{"Type":"NodeText","Data":"常见场景有："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时间片用完；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程主动阻塞，比如锁竞争、IO 阻塞、sleep；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更高优先级线程就绪；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中断或内核调度触发切换。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上下文切换会保存当前线程寄存器、程序计数器、栈信息，再恢复另一个线程的执行现场。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以频繁切换会带来性能损耗。"}]},{"ID":"20260505170804-ardv9nc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ardv9nc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程之间是如何调度的"}]},{"ID":"20260505170804-78n3eyz","Type":"NodeParagraph","Properties":{"id":"20260505170804-78n3eyz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程调度由操作系统内核负责，基于时间片轮转、抢占式调度机制"}]},{"ID":"20260505170804-3nnp3ya","Type":"NodeParagraph","Properties":{"id":"20260505170804-3nnp3ya","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同一进程内的多个线程，共享进程资源，由内核统一分配 CPU 时间片，快速切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统会按线程优先级划分，高优先级线程可抢占 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"时间片耗尽就主动让出 CPU，切换下一个就绪线程"}]},{"ID":"20260505170804-jib1snd","Type":"NodeParagraph","Properties":{"id":"20260505170804-jib1snd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"遇到阻塞事件，比如锁等待、IO 请求，线程会主动放弃 CPU，进入阻塞态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调度器立马切换其他就绪线程运行，提升 CPU 利用率"}]},{"ID":"20260505170804-cwyt9bn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cwyt9bn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"计算机中怎么实现的多线程?"}]},{"ID":"20260505170804-qecr1pb","Type":"NodeParagraph","Properties":{"id":"20260505170804-qecr1pb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"计算机多线程，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"由操作系统内核负责管理调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程是进程内轻量级执行单元，共享进程资源，只独有栈和寄存器上下文，创建切换开销很小"}]},{"ID":"20260505170804-m1c8uxf","Type":"NodeParagraph","Properties":{"id":"20260505170804-m1c8uxf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核用 TCB 维护线程信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"时间片轮转 + 抢占式调度"},{"Type":"NodeText","Data":"做线程切换，单核靠快速轮转实现并发，多核可真正并行执行"}]},{"ID":"20260505170804-6tau8er","Type":"NodeParagraph","Properties":{"id":"20260505170804-6tau8er","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编程语言的线程库本质是封装系统调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终都依赖操作系统内核和 CPU 上下文切换机制实现多线程"}]},{"ID":"20260505170804-7w94lbo","Type":"NodeParagraph","Properties":{"id":"20260505170804-7w94lbo","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"比如说有两个线程："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程 A 和线程 B，线程 B 要先于线程 A 运行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"或者是线程 B 运行了多次之后在启动线程 A，如何进行调度？"}]},{"ID":"20260505170804-059zizb","Type":"NodeParagraph","Properties":{"id":"20260505170804-059zizb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不能靠线程优先级控制，优先级只是概率调度，无法保证绝对顺序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"想要 B 先执行、或 B 跑多次再启动 A，用条件变量 + 互斥锁实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让线程 A 启动后阻塞等待，线程 B 优先执行，跑完指定次数再发信号唤醒 A"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也可在主线程管控，先让 B 运行，再创建开启 A，从源头控制执行先后"}]},{"ID":"20260505170804-slj4jwj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-slj4jwj","updated":"20260517205213"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多线程开发会遇到哪些问题?"}]},{"ID":"20260505170804-wa5jz7x","Type":"NodeParagraph","Properties":{"id":"20260505170804-wa5jz7x","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享变量同时读写，会出现数据错乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有 CPU 缓存带来的可见性、编译器和 CPU 的指令重排序导致有序性问题"}]},{"ID":"20260505170804-94f8zfh","Type":"NodeParagraph","Properties":{"id":"20260505170804-94f8zfh","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"同步引发的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为保证安全要加锁，容易产生死锁、活锁、线程饥饿"}]},{"ID":"20260505170804-lcf3c5g","Type":"NodeParagraph","Properties":{"id":"20260505170804-lcf3c5g","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性能和维护问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程太多会造成频繁上下文切换，消耗性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且多线程 bug 大多偶发难复现，调试排查特别麻烦"}]},{"ID":"20260517205213-grm7huf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517205213-grm7huf","updated":"20260517205220"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多线程调用一个函数，判断调用了多少次"}]},{"ID":"20260517205213-p0emvqw","Type":"NodeParagraph","Properties":{"id":"20260517205213-p0emvqw","updated":"20260517205220"},"Children":[{"Type":"NodeText","Data":"最直接的方式是用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原子计数器"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"std ::atomic"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次进入函数时做原子自增，最终读取计数即可。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果只想统计一次初始化，甚至可以用 std ::call"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"once。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这题重点是意识到："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"普通 int++ 在多线程下不是安全的，必须用原子或锁"}]},{"ID":"20260505170804-qy0loqi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qy0loqi","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"If 操作，开子线程，如何返回给主线程?"}]},{"ID":"20260505170804-xt76ojs","Type":"NodeParagraph","Properties":{"id":"20260505170804-xt76ojs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 if 逻辑里开启子线程，子线程不能直接 return 返回给主线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为子线程是异步执行的，主线程不会等待子线程执行完毕"}]},{"ID":"20260505170804-vvq9f0l","Type":"NodeParagraph","Properties":{"id":"20260505170804-vvq9f0l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常用五种方式把子线程结果回传给主线程："}]},{"ID":"20260505170804-qs7ltqp","Type":"NodeParagraph","Properties":{"id":"20260505170804-qs7ltqp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"共享变量：用 volatile 或原子变量保存结果，主线程等待后取值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"回调函数：子线程任务完成后，主动回调主线程方法传回数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Future/Callable：借助线程池的 Future，主线程调用 get () 阻塞获取返回值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CountDownLatch 同步工具：子线程完成后递减计数器，主线程等待闩锁放行再拿结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Qt 信号槽：专门适配跨线程传值，子线程发信号携带结果，主线程槽函数接收处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Qt 内部自动做线程间消息队列转发，不用手动加锁、线程安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还能在子线程干完活后安全更新主线程 UI"}]},{"ID":"20260505170804-51uqu7x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-51uqu7x","updated":"20260507220846"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果一个线程崩溃，会影响到其他线程吗"}]},{"ID":"20260505170804-wiid8ua","Type":"NodeParagraph","Properties":{"id":"20260505170804-wiid8ua","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 里"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"普通业务异常"},{"Type":"NodeText","Data":"在线程内部捕获了，就只崩当前线程，不影响别的"}]},{"ID":"20260505170804-jyl0glm","Type":"NodeParagraph","Properties":{"id":"20260505170804-jyl0glm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但只要出现空指针、除零、栈溢出这类"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统级崩溃"},{"Type":"NodeText","Data":"，或者线程异常没被捕获"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"都会直接干掉整个进程，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"所有线程一起挂"}]},{"ID":"20260505170804-wq7vms3","Type":"NodeParagraph","Properties":{"id":"20260505170804-wq7vms3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"真正要隔离故障只能用多进程，线程做不到彻底隔离"}]},{"ID":"20260507220846-hh8o7kr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507220846-hh8o7kr","updated":"20260507165902"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程被挂起会带来什么问题？"}]},{"ID":"20260507220846-ggagevz","Type":"NodeParagraph","Properties":{"id":"20260507220846-ggagevz","updated":"20260507220534"},"Children":[{"Type":"NodeText","Data":"线程被挂起，就是线程突然被暂停、让出 CPU，暂时不干活了"}]},{"ID":"20260507220846-54hchph","Type":"NodeParagraph","Properties":{"id":"20260507220846-54hchph","updated":"20260507220540"},"Children":[{"Type":"NodeText","Data":"会有这几个问题："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"业务变卡、响应变慢，本来马上能处理的任务，要等系统重新调度唤醒，耽误时间"}]},{"ID":"20260507220846-tpg6kn8","Type":"NodeParagraph","Properties":{"id":"20260507220846-tpg6kn8","updated":"20260507220553"},"Children":[{"Type":"NodeText","Data":"容易引发锁的问题："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果拿着锁的线程被挂起，别的线程只能干等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要么死循环空转浪费 CPU，要么扎堆阻塞，还容易死锁"}]},{"ID":"20260507220846-f3i29ga","Type":"NodeParagraph","Properties":{"id":"20260507220846-f3i29ga","updated":"20260507220613"},"Children":[{"Type":"NodeText","Data":"定时、心跳这类逻辑乱掉，该到点执行的任务不准时，容易判超时、断连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"消息越堆越多，处理线程停了，请求和数据积压"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务吞吐量下降，严重还会内存爆掉崩溃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像游戏、嵌入式这种实时场景，线程一挂起，直接错过处理时机，业务就出错失控"}]},{"ID":"20260505170804-hka9o6p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-hka9o6p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程切换详细过程是怎么样的？上下文保存在哪里？\t\u003e\u003e"}]},{"ID":"20260505170804-ldyrhp9","Type":"NodeParagraph","Properties":{"id":"20260505170804-ldyrhp9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程切换分四步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先保存当前线程的寄存器、程序计数器等上下文到 TCB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再切给调度器选下一个线程，然后从新线程的 TCB 恢复上下文，最后把执行权切给新线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上下文统一存在线程控制块 TCB 里，线程切换不用换页表，开销远小于进程切换，速度更快"}]},{"ID":"20260505170804-taqs567","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-taqs567","updated":"20260505172938"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程的状态（五种状态），如何切换？"}]},{"ID":"20260505170804-jfuor6m","Type":"NodeParagraph","Properties":{"id":"20260505170804-jfuor6m","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260404202527599"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260404202527599.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505172935-0l8h07f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505172935-0l8h07f","updated":"20260505172935"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程阻塞"}]},{"ID":"20260505172935-ynom3t8","Type":"NodeParagraph","Properties":{"id":"20260505172935-ynom3t8","updated":"20260505172935"},"Children":[{"Type":"NodeText","Data":"线程阻塞就是线程暂停运行，让出 CPU，进入等待状态，不占用时间片常见触发场景：等待锁、等待条件变量、IO 读写、sleep、等待信号量都会阻塞阻塞后 CPU 可以调度其他线程，不忙等、节省资源条件满足后被唤醒，重新进入就绪队列抢 CPU 执行"}]},{"ID":"20260505170804-vr1zuui","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vr1zuui","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程上下文有哪些？\t\u003e\u003e"}]},{"ID":"20260505170804-m3l19rv","Type":"NodeParagraph","Properties":{"id":"20260505170804-m3l19rv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程上下文，就是进程在 CPU 上执行时所需要的全部执行环境"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单理解，就是 CPU 当时的寄存器状态、程序计数器（PC）、堆栈指针、内存页表、内核栈、文件描述符等等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一套完整的现场信息"}]},{"ID":"20260505170804-vol1efx","Type":"NodeParagraph","Properties":{"id":"20260505170804-vol1efx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当进程切换发生时，操作系统会把当前进程的上下文完整保存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包括 CPU 寄存器的值、程序计数器记录下一条执行位置、堆栈指针、以及进程的虚拟内存空间、页表、内核堆栈等内核资"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这些信息都统一存放在进程的 PCB（进程控制块） 里"}]},{"ID":"20260505170804-ey82fjv","Type":"NodeParagraph","Properties":{"id":"20260505170804-ey82fjv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"切换到下一个进程时，操作系统就从目标进程的 PCB 里把之前保存的上下文恢复到 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包括寄存器、程序计数器、页表等，让 CPU 直接从上次中断的位置继续执行新进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样就实现了进程的无缝切换，让进程看起来像是一直在连续运行"}]},{"ID":"20260505170804-64e8419","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-64e8419","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程切换时，只需要修改页表基址寄存器，看起来只是简单移动一下指针，为什么进程切换的开销仍然很大？"}]},{"ID":"20260505170804-8kvq30s","Type":"NodeParagraph","Properties":{"id":"20260505170804-8kvq30s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"切换进程时，虽然只是把 CR3 寄存器（页表基址指针）换一下，看起来只是改个指针"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但开销大主要不在这一步，而在切换之后带来的连锁反应"}]},{"ID":"20260505170804-vfxwnak","Type":"NodeParagraph","Properties":{"id":"20260505170804-vfxwnak","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLB 快表会全部失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TLB 是缓存虚拟地址到物理地址映射的高速缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个进程的虚拟地址空间是独立的，切换进程后，原来的 TLB 条目全作废，必须全部刷新"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后访问内存都要重新查页表、重新填充 TLB，这会导致大量的缺页、慢访问，性能掉得很明显"}]},{"ID":"20260505170804-w0xxyyg","Type":"NodeParagraph","Properties":{"id":"20260505170804-w0xxyyg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CPU 缓存基本失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"L1、L2 这些缓存通常是按虚拟地址或者进程标识来区分的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程一切换，原来缓存里的数据对新进程没用，相当于缓存被 “清空”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接下来会出现大量缓存不命中，CPU 要频繁去内存读数据，速度慢很多"}]},{"ID":"20260505170804-ywgikn4","Type":"NodeParagraph","Properties":{"id":"20260505170804-ywgikn4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"上下文本身也要保存恢复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"除了页表，还要保存通用寄存器、浮点寄存器、程序计数器、堆栈指针等一堆现场，这些操作本身也是有开销的"}]},{"ID":"20260505170804-fxa6xfl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fxa6xfl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是线程的优先级反转\t\t\u003e\u003e"}]},{"ID":"20260505170804-wfen7z9","Type":"NodeParagraph","Properties":{"id":"20260505170804-wfen7z9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优先级反转就是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"低优先级线程拿着锁，高优先级线程在等锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结果被中间优先级的线程抢占了 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"导致高优先级任务反而执行不了"}]},{"ID":"20260505170804-ag5fb2z","Type":"NodeParagraph","Properties":{"id":"20260505170804-ag5fb2z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决方式最常用优先级继承，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让持有锁的低优先级线程临时提升优先级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免被中间线程打断，快速释放锁后再恢复，保证调度正常"}]},{"ID":"20260505170804-wonupfq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wonupfq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"用户态切换到内核态都需要做哪些事\t\t\u003e\u003e"}]},{"ID":"20260505170804-jj7inrh","Type":"NodeParagraph","Properties":{"id":"20260505170804-jj7inrh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户态切换内核态，本质是 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 特权级升级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从低权限用户模式进入高权限内核模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有中断、异常、系统调用这三种方式能触发切换，不能程序主动直接跳转"}]},{"ID":"20260505170804-lnslu23","Type":"NodeParagraph","Properties":{"id":"20260505170804-lnslu23","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"切换首先要"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"保存用户态现场"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把当前 CPU 寄存器、程序计数器 PC、栈指针 SP 等全部压入内核栈保存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止返回用户态时数据丢失"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时切换栈，从用户栈切换到独立内核栈，避免内核数据被用户态篡改"}]},{"ID":"20260505170804-mi0b0lk","Type":"NodeParagraph","Properties":{"id":"20260505170804-mi0b0lk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"接着 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 修改特权级寄存器，完成权限升级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加载内核页表，关闭部分用户态权限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开始执行内核处理逻辑，比如系统调用服务、中断处理、异常处理"}]},{"ID":"20260505170804-073w555","Type":"NodeParagraph","Properties":{"id":"20260505170804-073w555","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"处理完成后，再"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"恢复用户态现场"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"弹出之前保存的寄存器，切回用户栈、切回用户页表、降低 CPU 特权级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"回到用户态继续执行原来程序。整个切换有固定开销，频繁切换会导致性能下降"}]},{"ID":"20260505170804-3695ztc","Type":"NodeParagraph","Properties":{"id":"20260505170804-3695ztc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"保存现场、切栈、改权限、内核处理、恢复现场"}]},{"ID":"20260505170804-kod21ve","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kod21ve","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"TLB\t\u003e\u003e"}]},{"ID":"20260505170804-6k7fouu","Type":"NodeParagraph","Properties":{"id":"20260505170804-6k7fouu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLB 就是快表，作用就是加速虚拟地址到物理地址的转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序用的是虚拟地址，CPU 要访问内存，必须先查页表转成物理地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但页表本身在内存里，每次都查内存会很慢"}]},{"ID":"20260505170804-cu4z19s","Type":"NodeParagraph","Properties":{"id":"20260505170804-cu4z19s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"TLB 就是一块 CPU 内部的高速缓存，专门存最近用过的虚拟地址到物理地址映射关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"地址翻译时，先去 TLB 里找，命中了就直接拿到物理地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用再访问内存查页表，速度非常快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 TLB 没命中，才去内存查页表，查到后再把这条映射存进 TLB，方便下次使用"}]},{"ID":"20260505170804-dg6y7ya","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dg6y7ya","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"系统调用有哪些"}]},{"ID":"20260505170804-2lw40j7","Type":"NodeParagraph","Properties":{"id":"20260505170804-2lw40j7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统调用主要分"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进程、文件 IO、网络、内存、信号时间"},{"Type":"NodeText","Data":"五大类"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是用户态主动陷入内核、请求操作系统服务的唯一入口"}]},{"ID":"20260505170804-j02vqra","Type":"NodeParagraph","Properties":{"id":"20260505170804-j02vqra","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"创建进程、销毁进程、进程等待、获取 PID、进程退出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：fork、exec、exit、wait、getpid"}]},{"ID":"20260505170804-eq68jhb","Type":"NodeParagraph","Properties":{"id":"20260505170804-eq68jhb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"文件 IO 管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"打开、关闭、读写文件、偏移指针、创建删除文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：open、close、read、write、lseek"}]},{"ID":"20260505170804-hj3m6ia","Type":"NodeParagraph","Properties":{"id":"20260505170804-hj3m6ia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"网络通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"创建套接字、绑定、监听、连接、收发数据。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：socket、bind、listen、accept、send、recv"}]},{"ID":"20260505170804-pavyn9h","Type":"NodeParagraph","Properties":{"id":"20260505170804-pavyn9h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"申请释放虚拟内存、内存映射"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：mmap、munmap、brk"}]},{"ID":"20260505170804-72qb6kf","Type":"NodeParagraph","Properties":{"id":"20260505170804-72qb6kf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"设备 / 时间 / 信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"获取系统时间、设置闹钟、注册信号、进程休眠"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心：signal、alarm、sleep、gettimeofday"}]},{"ID":"20260505170804-ln6shmd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ln6shmd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"操作系统启动一个进程、加载应用程序的流程是什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-tnl5597","Type":"NodeParagraph","Properties":{"id":"20260505170804-tnl5597","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"操作系统先通过 fork 创建进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分配 PCB、虚拟内存等内核资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再通过 exec 加载可执行文件，解析 ELF/PE 格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加载代码数据段、完成动态链接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"初始化栈与入口地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后切换上下文开始执行，从而把一个可执行文件变成运行中的进程"}]},{"ID":"20260505170804-5jrxcji","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5jrxcji","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"代码和数据是一次性加载到内存里吗?\t\t\u003e\u003e"}]},{"ID":"20260505170804-y48za4l","Type":"NodeParagraph","Properties":{"id":"20260505170804-y48za4l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"并不是把代码和数据一次性全部加载到内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统只是先建立好虚拟地址空间和页表映射,把可执行文件映射到虚拟内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正用到哪一页，CPU 缺页异常时才从磁盘读到物理内存，没用到的暂时不加载，这就是按需分页加载"}]},{"ID":"20260505170804-uq6fklx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uq6fklx","updated":"20260512135607"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"一个进程能创建多少个线程"}]},{"ID":"20260505170804-qquynlv","Type":"NodeParagraph","Properties":{"id":"20260505170804-qquynlv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一个进程能创建的线程数量没有固定上限，主要受三个因素限制：用户态栈内存大小、系统全局线程总数限制、进程地址空间大小"}]},{"ID":"20260505170804-1hc0c3z","Type":"NodeParagraph","Properties":{"id":"20260505170804-1hc0c3z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"默认情况下，Linux 每个线程栈大小通常是 8MB，32 位进程地址空间只有 4GB，除去程序本身占用，一般最多只能创建 几百个线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"64 位进程地址空间极大，线程数量主要受限于系统参数 pid_max、threads-max 以及物理内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通常可以达到数千甚至上万个，但实际业务里受限于调度开销，一般不会开这么多"}]},{"ID":"20260505170804-aanec6j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-aanec6j","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么用线程池而不用进程池？\t进程和线程的核心区别？\t\u003e\u003e"}]},{"ID":"20260505170804-q2qa5qx","Type":"NodeParagraph","Properties":{"id":"20260505170804-q2qa5qx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，服务器需要处理大量网络 IO 和数据传输，属于典型的 IO 密集型场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程比进程更轻量，创建销毁和上下文切换的开销都更小，能更高效地支撑高并发连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次，同一进程内的线程共享地址空间，线程间传递数据更方便，不需要进程间通信那样复杂的 IPC 机制，减少了数据拷贝和同步开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更适合网络数据接收与处理分离的架构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外，线程池可以动态调整线程数量，控制并发度，避免频繁创建销毁线程，资源利用率更高，也更稳定"}]},{"ID":"20260505170804-51duerv","Type":"NodeParagraph","Properties":{"id":"20260505170804-51duerv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"进程和线程的核心区别主要在这几方面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一是资源模型，进程有独立的地址空间和系统资源，而线程共享所属进程的地址空间和资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二是开销，进程创建、切换和销毁的开销远大于线程，线程更轻量化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三是稳定性，进程之间相互隔离，一个进程崩溃不会影响其他进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而线程共享资源，一个线程异常可能导致整个进程崩溃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四是通信方式，进程间需要管道、消息队列等 IPC，线程则可以直接读写共享数据，效率更高"}]},{"ID":"20260505170804-hzbu0ms","Type":"NodeParagraph","Properties":{"id":"20260505170804-hzbu0ms","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"结合项目我需要高并发、低开销、高效数据交互，线程池在这些方面更有优势"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此最终采用了线程池方案来处理网络事件和数据任务"}]},{"ID":"20260505170804-zx1f062","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zx1f062","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么时候该用多线程，什么时候该用多进程？\t\u003e\u003e"}]},{"ID":"20260505170804-y7h5191","Type":"NodeParagraph","Properties":{"id":"20260505170804-y7h5191","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用多线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当需要多个执行单元共享大量数据或状态时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要频繁地创建和销毁执行单元或者需要大量轻量级并发操作时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对实时响应要求比较高的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"例如：网络服务器和客户端应用程序，如 Web 服务器和现代 Web 浏览器。多媒体应用，如视频播放软件，需要在后台加载数据的同时保持用户界面的响应。"}]},{"ID":"20260505170804-fns6rqp","Type":"NodeParagraph","Properties":{"id":"20260505170804-fns6rqp","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"使用多进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在隔离性、安全性和稳定性要求较高的场景，例如网银系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"利用多核处理器，将不同的进程调度到不同的核心上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对于大量计算和资源要求高的程序，多进程可以避免一个进程中的错误影响到其他进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不像线程共享内存，多进程没有线程安全问题，不用复杂锁，更稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"例如："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大数据处理应用，每个进程执行不同的数据集分析"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大型计算应用，需要大量计算资源而且稳定性要求极高"}]},{"ID":"20260505170804-qxe132u","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qxe132u","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"协程，一个线程同一时间只能运行一个协程，为什么快\t\u003e\u003e"}]},{"ID":"20260505170804-4p27uos","Type":"NodeParagraph","Properties":{"id":"20260505170804-4p27uos","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"【不涉及内核，协程堆栈通常很小（KB 级别），单线程内协程不存在竞态条件】"}]},{"ID":"20260505170804-69z1n3p","Type":"NodeParagraph","Properties":{"id":"20260505170804-69z1n3p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"切换完全在用户态完成，不涉及内核，没有系统调用、上下文切换开销，比线程切换轻量得多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程的堆栈很小，一般只有几 KB，创建和销毁成本极低，可以轻松创建大量协程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在单线程内调度，同一时刻只运行一个协程，不需要加锁，不存在竞态条件，避免了锁竞争带来的性能损耗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程是协作式调度，由程序自己控制切换时机，减少了无效切换，CPU 利用率更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以整体上，协程在高并发场景下比线程更高效、更快"}]},{"ID":"20260505170804-c4po55g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c4po55g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"fork 与 system 调用的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-9f7b6s6","Type":"NodeParagraph","Properties":{"id":"20260505170804-9f7b6s6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"fork:创建一个新的子进程，该子进程是调用进程的副本。子进程继承了父进程的地址空间、文件描述符等资源，但拥有独立的进程 ID。适用于多进程编程，需要手动管理进程间的通信和同步。"}]},{"ID":"20260505170804-2pjykvb","Type":"NodeParagraph","Properties":{"id":"20260505170804-2pjykvb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"system：执行一个命令字符串，system 调用会创建一个子进程来运行指定的命令，父进程等待子进程完成。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适用于需要在程序中执行外部命令或脚本的场景，简化了执行外部命令的过程"}]},{"ID":"20260505170804-fes7q38","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fes7q38","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"用户级线程和内核级线程的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-8ffnbro","Type":"NodeParagraph","Properties":{"id":"20260505170804-8ffnbro","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用户级线程通常由线程库管理，不需要内核参与，上下文切换在用户空间完成速度快、开销小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由于内核只认进程，在进行 I/O 操作时整个进程会被阻塞，并且用户级线程无法利用多核处理器优势"}]},{"ID":"20260505170804-hqzfxo4","Type":"NodeParagraph","Properties":{"id":"20260505170804-hqzfxo4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核级线程需要通过系统调用进行，上下文切换需要从用户态切换到内核态，速度较慢，开销较大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统调用尽管开销较大，但可以利用操作系统的各种功能，如进程调度和 I/O 操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核能识别和管理每个线程，可以充分利用多核处理器的优势"}]},{"ID":"20260505170804-y93wfht","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-y93wfht","updated":"20260521124529"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程间通信方式适用场景/区别？"}]},{"ID":"20260505170804-iklw34o","Type":"NodeParagraph","Properties":{"id":"20260505170804-iklw34o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"管道分为匿名管道和命名管道，匿名管道只适用于父子进程间通信，简单轻量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命名管道可以跨无关进程，像文件一样使用，适合简单的单向数据传递"}]},{"ID":"20260505170804-iquonff","Type":"NodeParagraph","Properties":{"id":"20260505170804-iquonff","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"消息队列是内核维护的消息链表，支持按类型读取，异步通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比管道更灵活，但不适合大数据量传输"}]},{"ID":"20260505170804-etjmrjd","Type":"NodeParagraph","Properties":{"id":"20260505170804-etjmrjd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"共享内存是效率最高的方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接让多个进程访问同一块内存，数据不用来回拷贝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合高频、大数据量交互，但必须配合信号量做同步互斥，否则会出现数据混乱"}]},{"ID":"20260505170804-wjs14sf","Type":"NodeParagraph","Properties":{"id":"20260505170804-wjs14sf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"信号量主要不是用来传数据，而是做进程间的同步与互斥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保护临界资源，常和共享内存搭配使用"}]},{"ID":"20260505170804-uq0lk6z","Type":"NodeParagraph","Properties":{"id":"20260505170804-uq0lk6z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Socket 可以跨主机、跨网络通信，既支持本地也支持远端，适用范围最广"}]},{"ID":"20260505170804-m2nszxc","Type":"NodeParagraph","Properties":{"id":"20260505170804-m2nszxc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"匿名管道：父子进程、临时少量传数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命名管道：本机无关进程、简单单向通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"消息队列：异步结构化短消息、按类型收发  消息内核持久存储"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享内存：大数据、高吞吐、追求极致性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号量：只做同步互斥、保护临界资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Socket：本机 + 跨网络、通用所有场景"}]},{"ID":"20260521124529-8x0p35t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124529-8x0p35t","updated":"20260521101506"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"windows 进程间通信"}]},{"ID":"20260521124529-5hoekro","Type":"NodeParagraph","Properties":{"id":"20260521124529-5hoekro","updated":"20260521115807"},"Children":[{"Type":"NodeText","Data":"剪贴板、窗口消息，轻量简易传数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"匿名管道、命名管道，本地跨进程高效通信"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"邮槽，单向广播消息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享内存，速度最快，需同步互斥"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Socket，跨机器通用"}]},{"ID":"20260517204532-d48mmq9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260517204532-d48mmq9","updated":"20260517204457"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号量可以跨进程使用吗"}]},{"ID":"20260517204532-opy69mg","Type":"NodeParagraph","Properties":{"id":"20260517204532-opy69mg","updated":"20260517204510"},"Children":[{"Type":"NodeText","Data":"可以"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统通常既支持线程内使用的同步原语，也支持 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进程间共享的信号量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跨进程使用时，本质上是内核维护这个同步对象，多个进程共同操作它"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"共享内存负责数据共享，信号量负责访问同步"}]},{"ID":"20260511230811-hqbbi9l","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511230811-hqbbi9l","updated":"20260511171838"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你了解 DBus 通信吗？"}]},{"ID":"20260511230811-o59zofq","Type":"NodeParagraph","Properties":{"id":"20260511230811-o59zofq","updated":"20260511230003"},"Children":[{"Type":"NodeText","Data":"DBus 是 Linux/Unix 桌面环境里很常见的一种 进程间通信方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上就是给不同进程之间传消息、调方法、收事件用的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多桌面组件、系统服务、应用程序之间的协作，底层都会走 DBus"}]},{"ID":"20260511230811-v7huse3","Type":"NodeParagraph","Properties":{"id":"20260511230811-v7huse3","updated":"20260511230736"},"Children":[{"Type":"NodeText","Data":"它的模型可以理解成\"总线 + 消息\""},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程把自己提供的服务挂到总线上，别的进程可以通过总线去调用它的方法、传参数、订阅信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常见会分成 session bus 和 system bus：前者偏当前用户会话里的应用通信，后者偏系统级服务通信"}]},{"ID":"20260507223415-lvykmun","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507223415-lvykmun","updated":"20260513145408"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你了解安卓的进程间通信吗？"}]},{"ID":"20260507223415-lfy2hzz","Type":"NodeParagraph","Properties":{"id":"20260507223415-lfy2hzz","updated":"20260507223320"},"Children":[{"Type":"NodeText","Data":"核心底层是 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Binder 机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安卓基于 Linux，每个应用都是独立进程，有各自独立虚拟内存"}]},{"ID":"20260507223415-s4npqdj","Type":"NodeParagraph","Properties":{"id":"20260507223415-s4npqdj","updated":"20260507223331"},"Children":[{"Type":"NodeText","Data":"常用 IPC 方式有这几种："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AIDL、Messenger、Intent、ContentProvider、Socket、共享内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其中 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Binder/AIDL"},{"Type":"NodeText","Data":" 是官方主力，基于内存映射，只一次数据拷贝，性能最好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自带 UID 权限校验、安全性高，适合跨进程接口调用、系统服务通信"}]},{"ID":"20260507223415-c831bk6","Type":"NodeParagraph","Properties":{"id":"20260507223415-c831bk6","updated":"20260507223344"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Messenger"},{"Type":"NodeText","Data":" 是封装好的轻量 Binder，串行消息处理，用法简单，适合简单点对点消息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Intent"},{"Type":"NodeText","Data":" 适合跳转组件、传少量轻数据，有 1MB 大小限制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ContentProvider"},{"Type":"NodeText","Data":" 专门做跨应用数据共享，自带权限和数据封装"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大数据场景用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"共享内存"},{"Type":"NodeText","Data":"零拷贝，网络或跨设备就用 Socket"}]},{"ID":"20260507223415-fq1wf31","Type":"NodeParagraph","Properties":{"id":"20260507223415-fq1wf31","updated":"20260513145408"},"Children":[{"Type":"NodeText","Data":"Binder 整体是 C/S 架构，靠 Binder 驱动、ServiceManager 做服务注册和发现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 Parcel 序列化数据，开发上常用 AIDL 定义接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自动生成代理和存根类，像调本地方法一样跨进程通信"}]},{"ID":"20260505170804-r5e3fv5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-r5e3fv5","updated":"20260507211313"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"mmap 了解吗？"}]},{"ID":"20260505170804-wkfbamf","Type":"NodeParagraph","Properties":{"id":"20260505170804-wkfbamf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"mmap 就是把磁盘文件或者物理内存，直接映射到进程的虚拟地址空间"}]},{"ID":"20260505170804-5zleobb","Type":"NodeParagraph","Properties":{"id":"20260505170804-5zleobb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不用 read、write 系统调用，进程直接通过指针就能读写数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"省去用户态到内核态的数据拷贝，效率更高"}]},{"ID":"20260505170804-k0tntfj","Type":"NodeParagraph","Properties":{"id":"20260505170804-k0tntfj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它分文件映射和匿名映射两种"}]},{"ID":"20260505170804-gd8fmuf","Type":"NodeParagraph","Properties":{"id":"20260505170804-gd8fmuf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"文件映射"},{"Type":"NodeText","Data":"绑定磁盘文件，修改内存内容会自动同步回文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"匿名映射"},{"Type":"NodeText","Data":"没有对应文件，专门用来申请大块堆外内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"glibc malloc 分配大内存底层就用匿名 mmap"}]},{"ID":"20260505170804-gpn3b43","Type":"NodeParagraph","Properties":{"id":"20260505170804-gpn3b43","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"mmap 采用懒加载机制，刚映射只占虚拟地址，不会立马分配物理内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"触发缺页中断时才真正加载物理页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多进程映射同一个文件还能实现内存共享，可用于进程间通信"}]},{"ID":"20260505170804-5qdvw46","Type":"NodeParagraph","Properties":{"id":"20260505170804-5qdvw46","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和 brk 相比，brk 只能从堆尾部扩展收缩，中间空闲内存没法还给内核"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 mmap 申请的内存，调用 munmap 就能直接归还操作系统，不会造成外部内存碎片"}]},{"ID":"20260507211313-nwxbybg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260507211313-nwxbybg","updated":"20260507165025"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"请讲一下你对锁的了解"}]},{"ID":"20260507211313-f2ch6x9","Type":"NodeParagraph","Properties":{"id":"20260507211313-f2ch6x9","updated":"20260507211156"},"Children":[{"Type":"NodeText","Data":"首先，锁的本质，就是多线程竞争共享资源时，用来保证同一时间只有一个线程能访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止数据错乱，保证线程安全"}]},{"ID":"20260507211313-b7hag29","Type":"NodeParagraph","Properties":{"id":"20260507211313-b7hag29","updated":"20260507211158"},"Children":[{"Type":"NodeText","Data":"其次，锁分两大类：悲观锁和乐观锁"}]},{"ID":"20260507211313-2l788no","Type":"NodeParagraph","Properties":{"id":"20260507211313-2l788no","updated":"20260507211209"},"Children":[{"Type":"NodeText","Data":"悲观锁默认别人一定会抢资源，一进来就加锁堵着，别人必须排队等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如互斥锁、自旋锁都是这类，适合竞争激烈的场景"}]},{"ID":"20260507211313-r6rgbgh","Type":"NodeParagraph","Properties":{"id":"20260507211313-r6rgbgh","updated":"20260507211220"},"Children":[{"Type":"NodeText","Data":"乐观锁默认没人争抢，不上锁，先正常操作，提交时校验有没有被别人改过，没改就成功"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"改了就重试，比如原子变量、版本号机制，适合竞争少的场景，性能更高"}]},{"ID":"20260507211313-h9vuy0e","Type":"NodeParagraph","Properties":{"id":"20260507211313-h9vuy0e","updated":"20260507211238"},"Children":[{"Type":"NodeText","Data":"然后从实现和形态上说，有互斥锁、自旋锁、读写锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"互斥锁拿不到就休眠让出 CPU，适合加锁时间长"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自旋锁拿不到就原地循环忙等，不放弃 CPU，适合锁定时间极短"}]},{"ID":"20260507211313-nyjhy20","Type":"NodeParagraph","Properties":{"id":"20260507211313-nyjhy20","updated":"20260507211247"},"Children":[{"Type":"NodeText","Data":"读写锁是读共享、写独占，多读少写场景能大幅提升并发效率"}]},{"ID":"20260507211313-x00e75z","Type":"NodeParagraph","Properties":{"id":"20260507211313-x00e75z","updated":"20260507211259"},"Children":[{"Type":"NodeText","Data":"另外锁还有几个核心问题：死锁、饥饿、锁竞争、粒度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程互相持有对方需要的锁就会死锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有的线程一直抢不到锁会饥饿"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"锁粒度太大并发低，太小又容易出 bug"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开发中要尽量减小锁范围、按固定顺序加锁，避免死锁和性能瓶颈"}]},{"ID":"20260505170804-ps3c8zp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ps3c8zp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"只有一个锁会发生死锁吗"}]},{"ID":"20260505170804-fhf5b4x","Type":"NodeParagraph","Properties":{"id":"20260505170804-fhf5b4x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"正常多线程抢同一把锁，不会死锁，形不成循环等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但同一个线程对同一把非递归锁重复加锁，自己等自己，单把锁也会死锁"}]},{"ID":"20260505170804-46packr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-46packr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么判断死锁"}]},{"ID":"20260505170804-xls53w7","Type":"NodeParagraph","Properties":{"id":"20260505170804-xls53w7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一，满足四个必要条件："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"互斥访问、请求并持有资源、资源不可抢占、线程循环等待，四个同时满足就会产生死锁。"}]},{"ID":"20260505170804-fupq5cp","Type":"NodeParagraph","Properties":{"id":"20260505170804-fupq5cp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二，现场排查："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序卡死无业务推进、CPU 占用低、线程互相阻塞等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再通过线程堆栈查看，出现循环等待锁的依赖环，就能判定是死锁"}]},{"ID":"20260505170804-kf0k2om","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kf0k2om","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么解决死锁，每个条件找个例子"}]},{"ID":"20260505170804-l6ysheb","Type":"NodeParagraph","Properties":{"id":"20260505170804-l6ysheb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"破坏互斥条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要破坏它，就要让资源可以共享使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如只读文件，多个进程可以同时访问，不用互斥，自然不会因为抢文件产生死锁"}]},{"ID":"20260505170804-thqb8pn","Type":"NodeParagraph","Properties":{"id":"20260505170804-thqb8pn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"破坏请求与保持条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"请求并保持就是进程拿着已有的资源，又去申请新资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方法是进程运行前一次性申请所有需要的资源，要么全分配，要么一个都不分配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如进程要同时用打印机和扫描仪，就一次性申请两者，拿到再运行，不拿着一个等另一个"}]},{"ID":"20260505170804-1jjjs1c","Type":"NodeParagraph","Properties":{"id":"20260505170804-1jjjs1c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"破坏不可剥夺条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不剥夺就是资源一旦分配就不能强行收回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"破坏它就是允许系统强行回收资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如进程 A 拿着资源 1，又申请资源 2 但拿不到，系统就把资源 1 从 A 手里剥夺，分给其他进程，避免卡死"}]},{"ID":"20260505170804-z1ompv5","Type":"NodeParagraph","Properties":{"id":"20260505170804-z1ompv5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"破坏环路等待条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"环路等待就是进程之间形成资源请求环路"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方法是给所有资源统一编号，按顺序申请"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如规定必须先申请打印机，再申请扫描仪，再申请 plotter，大家都按这个顺序来，就不会形成环路，也就不会死锁"}]},{"ID":"20260505170804-6megsm9","Type":"NodeParagraph","Properties":{"id":"20260505170804-6megsm9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"死锁避免：比如银行家算法，每次分配资源前先判断是否安全，不安全就不分配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"死锁检测与解除：允许死锁发生，系统定期检测，发现后通过撤销进程、抢占资源来解除"}]},{"ID":"20260505170804-38u81se","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-38u81se","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"程序什么时候单线程效率高？"}]},{"ID":"20260505170804-gvq5yry","Type":"NodeParagraph","Properties":{"id":"20260505170804-gvq5yry","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"顺序任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单线程避免了上下文切换和同步机制的开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"I/O 密集型应用，在这种情况下多线程可能不会带来明显的性能提升，因为瓶颈是 I/O 而不是 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单线程能更好的利用有限的内存资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非共享资源的操作，单线程可以避免多线程中资源锁定和同步"}]},{"ID":"20260505170804-k11c4il","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k11c4il","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程控制块的作用"}]},{"ID":"20260505170804-1ols73l","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ols73l","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260310163342294"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310163342294.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-v95zdmr","Type":"NodeParagraph","Properties":{"id":"20260505170804-v95zdmr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"PCB 中包含了 384 项进程信息，其中 pid 是进程 id 操作系统唯一的进程身份标识 ps aux"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进程控制块（PCB）就是操作系统用来描述、管理和找到一个进程的“身份证 + 档案”。"}]},{"ID":"20260505170804-vsuv6qq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vsuv6qq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Linux 文件标识符相关问题：父进程 fork 子进程后，子进程能否修改父进程的文件？"}]},{"ID":"20260505170804-p14djma","Type":"NodeParagraph","Properties":{"id":"20260505170804-p14djma","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260310164639541"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310164639541.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-wrb5yjo","Type":"NodeParagraph","Properties":{"id":"20260505170804-wrb5yjo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"父进程 fork 出子进程时，子进程会继承父进程的文件描述符，二者指向同一个打开文件表，共享文件偏移量，所以一方读写会影响另一方；若要独立操作，需重新打开文件或新建独立的文件表项。"}]},{"ID":"20260505170804-whng1jq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-whng1jq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存屏障\t\t\u003e\u003e"}]},{"ID":"20260505170804-oo5hqrb","Type":"NodeParagraph","Properties":{"id":"20260505170804-oo5hqrb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"用于控制 CPU 和编译器对内存操作顺序的一种机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确保特定的内存操作在程序执行的顺序上不会被重排序"}]},{"ID":"20260505170804-g2zgab9","Type":"NodeParagraph","Properties":{"id":"20260505170804-g2zgab9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"全局屏障：全局内存屏障确保在屏障前的所有内存操作在屏障后的内存操作之前完成。它会阻止所有类型的内存操作重排序。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读内存屏障：读内存屏障确保在屏障前的所有读操作在屏障后的读操作之前完成。它会阻止读操作被重排序。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写内存屏障：写内存屏障确保在屏障前的所有写操作在屏障后的写操作之前完成。它会阻止写操作被重排序。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"依赖性屏障：依赖关系的顺序不会被重排序。它保证依赖于先前操作的内存访问不会被重排序到先前操作之前。"}]},{"ID":"20260505170804-jv889ol","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jv889ol","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何实现操作系统中的原子操作？\t\t\u003e\u003e"}]},{"ID":"20260505170804-dssrjfe","Type":"NodeParagraph","Properties":{"id":"20260505170804-dssrjfe","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"硬件支持：大多数现代处理器提供特殊的原子指令，这些指令在单个指令周期内完成检查和修改值的操作，确保了操作的原子性。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统支持：操作系统通过禁用中断创建临界区，防止上下文切换，确保代码段在执行过程中不被中断。主要用于单处理器系统或控制特定硬件交互"}]},{"ID":"20260505170804-7yxrhdl","Type":"NodeParagraph","Properties":{"id":"20260505170804-7yxrhdl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"禁用中断可以屏蔽包括时钟中断在内的所有中断，让操作系统内核无法获得 CPU 控制权，从而不会触发进程 / 线程调度与上下文切换"}]},{"ID":"20260505170804-wq1mwi4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wq1mwi4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"原子操作不是单线程的吗"}]},{"ID":"20260505170804-1arc8wy","Type":"NodeParagraph","Properties":{"id":"20260505170804-1arc8wy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"原子操作不是单线程专属，它和单线程没有绑定关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单线程环境里也能使用原子操作，但完全没必要"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为单线程不存在线程竞争，普通读写就足够安全"}]},{"ID":"20260505170804-gkmpbkw","Type":"NodeParagraph","Properties":{"id":"20260505170804-gkmpbkw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"原子操作真正的作用，是解决多线程并发竞争问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它依托 CPU 硬件指令实现，执行过程不可被中断、不可分割"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要么完整执行成功，要么完全不执行"}]},{"ID":"20260505170804-0vsfmm3","Type":"NodeParagraph","Properties":{"id":"20260505170804-0vsfmm3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"相比于互斥锁，原子操作属于无锁并发，开销更小、性能更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般用来做简单计数、状态标记这类轻量的多线程共享变量操作"}]},{"ID":"20260505170804-kxczjyq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kxczjyq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"解释并发和并行的区别？\t\t\u003e\u003e"}]},{"ID":"20260505170804-hdzo231","Type":"NodeParagraph","Properties":{"id":"20260505170804-hdzo231","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"并发：多个任务在同一时间段内交替进行，任务切换提高响应性和资源利用率，可以在单核处理器上实现。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并行：多个任务在同一时刻同时进行，需要多核处理器或多个处理器，提高计算速度和处理能力，任务之间是真正的同时执行。"}]},{"ID":"20260505170804-wpq4jo7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wpq4jo7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么操作系统设计允许内存碎片的产生？\t\t\u003e\u003e"}]},{"ID":"20260505170804-845seds","Type":"NodeParagraph","Properties":{"id":"20260505170804-845seds","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"完全避免内存碎片会导致内存管理策略过于复杂，可能降低内存利用效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在一些应用场景下，适当的内存碎片是可以接受的，以换取内存管理的简单性和高效性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适当保留碎片，可换取内存分配的简单、高效与灵活"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像分页、分段这类机制虽会产生内部碎片，但能实现非连续分配、提升分配回收速度，只是内存紧凑会因移动数据带来性能损耗"}]},{"ID":"20260505170804-dog0t9k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dog0t9k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"逻辑地址怎么转物理地址的？\t\t\u003e\u003e"}]},{"ID":"20260505170804-3cqax7j","Type":"NodeParagraph","Properties":{"id":"20260505170804-3cqax7j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CPU 执行指令时会先给出逻辑地址，系统会先把它拆成页号和页内偏移"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一步先查 TLB 快表，页号命中的话直接拿到物理页框号，和页内偏移拼接就得到物理地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 TLB 未命中，再去查内存中的页表，找到对应物理页框，同时把这条记录写回 TLB 方便下次快速访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要是页表显示该页不在内存，就触发缺页中断，操作系统把页面从磁盘调入内存，更新页表和 TLB 后，重新完成地址转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个过程由 MMU 内存管理单元自动完成，对上层程序完全透明"}]},{"ID":"20260505170804-aupq1yg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-aupq1yg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"物理页面大小选择的依据是什么？为什么常选择 4KB 大小的页面？\t\t\u003e\u003e"}]},{"ID":"20260505170804-20n4ush","Type":"NodeParagraph","Properties":{"id":"20260505170804-20n4ush","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260310190959940"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310190959940.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-6bam7ma","Type":"NodeParagraph","Properties":{"id":"20260505170804-6bam7ma","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"依据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"物理页面大小的选择，核心是在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存碎片、页表管理开销、缺页异常频率、硬件支持"},{"Type":"NodeText","Data":"之间做权衡"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"页面越大，页表项越少、管理成本越低、缺页率更低，但内部碎片会增加"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"页面越小，碎片越少、内存利用率更高，但页表更大、缺页更频繁"}]},{"ID":"20260505170804-05c2pat","Type":"NodeParagraph","Properties":{"id":"20260505170804-05c2pat","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每个进程、每个模块至少要占用一整页，不管实际用多少，没用完的部分都会变成内部碎片，无法再分配给别人。页面越大，平均每一页浪费的空间就越多，所以整体内部碎片就更多"}]},{"ID":"20260505170804-uesoyjr","Type":"NodeParagraph","Properties":{"id":"20260505170804-uesoyjr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"选 4KB 的原因"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是因为它在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"碎片与页表开销"},{"Type":"NodeText","Data":"上达到了极佳的平衡，既不会因页面过大造成严重浪费，也不会因页面过小导致页表膨胀；同时它被 x86、ARM 等绝大多数硬件架构原生支持，Linux、Windows 等主流系统都以此为标准，兼容性、稳定性和性能最优，能适配绝大多数应用场景，是综合成本、效率与兼容性的最佳选择"}]},{"ID":"20260505170804-ycgzzkq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ycgzzkq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"虚拟内存的作用？\t使用虚拟内存的好处？\t\u003e\u003e"}]},{"ID":"20260505170804-ml423ak","Type":"NodeParagraph","Properties":{"id":"20260505170804-ml423ak","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚拟内存是操作系统给每个进程提供的一种逻辑地址空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让进程看到一段连续、独立的地址，而不是直接使用物理内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心作用是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"隔离进程地址空间、管理物理内存、扩大可用内存空间"}]},{"ID":"20260505170804-0acdnxj","Type":"NodeParagraph","Properties":{"id":"20260505170804-0acdnxj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"进程间地址隔离"},{"Type":"NodeText","Data":"，每个进程都有独立的虚拟地址空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个进程崩溃或非法访问不会直接影响其他进程，系统更稳定安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次，它可以让进程使用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"连续的逻辑地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而底层物理内存可以是离散不连续的，解决了内存碎片问题，也方便程序编译和加载"}]},{"ID":"20260505170804-m9q4o45","Type":"NodeParagraph","Properties":{"id":"20260505170804-m9q4o45","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"虚拟内存可以借助磁盘空间实现 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"swap 交换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把暂时不用的数据换到硬盘，让系统能运行比物理内存更大的程序、更多的进程，扩大了可用内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时操作系统还能通过虚拟内存实现"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存共享、写时复制"},{"Type":"NodeText","Data":"等机制，比如父子进程共享代码段、动态库共享，大幅提升内存使用效率"}]},{"ID":"20260505170804-b59wgqg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b59wgqg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存 swap 机制"}]},{"ID":"20260505170804-kqsab19","Type":"NodeParagraph","Properties":{"id":"20260505170804-kqsab19","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心原理是磁盘空间充当临时内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在物理内存资源紧张时，将暂时不常用的内存页面迁移到 Swap 分区或交换文件中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"释放物理内存给活跃进程使用，以此避免内存溢出、系统 OOM 崩溃"}]},{"ID":"20260505170804-osvzzf8","Type":"NodeParagraph","Properties":{"id":"20260505170804-osvzzf8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核会区分两种内存页面做差异化回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件缓存页可直接丢弃回收"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而进程栈、堆这类无文件映射的匿名页无法直接释放，必须借助 Swap 换出到磁盘"}]},{"ID":"20260505170804-ii6pivq","Type":"NodeParagraph","Properties":{"id":"20260505170804-ii6pivq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内核通过 LRU 冷热链表管理页面，由 kswapd 后台进程定时扫描内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当空闲内存低于阈值时，优先淘汰长时间未访问的冷页，完成换出操作"}]},{"ID":"20260505170804-l38phya","Type":"NodeParagraph","Properties":{"id":"20260505170804-l38phya","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当进程再次访问被换出的内存时，会触发缺页异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核再将 Swap 中的数据重新读回物理内存，完成换入"}]},{"ID":"20260505170804-p474kzh","Type":"NodeParagraph","Properties":{"id":"20260505170804-p474kzh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统可通过 swappiness 参数调节 Swap 使用倾向，该值越高，系统越积极使用交换分区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际生产环境中，由于磁盘读写速度远低于内存，频繁 Swap 会造成系统卡顿、性能暴跌"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此服务器通常调低 swappiness，尽量限制 Swap 使用，从根源保障服务稳定性"}]},{"ID":"20260505170804-wyx2c00","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wyx2c00","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么尽量避免磁盘 io 缓存"}]},{"ID":"20260505170804-1daao2j","Type":"NodeParagraph","Properties":{"id":"20260505170804-1daao2j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"想要避免系统的磁盘 IO 缓存，核心就是绕过操作系统自带的页缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常规文件读写都会走内存缓存，占用内存还由系统自动管理，通过直接 IO 就能跳过这一层"}]},{"ID":"20260505170804-fir93ks","Type":"NodeParagraph","Properties":{"id":"20260505170804-fir93ks","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Linux 打开文件时添加 O_DIRECT 标识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读写数据就不会进入系统缓存，直接和磁盘交互，彻底避开内核缓存机制"}]},{"ID":"20260505170804-hi5s7ho","Type":"NodeParagraph","Properties":{"id":"20260505170804-hi5s7ho","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这么做主要是为了节省内存，防止系统缓存占用过多资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时避免应用缓存和系统缓存重复存储，也能让程序自己控制磁盘读写，IO 行为更可控"}]},{"ID":"20260505170804-w17sr30","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w17sr30","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲一讲虚拟内存空间"}]},{"ID":"20260505170804-ky8c1q6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ky8c1q6","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"0xFFFFFFFF  ──────────────\n│     内核空间（1GB）      │ （进程不能直接访问）\n0xC0000000  ──────────────\n│        栈 stack         │ ↓ 向下增长（函数调用、局部变量）\n│                         │\n│      内存映射区 mmap     │ （动态库、文件映射、共享内存）\n│                         │\n│        堆 heap          │ ↑ 向上增长（new/malloc）\n│                         │\n│      BSS 段（未初始化）   │ 全局/静态变量，默认0\n│      DATA 段（已初始化）  │ 全局/静态变量（有初值）\n│      TEXT 段（代码）     │ 程序指令，只读可执行\n0x08048000  ──────────────\n│     保留区（空指针）      │ 访问即段错误\n0x00000000  ──────────────\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-68bqd6l","Type":"NodeParagraph","Properties":{"id":"20260505170804-68bqd6l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C++ 里的虚拟内存，是操作系统为每个进程分配的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"独立逻辑地址空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"依靠 MMU 做虚拟地址到物理内存的映射"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个进程地址相互隔离，互不干扰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还能借助磁盘 swap 扩容内存、做内存权限管控，提升系统安全和资源利用率"}]},{"ID":"20260505170804-un9b2rf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-un9b2rf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"程序从堆中动态分配内存时，虚拟内存上如何操作的？"}]},{"ID":"20260505170804-1qflcw0","Type":"NodeParagraph","Properties":{"id":"20260505170804-1qflcw0","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260310191839007"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310191839007.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-ha4rj7s","Type":"NodeParagraph","Properties":{"id":"20260505170804-ha4rj7s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用动态内存分配函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理内存请求，可能会调用系统调用 brk、mmap 等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果需要，操作系统为进程分配新的物理内存页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更新页表映射新的虚拟内存到物理内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"返回指向分配内存的指针"}]},{"ID":"20260505170804-a5qm80k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-a5qm80k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"分页有什么好处？为什么需要分页？\t\t\u003e\u003e"}]},{"ID":"20260505170804-jeuyhup","Type":"NodeParagraph","Properties":{"id":"20260505170804-jeuyhup","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"将内存划为固定大小的页和页框简化了内存的分配和回收，把内存分成固定大小的页和页框后，所有内存块都一样大，分配时只要找到任意空闲页框即可，不用考虑大小匹配、拼接、查找合适块；回收时也不用合并相邻块，直接标记为空闲就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个进程拥有独立的页表，确保了地址空间的隔离，提高了系统的稳定性和安全性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分页支持页面级的权限控制防止进程非法访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现虚拟内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少外部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分页支持按需加载和交换优化内存使用"}]},{"ID":"20260505170804-kqss6id","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kqss6id","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"分页查询的优化\t\t\u003e\u003e"}]},{"ID":"20260505170804-jrlzaqz","Type":"NodeParagraph","Properties":{"id":"20260505170804-jrlzaqz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先避免使用大偏移量的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"limit offset, size"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 offset 越大，MySQL 需要扫描并丢弃的数据越多，性能越差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以改用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主键定位分页"},{"Type":"NodeText","Data":"，比如用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"where id \u0026gt; 上一页最后id limit 20"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接从指定位置开始查，效率高很多"}]},{"ID":"20260505170804-bmgkn0i","Type":"NodeParagraph","Properties":{"id":"20260505170804-bmgkn0i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次要合理建立索引，尤其是查询条件和排序字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量让排序和过滤都走索引，避免回表和文件排序"}]},{"ID":"20260505170804-4orm7t3","Type":"NodeParagraph","Properties":{"id":"20260505170804-4orm7t3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外可以减少查询字段，只查需要的列，避免 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"select *"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据量特别大时，还可以用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分表分库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者做缓存，把热点页数据缓存起来，减轻数据库压力"}]},{"ID":"20260505170804-k4nylxn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k4nylxn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"分段分页，分页内部碎片、分段外部碎片怎么解决\t\t\u003e\u003e"}]},{"ID":"20260505170804-efinkui","Type":"NodeParagraph","Properties":{"id":"20260505170804-efinkui","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分页的内部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内部碎片基本没法彻底消除，只能想办法减小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用做法就是选一个合适的页大小，页越小，浪费的空间就越少，但页表会变大，系统开销也会变高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像多级页表、哈希页表这些，主要是优化页表占用的空间，并不能直接解决碎片问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再配合虚拟内存、按需调页，只把要用的页面装进内存，也能间接缓解一下浪费"}]},{"ID":"20260505170804-762efw1","Type":"NodeParagraph","Properties":{"id":"20260505170804-762efw1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分段的外部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"外部碎片的核心问题就是空闲空间太零散，不连续，所以思路就是把它们凑成整块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一种办法是内存紧凑，挪动已在运行的程序段，把小空闲块拼成一大块，能彻底解决碎片，但代价很大，要重定位地址、改段表，还得暂停进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二种最常用也最好用，就是段页式管理，先按逻辑分段，再在段里面分页，这样既没有外部碎片，只会有一点点内部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三种是伙伴系统，按 2 的倍数大小分配内存，释放的时候把相邻空闲块合并，能减少外部碎片，但还是会有点内部碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四种是靠虚拟内存和置换算法，不要求物理地址连续，只要逻辑上连续就行，从根本上避开必须连续分配的问题"}]},{"ID":"20260505170804-yejyoae","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yejyoae","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"伙伴系统\t\t\u003e\u003e"}]},{"ID":"20260505170804-ryzjxfg","Type":"NodeParagraph","Properties":{"id":"20260505170804-ryzjxfg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"分页管理中，物理内存是被分成固定大小的页框，比如 4KB 一页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"伙伴系统就是专门用来管理这种固定大小、以 2 的幂次为单位的物理页的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会把连续的物理页帧按 2 ⁿ 大小分组，比如 1 页、2 页、4 页、8 页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当内核需要分配连续的几页物理内存时，就从对应大小的链表里取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"释放时再和相邻的空闲块合并"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以正是因为分页是固定大小，伙伴系统这种按 2 的幂次管理连续页的算法才特别合适"}]},{"ID":"20260505170804-uler1x4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uler1x4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"程序的内存布局是怎么样的？"}]},{"ID":"20260505170804-zx05d92","Type":"NodeParagraph","Properties":{"id":"20260505170804-zx05d92","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260404204429530"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260404204429530.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-jy1f598","Type":"NodeParagraph","Properties":{"id":"20260505170804-jy1f598","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代码段，包括二进制可执行代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据段，包括已初始化的静态常量和全局变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"BSS 段，包括未初始化的静态变量和全局变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"堆段，包括动态分配的内存，从低地址开始向上增长"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件映射段，包括动态库、共享内存等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈段，包括局部变量和函数调用的上下文等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈的大小是固定的，一般是 8 MB \t当然系统也提供了参数，以便我们自定义大小"}]},{"ID":"20260505170804-q48rhug","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-q48rhug","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"操作系统内存不足的时候会发生什么？"}]},{"ID":"20260505170804-eod7qfn","Type":"NodeParagraph","Properties":{"id":"20260505170804-eod7qfn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统内存不足时，会先通过缺页中断尝试分配物理内存，不够就启动回收，最后靠 OOM 兜底："}]},{"ID":"20260505170804-1g1lm8x","Type":"NodeParagraph","Properties":{"id":"20260505170804-1g1lm8x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，进程申请动态内存时，内核先给虚拟内存，读写时触发缺页中断，内核会建虚拟与物理内存的映射，物理内存不够就开始回收"}]},{"ID":"20260505170804-1i73bxy","Type":"NodeParagraph","Properties":{"id":"20260505170804-1i73bxy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"回收分两种："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后台内存回收是 kswapd 线程异步做的，不影响进程运行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接内存回收是同步的，会卡住进程，只有后台回收跟不上时才会触发"}]},{"ID":"20260505170804-jhwo4n8","Type":"NodeParagraph","Properties":{"id":"20260505170804-jhwo4n8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"要是直接回收后内存还不够，就会触发 OOM 机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"OOM Killer 会选占内存多的进程杀掉，释放内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一直杀到有足够可用内存为止，这是系统最后的内存保障机制"}]},{"ID":"20260505170804-n0j2psn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-n0j2psn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"现代操作系统一般用那种存储方式？哪种页面置换算法？"}]},{"ID":"20260505170804-7xlg3x3","Type":"NodeParagraph","Properties":{"id":"20260505170804-7xlg3x3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主流用虚拟存储、分页存储管理，采用请求分页式存储"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是：离散分页 + 虚拟内存 + 按需调页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不一次性把程序全装进内存，缺页才调入，节省内存、支持多进程并发"}]},{"ID":"20260505170804-bgx1iud","Type":"NodeParagraph","Properties":{"id":"20260505170804-bgx1iud","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不用纯 LRU、不用 FIFO"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"统一用改进时钟算法（二次机会 Clock 算法），是 LRU 的高效近似，硬件开销小、性能好"}]},{"ID":"20260505170804-6fnk2ux","Type":"NodeParagraph","Properties":{"id":"20260505170804-6fnk2ux","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux：分区 LRU + 冷热页链表，本质改良 Clock"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Windows：工作集 + 改进 Clock"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安卓 /macOS：都是二阶时钟置换算法"}]},{"ID":"20260505170804-u9bxk7v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-u9bxk7v","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"页面置换算法"}]},{"ID":"20260505170804-tnimede","Type":"NodeParagraph","Properties":{"id":"20260505170804-tnimede","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260310194723023"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310194723023.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-byxuslu","Type":"NodeTable","Data":"|select|特性|poll|epoll（Linux 2.6+）|\n| ---------------------------------------| ----| ------------------------------------| -------------------------------------------|\n|位图（fd_set）|\u003cspan data-type=\"strong\"\u003e底层实现\u003c/span\u003e|数组（pollfd 结构体）|红黑树 + 就绪链表（内核态）|\n|有上限（默认 1024，受 FD_SETSIZE 限制）|\u003cspan data-type=\"strong\"\u003e文件描述符（fd）限制\u003c/span\u003e|无上限（数组动态扩展）|无上限（红黑树管理）|\n|轮询所有 fd（用户态），效率低|\u003cspan data-type=\"strong\"\u003e遍历方式\u003c/span\u003e|轮询所有 fd（用户态），效率低|只遍历就绪 fd（内核态就绪链表），效率高|\n|仅水平触发（LT）|\u003cspan data-type=\"strong\"\u003e触发方式\u003c/span\u003e|仅水平触发（LT）|水平触发（LT）+ 边缘触发（ET）|\n|每次调用拷贝整个 fd 集合到内核态|\u003cspan data-type=\"strong\"\u003e内存拷贝\u003c/span\u003e|每次调用拷贝整个 pollfd 数组到内核态|仅初始化时拷贝，后续通过共享内存 / 指针访问|\n|短连接、fd 数量少（\u003c1000）|\u003cspan data-type=\"strong\"\u003e适用场景\u003c/span\u003e|短连接、fd 数量中等（1000-10000）|长连接、fd 数量多（\u003e10000，如高并发服务端）|\n|客户端（CKernal）低并发场景|\u003cspan data-type=\"strong\"\u003e你的项目适配\u003c/span\u003e|中小型服务端（TcpKernel）|高并发视频服务端（TcpKernel）|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-byxuslu","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"select"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"特性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"poll"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"epoll（Linux 2.6+）"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"位图（fd_set）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"底层实现"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数组（pollfd 结构体）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"红黑树 + 就绪链表（内核态）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"有上限（默认 1024，受 FD_SETSIZE 限制）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"文件描述符（fd）限制"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无上限（数组动态扩展）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无上限（红黑树管理）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"轮询所有 fd（用户态），效率低"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"遍历方式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"轮询所有 fd（用户态），效率低"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只遍历就绪 fd（内核态就绪链表），效率高"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仅水平触发（LT）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发方式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仅水平触发（LT）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"水平触发（LT）+ 边缘触发（ET）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"每次调用拷贝整个 fd 集合到内核态"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存拷贝"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"每次调用拷贝整个 pollfd 数组到内核态"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仅初始化时拷贝，后续通过共享内存 / 指针访问"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"短连接、fd 数量少（\u003c1000）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"适用场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"短连接、fd 数量中等（1000-10000）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"长连接、fd 数量多（\u003e10000，如高并发服务端）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"客户端（CKernal）低并发场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"你的项目适配"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"中小型服务端（TcpKernel）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高并发视频服务端（TcpKernel）"}]}]}]},{"ID":"20260505170804-thankkd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-thankkd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"LRU Cache 及应用场景\t\t\u003e\u003e"}]},{"ID":"20260505170804-hoakxia","Type":"NodeParagraph","Properties":{"id":"20260505170804-hoakxia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最近最少使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"应用场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统：虚拟内存页面置换算法，减少缺页中断"}]},{"ID":"20260505170804-b8yrfys","Type":"NodeParagraph","Properties":{"id":"20260505170804-b8yrfys","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 缓存：内存淘汰策略：volatile-lru / allkeys-lru"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"volatile-lru：只在设置了过期时间的 key 里，淘汰最近最少使用的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"allkeys-lru：不管有没有过期时间，所有 key 一起按 LRU 淘汰"}]},{"ID":"20260505170804-l0po5r2","Type":"NodeParagraph","Properties":{"id":"20260505170804-l0po5r2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL InnoDB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Buffer Pool 缓冲池管理数据页，用改进版 LRU 避免频繁换入换出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Buffer Pool 就是 InnoDB 在内存里开的一大块"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据缓存区"},{"Type":"NodeText","Data":"，用来少读磁盘、快查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MySQL Buffer Pool 不用普通 LRU，怕全表扫描把热点冲没"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"改成了冷热两段式 LRU："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新读的数据页先放冷区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在冷区待够时间、又被再次访问，才放进热区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"满了先删冷区尾部最久没用的"}]},{"ID":"20260505170804-vtuss0o","Type":"NodeParagraph","Properties":{"id":"20260505170804-vtuss0o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"浏览器 / APP 本地缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缓存图片、接口数据、历史记录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CDN、网关缓存、本地内存缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"高频热点数据缓存，自动清理冷数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统页面缓存、文件缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提高磁盘 I/O 效率"}]},{"ID":"20260505170804-odx4ml9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-odx4ml9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"LRU 优缺点"}]},{"ID":"20260505170804-v273n4n","Type":"NodeParagraph","Properties":{"id":"20260505170804-v273n4n","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心逻辑合理：最近最少使用淘汰，符合局部性原理，缓存命中率高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现简单、思路清晰，工程落地常用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"冷热数据区分明显，频繁访问的数据能长期留在缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"随机访问场景性能差，偶尔冷门数据也可能淘汰热点数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单纯 LRU 容易出现缓存污染：一次性大量冷数据涌入，挤掉热点缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统链表实现：读写都要移动节点，并发下锁竞争多、开销大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无法区分访问频次与访问时间，只看时间、不看热度"}]},{"ID":"20260505170804-w3s83n7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w3s83n7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Iru-2"}]},{"ID":"20260505170804-zp86b93","Type":"NodeParagraph","Properties":{"id":"20260505170804-zp86b93","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LRU-2 是 LRU-K 取 K=2"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心不只看最近一次访问，而是记录最近两次访问时间"}]},{"ID":"20260505170804-kjoxvi9","Type":"NodeParagraph","Properties":{"id":"20260505170804-kjoxvi9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"普通 LRU 容易被批量扫描的冷数据挤掉热数据，出现缓存污染"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"LRU-2 淘汰时不看最后一次，看倒数第二次访问时间，把倒数第二次最久没访问的优先删掉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只访问过一次的数据很难晋升，不会轻易占缓存，能抗全表扫描、保护热点数据"}]},{"ID":"20260505170804-l7cjgj9","Type":"NodeParagraph","Properties":{"id":"20260505170804-l7cjgj9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工程里常不用原生 LRU-2，多用它的简化版 2Q 队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现更简单、开销更低，效果接近 LRU-2"}]},{"ID":"20260505170804-mvrd939","Type":"NodeParagraph","Properties":{"id":"20260505170804-mvrd939","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"2Q 是 LRU-2 的工程简化版，用两个队列实现，不用记录时间戳，开销极低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分两个队列：A1 队列存首次访问的新数据，用 FIFO 规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Am 队列存多次访问的热数据，用 LRU 规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据第一次缓存命中，先进入 A1；再次访问，就晋升到 Am 热队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缓存满了优先淘汰 A1 里最老的数据，只来过一次的扫描数据直接被清掉，不会污染热缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"既能防批量扫描缓存污染，又比原生 LRU-2 实现简单、性能更好，业务里用得非常多"}]},{"ID":"20260505170804-h9wl5qq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-h9wl5qq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"5 种 IO 模型 + 同步 / 异步处理"}]},{"ID":"20260505170804-kitc7oz","Type":"NodeParagraph","Properties":{"id":"20260505170804-kitc7oz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll 的核心定位是：IO 模型层面属于「同步 IO（IO 多路复用）」，但能实现业务层面的「异步处理」"}]},{"ID":"20260505170804-h67izoa","Type":"NodeTable","Data":"|模型|核心特点（一句话记）|适用场景|\n| ----| ------------------------------------------| --------------------------------------|\n|\u003cspan data-type=\"strong\"\u003e1. 同步阻塞（BIO）\u003c/span\u003e|等 + 拷贝都阻塞，线程全程卡死|简单短连接、单机小流量|\n|\u003cspan data-type=\"strong\"\u003e2. 同步非阻塞（NIO）\u003c/span\u003e|等不阻塞（立即返回），拷贝阻塞；需循环轮询|单连接非阻塞、低并发|\n|\u003cspan data-type=\"strong\"\u003e3. IO 多路复用（epoll/select/poll）\u003c/span\u003e|等多连接不阻塞，拷贝阻塞；\u003cspan data-type=\"strong\"\u003eepoll 最高效\u003c/span\u003e|高并发长连接（Nginx/Redis）|\n|\u003cspan data-type=\"strong\"\u003e4. 信号驱动 IO\u003c/span\u003e|内核等就绪后发信号，拷贝阻塞|很少用，适合低频率 IO|\n|\u003cspan data-type=\"strong\"\u003e5. 异步 IO（AIO）\u003c/span\u003e|等 + 拷贝全由内核自动完成，全程不阻塞|极致高并发、大文件 / 流式（Linux aio）|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-h67izoa","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"核心特点（一句话记）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"适用场景"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1. 同步阻塞（BIO）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"等 + 拷贝都阻塞，线程全程卡死"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"简单短连接、单机小流量"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2. 同步非阻塞（NIO）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"等不阻塞（立即返回），拷贝阻塞；需循环轮询"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"单连接非阻塞、低并发"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3. IO 多路复用（epoll/select/poll）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"等多连接不阻塞，拷贝阻塞；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll 最高效"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高并发长连接（Nginx/Redis）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4. 信号驱动 IO"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内核等就绪后发信号，拷贝阻塞"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"很少用，适合低频率 IO"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5. 异步 IO（AIO）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"等 + 拷贝全由内核自动完成，全程不阻塞"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"极致高并发、大文件 / 流式（Linux aio）"}]}]}]},{"ID":"20260505170804-e20bwi3","Type":"NodeParagraph","Properties":{"id":"20260505170804-e20bwi3","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"阻塞 vs 非阻塞（看 “等” 的状态）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"阻塞：等数据时，线程啥也不干，死死盯着，直到数据来了再动（比如等快递，一直站在门口等，不做别的）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非阻塞：等数据时，线程不闲着，去做别的事，隔一会再来看数据有没有来（比如等快递，去看电视，隔 5 分钟看一眼快递到没）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"同步 vs 异步（看 “谁来干活”）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同步：事情自己做，做完再做下一件（比如自己做饭、自己洗碗，一步一步来）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"异步：事情交给别人做，做完再通知你（比如点外卖，让外卖员做，你去玩，做好了再通知你）。"}]},{"ID":"20260505170804-untao2v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-untao2v","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Reactor 反应堆模型的三大组件"}]},{"ID":"20260505170804-2jpgv77","Type":"NodeParagraph","Properties":{"id":"20260505170804-2jpgv77","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"反应堆（Reactor）模型是高并发网络编程的经典设计模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心思想是 “事件驱动、异步非阻塞”—— 把 IO 事件（可读 / 可写 / 异常）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"交给专门的模块监听，事件触发时自动分发到对应处理逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像 “反应堆” 一样，有事件就 “反应”，无事件就闲置，极致提升 IO 效率"}]},{"ID":"20260505170804-n4wo91h","Type":"NodeParagraph","Properties":{"id":"20260505170804-n4wo91h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心是事件驱动，三大组件按‘事件产生 - 监听 - 处理’分工："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"事件源："},{"Type":"NodeText","Data":"非阻塞的 socket，是 IO 事件的产生源头"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"事件多路分发器："},{"Type":"NodeText","Data":"用 epoll/select 监听多个事件源的就绪事件，是模型的‘监听核心’"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"事件处理器："},{"Type":"NodeText","Data":"绑定事件源，提供可读 / 可写 / 异常的回调逻辑，是事件的‘处理核心’"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个流程是‘注册事件 → 监听事件 → 分发事件 → 处理事件’"}]},{"ID":"20260505170804-0fqb5g6","Type":"NodeParagraph","Properties":{"id":"20260505170804-0fqb5g6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"epoll_wait"},{"Type":"NodeText","Data":" 是反应堆模型中 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"“事件多路分发器” 的核心实现"},{"Type":"NodeText","Data":" —— 反应堆模型是 “事件驱动” 的设计模式，而 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"epoll_wait"},{"Type":"NodeText","Data":" 就是这个模式里 “监听事件、获取就绪事件” 的核心操作，没有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"epoll_wait"},{"Type":"NodeText","Data":"，反应堆模型就失去了 “事件监听” 的核心能力。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll_wait 是反应堆模型 “阻塞等待” 的唯一入口："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反应堆模型是 “异步非阻塞” 的，但 epoll_wait 本身是阻塞调用 —— 这个 “阻塞” 是必要的（避免线程空转），但只阻塞在 “等事件” 这一步，而非阻塞在单个 socket 的 IO 操作上，这也是高并发的核心；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"epoll_wait 的触发模式决定反应堆的处理逻辑："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"LT 模式（默认）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll_wait 会反复返回未处理完的事件，反应堆处理器只需处理一次即可，逻辑简单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ET 模式（高效）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"epoll_wait 只返回一次 “事件从无到有” 的信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反应堆处理器必须循环处理完该 socket 的所有数据，避免残留"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"没有 epoll_wait，反应堆模型就成了 “盲轮询”："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若不用 epoll_wait，反应堆模型只能循环遍历所有 socket 问 “有没有数据”，CPU 会被空转耗光 ——epoll_wait 让反应堆模型实现了 “有事件才处理，无事件就闲置” 的高效特性。"}]},{"ID":"20260505170804-khairft","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-khairft","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"大型服务器，主从 react 模型"}]},{"ID":"20260505170804-c33jz37","Type":"NodeParagraph","Properties":{"id":"20260505170804-c33jz37","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主从 Reactor（Master-Slave Reactor）是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大型高并发服务器的标配 Reactor 模型"},{"Type":"NodeText","Data":"，核心是 “分工解耦”—— 主 Reactor 负责处理 “连接建立”（低频但关键），从 Reactor 负责处理 “读写 IO”（高频核心），利用多线程充分压榨 CPU，解决单 Reactor 的性能瓶颈。"}]},{"ID":"20260505170804-dg2wqp3","Type":"NodeTable","Data":"|组件|核心职责|对应实现（Linux）|\n| --------------------------| --------------------------------------------------------------------------------------------------------------------| ------------------------------------------|\n|主 Reactor（Master）|1. 监听监听 socket（listen_fd）的连接事件（EPOLLIN）；2. 接受新连接（accept）；3. 将新连接的 socket 分发给从 Reactor|epoll + 单线程（或少量线程）|\n|从 Reactor（Slave/Worker）|1. 监听主 Reactor 分配的连接 socket；2. 处理读写事件（recv/send）；3. 调用业务逻辑处理数据|多个 epoll + 多线程（线程数 ≈CPU 核心数）|\n|事件处理器|绑定具体 socket，提供连接 / 读 / 写 / 异常的回调逻辑|自定义回调（handle_accept/handle_read 等）|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-dg2wqp3","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"组件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"核心职责"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对应实现（Linux）"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"主 Reactor（Master）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"1. 监听监听 socket（listen_fd）的连接事件（EPOLLIN）；2. 接受新连接（accept）；3. 将新连接的 socket 分发给从 Reactor"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"epoll + 单线程（或少量线程）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"从 Reactor（Slave/Worker）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"1. 监听主 Reactor 分配的连接 socket；2. 处理读写事件（recv/send）；3. 调用业务逻辑处理数据"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多个 epoll + 多线程（线程数 ≈CPU 核心数）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"事件处理器"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"绑定具体 socket，提供连接 / 读 / 写 / 异常的回调逻辑"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"自定义回调（handle_accept/handle_read 等）"}]}]}]},{"ID":"20260505170804-03ocpca","Type":"NodeParagraph","Properties":{"id":"20260505170804-03ocpca","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大型服务器用主从 Reactor 模型，核心是分工解耦，解决单 Reactor 的性能瓶颈："}]},{"ID":"20260505170804-tnmvudw","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-tnmvudw","updated":"20260505170804"},"Children":[{"ID":"20260505170804-un6uy7q","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-un6uy7q","updated":"20260505170804"},"Children":[{"ID":"20260505170804-m1s1azk","Type":"NodeParagraph","Properties":{"id":"20260505170804-m1s1azk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主 Reactor：单线程监听连接事件，accept 新连接后，轮询分发给从 Reactor；"}]}]},{"ID":"20260505170804-jdfky9r","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-jdfky9r","updated":"20260505170804"},"Children":[{"ID":"20260505170804-lizluy0","Type":"NodeParagraph","Properties":{"id":"20260505170804-lizluy0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"从 Reactor：多线程（数等于 CPU 核心数），处理具体连接的读写 IO 和业务逻辑；"}]}]},{"ID":"20260505170804-idits9j","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-idits9j","updated":"20260505170804"},"Children":[{"ID":"20260505170804-ku2xf1b","Type":"NodeParagraph","Properties":{"id":"20260505170804-ku2xf1b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优势：充分利用多核，连接和 IO 解耦，新连接响应快，能支撑百万级并发，是 Netty、Nginx、Redis（高并发模式）的底层核心模型。”"}]}]}]},{"ID":"20260505170804-aymn12r","Type":"NodeTable","Data":"|组件|模型|线程 / 进程|I/O 模型|\n| -----| -----------------| --------------------------------------| --------------------|\n|MySQL|一线一程 + 线程池|多线程（阻塞）|阻塞 I/O，无多路复用|\n|Redis|单 Reactor 单线程|单线程（主）+ 多 I/O 线程（6.0+）|非阻塞 I/O + epoll|\n|Nginx|多 Reactor 多进程|Master (1) + Worker (N)，Worker 单线程|非阻塞 I/O + epoll|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-aymn12r","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"组件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"线程 / 进程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"I/O 模型"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"MySQL"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"一线一程 + 线程池"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多线程（阻塞）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"阻塞 I/O，无多路复用"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Redis"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"单 Reactor 单线程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"单线程（主）+ 多 I/O 线程（6.0+）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"非阻塞 I/O + epoll"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Nginx"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多 Reactor 多进程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Master (1) + Worker (N)，Worker 单线程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"非阻塞 I/O + epoll"}]}]}]},{"ID":"20260505170804-28fplsa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-28fplsa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"sendfile"}]},{"ID":"20260505170804-0pfpikh","Type":"NodeParagraph","Properties":{"id":"20260505170804-0pfpikh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"sendfile 是 Linux 下的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"零拷贝技术"},{"Type":"NodeText","Data":"，主要用来在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"文件数据直接发送到网络套接字"},{"Type":"NodeText","Data":"时，减少数据拷贝和上下文切换，提升传输效率。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统的文件传输，比如 read + write，需要先把数据从"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"磁盘读到内核缓冲区"},{"Type":"NodeText","Data":"，再复制到"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户缓冲区"},{"Type":"NodeText","Data":"，然后再复制到 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"socket 内核缓冲区"},{"Type":"NodeText","Data":"，最后发送出去。过程中会发生多次 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 拷贝"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户态 / 内核态切换"},{"Type":"NodeText","Data":"，开销很大。"}]},{"ID":"20260505170804-i5k697i","Type":"NodeParagraph","Properties":{"id":"20260505170804-i5k697i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而 sendfile 直接在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内核态"},{"Type":"NodeText","Data":"完成数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"从文件描述符到 socket 描述符的传递"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不需要拷贝到用户空间"},{"Type":"NodeText","Data":"，也减少了系统调用次数。真正做到了"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"零拷贝"},{"Type":"NodeText","Data":"，大大降低了 CPU 开销。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"sendfile 本质不是 “拷贝文件数据”，而是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在内核里传递 “数据的位置和长度信息”"},{"Type":"NodeText","Data":"，让硬件（DMA）直接从文件缓冲区拿数据到网卡，全程绕开用户态，也没有 CPU 参与数据拷贝。"}]},{"ID":"20260505170804-5dzf127","Type":"NodeParagraph","Properties":{"id":"20260505170804-5dzf127","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它特别适合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大量文件传输"},{"Type":"NodeText","Data":"的场景，比如静态资源服务器、网盘、下载服务。像 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Nginx、Tomcat、Netty"},{"Type":"NodeText","Data":" 这些高性能服务器，都会开启 sendfile 来优化文件传输性能。"}]},{"ID":"20260505170804-0cegro5","Type":"NodeParagraph","Properties":{"id":"20260505170804-0cegro5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一句话总结："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"sendfile 是内核级零拷贝，少拷贝、少切换、高吞吐，是高并发服务优化文件传输的关键技术。"}]},{"ID":"20260505170804-7jdck2a","Type":"NodeTable","Data":"|对比项|mmap|sendfile|\n| ------| -----------------------------------| ----------------------------|\n|\u003cspan data-type=\"strong\"\u003e全称\u003c/span\u003e|内存映射|发送文件|\n|\u003cspan data-type=\"strong\"\u003e核心作用\u003c/span\u003e|将文件映射到\u003cspan data-type=\"strong\"\u003e用户进程地址空间\u003c/span\u003e|在内核态将文件数据\u003cspan data-type=\"strong\"\u003e直接拷贝到 Socket\u003c/span\u003e|\n|\u003cspan data-type=\"strong\"\u003e拷贝次数\u003c/span\u003e|2 次（内核 → 用户，用户 →Socket）|\u003cspan data-type=\"strong\"\u003e零拷贝\u003c/span\u003e（仅 DMA 拷贝，无 CPU 拷贝）|\n|\u003cspan data-type=\"strong\"\u003e用户态访问\u003c/span\u003e|可以在\u003cspan data-type=\"strong\"\u003e用户态\u003c/span\u003e直接读写文件数据|数据不经过用户态，\u003cspan data-type=\"strong\"\u003e无法修改\u003c/span\u003e数据|\n|\u003cspan data-type=\"strong\"\u003e系统调用\u003c/span\u003e|mmap + write|sendfile（\u003cspan data-type=\"strong\"\u003e一次系统调用\u003c/span\u003e）|\n|\u003cspan data-type=\"strong\"\u003e适用场景\u003c/span\u003e|需\u003cspan data-type=\"strong\"\u003e随机读写\u003c/span\u003e、频繁操作小文件|大文件\u003cspan data-type=\"strong\"\u003e流式传输\u003c/span\u003e、文件下载|\n|\u003cspan data-type=\"strong\"\u003e代表应用\u003c/span\u003e|Redis、消息队列|Nginx、静态 Web 服务器|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-7jdck2a","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比项"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"mmap"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"sendfile"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全称"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内存映射"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"发送文件"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心作用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"将文件映射到"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户进程地址空间"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"在内核态将文件数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"直接拷贝到 Socket"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拷贝次数"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"2 次（内核 → 用户，用户 →Socket）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"零拷贝"},{"Type":"NodeText","Data":"（仅 DMA 拷贝，无 CPU 拷贝）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户态访问"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可以在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户态"},{"Type":"NodeText","Data":"直接读写文件数据"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据不经过用户态，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无法修改"},{"Type":"NodeText","Data":"数据"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统调用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"mmap + write"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"sendfile（"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一次系统调用"},{"Type":"NodeText","Data":"）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"适用场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"需"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"随机读写"},{"Type":"NodeText","Data":"、频繁操作小文件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大文件"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"流式传输"},{"Type":"NodeText","Data":"、文件下载"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代表应用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Redis、消息队列"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Nginx、静态 Web 服务器"}]}]}]},{"ID":"20260505170804-ku5mu3b","Type":"NodeParagraph","Properties":{"id":"20260505170804-ku5mu3b","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"read+write"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"4 次拷贝"},{"Type":"NodeText","Data":"（2 次 CPU + 2 次 DMA）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mmap+write"},{"Type":"NodeText","Data":"：3 次拷贝（1 次 CPU + 2 次 DMA）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sendfile"},{"Type":"NodeText","Data":"：2 次拷贝（0 次 CPU + 2 次 DMA）"}]},{"ID":"20260505170804-i55tjgd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-i55tjgd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"三者拷贝对比"}]},{"ID":"20260505170804-p3o0z6s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-p3o0z6s","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程池的创建有哪些注意事项"}]},{"ID":"20260505170804-ta6rd53","Type":"NodeParagraph","Properties":{"id":"20260505170804-ta6rd53","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"“线程池创建的核心是适配业务、保证安全、避免浪费，关键注意事项有 6 点："}]},{"ID":"20260505170804-rirputq","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-rirputq","updated":"20260505170804"},"Children":[{"ID":"20260505170804-13tc2el","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-13tc2el","updated":"20260505170804"},"Children":[{"ID":"20260505170804-s7rp30l","Type":"NodeParagraph","Properties":{"id":"20260505170804-s7rp30l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程数：IO 密集型设为 CPU 核心数 ×2~4，CPU 密集型设为核心数 + 1，做成可配置项；"}]}]},{"ID":"20260505170804-vu018di","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-vu018di","updated":"20260505170804"},"Children":[{"ID":"20260505170804-tunwusp","Type":"NodeParagraph","Properties":{"id":"20260505170804-tunwusp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"任务队列：优先用有界队列，设置容量和队列满的降级策略；"}]}]},{"ID":"20260505170804-68zp6v6","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-68zp6v6","updated":"20260505170804"},"Children":[{"ID":"20260505170804-v3p6j3f","Type":"NodeParagraph","Properties":{"id":"20260505170804-v3p6j3f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程策略：区分核心线程（常驻）和临时线程（超时销毁），限制临时线程数；"}]}]},{"ID":"20260505170804-fg2wqjr","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-fg2wqjr","updated":"20260505170804"},"Children":[{"ID":"20260505170804-mc5hfwh","Type":"NodeParagraph","Properties":{"id":"20260505170804-mc5hfwh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程安全：任务队列加锁，用条件变量等待任务，优雅停止线程；"}]}]},{"ID":"20260505170804-mowgls3","Type":"NodeListItem","Data":"5.","ListData":{"Typ":1,"Tight":true,"Start":5,"Delimiter":46,"Padding":3,"Marker":"NS4=","Num":5},"Properties":{"id":"20260505170804-mowgls3","updated":"20260505170804"},"Children":[{"ID":"20260505170804-2jjyyla","Type":"NodeParagraph","Properties":{"id":"20260505170804-2jjyyla","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"异常处理：捕获任务执行异常，销毁时释放所有资源；"}]}]},{"ID":"20260505170804-zvaw14u","Type":"NodeListItem","Data":"6.","ListData":{"Typ":1,"Tight":true,"Start":6,"Delimiter":46,"Padding":3,"Marker":"Ni4=","Num":6},"Properties":{"id":"20260505170804-zvaw14u","updated":"20260505170804"},"Children":[{"ID":"20260505170804-qjkl7qo","Type":"NodeParagraph","Properties":{"id":"20260505170804-qjkl7qo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"监控扩展：统计核心指标，预留钩子函数便于排查问题。”"}]}]}]},{"ID":"20260505170804-wv6cww1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wv6cww1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"介绍线程池"}]},{"ID":"20260505170804-mb7ws7k","Type":"NodeParagraph","Properties":{"id":"20260505170804-mb7ws7k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程池是一种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"池化思想"},{"Type":"NodeText","Data":"的并发技术，通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"预先创建一批线程并统一管理"},{"Type":"NodeText","Data":"，避免频繁创建、销毁线程带来的巨大开销，从而提高系统响应速度和资源利用率。"}]},{"ID":"20260505170804-8zblzpt","Type":"NodeParagraph","Properties":{"id":"20260505170804-8zblzpt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"池化思想的核心是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"空间换时间、资源复用"},{"Type":"NodeText","Data":"：把线程这种昂贵的资源提前初始化、重复使用，而不是每次任务来都新建线程，用完就销毁，减少了线程创建、销毁、上下文切换的开销。"}]},{"ID":"20260505170804-6kconv5","Type":"NodeParagraph","Properties":{"id":"20260505170804-6kconv5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一个完整的线程池调度过程是：任务提交后，先判断"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心线程数是否已满"},{"Type":"NodeText","Data":"，没满就由核心线程执行；如果核心线程已满，任务进入"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"阻塞队列"},{"Type":"NodeText","Data":"排队；如果队列也满了，再判断是否达到"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最大线程数"},{"Type":"NodeText","Data":"，没满就创建临时非核心线程执行；如果最大线程数也满了，就执行"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"拒绝策略"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-nafliem","Type":"NodeParagraph","Properties":{"id":"20260505170804-nafliem","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程池的重点参数包括："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心线程数、最大线程数、空闲线程存活时间、阻塞队列、线程工厂、拒绝策略"},{"Type":"NodeText","Data":"。合理设置这些参数，可以根据 CPU 密集型或 IO 密集型业务，平衡并发能力与资源消耗。"}]},{"ID":"20260505170804-jyfxyjh","Type":"NodeParagraph","Properties":{"id":"20260505170804-jyfxyjh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用线程池的好处非常明显："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"降低资源消耗、提高响应速度、统一管理线程、避免无限创建线程导致系统崩溃"},{"Type":"NodeText","Data":"，是高并发、后端服务开发中必备的组件。"}]},{"ID":"20260505170804-hachsaq","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-hachsaq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么需要线程池？"}]},{"ID":"20260505170804-nmnll0h","Type":"NodeParagraph","Properties":{"id":"20260505170804-nmnll0h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"避免占用当前线程，在线程池"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异步"},{"Type":"NodeText","Data":"执行"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"耗时任务"}]},{"ID":"20260505170804-rmavest","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-rmavest","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"阐述一下线程池"}]},{"ID":"20260505170804-t822d8i","Type":"NodeParagraph","Properties":{"id":"20260505170804-t822d8i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.定义： 线程池是维持管理一定数量线程的池式结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.解决了什么问题：为了避免占用当前线程，把耗时任务放到线程池异步执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.阐述具体工作流程：生产者将耗时任务进行封装抽象成一个具体任务，丢到任务队列当中，然后由消费者线程池不断从任务队列中取出任务，并且去执行它，当任务队列为空的时候，消费者线程将会发生阻塞休眠"}]},{"ID":"20260505170804-gdgk0jc","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-gdgk0jc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"线程池线程数量如何选择"}]},{"ID":"20260505170804-vvn9utz","Type":"NodeParagraph","Properties":{"id":"20260505170804-vvn9utz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"跟耗时任务和耗时类型息息相关"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"耗时任务： cpu 密集型\tio 密集型(网络 io 磁盘 io) \t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"cpu 密集型从 cpu 核心数开始试探 +1，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"io 密集型通常用 2 倍的 cpu 核心数 +1 试探，看当前 io 类型适合多少\t(IO 操作不占 CPU)"}]},{"ID":"20260505170804-yisdeoa","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-yisdeoa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"生产者消费者模型"}]},{"ID":"20260505170804-0kf5ivb","Type":"NodeParagraph","Properties":{"id":"20260505170804-0kf5ivb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"生产者消费者模型是一种经典的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"并发协作模式"},{"Type":"NodeText","Data":"，生产者负责生产数据、任务，消费者负责处理数据、任务，两者通过一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓冲区"},{"Type":"NodeText","Data":"解耦，不直接通信。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心作用是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"削峰、解耦、异步"},{"Type":"NodeText","Data":"：生产者不需要等待消费者处理完，只需要把数据放入缓冲区即可继续生产；消费者也只管从缓冲区取任务执行，双方互不依赖、互不阻塞。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个模型能很好解决"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"忙闲不均"},{"Type":"NodeText","Data":"的问题，避免生产者速度过快把消费者压垮，也能在消费者空闲时自动处理积压任务，是实现高并发、流量控制、异步处理的基础思想。"}]},{"ID":"20260505170804-c7336qa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c7336qa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"怎么中断线程池？\t\t\u003e\u003e"}]},{"ID":"20260505170804-txhuj4r","Type":"NodeParagraph","Properties":{"id":"20260505170804-txhuj4r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"想要中断线程池，不能直接粗暴杀掉线程，那样很容易出问题，比如数据错乱、资源没释放、死锁等等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正确的做法是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把线程池里的关闭标志位设为 true，告诉所有线程准备退出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后通过条件变量把所有阻塞等着任务的线程都唤醒，让它们不要再等任务了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个工作线程自己会循环检查这个标志位，一旦发现要关闭，就跳出循环，正常结束自己"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后主线程再调用 join，等所有线程都跑完退出，整个线程池就安全关闭了"}]},{"ID":"20260505170804-576ste3","Type":"NodeParagraph","Properties":{"id":"20260505170804-576ste3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程池内部有一个循环，每次取任务前先判断关闭标志"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦标志为 true，线程就自动跳出循环、释放资源、正常退出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主线程只需要 join() 等待所有线程结束即可"}]},{"ID":"20260505170804-efsrbq6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-efsrbq6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果长时间没有任务的话，线程池怎么处理？\t\t\u003e\u003e"}]},{"ID":"20260505170804-1369s9h","Type":"NodeParagraph","Properties":{"id":"20260505170804-1369s9h","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果线程池长时间没有任务，核心线程会一直保持阻塞存活，不会退出，也不会占用 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它们会通过条件变量进入休眠等待状态，主动释放 CPU 资源，直到新任务到来时被唤醒，这样能避免频繁创建、销毁线程带来的开销，保证线程池的响应速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而对于非核心线程，通常会设置空闲超时时间，如果长时间没有任务可执行，就会自动退出，实现线程数量的动态收缩，节约系统资源"}]},{"ID":"20260505170804-4ftbsmo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4ftbsmo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"页式存储，段式存储"}]},{"ID":"20260505170804-ivawgv7","Type":"NodeParagraph","Properties":{"id":"20260505170804-ivawgv7","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页式存储管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"页式存储是把逻辑地址空间和物理内存都分成大小固定的页和页框，以页为单位进行分配。程序不一定连续存放，哪有空位就放哪，通过页表完成逻辑地址到物理地址的映射。优点是内存利用率高、没有外部碎片，方便离散分配；缺点是页不是逻辑完整单位，不利于共享和保护。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"段式存储管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"段式存储是按照程序的逻辑结构划分成段，比如代码段、数据段、栈段，每段长度不固定。每个段有独立的段号和段内地址，通过段表映射到物理内存。优点是符合程序逻辑、便于共享、便于保护；缺点是会产生外部碎片，内存利用率不如页式。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"段页式存储管理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"段页式结合了前两者的优点：先分段，再在段内分页。先按逻辑结构分段，再把每一段分成固定大小的页，内存以页为单位分配。它既有段式的逻辑清晰、方便共享保护的优点，又有页式内存利用率高、无外部碎片的优点，只是地址变换稍复杂，需要同时查段表和页表。"}]},{"ID":"20260505170804-dmymy9o","Type":"NodeTable","Data":"|对比项|页式存储|段式存储|段页式存储|\n| ----------| --------------------| ----------------------| ----------------------|\n|划分单位|按\u003cspan data-type=\"strong\"\u003e固定大小\u003c/span\u003e分页|按\u003cspan data-type=\"strong\"\u003e逻辑模块\u003c/span\u003e分段（长度不固定）|先\u003cspan data-type=\"strong\"\u003e分段\u003c/span\u003e，段内再\u003cspan data-type=\"strong\"\u003e分页\u003c/span\u003e|\n|地址结构|页号 + 页内偏移|段号 + 段内偏移|段号 + 页号 + 页内偏移|\n|碎片情况|有\u003cspan data-type=\"strong\"\u003e内部碎片\u003c/span\u003e，无外部碎片|有\u003cspan data-type=\"strong\"\u003e外部碎片\u003c/span\u003e，无内部碎片|只有\u003cspan data-type=\"strong\"\u003e内部碎片\u003c/span\u003e，无外部碎片|\n|内存利用率|高|较低|高|\n|共享与保护|不方便|方便|方便|\n|地址变换|查\u003cspan data-type=\"strong\"\u003e页表\u003c/span\u003e|查\u003cspan data-type=\"strong\"\u003e段表\u003c/span\u003e|先查\u003cspan data-type=\"strong\"\u003e段表\u003c/span\u003e，再查\u003cspan data-type=\"strong\"\u003e页表\u003c/span\u003e|\n|优点|利用率高、无外碎片|符合逻辑、便于共享保护|兼顾前两者优点|\n|缺点|不便共享、逻辑不清晰|有外碎片、分配复杂|结构复杂、开销稍大|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-dmymy9o","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比项"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"页式存储"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"段式存储"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"段页式存储"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"划分单位"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"固定大小"},{"Type":"NodeText","Data":"分页"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"逻辑模块"},{"Type":"NodeText","Data":"分段（长度不固定）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"先"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分段"},{"Type":"NodeText","Data":"，段内再"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分页"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址结构"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"页号 + 页内偏移"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"段号 + 段内偏移"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"段号 + 页号 + 页内偏移"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"碎片情况"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内部碎片"},{"Type":"NodeText","Data":"，无外部碎片"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外部碎片"},{"Type":"NodeText","Data":"，无内部碎片"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内部碎片"},{"Type":"NodeText","Data":"，无外部碎片"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内存利用率"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"较低"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"共享与保护"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不方便"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"方便"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"方便"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"地址变换"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"查"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页表"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"查"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"段表"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"先查"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"段表"},{"Type":"NodeText","Data":"，再查"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页表"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"优点"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"利用率高、无外碎片"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"符合逻辑、便于共享保护"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"兼顾前两者优点"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"缺点"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不便共享、逻辑不清晰"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"有外碎片、分配复杂"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"结构复杂、开销稍大"}]}]}]},{"ID":"20260505170804-6lr0e0p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6lr0e0p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MMU"}]},{"ID":"20260505170804-mskieio","Type":"NodeParagraph","Properties":{"id":"20260505170804-mskieio","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MMU 是 CPU 里的内存管理单元，专门做一件事：把虚拟地址转成物理地址"}]},{"ID":"20260505170804-drdokk6","Type":"NodeParagraph","Properties":{"id":"20260505170804-drdokk6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它帮进程做内存隔离，每个进程只能访问自己的地址空间，不会互相干扰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时还做权限校验，非法访问直接报错，保证系统安全"}]},{"ID":"20260505170804-303eu0y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-303eu0y","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"运行一个进程，他会在内存中进行分配，一些区块的名字都是什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-y8bd2kk","Type":"NodeParagraph","Properties":{"id":"20260505170804-y8bd2kk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"代码段存放程序的二进制指令，只读可执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据段存放已经初始化的全局变量和静态变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"BSS 段存放未初始化的全局变量和静态变量，会被自动清零"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"堆向高地址增长，由程序员动态申请释放，比如 malloc"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存映射段，用于加载动态库、文件映射等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈向低地址增长，存放局部变量、函数调用栈，系统自动管理"}]},{"ID":"20260505170804-7o5scva","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7o5scva","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程怎么同步访问共享资源内存管理"}]},{"ID":"20260505170804-o170g48","Type":"NodeParagraph","Properties":{"id":"20260505170804-o170g48","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内存管理通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页表和 MMU"},{"Type":"NodeText","Data":"，将同一块物理内存映射到多个进程虚拟地址空间，实现资源共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时依靠地址隔离、写时复制保障进程独立与内存安全"}]},{"ID":"20260505170804-lymxtzv","Type":"NodeParagraph","Properties":{"id":"20260505170804-lymxtzv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但共享内存本身没有互斥能力，多进程并发访问会产生竞态条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以要用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互斥锁、信号量"},{"Type":"NodeText","Data":"等同步机制，对访问共享资源的临界区做互斥控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保证同一时刻只有一个进程修改共享资源，实现安全有序访问"}]},{"ID":"20260505170804-8r9j3ra","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8r9j3ra","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"页面置换算法"}]},{"ID":"20260505173830-jhkp5tz","Type":"NodeParagraph","Properties":{"id":"20260505173830-jhkp5tz","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"页面置换算法，是当内存中没有空闲页面、需要调入新页面时用来选择淘汰哪个旧页面的策略，目的是尽量减少缺页中断次数"}]},{"ID":"20260505173830-kud816d","Type":"NodeParagraph","Properties":{"id":"20260505173830-kud816d","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"常用的有以下几种："}]},{"ID":"20260505173830-vr4mpq1","Type":"NodeParagraph","Properties":{"id":"20260505173830-vr4mpq1","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"最佳置换算法 OPT 选择未来最久以后才会使用的页面淘汰理论上缺页率最低，但实际无法实现，只能作为理论参考"}]},{"ID":"20260505173830-5nytgyv","Type":"NodeParagraph","Properties":{"id":"20260505173830-5nytgyv","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"先进先出 FIFO 按照页面进入内存的顺序，先进入的先淘汰实现简单，但可能出现 Belady 异常—— 分配的物理页越多，缺页率反而升高，效率不高"}]},{"ID":"20260505173830-7kg3x1l","Type":"NodeParagraph","Properties":{"id":"20260505173830-7kg3x1l","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"最近最少使用 LRU 选择最近最久没有使用的页面淘汰性能接近 OPT，实际中常用，一般用链表或时间戳实现"}]},{"ID":"20260505173830-ychcbzf","Type":"NodeParagraph","Properties":{"id":"20260505173830-ychcbzf","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"时钟算法 CLOCK 是 LRU 的近似实现，给每个页面加一个使用位循环扫描页面，遇到使用位为 0 就淘汰，为 1 就清零，实现简单、开销小是实际系统里很常用的算法"}]},{"ID":"20260505173830-lcj8xrk","Type":"NodeParagraph","Properties":{"id":"20260505173830-lcj8xrk","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"二次机会算法就是改良版 FIFO，给每页加访问位按 FIFO 顺序遍历，访问位为 1 就清零、给二次机会；遇到 0 直接淘汰兼顾简单和性能，开销很低"}]},{"ID":"20260505173830-49kaay7","Type":"NodeParagraph","Properties":{"id":"20260505173830-49kaay7","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"最不经常使用 LFU 淘汰访问次数最少的页面；次数相同再按时间淘汰贴合访问频率规律，缺点是历史旧页面容易赖在内存，产生缓存老化"}]},{"ID":"20260505173830-92a8zk7","Type":"NodeParagraph","Properties":{"id":"20260505173830-92a8zk7","updated":"20260505173830"},"Children":[{"Type":"NodeText","Data":"最近未使用 NRU 极简 LRU 近似，给页面设访问位、修改位，分四类页面按优先级从未访问未修改开始淘汰，不用记录时间，硬件配合就能实现，系统轻量常用"}]},{"ID":"20260505170804-kmwri28","Type":"NodeParagraph","Properties":{"id":"20260505170804-kmwri28","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"页面置换算法，是当内存中没有空闲页面、需要调入新页面时，用来选择淘汰哪个旧页面的策略，目的是尽量减少缺页中断次数。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用的有以下几种："}]},{"ID":"20260505170804-76ykdzr","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-76ykdzr","updated":"20260505170804"},"Children":[{"ID":"20260505170804-oz7f185","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-oz7f185","updated":"20260505170804"},"Children":[{"ID":"20260505170804-24ms8xd","Type":"NodeParagraph","Properties":{"id":"20260505170804-24ms8xd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最佳置换算法 OPT 选择未来最久以后才会使用的页面淘汰。理论上缺页率最低，但实际无法实现，只能作为理论参考。"}]}]},{"ID":"20260505170804-bazdxnd","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-bazdxnd","updated":"20260505170804"},"Children":[{"ID":"20260505170804-hauxzg7","Type":"NodeParagraph","Properties":{"id":"20260505170804-hauxzg7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先进先出 FIFO 按照页面进入内存的顺序，先进入的先淘汰。实现简单，但可能出现 Belady 异常—— 分配的物理页越多，缺页率反而升高，效率不高。"}]}]},{"ID":"20260505170804-d90zrsb","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-d90zrsb","updated":"20260505170804"},"Children":[{"ID":"20260505170804-a87im7d","Type":"NodeParagraph","Properties":{"id":"20260505170804-a87im7d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最近最少使用 LRU 选择最近最久没有使用的页面淘汰。性能接近 OPT，实际中常用，一般用链表或时间戳实现。"}]}]},{"ID":"20260505170804-h3uneei","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-h3uneei","updated":"20260505170804"},"Children":[{"ID":"20260505170804-77ht8vu","Type":"NodeParagraph","Properties":{"id":"20260505170804-77ht8vu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"时钟算法 CLOCK 是 LRU 的近似实现，给每个页面加一个使用位。循环扫描页面，遇到使用位为 0 就淘汰，为 1 就清零，实现简单、开销小，是实际系统里很常用的算法"}]}]}]},{"ID":"20260505170804-y9ekpnj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-y9ekpnj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"程序创建进程之后，申请虚拟内存会有相应的页表，你了解页表的数据结构吗？\t\t\u003e\u003e"}]},{"ID":"20260505170804-0madeym","Type":"NodeParagraph","Properties":{"id":"20260505170804-0madeym","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"页表用来实现虚拟地址到物理地址的映射"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"现代 Linux 普遍采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四级页表"},{"Type":"NodeText","Data":"结构，分别是 PGD、PUD、PMD、PTE"}]},{"ID":"20260505170804-l7150zx","Type":"NodeParagraph","Properties":{"id":"20260505170804-l7150zx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它会把虚拟地址按位切分成几段索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 从 CR3 寄存器找到顶级页目录，一层层往下查找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终通过 PTE 获取物理页号，再加上页内偏移得到完整物理地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"页表项里还记录了存在位、脏位、权限位等信息"}]},{"ID":"20260505170804-oyd2rud","Type":"NodeParagraph","Properties":{"id":"20260505170804-oyd2rud","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"相比于单级页表必须为整个地址空间分配大表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多级页表可以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"按需分配、只创建用到的各级页表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用为未使用的虚拟地址浪费内存，因此能大幅节省页表本身的内存开销"}]},{"ID":"20260505170804-b57iyks","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b57iyks","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"通过 swap 往磁盘进行去存储，那所有操作系统都是往磁盘去存放吗？\t\t\u003e\u003e"}]},{"ID":"20260505170804-ppp35wi","Type":"NodeParagraph","Properties":{"id":"20260505170804-ppp35wi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，Linux、Windows 这类传统桌面 / 服务器系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"都是把内存里暂时不用的数据换到磁盘分区或交换文件里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是常说的 swap 或虚拟内存，目的是缓解物理内存不足"}]},{"ID":"20260505170804-sdxs8nd","Type":"NodeParagraph","Properties":{"id":"20260505170804-sdxs8nd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后，像 Android、iOS 这类移动操作系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般不使用传统的 swap 分区，它们很少把内存数据交换到磁盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更多是直接杀掉后台进程来回收内存，因为手机闪存读写慢、寿命有限，频繁交换会卡顿还伤存储"}]},{"ID":"20260505170804-pz5zbju","Type":"NodeParagraph","Properties":{"id":"20260505170804-pz5zbju","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"还有一些嵌入式实时系统（RTOS）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"干脆就没有交换机制，全程只用物理内存，保证响应速度稳定可靠"}]},{"ID":"20260505170804-ydpvbwl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ydpvbwl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"递归锁"}]},{"ID":"20260505170804-8j1afnh","Type":"NodeParagraph","Properties":{"id":"20260505170804-8j1afnh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"递归锁也叫可重入锁，它是一种允许同一个线程多次获取同一把锁的互斥锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和普通互斥锁不同，同一个线程在已经持有锁的情况下，再次调用加锁操作不会被阻塞，也不会造成死锁"}]},{"ID":"20260505170804-knvt6rc","Type":"NodeParagraph","Properties":{"id":"20260505170804-knvt6rc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"递归锁内部会维护一个加锁计数器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程第一次加锁时，计数器置为 1 并成功持有锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后每重复加锁一次，计数器就加 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次解锁操作只会让计数器减 1，只有当计数器减到 0 时，锁才会真正被释放，其他线程才能竞争获取这把锁"}]},{"ID":"20260505170804-uxalkld","Type":"NodeParagraph","Properties":{"id":"20260505170804-uxalkld","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它主要用在递归函数、多层嵌套函数调用的场景中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个函数内部加锁，又调用了同样会对这把锁加锁的子函数，如果用普通锁就会直接死锁，而递归锁可以安全地处理这种重复加锁逻辑"}]},{"ID":"20260505170804-y1pygpu","Type":"NodeParagraph","Properties":{"id":"20260505170804-y1pygpu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不过递归锁也有明显缺点：它会隐藏代码中的锁误用问题，让加锁逻辑变得不清晰 |"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时必须严格保证加锁和解锁次数一一对应，否则会导致锁无法正常释放，进而引发程序死锁"}]},{"ID":"20260505170804-yghmka7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-yghmka7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"乐观锁，悲观锁"}]},{"ID":"20260505170804-cwzrju0","Type":"NodeParagraph","Properties":{"id":"20260505170804-cwzrju0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"悲观锁是一种保守的并发控制策略，它默认并发冲突一定会发生"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以在操作数据前会先加锁、再执行，期间其他线程必须阻塞等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它能保证数据强一致性，但在高并发下会带来大量阻塞和上下文切换，性能较差，适合写多读少、对数据一致性要求高的场景"}]},{"ID":"20260505170804-yhp5914","Type":"NodeParagraph","Properties":{"id":"20260505170804-yhp5914","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"乐观锁则是乐观的思路，它认为冲突大概率不会发生，所以不加锁，只在更新提交时做校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最常见的实现是版本号机制，更新时带上版本号，只有版本匹配才允许修改，否则视为冲突"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它无锁、无阻塞，高并发下性能更好，但冲突频繁时会频繁重试，适合读多写少的场景"}]},{"ID":"20260505170804-z25q9as","Type":"NodeParagraph","Properties":{"id":"20260505170804-z25q9as","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"追求强一致、写操作多就用悲观锁；追求高并发、读操作多就用乐观锁"}]},{"ID":"20260505170804-oy2cem5","Type":"NodeTable","Data":"|对比维度|悲观锁|乐观锁|\n| ----------| ----------------------------------------------| ------------------------------------|\n|核心思想|默认冲突一定会发生，先加锁再操作|默认冲突很少发生，不加锁，提交时校验|\n|加锁时机|操作前就加锁|全程无锁，更新时判断|\n|实现方式|数据库 for update、synchronized、ReentrantLock|版本号机制、CAS|\n|并发性能|高并发下阻塞多，性能差|无锁无阻塞，高并发性能好|\n|数据一致性|强一致性|最终一致性|\n|适用场景|写多读少、要求强一致（库存、支付）|读多写少、高并发（点赞、统计）|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-oy2cem5","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比维度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"悲观锁"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"乐观锁"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"核心思想"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"默认冲突一定会发生，先加锁再操作"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"默认冲突很少发生，不加锁，提交时校验"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"加锁时机"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"操作前就加锁"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"全程无锁，更新时判断"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"实现方式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据库 for update、synchronized、ReentrantLock"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"版本号机制、CAS"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"并发性能"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高并发下阻塞多，性能差"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无锁无阻塞，高并发性能好"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据一致性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"强一致性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"最终一致性"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"适用场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"写多读少、要求强一致（库存、支付）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"读多写少、高并发（点赞、统计）"}]}]}]},{"ID":"20260505170804-5js9xls","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5js9xls","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多人同时编辑同一个表格的冲突问题怎么解决？版本号怎么加？\t\t\u003e\u003e"}]},{"ID":"20260505170804-7u2kn78","Type":"NodeParagraph","Properties":{"id":"20260505170804-7u2kn78","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多人同时编辑表格出现冲突，主要用乐观锁 + 版本号来解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个人编辑时都带上当前版本号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提交时服务器对比版本：一致就保存并升级版本，不一致就说明别人已修改，提示冲突，让用户选择合并或覆盖"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"版本号就用全局自增数字就行，每次成功保存就 + 1"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同单元格修改可以自动合并，同一单元格冲突就高亮差异，让用户手动确认，既保证并发流畅，又不会丢数据"}]},{"ID":"20260505170804-rgpxggd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rgpxggd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"了解 atomic 吗"}]},{"ID":"20260505170804-84qev7a","Type":"NodeParagraph","Properties":{"id":"20260505170804-84qev7a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"std::atomic 是 C++11 引入的原子类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"专门解决多线程下共享变量的数据竞争问题"}]},{"ID":"20260505170804-soacjm4","Type":"NodeParagraph","Properties":{"id":"20260505170804-soacjm4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它能给变量"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"提供原子性、可见性、指令有序性三大保障"},{"Type":"NodeText","Data":"，不用加互斥锁就能实现线程安全"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开销比 mutex 小很多，属于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无锁并发的核心"}]},{"ID":"20260505170804-5puckha","Type":"NodeParagraph","Properties":{"id":"20260505170804-5puckha","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"普通变量的自增、赋值这类操作，在 CPU 里会拆成读、改、写三步"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程交替执行就会丢数据、结果错乱"}]},{"ID":"20260505170804-1t5qlfa","Type":"NodeParagraph","Properties":{"id":"20260505170804-1t5qlfa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"atomic 内部依托 CPU 硬件原子指令"},{"Type":"NodeText","Data":"，比如 x86 的 LOCK 前缀、ARM 的 LDREX/STREX，把整个操作做成不可拆分的整体，中间不会被其他线程打断"}]},{"ID":"20260505170804-xk70egt","Type":"NodeParagraph","Properties":{"id":"20260505170804-xk70egt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它支持整型、指针这类基础类型，常用接口有 load 读、store 写、fetch_add 自增"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有 CAS 机制的 compare_exchange"}]},{"ID":"20260505170804-ixkdps5","Type":"NodeParagraph","Properties":{"id":"20260505170804-ixkdps5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"默认是顺序一致内存序，也可以手动用 acquire、release、relaxed 放宽内存序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少 CPU 屏障开销，提升并发性能"}]},{"ID":"20260505170804-3lszohi","Type":"NodeParagraph","Properties":{"id":"20260505170804-3lszohi","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"atomic 只适合单个简单共享变量，比如计数器、状态标记，无阻塞、开销极低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 mutex 适合保护多变量、复杂临界区，会触发线程阻塞和上下文切换，成本更高"}]},{"ID":"20260505170804-ugb50pl","Type":"NodeParagraph","Properties":{"id":"20260505170804-ugb50pl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"atomic 只能保证单步操作原子，像判断再修改的复合逻辑，还是要用 CAS 循环或者加锁"}]},{"ID":"20260505170804-5dxdj98","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5dxdj98","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"CAS 机制\t\t\t\u003e\u003e"}]},{"ID":"20260505170804-8via9uu","Type":"NodeParagraph","Properties":{"id":"20260505170804-8via9uu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CAS 全称 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Compare And Swap，比较并交换"},{"Type":"NodeText","Data":"，是一种"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无锁、轻量级的原子操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也是实现乐观锁的核心机制"}]},{"ID":"20260505170804-vv46u07","Type":"NodeParagraph","Properties":{"id":"20260505170804-vv46u07","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它不需要加锁阻塞线程，而是直接通过 CPU 原子指令来保证操作的原子性"}]},{"ID":"20260505170804-9ptt5ja","Type":"NodeParagraph","Properties":{"id":"20260505170804-9ptt5ja","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工作时，CAS 会先记录当前内存值作为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"预期值"},{"Type":"NodeText","Data":"，在更新时先比较内存中的实际值是否和预期值一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果一致，就说明期间没有被其他线程修改，直接完成赋值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果不一致，说明发生了并发冲突，本次操作失败，通常会选择自旋重试"}]},{"ID":"20260505170804-jurlq1f","Type":"NodeParagraph","Properties":{"id":"20260505170804-jurlq1f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CAS 优点非常明显："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无锁、无阻塞、无线程上下文切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在并发冲突不高的场景下性能远优于悲观锁"}]},{"ID":"20260505170804-trxjthk","Type":"NodeParagraph","Properties":{"id":"20260505170804-trxjthk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但它也存在短板："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是会出现 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ABA 问题"},{"Type":"NodeText","Data":"，即值从 A 变成 B 再变回 A，CAS 无法感知，一般通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"版本号"},{"Type":"NodeText","Data":"来解决"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是冲突频繁时，自旋会持续占用 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三是它只能保证"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单个变量"},{"Type":"NodeText","Data":"的原子性，无法保证代码块的原子性"}]},{"ID":"20260505170804-ypmndwl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ypmndwl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"介绍 CAS 中的 ABA 问题及其解决方案？\t\t\u003e\u003e"}]},{"ID":"20260505170804-666r9th","Type":"NodeParagraph","Properties":{"id":"20260505170804-666r9th","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"线程 1 读取变量值为 A，在执行 CAS 操作前，线程 2 将变量先改为 B 再改回 A，线程 1 执行 CAS 时发现值仍为 A，误认为数据未被修改而成功更新，导致数据一致性问题；尽管此位置的值看起来未变，但其实它在此期间可能已经被改变过。"}]},{"ID":"20260505170804-jhk5agc","Type":"NodeParagraph","Properties":{"id":"20260505170804-jhk5agc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方案主要是为共享变量引入版本号（或时间戳），每次修改都更新版本号，CAS 时同时校验值和版本号，只要数据被改动过版本号就会改变，从而避免 ABA 问题"}]},{"ID":"20260505170804-ytzj49v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ytzj49v","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"无锁编程\t\t\u003e\u003e"}]},{"ID":"20260505170804-nmfh3ks","Type":"NodeParagraph","Properties":{"id":"20260505170804-nmfh3ks","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"无锁编程是指在多线程并发场景下，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不使用传统的互斥锁、信号量等阻塞式同步机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是通过 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CAS 原子操作、自旋、线程本地存储"},{"Type":"NodeText","Data":"等方式，实现线程安全的编程思想"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心思路是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"乐观并发"},{"Type":"NodeText","Data":"，认为冲突概率较低，尽量避免阻塞和线程上下文切换"}]},{"ID":"20260505170804-p53br2e","Type":"NodeParagraph","Properties":{"id":"20260505170804-p53br2e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"无锁编程的底层依赖 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 原子指令"},{"Type":"NodeText","Data":"，比如 CAS（比较并交换）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过硬件保证比较‑更新操作的原子性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"线程在遇到冲突时，不会进入阻塞状态，而是采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自旋"},{"Type":"NodeText","Data":"的方式不断重试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从而大幅提升高并发下的吞吐量和响应速度"}]},{"ID":"20260505170804-bo0rbaf","Type":"NodeParagraph","Properties":{"id":"20260505170804-bo0rbaf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"无锁的优点非常突出："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"避免锁竞争、死锁、线程切换开销"},{"Type":"NodeText","Data":"，高并发场景下性能远超传统加锁方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它也有明显缺点：实现复杂，容易出现 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ABA 问题"},{"Type":"NodeText","Data":"，且冲突激烈时自旋会加重 CPU 负担"}]},{"ID":"20260505170804-09j3axq","Type":"NodeParagraph","Properties":{"id":"20260505170804-09j3axq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单总结："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无锁编程是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高性能并发"},{"Type":"NodeText","Data":"的常用方案，基于 CAS 和自旋实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合读多写少、对性能要求极高的场景"}]},{"ID":"20260505170804-kglceww","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kglceww","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"类中变量初始化顺序和销毁顺序"}]},{"ID":"20260505170804-zpmsb8r","Type":"NodeParagraph","Properties":{"id":"20260505170804-zpmsb8r","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先父后子"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先静态后实例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先加载父类静态成员并完成初始化，再执行子类静态成员初始化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"静态内容只在类加载时执行一次"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后初始化父类普通成员变量，再调用父类构造方法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后依次初始化子类普通成员变量、执行子类构造方法，完成整体创建"}]},{"ID":"20260505170804-cvpqfbg","Type":"NodeParagraph","Properties":{"id":"20260505170804-cvpqfbg","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"销毁顺序和初始化完全相反"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对象回收时，会先执行子类的销毁逻辑、释放子类成员资源，再销毁子类成员变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后释放父类成员并执行父类析构逻辑"}]},{"ID":"20260505170804-auxeqlp","Type":"NodeParagraph","Properties":{"id":"20260505170804-auxeqlp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这样的顺序可以保证子类依赖父类资源时，创建时资源先就绪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"销毁时不会出现父类资源提前释放导致子类异常的问题，保证继承体系资源管理的安全性"}]},{"ID":"20260505170804-2jmgxvl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2jmgxvl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程调度算法"}]},{"ID":"20260505170804-z257v9b","Type":"NodeParagraph","Properties":{"id":"20260505170804-z257v9b","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先来先服务（FCFS）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非抢占式，按照进程到达顺序依次执行，简单但不利于短作业"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"容易出现长作业阻塞短作业的情况"}]},{"ID":"20260505170804-qm3rpbr","Type":"NodeParagraph","Properties":{"id":"20260505170804-qm3rpbr","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"短作业优先（SJF）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非抢占式，优先选择预计执行时间最短的进程，能减少平均等待时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但可能导致长作业饥饿，且无法预知执行时间"}]},{"ID":"20260505170804-rasc2bs","Type":"NodeParagraph","Properties":{"id":"20260505170804-rasc2bs","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"时间片轮转（RR）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抢占式，给每个进程分配固定时间片，时间片用完就切换到下一个进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"响应快、公平，适合分时系统和交互式场景"}]},{"ID":"20260505170804-pb92sp2","Type":"NodeParagraph","Properties":{"id":"20260505170804-pb92sp2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优先级调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可抢占可非抢占，根据进程优先级分配 CPU，高优先级先执行，可分为抢占式和非抢占式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要注意防止低优先级进程饥饿"}]},{"ID":"20260505170804-adk0fvo","Type":"NodeParagraph","Properties":{"id":"20260505170804-adk0fvo","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多级反馈队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也是抢占式，结合优先级和时间片，设置多个队列，优先级从高到低，时间片从小到大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新进程进入高级队列，用完时间片则降级，兼顾响应速度和吞吐量，是综合效果最好的算法"}]},{"ID":"20260505170804-d641yf7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d641yf7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"多级反馈队列"}]},{"ID":"20260505170804-mvqq4ub","Type":"NodeParagraph","Properties":{"id":"20260505170804-mvqq4ub","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多级反馈队列设置了多个优先级不同的就绪队列，优先级越高，时间片越短"}]},{"ID":"20260505170804-xhhcby5","Type":"NodeParagraph","Properties":{"id":"20260505170804-xhhcby5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"新进程默认进入最高优先级队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果用完时间片还在运行，就降级到低优先级队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果中途 IO 阻塞，唤醒后保持原高优先级"}]},{"ID":"20260505170804-dv8ja01","Type":"NodeParagraph","Properties":{"id":"20260505170804-dv8ja01","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它可以动态识别进程类型，IO 密集型响应快，CPU 密集型能充分利用 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用手动设置优先级，兼顾响应速度和吞吐量，是综合最优的进程调度算法"}]},{"ID":"20260505170804-o9lu753","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-o9lu753","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"死锁问题\t\t\u003e\u003e"}]},{"ID":"20260505170804-xf1jgkn","Type":"NodeParagraph","Properties":{"id":"20260505170804-xf1jgkn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"死锁是指"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多个进程或线程互相持有对方需要的资源，并且都不释放自己的资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"导致彼此无限等待、程序无法继续推进的状态"}]},{"ID":"20260505170804-n3pvg5f","Type":"NodeParagraph","Properties":{"id":"20260505170804-n3pvg5f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"产生死锁必须同时满足"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"四个必要条件"},{"Type":"NodeText","Data":"："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互斥条件"},{"Type":"NodeText","Data":"：资源同一时间只能被一个线程占用；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"请求并保持"},{"Type":"NodeText","Data":"：线程持有资源的同时，又去请求其他资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"(在请求资源时一口气把所需资源全部申请）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不可剥夺"},{"Type":"NodeText","Data":"：资源只能由持有线程主动释放，不能被强行抢占；(持有资源时，又去请求新的资源还无法被满足必须主动释放所有资源，也允许管理者剥夺资源)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"循环等待"},{"Type":"NodeText","Data":"：多个线程形成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"环路等待"},{"Type":"NodeText","Data":"，你等我、我等你（按固定顺序加锁、避免持有并等待）"}]},{"ID":"20260505170804-cbvu7cp","Type":"NodeParagraph","Properties":{"id":"20260505170804-cbvu7cp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这四个条件缺一不可，只要破坏任意一个，死锁就不会发生。"}]},{"ID":"20260505170804-5omth8y","Type":"NodeParagraph","Properties":{"id":"20260505170804-5omth8y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决死锁的思路主要有"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"预防、避免、检测与解除"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"预防是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"破坏四个必要条件之一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如按固定顺序加锁、避免持有并等待\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免是通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"银行家算法"},{"Type":"NodeText","Data":"动态检查资源分配，确保系统安全；检测与解除是允许死锁发生，定期检测后通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"终止线程、抢占资源"},{"Type":"NodeText","Data":"来恢复。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际开发中最常用的方案是："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"统一加锁顺序、设置超时时间、避免嵌套锁、按序申请资源"},{"Type":"NodeText","Data":"，从编码层面杜绝死锁"}]},{"ID":"20260505170804-jn7k4b9","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-jn7k4b9","updated":"20260505170804"}},{"ID":"20260505170804-0fe5gpa","Type":"NodeParagraph","Properties":{"id":"20260505170804-0fe5gpa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"假脱机就是 SPOOLing 技术，核心是用磁盘当中间缓冲区，把低速外设和 CPU 高速运算拆开，不让 CPU 等慢速设备。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像打印机这种很慢的外设，CPU 不用等它慢慢打印。先把要打印的数据快速写到磁盘的缓冲区里，CPU 立马去干别的任务；再由后台进程慢慢从缓冲区取数据，送给打印机慢慢输出。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相当于先缓存、再后台慢慢处理，把独占的低速设备变成共享式，提高 CPU 利用率和系统并发效率，这就是假脱机。"}]},{"ID":"20260505170804-oo2cyko","Type":"NodeParagraph","Properties":{"id":"20260505170804-oo2cyko","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"假脱机技术把独占设备转化为共享设备，让多个进程可以并发访问，不再需要互斥，因此破坏了死锁的互斥条件，用来破坏互斥条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"真正独占的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"物理设备"},{"Type":"NodeText","Data":"，全程只由系统后台进程串行使用"}]},{"ID":"20260505170804-vh41s4q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vh41s4q","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"volatile 关键字"}]},{"ID":"20260505170804-1uq07tm","Type":"NodeParagraph","Properties":{"id":"20260505170804-1uq07tm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"C 语言中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"volatile"},{"Type":"NodeText","Data":" 的核心目的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防止编译器对变量进行不合理的优化（如缓存到寄存器、指令重排），确保程序对该变量的读写操作严格按照代码逻辑执行，且每次都直接访问内存，能感知到外部因素（硬件、中断、其他线程）对变量的修改"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-hh9kfac","Type":"NodeParagraph","Properties":{"id":"20260505170804-hh9kfac","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"禁止编译器优化"},{"Type":"NodeText","Data":"：编译器不会把 volatile 变量缓存到寄存器中，每次读写都必须从内存中直接操作，这保证了变量的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存可见性"},{"Type":"NodeText","Data":"（和 Java volatile 这一点一致）；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"对指令重排的约束有限"},{"Type":"NodeText","Data":"：C 语言的 volatile "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"仅禁止编译器层面的指令重排"},{"Type":"NodeText","Data":"，但"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无法禁止 CPU 层面的指令重排"},{"Type":"NodeText","Data":"；而 Java 的 volatile 是通过内存屏障，同时禁止编译器 + CPU 层面的指令重排，这是两者核心区别；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无原子性保证"},{"Type":"NodeText","Data":"：和 Java 一样，C 的 volatile 也不保证复合操作（如 i++）的原子性，要保证原子性仍需借助锁、CPU 原子指令（如 CAS）或编译器内置原子操作（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"__sync_fetch_and_add"},{"Type":"NodeText","Data":"）。"}]},{"ID":"20260505170804-1ubo1j1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1ubo1j1","updated":"20260528221818"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"中断"}]},{"ID":"20260505170804-z2topsc","Type":"NodeParagraph","Properties":{"id":"20260505170804-z2topsc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断就是 CPU 暂停当前正在执行的任务，先去处理更紧急的其他事情，处理完再回来继续做原来的工作"}]},{"ID":"20260505170804-xa100bw","Type":"NodeParagraph","Properties":{"id":"20260505170804-xa100bw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它是操作系统的核心机制，让 CPU 不用一直轮询外设，能异步响应突发、紧急事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大幅提升了 CPU 的工作效率，也是系统能实现多任务、实时响应的基础"}]},{"ID":"20260505170804-rgfax3o","Type":"NodeParagraph","Properties":{"id":"20260505170804-rgfax3o","updated":"20260528221818"},"Children":[{"Type":"NodeText","Data":"中断主要分两大类：外部中断和内部中断"}]},{"ID":"20260505170804-ff897yj","Type":"NodeParagraph","Properties":{"id":"20260505170804-ff897yj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"外部中断来自 CPU 外部，也就是硬件产生的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"又分可屏蔽中断和不可屏蔽中断：可屏蔽中断来自硬盘、网卡这类普通外设，不影响系统运行，CPU 可以选择屏蔽"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不可屏蔽中断是电源掉电、硬件故障这类严重错误，不能屏蔽，必须立刻处理"}]},{"ID":"20260505170804-eawygwy","Type":"NodeParagraph","Properties":{"id":"20260505170804-eawygwy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"内部中断来自 CPU 内部，是程序执行时触发的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包括陷阱、故障、终止三类：陷阱是主动触发的，比如系统调用，处理完能回到原程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"故障是可修复的意外，比如缺页中断，修正后能重试指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"终止是致命错误，直接终止程序，无法恢复"}]},{"ID":"20260505170804-96k9w2x","Type":"NodeParagraph","Properties":{"id":"20260505170804-96k9w2x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断的执行流程分三步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先是发生中断，外设或软件发出中断信号，CPU 立刻暂停当前指令，保存好现场，也就是程序计数器、寄存器这些状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后是中断响应，CPU 通过中断向量表，找到对应中断处理程序的入口地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后是中断处理，执行对应的处理逻辑，完成后恢复现场，回到原来的任务继续执行"}]},{"ID":"20260505170804-h7av7pq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-h7av7pq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"cpu 和 gpu 的区别\t\t\u003e\u003e"}]},{"ID":"20260505170804-hhawdfd","Type":"NodeParagraph","Properties":{"id":"20260505170804-hhawdfd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"CPU 擅长复杂逻辑、串行任务、通用计算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心少但每个核算力强、缓存大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能处理各种复杂指令和分支判断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合做系统调度、业务逻辑"}]},{"ID":"20260505170804-kvu6zoq","Type":"NodeParagraph","Properties":{"id":"20260505170804-kvu6zoq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"GPU 擅长大量简单重复、高度并行的计算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心非常多，但单个核简单、缓存小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合同时处理成千上万相似任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如图像渲染、矩阵运算、深度学习训练"}]},{"ID":"20260505170804-6dwo08l","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6dwo08l","updated":"20260516141002"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"中断的底层"}]},{"ID":"20260505170804-y99lqz3","Type":"NodeParagraph","Properties":{"id":"20260505170804-y99lqz3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断是 CPU 硬件层面的异步抢占机制"}]},{"ID":"20260505170804-jpjquk3","Type":"NodeParagraph","Properties":{"id":"20260505170804-jpjquk3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"外设或 CPU 内部产生紧急事件时，会向 CPU 发送中断信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 会立即保存当前运行现场、暂停正在执行的代码，跳转执行中断服务程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理完成后恢复现场，继续执行原来被打断的程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它是操作系统 IO、时钟调度、外设响应的底层基础"}]},{"ID":"20260516141002-3rgxij0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516141002-3rgxij0","updated":"20260516085726"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲讲中断的流程"}]},{"ID":"20260516141002-bxodpd7","Type":"NodeParagraph","Properties":{"id":"20260516141002-bxodpd7","updated":"20260516140253"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外设先发出中断信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如网卡收到数据、键盘按键、定时器到时间了，这些设备会向中断控制器发中断请求"}]},{"ID":"20260516141002-bxtfrh5","Type":"NodeParagraph","Properties":{"id":"20260516141002-bxtfrh5","updated":"20260516140539"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中断控制器把请求交给 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 在执行完当前这条指令后，会判断是否响应这个中断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果当前中断没被屏蔽，而且优先级够高，就会进入中断处理流程"}]},{"ID":"20260516141002-tg8ivjt","Type":"NodeParagraph","Properties":{"id":"20260516141002-tg8ivjt","updated":"20260516140603"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"CPU 保存现场"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是把当前程序的执行状态先保存下来，比如程序计数器、寄存器这些，避免处理中断后回不来"}]},{"ID":"20260516141002-0itwda3","Type":"NodeParagraph","Properties":{"id":"20260516141002-0itwda3","updated":"20260516140806"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"根据中断向量表找到中断处理程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 会根据中断号，定位到对应的 ISR（同步副本集合）也就是中断服务程序，然后跳过去执行"}]},{"ID":"20260516141002-who9acx","Type":"NodeParagraph","Properties":{"id":"20260516141002-who9acx","updated":"20260516140838"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"执行中断处理程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这里一般只做快速、关键的事情，比如读设备状态、清中断标志、把数据放到缓冲区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复杂耗时的工作通常不会在上半部全做完，而是放到下半部、软中断或者工作队列里"}]},{"ID":"20260516141002-mzv3soy","Type":"NodeParagraph","Properties":{"id":"20260516141002-mzv3soy","updated":"20260516140936"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"恢复现场，返回原程序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中断处理完后，CPU 恢复之前保存的现场，继续执行被打断的程序"}]},{"ID":"20260505170804-0gitpf5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0gitpf5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"中断的分类"}]},{"ID":"20260505170804-wyim42e","Type":"NodeParagraph","Properties":{"id":"20260505170804-wyim42e","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外部中断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由网卡、硬盘、键盘等外部硬件外设触发，属于异步外部事件"}]},{"ID":"20260505170804-dqkjr8n","Type":"NodeParagraph","Properties":{"id":"20260505170804-dqkjr8n","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内部异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"| 是 CPU 执行指令自身出现错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如除零错误、缺页中断、非法指令、页故障等，属于同步内部错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时中断还有优先级，高优先级可以抢占低优先级中断"}]},{"ID":"20260505170804-4gqccfn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4gqccfn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"断言的底层"}]},{"ID":"20260505170804-jockgrf","Type":"NodeParagraph","Properties":{"id":"20260505170804-jockgrf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"断言是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"软件层面的调试校验机制"},{"Type":"NodeText","Data":"，底层是代码逻辑判断"}]},{"ID":"20260505170804-ypcurvo","Type":"NodeParagraph","Properties":{"id":"20260505170804-ypcurvo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"程序运行时会检查一个条件是否成立"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果条件为假，断言失败，会直接打印错误信息、终止当前程序运行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它完全运行在用户态 / 内核态软件逻辑里，不是硬件信号，也不是 CPU 硬件机制"}]},{"ID":"20260505170804-emdv7wq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-emdv7wq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"断言是中断吗"}]},{"ID":"20260505170804-ksie9gf","Type":"NodeParagraph","Properties":{"id":"20260505170804-ksie9gf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"断言绝对不是中断"}]},{"ID":"20260505170804-lklpcq7","Type":"NodeParagraph","Properties":{"id":"20260505170804-lklpcq7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断是 CPU 硬件异步事件，是硬件主动打断软件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"断言是软件主动检测错误、主动退出程序，是同步软件行为"}]},{"ID":"20260505170804-1k9vun3","Type":"NodeParagraph","Properties":{"id":"20260505170804-1k9vun3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断可以恢复现场继续运行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"断言失败一般直接程序崩溃终止，二者原理、层级、行为完全不同"}]},{"ID":"20260505170804-haj08yt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-haj08yt","updated":"20260506124453"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"中断和异常"}]},{"ID":"20260505170804-07h6pnw","Type":"NodeParagraph","Properties":{"id":"20260505170804-07h6pnw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"中断，是外部硬件主动向 CPU 发起的请求，属于异步事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如网卡收到数据、硬盘读写完成、键盘按键"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 正在运行别的程序时，硬件打断当前任务，优先处理硬件请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理完再回到原来程序继续执行"}]},{"ID":"20260505170804-psij1sg","Type":"NodeParagraph","Properties":{"id":"20260505170804-psij1sg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"异常，是 CPU 执行当前指令时内部发生的错误，属于同步事件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是程序自身问题导致的，比如除零运算、内存访问越界、指令非法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在执行这条指令的瞬间出错，CPU 立即停下当前指令进行处理"}]},{"ID":"20260505170804-l7a10e4","Type":"NodeParagraph","Properties":{"id":"20260505170804-l7a10e4","updated":"20260506124444"},"Children":[{"Type":"NodeText","Data":"简单总结区分："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中断来自外部硬件、异步发生"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"异常来自程序内部、同步发生，这是两者最核心的区别"}]},{"ID":"20260505170804-6m0gbg0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6m0gbg0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"windows CtrlC+V  数据传输时采用的是什么方法\t\t\u003e\u003e"}]},{"ID":"20260505170804-91c4fkk","Type":"NodeParagraph","Properties":{"id":"20260505170804-91c4fkk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Windows Ctrl+C/V 复制粘贴"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层是操作系统全局剪贴板 + 轻量级 IPC 进程间通信 Microsoft Learn"}]},{"ID":"20260505170804-jzjjzfl","Type":"NodeParagraph","Properties":{"id":"20260505170804-jzjjzfl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"剪贴板是系统内核管理、不属于任何进程的全局共享内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Ctrl+C 把当前进程数据写入这块共享内存，Ctrl+V 由目标进程从共享内存读取数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过窗口消息 WM_COPY/WM_PASTE 调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属于异步、松耦合、单向中转的进程间数据传输方式"}]},{"ID":"20260505170804-jefexhh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jefexhh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"信号的三大行为"}]},{"ID":"20260505170804-7rzt3ag","Type":"NodeParagraph","Properties":{"id":"20260505170804-7rzt3ag","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 信号是一种异步软件中断，进程收到信号后，内核只会执行下面三种固定处理方式"}]},{"ID":"20260505170804-7gj685m","Type":"NodeParagraph","Properties":{"id":"20260505170804-7gj685m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一种是忽略信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核直接丢弃该信号，进程完全无感知、不执行任何操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如我们经常忽略子进程退出信号 SIGCHLD，避免产生僵尸进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但 SIGKILL、SIGSTOP 这两个信号不能被忽略"}]},{"ID":"20260505170804-83lf0wp","Type":"NodeParagraph","Properties":{"id":"20260505170804-83lf0wp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二种是执行系统默认动作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核按照预设规则处理信号，大部分信号默认会直接终止进程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"部分会暂停进程、或者生成 core 转储文件用于调试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不做任何设置时，信号默认都是走这个逻辑"}]},{"ID":"20260505170804-fx6nvps","Type":"NodeParagraph","Properties":{"id":"20260505170804-fx6nvps","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三种是自定义捕获处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序员通过 signal、sigaction 注册自定义回调函数，收到信号后执行我们自己的代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"处理完成后进程可以继续正常运行，不会退出"}]},{"ID":"20260505170804-l02dmg8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-l02dmg8","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"在用 Linux 很卡的时候用什么来排查"}]},{"ID":"20260505170804-l1kup6v","Type":"NodeParagraph","Properties":{"id":"20260505170804-l1kup6v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 系统很卡的时候，先用 top 查看 CPU 使用率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"看 CPU 是否被打满、哪个进程占用高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再用 free 查看内存是否耗尽、是否频繁交换内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 iostat 查看磁盘 IO 是否拥堵"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 netstat/ss 查看网络带宽是否占满"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"总结排查顺序："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"top（CPU）→ free（内存）→ iostat（磁盘 IO）→ 网络"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统卡 90% 都是 CPU、内存、磁盘 IO 这三个问题"}]},{"ID":"20260505170804-tibtixm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-tibtixm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"非实时操作系统和实时操作系统的区别和选择，以及应用场景"}]},{"ID":"20260505170804-tn4tps5","Type":"NodeParagraph","Properties":{"id":"20260505170804-tn4tps5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"非实时系统调度以公平和吞吐量为主，响应时间不确定，延迟不可控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实时系统基于优先级抢占调度，响应时间确定、时延可控，能保障任务按时完成"}]},{"ID":"20260505170804-0cyjqjv","Type":"NodeParagraph","Properties":{"id":"20260505170804-0cyjqjv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"选型看业务时序要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通办公、手机、服务器这类对延时无硬性要求，用非实时系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工业控制、车载、医疗、嵌入式设备，有严格时间限制，必须用实时系统"}]},{"ID":"20260505170804-s4fgbz7","Type":"NodeParagraph","Properties":{"id":"20260505170804-s4fgbz7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"非实时代表是 Windows、普通 Linux，侧重日常交互与并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实时系统如 FreeRTOS、实时 Linux，多用于工控、物联网、自动驾驶等安全关键场景"}]},{"ID":"20260505170804-jqo2e9a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jqo2e9a","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内核同步机制有哪些?"}]},{"ID":"20260505170804-k5x0iaz","Type":"NodeParagraph","Properties":{"id":"20260505170804-k5x0iaz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 内核常用同步机制，用来解决并发数据竞争问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原子操作最轻量，保证单一变量操作不可分割，开销小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自旋锁靠忙等待获取锁，不休眠，适合短临界区、中断上下文使用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"互斥锁和信号量拿不到锁会休眠，节省 CPU，适合进程上下文、加锁时间久的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读写锁、读写信号量支持读共享、写互斥，优化读多写少的并发场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有完成量用于进程等待唤醒，RCU 实现高并发无锁读，内存屏障防止指令乱序"}]},{"ID":"20260505170804-o13rrv4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-o13rrv4","updated":"20260521124503"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果硬盘读取速度达到 5GB/s 了，能取代内存吗?"}]},{"ID":"20260505170804-jmd2c6z","Type":"NodeParagraph","Properties":{"id":"20260505170804-jmd2c6z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不能"}]},{"ID":"20260505170804-z1v54r1","Type":"NodeParagraph","Properties":{"id":"20260505170804-z1v54r1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一是延迟差了几百倍"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"硬盘看的是连续读写速度，内存强在随机访问、极低延迟"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"CPU 取数据是毫秒级、随机寻址，硬盘再快，寻址延迟也远高于内存，一跑程序就卡顿"}]},{"ID":"20260505170804-lm51sg3","Type":"NodeParagraph","Properties":{"id":"20260505170804-lm51sg3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二是读写寿命和机制不一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存可无限次随意读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"硬盘有擦写次数上限，要是当成内存那样频繁随机反复读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很快就会报废"}]},{"ID":"20260505170804-6uhcm35","Type":"NodeParagraph","Properties":{"id":"20260505170804-6uhcm35","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三是工作定位完全不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存是给 CPU 临时高速周转数据的，断电丢数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"硬盘是长期持久存数据的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪怕带宽追上，总线位宽、时序、掉电特性、控制器架构都跟不上 CPU 的实时调度需求"}]},{"ID":"20260521124503-6y11ckc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124503-6y11ckc","updated":"20260521113336"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲一下内存池"}]},{"ID":"20260521124503-7kl9xwa","Type":"NodeParagraph","Properties":{"id":"20260521124503-7kl9xwa","updated":"20260521112634"},"Children":[{"Type":"NodeText","Data":"内存池就是先预先申请一大块内存，自己在里面做分配和回收，而不是频繁向系统 new/delete"}]},{"ID":"20260521124503-x5nauvg","Type":"NodeParagraph","Properties":{"id":"20260521124503-x5nauvg","updated":"20260521112806"},"Children":[{"Type":"NodeText","Data":"它的核心好处是快、减少碎片、降低系统调用开销，特别适合频繁申请小对象的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如网络包、线程任务、连接对象"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通常做法是把大块内存切成固定大小的块，用空闲链表管理，分配时直接取一块，释放时再放回去"}]},{"ID":"20260521124503-nwd96mi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260521124503-nwd96mi","updated":"20260521113336"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"// 一个最小的固定大小内存池示例\nclass MemoryPool {\npublic:\n    MemoryPool(size_t blockSize, size_t blockCount) {\n        pool = malloc(blockSize * blockCount);\n        char* p = static_cast\u003cchar*\u003e(pool);\n\n        // 把大块内存切成很多小块，挂到空闲链表\n        for (size_t i = 0; i \u003c blockCount; ++i) {\n            freeList.push_back(p + i * blockSize);\n        }\n    }\n\n    void* alloc() {\n        if (freeList.empty()) return nullptr;\n        void* p = freeList.back();\n        freeList.pop_back();\n        return p; // 直接取现成块，不走系统 malloc\n    }\n\n    void release(void* p) {\n        freeList.push_back(p); // 释放时放回池子，后面继续复用\n    }\n\n    ~MemoryPool() { free(pool); }\n\nprivate:\n    void* pool{};\n    std::vector\u003cvoid*\u003e freeList;\n};\n\n这个例子里，pool 是一次性申请的大内存，alloc() 和 release() 只是回收复用，不反复找系统要内存\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260521124503-czi39jd","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124503-czi39jd","updated":"20260521114610"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存池如何精确找到合适的空闲块"}]},{"ID":"20260521124503-rkznf96","Type":"NodeParagraph","Properties":{"id":"20260521124503-rkznf96","updated":"20260521114537"},"Children":[{"Type":"NodeText","Data":"最常用是空闲链表分类管理，提前把内存块按固定大小规格划分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同尺寸空闲块挂同一条链表，申请时直接匹配对应链表，一秒找到合适块"}]},{"ID":"20260521124503-l2vutr2","Type":"NodeParagraph","Properties":{"id":"20260521124503-l2vutr2","updated":"20260521114547"},"Children":[{"Type":"NodeText","Data":"采用大小分级策略，划分多级内存池，小尺寸、中等尺寸、大尺寸分开存放"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按需快速定位层级，不用全局遍历查找"}]},{"ID":"20260521124503-pu1kpss","Type":"NodeParagraph","Properties":{"id":"20260521124503-pu1kpss","updated":"20260521114554"},"Children":[{"Type":"NodeText","Data":"用伙伴系统精准匹配，将内存按 2 的幂次划分块，向上逐级合并、向下拆分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能快速算出最贴合需求的空闲块，碎片少查找快"}]},{"ID":"20260521124503-5eg1kgs","Type":"NodeParagraph","Properties":{"id":"20260521124503-5eg1kgs","updated":"20260521114601"},"Children":[{"Type":"NodeText","Data":"也可搭配位图标记，用二进制位记录每块内存占用状态，通过位运算快速检索空闲位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查找效率极高，适合规整内存布局"}]},{"ID":"20260521124503-9jxqpw2","Type":"NodeParagraph","Properties":{"id":"20260521124503-9jxqpw2","updated":"20260521114610"},"Children":[{"Type":"NodeText","Data":"还能维护有序空闲块数组，按块大小排序，申请时二分查找"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"快速锁定刚好满足大小的空闲块，做到精准分配"}]},{"ID":"20260521124503-zs6uc95","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521124503-zs6uc95","updated":"20260521115138"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存池不够用了如何处理"}]},{"ID":"20260521124503-hyk07y5","Type":"NodeParagraph","Properties":{"id":"20260521124503-hyk07y5","updated":"20260521115138"},"Children":[{"Type":"NodeText","Data":"扩容扩容（最常用）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重新向操作系统申请更大连续内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把旧池数据拷贝到新大池"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"释放旧内存池"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：逻辑简单、无碎片；缺点：拷贝耗时"}]},{"ID":"20260521124503-jcladmj","Type":"NodeParagraph","Properties":{"id":"20260521124503-jcladmj","updated":"20260521115311"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"新建次级内存池"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用链表串联多块内存池"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分配时依次查找，无需数据拷贝"}]},{"ID":"20260521124503-mq1kqz3","Type":"NodeParagraph","Properties":{"id":"20260521124503-mq1kqz3","updated":"20260521115138"},"Children":[{"Type":"NodeText","Data":"主动收缩 + 释放冗余"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遍历内存池，回收长时间闲置大块内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把连续空闲内存归还 OS"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"压缩池空间腾出位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合：流量波动大场景"}]},{"ID":"20260521124503-uppf20a","Type":"NodeParagraph","Properties":{"id":"20260521124503-uppf20a","updated":"20260521115303"},"Children":[{"Type":"NodeText","Data":"降级走系统原生分配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存池耗尽时，放弃池分配，直接调用 malloc/brk 临时分配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"空闲后优先归还、不进池"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：兜底不崩溃；缺点：失去池性能优势"}]},{"ID":"20260505170804-rfbeqr6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-rfbeqr6","updated":"20260511224750"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"内存池如何减少 STL 容器碎片"}]},{"ID":"20260505170804-cuxifav","Type":"NodeParagraph","Properties":{"id":"20260505170804-cuxifav","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"预先分配大块内存，当 STL 容器申请内存时，从内存池中分配小块内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免频繁调用 new/delete 导致的堆碎片化"}]},{"ID":"20260511224750-77jaqsm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511224750-77jaqsm","updated":"20260511225410"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你用过 Windows 原生 API 吗？"}]},{"ID":"20260511224750-bbq3zii","Type":"NodeParagraph","Properties":{"id":"20260511224750-bbq3zii","updated":"20260511224630"},"Children":[{"Type":"NodeText","Data":"win32 中的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"socket"},{"Type":"NodeText","Data":"​"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"socket 对应的是 Winsock，头文件一般是 winsock2.h，链接库通常是 Ws2_32.lib"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，代码里用 socket、bind、listen、connect 这些接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上是在调用 Windows 提供的 Winsock 网络库"}]},{"ID":"20260511224750-j70z8wj","Type":"NodeParagraph","Properties":{"id":"20260511224750-j70z8wj","updated":"20260511224714"},"Children":[{"Type":"NodeText","Data":"Windows 原生 API，通常就是指 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Windows 操作系统官方直接提供的底层编程接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最常见的就是 Win32 API"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不是某个第三方库，而是系统本身暴露出来让程序去调用的能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来访问窗口、进程、线程、文件、内存、消息循环、同步对象这些系统资源"}]},{"ID":"20260511224750-yej8mga","Type":"NodeParagraph","Properties":{"id":"20260511224750-yej8mga","updated":"20260511224733"},"Children":[{"Type":"NodeText","Data":"比如你在 Windows 上创建窗口、收发窗口消息、创建互斥锁、启动线程、申请共享内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这些都可以直接通过原生 API 完成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像 CreateWindow、SendMessage、CreateMutex、CreateThread、CreateFileMapping"}]},{"ID":"20260511225410-esgku4h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260511225410-esgku4h","updated":"20260515205052"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"winsock2.h，链接库通常是 Ws2_32.lib 这个是动态库吗"}]},{"ID":"20260511225425-wb4yk5o","Type":"NodeParagraph","Properties":{"id":"20260511225425-wb4yk5o","updated":"20260511225428"},"Children":[{"Type":"NodeText","Data":"winsock2.h 不是动态库，它是头文件。Ws2"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"32.lib 也通常不是运行时真正执行代码的动态库，它更像是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"导入库"},{"Type":"NodeText","Data":"，作用是告诉链接器去链接 Ws2"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"32.dll"}]},{"ID":"20260511225425-go198dv","Type":"NodeParagraph","Properties":{"id":"20260511225425-go198dv","updated":"20260511225425"},"Children":[{"Type":"NodeText","Data":"也就是说："}]},{"ID":"20260511225425-ftivp0s","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511225425-ftivp0s","updated":"20260511225425"},"Children":[{"ID":"20260511225425-vgqudab","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511225425-vgqudab","updated":"20260511225425"},"Children":[{"ID":"20260511225425-tdpx5m6","Type":"NodeParagraph","Properties":{"id":"20260511225425-tdpx5m6","updated":"20260511225425"},"Children":[{"Type":"NodeText","Data":"winsock2.h：声明接口，编译时用"}]}]},{"ID":"20260511225425-m5g3aaf","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511225425-m5g3aaf","updated":"20260511225425"},"Children":[{"ID":"20260511225425-h56kc0c","Type":"NodeParagraph","Properties":{"id":"20260511225425-h56kc0c","updated":"20260511225425"},"Children":[{"Type":"NodeText","Data":"Ws2"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"32.lib：链接时用的库文件"}]}]},{"ID":"20260511225425-mc4hfdy","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260511225425-mc4hfdy","updated":"20260511225425"},"Children":[{"ID":"20260511225425-nwiaxiz","Type":"NodeParagraph","Properties":{"id":"20260511225425-nwiaxiz","updated":"20260511225425"},"Children":[{"Type":"NodeText","Data":"Ws2"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"32.dll：运行时真正提供 socket 功能的动态库"}]}]}]},{"ID":"20260515205052-rszvjhe","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260515205052-rszvjhe","updated":"20260515211536"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"了解 Windows 窗口机制，消息通信机制吗"}]},{"ID":"20260515205052-6b0d4p0","Type":"NodeParagraph","Properties":{"id":"20260515205052-6b0d4p0","updated":"20260515204855"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窗口机制："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Windows 是基于窗口的 GUI 系统，每个窗口都有唯一句柄 HWND"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质是一块内存结构，包含标题、大小、样式等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统通过句柄管理的创建、显示、销毁、重绘"}]},{"ID":"20260515205052-hsqh8w0","Type":"NodeParagraph","Properties":{"id":"20260515205052-hsqh8w0","updated":"20260515205027"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"消息通信机制："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Windows 是消息驱动模式，用户操作、系统事件都会生成消息，放进消息队列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"程序循环从队列取消息，交给对应窗口的窗口过程函数 WndProc，通过 switch-case 处理不同消息（鼠标、键盘、重绘等），实现交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单讲就是：事件产生消息 → 入队列 → 循环取消息 → 回调处理"}]},{"ID":"20260515211536-wcs6vn7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260515211536-wcs6vn7","updated":"20260515211056"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"那如果用链表怎么做"}]},{"ID":"20260515211536-6fe55vx","Type":"NodeParagraph","Properties":{"id":"20260515211536-6fe55vx","updated":"20260515211159"},"Children":[{"Type":"NodeText","Data":"每条消息先存进链表节点，再由界面层遍历链表渲染"}]},{"ID":"20260515211536-xv92u7o","Type":"NodeParagraph","Properties":{"id":"20260515211536-xv92u7o","updated":"20260515211138"},"Children":[{"Type":"NodeText","Data":"比如定义一个消息节点："}]},{"ID":"20260515211536-lrmvzal","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260515211536-lrmvzal","updated":"20260515211156"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"struct MsgNode {\n    int userId;\n    QString sender;\n    QString content;\n    QString time;\n    MsgNode* next;\n};\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260515211536-nkbwf2h","Type":"NodeParagraph","Properties":{"id":"20260515211536-nkbwf2h","updated":"20260515211315"},"Children":[{"Type":"NodeText","Data":"来一条新消息，就创建一个新节点，挂到链表尾部"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为聊天记录是按时间顺序展示，所以一般用尾插更合适"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样链表里保存的顺序就是：最早消息在前，最新消息在后"}]},{"ID":"20260515211536-akklwmi","Type":"NodeParagraph","Properties":{"id":"20260515211536-akklwmi","updated":"20260515211514"},"Children":[{"Type":"NodeText","Data":"显示时，打开聊天窗口或者收到新消息后，就从头节点开始遍历，把每个节点一条条追加到界面里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样旧消息天然在上面，新消息因为插在尾部，所以显示时就在下面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果想只刷新最新一条，也可以插完尾节点后只渲染这个新节点，不用整条链表重刷"}]},{"ID":"20260515211536-tul4861","Type":"NodeParagraph","Properties":{"id":"20260515211536-tul4861","updated":"20260515211530"},"Children":[{"Type":"NodeText","Data":"不过工程上我不会优先选手写链表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Qt 里更适合用 QList、QVector，或者直接上 model/view"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"链表更适合用来说明消息有序存储和遍历渲染这个思想，不一定是最终最优实现"}]},{"ID":"20260505170804-vfb5grx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vfb5grx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"文件系统"}]},{"ID":"20260505170804-cabnidu","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-cabnidu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Linux 常见文件系统"}]},{"ID":"20260505170804-95epf2b","Type":"NodeParagraph","Properties":{"id":"20260505170804-95epf2b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ext4 兼容性强、稳定性高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是很多发行版的默认文件系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"日常业务、普通服务器场景使用广泛，综合表现均衡"}]},{"ID":"20260505170804-v8is5yh","Type":"NodeParagraph","Properties":{"id":"20260505170804-v8is5yh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"xfs 更适配大容量磁盘与大文件场景，读写性能出色，扩容简单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"现在 CentOS 等服务器环境普遍采用，很适合数据库、大数据这类高负载业务"}]},{"ID":"20260505170804-q6dky8d","Type":"NodeParagraph","Properties":{"id":"20260505170804-q6dky8d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"除此之外还有一些经典和特殊文件系统，老旧机器会见到 ext2、ext3，属于迭代淘汰版本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像 btrfs、zfs 主打快照、压缩、数据容错，多用于存储和容器环境"}]},{"ID":"20260505170804-eslx5n8","Type":"NodeParagraph","Properties":{"id":"20260505170804-eslx5n8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"还有 tmpfs、proc、sysfs 这类伪文件系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个基于内存高速读写，一个用来查看和管理内核、进程信息"}]},{"ID":"20260505170804-7kntrgv","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-7kntrgv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"什么是文件系统？ 什么是块？ 什么是块组？ 块组的组成？"}]},{"ID":"20260505170804-en352kl","Type":"NodeParagraph","Properties":{"id":"20260505170804-en352kl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 文件系统是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"操作系统用于管理磁盘存储的机制"}]},{"ID":"20260505170804-2gwbiwn","Type":"NodeParagraph","Properties":{"id":"20260505170804-2gwbiwn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"将磁盘抽象为文件和目录来屏蔽硬件细节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其中"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块"},{"Type":"NodeText","Data":"是磁盘读写的最小物理单位，也是文件存储的基础载体"}]},{"ID":"20260505170804-dkwao29","Type":"NodeParagraph","Properties":{"id":"20260505170804-dkwao29","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为了高效管理大容量磁盘，系统会将其划分为多个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"块组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个块组相互独立且结构一致，避免单点故障影响整个文件系统"}]},{"ID":"20260505170804-we5fn1m","Type":"NodeParagraph","Properties":{"id":"20260505170804-we5fn1m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一个标准的块组主要由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"超级块、块组描述符表、块位图、iNode 位图、iNode 表以及实际存储数据的数据块组成"}]},{"ID":"20260505170804-3q2y62m","Type":"NodeParagraph","Properties":{"id":"20260505170804-3q2y62m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"超级块记录文件系统的整体元信息，位图负责管理资源的空闲状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"iNode 表存储文件元数据，数据块则存放文件实际内容"}]},{"ID":"20260505170804-xl1ptt6","Type":"NodeParagraph","Properties":{"id":"20260505170804-xl1ptt6","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260310195513270.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-vfnqjbf","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-vfnqjbf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"什么是 inode？"}]},{"ID":"20260505170804-duamplb","Type":"NodeParagraph","Properties":{"id":"20260505170804-duamplb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"inode 叫索引节点，是 Linux 文件系统里，标识文件的核心数据结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不存文件名"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"专门保存文件元数据，比如权限、大小、时间、磁盘数据块指针这些信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件名存放在目录里，目录本质是文件名和 inode 号的映射表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统访问文件时，先通过目录查到 inode 编号，再靠 inode 找到真实数据存储位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正因为文件名和 inode 分开管理，才能支持硬链接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多个文件名可以指向同一个 inode，共用一份文件数据"}]},{"ID":"20260505170804-6b11hqd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-6b11hqd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"寻址过程"}]},{"ID":"20260505170804-ejpcrka","Type":"NodeParagraph","Properties":{"id":"20260505170804-ejpcrka","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Linux 文件系统采用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"混合索引寻址"},{"Type":"NodeText","Data":"，依靠 inode 里的 13 个指针管理文件数据块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前十项是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"直接指针"},{"Type":"NodeText","Data":"，直接指向文件数据块，小文件不用多层跳转，访问速度最快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后面分别是一级、二级、三级间接指针，不直接存数据，而是逐层存放下级块的地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过一到三层间接映射，逐级扩容，既能满足普通文件存储，也能支撑超大文件"}]},{"ID":"20260505170804-msuaqy9","Type":"NodeParagraph","Properties":{"id":"20260505170804-msuaqy9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这种设计兼顾两端，既保证小文件高效读写，又能兼容大文件的扩展存储，平衡了性能与容量"}]},{"ID":"20260505170804-8ax8dey","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-8ax8dey","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"示例描述向/home/colin/aa 文件中写入“hello world”的文件系统寻址的详细过程："}]},{"ID":"20260505170804-umorf1m","Type":"NodeParagraph","Properties":{"id":"20260505170804-umorf1m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"系统首先会进行路径解析"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从根目录开始，依次查找 /home、/home/colin 目录对应的 inode"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过目录中 “文件名 - inoe 号” 的映射关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终定位到 aa 文件的 inode"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"由于 “hello world” 的大小远小于一个数据块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统会通过块位图找到一个空闲的数据块并完成分配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"随后将字符串数据写入该数据块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时把这个数据块的物理地址记录到 aa 文件 inode 的直接寻址指针中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后，系统会更新该 inode 的文件大小、修改时间等元数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并同步更新块位图（标记该数据块为已使用）和超级块中的相关统计信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完成整个写入过程的寻址与存储操作"}]},{"ID":"20260505170804-3q32v6w","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-3q32v6w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"符号链接和硬链接的区别"}]},{"ID":"20260505170804-hkgxckc","Type":"NodeParagraph","Properties":{"id":"20260505170804-hkgxckc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"硬链接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本质上是同一个 inode 的多个别名，与原文件共享 inode 号和数据块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能指向文件、不能跨文件系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"删除原文件或任一硬链接，只要还有其他硬链接存在"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件数据就不会被真正删除"}]},{"ID":"20260505170804-hjoxulb","Type":"NodeParagraph","Properties":{"id":"20260505170804-hjoxulb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"符号链接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是一个独立的文件，拥有自己的 inode"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内容只是目标文件的路径字符串 既可以指向文件也可以指向目录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还能跨文件系统创建 但它依赖原文件的路径"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦原文件被删除或移动，符号链接就会失效，变成 “断链”"}]},{"ID":"20260505170804-ght140u","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ght140u","updated":"20260519164022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"真正删除文件的时机"}]},{"ID":"20260505170804-l23jr1x","Type":"NodeParagraph","Properties":{"id":"20260505170804-l23jr1x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"只有当一个文件的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"硬链接数为 0"},{"Type":"NodeText","Data":"，并且"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"没有任何进程打开该文件"},{"Type":"NodeText","Data":"时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它占用的数据块才会被文件系统标记为空闲，真正释放磁盘空间"}]},{"ID":"20260505170804-u7q7pz5","Type":"NodeParagraph","Properties":{"id":"20260505170804-u7q7pz5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"具体来说："}]},{"ID":"20260505170804-v5sqzj3","Type":"NodeParagraph","Properties":{"id":"20260505170804-v5sqzj3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当你执行 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"rm"},{"Type":"NodeText","Data":" 命令时，只是减少了文件的硬链接计数，而不是立即删除数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果还有其他硬链接指向该 inode，文件数据依然存在"}]},{"ID":"20260505170804-mnvpbtw","Type":"NodeParagraph","Properties":{"id":"20260505170804-mnvpbtw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"即使硬链接数已经为 0，如果有进程仍然打开着这个文件（例如日志文件被持续写入）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据块也不会被回收，直到所有打开该文件的进程都关闭文件描述符后"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统才会在后台回收空间"}]},{"ID":"20260519164022-95cjyy3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164022-95cjyy3","updated":"20260519164154"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"进程的虚拟内存空间主要包含哪些部分"}]},{"ID":"20260519164022-77en9lh","Type":"NodeParagraph","Properties":{"id":"20260519164022-77en9lh","updated":"20260519145519"},"Children":[{"Type":"NodeText","Data":"进程的虚拟内存空间，面试里一般可以分成这几块："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代码段、数据段、BSS 段、堆、栈，还有共享库/内存映射区"}]},{"ID":"20260519164022-oygso4h","Type":"NodeParagraph","Properties":{"id":"20260519164022-oygso4h","updated":"20260519145542"},"Children":[{"Type":"NodeText","Data":"代码段放的是程序指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据段放的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"已初始化的全局变量和静态变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"BSS 段放的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未初始化或初始化为 0 的全局变量和静态变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"堆是程序运行时动态申请的内存，比如 new、malloc 出来的空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"栈主要放函数调用现场、局部变量、参数这些"}]},{"ID":"20260519164022-fain3sg","Type":"NodeParagraph","Properties":{"id":"20260519164022-fain3sg","updated":"20260519145549"},"Children":[{"Type":"NodeText","Data":"另外还有一块常见的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存映射区"},{"Type":"NodeText","Data":"，一般用来放共享库、mmap 映射文件这类内容"}]},{"ID":"20260519164154-5vlv0vx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164154-5vlv0vx","updated":"20260519154726"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"线程什么时候会发生上下文切换"}]},{"ID":"20260519164154-ifnyett","Type":"NodeParagraph","Properties":{"id":"20260519164154-ifnyett","updated":"20260519154706"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程发生上下文切换，本质上就是 CPU 不再执行当前线程，转去执行另一个线程"}]},{"ID":"20260519164154-apf7r73","Type":"NodeParagraph","Properties":{"id":"20260519164154-apf7r73","updated":"20260519154711"},"Children":[{"Type":"NodeText","Data":"第一类是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"时间片用完"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作系统为了公平调度，会把当前线程挂下来，切到别的线程"}]},{"ID":"20260519164154-szat0qv","Type":"NodeParagraph","Properties":{"id":"20260519164154-szat0qv","updated":"20260519154718"},"Children":[{"Type":"NodeText","Data":"第二类是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程主动让出 CPU"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 sleep、wait、阻塞读写、等锁、等 IO，这时候它自己没法继续跑了，就会切走"}]},{"ID":"20260519164154-c9it8ld","Type":"NodeParagraph","Properties":{"id":"20260519164154-c9it8ld","updated":"20260519154726"},"Children":[{"Type":"NodeText","Data":"第三类是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"被更高优先级线程抢占"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果有更紧急的线程变成可运行状态，调度器可能马上切换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四类是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统调用、缺页中断、异常"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这类进入内核的场景，也可能伴随调度，从而发生上下文切换"}]},{"ID":"20260519164154-oa8q4wn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164154-oa8q4wn","updated":"20260519154959"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"两个进程怎么拿到这个信号量的"}]},{"ID":"20260519164154-qwoqsab","Type":"NodeParagraph","Properties":{"id":"20260519164154-qwoqsab","updated":"20260519154931"},"Children":[{"Type":"NodeText","Data":"如果是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"两个进程共享同一个信号量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前提是这个信号量本身得是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内核对象"},{"Type":"NodeText","Data":"或者"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"放在共享内存里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不能是各自进程里普通的局部变量，不然彼此根本看不到"}]},{"ID":"20260519164154-i7cmaqp","Type":"NodeParagraph","Properties":{"id":"20260519164154-i7cmaqp","updated":"20260519154957"},"Children":[{"Type":"NodeText","Data":"常见做法有两种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第一种是命名信号量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两个进程都通过同一个名字去创建或打开"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 Linux 里的 sem"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"open，Windows 里的命名 Semaphore，这样它们拿到的其实是同一个内核信号量"}]},{"ID":"20260519164154-kuedctf","Type":"NodeParagraph","Properties":{"id":"20260519164154-kuedctf","updated":"20260519154959"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第二种是匿名信号量 + 共享内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把信号量对象放到一块两个进程都能访问的共享内存里，再让两个进程都去操作这块共享的信号量"}]},{"ID":"20260519164154-hb95xei","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164154-hb95xei","updated":"20260519155236"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是协程"}]},{"ID":"20260519164154-lldq9cm","Type":"NodeParagraph","Properties":{"id":"20260519164154-lldq9cm","updated":"20260519155205"},"Children":[{"Type":"NodeText","Data":"协程可以理解成一种比线程更轻量的用户态执行单元"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心特点是：切换不是靠操作系统抢占，而是由程序自己主动挂起和恢复"}]},{"ID":"20260519164154-rf80y2s","Type":"NodeParagraph","Properties":{"id":"20260519164154-rf80y2s","updated":"20260519155219"},"Children":[{"Type":"NodeText","Data":"线程是操作系统调度的，切换开销相对大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"协程一般在用户态完成调度，一个线程里可以跑很多协程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以创建和切换成本更低，特别适合大量 IO 等待场景"}]},{"ID":"20260519164154-4eetw10","Type":"NodeParagraph","Properties":{"id":"20260519164154-4eetw10","updated":"20260519155236"},"Children":[{"Type":"NodeText","Data":"函数执行到一半，可以先 yield 挂起，把执行权让出去，等合适的时候再从上次暂停的位置继续执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":" 这就是协程和普通函数最大的区别，普通函数退出后下次得从头开始，协程可以“断点续跑”"}]},{"ID":"20260519164154-kapomvm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260519164154-kapomvm","updated":"20260520163158"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"协程有自己的栈吗，C++20 的协程有独立的栈吗"}]},{"ID":"20260519164154-s0jwtfb","Type":"NodeParagraph","Properties":{"id":"20260519164154-s0jwtfb","updated":"20260519155445"},"Children":[{"Type":"NodeText","Data":"传统协程一般可以有自己的栈，也可以没有，分成有栈协程和无栈协程"}]},{"ID":"20260519164154-x9rse7l","Type":"NodeParagraph","Properties":{"id":"20260519164154-x9rse7l","updated":"20260519155503"},"Children":[{"Type":"NodeText","Data":"像很多早期协程库，用的是有栈协程，每个协程会有自己独立的一块栈空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"切换时要把栈上下文一起切过去，所以它更像“用户态线程”"}]},{"ID":"20260519164154-ew6nrpv","Type":"NodeParagraph","Properties":{"id":"20260519164154-ew6nrpv","updated":"20260519155522"},"Children":[{"Type":"NodeText","Data":"但 C++20 协程不是这种模型，它是无栈协程，没有独立的调用栈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"C++20 协程的核心是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编译器把协程函数改写成一个状态机，挂起时需要保存的局部变量、状态、恢复点这些信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"放到一个协程帧（coroutine frame）里，下次恢复时从这个状态继续执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而不是靠单独一块栈去恢复现场"}]},{"ID":"20260520163157-kvcwijz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260520163157-kvcwijz","updated":"20260521231833"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Linux 信号传递与处理机制"}]},{"ID":"20260520163208-ifoob7g","Type":"NodeParagraph","Properties":{"id":"20260520163208-ifoob7g","updated":"20260520163324"},"Children":[{"Type":"NodeText","Data":"信号是 Linux 进程间异步通信方式，用来通知进程发生了某个事件（如中断、崩溃、超时）"}]},{"ID":"20260520163324-h0anglj","Type":"NodeParagraph","Properties":{"id":"20260520163324-h0anglj","updated":"20260520163535"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"信号传递流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内核检测到事件----\u003e 给目标进程发送信号----\u003e 进程收到信号，暂停当前执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"-----\u003e 执行信号处理函数-----\u003e 处理完回到原代码继续跑"}]},{"ID":"20260520163535-makbcfl","Type":"NodeParagraph","Properties":{"id":"20260520163535-makbcfl","updated":"20260520163555"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三种处理方式"}]},{"ID":"20260520163557-ox4bfe7","Type":"NodeParagraph","Properties":{"id":"20260520163557-ox4bfe7","updated":"20260520163558"},"Children":[{"Type":"NodeText","Data":"默认处理：系统自带（如 SIGINT 终止、SIGSEGV 崩溃）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"忽略：主动屏蔽信号"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自定义捕获：注册回调函数，自己写逻辑处理"}]},{"ID":"20260520163158-j5h119j","Type":"NodeParagraph","Properties":{"id":"20260520163158-j5h119j","updated":"20260520163816"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号掩码：可以阻塞某些信号，暂时不处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不可靠信号：早期信号可能丢失；可靠信号排队，不丢失"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"信号是异步的，进程不知道什么时候来，会打断正常流程"}]},{"ID":"20260521231833-2d4dsks","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521231833-2d4dsks","updated":"20260521231911"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"CPU 内核是跑进程还是跑线程"}]},{"ID":"20260521231817-u6m8mms","Type":"NodeParagraph","Properties":{"id":"20260521231817-u6m8mms","updated":"20260521231840"},"Children":[{"Type":"NodeText","Data":"CPU 内核实际调度执行的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"线程"},{"Type":"NodeText","Data":"，并非进程"}]},{"ID":"20260521231817-elg9qsa","Type":"NodeParagraph","Properties":{"id":"20260521231817-elg9qsa","updated":"20260521231845"},"Children":[{"Type":"NodeText","Data":"进程是资源分配的基本单位，独享内存、文件等系统资源，本身没法直接被 CPU 运行"}]},{"ID":"20260521231817-fxrf9qw","Type":"NodeParagraph","Properties":{"id":"20260521231817-fxrf9qw","updated":"20260521231911"},"Children":[{"Type":"NodeText","Data":"线程隶属于进程，是 CPU 调度和运算的最小单元"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个进程可以包含多个线程，CPU 轮流切换执行不同线程，完成程序运算任务"}]},{"ID":"20260505170804-rtcuai3","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-rtcuai3","updated":"20260505170804"}},{"ID":"20260505170804-czzclaj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-czzclaj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"Redis"}]},{"ID":"20260505170804-mfjqkiv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mfjqkiv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 是什么？"}]},{"ID":"20260505170804-9vw7g33","Type":"NodeParagraph","Properties":{"id":"20260505170804-9vw7g33","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 是一个基于内存的高性能键值非关系型数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时支持数据持久化和多种丰富的数据结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"常用来做缓存、分布式锁、消息队列、计数器等场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为读写极快、高并发、低延迟，在后端项目里非常常用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260211120213147"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260211120213147.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-qcq2xhs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qcq2xhs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 的优缺点"}]},{"ID":"20260505170804-1lpncjy","Type":"NodeParagraph","Properties":{"id":"20260505170804-1lpncjy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读写性能优异。数据结构丰富"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持数据持久化---AOF 持久化和 RDB 持久化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持事务，Redis 的所有操作都是原子性的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"支持主从复制，主机会自动将数据同步到从机，可进行读写分离"}]},{"ID":"20260505170804-ty9incz","Type":"NodeParagraph","Properties":{"id":"20260505170804-ty9incz","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"容量受到物理内存的限制，不能用作高性能海量数据读写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 不具备自动容错和恢复功能，主机从机的宕机都会导致前端部分读写需求失败"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要等待机器重启或者手动切换前端的 IP 才能恢复\t（自救加哨兵）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主机宕机，宕机前有部分数据未能同步到从机，切换 IP 后会引入数据不一致的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 较难支持在线扩容，在集群 容量达到上限时，扩容会变得很复杂"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有运维人员在系统上线时必须确保足够的空间，这对资源造成很大的浪费"}]},{"ID":"20260505170804-95r2f59","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-95r2f59","updated":"20260520120914"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么 Redis 扩容难"}]},{"ID":"20260505170804-ynivkj9","Type":"NodeParagraph","Properties":{"id":"20260505170804-ynivkj9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 扩容之所以难，核心在于它是纯内存存储，并且采用哈希槽分片机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和普通磁盘数据库扩容完全不是一个难度"}]},{"ID":"20260505170804-1smg5wz","Type":"NodeParagraph","Properties":{"id":"20260505170804-1smg5wz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，Redis 所有数据都在内存里，扩容不是简单加机器、加磁盘就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"必须把大量内存数据从旧节点搬到新节点，搬迁过程非常耗 CPU、网络和内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据量大时很容易卡顿"}]},{"ID":"20260505170804-4rcvcah","Type":"NodeParagraph","Properties":{"id":"20260505170804-4rcvcah","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，Redis 集群用 16384 个哈希槽做分片，扩容需要重新分配槽位、逐个迁移 key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"迁移期间还要正常处理业务请求，保证数据不丢失、不错乱，逻辑复杂、风险高"}]},{"ID":"20260505170804-jjr8cug","Type":"NodeParagraph","Properties":{"id":"20260505170804-jjr8cug","updated":"20260520120914"},"Children":[{"Type":"NodeText","Data":"最后，Redis 集群没有自动扩容和自动均衡"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"槽迁移、节点添加都需要手动执行命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"运维成本高，稍微操作不当就会导致集群异常或服务抖动"}]},{"ID":"20260505170804-kdusait","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kdusait","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么要用 Redis/为什么要用缓存\t\t\u003e\u003e"}]},{"ID":"20260505170804-bcdzv5a","Type":"NodeParagraph","Properties":{"id":"20260505170804-bcdzv5a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"高性能、能顶住高并发："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"假如用户第一次访问数据库中的某些数据，这个过程时比较慢的，因为使用硬盘上直接读取的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将该用户访问的数据存储在缓存中，这样下次再次访问这些数据的时候，就可以直接去缓存中拿了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"操作缓存就是直接操作内存，所以速度特别快。如果数据库中的数据改变后，同步改变缓存中相对应得数据即可"}]},{"ID":"20260505170804-nayw0kw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nayw0kw","updated":"20260520121910"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么 Redis 这么快\t\t\u003e\u003e"}]},{"ID":"20260505170804-wmsyd5k","Type":"NodeParagraph","Properties":{"id":"20260505170804-wmsyd5k","updated":"20260520121910"},"Children":[{"Type":"NodeText","Data":"完全基于内存，数据存在内存中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据结构简单，对数据操作也简单，Redis 中的数据结构是专门进行设计的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用单线程，避免了不必要的上下文切换和竞争条件，也不存在多进程或者 多线程导致的切换而消耗 CPU，不用去考虑各种锁的问题，不存在加锁释放锁操作，没有因为可能出现死锁而导致的性能消耗；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用多路 I/O 复用模型 ，非阻塞 IO"}]},{"ID":"20260505170804-w4akawu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w4akawu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 的对象类型有哪些？ 底层实现用了哪些数据结构？\t\t\u003e\u003e"}]},{"ID":"20260505170804-y2d9zau","Type":"NodeParagraph","Properties":{"id":"20260505170804-y2d9zau","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"String-\u003eSDS 简单动态字符串\t用于缓存、计数、分布式锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Hash-\u003e 压缩列表/字典(哈希)  用于存储对象，方便字段修改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"List-\u003e 双向链表/快速链表   用于队列、消息、时间线"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Set-\u003e 字典(哈希)/整数集合   去重、点赞、共同好友"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ZSet-\u003e 压缩列表/跳表     用于排行榜、限流、排序"}]},{"ID":"20260505170804-pdwquaw","Type":"NodeParagraph","Properties":{"id":"20260505170804-pdwquaw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"SDS 包含：len：已用长度\talloc：分配的总空间\tbuf[]：实际存数据的字节数组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比 C 字符串，SDS 能 O (1) 获取长度、自动扩容、预分配内存减少开销、二进制安全，所以速度更快、更安全、更灵活。"}]},{"ID":"20260505170804-kht5pfo","Type":"NodeParagraph","Properties":{"id":"20260505170804-kht5pfo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"entry 就是 ziplist 里的「一个数据节点」，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存了前一个节点长度、自身信息和真实数据"}]},{"ID":"20260505170804-zmprvgi","Type":"NodeParagraph","Properties":{"id":"20260505170804-zmprvgi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"快速链表是一个由 ziplist 作为节点的双向链表，每个 ziplist 保存一段连续的数据，既避免了普通链表的内存碎片，又防止单个 ziplist 过长导致性能下降，在内存效率和操作性能之间做了平衡"}]},{"ID":"20260505170804-gj7shwo","Type":"NodeParagraph","Properties":{"id":"20260505170804-gj7shwo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 的字典底层是哈希表，通过哈希函数计算 key 的哈希值，对数组长度取余得到槽位下标，把键值对放入对应槽位；冲突时使用链式哈希解决；字典包含两个哈希表，用于渐进式 rehash 实现扩容缩容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为如果一次性把所有数据重新哈希，会阻塞主线程，导致 Redis 卡顿"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以 Redis 用 渐进式 Rehash：把 rehash 分摊到多次操作里，一点点挪数据，不阻塞服务"}]},{"ID":"20260505170804-ewb77ol","Type":"NodeParagraph","Properties":{"id":"20260505170804-ewb77ol","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260211120536217"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260211120536217.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-kaz9oaf","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-kaz9oaf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"怎么通过 key 存储/查找 value 的呢？"}]},{"ID":"20260505170804-k8ad602","Type":"NodeParagraph","Properties":{"id":"20260505170804-k8ad602","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"key:通过 key 经过哈希函数生成 64 位整数，对数组进行长度取余，落到数组的某一个槽位，在最外层通过一个字典"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"value:字典，双向链表，压缩列表，跳表，整数数组(用来实现无序集合(集合用来做交并查集))，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态数组(用来实现 string 类型(string 二进制安全字符串，主要用来区别 C 中的‘/0’作为分隔符的安全字符串)支持字节流)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260211121551455"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260211121551455.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-4jh768w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4jh768w","updated":"20260520131946"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么 Redis 只有小数据量时才用压缩列表?\t\u003e\u003e"}]},{"ID":"20260505170804-n4ja7k8","Type":"NodeParagraph","Properties":{"id":"20260505170804-n4ja7k8","updated":"20260520131946"},"Children":[{"Type":"NodeText","Data":"压缩列表是 Redis 为小数据场景设计的极度紧凑的连续内存结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不使用指针、内存排布紧密，能最大程度节省内存空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在数据量很小的时候，遍历和修改的开销可以忽略，既能省内存又能保证效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此适合用来存储少量字段或短数据"}]},{"ID":"20260505170804-8dnosxs","Type":"NodeParagraph","Properties":{"id":"20260505170804-8dnosxs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但压缩列表的缺点也很明显："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它是连续内存，插入、删除元素会导致后续数据大量移动,查找也只能线性遍历"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据量变大后，操作效率会急剧下降，还可能出现连锁更新问题，严重影响性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以 Redis 只在元素数量少、单个值较小时使用压缩列表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦数据量超过阈值，就会自动转换成哈希表、跳表等更高效的结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用空间换稳定的高性能，保证大数据量下的读写速度"}]},{"ID":"20260505170804-cw0bsdt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cw0bsdt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"渐进式 rehash\t\t\u003e\u003e"}]},{"ID":"20260505170804-pqmrvgw","Type":"NodeParagraph","Properties":{"id":"20260505170804-pqmrvgw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"渐进式 rehash 是 Redis 哈希表在扩容或缩容时，为了避免一次性大量数据迁移导致主线程阻塞而采用的平滑迁移方案。Redis 会维护新旧两个哈希表，在扩容或缩容期间，并不会立即把所有数据一次性迁移完成，而是把迁移压力分摊到后续的每一次增删改查操作中"}]},{"ID":"20260505170804-mby07r6","Type":"NodeParagraph","Properties":{"id":"20260505170804-mby07r6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每次客户端访问时，Redis 都会顺带迁移一小部分数据，同时查询操作会先查新表，找不到再去旧表查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"等到所有数据都迁移到新表后，旧表才会被释放"}]},{"ID":"20260505170804-gemkkqz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-gemkkqz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 跳表介绍下？"}]},{"ID":"20260505170804-jdyue41","Type":"NodeParagraph","Properties":{"id":"20260505170804-jdyue41","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 跳表本质是多层有序链表，底层完整数据有序排列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上层逐层建立稀疏索引，用空间换时间"}]},{"ID":"20260505170804-kwd024d","Type":"NodeParagraph","Properties":{"id":"20260505170804-kwd024d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"查询、插入、删除都从最高层索引开始，大了往下沉，小了往后走"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用遍历整条链表，时间复杂度做到 O(logn)"}]},{"ID":"20260505170804-wjqfku4","Type":"NodeParagraph","Properties":{"id":"20260505170804-wjqfku4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"跳表每层高度随机生成，不用像红黑树做旋转平衡，实现简单、维护成本低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比平衡树，它区间范围查询更天然高效，非常适配 Redis 的 ZSet 有序排行、分页遍历场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这也是 Redis 选用跳表的核心原因"}]},{"ID":"20260505170804-evzyddt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-evzyddt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"跳表为什么比红黑树更适合 ZSet？\t\t\u003e\u003e"}]},{"ID":"20260505170804-fkenyt2","Type":"NodeParagraph","Properties":{"id":"20260505170804-fkenyt2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实现简单，无需旋转平衡，代码易维护；"}]},{"ID":"20260505170804-wio80pg","Type":"NodeParagraph","Properties":{"id":"20260505170804-wio80pg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"区间查询极快，符合 ZSet 常用的范围查找需求；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跳表是有序链表，找到起点后直接向后遍历即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"红黑树是二叉树，区间查询要做中序遍历，效率更低、更复杂"}]},{"ID":"20260505170804-gf2xg0u","Type":"NodeParagraph","Properties":{"id":"20260505170804-gf2xg0u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"插入删除只修改局部节点，性能更稳定；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并发更友好，加锁粒度小，高并发表现更好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以 Redis 用跳表实现 ZSet"}]},{"ID":"20260505170804-7guthz0","Type":"NodeParagraph","Properties":{"id":"20260505170804-7guthz0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Map 主要做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单点增删改查"},{"Type":"NodeText","Data":"，追求"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"稳定 O (logN)、省内存"},{"Type":"NodeText","Data":"，所以用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红黑树"}]},{"ID":"20260505170804-b2436ys","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b2436ys","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 中相同数量的数据，对比 hash 存储于 zset 存储内存占用情况？\t\u003e\u003e"}]},{"ID":"20260505170804-mfx53et","Type":"NodeParagraph","Properties":{"id":"20260505170804-mfx53et","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当节点数小于等于 128 的时候，内存占用情况是一样的；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当节点数大于 128 小于 512 的时候\thash 使用的是压缩列表   zset 使用的是 skiplist(1.5* n) \t// n\u003c n+1/4*n+1/16 *n+ …\t\u003c= 1.5n"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有扩缩容：最差的情况是 2 *n,最好的情况是 n"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进行扩容：\t在渐进式 rehash2 *n+n \t 没在渐进式 rehash 2 *n"}]},{"ID":"20260505170804-jo4yh3t","Type":"NodeParagraph","Properties":{"id":"20260505170804-jo4yh3t","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小数据量（节点数 ≤128）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两者内存占用基本持平。因为 Redis 默认对 Hash 和 ZSet 做了小数据优化，底层均使用压缩列表（ziplist）—— 连续内存块存储，无额外指针 / 索引开销，仅占用数据本身的内存。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中数据量（128 \u003c 节点数 \u003c 512）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ZSet 内存占用显著更高。此时 ZSet 因超过阈值切换为「跳表 + 哈希表」编码：跳表需要分层索引（总节点数约 1.5n），哈希表用于快速查询 （约 n），总内存约 2.5n；而 Hash 仍维持压缩列表，仅占用 n 级内存，无额外结构开销。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大数据量（节点数 ≥512）："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Hash 切换为哈希表，但仍比 ZSet 更省内存。Hash 哈希表负载因子 0.75，稳定态内存约 1.33n；即便扩容时触发渐进式 rehash（同时持有原表 + 新表，峰值 3n），也仅在扩容阶段临时增高，稳定后仍低于 ZSet（跳表 + 哈希表约 2.5n）。"}]},{"ID":"20260505170804-1o20tnz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1o20tnz","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"关于 redis 限流\t\t\u003e\u003e"}]},{"ID":"20260505170804-2z4ebgy","Type":"NodeParagraph","Properties":{"id":"20260505170804-2z4ebgy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 限流就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"基于 Redis 实现的流量控制机制"},{"Type":"NodeText","Data":"，限制单位时间内接口或用户的请求总量，防止请求超过系统能承受的范围，从而保证服务稳定。"}]},{"ID":"20260505170804-wlpnv2d","Type":"NodeParagraph","Properties":{"id":"20260505170804-wlpnv2d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，防止流量突增打垮服务，比如秒杀、热点接口、恶意刷接口，都可能瞬间把服务压崩"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次，保护下游依赖，比如数据库、第三方接口，避免被大量请求拖慢甚至宕机"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外，防止恶意攻击和刷接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且 Redis 性能高、支持分布式，能在多台服务实例之间共用一套限流规则，适合做分布式限流"}]},{"ID":"20260505170804-7auuixs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7auuixs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"基于 redis 实现限流功能有哪几种方式？\t\t\u003e\u003e"}]},{"ID":"20260505170804-g31lerw","Type":"NodeParagraph","Properties":{"id":"20260505170804-g31lerw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"固定窗口计数器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它把时间划分成固定大小的窗口，超过阈值就拒绝访问。这种方式实现简单、性能很高，但存在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"窗口临界突刺问题"},{"Type":"NodeText","Data":"，在两个窗口切换时可能出现流量瞬间翻倍。"}]},{"ID":"20260505170804-c18i8ta","Type":"NodeParagraph","Properties":{"id":"20260505170804-c18i8ta","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滑动窗口限流"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用 Redis 的 ZSet 来实现，以时间戳作为分数，每次请求先移除窗口外的旧数据，再统计窗口内的总请求数。这种方式"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"限流非常精准"},{"Type":"NodeText","Data":"，没有边界漏洞，缺点是需要频繁删除和统计数据，性能比固定窗口略低一些。"}]},{"ID":"20260505170804-pf1pt8o","Type":"NodeParagraph","Properties":{"id":"20260505170804-pf1pt8o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"漏桶算法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它把请求当作水流先进入漏桶，再以固定速率匀速处理，桶满则直接拒绝。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过 Redis 记录剩余水量和上次漏水时间，每次请求先计算这段时间漏掉的水量，更新剩余水量后再判断是否允许进入。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"流量平滑稳定"},{"Type":"NodeText","Data":"，能有效保护下游服务，缺点是无法应对突发流量，即使系统空闲也只能匀速处理。"}]},{"ID":"20260505170804-0w4w3k9","Type":"NodeParagraph","Properties":{"id":"20260505170804-0w4w3k9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第四种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"令牌桶算法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"固定速率向桶中放入令牌，请求必须先获取令牌才能执行。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 Redis 维护令牌数量和更新时间，每次请求先补齐令牌再消费。它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"既可以严格限流，又能支持一定的突发流量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际项目中，一般结合 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Lua 脚本"},{"Type":"NodeText","Data":"保证 Redis 操作的原子性，避免并发超流问题"}]},{"ID":"20260505170804-mwmcey9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mwmcey9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"令牌桶算法的工作原理是什么？如何通过令牌桶算法应对突发流量？\t\u003e\u003e"}]},{"ID":"20260505170804-5nt8t8b","Type":"NodeParagraph","Properties":{"id":"20260505170804-5nt8t8b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"令牌桶算法的核心原理是系统以固定速率持续生成令牌，并放入令牌桶中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个请求到来时，必须先拿到一个令牌才能被处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果桶内没有令牌，请求就会被限流或拒绝"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"桶本身有容量上限，令牌满了之后就不再新增，避免无限堆积"}]},{"ID":"20260505170804-lvahq1x","Type":"NodeParagraph","Properties":{"id":"20260505170804-lvahq1x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它之所以能很好应对突发流量，是因为令牌桶会预先积攒令牌"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平时流量低的时候，令牌会慢慢存满整个桶，一旦瞬间出现大量请求，就可以一次性把桶里积攒的令牌全部消耗掉，从而允许短时间内的流量突增，不会像漏桶算法那样强行匀速、把正常突发流量直接拒绝"}]},{"ID":"20260505170804-u3ft9wi","Type":"NodeParagraph","Properties":{"id":"20260505170804-u3ft9wi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在实际使用中，我们还可以在令牌桶基础上做更灵活的设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如设置一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"预警阈值"},{"Type":"NodeText","Data":"，当请求量接近限流上限时，先打出日志进行监控和统计，观察流量趋势"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而不是立刻开启强限流，避免误伤正常用户"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时可以加入动态开关，根据实时流量情况决定是否启用限流"}]},{"ID":"20260505170804-4imztou","Type":"NodeParagraph","Properties":{"id":"20260505170804-4imztou","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"针对用户维度，还可以按用户粒度做细粒度限流，给每个用户分配独立的令牌桶"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如设置桶容量为 200、每秒生成固定数量令牌"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样既能保证平稳流量，又能在突发时允许瞬间冲到最大容量，既保护系统，又提升正常用户的体验"}]},{"ID":"20260505170804-gjjk0ta","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-gjjk0ta","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何实现系统的流量监控和限流触发的告警机制？\t\t\u003e\u003e"}]},{"ID":"20260505170804-us5a7x4","Type":"NodeParagraph","Properties":{"id":"20260505170804-us5a7x4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一般会先在系统里做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实时流量统计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如通过接口 QPS（每秒请求数）、请求耗时、错误率这些指标，用日志或者埋点的方式上报到监控系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像 Prometheus、Grafana 或者云厂商的监控平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后提前配置好"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多级阈值"},{"Type":"NodeText","Data":"，比如设置一个 80% 的预警线和 100% 的限流阈值"}]},{"ID":"20260505170804-1j77sqc","Type":"NodeParagraph","Properties":{"id":"20260505170804-1j77sqc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当流量达到预警阈值时，系统不会直接拦截请求，而是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发告警"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过邮件、短信等通知相关人员，同时记录详细日志，方便观察流量趋势"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果流量继续上涨，达到甚至超过限流上限，就"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自动开启限流策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时再发一次紧急告警，让运维和开发及时介入处理"}]},{"ID":"20260505170804-zclt4wq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zclt4wq","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 缓存策略\t\t\u003e\u003e"}]},{"ID":"20260505170804-jmurcj7","Type":"NodeParagraph","Properties":{"id":"20260505170804-jmurcj7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 缓存策略主要分为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存读写更新策略"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"内存淘汰策略"},{"Type":"NodeText","Data":"两大类"}]},{"ID":"20260505170804-bgrjgri","Type":"NodeParagraph","Properties":{"id":"20260505170804-bgrjgri","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在读写更新策略里最常用的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旁路缓存模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读流程是先查缓存，缓存命中直接返回，未命中就查询数据库，再把结果写入缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写流程一般是先更新数据库，再删除缓存，而不是更新缓存，这样能有效避免并发场景下的脏数据问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"除此之外还有穿透、击穿、雪崩的防护策略，比如设置空值缓存、加互斥锁、缓存过期时间随机化等"}]},{"ID":"20260505170804-o8hn7sk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-o8hn7sk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 的过期键和删除策略\t\t\u003e\u003e"}]},{"ID":"20260505170804-23pf6pd","Type":"NodeParagraph","Properties":{"id":"20260505170804-23pf6pd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 的过期策略就是指当 Redis 中缓存的 key 过期了，Redis 如何处理。"}]},{"ID":"20260505170804-jf9j6yc","Type":"NodeParagraph","Properties":{"id":"20260505170804-jf9j6yc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"定时过期：每个过期时间的 Key 都需要一个定时器，到过期期间就会立即清楚(每隔一段时间，把所有过期 key 全部检查一遍)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"该策略可以立即清楚过期的 key，对内存很友好；但是会占用大量 CPU 去处理过期的数据，从而影响缓存的响应时间和吞吐量"}]},{"ID":"20260505170804-w33qm5r","Type":"NodeParagraph","Properties":{"id":"20260505170804-w33qm5r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"惰性过期：只有当访问一个 key 时，才会去判断这个 Key 是否已经过期，过期则清除；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"该策略可以最大化的节省 CPU 资源，但对内存十分不友好，极端情况可能出现大量的 过期 key 没有再次被访问，从而不会被清除，占用大量内存"}]},{"ID":"20260505170804-fch2nc0","Type":"NodeParagraph","Properties":{"id":"20260505170804-fch2nc0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"定期过期：每隔一定的时间，会扫描一定数量的数据库的 expires 字典中一定数 量的 key，并清除其中已过期的 key。该策略是前两者的一个折中方案。通过调整定 时扫描的时间间隔和每次扫描的限定耗时，可以在不同情况下使得 CPU 和内存资源达 到最优的平衡效果。"}]},{"ID":"20260505170804-5k8wbux","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5k8wbux","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 的内存淘汰策略有哪些\t\t\u003e\u003e"}]},{"ID":"20260505170804-gldmrzo","Type":"NodeParagraph","Properties":{"id":"20260505170804-gldmrzo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 的内存淘汰策略的选取并不会影响过期的 key 的处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内存淘汰策略用于 处理内存不足时的需要申请额外空间的数据；过期策略用于处理过期的缓存数据"}]},{"ID":"20260505170804-7werzqf","Type":"NodeParagraph","Properties":{"id":"20260505170804-7werzqf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"volatile：只淘汰设置了过期时间的 key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"allkeys：所有 key 都可以淘汰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lru：看最近多久没用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lfu：看使用次数多少"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"生产推荐：allkeys-lru"}]},{"ID":"20260505170804-tvh7hog","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-tvh7hog","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 到底是不是单线程的"}]},{"ID":"20260505170804-5pod6s4","Type":"NodeParagraph","Properties":{"id":"20260505170804-5pod6s4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 是单线程的；通常说的单线程，主要是指 Redis 对外提供的键值存储服务的主要流程是单线程，也就是网络 I/O 和数据读写是由单个线程来完成的"}]},{"ID":"20260505170804-xey84jd","Type":"NodeParagraph","Properties":{"id":"20260505170804-xey84jd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"除此之外 Redis 的其他功能，例如持久化，异步删除，集群数据同步等，是由额外线程来执行的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此，严格来说 Redis 并不是全面单线程"}]},{"ID":"20260505170804-d8reftv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d8reftv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 事务"}]},{"ID":"20260505170804-5vqykko","Type":"NodeParagraph","Properties":{"id":"20260505170804-5vqykko","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以一次执行多个命令，本质是一组命令的集合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个事务中的所有命令都会序列化，按顺序地串行执行而不会被其他命令插入，不许加塞"}]},{"ID":"20260505170804-kudouua","Type":"NodeParagraph","Properties":{"id":"20260505170804-kudouua","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 的事务总是具有 ACID 中的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一致性和隔离性"},{"Type":"NodeText","Data":"，其他特性是不支持的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 是单进程程序，并且它保证在执行事务时，不会对事务进行中断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"事务可以运行直到执行完所有事务队列中的命令为止"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此，Redis 的事务是总是带有 隔离性的"}]},{"ID":"20260505170804-frifavw","Type":"NodeParagraph","Properties":{"id":"20260505170804-frifavw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Redis 事务保证原子性吗，支持回滚吗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 中单条命令是原子性执行的，但事务不保证原子性，且没有回滚"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"事务 中任意命令执行失败，其余的命令仍会被执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Redis 事务其他实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于 Lua 脚本，Redis 可以保证脚本内的命令一次性、按顺序地执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其同时也不提供事务运行错误的回滚，执行过程中如果部分命令运行错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"剩下的命令还是 会继续运行完"}]},{"ID":"20260505170804-2uuwrvl","Type":"NodeParagraph","Properties":{"id":"20260505170804-2uuwrvl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"基于中间标记变量，通过另外的标记变量来标识事务是否执行完成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读取数据时 先读取该标记变量判断是否事务执行完成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但这样会需要额外写代码实现，比较繁琐"}]},{"ID":"20260505170804-tcxevye","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-tcxevye","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 事务相关的命令"}]},{"ID":"20260505170804-5d0j38k","Type":"NodeParagraph","Properties":{"id":"20260505170804-5d0j38k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"编译错误（语法错）：全部命令不执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"运行错误（类型错）：正确命令继续执行"}]},{"ID":"20260505170804-qgrqctr","Type":"NodeParagraph","Properties":{"id":"20260505170804-qgrqctr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MULTI：开启事务，命令入队"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"EXEC：执行队列所有命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"DISCARD：清空队列、放弃事务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"WATCH：乐观锁，监控 key，被修改则事务不执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UNWATCH：取消监控"}]},{"ID":"20260505170804-3q9ei1l","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3q9ei1l","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"缓存更新策略"}]},{"ID":"20260505170804-hsyodlb","Type":"NodeParagraph","Properties":{"id":"20260505170804-hsyodlb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 旁路缓存（Cache-Aside Pattern，也叫懒加载模式）是最主流的缓存使用方式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用代码主动管理缓存读写，数据库是数据源，Redis 只做旁路加速"}]},{"ID":"20260505170804-3p6oq0k","Type":"NodeParagraph","Properties":{"id":"20260505170804-3p6oq0k","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读流程"},{"Type":"NodeText","Data":"（先缓存、后 DB）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用先查 Redis 缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命中：直接返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"未命中：查数据库 → 把结果写回 Redis（可设过期）→ 返回"}]},{"ID":"20260505170804-yelubzv","Type":"NodeParagraph","Properties":{"id":"20260505170804-yelubzv","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"写流程"},{"Type":"NodeText","Data":"（先 DB、后删缓存）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先更新数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再删除 Redis 中对应缓存，下次读自动回填新数据"}]},{"ID":"20260505170804-ssf8ikd","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ssf8ikd","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么是删除，不是更新缓存？"}]},{"ID":"20260505170804-islu385","Type":"NodeParagraph","Properties":{"id":"20260505170804-islu385","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"避免频繁更新缓存造成浪费"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止并发下的脏数据问题"}]},{"ID":"20260505170804-le8whmq","Type":"NodeParagraph","Properties":{"id":"20260505170804-le8whmq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果采用更新数据库 + 更新缓存，在并发场景下很容易出现脏数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如线程 A 先更新数据库，还没来得及更新缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此时线程 B 又更新数据库并更新了缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后线程 A 才把旧数据写入缓存，就会导致缓存里一直是旧值，数据库里是新值，数据不一致"}]},{"ID":"20260505170804-7hagi0a","Type":"NodeParagraph","Properties":{"id":"20260505170804-7hagi0a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"而采用更新数据库再删除缓存就可以避免这个问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"删除缓存相当于让缓存失效，下一次查询时会重新从数据库读取最新数据回填"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相当于 “懒加载” 最新值，天然规避了并发写时序错乱带来的脏数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时也不会因为频繁更新缓存产生无效开销"}]},{"ID":"20260505170804-kahqjop","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-kahqjop","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"为什么不先删缓存？"}]},{"ID":"20260505170804-iu3l55o","Type":"NodeParagraph","Properties":{"id":"20260505170804-iu3l55o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先删缓存 → 再更新 DB 中间如果有查询，会把旧数据写回缓存，造成脏数据"}]},{"ID":"20260505170804-2iqun9o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2iqun9o","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 有哪些架构模式？"}]},{"ID":"20260505170804-pa7o23u","Type":"NodeParagraph","Properties":{"id":"20260505170804-pa7o23u","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单机模式"},{"Type":"NodeText","Data":"只有一个 Redis 节点，读写都在这台机器上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点是部署简单、成本低"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是不具备高可用，一旦宕机服务就会中断，只适合测试或非核心业务"}]},{"ID":"20260505170804-n11m2ac","Type":"NodeParagraph","Properties":{"id":"20260505170804-n11m2ac","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主从模式"},{"Type":"NodeText","Data":"将数据从主节点同步到多个从节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主节点负责写，从节点负责读，实现读写分离，减轻主节点压力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它本身不具备自动故障转移能力，主节点挂掉后需要人工切换，无法保证高可用"}]},{"ID":"20260505170804-2hqeze9","Type":"NodeParagraph","Properties":{"id":"20260505170804-2hqeze9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"哨兵模式"},{"Type":"NodeText","Data":"是在主从架构的基础上引入哨兵节点，用来监控主从节点状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当主节点故障时，哨兵会自动进行故障转移，从从节点中选出新的主节点，保证服务高可用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但它只解决了高可用问题，不支持数据分片，无法突破单机内存和并发瓶颈"}]},{"ID":"20260505170804-lfhiqxy","Type":"NodeParagraph","Properties":{"id":"20260505170804-lfhiqxy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Redis 集群模式"},{"Type":"NodeText","Data":"通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据分片"},{"Type":"NodeText","Data":"将数据分散到多个主节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个主节点再搭配从节点，既支持水平扩容，又具备高可用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它能突破单机性能限制，支撑更大的并发和数据量，是生产环境中大规模场景下的首选方案"}]},{"ID":"20260505170804-p41i3jj","Type":"NodeParagraph","Properties":{"id":"20260505170804-p41i3jj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Redis 集群里，是用哈希槽 来实现分片的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 一共划分了 16384 个哈希槽（16384 个槽正好占用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2KB"},{"Type":"NodeText","Data":" 的空间）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据进来先通过 CRC16 算法计算 key（得到一个 16 位整数）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再对 16384 取模，落到对应的槽位上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个主节点负责一部分槽位，从而实现数据均匀分布"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样一来，容量可以横向扩展，并发能力也能成倍提升，这就是数据分片的核心作用"}]},{"ID":"20260505170804-8lp6c8g","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-8lp6c8g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"Redis 集群为什么是 16384 个槽？"}]},{"ID":"20260505170804-5yjr59u","Type":"NodeParagraph","Properties":{"id":"20260505170804-5yjr59u","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"心跳包小：用位图传输，刚好 2KB，通信高效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适配节点数：满足千节点内均匀分配，不倾斜"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2 的幂：哈希计算快，是性能与开销的最优折中"}]},{"ID":"20260505170804-n3v6zyc","Type":"NodeParagraph","Properties":{"id":"20260505170804-n3v6zyc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"心跳包："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"心跳包小指的是 Redis 集群里节点之间互相发送的心跳信息很小（节点状态、槽信息等）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络传输极快、不占带宽"}]},{"ID":"20260505170804-76f6ysy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-76f6ysy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是缓存雪崩，缓存穿透，缓存击穿？\t分别有哪些解决方案？"}]},{"ID":"20260505170804-icc7nly","Type":"NodeParagraph","Properties":{"id":"20260505170804-icc7nly","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存雪崩"},{"Type":"NodeText","Data":"是指大量缓存同时过期，或者 Redis 整体宕机，导致大量请求直接访问数据库，使数据库压力剧增甚至宕机。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决办法"},{"Type":"NodeText","Data":"主要是给缓存过期时间加上随机值，避免批量 key 同时失效；搭建 Redis 主从、哨兵或集群架构保证高可用；同时结合限流、降级、熔断机制保护数据库，也可以使用互斥锁，只允许一个线程去重建缓存。"}]},{"ID":"20260505170804-kg2vhlf","Type":"NodeParagraph","Properties":{"id":"20260505170804-kg2vhlf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存穿透"},{"Type":"NodeText","Data":"是指请求查询的数据在缓存和数据库中都不存在，每次请求都会直接访问数据库，容易被恶意攻击造成数据库压力过大。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决方案"},{"Type":"NodeText","Data":"是对不存在的数据缓存空值，并设置较短过期时间；也可以使用布隆过滤器提前判断数据是否存在，不存在则直接返回；同时做好参数校验、限流和黑名单拦截，从源头避免非法请求。"}]},{"ID":"20260505170804-lcr83r0","Type":"NodeParagraph","Properties":{"id":"20260505170804-lcr83r0","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缓存击穿"},{"Type":"NodeText","Data":"是指一个极高并发访问的热点 key，在某一时刻突然过期，大量请求瞬间直接打到数据库，导致数据库压力飙升。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决方式"},{"Type":"NodeText","Data":"一般是将热点 key 设置为永不过期，由后台异步更新数据；或者使用互斥锁，同一时间只允许一个线程去查询数据库并重建缓存，也可以提前对热点数据进行预热，避免集中失效。"}]},{"ID":"20260505170804-52pxydf","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-52pxydf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"熔断机制"}]},{"ID":"20260505170804-sz6v7k6","Type":"NodeParagraph","Properties":{"id":"20260505170804-sz6v7k6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"熔断机制"},{"Type":"NodeText","Data":"是一种服务保护机制，类似于电路里的保险丝。当下游服务出现大量异常、响应缓慢或失败率过高时，熔断器会自动"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"断开调用"},{"Type":"NodeText","Data":"，不再继续请求问题服务，直接快速返回降级结果，避免故障不断放大，防止整个系统被拖垮。"}]},{"ID":"20260505170804-zieno16","Type":"NodeParagraph","Properties":{"id":"20260505170804-zieno16","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"熔断一般有三个状态："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关闭、打开、半开"},{"Type":"NodeText","Data":"。关闭状态下正常调用；当失败率达到阈值，熔断器切换到打开状态，直接拒绝请求；等待一段时间后进入半开状态，允许少量请求试探，如果恢复正常就重新关闭熔断，否则继续保持打开。"}]},{"ID":"20260505170804-54zsw4n","Type":"NodeParagraph","Properties":{"id":"20260505170804-54zsw4n","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用熔断机制的目的，就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防止级联故障、保护系统整体可用性"},{"Type":"NodeText","Data":"，在微服务架构和高并发场景中非常关键，常和限流、降级一起配合使用，共同保障服务稳定。"}]},{"ID":"20260505170804-ka6ehvf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ka6ehvf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"RDB 和 AOF"}]},{"ID":"20260505170804-7tmqp5y","Type":"NodeParagraph","Properties":{"id":"20260505170804-7tmqp5y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redis 持久化主要有 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"RDB"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AOF"},{"Type":"NodeText","Data":" 两种方式，用来把内存数据保存到磁盘，防止宕机丢失数据"}]},{"ID":"20260505170804-fnbdqxj","Type":"NodeParagraph","Properties":{"id":"20260505170804-fnbdqxj","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"RDB 是快照持久化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按照配置的时间和条件，把内存里的数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一次性全量生成一个二进制文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点是文件小、恢复速度快、对 Redis 性能影响小"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是两次快照之间如果宕机，会丢失这段时间的数据"}]},{"ID":"20260505170804-qs264fy","Type":"NodeParagraph","Properties":{"id":"20260505170804-qs264fy","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AOF 是日志持久化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把每一条写命令以日志形式追加到文件里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点是数据安全性更高，最多丢失 1 秒数据，日志可读可修复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是文件通常比 RDB 大，恢复速度慢，对性能影响相对大一点"}]},{"ID":"20260505170804-1ttegot","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ttegot","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"RDB 存的是数据最终状态，二进制紧凑，直接加载就能用，所以文件小、恢复快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AOF 存的是一条条命令，文件大，还要重放执行，所以慢"}]},{"ID":"20260505170804-h1zgmc6","Type":"NodeParagraph","Properties":{"id":"20260505170804-h1zgmc6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实际项目里一般"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"混合使用"},{"Type":"NodeText","Data":"："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 RDB 做全量备份、恢复快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 AOF 保证数据不丢，重启时优先加载 AOF，兼顾安全性和效率"}]},{"ID":"20260505170804-pvcjo0z","Type":"NodeTable","Data":"|对比项|RDB 快照|AOF 日志|\n| --------------| --------------------------| --------------------------|\n|原理|定时把内存数据\u003cspan data-type=\"strong\"\u003e全量快照\u003c/span\u003e保存到磁盘|把每条\u003cspan data-type=\"strong\"\u003e写命令\u003c/span\u003e追加记录到日志文件|\n|文件大小|小，二进制紧凑|大，文本命令，体积更大|\n|恢复速度|\u003cspan data-type=\"strong\"\u003e快\u003c/span\u003e|慢，需要重放命令|\n|数据安全性|可能丢最后一次快照后的数据|高，最多丢 \u003cspan data-type=\"strong\"\u003e1 秒数据\u003c/span\u003e|\n|对性能影响|小，fork 子进程后台执行|稍大，持续写盘、文件会膨胀|\n|适用场景|冷备、大数据量、快速恢复|要求数据安全、丢失少|\n|重启加载优先级|低|高，一般优先加载 AOF|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-pvcjo0z","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比项"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"RDB 快照"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"AOF 日志"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"原理"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"定时把内存数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全量快照"},{"Type":"NodeText","Data":"保存到磁盘"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"把每条"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"写命令"},{"Type":"NodeText","Data":"追加记录到日志文件"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"文件大小"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小，二进制紧凑"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大，文本命令，体积更大"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"恢复速度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"快"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"慢，需要重放命令"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据安全性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可能丢最后一次快照后的数据"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高，最多丢 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1 秒数据"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对性能影响"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小，fork 子进程后台执行"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"稍大，持续写盘、文件会膨胀"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"适用场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"冷备、大数据量、快速恢复"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"要求数据安全、丢失少"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"重启加载优先级"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"低"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"高，一般优先加载 AOF"}]}]}]},{"ID":"20260505170804-1t4812r","Type":"NodeParagraph","Properties":{"id":"20260505170804-1t4812r","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AOF 持久化的三种刷盘策略"}]},{"ID":"20260505170804-yr2djau","Type":"NodeParagraph","Properties":{"id":"20260505170804-yr2djau","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"always（同步刷盘）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每执行一条写命令，就立即写入硬盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：最安全，最多丢 0 条数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：性能最差，大 key 会直接阻塞主线程"}]},{"ID":"20260505170804-3iqm8d0","Type":"NodeParagraph","Properties":{"id":"20260505170804-3iqm8d0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"everysec（每秒刷盘 —— 默认）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每秒批量写一次硬盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：性能好，安全折中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：宕机最多丢 1 秒数据"}]},{"ID":"20260505170804-eofwo5k","Type":"NodeParagraph","Properties":{"id":"20260505170804-eofwo5k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"no（操作系统控制）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redis 不主动刷盘，由操作系统决定什么时候写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：性能最快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点：最不安全，宕机可能丢大量数据"}]},{"ID":"20260505170804-0b6hu84","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0b6hu84","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 主从复制"}]},{"ID":"20260505170804-sy3dtb9","Type":"NodeParagraph","Properties":{"id":"20260505170804-sy3dtb9","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260311175250808"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260311175250808.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-cg69kut","Type":"NodeParagraph","Properties":{"id":"20260505170804-cg69kut","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主从全量复制就是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从节点发起 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PSYNC"},{"Type":"NodeText","Data":"，主节点生成 RDB 并缓存增量命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先传 RDB 再传缓存命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从节点加载后，主节点再持续同步后续写命令，最终保证数据一致"}]},{"ID":"20260505170804-7am5jwl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7am5jwl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 分布式锁"}]},{"ID":"20260505170804-b4os8j2","Type":"NodeParagraph","Properties":{"id":"20260505170804-b4os8j2","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Redis 分布式锁 = 利用 Redis 单线程特性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通过 SET 命令抢占一个 key，实现多进程 / 多服务互斥访问"}]},{"ID":"20260505170804-mu0lirs","Type":"NodeParagraph","Properties":{"id":"20260505170804-mu0lirs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实现命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"SET lock_key unique_value NX PX 30000"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"lock_key：锁的 key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"unique_value：唯一标识（防止误删别人的锁）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"NX：只有 key 不存在才设置（互斥抢占）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"PX 30000：过期时间 30s（防止死锁）"}]},{"ID":"20260505170804-ce1xntf","Type":"NodeParagraph","Properties":{"id":"20260505170804-ce1xntf","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"互斥性"},{"Type":"NodeText","Data":"：同一时间只有一个客户端能拿到锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防死锁"},{"Type":"NodeText","Data":"：必须设置过期时间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"防误删"},{"Type":"NodeText","Data":"：释放锁时要判断 value 是不是自己的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高可用"},{"Type":"NodeText","Data":"：Redis 集群可用时就能加锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最终一致性"},{"Type":"NodeText","Data":"：属于最终一致性锁，不是强一致"}]},{"ID":"20260505170804-h6yhqre","Type":"NodeParagraph","Properties":{"id":"20260505170804-h6yhqre","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解锁流程"}]},{"ID":"20260505170804-9kocqnd","Type":"NodeParagraph","Properties":{"id":"20260505170804-9kocqnd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"获取 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lock_key"},{"Type":"NodeText","Data":" 对应的 value"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"判断是不是自己加锁时的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unique_value"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是自己的锁 → 删除 key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是 → 不删"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最佳实践：用 Lua 脚本保证原子性"}]},{"ID":"20260505170804-59cp94d","Type":"NodeParagraph","Properties":{"id":"20260505170804-59cp94d","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"三大问题 \u0026 解决方案"}]},{"ID":"20260505170804-ki9xzqq","Type":"NodeParagraph","Properties":{"id":"20260505170804-ki9xzqq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"任务超时，锁过期 -\u003e 其他线程拿到锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：自动续期（看门狗机制）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"启动后台线程，检测锁快过期时自动延长过期时间"}]},{"ID":"20260505170804-qu31mx1","Type":"NodeParagraph","Properties":{"id":"20260505170804-qu31mx1","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主从切换，锁丢失（Redis 主从异步复制）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：Redlock 红锁（不推荐生产用）/ 使用 Redisson + 集群优化实际企业大多接受小概率锁丢失，追求性能"}]},{"ID":"20260505170804-ry28aw3","Type":"NodeParagraph","Properties":{"id":"20260505170804-ry28aw3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"(客户端向 Master 加锁：SET lock NX PX 30000"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Master 加锁成功，返回客户端 “拿到锁了”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还没来得及把锁同步给 Slave，Master 突然宕机"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哨兵（Sentinel）检测到宕机，把 Slave 提升为新 Master"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新 Master 里没有这个锁！"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另一个客户端来加锁，加锁成功)"}]},{"ID":"20260505170804-jxei1pu","Type":"NodeParagraph","Properties":{"id":"20260505170804-jxei1pu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"误删别人的锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决：加锁时存唯一值，解锁时判断再删"}]},{"ID":"20260505170804-5oajr9u","Type":"NodeParagraph","Properties":{"id":"20260505170804-5oajr9u","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"红锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redlock 是 Redis 官方提出的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"强一致分布式锁"},{"Type":"NodeText","Data":"方案，它放弃主从架构，采用多台完全独立的 Redis 节点，加锁时需在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"过半节点"},{"Type":"NodeText","Data":"上加锁成功才算有效，以此避免主从异步复制导致的锁丢失问题。"}]},{"ID":"20260505170804-2rrxdac","Type":"NodeParagraph","Properties":{"id":"20260505170804-2rrxdac","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为什么生产不推荐（一段话）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Redlock 性能差、需要向多台节点同步加锁，且严重依赖机器时钟，一旦时钟漂移就会出现锁安全性问题，实现复杂且风险高，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"实际企业几乎不用"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-qfeb7vw","Type":"NodeParagraph","Properties":{"id":"20260505170804-qfeb7vw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"redission+ 集群优化"}]},{"ID":"20260505170804-27h2e2t","Type":"NodeParagraph","Properties":{"id":"20260505170804-27h2e2t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"企业实际常用 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Redisson + Redis 集群"},{"Type":"NodeText","Data":" 的方案，Redisson 封装了完整的分布式锁逻辑，包括自动加锁、防误删、看门狗自动续期，能直接对接 Redis 集群，使用简单且性能极高，但它"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"没有解决主从异步复制带来的锁丢失问题"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-so9zntt","Type":"NodeParagraph","Properties":{"id":"20260505170804-so9zntt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为什么企业选择这套方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为主从切换本身概率很低，锁丢失属于极端小概率事件，相比复杂且低效的 Redlock，这种方案性价比更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"即便极罕见地出现锁失效，也可以通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"业务幂等、重试、日志校验"},{"Type":"NodeText","Data":"等方式兜底，在性能和一致性之间做了更务实的平衡"}]},{"ID":"20260505170804-xrf0ao7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xrf0ao7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 6.0 为什么引入多线程？"}]},{"ID":"20260505170804-sckloe8","Type":"NodeParagraph","Properties":{"id":"20260505170804-sckloe8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不是为了多核并发执行命令，而是为了解决网络 IO 瓶颈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多线程只用来并行处理网络 IO 读写，大幅提升吞吐量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"命令执行依然是单线程，保证原子性、不加锁最终在不破坏原有特性的前提下，突破网络性能瓶颈"}]},{"ID":"20260505170804-2emp2zh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2emp2zh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"布隆过滤器作用 \u0026 原理\t\t\u003e\u003e"}]},{"ID":"20260505170804-0c91g8j","Type":"NodeParagraph","Properties":{"id":"20260505170804-0c91g8j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"布隆过滤器用于判断元素是否存在，核心是 bit 数组 + 多个哈希函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"添加时将多个哈希位置置 1，查询时判断对应位"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不存在一定不存在，存在可能误判"}]},{"ID":"20260505170804-viqaux2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-viqaux2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何保证缓存与数据库双写时的数据一致性？"}]},{"ID":"20260505170804-pd3xsdv","Type":"NodeParagraph","Properties":{"id":"20260505170804-pd3xsdv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先写缓存再写数据库、先写数据库再写缓存，这两种方案都"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"绝对不能用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为一旦一方成功、一方失败，就会产生长期脏数据，而且并发场景下会出现乱序覆盖，一致性完全无法保证"}]},{"ID":"20260505170804-54i3hnn","Type":"NodeParagraph","Properties":{"id":"20260505170804-54i3hnn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先删缓存，再更新数据库这种方案在高并发下，会出现查询线程把旧数据写回缓存，导致不一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解决方法是延迟双删：写完数据库后，延迟几百毫秒再删一次缓存，把可能回写的旧缓存清理掉，保证最终一致"}]},{"ID":"20260505170804-idje8u0","Type":"NodeParagraph","Properties":{"id":"20260505170804-idje8u0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先更新数据库，再删除缓存这是最推荐、最主流的方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只会出现极短时间的旧数据，不会产生长期脏数据。如果删除缓存失败，可以通过消息队列重试，或者监听 MySQL binlog 异步删除缓存。其中 binlog 方案最优，和业务解耦，一致性最强、最可靠。"}]},{"ID":"20260505170804-51a879d","Type":"NodeParagraph","Properties":{"id":"20260505170804-51a879d","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260311203418993"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260311203418993.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-jg6iq25","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jg6iq25","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 是单线程的，如何提高多核 CPU 的利用率？"}]},{"ID":"20260505170804-vmcwz3q","Type":"NodeParagraph","Properties":{"id":"20260505170804-vmcwz3q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可以在同一个服务器部署多个 Redis 的实例，并把他们当作不同的服务器来使用，在某些时候，无论如何一个服务器是不够的， 所以，如果想使用多个 CPU，你可以考虑一下"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分片"}]},{"ID":"20260505170804-ku151fs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ku151fs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 Redis 的大 key？"}]},{"ID":"20260505170804-m4r5bo5","Type":"NodeParagraph","Properties":{"id":"20260505170804-m4r5bo5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"指的是单个 key 对应的 value 体积过大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者单个 key 包含的元素数量极多的 key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个很大的 String、一个包含几十万成员的 Hash/Set/List/ZSet 都属于大 Key"}]},{"ID":"20260505170804-4row0p5","Type":"NodeParagraph","Properties":{"id":"20260505170804-4row0p5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"行业里比较通用的经验标准是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"String 类型 value 大小超过 10KB 或 100KB 就可以视为大 Key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"复合类型（Hash/Set/List 等）元素数量超过 几千甚至上万，也会被当作大 Key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实际中只要单次操作耗时明显变长、影响响应，就可以认为是大 Key"}]},{"ID":"20260505170804-utuxavj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-utuxavj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 的大 key 有什么影响"}]},{"ID":"20260505170804-lxv0360","Type":"NodeParagraph","Properties":{"id":"20260505170804-lxv0360","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，Redis 是单线程处理命令的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大 Key 的读写、删除、过期删除等操作都会长时间占用主线程，导致其他正常请求排队阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接引发请求超时、接口响应变慢，严重时甚至让 Redis 看起来像假死"}]},{"ID":"20260505170804-tragm06","Type":"NodeParagraph","Properties":{"id":"20260505170804-tragm06","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，大 Key 在网络传输时会占用大量带宽"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一次返回的数据量过大，容易造成网络流量突刺、网络延迟升高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不仅影响 Redis 本身，还会挤占同机器其他服务的网络资源"}]},{"ID":"20260505170804-fb79og0","Type":"NodeParagraph","Properties":{"id":"20260505170804-fb79og0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在 Redis 集群模式下，大 Key 的问题会更突出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为一个 key 只会被哈希到固定一个节点，无法分散到多个节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会导致该节点的 CPU、内存、网络压力远高于其他节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"出现数据倾斜和负载不均，进而拖慢整个集群的稳定性和性能"}]},{"ID":"20260505170804-u4zzr82","Type":"NodeParagraph","Properties":{"id":"20260505170804-u4zzr82","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总结"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"阻塞主线程：Redis 单线程执行，大 key 操作耗时，直接导致请求超时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网络阻塞：数据量大，占用带宽高，引发流量突刺和延迟升高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"集群倾斜：一个 key 只能落在一个节点，造成单节点压力过大，负载不均"}]},{"ID":"20260505170804-04cm2ln","Type":"NodeParagraph","Properties":{"id":"20260505170804-04cm2ln","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大 key 对持久化的影响"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AOF 阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"always 策略：大 key 会让 文件同步(刷盘)变慢，阻塞主线程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"everysec、no 策略：基本不受影响"}]},{"ID":"20260505170804-6h8ivm9","Type":"NodeParagraph","Properties":{"id":"20260505170804-6h8ivm9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"RDB/AOF 重写阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大 Key 多 → 内存占用高 → fork 耗时变长 → 主线程阻塞更久"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"fork 时：内存越大，复制页表越慢，阻塞越久"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写时复制：修改大 key 会拷贝物理内存，加剧主线程阻塞"}]},{"ID":"20260505170804-wu5vjq5","Type":"NodeParagraph","Properties":{"id":"20260505170804-wu5vjq5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"always：每次写都刷盘，最安全，最慢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"everysec：每秒刷一次，性能安全均衡，默认推荐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"no：不主动刷盘，最快，但丢数据风险大"}]},{"ID":"20260505170804-z0jsk8p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z0jsk8p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 Redis 的热 Key？热 Key 的判定标准是什么？\t\u003e\u003e"}]},{"ID":"20260505170804-g8p72li","Type":"NodeParagraph","Properties":{"id":"20260505170804-g8p72li","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单说就是被访问频率特别高、流量高度集中的单个 Key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大量请求在短时间内都去查询或操作这一个 Key，导致它所在的 Redis 节点压力远高于其他节点，这类 Key 就叫热 Key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如秒杀活动里的商品库存、首页热点配置、热门榜单信息，都很容易变成热 Key"}]},{"ID":"20260505170804-nf7cvsi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nf7cvsi","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"热 Key 会导致 Redis 的雪崩问题，Redis 雪崩的核心产生原因是什么？\t\u003e\u003e"}]},{"ID":"20260505170804-kon45h8","Type":"NodeParagraph","Properties":{"id":"20260505170804-kon45h8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"热 Key 引发的 Redis 雪崩，本质是高并发热点流量在集群分片间形成连锁压垮效应"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"和传统大量 Key 同时过期的雪崩不一样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单个热 Key 会固定哈希到某一个分片节点，极高的访问 QPS 会先把这个节点的 CPU、网络、带宽打满，让该分片直接阻塞甚至不可用当第一个分片崩溃后，原本的热点请求并不会消失，而是会被转发、重定向到其他分片尝试承接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结果就是热 Key 的流量像洪水一样扩散，把下一层节点也迅速打满拖垮，形成金字塔式的连锁崩溃，从上到下一层接一层失效"}]},{"ID":"20260505170804-r57pjwp","Type":"NodeParagraph","Properties":{"id":"20260505170804-r57pjwp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"只要热 Key 持续存在、高并发流量不消失，这个循环就无法停止"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分片会不断被打满、不断崩溃，最终整个 Redis 集群全面瘫痪"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有彻底解决热 Key 问题，才能终止这种链式雪崩，恢复集群稳定"}]},{"ID":"20260505170804-bmlejk5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bmlejk5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何避免 Redis 集群中的资源倾斜问题？\t\u003e\u003e"}]},{"ID":"20260505170804-8vywqwn","Type":"NodeParagraph","Properties":{"id":"20260505170804-8vywqwn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"要避免 Redis 集群资源倾斜，核心就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"打散热点、打散大 Key、让压力均匀分布到各个节点"}]},{"ID":"20260505170804-28yltm9","Type":"NodeParagraph","Properties":{"id":"20260505170804-28yltm9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先要提前识别并处理热 Key"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如把热 Key 做本地缓存、多级缓存，或者拆分成多个备份 Key 分散到不同槽位，不让流量集中打在一个分片上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次要清理大 Key，大 Key 会独占节点资源，必须拆分成小 Key，避免单个节点内存、网络被占满"}]},{"ID":"20260505170804-1xyc1kl","Type":"NodeParagraph","Properties":{"id":"20260505170804-1xyc1kl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后要合理使用集群分片和哈希槽，保证槽位均匀分配，不要手动指定节点导致分布不均"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时避免使用过长、过于集中的键名规则，防止大量 Key 被哈希到同一节点"}]},{"ID":"20260505170804-w9m4qm6","Type":"NodeParagraph","Properties":{"id":"20260505170804-w9m4qm6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外，开启合理的集群均衡策略，让节点负载高时能自动迁移槽位，避免持续倾斜"}]},{"ID":"20260505170804-p5vkfj5","Type":"NodeParagraph","Properties":{"id":"20260505170804-p5vkfj5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后还要做好监控，实时观察各节点的 CPU、内存、流量、连接数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦出现倾斜及时扩容或迁移数据，防止单点压力过大拖垮整个集群"}]},{"ID":"20260505170804-93pgkbp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-93pgkbp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Redis 分区有什么缺点？"}]},{"ID":"20260505170804-hgxsyh9","Type":"NodeParagraph","Properties":{"id":"20260505170804-hgxsyh9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不支持跨节点多键操作多个 key 如果分布在不同 Redis 实例，就不能执行事务、交集、并集等批量操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分区粒度是单个 key 只能以 key 为单位分区，不能把一个大 key 拆分存储，要避免使用超大 big key。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据运维更复杂备份、持久化时，需要从多个节点分别收集 RDB/AOF 文件，统一管理成本更高。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态扩缩容复杂虽然 Redis 集群支持在线扩容、数据迁移，但相比单机更复杂"}]},{"ID":"20260505170804-4q1aa55","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4q1aa55","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 和数据库一致性"}]},{"ID":"20260505170804-wo6od9g","Type":"NodeParagraph","Properties":{"id":"20260505170804-wo6od9g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"**旁路缓存\t**\t最常用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读：先查缓存，命中直接返回；未命中查数据库，写入缓存后返回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写：先更新数据库再删除缓存\t（避免数据库旧值覆盖缓存新值的并发问题）"}]},{"ID":"20260505170804-vo3e7qu","Type":"NodeParagraph","Properties":{"id":"20260505170804-vo3e7qu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"延迟双删"},{"Type":"NodeText","Data":"\t\t解决并发脏读"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写操作流程：删除缓存-更新数据库-延迟（500ms）再次删除缓存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防止极小概率主从延迟，写主库成功，删缓存了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读请求立刻去从库读了旧数据，回填旧缓存"}]},{"ID":"20260505170804-f1ltw73","Type":"NodeParagraph","Properties":{"id":"20260505170804-f1ltw73","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"**异步更新缓存\t**\t最终一致性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于 binlog 订阅 (如 canel)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据变更后通过消息队列异步自动删除缓存，业务代码不用手动维护缓存，只能做到最终一致性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"更新数据库后，通过消息队列异步更新/删除缓存，适合对一致性要求不高的场景（商品详情）"}]},{"ID":"20260505170804-109lh1w","Type":"NodeParagraph","Properties":{"id":"20260505170804-109lh1w","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分布式锁"},{"Type":"NodeText","Data":"\t\t强一致性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读写操作加分布式锁，同一时间只允许一个线程操作，保证强一致性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但性能损耗大，适合金融级场景"}]},{"ID":"20260505170804-0k9ldi6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0k9ldi6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"redis 与 mysql 保持数据一致性时存不存在 redis 更新到 mysql 的情况"}]},{"ID":"20260505170804-vjnypbt","Type":"NodeParagraph","Properties":{"id":"20260505170804-vjnypbt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存在的"}]},{"ID":"20260505170804-w8zf2qk","Type":"NodeParagraph","Properties":{"id":"20260505170804-w8zf2qk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常规旁路缓存是以 MySQL 为基准，先更数据库、再删更缓存"}]},{"ID":"20260505170804-3y9wbu5","Type":"NodeParagraph","Properties":{"id":"20260505170804-3y9wbu5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但高并发、计数、秒杀、点赞场景会反过来："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先写 Redis 做缓冲，再通过定时任务、消息队列异步批量把 Redis 数据落地到 MySQL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有写回缓存架构、数据库降级暂存，也都是 Redis 先更新，再同步到 MySQL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属于最终一致性方案"}]},{"ID":"20260505170804-do3ived","Type":"NodeParagraph","Properties":{"id":"20260505170804-do3ived","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"这类场景"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不需要强实时一致"},{"Type":"NodeText","Data":"，允许 Redis 先更新、MySQL 延后同步"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只要最终数据对上就行，牺牲瞬时一致性换高并发性能"}]},{"ID":"20260505170804-jmldngk","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-jmldngk","updated":"20260505170804"}},{"ID":"20260505170804-1o7tsmo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-1o7tsmo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"MySQL"}]},{"ID":"20260505170804-6ikjw1q","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-6ikjw1q","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"什么是数据库"}]},{"ID":"20260505170804-0z0phzo","Type":"NodeParagraph","Properties":{"id":"20260505170804-0z0phzo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据库是 “按照数据结构来组织、存储和管理数据的仓库”。是一个长期存储在计算机内的、有组织的、可共享的、统一管理的大量数据的集合。"}]},{"ID":"20260505170804-l082tr2","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-l082tr2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据库的由来？"}]},{"ID":"20260505170804-rydcr8f","Type":"NodeParagraph","Properties":{"id":"20260505170804-rydcr8f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"规范化的本地存储 加密 共享"}]},{"ID":"20260505170804-j1afynh","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-j1afynh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据库的分类"}]},{"ID":"20260505170804-1z634lt","Type":"NodeParagraph","Properties":{"id":"20260505170804-1z634lt","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关系型数据库：其实就是二维表，典型代表 mysql(不区分大小写),oracle,SQL Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非关系型数据库：也叫 NoSQL，是一维映射 key-value 典型代表 redis，MongoDB"}]},{"ID":"20260505170804-n2ogfn0","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-n2ogfn0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"运行 sql 语句"}]},{"ID":"20260505170804-ydlyzkc","Type":"NodeParagraph","Properties":{"id":"20260505170804-ydlyzkc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.带光标的闪电：运行光标所在行的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.不带光标的闪电：没有选择任何 sql 语句时，从文件开头执行所有 sql 语句（如果中间有执行失误，停止执行）；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"选择了一条或者多条 sql 语句，就是执行所用选择的 sql 语句"}]},{"ID":"20260505170804-wezl3ff","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-wezl3ff","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"数据类型"}]},{"ID":"20260505170804-18favvk","Type":"NodeParagraph","Properties":{"id":"20260505170804-18favvk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.char(45):\t一个字符占一个字节，固定长度 45，无论字符串多少都占 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.nchar(45):\t采用宽字符集，一个字符占两个字节，无论字符串多少，都占 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.varchar(45):\t一个字符占一个字节，最大长度 45，实际存多长数据，就占多少字节，不能超过 45 个字节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.nvarchar(45):\t采用宽字符集，一个字符占两个字节，实际存多少数据就占多少字节，不能超过 45 个字节"}]},{"ID":"20260505170804-j8dk25a","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-j8dk25a","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"建表约束"}]},{"ID":"20260505170804-6apz738","Type":"NodeParagraph","Properties":{"id":"20260505170804-6apz738","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"1.主键："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"primary key"},{"Type":"NodeText","Data":" 每个表中只能有一列是主键列，主键列的值不允许重复，并且不能为空（数据库会给主键列创建索引查找速度快）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.唯一："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"unique"},{"Type":"NodeText","Data":" 数据不允许重复，但是可以为空"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.不为空："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"not null"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.默认值："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"default"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"5.自增："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"auto_increment"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"6.外键约束："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"foreign key"},{"Type":"NodeText","Data":" 跟其他表里的某一列或某几列有关系 通过一些计算公式算出来的结果"}]},{"ID":"20260505170804-jutytdc","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-jutytdc","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#注释使用\n#sql以分号为结尾\n#设置默认使用的库（查表的时候就不用专门指定库了，没有指定库的时候就在默认使用的库中查找表）\nuse 20240318test;\n\n#创建表\ncreate table 表名(列名 数据类型 建表约束,列名 数据类型 建表约束,...);\n#例子\ncreate table studentInfo(\n\tid int primary key auto_increment,\n\tname varchar(20) unique not null,\n\tsex enum('男','女'),\n\tage int default 18\n);\n\n#修改表\nalter table 表名 ...;\n#增加列\nalter table 表名 add column 列名 数据类型 建表约束;\n#增加列的属性：\nalter table 表名 modify 列名 数据类型 建表约束;\n#删除列：\nalter table 表名 drop 列名;\n#删除表：\ndrop table 表名;\n\n#查询数据\nselect 列名1，列名2... from 表名;\n#查询所有列的数据\nselect * from 表名;\n#给查询的列名起别名\nselect 列名1 别名1,列名2 别名2... from 表名;\n\n#插入数据\n#插入所有列的数据(要求数据的顺序必须和表中列的顺序一致)\ninsert into 表名 values(值1，值2，值3...);\n#插入部分列的数据\ninsert into 表名 (列名1，列名2，列名3...)values(值1，值2，值3...);\n\n#更新数据\nupdate 表名 set 列名 = 值 where 条件表达式;\n\n#删除表中的所有数据\ndelete from 表名;\n#删除表中满足条件行的数据\ndelete from 表名 where 条件表达式;\n\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-h8x5ow1","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-h8x5ow1","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"数据库范式"}]},{"ID":"20260505170804-nlj2hp0","Type":"NodeParagraph","Properties":{"id":"20260505170804-nlj2hp0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常见名词"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"属性-\u003e 特征-\u003e 表中的一列-\u003e 字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"元组：表的一行就叫一个元组"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"码：表中唯一确定一个元组的属性，码不止一个，叫这些为候选码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主码：从候选码挑选出来一个主要确定这一行的属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主属性：只要在任何一个候选码中出现过，这个属性就叫主属性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非主属性：没有在任何一个候选码中出现过"}]},{"ID":"20260505170804-odmps6d","Type":"NodeParagraph","Properties":{"id":"20260505170804-odmps6d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"数据库范式"}]},{"ID":"20260505170804-im613vi","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-im613vi","updated":"20260505170804"},"Children":[{"ID":"20260505170804-2i6idyq","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-2i6idyq","updated":"20260505170804"},"Children":[{"ID":"20260505170804-afnd5x8","Type":"NodeParagraph","Properties":{"id":"20260505170804-afnd5x8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1NF（原子性）"},{"Type":"NodeText","Data":"：列值不可再分，比如 “联系方式” 拆为 “手机号 + 邮箱”。"}]}]},{"ID":"20260505170804-runk5uo","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-runk5uo","updated":"20260505170804"},"Children":[{"ID":"20260505170804-0dvrrzu","Type":"NodeParagraph","Properties":{"id":"20260505170804-0dvrrzu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2NF（消除部分依赖）"},{"Type":"NodeText","Data":"：非主键列需完全依赖主键，用拆分表解决复合主键的部分依赖（如拆 “学生 - 课程 - 成绩” 为学生表、课程表、成绩表）。"}]}]},{"ID":"20260505170804-wuzllaa","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-wuzllaa","updated":"20260505170804"},"Children":[{"ID":"20260505170804-ew6f4er","Type":"NodeParagraph","Properties":{"id":"20260505170804-ew6f4er","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3NF（消除传递依赖）"},{"Type":"NodeText","Data":"：非主键列不能依赖其他非主键列（如 “学生表” 去掉 “班级名称”，单独建班级表关联）。"}]}]},{"ID":"20260505170804-ibr31sz","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-ibr31sz","updated":"20260505170804"},"Children":[{"ID":"20260505170804-8z7twza","Type":"NodeParagraph","Properties":{"id":"20260505170804-8z7twza","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"BCNF（鲍依斯-科得范式）"},{"Type":"NodeText","Data":"：不存在关键字段决定关键字段（如 仓库管理系统（仓库 ID 存储物品 ID 管理员 ID 数量）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"改进：仓库管理：仓库 ID，管理员 ID        仓库：仓库 ID 存储物品 ID 数量"}]}]}]},{"ID":"20260505170804-j9qdo0v","Type":"NodeTable","Data":"|条件类型|语法格式|说明（含兼容性）|示例（表名：\u003cspan data-type=\"code\"\u003estudent\u003c/span\u003e，列：\u003cspan data-type=\"code\"\u003eid\u003c/span\u003e/\u003cspan data-type=\"code\"\u003eage\u003c/span\u003e/\u003cspan data-type=\"code\"\u003ename\u003c/span\u003e）|\n| ------------| -------------------------------------| ---------------------------------------------| ----------------------|\n|相等|列名 = 值|精确匹配（值为字符串需加单引号）|\u003cspan data-type=\"code\"\u003eWHERE id = 101\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name = '张三'\u003c/span\u003e|\n|不相等|列名！= 值 或 列名 \u003c\u003e 值|\u003cspan data-type=\"code\"\u003e\u0026lt;\u0026gt;\u003c/span\u003e 是标准语法（所有数据库兼容），\u003cspan data-type=\"code\"\u003e!=\u003c/span\u003e 仅 MySQL 支持|\u003cspan data-type=\"code\"\u003eWHERE age != 18\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name \u0026lt;\u0026gt; '李四'\u003c/span\u003e|\n|大于|列名 \u003e 值|-|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt; 20\u003c/span\u003e|\n|小于|列名 \u003c 值|-|\u003cspan data-type=\"code\"\u003eWHERE score \u0026lt; 60\u003c/span\u003e|\n|大于等于|列名 \u003e= 值|-|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt;= 18\u003c/span\u003e|\n|小于等于|列名 \u003c= 值|-|\u003cspan data-type=\"code\"\u003eWHERE score \u0026lt;= 100\u003c/span\u003e|\n|或者|条件 1 OR 条件 2 或 条件 1 \\|\\| 条件 2|两者等价，\u003cspan data-type=\"code\"\u003eOR\u003c/span\u003e 更通用|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt; 20 OR score \u0026gt;= 90\u003c/span\u003e|\n|并且|条件 1 AND 条件 2 或 条件 1 \u0026\u0026 条件 2|两者等价，\u003cspan data-type=\"code\"\u003eAND\u003c/span\u003e 更通用|\u003cspan data-type=\"code\"\u003eWHERE age \u0026gt;= 18 AND name = '张三'\u003c/span\u003e|\n|介于两者之间|列名 BETWEEN 值 1 AND 值 2|闭区间（包含值 1 和值 2），等价于 \u003cspan data-type=\"code\"\u003e\u0026gt;= AND \u0026lt;=\u003c/span\u003e|\u003cspan data-type=\"code\"\u003eWHERE age BETWEEN 18 AND 25\u003c/span\u003e（等价于 \u003cspan data-type=\"code\"\u003eage \u0026gt;=18 AND age \u0026lt;=25\u003c/span\u003e）|\n|在范围内|列名 IN (值 1, 值 2, ..., 值 N)|匹配括号内任意一个值，支持多值|\u003cspan data-type=\"code\"\u003eWHERE id IN (101, 102, 103)\u003c/span\u003e / \u003cspan data-type=\"code\"\u003eWHERE name IN ('张三', '王五')\u003c/span\u003e|\n|不在范围内|列名 NOT IN (值 1, 值 2, ..., 值 N)|与 \u003cspan data-type=\"code\"\u003eIN\u003c/span\u003e 相反，不匹配括号内任何值|\u003cspan data-type=\"code\"\u003eWHERE age NOT IN (16, 17, 19)\u003c/span\u003e|","TableAligns":[0,0,0,0],"Properties":{"id":"20260505170804-j9qdo0v","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"语法格式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说明（含兼容性）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"示例（表名："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"student"},{"Type":"NodeText","Data":"，列："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"id"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"age"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"name"},{"Type":"NodeText","Data":"）"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"相等"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 = 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"精确匹配（值为字符串需加单引号）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE id = 101"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name = '张三'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不相等"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名！= 值 或 列名 \u003c\u003e 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\u0026lt;\u0026gt;"},{"Type":"NodeText","Data":" 是标准语法（所有数据库兼容），"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!="},{"Type":"NodeText","Data":" 仅 MySQL 支持"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age != 18"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name \u0026lt;\u0026gt; '李四'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003e 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt; 20"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003c 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE score \u0026lt; 60"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"大于等于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003e= 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt;= 18"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"小于等于"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 \u003c= 值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"-"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE score \u0026lt;= 100"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"或者"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件 1 OR 条件 2 或 条件 1 "},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"|"}]},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"|"}]},{"Type":"NodeText","Data":" 条件 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"两者等价，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"OR"},{"Type":"NodeText","Data":" 更通用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt; 20 OR score \u0026gt;= 90"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"并且"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"条件 1 AND 条件 2 或 条件 1 \u0026\u0026 条件 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"两者等价，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AND"},{"Type":"NodeText","Data":" 更通用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age \u0026gt;= 18 AND name = '张三'"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"介于两者之间"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 BETWEEN 值 1 AND 值 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"闭区间（包含值 1 和值 2），等价于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"\u0026gt;= AND \u0026lt;="}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age BETWEEN 18 AND 25"},{"Type":"NodeText","Data":"（等价于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"age \u0026gt;=18 AND age \u0026lt;=25"},{"Type":"NodeText","Data":"）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"在范围内"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 IN (值 1, 值 2, ..., 值 N)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"匹配括号内任意一个值，支持多值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE id IN (101, 102, 103)"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE name IN ('张三', '王五')"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不在范围内"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"列名 NOT IN (值 1, 值 2, ..., 值 N)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"IN"},{"Type":"NodeText","Data":" 相反，不匹配括号内任何值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WHERE age NOT IN (16, 17, 19)"}]}]}]},{"ID":"20260505170804-437w0ul","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-437w0ul","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#查询年龄超过15岁的女同学\nselect * from studentinfo where age\u003e15 and sex='女';\n#年龄超过18岁，或者性别是男的同学\nselect * from studentinfo where age \u003e18 or sex='男';\n#查询年龄在18岁到20岁之间的同学\nselect * from sutdentinfo where age between 18 and 20;  (是闭合区间)\n#查询年龄在15,18,20范围内的同学\nselect * from studentinfo where age not in(15,18,20);\n\n#模糊查询\nwhere 列名 like 模糊表达式;\n#模糊表达式\n\t%:匹配0~n个字符\n\t_:匹配1个字符\n#查询班级中姓朱的同学\nselect * from studentinfo where name like '朱%';\n\n#分页查找\nlimit a,b;\t(a是起始行数,从0开始计算;b是总共显示多少行数据)\nselect * from studentinfo limit 3,5;\n\n#聚合函数\t统计个数(查行数)\ncount()\n统计班级中有多少名同学(查询student表中有多少行数据)\nselect count(*) from student;\n单独查name列有多少行\nselect count(name) from student;\n#求和\t\nsum()\n#计算最大值\nmax()\n#计算最小值\nmin()\n#计算平均值\navg()\n\n#分组(计算每个):\t\ngroup by 列名\n计算每门科目的总分\nselect C,sum(score) \n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-7ol1jwa","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-7ol1jwa","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#查询总成绩高于200分的学生的编号\n#\t1.查询每个学生的总成绩\t2.加条件：总成绩高于200分 3.根据学生的编号查询学生的信息\nselect S,sum(score) from sc having sum(score)\u003e200; # 1 2\nselect * from student where S in (select S,sum(score) from sc having sum(score)\u003e200);# 3\n\n#添加条件：where or having\n#当作为条件的列是表中原来就有的，就使用where加条件\n#当作为条件的列不是表中原来就有的，使用having来加条件\n\n#排序：\norder by 列名 排序规则(升序asc/降序desc);\t\t#如果不写排序规则 默认是升序排列\n#给学生编号按照平均成绩降序排列\n#1. 计算每个同学的平均成绩\t2.按照平均成绩降序排列\t\nselect S,avg(score)from sc group by S order by avg(score) desc;\n\n#练习：\n#1.查询每门课程被选修的学生数\nselect C,count(*) from sc group by C;\n\n#2.检索至少选修两门课程的学生学号\n\t#查询每个学生选修的课程个数,个数\u003e=2\nselect S,count(*)from sc group by S having count(*)\u003e=2;\n\n#3.求这些学号对应的个人信息\nselect * from student where S in(select S,count(*)from sc group by S having count(*)\u003e=2);\n\n#4.查询选修了全部课程的学生信息\n\t#查询每个同学选修课程的个数\t查询总的课程的个数\t=\t查询这些学生个信息\nselect * from student where S in (select S from sc group by S having count(*)=(select count(*) from course));\n\n#5.查询没有学全部课程的学生信息\nselect * from student where S not in (select S from sc group by S having count(*)=(select count(*) from course));\n\n#6.查询学过张三老师授课的同学的信息\nselect * from student where \n\tS in(select S from sc where C in (select C from course where T =(select T from teacher where Tname='张三')));\n\n#7.查询没学过张三老师授课的同学的信息\nselect * from student where S not in\n\t(select S from sc where C in (select C from course where T =(select T from teacher where Tname='张三')));\n\n#8.查询每个同学01课程的成绩，包括个人信息\n\t#查询每个同学01课程的成绩\nselect S,score from sc where C='01';\n\t#查询每个同学的个人信息\nselect *from student;\n\t#把列拼接到一张表中\nselect *,(select S,score from sc where C='01'and sc.S=student.S) 01score from student;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-85uw2g6","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-85uw2g6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"联表查询"}]},{"ID":"20260505170804-ysf9jsb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ysf9jsb","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"内联:  select * from 表1 inner join 表2 on 连接条件 (inner join.....);\n左联： select * from 表1 left join 表2 on 连接条件 (left join.....);\n右联： select * from 表1 right join 表2 on 连接条件 (right join.....);\n笛卡尔积： select * from 表1 , 表2 where 连接条件;\n\n区别：\n\t内联：去两个表的交集进行连接，不会出现空属性\n\t左联：以左边的表为基准，匹配行，如果没有相应属性就是空\n\t右联：以右边的表为基准，匹配行，如果没有相应属性就是空\n 笛卡尔积：结果和内联结果一致 采用先排列组合，在按照条件筛选结果，执行效率低，不推荐使用\n \n 去重： distinct\n select distinct s,c from sc;\n \n 联合： select 语句1 union all select 语句2; (两个select的结果列要相同) \n # 查询男生和女生的人数\nselect count(*) from student where Ssex='男'\nunion all\nselect count(*) from student where Ssex='女'\n\n做题三步骤：1.联表 2.加条件 3.筛选显示的列\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-8celtxa","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-8celtxa","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"视图"}]},{"ID":"20260505170804-faty4cg","Type":"NodeParagraph","Properties":{"id":"20260505170804-faty4cg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"view，为了简化复杂的 sql 查询语句而提出来的概念。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"视图是一个表或者多个表导出的虚拟表，不是真实存在的，所以不需要满足范式的要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"视图创建以后就永久的保存在数据库中，可以按照表名规则使用视图，达到一个简化的目的"}]},{"ID":"20260505170804-fx5sc8o","Type":"NodeParagraph","Properties":{"id":"20260505170804-fx5sc8o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用视图：跟表的使用方式一样（但是只能查询数据）"}]},{"ID":"20260505170804-zrigmw8","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-zrigmw8","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"创建视图\tcreate view 视图名 as (select 语句);\n删除视图\tdrop view 视图名;\n\n视图的优点：sql语句在网络中传输，使用视图可以减少流量，更安全。\n视图的缺点：执行效率不会提高，执行的还是原来的sql语句\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-qdrlxyh","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-qdrlxyh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"函数"}]},{"ID":"20260505170804-txwk8hi","Type":"NodeParagraph","Properties":{"id":"20260505170804-txwk8hi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自定义函数:function"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重新声明结束标志：delimiter  // \t\t\t\t\t\t\t声明//为新的结束标志"}]},{"ID":"20260505170804-toj4zw4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-toj4zw4","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"创建函数语法：\ndelimiter //\t    #声明//为结束标志\ncreate function 函数名(参数1 数据类型,参数2 数据类型, ...)\nreturns 返回值类型\nbegin\n函数语句;\n函数语句;\n...\nend //\ndelimiter ;\t\t\t#重新声明;为结束标志\n\n调用函数： select 函数名(参数列表);\n删除：\t   drop function 函数名;\n先判断是否存在，再删除: drop function if exists 函数名;\n\n#例子：实现一个加法函数\ndelimiter //\ncreate function myadd(a int,b int)\nreturns int\nbegin\n\tdeclare c int default 0;\n\tset c=a+b;\n\treturn c;\nend //\ndelimiter;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-05yaosm","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-05yaosm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"变量"}]},{"ID":"20260505170804-ibc7713","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ibc7713","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"局部变量：\n会话变量：本次会话有效，不需要定义声明，直接使用\nset @x=10;\nselect @x;\n系统变量：也叫全局变量-需要root权限才能操作\n#查看全部系统变量\nshow global variables;\n#查看具体系统变量\nselect @@concurrent_insert;\n\n选择\n#if选择：\nif(表达式) then 执行语句;执行语句;执行语句;\nelseif (表达式) then 执行语句;执行语句;执行语句;\nelse 执行语句;执行语句;执行语句;\nend if;\n#case选择：\n#语法1：\ncase 变量 when 值1 then 执行语句;执行语句;...\n\t\t when 值2 then 执行语句;执行语句;...\n\t\t when 值3 then 执行语句;执行语句;...\nend case;\n#语法2：\ncase when 表达式1 then 执行语句;执行语句;...\n\t when 表达式2 then 执行语句;执行语句;...\n\t when 表达式3 then 执行语句;执行语句;...\n\t else 执行语句;执行语句;...\nend case;\n\n循环\n#while循环语法：\nwhile 循环条件\ndo\n\t执行语句;\n\t执行语句;\n\t执行语句;\nend while;\n\n#其他循环：mysql中没有for循环，有repeat和loop循环\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-orxkl9m","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-orxkl9m","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#青蛙爬井\ndrop function if exists qwpj;\ndelimiter //\ncreate function qwpj(nHigh int)\nreturns int\nbegin\n\tdeclare nDay int default 0;\n\tdeclare m int default 0;\n\twhile 1\n\tdo\n\t\tset nDay=nDay+1;\n\t\tset m=m+5;\n\t\tif m\u003e=nHigh then return nDay;\n\t\tend if;\n\t\tset m=m-4;\n\tend while\nend //\ndelimiter ;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-9g3r2bl","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-9g3r2bl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"存储过程"}]},{"ID":"20260505170804-ps75edr","Type":"NodeParagraph","Properties":{"id":"20260505170804-ps75edr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"procedure,是在大型数据库中，一组为了完成特定功能的 sql 语句集合。一次编译永久有效。|"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有返回值，如果需要返回数据，使声明参数的类型(IN,OUT,INOUT)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优点：减少流量，更安全：运行在数据库的服务器端，减少与客户机的交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"增强了代码的重用性和共享性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加快系统运行速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用灵活"}]},{"ID":"20260505170804-ypmxv9l","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-ypmxv9l","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#创建存储过程语法：\ndelimiter //\ncreate procedure 存储过程名(参数1,类型,参数2,类型...)\nbegin\nsql 语句;\nsql 语句;\n...\nend //\ndelimiter;\n\n#执行存储过程\ncall 过程名(参数列表);\n\n#删除存储过程\ndrop procedure if exists 过程名;\n\n\n----------------------------------------------------------------------------------------------------------\n#例子\t创建一个分页查询的存储过程\n#参数\t当前是第几页，每页显示多少行，固定查询student表\ndrop procedure if exists limitpro;\ndelimiter //\ncreate procedure limitpro(nPage int,nCount int)\nbegin\n\tdeclare a int default 0;\n\tset a=(nPage-1)*nCount;\n\tselect* from student limit a,nCount;\nend\ndelimiter ;\ncall limitpro(3,3);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-slzrtop","Type":"NodeParagraph","Properties":{"id":"20260505170804-slzrtop","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存储过程和函数的区别："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数有且仅有一个返回值；存储过程没有返回值，可以通过设置参数为 OUT 或者 INOUT 类型返回数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"函数中的 SQL 核心用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据查询计算"},{"Type":"NodeText","Data":"（SELECT 赋值给变量），而非执行修改操作；若需增删改 / 返回结果集，优先用存储过程。"}]},{"ID":"20260505170804-89z9fz4","Type":"NodeTable","Data":"|对比维度|存储过程|函数|\n| -------------| -----------------------------| ---------------------------------|\n|返回值|可选（0 / 多个，靠 OUT 参数）|必须有且仅有 1 个|\n|调用方式|独立 CALL 调用|可嵌入 SQL（如 SELECT）或独立调用|\n|核心用途|批量增删改、业务逻辑封装|数据计算、值转换、查询过滤|\n|参数类型|支持 IN/OUT/INOUT|仅 IN（部分库支持 OUT 但不推荐）|\n|事务 / 结果集|支持事务、可返回多个结果集|无事务、仅返回单个值（无结果集）|\n|SQL 兼容性|不能嵌入 SQL 语句|可作为 SQL 子句一部分使用|","TableAligns":[0,0,0],"Properties":{"id":"20260505170804-89z9fz4","updated":"20260505170804"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对比维度"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"存储过程"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"函数"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"返回值"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可选（0 / 多个，靠 OUT 参数）"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"必须有且仅有 1 个"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"调用方式"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"独立 CALL 调用"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可嵌入 SQL（如 SELECT）或独立调用"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"核心用途"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"批量增删改、业务逻辑封装"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据计算、值转换、查询过滤"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"参数类型"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"支持 IN/OUT/INOUT"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"仅 IN（部分库支持 OUT 但不推荐）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"事务 / 结果集"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"支持事务、可返回多个结果集"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无事务、仅返回单个值（无结果集）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"SQL 兼容性"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不能嵌入 SQL 语句"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"可作为 SQL 子句一部分使用"}]}]}]},{"ID":"20260505170804-5pp9eu5","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-5pp9eu5","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"触发器"}]},{"ID":"20260505170804-cedx3hx","Type":"NodeParagraph","Properties":{"id":"20260505170804-cedx3hx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"trigger,是一种特殊的存储过程，当值指定事件发生时，系统自动调用。"}]},{"ID":"20260505170804-a4c2cnk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-a4c2cnk","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#创建触发器的语法\ndelimiter //\ncreate trigger 触发器\nafter/before 操作名\t#在xxx操作之前或者之后\non 表名\t\t\t\t#触发操作的表\nfor each row\t\t  #影响每一行\nbegin\t\t\t\t \n\tsql语句;\t\t    #要执行的sql语句\nend\ndelimiter ;\n\n#删除\ndrop trigger if exists 触发器名;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-xkqi8n7","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-xkqi8n7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"事务"}]},{"ID":"20260505170804-ltfk1gy","Type":"NodeParagraph","Properties":{"id":"20260505170804-ltfk1gy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"transaction"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库事务是作为单个逻辑单元执行的一系列的 qsl 语句集合，操作要么都执行成功，要么都执行失败"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"特性："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原子性：事务是最小的工作单元，不可拆分，要么都执行成功，要么都不执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一致性：数据库的完整性约束不能被破坏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"隔离性：并行执行的事务之间是隔离的，保证多个事务之间互相不影响"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"持久性：事务提交以后，改变永久保存到数据库中"}]},{"ID":"20260505170804-k8czf3z","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bXlzcWw=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260505170804-k8czf3z","updated":"20260505170804"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bXlzcWw="},{"Type":"NodeCodeBlockCode","Data":"#使用事务语法：\nstart transaction;\t#开启事务\nsql 语句;\nsql 语句;\n...\ncommit;\t#提交\nrollback; #回滚\n#提交和回滚只能二选一，不能既要又要\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260505170804-byduw1t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-byduw1t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"事务特性，怎么实现的\t\t\u003e\u003e"}]},{"ID":"20260505170804-rtjk3ir","Type":"NodeParagraph","Properties":{"id":"20260505170804-rtjk3ir","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"原子性、一致性、隔离性、持久性"}]},{"ID":"20260505170804-p7haoau","Type":"NodeParagraph","Properties":{"id":"20260505170804-p7haoau","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原子性"},{"Type":"NodeText","Data":"指一个事务内的所有操作要么全部执行成功，要么全部回滚失败"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这一特性主要依靠 InnoDB 的 undo log 实现，undo log 会记录数据修改前的旧版本，事务异常时可根据日志回滚到原始状态"}]},{"ID":"20260505170804-d9vqzwi","Type":"NodeParagraph","Properties":{"id":"20260505170804-d9vqzwi","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一致性"},{"Type":"NodeText","Data":"是指事务执行前后，数据库的完整性约束不会被破坏，数据始终保持合法有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一致性并非由单独机制实现，而是通过原子性、隔离性、持久性共同保障"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再配合数据库的主键、外键、唯一约束等规则，确保数据不会出现逻辑错误"}]},{"ID":"20260505170804-frwlv59","Type":"NodeParagraph","Properties":{"id":"20260505170804-frwlv59","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"隔离性"},{"Type":"NodeText","Data":"用于保证多个并发事务之间互不干扰，一个事务不会读到另一个事务未提交的中间数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"InnoDB 主要通过 MVCC 多版本并发控制和锁机制实现隔离，读操作利用 MVCC 读取历史数据版本实现无锁并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写操作通过行锁、表锁保证互斥，从而兼顾并发性能与数据隔离"}]},{"ID":"20260505170804-qwth5qi","Type":"NodeParagraph","Properties":{"id":"20260505170804-qwth5qi","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"持久性"},{"Type":"NodeText","Data":"指事务一旦提交成功，对数据的修改就会永久保存，即使数据库宕机、断电也不会丢失"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"该特性依靠 redo log 实现，数据修改会先顺序写入 redo log 以保证高效落盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库异常重启后，可通过 redo log 恢复已提交的数据，确保数据不会丢失"}]},{"ID":"20260505170804-zgn7jix","Type":"NodeParagraph","Properties":{"id":"20260505170804-zgn7jix","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redo log 是 InnoDB 用来保证事务持久性的核心日志"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"事务修改数据时不会直接刷磁盘，而是先把变更记录写到 redo log 里，事务提交只要日志落盘就算成功"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它是固定大小、循环写入的物理日志，就算数据库宕机，重启后也能根据 redo log 把没来得及写入磁盘的数据恢复过来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确保已提交事务的数据不会丢失"}]},{"ID":"20260505170804-4m14w32","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4m14w32","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"不满足事务这几个特点会出现什么问题？，举例都可以\t\t\u003e\u003e"}]},{"ID":"20260505170804-7oqrdzb","Type":"NodeParagraph","Properties":{"id":"20260505170804-7oqrdzb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"原子性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如转账时一方扣了钱，另一方却没到账，导致数据出现错误"}]},{"ID":"20260505170804-qzo92ye","Type":"NodeParagraph","Properties":{"id":"20260505170804-qzo92ye","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一致性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"例如转账后总金额对不上，或者账户余额变成负数，出现逻辑上不合理的数据"}]},{"ID":"20260505170804-gtcywyk","Type":"NodeParagraph","Properties":{"id":"20260505170804-gtcywyk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"隔离性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个事务读到另一个事务未提交的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对方回滚后，这条数据就成了无效的脏数据"}]},{"ID":"20260505170804-126iee0","Type":"NodeParagraph","Properties":{"id":"20260505170804-126iee0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"持久性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不满足持久性的话，用户明明已经提交成功"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结果数据库重启后数据消失，订单和支付记录丢失，造成严重的业务问题"}]},{"ID":"20260505170804-zbufn1d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zbufn1d","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"undolog、redologlog、binlog\t\t\u003e\u003e"}]},{"ID":"20260505170804-cd77osm","Type":"NodeParagraph","Properties":{"id":"20260505170804-cd77osm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Undolog 主要用来实现事务回滚和 MVCC 多版本并发控制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它记录的是数据修改前的旧值，事务执行出错或者手动回滚时，就能根据 undolog 把数据恢复回去，保证事务原子性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时在可重复读隔离级别下，靠它生成历史版本，实现无锁的快照读，提升并发性能"}]},{"ID":"20260505170804-zx5varf","Type":"NodeParagraph","Properties":{"id":"20260505170804-zx5varf","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redolog 是保证事务持久性的核心日志，采用 WAL 预写日志机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它记录数据页的物理修改，事务提交时先写 redolog 再异步刷盘数据文件，把随机写变成顺序写提高性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库宕机重启后，会重放已提交的 redolog，把没来得及刷盘的数据补回来，确保已提交事务不会丢失"}]},{"ID":"20260505170804-pnffe4p","Type":"NodeParagraph","Properties":{"id":"20260505170804-pnffe4p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Binlog 是 MySQL Server 层的逻辑日志，不管用什么存储引擎都会记录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它主要用于主从复制和数据恢复，记录的是完整的 SQL 逻辑或行变化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主库把 binlog 同步给从库，从库重放实现主从一致，也能通过 binlog 做基于时间点的数据恢复"}]},{"ID":"20260505170804-0jqsfgr","Type":"NodeParagraph","Properties":{"id":"20260505170804-0jqsfgr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它们的区别主要有三点："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一是层级不同，undolog 和 redolog 属于 InnoDB 引擎层，binlog 属于 Server 层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是作用不同，undolog 管回滚和快照，redolog 管崩溃恢复，binlog 管主从复制和数据恢复"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三是写入方式不同，redolog 是固定大小循环覆盖写，binlog 是追加写，不会覆盖历史日志"}]},{"ID":"20260505170804-9cdr45w","Type":"NodeParagraph","Properties":{"id":"20260505170804-9cdr45w","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Redolog 恢复是救急，解决数据库挂了重启后数据不丢"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Binlog 恢复是回溯，解决人为误操作或历史数据找回，也支撑主从同步"}]},{"ID":"20260505170804-bx3922k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bx3922k","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"一条 SQL 语句在数据库中的执行流程\t\t\u003e\u003e"}]},{"ID":"20260505170804-s34b13v","Type":"NodeParagraph","Properties":{"id":"20260505170804-s34b13v","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260413162124435"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260413162124435.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-nnp8yh7","Type":"NodeParagraph","Properties":{"id":"20260505170804-nnp8yh7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先 MySQL 可以分为 Server 层和存储引擎层"}]},{"ID":"20260505170804-shjfmu2","Type":"NodeParagraph","Properties":{"id":"20260505170804-shjfmu2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"查询 SQL 语句会先经过 Server 层的连接器，毕竟我们要从数据库中读取数据，第一步一定要先建立连接"}]},{"ID":"20260505170804-kjikf3a","Type":"NodeParagraph","Properties":{"id":"20260505170804-kjikf3a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二步会到查询缓存中看看是否存在这条 SQL 语句，查询缓存是以 key-value 的形式进行存储的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"key 就是要查询的语句，value 则是该语句所对应的结果，如果存在则直接返回给客户端，不存在则继续往下走"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只不过考虑到缓存命中率不高的问题，在 MySQL8.0 已经废除这项功能了"}]},{"ID":"20260505170804-35ezijh","Type":"NodeParagraph","Properties":{"id":"20260505170804-35ezijh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三步就到了分析器，Server 层要执行一条 SQL 查询语句总要分析它的词法语法是否正确，弄清它的指令意图"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第四步是优化器，Server 层需要为这条 SQL 查询语句找到最合适的索引，或者在多表关联的时候选择先从哪个表取数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后 Server 层会按照执行计划调用存储引擎接口，完成查询数据操作，并将结果集返回给客户端"}]},{"ID":"20260505170804-dc9eoqk","Type":"NodeParagraph","Properties":{"id":"20260505170804-dc9eoqk","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SQL 语句的执行顺序"}]},{"ID":"20260505170804-p7vmdzp","Type":"NodeParagraph","Properties":{"id":"20260505170804-p7vmdzp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"from 子句组装来自不同数据源的数据(笛卡尔积计算)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"应用 on 筛选器\t执行 join"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"where 子句基于指定的条件对记录行进行筛选"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"group by 子句将数据划分为多个分组\t[聚集函数进行计算]"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用 having 子句筛选分组(二次筛选)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"select 的字段"}]},{"ID":"20260505170804-60c35gb","Type":"NodeParagraph","Properties":{"id":"20260505170804-60c35gb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"WHERE 是分组前筛行不能用聚集函数，HAVING 是分组后筛分组能用聚集函数；"}]},{"ID":"20260505170804-qsy75gv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qsy75gv","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 查询过程中有什么问题"}]},{"ID":"20260505170804-c2ll2by","Type":"NodeParagraph","Properties":{"id":"20260505170804-c2ll2by","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL 在执行查询的时候，首先最常见的问题就是索引失效、走全表扫描"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如查询条件做函数运算、隐式类型转换、左模糊查询，还有违反最左前缀原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"都会导致索引用不上，数据库只能一行行遍历整张表，查询变得非常慢"}]},{"ID":"20260505170804-pfxlvgc","Type":"NodeParagraph","Properties":{"id":"20260505170804-pfxlvgc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二个问题是排序、分组和多表关联不合理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"order by、group by 没有对应索引，MySQL 就会产生文件排序和临时表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多表 join 关联字段没索引，容易出现笛卡尔积，占用大量内存和磁盘 IO，直接变成慢查询"}]},{"ID":"20260505170804-skuxpla","Type":"NodeParagraph","Properties":{"id":"20260505170804-skuxpla","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三个是 SQL 语句写得不好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如习惯性 select * 查所有字段、不分页查大量数据、子查询嵌套太深"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还有 or 连接无索引字段，都会增加数据库 IO 开销和网络传输开销，浪费系统资源"}]},{"ID":"20260505170804-4his0cd","Type":"NodeParagraph","Properties":{"id":"20260505170804-4his0cd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后还有锁等待和数据库负载问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长事务长时间不提交会加行锁，导致查询被阻塞等待"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外数据库连接数过高、磁盘 IO 压力大、缓冲池命中率低，也会让正常查询执行变慢"}]},{"ID":"20260505170804-vloixoj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vloixoj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 长连接过多"}]},{"ID":"20260505170804-tnb6i8l","Type":"NodeParagraph","Properties":{"id":"20260505170804-tnb6i8l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL 单个连接是串行执行 SQL 的，不能并发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果只用一条连接，并发请求只能排队等待，性能会非常差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因此服务都会使用连接池维护多条长连接并行处理请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而长连接过多，就是连接池连接开太多、用完不释放归还导致堆积占用"}]},{"ID":"20260505170804-z502jhk","Type":"NodeParagraph","Properties":{"id":"20260505170804-z502jhk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"长连接过多首先会耗尽 MySQL 最大连接数（151），新请求无法建立连接"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"出现连接超时、数据库拒绝服务"}]},{"ID":"20260505170804-4928zn1","Type":"NodeParagraph","Properties":{"id":"20260505170804-4928zn1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次每个长连接都会占用缓冲区、事务内存"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大量空闲连接不释放会持续占用数据库内存，严重时会导致内存溢出"}]},{"ID":"20260505170804-l2u8uld","Type":"NodeParagraph","Properties":{"id":"20260505170804-l2u8uld","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时空闲长连接会占用锁与事务资源，容易引发长事务和锁等待阻塞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"影响正常 SQL 执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且数据库需要一直维护大量无效空闲连接，占用线程和 IO 资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"造成 CPU 空耗，业务查询变慢"}]},{"ID":"20260505170804-qjnthkb","Type":"NodeParagraph","Properties":{"id":"20260505170804-qjnthkb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"解决方式主要是合理配置连接池、设置空闲超时自动回收、规范业务不要长时间占用连接"}]},{"ID":"20260505170804-4ktpyzy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4ktpyzy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"mysql 一张表可以有多少行数据？需要一亿该怎么办？\t\t\u003e\u003e"}]},{"ID":"20260505170804-5an3bkl","Type":"NodeParagraph","Properties":{"id":"20260505170804-5an3bkl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"极限情况是 500 万条"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"水平分表 比如分 30 个表，每个用户 id%30 确定要存在哪个表中"}]},{"ID":"20260505170804-54izb5v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-54izb5v","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"随着业务增长，现在有至少 2 亿多用户，但之前的分表是 30 个表，此时该怎么办？\t\t\u003e\u003e"}]},{"ID":"20260505170804-pstt5y9","Type":"NodeParagraph","Properties":{"id":"20260505170804-pstt5y9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心思路是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"平滑扩容、不停机、数据一致"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先新建 80 张新表，然后开启双写，新数据同时写入旧 30 表和新 80 表，保证数据不丢失"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着通过脚本分批迁移历史数据，按 ID 范围小批量拷贝，避免影响线上业务。迁移完成后做数据校验，再灰度把读流量切到新表，最后全量切读写、关闭双写、下线旧表"}]},{"ID":"20260505170804-vpqnsyk","Type":"NodeParagraph","Properties":{"id":"20260505170804-vpqnsyk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"为了避免后续再次扩容时全量迁移，推荐使用一致性哈希"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它可以在扩容时只迁移少量数据，配合虚拟节点让数据分布更均匀，大幅降低扩容成本和风险，让分表架构更稳定、可扩展。"}]},{"ID":"20260505170804-evt5inq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-evt5inq","updated":"20260523200832"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲一下一致性 hash\t\t\u003e\u003e"}]},{"ID":"20260505170804-wygd1px","Type":"NodeParagraph","Properties":{"id":"20260505170804-wygd1px","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"img"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://i-blog.csdnimg.cn/blog_migrate/c5cfe1961395a6ea52d9ae78796dcc03.jpeg"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-i5sm3t0","Type":"NodeParagraph","Properties":{"id":"20260505170804-i5sm3t0","updated":"20260523200832"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"构建哈希环"},{"Type":"NodeText","Data":"：把哈希值范围（0"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"2^32-1）映射成一个首尾相连的环；"},{"Type":"NodeTextMark","TextMarkType":"sub strong","TextMarkTextContent":"节点映射"},{"Type":"NodeTextMark","TextMarkType":"sub","TextMarkTextContent":"：将 80 张分表（物理节点）通过哈希计算，固定到哈希环的不同位置；为了避免数据不均，还会给每个物理表绑定 5"},{"Type":"NodeText","Data":" 10 个「虚拟节点」，让节点分布更均匀；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据映射"},{"Type":"NodeText","Data":"：计算 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hash(user_id)"},{"Type":"NodeText","Data":"​，得到一个哈希值，在环上顺时针找最近的表节点，这个节点就是该用户数据要存储的表。"}]},{"ID":"20260505170804-d3r8tj9","Type":"NodeParagraph","Properties":{"id":"20260505170804-d3r8tj9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一致性哈希是一种用于分布式存储和分库分表的哈希算法，主要解决传统取模分片在扩容时数据几乎全量需要迁移的问题。它把哈希值抽象成一个环形空间，将数据表或节点通过哈希映射到环上，数据根据其哈希值顺时针找到最近的节点存储。"}]},{"ID":"20260505170804-aodg5ul","Type":"NodeParagraph","Properties":{"id":"20260505170804-aodg5ul","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当节点数量增加或减少时，只有受影响的一小段环上的数据需要迁移，大部分数据保持原来的分片不变，从而大幅降低扩容成本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在实际使用中，通常会引入虚拟节点，把一个物理节点拆成多个虚拟节点散落在环上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"避免数据倾斜，让分布更均匀"}]},{"ID":"20260505170804-4k95jx1","Type":"NodeParagraph","Properties":{"id":"20260505170804-4k95jx1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一致性哈希特别适合分表分库场景，既能保证系统平滑扩缩容，又能减少数据迁移量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是高并发、大数据量架构里非常经典的方案"}]},{"ID":"20260505170804-mf3eavk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mf3eavk","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MYSQL 中索引有什么用，使用的时候需要注意什么？\t\t\u003e\u003e"}]},{"ID":"20260505170804-fb824w3","Type":"NodeParagraph","Properties":{"id":"20260505170804-fb824w3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL 索引的核心作用就是加快查询效率，避免全表扫描"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它相当于给数据表建了一个目录结构，让数据库不用逐行遍历数据，能快速定位到目标记录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大幅提升 where 查询、order by 排序、group by 分组等操作的速度"}]},{"ID":"20260505170804-x9kz6yq","Type":"NodeParagraph","Properties":{"id":"20260505170804-x9kz6yq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在使用索引时，首先要注意不能滥用索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"索引虽然提升查询速度，但会降低写入性能，因为每次 insert、update、delete 都需要同步维护索引，索引越多，写入开销越大"}]},{"ID":"20260505170804-elkkpgs","Type":"NodeParagraph","Properties":{"id":"20260505170804-elkkpgs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，要遵循最左匹配原则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"联合索引必须从最左边的列开始使用，跳过前面的字段会导致索引失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时，尽量不要在索引列上做函数计算、类型隐式转换，否则也会导致索引失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外，建索引要选择区分度高的列，比如身份证号、用户 ID，而性别、状态这种枚举值区分度低，建索引意义不大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还要避免冗余索引，比如已经建了联合索引 (a,b)，就不需要再单独建 a 索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后，像 like '%xxx' 这种以通配符开头的查询、使用 !=、\u003c\u003e 或者大量 or 的场景，也容易导致索引失效，实际开发中要尽量避免"}]},{"ID":"20260505170804-do8lyx9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-do8lyx9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是索引？\t\t\t\u003e\u003e"}]},{"ID":"20260505170804-eyfwnas","Type":"NodeParagraph","Properties":{"id":"20260505170804-eyfwnas","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"索引是 MySQL 中用于"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"加快查询速度"},{"Type":"NodeText","Data":"的一种数据结构，本质上就像一本书的目录。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过索引直接定位到数据所在位置，大幅减少磁盘 IO，提升查询效率。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"InnoDB 里最常用的是 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"B+ 树索引"},{"Type":"NodeText","Data":"，结构有序、支持范围查询、适合磁盘存储。"}]},{"ID":"20260505170804-60odh0j","Type":"NodeParagraph","Properties":{"id":"20260505170804-60odh0j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用索引要权衡利弊：它能极大提升 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SELECT"},{"Type":"NodeText","Data":" 效率，但会减慢 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"INSERT、UPDATE、DELETE"},{"Type":"NodeText","Data":" 的速度，因为每次写入都要维护索引结构。同时索引会占用额外存储空间，所以只适合在经常查询、区分度高的字段上建立，避免索引过多或失效。"}]},{"ID":"20260505170804-c9qfoc3","Type":"NodeParagraph","Properties":{"id":"20260505170804-c9qfoc3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"索引主要分为"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主键索引、普通索引、唯一索引和联合索引"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"联合索引遵循"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最左前缀原则"},{"Type":"NodeText","Data":"，能同时优化多字段查询，但要注意字段顺序。"}]},{"ID":"20260505170804-ielgm6l","Type":"NodeParagraph","Properties":{"id":"20260505170804-ielgm6l","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主键索引（聚簇索引）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每张表唯一，叶子节点存放整行数据，默认基于主键构建；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特点：查询速度最快，InnoDB 表必须有主键（无显式指定则隐式生成）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"普通索引（非聚簇索引）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于普通字段构建，叶子节点只存储主键值需回表查整行数据；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"示例：CREATE INDEX idx_order_time ON order(create_time);（给订单时间建普通索引）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"唯一索引（非聚簇索引）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"字段值必须唯一（允许 NULL），兼具 “唯一性约束 + 索引查询” 双重作用；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"示例：CREATE UNIQUE INDEX idx_user_phone ON user(phone);（保证手机号唯一，同时加速手机号查询）。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"联合索引（非聚簇，复合索引）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于多个字段构建，遵循 “最左前缀匹配原则”；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"示例：CREATE INDEX idx_user_age_gender ON user(age, gender);（支持 age、age+gender 查询，不支持单独 gender 查询）。"}]},{"ID":"20260505170804-mxeeudf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mxeeudf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"前缀索引"}]},{"ID":"20260505170804-kh0c7kk","Type":"NodeParagraph","Properties":{"id":"20260505170804-kh0c7kk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"前缀索引，就是只给字段前面一部分字符建立索引，而不是整个字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合字符串很长的字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如手机号、邮箱、地址、URL，整列索引占用空间太大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写入慢、索引效率低，就截取前 N 个字符建索引"}]},{"ID":"20260505170804-f9vke80","Type":"NodeParagraph","Properties":{"id":"20260505170804-f9vke80","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优点是索引体积小、占用内存少、查询快、写入性能更好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是无法用于 order by、group by 排序分组，也不能做覆盖索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且前缀长度太短区分度低，索引效果变差"}]},{"ID":"20260505170804-g7ff771","Type":"NodeParagraph","Properties":{"id":"20260505170804-g7ff771","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用前缀索引一定要先计算区分度，区分度接近整列再使用"}]},{"ID":"20260505170804-awqpl7f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-awqpl7f","updated":"20260603221047"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"覆盖索引"}]},{"ID":"20260505170804-ddtypie","Type":"NodeParagraph","Properties":{"id":"20260505170804-ddtypie","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"覆盖索引，就是查询需要的所有字段，都在索引里就能拿到，不用再回表查询原始数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MySQL 查到索引就能直接返回结果，不需要再通过主键回表查聚簇索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"极大减少 IO，查询速度非常快"}]},{"ID":"20260505170804-0dqd1pp","Type":"NodeParagraph","Properties":{"id":"20260505170804-0dqd1pp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"优点是性能极高、避免回表、大幅提升查询效率"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"缺点是索引会变大，写入更新成本会变高，而且要精准设计 select 字段，不能 select *"}]},{"ID":"20260505170804-8yhqe8f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-8yhqe8f","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么要使用索引？\t\t\u003e\u003e"}]},{"ID":"20260505170804-fdqf51z","Type":"NodeParagraph","Properties":{"id":"20260505170804-fdqf51z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心原因：避免全表扫描，减少 IO 次数，大幅提升查询效率；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"附加价值：降低数据库负载，优化排序 / 分组 / 关联查询性能；"}]},{"ID":"20260505170804-1taq0dh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-1taq0dh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"索引数据结构由什么决定？\t\t\u003e\u003e"}]},{"ID":"20260505170804-gkv63co","Type":"NodeParagraph","Properties":{"id":"20260505170804-gkv63co","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"索引的数据结构主要由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"存储引擎、查询场景、数据存储"},{"Type":"NodeText","Data":"方式决定。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同存储引擎支持的结构不同"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"InnoDB 主流使用 B+ 树，内存引擎常用哈希索引。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果是等值查询，哈希更快；如果是范围、排序、分组查询，B+ 树更合适。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"磁盘存储追求少 IO，所以用多路平衡的 B+ 树；内存读写快，更适合用哈希结构。"}]},{"ID":"20260505170804-025nqyh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-025nqyh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么用 B+ 树不用 B 树？\t\t\u003e\u003e"}]},{"ID":"20260505170804-z95owo5","Type":"NodeParagraph","Properties":{"id":"20260505170804-z95owo5","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260312170852427"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260312170852427.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-mz32z8k","Type":"NodeParagraph","Properties":{"id":"20260505170804-mz32z8k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"B+ 树只有叶子节点存数据，非叶子节点只存键值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相同内存能存放更多索引键，树更矮更胖，"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"IO 次数更少，查询效率更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 B 树每个节点都存数据，相同空间能存的键更少，树更高，IO 更多"}]},{"ID":"20260505170804-vd4qrpp","Type":"NodeParagraph","Properties":{"id":"20260505170804-vd4qrpp","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"B + 树的所有叶子节点用有序链表相连，范围查询、排序、分组只需要遍历链表即可"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 B 树必须频繁回溯父节点，范围查询效率很低"}]},{"ID":"20260505170804-v2rcckl","Type":"NodeParagraph","Properties":{"id":"20260505170804-v2rcckl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"B + 树所有数据都在叶子节点，任何查询的 IO 次数都一样，性能稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 B 树数据可能出现在任意节点，有的快有的慢，不稳定"}]},{"ID":"20260505170804-urzrw3y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-urzrw3y","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"B 树适合什么场景\t\t\u003e\u003e"}]},{"ID":"20260505170804-3p2pac6","Type":"NodeParagraph","Properties":{"id":"20260505170804-3p2pac6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"节点需要快速命中，数据可能在非叶子节点，适合大量等值查询、少范围查询的场景。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"B 树没有叶子链表，结构更简单，在内存中查找效率很高。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据量不大、更追求单次查询极致速度，不怎么需要范围查询"}]},{"ID":"20260505170804-kc279e2","Type":"NodeParagraph","Properties":{"id":"20260505170804-kc279e2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"B 树采用中序遍历"}]},{"ID":"20260505170804-cyx89y7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cyx89y7","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"B+ 树索引能存多少数据\t\t\u003e\u003e"}]},{"ID":"20260505170804-g2sfud1","Type":"NodeParagraph","Properties":{"id":"20260505170804-g2sfud1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"B + 树索引能存多少数据，主要看树的高度和每个节点能存多少键值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一般 InnoDB 一页 16KB，主键是 bigint 8 字节，指针 6 字节，一个索引页大概能存 1170 个索引项"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三层 B + 树就能存 约 16 亿条数据，四层就能达到千亿级别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以实际使用中，B + 树高度基本就在 3～4 层，查询只需要 3～4 次 IO，就能支撑上亿甚至几十亿数据"}]},{"ID":"20260505170804-5n1oddx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5n1oddx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"索引 存储引擎密不可分\t\u003e\u003e"}]},{"ID":"20260505170804-cizvmv4","Type":"NodeParagraph","Properties":{"id":"20260505170804-cizvmv4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"索引依赖存储引擎实现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同存储引擎支持的索引类型、数据结构和实现方式完全不同"}]},{"ID":"20260505170804-b11uq57","Type":"NodeParagraph","Properties":{"id":"20260505170804-b11uq57","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 基于 B+ 树实现聚簇索引与二级索引，主键索引叶子节点存完整数据，同时支持事务和行锁"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MyISAM 采用非聚簇索引结构，索引与数据分开存储，索引叶子只存数据地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Memory 引擎数据存于内存，可选用哈希索引或 B 树索引，哈希索引更适合等值快速查询"}]},{"ID":"20260505170804-dth8zo1","Type":"NodeParagraph","Properties":{"id":"20260505170804-dth8zo1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存储引擎决定了索引怎么存、怎么查、怎么维护，而索引又直接决定了存储引擎的查询性能，二者必须配合使用，不能脱离存储引擎单独谈索引"}]},{"ID":"20260505170804-q4yh703","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-q4yh703","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"聚集索引优缺点\t\u003e\u003e"}]},{"ID":"20260505170804-7qdx93h","Type":"NodeParagraph","Properties":{"id":"20260505170804-7qdx93h","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeText","Data":"：数据和索引在一起，按主键查询快，范围查询、排序效率高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeText","Data":"：一张表只能有一个，写入数据时容易产生页分裂，影响性能，二级索引体积更大"}]},{"ID":"20260505170804-ddq6idh","Type":"NodeParagraph","Properties":{"id":"20260505170804-ddq6idh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一张表只能有一个聚簇索引，因为数据物理上只能按一种顺序组织，无法再创建第二个"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写入易产生页分裂：聚簇索引按主键有序存储，如果主键无序（如 UUID），插入时会导致数据页分裂，挪动数据，降低写入性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二级索引体积更大：二级索引需要存储主键值，主键越长，二级索引占用空间越大，会影响缓存效率和查询性能"}]},{"ID":"20260505170804-ihbggrj","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ihbggrj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"页分裂"}]},{"ID":"20260505170804-tzsi1hi","Type":"NodeParagraph","Properties":{"id":"20260505170804-tzsi1hi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"页分裂指的是 InnoDB 聚簇索引在插入数据时，因为主键有序且数据页大小固定默认 16KB"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"当某个数据页已经写满，又需要在这一页中间插入新数据，数据库就会把这个满了的数据页拆分成两个新页"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将一部分数据移到新页中，再插入新数据，这个拆分和移动的过程就是页分裂"}]},{"ID":"20260505170804-2977jns","Type":"NodeParagraph","Properties":{"id":"20260505170804-2977jns","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"页分裂会带来明显的性能开销："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"产生额外的磁盘 IO"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"破坏数据的物理有序性，还会产生空间碎片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"导致写入性能下降，同时也会影响后续范围查询和遍历的效率"}]},{"ID":"20260505170804-ee24smk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ee24smk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"页分裂是聚簇索引特有的问题，因为聚簇索引本身就是数据，必须严格按照主键顺序存储，无法像非聚簇索引那样只维护键值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为了减少页分裂，InnoDB 推荐使用自增主键，让数据始终从末尾追加写入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只在最后一页扩容，避免在中间插入，从而几乎不产生页分裂，保证写入性能稳定"}]},{"ID":"20260505170804-xo92zlh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-xo92zlh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"聚集索引和非聚集索引区别\t\u003e\u003e"}]},{"ID":"20260505170804-7jj2m7k","Type":"NodeParagraph","Properties":{"id":"20260505170804-7jj2m7k","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"聚集索引就是主键索引，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据和索引存在一起"},{"Type":"NodeText","Data":"，叶子节点存整行数据，一张表只能有一个，查询无需回表、速度更快；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"非聚簇索引也就是二级索引，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"索引和数据分开存储"},{"Type":"NodeText","Data":"，叶子节点只存主键值，一张表可以建多个，查询通常需要回表，效率稍低。"}]},{"ID":"20260505170804-z7tqusj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z7tqusj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"联合索引最左匹配原则\t\u003e\u003e"}]},{"ID":"20260505170804-za2c5su","Type":"NodeParagraph","Properties":{"id":"20260505170804-za2c5su","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"组合索引的最左匹配原则，就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"查询时必须从索引最左边的字段开始匹配，不能跳过前面的字段直接用后面的字段"},{"Type":"NodeText","Data":"，否则索引会失效"}]},{"ID":"20260505170804-l0bvvxw","Type":"NodeParagraph","Properties":{"id":"20260505170804-l0bvvxw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"比如建立（a,b,c）组合索引，能命中索引的是 a、a+b、a+b+c 这几种查询方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果只查 b、b+c、c 这类跳过左边字段的条件，就无法使用整个组合索引"}]},{"ID":"20260505170804-roq3fcs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-roq3fcs","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何触发组合索引——\u003e 最左前缀原则\t\u003e\u003e"}]},{"ID":"20260505170804-b0acgrk","Type":"NodeParagraph","Properties":{"id":"20260505170804-b0acgrk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"触发最左前缀原则的核心："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"查询条件必须包含组合索引最左侧的第一个字段，且按前缀连续匹配"},{"Type":"NodeText","Data":"，跳过左侧字段则索引失效"}]},{"ID":"20260505170804-wlw5xcu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wlw5xcu","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么需要最左匹配原则\t\t\u003e\u003e"}]},{"ID":"20260505170804-yuw3k76","Type":"NodeParagraph","Properties":{"id":"20260505170804-yuw3k76","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第一，联合索引底层是 B + 树有序结构，索引先按第一列排序"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一列相同才按第二列，第二列相同再按第三列"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有从最左开始匹配，才能直接在 B + 树上快速二分定位范围，走索引"}]},{"ID":"20260505170804-tv7jl5b","Type":"NodeParagraph","Properties":{"id":"20260505170804-tv7jl5b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第二，如果跳过左边字段，索引整体无序，数据库无法定位区间，只能全表扫描，索引直接失效"}]},{"ID":"20260505170804-p2xzfdr","Type":"NodeParagraph","Properties":{"id":"20260505170804-p2xzfdr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"第三，最左匹配本质是利用索引前缀有序性，保证查询能高效二分查找，而不是遍历"}]},{"ID":"20260505170804-m3zne7w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m3zne7w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是覆盖索引？\t\u003e\u003e"}]},{"ID":"20260505170804-yshnogs","Type":"NodeParagraph","Properties":{"id":"20260505170804-yshnogs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"覆盖索引，就是一个索引就包含了查询需要的所有字段，查询时直接从索引中就能拿到结果，不需要再回表查主键索引，从而减少 IO、提升查询效率。它不是一种单独的索引类型，而是一种索引优化效果。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"查询的 where 条件字段 + select 返回的字段"},{"Type":"NodeText","Data":"，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全部建在同一个联合索引里"},{"Type":"NodeText","Data":"，就能实现覆盖索引，不用回表。"}]},{"ID":"20260505170804-nf7k5tl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nf7k5tl","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 中推荐使用自增整数作为主键的原因是什么？\t\u003e\u003e"}]},{"ID":"20260505170804-to6z257","Type":"NodeParagraph","Properties":{"id":"20260505170804-to6z257","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 采用聚簇索引,整张表就是一棵 B+ 树，数据行按照主键顺序存储在叶子节点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自增主键是有序、连续递增的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新插入的数据总是在 B+ 树的最右侧叶子节点追加，不会导致中间节点分裂和数据移动，能有效减少页分裂和碎片，提升写入性能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时，整型主键占用空间小，使得 B+ 树每个节点能存储更多索引键"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"树的高度更低，查询时磁盘 I/O 更少，查询效率更高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比无序的 UUID 等字符串主键，自增 ID 在 B+ 树结构上天然更友好，整体读写性能和空间利用率都更优"}]},{"ID":"20260505170804-2n6cfy0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-2n6cfy0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"索引失效场景\t\t\u003e\u003e"}]},{"ID":"20260505170804-94750hb","Type":"NodeParagraph","Properties":{"id":"20260505170804-94750hb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL 索引失效主要有 8 个高频场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心原因是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MySQL 优化器认为走索引不如全表扫描快，或者索引列被函数 / 运算破坏了有序性"}]},{"ID":"20260505170804-h0bxarx","Type":"NodeParagraph","Properties":{"id":"20260505170804-h0bxarx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对索引字段做函数操作、数学运算、类型转换，会直接失效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原因：索引存储的是原值，运算后无法匹配索引有序结构"}]},{"ID":"20260505170804-vh5afck","Type":"NodeParagraph","Properties":{"id":"20260505170804-vh5afck","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LIKE 前缀模糊匹配会失效，后缀匹配有效"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原因：前缀 % 破坏索引最左匹配规则"}]},{"ID":"20260505170804-bw3y8vu","Type":"NodeParagraph","Properties":{"id":"20260505170804-bw3y8vu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"违反最左前缀原则\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"原因：联合索引是有序组合，缺少左侧列无法定位"}]},{"ID":"20260505170804-us0i9ha","Type":"NodeParagraph","Properties":{"id":"20260505170804-us0i9ha","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"使用 NOT IN / != / \u003c\u003e / IS NOT NULL\t索引是 “正向有序” 的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只适合快速找 “有什么”，不适合找 “没有什么”"}]},{"ID":"20260505170804-wnwcny8","Type":"NodeParagraph","Properties":{"id":"20260505170804-wnwcny8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"OR 连接非索引列\t解决：改用 UNION 替代 OR"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ORDER BY / GROUP BY 违反索引规则"}]},{"ID":"20260505170804-dvm1tv1","Type":"NodeParagraph","Properties":{"id":"20260505170804-dvm1tv1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"隐式类型转换"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优化器判断全表扫描更快"}]},{"ID":"20260505170804-mn1afop","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-mn1afop","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"数据库 10 亿索引"}]},{"ID":"20260505170804-uca3kfz","Type":"NodeParagraph","Properties":{"id":"20260505170804-uca3kfz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先从根源上收敛需要承载索引的数据集规模"}]},{"ID":"20260505170804-tjzfjky","Type":"NodeParagraph","Properties":{"id":"20260505170804-tjzfjky","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冷热数据分离"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把十亿条数据里的历史冷数据，比如超过半年的归档数据，拆分到归档表甚至离线存储里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只给高频访问的热数据建索引"},{"Type":"NodeText","Data":"，直接把索引需要维护的数据量级压下来"}]},{"ID":"20260505170804-9hvy88d","Type":"NodeParagraph","Properties":{"id":"20260505170804-9hvy88d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次索引本身的精准设计，绝对避免冗余索引和无效索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优先用联合索引"},{"Type":"NodeText","Data":"，严格遵循最左前缀原则，把过滤性最高、高基数的字段放在最左边"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如用户 ID、订单号这种，把范围查询的字段往后放，避免索引失效"}]},{"ID":"20260505170804-q8r62r0","Type":"NodeParagraph","Properties":{"id":"20260505170804-q8r62r0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"针对"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心的业务查询，直接做覆盖索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把查询需要的所有字段都放进联合索引里，彻底避免回表操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时绝对不给低基数字段，比如性别、状态这种只有几个枚举值的字段建单独索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种索引不仅没查询收益，还会严重拖慢写入性能"}]},{"ID":"20260505170804-welk11v","Type":"NodeParagraph","Properties":{"id":"20260505170804-welk11v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"存储引擎适配和常态化的索引维护"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 InnoDB 的话，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主键必须用有序自增 ID"},{"Type":"NodeText","Data":"，绝对不能用 UUID 这种无序主键"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不然十亿级数据会导致严重的页分裂，索引碎片直接爆炸"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后定期用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无锁工具做索引碎片整理"},{"Type":"NodeText","Data":"，避免直接锁表操作影响线上业务"}]},{"ID":"20260505170804-7fvbkvh","Type":"NodeParagraph","Properties":{"id":"20260505170804-7fvbkvh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"同时调整数据库缓冲池参数，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"尽量把热点索引页缓存在内存里"},{"Type":"NodeText","Data":"，减少磁盘 IO"}]},{"ID":"20260505170804-sekaltd","Type":"NodeParagraph","Properties":{"id":"20260505170804-sekaltd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外还可以做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"表分区"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如按时间分区，查询的时候只扫描对应分区的索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用全表扫索引，进一步缩小扫描范围"}]},{"ID":"20260505170804-w68l2id","Type":"NodeParagraph","Properties":{"id":"20260505170804-w68l2id","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后是特殊场景的兜底优化和压力分流"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如长字符串字段，可以用前缀索引，只取前几位字符建索引，大幅缩小索引体积"}]},{"ID":"20260505170804-shsttk9","Type":"NodeParagraph","Properties":{"id":"20260505170804-shsttk9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对于多维度的复杂筛选查询，不要硬扛在 MySQL 里用联合索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接把这部分查询分流到 ES、ClickHouse 这类适配的引擎里"}]},{"ID":"20260505170804-3vyvfxa","Type":"NodeParagraph","Properties":{"id":"20260505170804-3vyvfxa","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MySQL 只负责事务性的主键精准查询，从架构上把索引的压力拆分掉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时针对写入场景，用批量插入代替高频单条插入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少索引树的频繁调整，降低索引维护的开销"}]},{"ID":"20260505170804-paqhbgp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-paqhbgp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 涉及的三种锁"}]},{"ID":"20260505170804-vmgsm72","Type":"NodeParagraph","Properties":{"id":"20260505170804-vmgsm72","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"表锁"},{"Type":"NodeText","Data":"：锁定整张表，开销小、加锁快，不会死锁，但并发度最差，MyISAM 默认使用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"行锁"},{"Type":"NodeText","Data":"：只锁定某一行，开销大、加锁慢，会出现死锁，但并发度最好，InnoDB 默认使用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"页锁"},{"Type":"NodeText","Data":"：锁定一页数据，介于表锁和行锁之间，并发和开销也居中。"}]},{"ID":"20260505170804-0z564id","Type":"NodeParagraph","Properties":{"id":"20260505170804-0z564id","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关于行锁："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它只锁定某一行数据，需要精确找到数据所在的页、行，并维护锁的信息、事务关系，成本更高。同时，多个事务可以同时锁不同行，并发能力极高，但也正因为锁定粒度细、多个锁交叉等待，就可能出现循环等待，从而产生死锁。"}]},{"ID":"20260505170804-m2bxacq","Type":"NodeParagraph","Properties":{"id":"20260505170804-m2bxacq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 用行锁 + 表锁，MyISAM 用表锁。"}]},{"ID":"20260505170804-w0v2eri","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w0v2eri","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何排查慢 SQL，如何判定索引命中情况"}]},{"ID":"20260505170804-pccpngz","Type":"NodeParagraph","Properties":{"id":"20260505170804-pccpngz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先开启数据库慢查询日志，设置合理的超时阈值，把执行时间过长的 SQL 先定位出来。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拿到具体 SQL 后，用 EXPLAIN 分析执行计划，重点看扫描类型、索引使用情况、扫描行数以及是否出现临时表、文件排序等问题。"}]},{"ID":"20260505170804-yrx37wo","Type":"NodeParagraph","Properties":{"id":"20260505170804-yrx37wo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后再结合业务场景判断原因，常见的就是缺少索引、索引失效、SQL 写法不当、关联表过多或者数据量过大"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后针对性优化索引、改写 SQL 或者做分页、分库分表，并再次验证效果。"}]},{"ID":"20260505170804-fy7sr4q","Type":"NodeParagraph","Properties":{"id":"20260505170804-fy7sr4q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"判断索引是否命中，核心就是看 EXPLAIN 的结果。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最直接的是看 key 字段，如果显示具体索引名就是命中了，为 NULL 就是没命中，走了全表扫描。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时还要看 type 字段，像 const、ref、range 这类都是比较好的索引命中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 index 是索引全扫描，ALL 就是全表扫描，性能很差。"}]},{"ID":"20260505170804-q96rzvh","Type":"NodeParagraph","Properties":{"id":"20260505170804-q96rzvh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另外 Extra 里出现 Using index 说明用到了覆盖索引，是最优情况"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果出现 Using filesort 或 Using temporary，基本就意味着索引没发挥好作用，需要优化。"}]},{"ID":"20260505170804-t7yofxv","Type":"NodeParagraph","Properties":{"id":"20260505170804-t7yofxv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"EXPLAIN 是 MySQL 的执行计划分析工具，你可以把它理解成 SQL 的体检报告。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在执行一条 SQL 前加上 EXPLAIN，数据库不会真正运行这条语句，而是提前告诉你它打算怎么执行：比如会不会走索引、是全表扫描还是索引查找、要扫描多少行数据、有没有用到临时表或文件排序。"}]},{"ID":"20260505170804-wwqy6ha","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-wwqy6ha","updated":"20260508211622"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"已经命中索引仍然效率不佳，如何优化"}]},{"ID":"20260505170804-w9047jb","Type":"NodeParagraph","Properties":{"id":"20260505170804-w9047jb","updated":"20260508211605"},"Children":[{"Type":"NodeText","Data":"优先从索引质量和回表开销入手优化。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检查是否扫描行数过多、过滤性不足"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过建立"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"更合适的联合索引"},{"Type":"NodeText","Data":"，把区分度高的字段放在前面，提升筛选效率"}]},{"ID":"20260505170804-5tohr20","Type":"NodeParagraph","Properties":{"id":"20260505170804-5tohr20","updated":"20260508211616"},"Children":[{"Type":"NodeText","Data":"同时尽量使用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"覆盖索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把查询字段全部包含在索引中，避免大量回表查询，减少 IO 消耗"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外还要看是否存在排序、分组导致的 Using filesort 或 Using temporary"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将排序、分组字段加入索引，让数据库直接按索引顺序返回结果"}]},{"ID":"20260508211617-1xm5mkl","Type":"NodeParagraph","Properties":{"id":"20260508211617-1xm5mkl","updated":"20260508211622"},"Children":[{"Type":"NodeText","Data":"如果数据量过大或统计信息过期导致优化器选错索引"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以更新统计信息、强制指定索引，数据量极大时再考虑分表、分区或冷热数据分离"}]},{"ID":"20260505170804-z1vx964","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-z1vx964","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"脏读、不可重复读、幻读"}]},{"ID":"20260505170804-m538ax7","Type":"NodeParagraph","Properties":{"id":"20260505170804-m538ax7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"脏读、不可重复读、幻读，都属于事务并发带来的数据一致性问题，本质是 多个事务同时执行时，读写互相干扰导致的异常现象。"}]},{"ID":"20260505170804-frwxpuq","Type":"NodeParagraph","Properties":{"id":"20260505170804-frwxpuq","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"脏读："},{"Type":"NodeText","Data":"读到了其他事务还没提交的数据，万一对方回滚，数据就是错的。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不可重复读："},{"Type":"NodeText","Data":"同一个事务内，同一条数据多次查询结果不一样，因为被其他事务修改并提交了。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"幻读："},{"Type":"NodeText","Data":"同一个事务内，范围查询时多出 / 少了几条数据，像幻觉一样，是其他事务插入 / 删除导致的。"}]},{"ID":"20260505170804-q0atoxc","Type":"NodeParagraph","Properties":{"id":"20260505170804-q0atoxc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一句话区分：脏读是读到未提交数据，不可重复读是同一条数据变了，幻读是结果集条数变了。"}]},{"ID":"20260505170804-ns2zai6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ns2zai6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"数据隔离等级"}]},{"ID":"20260505170804-99lnxp3","Type":"NodeParagraph","Properties":{"id":"20260505170804-99lnxp3","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读未提交"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个事务能读到另一个事务未提交的数据，会出现脏读、不可重复读、幻读，基本不用。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读已提交"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只能读到其他事务已提交的数据，解决了脏读，但还会有不可重复读、幻读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"可重复读"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MySQL InnoDB 默认级别，同一个事务内多次读取结果一致，解决了脏读、不可重复读，通过临键锁基本解决幻读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"串行化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最高级别，事务串行执行，完全无并发问题，但"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"性能最差"}]},{"ID":"20260505170804-l7o1cu3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-l7o1cu3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"可重复读是怎么做到的"}]},{"ID":"20260505170804-4joyw3p","Type":"NodeParagraph","Properties":{"id":"20260505170804-4joyw3p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 的可重复读是通过 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"MVCC（多版本并发控制）"},{"Type":"NodeText","Data":" 实现的。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在事务开始时，会生成一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一致性视图（Read View）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后整个事务期间，都用这个视图去"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"读取历史版本数据"},{"Type":"NodeText","Data":"，看不到其他事务新提交的修改，从而保证重复读取结果一致。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"底层靠 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"undo log 版本链 + ReadView 可见性判断"},{"Type":"NodeText","Data":" 实现，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不加锁、高并发、一致性强"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260505170804-4u9dlvm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4u9dlvm","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"事务日志–重做日志和回滚日志"}]},{"ID":"20260505170804-5xy76hg","Type":"NodeParagraph","Properties":{"id":"20260505170804-5xy76hg","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"redo log 重做日志"},{"Type":"NodeText","Data":"和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"undo log 回滚日志"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"redo log 记录数据修改后的结果，用于崩溃恢复，保证事务的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"持久性"},{"Type":"NodeText","Data":"；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"undo log 记录修改前的旧数据，用于事务回滚，同时支撑 MVCC 实现隔离性，保证事务的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"原子性"},{"Type":"NodeText","Data":"。两者配合，共同保障了事务的安全与一致性。"}]},{"ID":"20260505170804-j33jmk2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-j33jmk2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"undo log"}]},{"ID":"20260505170804-9nqwn0s","Type":"NodeParagraph","Properties":{"id":"20260505170804-9nqwn0s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"undo log，回滚日志，用于记录数据被修改前的信息。在表记录修改之前，会先把数据拷贝到 undo log 里，如果事务回滚，即可以通过 undo log 来还原数据。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可以这样认为，当 delete 一条记录时，undo log 中会记录一条对应的 insert 记录，当 update 一条记录时，它记录一条对应相反的 update 记录。"}]},{"ID":"20260505170804-r7ri7bu","Type":"NodeParagraph","Properties":{"id":"20260505170804-r7ri7bu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"undo log 有什么用途呢？"}]},{"ID":"20260505170804-m7fu89g","Type":"NodeParagraph","Properties":{"id":"20260505170804-m7fu89g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"事务回滚时，保证原子性和一致性。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用于 MVCC 快照读。"}]},{"ID":"20260505170804-2ffm9bd","Type":"NodeParagraph","Properties":{"id":"20260505170804-2ffm9bd","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"版本链"}]},{"ID":"20260505170804-4jxw1ka","Type":"NodeParagraph","Properties":{"id":"20260505170804-4jxw1ka","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多个事务并行操作某一行数据时，不同事务对该行数据的修改会产生多个版本，然后通过回滚指针，连成一个链表，这个链表就称为版本链。如下："}]},{"ID":"20260505170804-v1rleoc","Type":"NodeParagraph","Properties":{"id":"20260505170804-v1rleoc","updated":"20260505170804"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"版本链"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://i-blog.csdnimg.cn/blog_migrate/fcec6b6c770023c99cc8d6664b6b06de.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260505170804-d7vs7uj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-d7vs7uj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"read view"}]},{"ID":"20260505170804-g2lr3z1","Type":"NodeParagraph","Properties":{"id":"20260505170804-g2lr3z1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"事务执行 SQL 语句时，产生的读视图。实际上在 innodb 中，每个 SQL 语句执行前都会得到一个 Read View。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它主要是用来做可见性判断的，即判断当前事务可见哪个版本的数据"}]},{"ID":"20260505170804-7xp0ir9","Type":"NodeParagraph","Properties":{"id":"20260505170804-7xp0ir9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Read View 是如何保证可见性判断的呢？"}]},{"ID":"20260505170804-ke91vkl","Type":"NodeParagraph","Properties":{"id":"20260505170804-ke91vkl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"m_ids:当前系统中那些活跃(未提交)的读写事务 ID, 它数据结构为一个 List"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"min_limit_id:表示在生成 Read View 时，当前系统中活跃的读写事务中最小的事务 id，即 m_ids 中的最小值。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"max_limit_id:表示生成 Read View 时，系统中应该分配给下一个事务的 id 值。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"creator_trx_id: 创建当前 Read View 的事务 ID"}]},{"ID":"20260505170804-5ekyb9l","Type":"NodeParagraph","Properties":{"id":"20260505170804-5ekyb9l","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Read view 匹配条件规则"}]},{"ID":"20260505170804-aqpckqw","Type":"NodeParagraph","Properties":{"id":"20260505170804-aqpckqw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ReadView 匹配规则："},{"Type":"NodeText","Data":"先看数据修改事务 ID 是否小于最小活跃 ID（可见），或大于等于下一个事务 ID（不可见）；中间范围则看是否在活跃列表里 —— 在则不可见，不在则可见；自己改的永远可见"}]},{"ID":"20260505170804-c95xwjb","Type":"NodeParagraph","Properties":{"id":"20260505170804-c95xwjb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"trx_id \u003c min_trx_id：修改数据的事务已提交，数据可见；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"trx_id \u003e= max_trx_id：修改数据的事务在当前事务启动后才开启，数据不可见；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"min_trx_id ≤ trx_id \u003c max_trx_id："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若 trx_id 在 m_ids 中（事务还活跃），数据不可见；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"若 trx_id 不在 m_ids 中（事务已提交），数据可见；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特殊规则：trx_id = creator_trx_id（自己修改的数据），数据可见。"}]},{"ID":"20260505170804-e4954fo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e4954fo","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"InnoDB 有哪几个隐藏列？分别有什么作用？"}]},{"ID":"20260505170804-i21rhib","Type":"NodeParagraph","Properties":{"id":"20260505170804-i21rhib","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 存储引擎会为每一行记录自动维护隐藏列，主要包含以下三个："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"trx_id：必选列，记录最近修改该行数据的事务 ID，用于 MVCC 中判断事务可见性。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"roll_pointer：必选列，回滚指针，指向该行记录在 undo log 中的历史版本，用于构建版本链，实现 MVCC 快照读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"row_id：可选列，只有当表没有显式定义主键，且没有非空唯一索引时，InnoDB 才会自动生成该隐藏主键，是一个单调递增的 6 字节 ID，用于构建聚簇索引。"}]},{"ID":"20260505170804-sfcz51l","Type":"NodeParagraph","Properties":{"id":"20260505170804-sfcz51l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单来说：trx_id 和 roll_pointer 用于实现 MVCC，row_id 是缺省情况下的隐藏聚簇主键。"}]},{"ID":"20260505170804-r33vx44","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-r33vx44","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MVCC 多版本并发控制"}]},{"ID":"20260505170804-00bikr3","Type":"NodeParagraph","Properties":{"id":"20260505170804-00bikr3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MVCC 全称多版本并发控制，是 InnoDB 存储引擎实现 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"可重复读"},{"Type":"NodeText","Data":" 隔离级别的核心机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目的是在"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不加锁"},{"Type":"NodeText","Data":"的情况下，实现读写并发，避免脏读、不可重复读问题。它的底层依赖 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"undo log 版本链"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ReadView 一致性视图"},{"Type":"NodeText","Data":" 共同完成。"}]},{"ID":"20260505170804-u8noe6q","Type":"NodeParagraph","Properties":{"id":"20260505170804-u8noe6q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ReadView 可以理解为事务启动时生成的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"数据可见性快照"},{"Type":"NodeText","Data":"，里面记录了当前所有未提交的活跃事务 ID、最小 / 最大事务 ID，以及当前事务自身 ID。数据库通过这套规则，判断某一行数据的版本对当前事务是否可见。"}]},{"ID":"20260505170804-zv0h7ce","Type":"NodeParagraph","Properties":{"id":"20260505170804-zv0h7ce","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在可重复读隔离级别下，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"事务只会在第一次查询时生成一次 ReadView"},{"Type":"NodeText","Data":"，整个事务期间都复用这个视图。因此无论其他事务如何修改、提交数据，当前事务都只能看到事务启动前的历史版本，从而保证多次读取结果一致，实现可重复读。"}]},{"ID":"20260505170804-6hj634l","Type":"NodeParagraph","Properties":{"id":"20260505170804-6hj634l","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单来说，MVCC 靠"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"旧数据版本 + 可见性判断"},{"Type":"NodeText","Data":"，既保证了事务隔离，又提升了数据库并发性能。"}]},{"ID":"20260505170804-r8ondme","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-r8ondme","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"什么是 MySQL InnoDB 下的当前读和快照读？"}]},{"ID":"20260505170804-2nzpcch","Type":"NodeParagraph","Properties":{"id":"20260505170804-2nzpcch","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"快照读"},{"Type":"NodeText","Data":"是不加锁的普通 SELECT 读取，依靠 MVCC 读取数据的历史快照版本，实现无锁并发，保证可重复读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当前读"},{"Type":"NodeText","Data":"是加锁的读取，比如 SELECT ... FOR UPDATE、UPDATE、DELETE 等，读取的是数据"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最新已提交版本"},{"Type":"NodeText","Data":"，并加锁防止其他事务修改，保证数据的实时一致性。"}]},{"ID":"20260505170804-ov2uj3t","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-ov2uj3t","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"MVCC 怎么实现？"}]},{"ID":"20260505170804-jty76r8","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-jty76r8","updated":"20260505170804"},"Children":[{"ID":"20260505170804-oqliyd1","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260505170804-oqliyd1","updated":"20260505170804"},"Children":[{"ID":"20260505170804-km0hq1d","Type":"NodeParagraph","Properties":{"id":"20260505170804-km0hq1d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"事务启动时，先获取自身的事务 ID（版本号），并生成对应的 Read View（一致性视图）；"}]}]},{"ID":"20260505170804-5lcvlc3","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260505170804-5lcvlc3","updated":"20260505170804"},"Children":[{"ID":"20260505170804-c7lv7ia","Type":"NodeParagraph","Properties":{"id":"20260505170804-c7lv7ia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"查询数据时，先读取数据的当前版本，拿到其修改事务 ID；"}]}]},{"ID":"20260505170804-cuk17yz","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260505170804-cuk17yz","updated":"20260505170804"},"Children":[{"ID":"20260505170804-jsilv1g","Type":"NodeParagraph","Properties":{"id":"20260505170804-jsilv1g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"将该事务 ID 与 Read View 中的可见性规则进行对比；"}]}]},{"ID":"20260505170804-0tu6aws","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260505170804-0tu6aws","updated":"20260505170804"},"Children":[{"ID":"20260505170804-sbqpqx5","Type":"NodeParagraph","Properties":{"id":"20260505170804-sbqpqx5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"若不符合可见性规则，就从 Undo Log 的历史版本链中回溯查找符合规则的历史快照；"}]}]},{"ID":"20260505170804-y1mqb4g","Type":"NodeListItem","Data":"5.","ListData":{"Typ":1,"Tight":true,"Start":5,"Delimiter":46,"Padding":3,"Marker":"NS4=","Num":5},"Properties":{"id":"20260505170804-y1mqb4g","updated":"20260505170804"},"Children":[{"ID":"20260505170804-rdgn8jg","Type":"NodeParagraph","Properties":{"id":"20260505170804-rdgn8jg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最终返回符合 Read View 规则的数据版本。"}]}]}]},{"ID":"20260505170804-e24uk8d","Type":"NodeParagraph","Properties":{"id":"20260505170804-e24uk8d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"本质上，MVCC 就是靠 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Undo Log 保存数据的历史快照"},{"Type":"NodeText","Data":"，再通过 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Read View 的可见性规则"},{"Type":"NodeText","Data":"判断哪个版本对当前事务可见，既保证了可重复读的隔离性，又实现了无锁并发读。"}]},{"ID":"20260505170804-6bci1dr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6bci1dr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 可能发生的死锁"}]},{"ID":"20260505170804-j9jv6yu","Type":"NodeParagraph","Properties":{"id":"20260505170804-j9jv6yu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"读不加锁，写要加锁。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"InnoDB 的死锁，是指多个事务在并发执行时，互相持有对方需要的锁，且都不主动释放，导致彼此永久等待、事务阻塞的现象，主要发生在高并发修改的场景中。"}]},{"ID":"20260505170804-gvb072p","Type":"NodeParagraph","Properties":{"id":"20260505170804-gvb072p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常见死锁场景主要有四种："}]},{"ID":"20260505170804-qlmh8q9","Type":"NodeParagraph","Properties":{"id":"20260505170804-qlmh8q9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多个事务加锁顺序不一致"},{"Type":"NodeText","Data":"，这是最典型的原因。比如事务 A 先锁行 1 再锁行 2，事务 B 先锁行 2 再锁行 1，双方循环等待，形成死锁。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"锁范围过大导致重叠冲突"},{"Type":"NodeText","Data":"，比如使用范围更新或间隙锁、临键锁时，不同事务锁定的区间互相覆盖，引发隐性死锁。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"表锁与行锁混合使用产生冲突"},{"Type":"NodeText","Data":"，例如一个事务持有行锁，另一个执行 DDL 需要表锁，再交叉申请资源就会造成死锁。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"外键约束触发自动加锁"},{"Type":"NodeText","Data":"，在主从表操作时，因外键检查的加锁顺序相反，也可能导致死锁。"}]},{"ID":"20260505170804-i4oq37z","Type":"NodeParagraph","Properties":{"id":"20260505170804-i4oq37z","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 默认开启死锁检测，一旦检测到死锁，会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"立即回滚代价最小的事务"},{"Type":"NodeText","Data":"，让其他事务可以继续执行，从而打破循环等待。"}]},{"ID":"20260505170804-b7c8zz4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-b7c8zz4","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"间歇锁临建锁"}]},{"ID":"20260505170804-d1wc52p","Type":"NodeParagraph","Properties":{"id":"20260505170804-d1wc52p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"间隙锁用于锁定索引之间的间隙，防止其他事务插入数据，避免幻读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"临键锁是 InnoDB 默认的行锁机制，是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"记录锁 + 间隙锁"},{"Type":"NodeText","Data":"的结合，会锁定一个左开右闭的区间，既锁记录又锁间隙，保证在可重复读隔离级别下"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"基本解决幻读"},{"Type":"NodeText","Data":"。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以 InnoDB 通过临键锁机制，在可重复读级别下基本解决了幻读问题。"}]},{"ID":"20260505170804-i0b9ujm","Type":"NodeParagraph","Properties":{"id":"20260505170804-i0b9ujm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"间隙锁 = 锁住一段 范围区间，不让任何人在这段区间插入数据。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只锁记录，只能防止已有记录被修改 / 删除，但锁不住 “区间空隙”，其他事务仍能在空隙里插入新数据，产生幻读。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"必须用间隙锁锁住区间，才能阻止插入，彻底解决幻读。"}]},{"ID":"20260505170804-nhw77wp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-nhw77wp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"SQL 注入和越权访问\t\t\u003e\u003e"}]},{"ID":"20260505170804-1gdbqdo","Type":"NodeParagraph","Properties":{"id":"20260505170804-1gdbqdo","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"SQL 注入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把 SQL 代码伪装成用户输入，让后端把输入当成 SQL 执行，从而窃取 / 篡改数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"攻击者通过在输入框、URL 参数等位置插入恶意 SQL 语句片段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"利用后端代码直接拼接 SQL 字符串的漏洞，使数据库执行非预期的查询或操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种漏洞会导致数据泄露、数据篡改、删库甚至获取服务器权限，危害极大"}]},{"ID":"20260505170804-w5ay96p","Type":"NodeParagraph","Properties":{"id":"20260505170804-w5ay96p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"防御 SQL 注入最有效的方式是使用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"参数化查询（预编译）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"严禁直接拼接 SQL，同时配合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"输入过滤、权限最小化"},{"Type":"NodeText","Data":"进一步提升安全性"}]},{"ID":"20260505170804-9ztw7f2","Type":"NodeParagraph","Properties":{"id":"20260505170804-9ztw7f2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"参数化查询"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在使用时，开发者不直接拼接字符串，而是在 SQL 中使用 占位符（?）表示变量位置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将用户输入作为 “纯数据” 传递"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库会先编译 SQL 结构，再传入参数，即使参数里包含恶意注入语句"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也只会被当作普通字符串处理，无法改变查询逻辑"}]},{"ID":"20260505170804-o87h1lw","Type":"NodeParagraph","Properties":{"id":"20260505170804-o87h1lw","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"越权访问"}]},{"ID":"20260505170804-1hdsbg5","Type":"NodeParagraph","Properties":{"id":"20260505170804-1hdsbg5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"越权访问指用户在系统中超越自身权限，访问或操作了不属于自己的数据或功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它主要分为两种："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"水平越权是同级别用户访问其他用户的数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"垂直越权是低权限用户使用管理员功能"}]},{"ID":"20260505170804-t89vht3","Type":"NodeParagraph","Properties":{"id":"20260505170804-t89vht3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"漏洞根源是后端仅校验登录状态，未校验数据归属或功能权限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"防御越权的核心是在接口层强制校验当前用户与操作资源的关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"使用会话中的用户 ID 进行鉴权，不信任前端传入的身份参数"}]},{"ID":"20260505170804-t6yfmpn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t6yfmpn","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"InnoDB 必须有主键，为什么？"}]},{"ID":"20260505170804-8322rdl","Type":"NodeParagraph","Properties":{"id":"20260505170804-8322rdl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 是索引组织表，表数据本身就是按主键存储的聚簇索引，没有主键就无法存储数据。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主键是数据的唯一标识，决定数据在磁盘的物理存储顺序，保证查询效率。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有二级索引都依赖主键，叶子节点存储主键值，没有主键二级索引无法工作。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果我们不建主键，InnoDB 会自动生成隐藏主键，但这种主键不可控，所以生产环境必须显式创建主键。"}]},{"ID":"20260505170804-dtvnxv0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-dtvnxv0","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"InnoDB 和 MyISAM 两种索引的区别"}]},{"ID":"20260505170804-46gz3df","Type":"NodeParagraph","Properties":{"id":"20260505170804-46gz3df","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 是 MySQL5.5 后的默认存储引擎，支持 ACID 事务、行级锁和外键，采用聚簇索引，能通过 redo log 和 undo log 实现崩溃恢复，并发性能好，适合高并发的 OLTP 场景；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 MyISAM 不支持事务和外键，仅用表级锁，采用非聚簇索引，无崩溃恢复机制，原生支持全文和空间索引，只适合读多写少、低并发的 OLAP 场景和静态数据存储。"}]},{"ID":"20260505170804-tyvnzsg","Type":"NodeParagraph","Properties":{"id":"20260505170804-tyvnzsg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"OLAP：联机分析处理，查询多，计算量大"}]},{"ID":"20260505170804-fu6a9ex","Type":"NodeParagraph","Properties":{"id":"20260505170804-fu6a9ex","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"InnoDB 安全、支持事务、并发强，适合业务系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MyISAM 读取快、结构简单，适合读多写少的静态场景"}]},{"ID":"20260505170804-to8tif3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-to8tif3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"大事务为什么不好？"}]},{"ID":"20260505170804-k3wwu4r","Type":"NodeParagraph","Properties":{"id":"20260505170804-k3wwu4r","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"锁长期占用，导致大量请求阻塞、死锁增多，并发能力下降；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主从同步延迟，造成主从数据不一致；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"undo log 膨胀，占用大量磁盘空间与 IO；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行时间长，易超时、中断，回滚代价巨大。"}]},{"ID":"20260505170804-4x32pmw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4x32pmw","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"自增主键 vs UUID"}]},{"ID":"20260505170804-fr2y78p","Type":"NodeParagraph","Properties":{"id":"20260505170804-fr2y78p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"自增主键有序、占用空间小，适合 InnoDB 聚簇索引，写入查询性能极高，是生产首选。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"UUID 无序、体积大，会造成大量页分裂和索引碎片，性能很差，不适合做主键。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分布式场景推荐用雪花算法，既有序又全局唯一。"}]},{"ID":"20260505170804-z3urj7x","Type":"NodeParagraph","Properties":{"id":"20260505170804-z3urj7x","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"UUID 是一个全球唯一的随机字符串，能保证 ID 不重复，但因为无序且占用空间大，不适合做 MySQL 主键。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"雪花算法：它由时间戳 + 机器 ID + 序列号组成，随时间递增、全局唯一。优点是：有序、数字型、分布式可用，完美适配 InnoDB 聚簇索引，是生产环境分布式主键首选。"}]},{"ID":"20260505170804-v036h1f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-v036h1f","updated":"20260516161831"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MySQL 读写分离"}]},{"ID":"20260505170804-2i6fso5","Type":"NodeParagraph","Properties":{"id":"20260505170804-2i6fso5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"读写分离就是把数据库的写操作集中在主库，读操作分发到多台从库，用来解决高并发场景下读压力过大的问题。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的核心原理是基于 MySQL 主从复制，主库写入后通过 binlog 同步到从库。"}]},{"ID":"20260505170804-bn6l76m","Type":"NodeParagraph","Properties":{"id":"20260505170804-bn6l76m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"主要问题是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主从延迟"},{"Type":"NodeText","Data":"，解决方案是关键查询强制走主库、使用缓存、半同步复制等。"}]},{"ID":"20260516161831-k4hbobf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260516161831-k4hbobf","updated":"20260516163637"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"AI 电影发现平台"}]},{"ID":"20260516163414-ho0rwub","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516163414-ho0rwub","updated":"20260516163637"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"介绍一下这个项目"}]},{"ID":"20260516163514-se5f1bp","Type":"NodeParagraph","Properties":{"id":"20260516163514-se5f1bp","updated":"20260516163537"},"Children":[{"Type":"NodeText","Data":"这个项目是一个 AI 电影发现平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端用 React + Vite，后端用 FastAPI + SQLAlchemy"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心目标不是只做一个电影列表页，而是把“自然语言找电影”这件事做成完整链路"}]},{"ID":"20260516163542-7j3l347","Type":"NodeParagraph","Properties":{"id":"20260516163542-7j3l347","updated":"20260516163637"},"Children":[{"Type":"NodeText","Data":"用户可以完成注册登录、JWT 鉴权、电影搜索、评分收藏、浏览记录这些基础功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在此之上，我做了 AI 找电影能力，支持用户直接输入“想看节奏快、不压抑的高分悬疑片”这类自然语言系统会先做语义解析，再做候选影片筛选，如果本地库里没有，再走远程补抓和降级展示"}]},{"ID":"20260516161850-e9ppd9j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516161850-e9ppd9j","updated":"20260516170847"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么用 React+Vite+FastAPI 进行开发"}]},{"ID":"20260516163705-v3l534v","Type":"NodeParagraph","Properties":{"id":"20260516163705-v3l534v","updated":"20260516164511"},"Children":[{"Type":"NodeText","Data":"首先，这套技术栈前后端职责很清晰"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"React 适合做交互复杂的前端页面，组件化开发效率高，页面状态管理也比较自然"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后端我用 FastAPI，因为它写接口非常快，代码结构清楚，而且天然适合做前后端分离项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端专注界面和交互，后端专注数据和业务逻辑"}]},{"ID":"20260516163705-txb71bj","Type":"NodeParagraph","Properties":{"id":"20260516163705-txb71bj","updated":"20260516164823"},"Children":[{"Type":"NodeText","Data":"其次，Vite 主要解决的是前端开发体验问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它启动快、热更新快，项目一大优势会很明显，开发调试效率比传统脚手架高很多"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对我来说，这意味着能把更多时间放在业务实现上，而不是等编译、等构建"}]},{"ID":"20260516163705-s6c96wg","Type":"NodeParagraph","Properties":{"id":"20260516163705-s6c96wg","updated":"20260516164837"},"Children":[{"Type":"NodeText","Data":"再一个，FastAPI 的优势是性能和规范性都比较好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它基于 Python，开发效率高，接口定义清晰，还自带 Swagger 文档，这对前后端联调特别友好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像电影评分这种项目，本质上就是用户、电影、评分、评论这些数据接口交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"FastAPI 很适合快速搭建、后续扩展也方便"}]},{"ID":"20260516163705-fkjyejv","Type":"NodeParagraph","Properties":{"id":"20260516163705-fkjyejv","updated":"20260516164855"},"Children":[{"Type":"NodeText","Data":"前端用 React + Vite 保证用户体验和开发效率，后端用 FastAPI 保证接口开发速度和可维护性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对于一个电影评分网站来说，这套方案既能快速落地，也方便后面继续加功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如搜索、推荐、用户画像这些"}]},{"ID":"20260516170103-9kfmq9h","Type":"NodeParagraph","Properties":{"id":"20260516170103-9kfmq9h","updated":"20260516170103"},"Children":[{"Type":"NodeText","Data":"SQLAlchemy 可以简单理解成："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Python 里专门用来操作数据库的工具"}]},{"ID":"20260516170108-9369fy8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516170108-9369fy8","updated":"20260528111350"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么用 SQLite 不用 MySQL"}]},{"ID":"20260516181847-6ts2xzi","Type":"NodeParagraph","Properties":{"id":"20260516181847-6ts2xzi","updated":"20260516181916"},"Children":[{"Type":"NodeText","Data":"这个项目我在开发阶段选择 SQLite，主要是因为它更轻量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不需要单独安装和维护数据库服务，开箱即用，特别适合这种个人项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"像电影评分网站前期重点其实是先把用户、电影、评分、评论这些核心功能跑通"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这时候用 SQLite 可以明显降低环境搭建成本，提高开发效率"}]},{"ID":"20260516181847-pppnf78","Type":"NodeParagraph","Properties":{"id":"20260516181847-pppnf78","updated":"20260516181926"},"Children":[{"Type":"NodeText","Data":"另外，这个项目早期并发量不高，数据规模也不算大，SQLite 已经能满足需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对当时的阶段来说，优先解决功能落地，比一开始就上更重的数据库更实际"}]},{"ID":"20260516181847-ms08lsi","Type":"NodeParagraph","Properties":{"id":"20260516181847-ms08lsi","updated":"20260528111350"},"Children":[{"Type":"NodeText","Data":"当然，SQLite 更偏开发和小规模场景，如果后面项目要正式上线、用户量上来，或者并发写入变多我会再切到 MySQL 所以这不是说 MySQL 不好，而是我当时是根据项目阶段和实际需求做技术选型"}]},{"ID":"20260528104827-700217b","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260528104827-700217b","updated":"20260528111420"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你这个项目里，影片的向量数据是怎么存储的？"}]},{"ID":"20260528104852-1efgh46","Type":"NodeParagraph","Properties":{"id":"20260528104852-1efgh46","updated":"20260528110614"},"Children":[{"Type":"NodeText","Data":"影片的向量数据我没有放到独立的向量数据库，比如 Milvus、Pinecone 这种"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是先做了一个更轻量、工程上更稳的方案："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接存到业务数据库的 movie_embeddings 表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每部电影对应一条向量记录，跟电影主表是关联关系"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样数据管理、回填、排查都比较直接"}]},{"ID":"20260528110614-wpc8y5a","Type":"NodeParagraph","Properties":{"id":"20260528110614-wpc8y5a","updated":"20260528110806"},"Children":[{"Type":"NodeText","Data":"具体存储上，当前实现是把 embedding 结果以 JSON 数组的形式落库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开发环境默认是项目里的 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"rating.db，也就是 SQLite"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果后面切到 PostgreSQL，表结构和读写链路也能平滑迁过去"}]},{"ID":"20260528110807-a5ldgyv","Type":"NodeParagraph","Properties":{"id":"20260528110807-a5ldgyv","updated":"20260528110814"},"Children":[{"Type":"NodeText","Data":"所以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现在的向量数据本质上是跟业务数据共库存储的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有额外引入一套独立向量基础设施"}]},{"ID":"20260528111357-6zt3xnj","Type":"NodeParagraph","Properties":{"id":"20260528111357-6zt3xnj","updated":"20260528111420"},"Children":[{"Type":"NodeText","Data":"整个链路是这样的："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把电影的标题、简介这些信息拼成文本，调用 embedding 接口生成向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后通过离线脚本或后台接口批量写入 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检索的时候，再把候选电影的向量读出来，在服务层做相似度计算，拿这个分数参与推荐排序"}]},{"ID":"20260516183501-8g0jejw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260516183501-8g0jejw","updated":"20260518093102"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"这个项目里，你认为最有技术含量的点是什么？"}]},{"ID":"20260516183502-xqhilrx","Type":"NodeParagraph","Properties":{"id":"20260516183502-xqhilrx","updated":"20260516183516"},"Children":[{"Type":"NodeText","Data":"这个项目是一个 AI 电影发现平台，前端用 React + Vite，后端用 FastAPI + SQLAlchemy"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心目标不是只做一个电影列表页，而是把“自然语言找电影”这件事做成完整链路"}]},{"ID":"20260516183516-qt20zlp","Type":"NodeParagraph","Properties":{"id":"20260516183516-qt20zlp","updated":"20260516184002"},"Children":[{"Type":"NodeText","Data":"用户可以完成注册登录、JWT 鉴权、电影搜索、评分收藏、浏览记录这些基础功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在此之上，我做了 AI 找电影能力，支持用户直接输入“想看节奏快、不压抑的高分悬疑片”这类自然语言，系统会先做语义解析，再做候选影片筛选，如果本地库里没有，再走远程补抓和降级展示"}]},{"ID":"20260518093102-dbfo9vz","Type":"NodeThematicBreak","Properties":{"id":"20260518093102-dbfo9vz","updated":"20260518093102"}},{"ID":"20260518090746-ng6uw5e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518090746-ng6uw5e","updated":"20260518093105"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"这个项目解决的核心问题是什么？为什么不只是电影评分站？"}]},{"ID":"20260518091552-fzekxts","Type":"NodeParagraph","Properties":{"id":"20260518091552-fzekxts","updated":"20260518091626"},"Children":[{"Type":"NodeText","Data":"这个项目表面上是电影评分网站，但我实际把它往“AI 电影发现平台”方向做了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统评分站更偏信息展示，用户仍然要自己筛片"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我想解决的是“我今晚想看什么”这个决策问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以我在基础的电影列表、详情、评分、收藏、历史记录之上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"增加了自然语言搜索、相似电影推荐、个性化推荐和推荐理由生成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样用户不需要只靠片名搜索，可以直接输入模糊需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如“想看节奏快、不压抑、适合晚上放松的电影”，系统会给出更接近真实观影场景的结果"}]},{"ID":"20260518091628-w97jjyr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518091628-w97jjyr","updated":"20260518093150"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"你整个系统的架构怎么分层"}]},{"ID":"20260518092742-ss0qpit","Type":"NodeParagraph","Properties":{"id":"20260518092742-ss0qpit","updated":"20260518092836"},"Children":[{"Type":"NodeText","Data":"我按前后端分离和服务职责拆分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端是 React + Vite，负责路由、页面渲染、鉴权态管理和接口调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后端是 FastAPI，负责认证、电影数据查询、收藏/历史、AI 搜索、推荐、播放管理等 API"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库层用 SQLAlchemy 管理模型和持久化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"服务层再细分成认证服务、搜索解析、推荐、海报缓存、播放链接补全、电影同步等模块"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"此外还有脚本层，负责批量导入电影、生成 embedding、重算相似电影、迁移 PostgreSQL"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种分层的好处是控制器薄、业务逻辑集中、脚本任务和在线请求解耦，后续扩展更容易"}]},{"ID":"20260518093051-empdzud","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-empdzud","updated":"20260518124539"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么前端选 React + Vite，后端选 FastAPI？"}]},{"ID":"20260518093148-7qwrr1c","Type":"NodeParagraph","Properties":{"id":"20260518093148-7qwrr1c","updated":"20260518124506"},"Children":[{"Type":"NodeText","Data":"React 适合组件化页面开发，路由和状态管理也成熟；Vite 冷启动快，适合这种中小型前后端分离项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后端选 FastAPI 是因为它对 REST API 场景非常高效，类型标注和 Pydantic 校验配合得很好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接口定义清晰，开发速度快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对我这个项目来说，FastAPI 很适合快速承载认证、电影查询、推荐和 AI 接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而且后续要接脚本和 AI 服务时也比较自然"}]},{"ID":"20260518093051-vxqudlb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-vxqudlb","updated":"20260518140024"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"电影数据从哪里来？抓取、清洗、去重、入库怎么做？"}]},{"ID":"20260518124539-8kjwyv1","Type":"NodeParagraph","Properties":{"id":"20260518124539-8kjwyv1","updated":"20260518124728"},"Children":[{"Type":"NodeText","Data":"项目的数据来源不是单一接口，而是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通过抓取和同步逻辑"},{"Type":"NodeText","Data":"逐步构建本地电影库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体流程是先从外部源抓原始电影信息，再做字段标准化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如标题、原始标题、导演、演员、年份、简介、评分、海报等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后根据外部 ID 或标题做去重和匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后通过同步服务 upsert 到本地库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"upsert 就是 update + insert 的合并操作"}]},{"ID":"20260518124645-zhkgp2r","Type":"NodeParagraph","Properties":{"id":"20260518124645-zhkgp2r","updated":"20260518124651"},"Children":[{"Type":"NodeText","Data":"我的目标不是每次请求都依赖外部接口，而是尽量沉淀到本地数据库里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样查询更快，也方便后续做 embedding、推荐和日志分析"}]},{"ID":"20260518140014-dvyttu1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518140014-dvyttu1","updated":"20260518145916"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"讲一下爬虫模块"}]},{"ID":"20260518140035-6le7w85","Type":"NodeParagraph","Properties":{"id":"20260518140035-6le7w85","updated":"20260518140731"},"Children":[{"Type":"NodeText","Data":"我的设计思路不是把它当成一个独立的小工具，而是把它当成电影网站后端的一个“数据供给模块”来做"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以我一开始就明确，爬虫的目标不是单纯把网页内容抓下来，而是要稳定地给系统补充电影数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"项目里核心实际放在 MovieSpider 这个类里，爬虫承担的是整个片库的冷启动和后续补充工作"}]},{"ID":"20260518140733-ekbcy13","Type":"NodeParagraph","Properties":{"id":"20260518140733-ekbcy13","updated":"20260518141628"},"Children":[{"Type":"NodeText","Data":"实现上，我采用的是“能调接口就调接口，接口不行再抓页面”的策略"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为接般直接返回 JSON，字段结构比较清晰，比如标题、评分、海报地址这些数据通常都是现成的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解析成本低，也不太依赖页结构，所以稳定性更好"}]},{"ID":"20260518141705-t91uoye","Type":"NodeParagraph","Properties":{"id":"20260518141705-t91uoye","updated":"20260518141823"},"Children":[{"Type":"NodeText","Data":"项目里第三方站点并不稳定，页面会改、接口会变"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以我不会把系统压在一个单一入口上，而是尽量做多方案兜底，保证片库同步能力尽可能可用"}]},{"ID":"20260518141825-2afua8s","Type":"NodeParagraph","Properties":{"id":"20260518141825-2afua8s","updated":"20260518142710"},"Children":[{"Type":"NodeText","Data":"抓回来的数据我没有直接返回给前端，而是先进入同步层，也就是 MovieSyncService"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这一层很关键，因为爬虫原始数据通常都不够干净，也不够统一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如不同来源的电影 ID 格式不一样，有的是豆瓣 ID、有的是猫眼 ID，所以我会先做标准化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"除此之外，这一层还会顺带处理海报问题，比如有的电影只有标题没有海报地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我会再去调瓣的联想接口补海报，然后把海报缓存到本地"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样做的好处是，爬虫抓到的数据不是次性的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是会沉淀成系统的标准化库，后搜索、推荐、详情页都能反复复"}]},{"ID":"20260518142711-f6oicw7","Type":"NodeParagraph","Properties":{"id":"20260518142711-f6oicw7","updated":"20260518142958"},"Children":[{"Type":"NodeText","Data":"再往上一层是调度层，负责把爬虫能力接入到真实业务流程里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如项目启动时，如果数据库还是空的，就会自动在后台线程里预加载一批电影"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再比如用户在搜索页搜一部电影，本地数据库里查不到时，后端不会直接返回空"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是触发远程搜索，把瓣搜索结果抓回来，同步进数据库，再重新查本地数据返回给前端"}]},{"ID":"20260518145916-m5t0iuw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518145916-m5t0iuw","updated":"20260522142913"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"项目中怎么做反爬的"}]},{"ID":"20260518145923-oq1cznt","Type":"NodeParagraph","Properties":{"id":"20260518145923-oq1cznt","updated":"20260518145952"},"Children":[{"Type":"NodeText","Data":"这个项目里我没有做特别重的反反爬，对抗思路比较轻量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要做了几件事："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，请求时加浏览器常用请求头，比如 User-Agent 和 Referer，让请求更像正常用户访问"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二，优先调网站本身的接口，因为 JSON 比直接抓页面更稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三，尽量少抓，数据先落本地库，只有冷启动、本地搜不到或者后台刷新时才再去爬"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"减少高频请求触发限流"}]},{"ID":"20260518093051-fj9swde","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-fj9swde","updated":"20260522143146"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用户注册登录怎么做？JWT 放哪、怎么校验？"}]},{"ID":"20260522142919-v5336d9","Type":"NodeParagraph","Properties":{"id":"20260522142919-v5336d9","updated":"20260522143056"},"Children":[{"Type":"NodeText","Data":"后端提供注册和登录接口，密码不明文存储，而是经过哈希后写入数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"登录成功后签发 JWT，前端保存 token，并在后续请求里通过 Authorization 头带上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后端的依赖函数会解析和校验 token，拿到当前用户"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要登录的接口通过受保护依赖强制鉴权，可选登录场景则允许匿名访问但能识别当前用户"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前端路由层也有 ProtectedRoute，避免未登录用户进入个人中心或后台页面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样做的好处是前后端职责明确，接口既支持鉴权又保留匿名访问能力"}]},{"ID":"20260518093051-xbjl73g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-xbjl73g","updated":"20260522145018"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"你的数据库表为什么这样设计？"}]},{"ID":"20260522143143-oqhbjpl","Type":"NodeParagraph","Properties":{"id":"20260522143143-oqhbjpl","updated":"20260522143525"},"Children":[{"Type":"NodeText","Data":"我把核心实体和行为拆开设计"}]},{"ID":"20260522143528-2s9q5ps","Type":"NodeParagraph","Properties":{"id":"20260522143528-2s9q5ps","updated":"20260522143841"},"Children":[{"Type":"NodeText","Data":"users 管用户身份"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"movies 管电影主数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"ratings 存用户对电影的评分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 user"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"id + movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"id 做唯一约束，防止重复评分"}]},{"ID":"20260522143909-chu5rt8","Type":"NodeParagraph","Properties":{"id":"20260522143909-chu5rt8","updated":"20260522144051"},"Children":[{"Type":"NodeText","Data":"favorites 和 watch"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"history 分别表示用户收藏和行为轨迹"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"search"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"logs 记录搜索词、解析结果、结果数量和延迟，用来分析搜索效果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"recommendation"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"logs 记录推荐场景和返回结果，用来评估推荐"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"user"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"profiles 存偏好画像 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings 存电影向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样拆开后，模型职责清晰，既能支撑业务，也便于后续做推荐和分析"}]},{"ID":"20260518093051-xy5wijh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-xy5wijh","updated":"20260522150722"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AI 搜索和普通关键词搜索的区别是什么？"}]},{"ID":"20260522145018-n2d7hhs","Type":"NodeParagraph","Properties":{"id":"20260522145018-n2d7hhs","updated":"20260522145106"},"Children":[{"Type":"NodeText","Data":"普通搜索本质上是基于片名或关键词的匹配，适合用户知道电影名或者演员名的场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 搜索处理的是模糊意图，比如情绪、节奏、类型、观影场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我的 AI 搜索不是单纯让模型“聊天”，而是先把用户意图结构化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再给出候选电影，并尽量映射回本地电影库"}]},{"ID":"20260522145107-ytzswtm","Type":"NodeParagraph","Properties":{"id":"20260522145107-ytzswtm","updated":"20260522145109"},"Children":[{"Type":"NodeText","Data":"这样结果既保留自然语言理解能力，也能保持系统可控、可落库、可追踪"}]},{"ID":"20260518093051-4iho4j7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-4iho4j7","updated":"20260522151130"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一次 AI 搜索请求的完整流程是什么？"}]},{"ID":"20260522150722-ocj59ka","Type":"NodeParagraph","Properties":{"id":"20260522150722-ocj59ka","updated":"20260522150740"},"Children":[{"Type":"NodeText","Data":"一次 AI 搜索请求，前端会把用户输入的一句自然语言，比如“想看轻松一点的高分科幻片”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发到后端的 /api/ai/search。如果用户已经登录，请求里还会带上 JWT；没登录也可以正常搜索"}]},{"ID":"20260522150722-i8yi965","Type":"NodeParagraph","Properties":{"id":"20260522150722-i8yi965","updated":"20260522150753"},"Children":[{"Type":"NodeText","Data":"后端拿到这句话后，直接调用大模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 AI 按用户描述返回几部具体电影，以及每部的推荐理由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，这一步本质上是“用户说需求，AI 直接给片单”"}]},{"ID":"20260522150722-v9kcg1g","Type":"NodeParagraph","Properties":{"id":"20260522150722-v9kcg1g","updated":"20260522150822"},"Children":[{"Type":"NodeText","Data":"拿到 AI 返回的候选电影后，后端会再去和本地电影库做匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本地没有的话，就去远程数据源补库，再把真实电影数据返回给前端"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后后端会记录这次搜索日志，前端再把结果和推荐理由展示出来"}]},{"ID":"20260522150824-v2lqfzf","Type":"NodeParagraph","Properties":{"id":"20260522150824-v2lqfzf","updated":"20260522150825"},"Children":[{"Type":"NodeText","Data":"整体流程就是：用户提需求，AI 先选片，后端再把片单落成站内可展示的数据"}]},{"ID":"20260522151130-7oug5o5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522151130-7oug5o5","updated":"20260522153450"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"后端是怎么调用大模型的"}]},{"ID":"20260522151145-986zu5c","Type":"NodeParagraph","Properties":{"id":"20260522151145-986zu5c","updated":"20260522153545"},"Children":[{"Type":"NodeText","Data":"一次 AI 搜索请求进来后，后端直接把用户的自然语言需求交给大模型做“选片”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"调用 /api/ai/search 对应的服务层，把这句话原样作为 user prompt 发给模型"}]},{"ID":"20260522151145-40kwp5m","Type":"NodeParagraph","Properties":{"id":"20260522151145-40kwp5m","updated":"20260522151719"},"Children":[{"Type":"NodeText","Data":"在调用模型之前，后端会先准备好一个固定的 system prompt"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个 prompt 的作用不是让模型自由聊天，而是把它约束成一个“电影选片助手”："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要求它严格根据用户描述返回几部具体电影，而且输出必须是结构化的 JSON"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一项都要包含片名、年份、导演和推荐理由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样做的目的，是把模型输出从“聊天文本”变成“可直接进入业务流程的候选片单”"}]},{"ID":"20260522151145-zvfa52e","Type":"NodeParagraph","Properties":{"id":"20260522151145-zvfa52e","updated":"20260522152907"},"Children":[{"Type":"NodeText","Data":"实际调用时，服务层会通过 OpenAI 兼容 client 去请求模型，优先走 chat.completions"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并且把温度设为 0，尽量保证结果稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时加上超时控制和格式约束，避免模型输出发散"}]},{"ID":"20260522153038-dkja0oj","Type":"NodeParagraph","Properties":{"id":"20260522153038-dkja0oj","updated":"20260522153042"},"Children":[{"Type":"NodeText","Data":"大模型输出会作为接口响应内容返回给后端，后端再从响应对象里把文本取出来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"解析成 JSON，转换成程序内部可用的电影候选数据"}]},{"ID":"20260522153421-7etrk2n","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260522153421-7etrk2n","updated":"20260522153421"},"Children":[{"ID":"20260522153421-en7cb5l","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260522153421-en7cb5l","updated":"20260522153421"},"Children":[{"ID":"20260522153421-rp16s68","Type":"NodeParagraph","Properties":{"id":"20260522153421-rp16s68","updated":"20260522153421"},"Children":[{"Type":"NodeText","Data":"后端先主动发一个 HTTP/API 请求给大模型"}]}]},{"ID":"20260522153421-exzy1tt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260522153421-exzy1tt","updated":"20260522153421"},"Children":[{"ID":"20260522153421-y8p07d0","Type":"NodeParagraph","Properties":{"id":"20260522153421-y8p07d0","updated":"20260522153421"},"Children":[{"Type":"NodeText","Data":"大模型处理完后，把结果放在响应对象里返回"}]}]},{"ID":"20260522153421-0yzu0vw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260522153421-0yzu0vw","updated":"20260522153421"},"Children":[{"ID":"20260522153421-xy725fy","Type":"NodeParagraph","Properties":{"id":"20260522153421-xy725fy","updated":"20260522153421"},"Children":[{"Type":"NodeText","Data":"后端代码再从这个响应对象里把文本取出来"}]}]}]},{"ID":"20260522151841-bi868y4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"Y3Bw","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260522151841-bi868y4","updated":"20260522151856"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"Y3Bw"},{"Type":"NodeCodeBlockCode","Data":"后端系统提示词：\n\n你是电影选片助手。你的任务不是泛泛推荐高分电影，而是严格根据用户描述挑出最符合条件的具体影片。\n\n请只返回 JSON 数组，不要输出任何解释、标题、代码块标记或 markdown。\n\n输出格式：\n[\n  {\n    \"title\": \"电影名\",\n    \"year\": \"电影年份\",\n    \"director\": \"导演名\",\n    \"reason\": \"一句简短中文理由\"\n  }\n]\n\n硬性规则：\n1. 返回 3 到 8 部电影。\n2. 每个元素都必须包含 title、year、director、reason。\n3. year 必须是整数；没有把握时填 null。\n4. director 没把握时可填空字符串。\n5. reason 只写 1 句中文，20 到 50 字，不要空话。\n6. 只推荐真实存在且较容易检索到的电影。\n7. 不要编造演员、导演、年份、剧情。\n\n筛选优先级：\n1. 如果用户提到了演员、导演、系列、国家、时代、风格、题材、情绪，这些约束优先于“高分”。\n2. 如果用户明确提到某个演员或导演，优先推荐此人参与的电影；不要忽略这个条件改推其他名片。\n3. 如果用户明确提到类型或风格，例如“搞笑”“喜剧”“悬疑”“科幻”，必须优先满足这个条件。\n4. 只有在同时满足人物和题材时才优先返回；不要因为影片更有名就放宽条件。\n\n严格限制：\n1. 当用户要求很具体时，不要退化成“高分电影榜单”。\n2. 如果某部电影与用户条件明显不相关，就绝对不要返回。\n3. 如果能确定的符合条件影片不足 3 部，可以少返回，宁可少也不要乱凑。\n4. 如果用户说“邓超的搞笑电影”，应优先考虑邓超主演或导演、且明显属于喜剧/搞笑方向的电影；不要返回与邓超无关的高分片。\n5. 如果用户说“周星驰的无厘头电影”，应优先返回周星驰相关且符合无厘头风格的作品；不要泛化成普通喜剧。\n\n输出前自检：\n1. 检查每一部电影是否真的符合用户描述。\n2. 删除所有不满足核心约束的影片。\n3. 再输出最终 JSON 数组。\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260518093051-hugn1aa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-hugn1aa","updated":"20260522153652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么不直接让大模型输出最终答案，而是做候选推荐 + 本地匹配 + 补库？"}]},{"ID":"20260522153346-ioz0gbh","Type":"NodeParagraph","Properties":{"id":"20260522153346-ioz0gbh","updated":"20260522153626"},"Children":[{"Type":"NodeText","Data":"如果完全让模型直接输出，问题是结果不可控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也无法复用已有详情页、收藏、评分、播放链接这些能力"}]},{"ID":"20260522153626-docm2d5","Type":"NodeParagraph","Properties":{"id":"20260522153626-docm2d5","updated":"20260522153637"},"Children":[{"Type":"NodeText","Data":"我采用“候选推荐 + 本地匹配”的方式，是为了让 AI 成为召回入口，而不是替代整个业务系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样推荐结果最终仍然落在本地 movie 实体上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能和现有页面、数据库、日志和推荐链路打通"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果本地缺失，再补库，兼顾灵活性和可维护性"}]},{"ID":"20260522153648-msevqwz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522153648-msevqwz","updated":"20260522160507"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"如果大模型返回库里没有的电影怎么办？"}]},{"ID":"20260522153650-eoretme","Type":"NodeParagraph","Properties":{"id":"20260522153650-eoretme","updated":"20260522160042"},"Children":[{"Type":"NodeText","Data":"先尝试本地匹配，匹配不到就走 remote backfill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"去远程源按标题检索并拉取电影数据，然后 upsert 到本地"}]},{"ID":"20260522160337-ot470y5","Type":"NodeParagraph","Properties":{"id":"20260522160337-ot470y5","updated":"20260522160352"},"Children":[{"Type":"NodeText","Data":"直接拿 AI 已经给出的电影片名去查远程数据源，这样目标更明确，噪声更小"}]},{"ID":"20260522160337-6fcktum","Type":"NodeParagraph","Properties":{"id":"20260522160337-6fcktum","updated":"20260522160404"},"Children":[{"Type":"NodeText","Data":"实现上我优先调外部电影搜索 API，按标题去请求 TMDB 这类接口，拿到结构化的电影数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如标题、原名、海报、简介、年份、评分这些字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样比直接爬网页更稳定，也更方便后端处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果 API 这条路拿不到结果，代码里还会再回退到网页搜索，用页面解析做兜底"}]},{"ID":"20260522160337-453nzgm","Type":"NodeParagraph","Properties":{"id":"20260522160337-453nzgm","updated":"20260522160443"},"Children":[{"Type":"NodeText","Data":"拿到远程结果后，后端会再做一次标题匹配，尽量确认补到的是同一部电影"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"确认之后，我会把这些远程字段统一映射成项目内部的电影结构，然后用 upsert 写回本地库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样这次 AI 推荐不只是临时展示一下，而是真的沉淀成了一条本地电影数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后面详情、评分、收藏这些功能都能直接复用"}]},{"ID":"20260522154902-84on91x","Type":"NodeParagraph","Properties":{"id":"20260522154902-84on91x","updated":"20260522154918"},"Children":[{"Type":"NodeText","Data":"如果远程也找不到，我不会让接口直接报错，而是保留一个 direct AI 结果作为兜底"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让用户至少能看到候选信息和推荐理由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说我把“严格落库”和“用户体验兜底”都考虑了"}]},{"ID":"20260522160503-232jvdv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522160503-232jvdv","updated":"20260522160727"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"你怎么控制 AI 返回格式稳定？"}]},{"ID":"20260522160507-kxpdmij","Type":"NodeParagraph","Properties":{"id":"20260522160507-kxpdmij","updated":"20260522160654"},"Children":[{"Type":"NodeText","Data":"我在 prompt 里明确要求返回 JSON 结构，并且限制字段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如 title、year、director、reason"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现上优先调用支持结构化输出的接口，并在服务层做 JSON 解析和字段校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果不是列表或者缺少必要字段，就视为无效响应"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一次失败还会重试一次，最终不行就降级"}]},{"ID":"20260522160655-1wmjduu","Type":"NodeParagraph","Properties":{"id":"20260522160655-1wmjduu","updated":"20260522160656"},"Children":[{"Type":"NodeText","Data":"也就是说，prompt 约束只是第一层，真正兜底的是程序解析和失败分支"}]},{"ID":"20260518093051-sci5ioi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-sci5ioi","updated":"20260522161108"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AI 超时、空结果、胡乱推荐时怎么降级？"}]},{"ID":"20260522160724-o5qiz3j","Type":"NodeParagraph","Properties":{"id":"20260522160724-o5qiz3j","updated":"20260522160744"},"Children":[{"Type":"NodeText","Data":"我做了几个层次的降级"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一，调用设置超时，避免请求无限挂起"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二，如果第一次空结果或非法 JSON，会自动重试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三，如果模型不可用或者超时，接口会返回明确的 provider/fallback 状态，而不是让前端无响应第四，即使无法落库，也可以返回 direct AI 候选结果"}]},{"ID":"20260522160745-vua6g2n","Type":"NodeParagraph","Properties":{"id":"20260522160745-vua6g2n","updated":"20260522160748"},"Children":[{"Type":"NodeText","Data":"核心原则是：宁可降低智能程度，也不要让用户完全没有结果"}]},{"ID":"20260518093051-4qkxuh7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-4qkxuh7","updated":"20260522163259"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"推荐系统怎么做？是纯规则、向量召回，还是 LLM 直接推荐？"}]},{"ID":"20260522161108-3542pdf","Type":"NodeParagraph","Properties":{"id":"20260522161108-3542pdf","updated":"20260522161455"},"Children":[{"Type":"NodeText","Data":"我没有直接用 LLM 做主推荐，而是把它放在理解和解释层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"推荐主链路分两类："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"未登录用户走高分热门兜底"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"已登录用户先构建用户画像，再基于偏好生成查询，由向量检索在候选电影中打分召回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时结合评分和时间等因素排序"}]},{"ID":"20260522161455-95unlcr","Type":"NodeParagraph","Properties":{"id":"20260522161455-95unlcr","updated":"20260522161708"},"Children":[{"Type":"NodeText","Data":"相似电影推荐优先使用缓存好的相似度表，没有缓存时再用 embedding fallback 计算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样做的原因是推荐主逻辑需要稳定、可控、低成本"}]},{"ID":"20260522162719-fnd3s34","Type":"NodeParagraph","Properties":{"id":"20260522162719-fnd3s34","updated":"20260522162735"},"Children":[{"Type":"NodeText","Data":"如果 embedding 服务可用，系统会先把 query 转成向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再去数据库里取候选电影已经存好的 embedding"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后用余弦相似度算 query 和每部电影之间的接近程度，按分数从高到低取 TopK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这一步本质上是在回答一个问题："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"哪几部电影在“语义上”最接近这个用户当前的兴趣"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相比纯关键词匹配，它的好处是用户没明确说出完全一样的词，系统也可能找到意思接近的内容"}]},{"ID":"20260522162719-b7vcho0","Type":"NodeParagraph","Properties":{"id":"20260522162719-b7vcho0","updated":"20260522162754"},"Children":[{"Type":"NodeText","Data":"我这里还专门做了降级设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为线上不能把推荐链路完全绑死在 embedding 服务上，所以如果没有 embedding client"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者某些电影还没生成向量，系统就会自动退回到 lexical fallback"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是基于标题、简介、导演、演员这些文本字段做词项匹配"}]},{"ID":"20260522162514-6rdk43u","Type":"NodeParagraph","Properties":{"id":"20260522162514-6rdk43u","updated":"20260522162539"},"Children":[{"Type":"NodeText","Data":"相似电影推荐则是另一种思路"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个场景很高频，比如用户看完一部电影，马上想知道“还有没有类似的”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以我优先用提前算好的相似度缓存表，查起来就是直接读结果，速度快、结果也稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果缓存里没有，再用 embedding 做一次 fallback 计算，临时找出内容最接近的电影"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样设计的好处是，大部分请求都能低成本、低延迟返回，少数没命中的情况也不会功能失效"}]},{"ID":"20260522163259-u93f8ph","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522163259-u93f8ph","updated":"20260522163325"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"电影的 embedding 是怎么算出来的"}]},{"ID":"20260522163259-usq93b6","Type":"NodeParagraph","Properties":{"id":"20260522163259-usq93b6","updated":"20260522163246"},"Children":[{"Type":"NodeText","Data":"电影 embedding 这块，我不是实时现算的，而是离线提前算好"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"具体做法是先把一部电影的标题、导演、演员、地区、年份、评分、剧情简介这些信息拼成一段文本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相当于先把电影整理成一个完整的内容描述，再送去 embedding 模型转成向量，最后存到数据库里"}]},{"ID":"20260522163259-6uiwreo","Type":"NodeParagraph","Properties":{"id":"20260522163259-6uiwreo","updated":"20260522163252"},"Children":[{"Type":"NodeText","Data":"这样后面做推荐时，只需要把用户兴趣转成 query 向量，再和电影向量做相似度计算，就能找到语义上最接近的电影"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样设计的好处是线上响应快、成本低，而且比纯关键词匹配更准确"}]},{"ID":"20260518093051-eswpv4r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-eswpv4r","updated":"20260522164336"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"冷启动怎么解决？"}]},{"ID":"20260522163325-ld1ab1t","Type":"NodeParagraph","Properties":{"id":"20260522163325-ld1ab1t","updated":"20260522163501"},"Children":[{"Type":"NodeText","Data":"冷启动分两种"}]},{"ID":"20260522163502-ky05xku","Type":"NodeParagraph","Properties":{"id":"20260522163502-ky05xku","updated":"20260522163522"},"Children":[{"Type":"NodeText","Data":"未登录冷启动，我直接返回高分热门电影，保证首页有稳定内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新登录但行为不足的用户，我会用初步画像或者高分电影作为默认召回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再逐步用收藏、评分、历史、搜索行为更新画像"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"冷启动阶段重点不是“绝对个性化”，而是先保证结果质量和可用性，随着行为积累再提高个性化程度"}]},{"ID":"20260522164336-idrid11","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522164336-idrid11","updated":"20260522163753"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"相似电影推荐怎么做？"}]},{"ID":"20260522164336-auum48l","Type":"NodeParagraph","Properties":{"id":"20260522164336-auum48l","updated":"20260522163757"},"Children":[{"Type":"NodeText","Data":"我有两层策略"}]},{"ID":"20260522164336-m1zr1k7","Type":"NodeParagraph","Properties":{"id":"20260522164336-m1zr1k7","updated":"20260522163754"},"Children":[{"Type":"NodeText","Data":"优先层是读取 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"similarities 缓存表，直接返回已经计算好的相似电影，这样接口快"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果缓存不存在，就用当前电影的标题和简介作为查询文本，对候选电影做向量检索，选出 topK 结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后把结果带上解释，比如题材、剧情摘要和整体风格接近"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个方案兼顾了性能和效果，也方便后续批量离线重算"}]},{"ID":"20260522164336-lecqg8g","Type":"NodeParagraph","Properties":{"id":"20260522164336-lecqg8g","updated":"20260522164316"},"Children":[{"Type":"NodeText","Data":"后端这边其实就是先把电影的标题、导演、演员、年份、简介这些信息拼成一段文本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后调用 embedding 接口把这段文本转成向量，存到 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings 表里"}]},{"ID":"20260522164336-wxn5s6f","Type":"NodeParagraph","Properties":{"id":"20260522164336-wxn5s6f","updated":"20260522164329"},"Children":[{"Type":"NodeText","Data":"做推荐时，再把用户偏好生成的 query 用同样方式转成向量，和电影向量做余弦相似度计算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"找出最接近的电影如果接口调用失败，还有本地 fallback 兜底，保证推荐链路不会断"}]},{"ID":"20260518093051-wpicun3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260518093051-wpicun3","updated":"20260604211000"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为什么要有"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"user_profile"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"movie_embeddings"}]},{"ID":"20260522163813-th3hbql","Type":"NodeParagraph","Properties":{"id":"20260522163813-th3hbql","updated":"20260522163840"},"Children":[{"Type":"NodeText","Data":"movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings 是把电影的文本信息转成可检索向量，解决“语义相近但关键词不重合”的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"user"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"profile 则把用户的收藏、评分、历史等行为沉淀成偏好摘要"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如喜欢的类型、国家、年份区间、时长偏好等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两者配合后，推荐不再只是“全站高分”，而是“用用户偏好去检索更相关的电影”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这也是从信息展示系统升级到推荐系统的关键"}]},{"ID":"20260522164057-vwey3vt","Type":"NodeParagraph","Properties":{"id":"20260522164057-vwey3vt","updated":"20260522164110"},"Children":[{"Type":"NodeText","Data":"embedding 模型本质上是把文本映射到向量空间的编码模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我们把电影内容编码成 movie embedding，把用户偏好编码成 query embedding，再通过余弦相似度做召回"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样解决的是语义匹配问题，而不是让大模型直接做推荐决策"}]},{"ID":"20260518093051-usw0f27","Type":"NodeParagraph","Properties":{"id":"20260518093051-usw0f27","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工程与设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"17. 为什么"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"rating"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要单独成表？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：因为评分是用户和电影之间的多对多关系，而且会持续增长、更新，还有唯一性约束和时间维度。如果把评分塞进 users 或 movies，模型会失真，也不利于查询统计。单独成表后，可以方便做用户评分记录、电影平均分、用户偏好分析以及后续推荐特征抽取。"}]},{"ID":"20260518093051-tw2xtm4","Type":"NodeParagraph","Properties":{"id":"20260518093051-tw2xtm4","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"18. 为什么"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"favorites"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"watch\\_history"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要拆开？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：因为两者语义不同。收藏代表显式偏好，通常强于点击；观影历史代表行为轨迹，可能只是浏览、点击、想看或已看。拆开后可以给不同权重，也更方便做埋点分析和推荐建模。如果合成一张表，会导致业务含义混乱。"}]},{"ID":"20260528104814-80d9uxg","Type":"NodeParagraph","Properties":{"id":"20260528104814-80d9uxg","updated":"20260528104814"}},{"ID":"20260518093051-f7s0lwv","Type":"NodeParagraph","Properties":{"id":"20260518093051-f7s0lwv","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"19. 为什么"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"MovieSimilarity"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要做缓存表？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：因为相似电影计算相对重，尤其候选集大了以后不适合每次实时算。把结果缓存到表里后，详情页查询会非常快，也便于离线批量重建。这个设计本质上是把“计算密集型逻辑”前移到后台任务，提高线上接口稳定性。"}]},{"ID":"20260518093051-v3malek","Type":"NodeParagraph","Properties":{"id":"20260518093051-v3malek","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"20. 为什么 embedding 先存 JSON？优缺点是什么？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：当前阶段存 JSON 是为了开发简单，和 SQLite 兼容，便于先把 AI 检索链路跑通。优点是实现成本低、迁移快；缺点是数据库层无法高效做向量索引和相似度查询，所以真正规模化时我会迁到 PostgreSQL + pgvector，把 embedding 存成向量类型，让召回计算下沉到数据库层。"}]},{"ID":"20260518093051-5xdi30l","Type":"NodeParagraph","Properties":{"id":"20260518093051-5xdi30l","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"21. 为什么写了这么多脚本？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：因为我不希望把数据准备、模型构建、补库、重算逻辑都塞进在线 API。比如初始化数据库、同步电影、导入播放链接、回填海报缓存、生成 embedding、重算相似度，这些都更适合作为离线或运维脚本。这样在线请求更轻，职责更清晰，线上故障面也更小。"}]},{"ID":"20260518093051-e53j4xl","Type":"NodeParagraph","Properties":{"id":"20260518093051-e53j4xl","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"22. 启动时为什么有 preload catalog 的后台线程？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：这是为了优化新环境初始化体验。如果数据库里还没有电影数据，而且也没有真实用户，我会在启动阶段异步预加载目录数据，让系统首次启动后能尽快有可浏览内容。之所以放后台线程，是为了避免阻塞 API 启动，保证服务先可用，再逐步补齐基础数据。"}]},{"ID":"20260518093051-i3u5o4b","Type":"NodeParagraph","Properties":{"id":"20260518093051-i3u5o4b","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"23. 你的 CORS、静态资源、接口路由怎么组织？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：CORS 通过环境变量优先配置，开发阶段允许本地多个前端端口访问；静态资源通过 /static 挂载，主要承载本地海报缓存；接口按业务域拆成多个 router，比如 auth、users、movies、favorites、history、ai、recommendations、admin"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"ai、proxy。这样做的目的是让入口文件只负责装配，业务逻辑落在各自模块里。"}]},{"ID":"20260518093051-vxh34n6","Type":"NodeParagraph","Properties":{"id":"20260518093051-vxh34n6","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"24. SQLite 为什么不够？你怎么迁到 PostgreSQL？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：SQLite 适合本地开发和单机验证，但在并发写入、复杂查询、扩展性和向量能力上都有限。我的迁移思路是先保持 SQLAlchemy 模型层稳定，再切换数据库连接，并提供迁移脚本把电影、用户、评分、收藏、历史、日志等数据导入 PostgreSQL；随后引入 pgvector，把 embedding 和相似检索下沉到数据库层。也就是说我会尽量保持应用层 API 不变，先替换存储能力。"}]},{"ID":"20260518093051-k6ezb58","Type":"NodeParagraph","Properties":{"id":"20260518093051-k6ezb58","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"风险与优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"25."},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"/admin/playback"},{"Type":"NodeText","Data":"  "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现在只是登录保护，管理员权限怎么补？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：这是我当前实现里一个明确可以继续完善的点。现在前端路由是受保护的，但严格来说这不等于管理员鉴权。更完整的方案是在 users 表增加角色字段，比如 user / admin，后端管理接口增加角色校验依赖，前端只是做展示层拦截，真正权限控制必须以后端为准。面试里我会主动指出这一点，说明我区分了“登录态校验”和“授权控制”。"}]},{"ID":"20260518093051-p5ra9w1","Type":"NodeParagraph","Properties":{"id":"20260518093051-p5ra9w1","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"26. AI 搜索成本和延迟怎么控制？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：我的策略是把 AI 放在必要环节，而不是每次都全链路依赖模型。比如 query summarize 可以走本地规则解析，只有 curated search 才调用模型；同时设置超时、限制候选数量、失败重试次数有限，结果再尽量映射到本地库减少后续外部依赖。后续如果要进一步控成本，我会加缓存、热门 query 预计算和埋点分析，识别高频需求。"}]},{"ID":"20260518093051-pw4x6ui","Type":"NodeParagraph","Properties":{"id":"20260518093051-pw4x6ui","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"27. 在线请求里触发抓取/补库会不会拖慢接口？为什么不做异步任务队列？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：会，所以这是一个典型的 MVP 和生产化之间的权衡。当前 remote backfill 的好处是链路闭环快，能快速验证“AI 推荐到本地落库”的流程；缺点是外部依赖会拉长接口耗时。生产化时我会把补库改成异步任务，接口先返回已有结果或占位信息，再由任务队列补齐数据。也就是说我知道现在方案的边界，它是为了先验证业务闭环，而不是最终形态。"}]},{"ID":"20260518093051-21c1yol","Type":"NodeParagraph","Properties":{"id":"20260518093051-21c1yol","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"28. 当前系统最大的性能瓶颈在哪？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：当前最明显的瓶颈不是普通电影列表，而是 AI 搜索和相似推荐链路中的外部依赖与 Python 层计算。具体包括模型调用延迟、remote backfill、embedding 检索未下沉数据库、相似电影 fallback 的候选遍历等。短期优化我会先做缓存和离线预计算；中期会迁 PostgreSQL + pgvector；长期再考虑异步任务和更细的埋点监控。"}]},{"ID":"20260518093051-gj37l2i","Type":"NodeParagraph","Properties":{"id":"20260518093051-gj37l2i","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"29. 如果明天要上线，你最先补哪三件事？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：第一，补齐管理员角色和后端权限控制；第二，把高耗时的补库和重算逻辑改成异步任务，减少接口抖动；第三，上 PostgreSQL，并增加日志监控、限流和错误告警。如果只能再补一点，我会加搜索和推荐效果埋点，因为没有数据闭环就无法持续优化。"}]},{"ID":"20260518093051-5o3ovu6","Type":"NodeParagraph","Properties":{"id":"20260518093051-5o3ovu6","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"测试与项目亮点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"30. 你怎么做测试？前后端分别测了什么？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：前端我用 Vitest 和 Testing Library，覆盖了页面、组件、AuthContext、API 封装以及部分集成行为；后端我用 pytest，测试了启动、数据库、电影 API、AI 搜索、推荐、播放管理、海报缓存、补库脚本等关键链路。我的测试思路不是只测纯函数，而是优先覆盖“最容易回归、最影响用户体验”的路径，比如登录态、搜索结果、推荐接口和后台能力。"}]},{"ID":"20260518093051-et1xbx8","Type":"NodeParagraph","Properties":{"id":"20260518093051-et1xbx8","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"31. 你最有价值的一条测试是什么？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：如果只选一条，我会选 AI 搜索或推荐链路的接口测试。因为这类功能跨了请求参数、服务编排、数据库读取和返回结构，最容易因为改动某一层而破坏整体契约。测这种接口比只测单个工具函数更能反映系统稳定性。"}]},{"ID":"20260518093051-jwt7x0t","Type":"NodeParagraph","Properties":{"id":"20260518093051-jwt7x0t","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"32. 你遇到的最难问题是什么？怎么解决的？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：最难的不是把页面写出来，而是把“AI 推荐”从一个演示能力做成系统能力。核心难点是模型输出不稳定、库内电影不完整、外部数据质量不一致。我最后的解决思路是把链路拆成几步：模型负责给候选，本地库负责承接，匹配不到再补库，同时全程记录日志和延迟，并为超时、空结果、无效 JSON 做降级。这个过程让我比较明确地把“智能能力”和“工程可控性”分开了。"}]},{"ID":"20260518093051-1f24ngp","Type":"NodeParagraph","Properties":{"id":"20260518093051-1f24ngp","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"33. 这个项目里，普通搜索、AI 搜索、推荐，这三者的边界是什么？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：普通搜索解决“我知道我要找什么”的问题，重在精确查找；AI 搜索解决“我不知道片名，但知道需求”的问题，重在意图理解；推荐解决“系统主动给我可能喜欢什么”的问题，重在个性化召回。三者都服务于找片，但触发方式、输入类型和系统责任不同。我在架构上也把它们拆成独立接口和服务，避免逻辑混在一起。"}]},{"ID":"20260518093051-zbelmsx","Type":"NodeParagraph","Properties":{"id":"20260518093051-zbelmsx","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"34. 你说用了向量搜索，那 embedding 怎么生成和更新？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：电影 embedding 不是在线现算，而是通过离线脚本批量构建。输入通常是电影标题、简介、导演、演员、类型等文本拼接，然后调用 embedding 模型生成向量，写入 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings。当电影主信息发生明显变化，或者模型版本升级时，我会通过 content"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"version 和脚本重建向量，避免线上接口承担高成本计算。"}]},{"ID":"20260518093051-82exbp9","Type":"NodeParagraph","Properties":{"id":"20260518093051-82exbp9","updated":"20260518093051"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"35. 你说有推荐理由，这个 reason 是规则生成还是模型生成？为什么这么选？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答：当前更偏规则和模板生成，而不是每条都调用 LLM。原因很直接：推荐理由的价值是帮助用户理解结果，不需要每次都付出高延迟和高成本。规则生成能结合类型、画像、查询意图和电影元数据做出足够可读的解释，稳定、快、便宜。如果后续要增强表达自然度，我会把 LLM 放在离线生成或可选增强层，而不是主链路强依赖。"}]},{"ID":"20260604211000-yg19llm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260604211000-yg19llm","updated":"20260604211300"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"项目中影片向量数据是怎么算的"}]},{"ID":"20260604211000-48wlki9","Type":"NodeParagraph","Properties":{"id":"20260604211000-48wlki9","updated":"20260604210855"},"Children":[{"Type":"NodeText","Data":"项目里的影片向量，本质上是把一部电影的文本信息整理成一段描述"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后送给 embedding 模型生成一个数字向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"参与拼接的字段主要有片名、原标题、导演、演员、国家、语言、年份、时长、豆瓣评分和简介"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，它不是直接拿某一个字段算"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是先把整部电影的关键信息合成一段文本，再做向量化"}]},{"ID":"20260604211000-rlv9e74","Type":"NodeParagraph","Properties":{"id":"20260604211000-rlv9e74","updated":"20260604210906"},"Children":[{"Type":"NodeText","Data":"生成时优先走配置好的 embedding 接口，模型名来自环境变量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"默认是 doubao-embedding-vision"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果接口没配好、没有 API Key，或者请求失败，代码就会降级到一个本地的 deterministic"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embedding 方案，用哈希函数生成固定 64 维的伪向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这个降级方案能保证系统继续跑，但语义效果肯定不如真实 embedding"}]},{"ID":"20260604211000-l64jp6m","Type":"NodeParagraph","Properties":{"id":"20260604211000-l64jp6m","updated":"20260604210931"},"Children":[{"Type":"NodeText","Data":"生成好的结果会存进 movie"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"embeddings 表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"里面除了向量本身，还会保存当时用于生成向量的原始文本 content"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"text 和模型名 model"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"_"}]},{"Type":"NodeText","Data":"name"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"向量通常是通过离线脚本或后台接口批量回填，不是每次用户请求时临时给所有电影重算"}]},{"ID":"20260604211000-vemkztw","Type":"NodeParagraph","Properties":{"id":"20260604211000-vemkztw","updated":"20260604210948"},"Children":[{"Type":"NodeText","Data":"后续在搜索和推荐里，会把用户查询也转成向量，再和影片向量做余弦相似度计算，相似度越高"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"说明语义上越接近"}]},{"ID":"20260604211000-j1imvtv","Type":"NodeParagraph","Properties":{"id":"20260604211000-j1imvtv","updated":"20260604210952"},"Children":[{"Type":"NodeText","Data":"所以这套逻辑的核心可以概括成一句话："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把电影内容文本化，再做 embedding，最后用向量相似度支撑搜索和推荐"}]},{"ID":"20260604211002-fc1ov2t","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260604211002-fc1ov2t","updated":"20260604211521"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"向量模型和降级策略具体是怎么做的"}]},{"ID":"20260604211410-dgtgxuv","Type":"NodeParagraph","Properties":{"id":"20260604211410-dgtgxuv","updated":"20260604211423"},"Children":[{"Type":"NodeText","Data":"embedding 直接调用，不需要 system prompt"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为它不是聊天模型，不负责回答问题，也不会生成一段话，它只做一件事"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就是把输入文本转成一个向量"}]},{"ID":"20260604211410-arpmsyv","Type":"NodeParagraph","Properties":{"id":"20260604211410-arpmsyv","updated":"20260604211429"},"Children":[{"Type":"NodeText","Data":"所以我的做法很简单："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把电影的标题、导演、演员、年份、简介这些信息拼成一段文本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后直接传给 embeddings.create()，模型返回一串向量，这一步就结束了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有角色设定，没有提示词，也不用控制输出格式"}]},{"ID":"20260604211430-21fvej7","Type":"NodeParagraph","Properties":{"id":"20260604211430-21fvej7","updated":"20260604211521"},"Children":[{"Type":"NodeText","Data":"降级思路："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把文本标准化，然后做 sha256 哈希，再把哈希结果切成若干段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"映射成 -1 到 1 之间的数，最后凑成固定 64 维向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不是真正理解语义的 AI 向量，但优点是同一段文本每次都会得到同一个结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以系统还能继续完成排序、推荐和检索流程"}]},{"ID":"20260604211303-1k6qph9","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260604211303-1k6qph9","updated":"20260907075407"},"Children":[{"Type":"NodeText","Data":"Agent"}]},{"ID":"20260906170108-2nrkj70","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260906170108-2nrkj70","updated":"20260907075407"},"Children":[{"Type":"NodeText","Data":"Agent 的基本架构由哪些核心组件构成"}]},{"ID":"20260906165616-hew2xc8","Type":"NodeParagraph","Properties":{"id":"20260906165616-hew2xc8","updated":"20260906170039"},"Children":[{"Type":"NodeText","Data":"可以把Agent系统比成一家公司：\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"LLM是老板"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，所有决策都经过它拍板\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"工具系统是外包执行团队"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，老板说指令，他们负责真正干活\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"记忆系统是公司档案室"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，各种信息的存档和调档都靠它\n"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"规划模块就是项目经理"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，拿到一个大项目后负责拆解成可执行的任务单\n四个角色各司其职，才撑起了Agent的自主运行能力"}]},{"ID":"20260906170111-anqxzg1","Type":"NodeParagraph","Properties":{"id":"20260906170111-anqxzg1","updated":"20260907065727"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"注意："},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n记忆分两层：\n短期记忆放在context Windows里，存当前任务的中间状态\n长期记忆用向量数据库实现，能跨任务保存用户偏好和历史，两者机制和用途完全不同"}]},{"ID":"20260907064814-byfovwk","Type":"NodeParagraph","Properties":{"id":"20260907064814-byfovwk","updated":"20260907065727"},"Children":[{"Type":"NodeText","Data":"模型本身不执行工具，它只是输出的决策，真正执行是你的代码，[决策和执行分离]"}]},{"ID":"20260907075408-o55h3bl","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907075408-o55h3bl","updated":"20260907081227"},"Children":[{"Type":"NodeText","Data":"Workflow，Agent，Tools 这三个的概念和区别介绍一下？"}]},{"ID":"20260907075410-kxvv4q1","Type":"NodeParagraph","Properties":{"id":"20260907075410-kxvv4q1","updated":"20260907075756"},"Children":[{"Type":"NodeText","Data":"Tools是最小的能力单元，就是封装好的可调用函数，比如搜索、执行代码、发邮件，它只负责执行，本身没有任何决策能力\nAgent是一个完整的决策系统，内部用LLM做大脑，自己判断什么时候调哪个Tool、要不要继续、什么时候结束，是主动的\nWorkflow是更上层的编排框架，把Agent、LLM、Tools组织成一条确定性流程，每个节点做什么、按什么顺序流转都是开发者事先写死的"}]},{"ID":"20260907081227-ui0n35r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907081227-ui0n35r","updated":"20260907102605"},"Children":[{"Type":"NodeText","Data":"什么是Multi-Agent"}]},{"ID":"20260907081236-5ugmy0g","Type":"NodeParagraph","Properties":{"id":"20260907081236-5ugmy0g","updated":"20260907081531"},"Children":[{"Type":"NodeText","Data":"多智能体系统就是多个Agent协作完成任务，每个Agent各有分工，有的负责搜索、有的负责写代码、有的负责做评审\n我理解的单个Agent主要受两个限制：\n一是context窗口大小，复杂任务信息量一多就撑爆了；\n二是单点能力，什么都让一个Agent做，每件事都是泛才。"}]},{"ID":"20260907102219-mjv6vfx","Type":"NodeParagraph","Properties":{"id":"20260907102219-mjv6vfx","updated":"20260907102336"},"Children":[{"Type":"NodeText","Data":"Multi-Agent通过专业分工和并行执行，能处理更复杂、更长流程的任务\n多Agent协作模式：顺序流水线、并行扇出、辩论评审"}]},{"ID":"20260907102605-nl8jb7e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907102605-nl8jb7e","updated":"20260907104117"},"Children":[{"Type":"NodeText","Data":"Agent记忆压缩通常有哪些方法"}]},{"ID":"20260907102623-n9cwxrb","Type":"NodeParagraph","Properties":{"id":"20260907102623-n9cwxrb","updated":"20260907103158"},"Children":[{"Type":"NodeText","Data":"记忆压缩常见有四种方法：\n摘要压缩、滑动窗口、重要性过滤、结构化抽取\n摘要压缩是把长对话总结成简短摘要；滑动窗口只是保留最近N轮对话\n重要性过滤是打分筛选，只留重要内容；结构化抽取是把关键信息抽成结构化数据存起来"}]},{"ID":"20260907104117-5ksbh3g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907104117-5ksbh3g","updated":"20260907105815"},"Children":[{"Type":"NodeText","Data":"LangChain的底层架构与实现原理是什么"}]},{"ID":"20260907104744-fr6w23u","Type":"NodeParagraph","Properties":{"id":"20260907104744-fr6w23u","updated":"20260907104744"},"Children":[{"Type":"NodeText","Data":"LangChain 是一套开源大模型应用开发库 (Python/JS)，本身不是大模型。它提供大量现成组件，帮你快速把 LLM、文档、向量库、工具组装成 AI 应用，不用从零手写全部胶水代码。"}]},{"ID":"20260907104133-yo0t02i","Type":"NodeParagraph","Properties":{"id":"20260907104133-yo0t02i","updated":"20260907104855"},"Children":[{"Type":"NodeText","Data":"当前LangChain v1 更像一套面向Agent的分层开发框架，而不是将Prompt串起来的Chain工具。\n底层的langchain-coredin定义Message、Model、Tool和Runnable等标准协议\n不同厂商的独立集成包负责把自己的请求与响应适配到这些协议，\n因此应用层可以使用相对统一的方式切换模型和工具"}]},{"ID":"20260907104858-htmf1xz","Type":"NodeParagraph","Properties":{"id":"20260907104858-htmf1xz","updated":"20260907105131"},"Children":[{"Type":"NodeText","Data":"在执行层，Runnable（“一个可以被执行的单元”）统一了组件的同步、异步、批处理和流式调用方式\n对于步骤固定的流程，可以使用LCEL组合Prompt、Model和Parser；\n对于需要模型自主选择工具的任务，则使用create_agent创建Agent。"}]},{"ID":"20260907105135-ga8pgri","Type":"NodeParagraph","Properties":{"id":"20260907105135-ga8pgri","updated":"20260907105434"},"Children":[{"Type":"NodeText","Data":"create_agent会把模型节点和工具节点编译成LangGraph状态图\n模型读取消息后生成AIMessage；如果其中包含tool_calls,运行时执行对应工具，并把结果包装成带相同调用ID的ToolMessage写回状态；模型再次读取工具结果并继续判断，直到生成最终回答。"}]},{"ID":"20260907105434-yx6amri","Type":"NodeParagraph","Properties":{"id":"20260907105434-yx6amri","updated":"20260907105434"},"Children":[{"Type":"NodeText","Data":"在这套架构中，State 保存会变化的消息与业务状态，Runtime 提供可信上下文和长期 Store，Middleware负\n责在模型或工具调用前后加入权限、重试、摘要与人工审批，LangGraph则负责路由、检查点、暂停恢复和长\n时间运行。\nLangChain 用标准协议统一组件，用create_agent 提供高层 Agent 入口，再由 LangGraph 承担有状态的\n执行运行时。"}]},{"ID":"20260907105815-qcja6kf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260907105815-qcja6kf","updated":"20260907110802"},"Children":[{"Type":"NodeText","Data":"RAG与LLM WiKi机制+对比"}]},{"ID":"20260907105833-oqs69ar","Type":"NodeParagraph","Properties":{"id":"20260907105833-oqs69ar","updated":"20260907110143"},"Children":[{"Type":"NodeText","Data":"RAG=检索 增强 生成"}]},{"ID":"20260907110141-zglypna","Type":"NodeParagraph","Properties":{"id":"20260907110141-zglypna","updated":"20260907110420"},"Children":[{"Type":"NodeText","Data":"传统 RAG 属于"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"查询时检索"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"的模式，文档入库只做切分、向量化保存原始碎片\n用户提问的时候，现场去"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"向量库召回相关文本块，把碎片塞给大模型生成回答"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，对话结束知识"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"不会沉淀"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，每次提问都要"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"重新检索拼接"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n优势是接入简单，适合大规模文档、原始原文检索\n缺点是容易出现碎片割裂，召回质量高度依赖切分和向量效果，跨文档综合推理比较弱"}]},{"ID":"20260907110141-sxcby9s","Type":"NodeParagraph","Properties":{"id":"20260907110141-sxcby9s","updated":"20260907110802"},"Children":[{"Type":"NodeText","Data":"LLM‑Wiki 是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"预编译式的知识库范式"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n文档"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"录入阶段"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"就交给"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"大模型深度理解"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，提炼生成"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"互相链接的 Markdown 维基页面"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n（原始素材层、维基展现层、模式约定层）\n还会处理观点冲突、维护实体关联，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"原始资料只做只读基准"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"。\n后续用户提问，直接读取已经整理好的 Wiki 成品页面，"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"不用再从原始文档切片检索"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"\n知识可以持续迭代沉淀下来GitHub"}]},{"ID":"20260907110141-vymxlfo","Type":"NodeParagraph","Properties":{"id":"20260907110141-vymxlfo","updated":"20260907110556"},"Children":[{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"text","TextMarkTextContent":"二者最本质区别就是知识处理时机"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"。\nRAG 是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"查询时干活"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，输入输出用完就丢\nLLM‑Wiki 是"},{"Type":"NodeTextMark","Properties":{"style":"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));"},"TextMarkType":"strong text","TextMarkTextContent":"摄入时干活"},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"background-color: var(--b3-inline-builtin-warning-background-color, var(--b3-card-warning-background)); color: var(--b3-inline-builtin-warning-color, var(--b3-card-warning-color));\"}"},{"Type":"NodeText","Data":"，提前把知识加工完成\nRAG 适合海量业务文档、需要引用原文的场景\nLLM‑Wiki 更适合知识需要持续积累、做多概念综合推理的场景\n工程上两者也可以组合，RAG 负责召回原始素材，输出给 LLM‑Wiki 做知识库更新"}]},{"ID":"20260505170804-x76nksf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260505170804-x76nksf","updated":"20260907102149"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"关于 AI 的使用"}]},{"ID":"20260505170804-zc9d4nj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-zc9d4nj","updated":"20260907102149"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"认知框架"}]},{"ID":"20260505170804-ht1ed9a","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20260505170804-ht1ed9a","updated":"20260907102149"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"概念"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"角色定位  "}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"核心价值"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"LLM"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"大脑"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"思考与生成回答"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"RAG"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"知识库"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"提供精准参考资料，避免幻觉"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Skills"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"技能包"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"查数据库、发邮件等具体能力"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"MCP"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"工作流程手册"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"规范技能调用顺序与异常处理"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Agent"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"智能执行者"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"统筹组件完成复杂任务"}]}]}]},{"ID":"20260505170804-0agane5","Type":"NodeParagraph","Properties":{"id":"20260505170804-0agane5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"以 cursor 为例"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"LLM（大脑）就是 Cursor 背后的大模型，负责理解需求、写代码、改 Bug、解释逻辑，是所有智能的核心"}]},{"ID":"20260505170804-gmoetp1","Type":"NodeParagraph","Properties":{"id":"20260505170804-gmoetp1","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"RAG（知识库）对应 Cursor 最核心的功能：@Workspace 读取项目代码、读取文档、读取你上传的文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不会思考，只负责把项目里相关代码、配置、文档找出来给模型，让 AI 不瞎编、懂你的项目结构"}]},{"ID":"20260505170804-0q5hl5g","Type":"NodeParagraph","Properties":{"id":"20260505170804-0q5hl5g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Skills（技能包）就是 Cursor 能直接执行的动作：生成代码、重构代码、运行命令、终端操作、生成注释、修复报错、生成 Git 信息等"}]},{"ID":"20260505170804-wxkm9iy","Type":"NodeParagraph","Properties":{"id":"20260505170804-wxkm9iy","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MCP（工作流程手册）对应 Cursor 内部的执行规则：比如先读项目 → 再理解需求 → 生成代码 → 检查报错 → 给出优化建议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遇到异常时自动重试、补充上下文，保证流程不乱"}]},{"ID":"20260505170804-x9z6vny","Type":"NodeParagraph","Properties":{"id":"20260505170804-x9z6vny","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent（智能执行者）就是 Cursor 本身。它接收用户的指令，自动调用模型思考、读取项目代码、调用写代码 / 修复技能，按流程一步步把任务做完，用户只需要说需求，它全程统筹执行"}]},{"ID":"20260907064633-4x020zq","Type":"NodeParagraph","Properties":{"id":"20260907064633-4x020zq","updated":"20260907065724"}},{"ID":"20260505170804-k6h7sbk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-k6h7sbk","updated":"20260907064856"},"Children":[{"Type":"NodeText","Data":"Skills 了解吗？你的项目用到了吗？"}]},{"ID":"20260505170804-rcgwad4","Type":"NodeParagraph","Properties":{"id":"20260505170804-rcgwad4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Skills 就是把 AI 的能力做成现成的工具包，就像写代码封装好的函数一样,想用直接调用就行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以前用 AI，每次都要写一大串提示词，告诉它怎么审代码、怎么写接口、要注意什么，又麻烦又不稳定，还没法复用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用 Skills 就省事多了，我提前把规则、标准都定好，做成一个个固定能力"}]},{"ID":"20260505170804-exa6d3p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-exa6d3p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 Skill、Rule"}]},{"ID":"20260505170804-6pgvfz7","Type":"NodeParagraph","Properties":{"id":"20260505170804-6pgvfz7","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Skill（技能）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Skill 是大模型主动调用的能力工具，是模型可以执行的具体功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如联网搜索、写代码、调用接口、数据分析、插件工具都属于 Skill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它是模型自主判断、按需触发的能力，用来扩展模型本身没有的知识和功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Rule（规则）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Rule 是给模型设定的硬性约束、行为规范，是必须遵守的指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如回答格式、禁止内容、语气要求、输出长度、逻辑步骤都属于 Rule"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它不需要模型思考选择，是强制执行的底线和要求，用来规范模型行为"}]},{"ID":"20260505170804-iujklky","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-iujklky","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP、RAG、Agent 协同"}]},{"ID":"20260505170804-ax2qdjk","Type":"NodeParagraph","Properties":{"id":"20260505170804-ax2qdjk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"单独看 MCP、RAG、Agent 各有侧重，但在实际应用中，它们是层层支撑、协同互补的 “黄金三角”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"形成了 “基础连接 → 知识增强 → 智能执行” 的完整链路"}]},{"ID":"20260505170804-d8ssu0j","Type":"NodeParagraph","Properties":{"id":"20260505170804-d8ssu0j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"底层：MCP（工作流程手册） 是 “基础设施”，负责连接外部工具和分配模型资源，是 RAG 和 Agent 稳定运行的前提"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中层：RAG （知识库）是 “知识增强层”，为 Agent 提供精准、实时的知识支撑，让决策有依据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上层：Agent （智能执行者）是 “决策执行中枢”，统筹全局，根据需求调用 RAG 查知识、通过 MCP 用工具，最终完成复杂任务"}]},{"ID":"20260505170804-2zhg457","Type":"NodeParagraph","Properties":{"id":"20260505170804-2zhg457","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MCP 主要解决的是连接问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"以前 AI 很难顺畅地对接各种系统、工具和数据，现在通过 MCP 可以更稳定、更灵活地打通外部资源，让 AI 能用得上各种工具和服务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RAG 解决的是准确性问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大模型本身容易出现幻觉、回答不准，RAG 相当于给 AI 配上了专属知识库，让它先查资料再回答，保证内容真实可靠，不会乱编"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agent 则解决了自主执行的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它让 AI 不再只是对话，而是能自己思考、做规划、调用工具、一步步完成复杂任务，真正具备主动执行能力"}]},{"ID":"20260505170804-88dtaia","Type":"NodeParagraph","Properties":{"id":"20260505170804-88dtaia","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"MCP 让 AI 连得上，RAG 让 AI 答得准，Agent 让 AI 干得动"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"三者结合，AI 就从被动应答，变成了能主动服务的智能体"}]},{"ID":"20260505170804-neb4s49","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-neb4s49","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"LLM 和 agent"}]},{"ID":"20260505170804-v2drba4","Type":"NodeParagraph","Properties":{"id":"20260505170804-v2drba4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LLM 就是大语言模型本身，比如常见的聊天 AI"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它主要负责理解语言、生成回答，你问它才答，更像一个只会思考和说话的大脑，但不会自己主动去做事情、调用工具"}]},{"ID":"20260505170804-q12x2da","Type":"NodeParagraph","Properties":{"id":"20260505170804-q12x2da","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 是在 LLM 基础上做的智能体，相当于给大脑加上了规划能力和手脚"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它能自己定目标、拆步骤、查资料、用工具，一步步把任务做完，是能主动思考、主动执行的完整助手，而不只是被动对话"}]},{"ID":"20260505170804-kthak4n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-kthak4n","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Agent 和 workflow 有什么区别"}]},{"ID":"20260505170804-aulf3gu","Type":"NodeParagraph","Properties":{"id":"20260505170804-aulf3gu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Workflow 是指 LLM 和工具通过预定义的代码路径进行编排的系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 Agent 是指 LLM 动态主导自身流程与工具调用的系统，由 LLM 自主决定如何完成任务"}]},{"ID":"20260505170804-yamwg7b","Type":"NodeParagraph","Properties":{"id":"20260505170804-yamwg7b","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"如果任务步骤是固定的、可以提前规划好的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"或者对可靠性要求很高（比如金融交易、医疗系统），那就用 Workflow"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果任务是开放式的、无法预知所有步骤，或者需要灵活应对各种意外情况，那就用 Agent"}]},{"ID":"20260505170804-7sx4guc","Type":"NodeParagraph","Properties":{"id":"20260505170804-7sx4guc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不过在实际生产环境中，最常见的其实是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"混合架构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Workflow 和 Agent 的结合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"正如 LangChain 说的：\"大多数生产中的 Agent 系统其实是 Workflow 和 Agent 的组合\""}]},{"ID":"20260505170804-r4jcp5c","Type":"NodeParagraph","Properties":{"id":"20260505170804-r4jcp5c","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"比如一个智能客服系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整体流程用 Workflow 控制（接收工单 → 分类 → 处理 → 回复）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但在\"处理\"环节遇到复杂问题时，会启动一个 Agent 来自主分析和解决"}]},{"ID":"20260505170804-c4hdq1g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c4hdq1g","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"workflow 的基本组成"}]},{"ID":"20260505170804-9cd67k0","Type":"NodeParagraph","Properties":{"id":"20260505170804-9cd67k0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"由"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"开始节点、任务节点、路由网关、流转连线、结束节点"},{"Type":"NodeText","Data":"这五大核心部分构成"}]},{"ID":"20260505170804-6rrx0vn","Type":"NodeParagraph","Properties":{"id":"20260505170804-6rrx0vn","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"开始节点是整个工作流的触发入口，用来启动流程"}]},{"ID":"20260505170804-e03gj8v","Type":"NodeParagraph","Properties":{"id":"20260505170804-e03gj8v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"任务节点是流程里实际要执行的环节"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"既可以是人工审批、人员处理，也能是系统自动执行、接口调用这类自动化任务"}]},{"ID":"20260505170804-poldp54","Type":"NodeParagraph","Properties":{"id":"20260505170804-poldp54","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"路由网关和流转连线负责控制流程走向"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网关主要做条件分支、并行或排他判断，根据业务条件走不同流程分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"连线则用来串联各个节点，实现步骤间的传递"}]},{"ID":"20260505170804-o5ed4mm","Type":"NodeParagraph","Properties":{"id":"20260505170804-o5ed4mm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后是结束节点，标志整个流程终止归档"}]},{"ID":"20260505170804-e1jfbv7","Type":"NodeParagraph","Properties":{"id":"20260505170804-e1jfbv7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"除此之外，完整工作流还会配套参与者角色、流程变量、超时规则、回退抄送这些辅助配置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"保障业务流程完整落地"}]},{"ID":"20260505170804-vccm4en","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-vccm4en","updated":"20260510154701"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Agent 定义、Agent 工作模式"}]},{"ID":"20260505170804-gmfp0zp","Type":"NodeParagraph","Properties":{"id":"20260505170804-gmfp0zp","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ReAct（边想边做）"}]},{"ID":"20260505170804-t8kd7iz","Type":"NodeParagraph","Properties":{"id":"20260505170804-t8kd7iz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"ReAct 是目前最经典、最基础的 Agent 工作模式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"推理 + 行动，几乎所有主流的 Agent 框架底层都在用它"}]},{"ID":"20260505170804-c8suxhv","Type":"NodeParagraph","Properties":{"id":"20260505170804-c8suxhv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 在思考和行动之间不断交替"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"具体来说就是一个三步循环："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"思考"},{"Type":"NodeText","Data":"，分析当前情况决定下一步做什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"行动"},{"Type":"NodeText","Data":"，调用一个工具来执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"观察"},{"Type":"NodeText","Data":"，查看工具返回的结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后回到思考，如此循环，直到任务完成"}]},{"ID":"20260505170804-m3vwgs6","Type":"NodeParagraph","Properties":{"id":"20260505170804-m3vwgs6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"透明可审计（每一步思考过程都看得见）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"灵活适应（遇到意外能随时调整）、通用性强"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"token 消耗大，因为每一步都要完整推理一次"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有时会陷入循环，反复执行相同动作走不出来"}]},{"ID":"20260505170804-od83pcd","Type":"NodeParagraph","Properties":{"id":"20260505170804-od83pcd","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Plan-and-Execute（先想好再做）"}]},{"ID":"20260505170804-lbc8w7o","Type":"NodeParagraph","Properties":{"id":"20260505170804-lbc8w7o","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它把 Agent 的工作分成两个阶段："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一阶段是规划，Agent 先把完整的执行计划想清楚"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二阶段是执行，按计划逐步完成，不用每步都重新思考全局"}]},{"ID":"20260505170804-0vljgxh","Type":"NodeParagraph","Properties":{"id":"20260505170804-0vljgxh","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"省钱，规划只做一次，执行阶段不用反复推理，token 消耗大约是 ReAct 的五分之一"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"缺点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是不够灵活，如果执行到第 3 步发现情况变了，原来的计划可能就不适用了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以也有这么个做法是在执行过程中加入"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重新规划检查点"},{"Type":"NodeText","Data":"，每隔几步检查一下计划是否还靠谱"}]},{"ID":"20260505170804-kg5fcuv","Type":"NodeParagraph","Properties":{"id":"20260505170804-kg5fcuv","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Reflection（做完再检查）"}]},{"ID":"20260505170804-emnnozo","Type":"NodeParagraph","Properties":{"id":"20260505170804-emnnozo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"反思模式的核心思想是 Agent 完成任务后不急着交付"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是先自我检查一遍"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就像你写完文章不会直接发出去，而是再通读一遍、改一改、润色一下"}]},{"ID":"20260505170804-m4fll0t","Type":"NodeParagraph","Properties":{"id":"20260505170804-m4fll0t","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"实现方式通常有两种"}]},{"ID":"20260505170804-rqheeda","Type":"NodeParagraph","Properties":{"id":"20260505170804-rqheeda","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自我反思"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同一个 Agent 完成任务后切换到审查者角色来审视自己的输出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"发现问题就修改，然后再审查，直到满意"}]},{"ID":"20260505170804-fq6qnvo","Type":"NodeParagraph","Properties":{"id":"20260505170804-fq6qnvo","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"另一种是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"双 Agent 对话"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个 Agent 负责生成，另一个负责评审，两者来回迭代直到评审方满意"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就像代码的 Code Review 过程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种模式特别适合对质量要求高的场景，比如代码生成、法律文书、学术论文等"}]},{"ID":"20260505170804-ywqgkas","Type":"NodeParagraph","Properties":{"id":"20260505170804-ywqgkas","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Multi-Agent（团队协作）"}]},{"ID":"20260505170804-vbro376","Type":"NodeParagraph","Properties":{"id":"20260505170804-vbro376","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"当任务太复杂、一个 Agent 搞不定的时候怎么办时，派一个团队上"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Multi-Agent 模式让多个专业化的 Agent 各司其职"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个负责规划、一个负责搜集信息、一个负责写代码、一个负责测试，通过协作来完成复杂任务"}]},{"ID":"20260505170804-93i4fnu","Type":"NodeParagraph","Properties":{"id":"20260505170804-93i4fnu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不要过早引入多 Agent 架构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多时候，一个强大的单 Agent 就够用了"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有任务确实需要拆分成多个并行子任务时，多 Agent 才值得引入"}]},{"ID":"20260505170804-siqxa8p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-siqxa8p","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"用过什么 AI 编程 IDE 吗？什么感觉？"}]},{"ID":"20260505170804-ct12xmw","Type":"NodeParagraph","Properties":{"id":"20260505170804-ct12xmw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我用过 cursor 和 trae，其中我日常开发中主要用的是 cursor"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给我整体的感觉是，AI 编程能力的进步太快了，已经不是几年前简单的代码补全工具，而是一个可以深度协作的工程助手"}]},{"ID":"20260505170804-z6yvyr3","Type":"NodeParagraph","Properties":{"id":"20260505170804-z6yvyr3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在开发过程中，我不会让 AI 直接开始写代码，而是让 cursor 分析整个代码库生成一份包含核心架构、模块职责和数据流的文档；只有当我和 AI 对项目有一致理解时后续产出才会稳定、高质量"}]},{"ID":"20260505170804-e1ghyux","Type":"NodeParagraph","Properties":{"id":"20260505170804-e1ghyux","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对于每个独立的开发任务，我都会开启一个新的对话，并提供必要的上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"包括需求背景、涉及模块和约束条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这种方式能显著减少上下文污染，让 AI 生成的代码更加精准，基本不需要大幅返工"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"我也会定期删除冗余实现和废弃代码，旧代码会误导 AI 的判断，增加上下文噪音，长期不清理会直接影响协作效率"}]},{"ID":"20260505170804-c22ud30","Type":"NodeParagraph","Properties":{"id":"20260505170804-c22ud30","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"需求背景：告诉 AI 这个功能要解决什么业务问题、给谁用、为什么要做，让它懂业务逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"涉及模块：明确要改哪些文件、调用哪些现有代码、不动哪些内容，限定范围避免乱改"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"约束条件：规定技术栈、代码规范、性能、安全、业务规则等硬性要求，保证代码符合项目标准"}]},{"ID":"20260505170804-c7ug0vw","Type":"NodeParagraph","Properties":{"id":"20260505170804-c7ug0vw","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"AI 是一个强大的知识库和辅助工具，可以帮我们快速实现功能、学习新知识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但如果完全依赖 AI 写代码而不理解其原理，个人技术能力可能会退化"}]},{"ID":"20260505170804-94gsvui","Type":"NodeParagraph","Properties":{"id":"20260505170804-94gsvui","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"因此我会坚持几个原则："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 生成代码之后必须人工 Review"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"关键逻辑必要时自己重写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心路径必须做压测和边界测试"}]},{"ID":"20260505170804-f7ydkof","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-f7ydkof","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"知道哪些 Cursor 使用技巧？"}]},{"ID":"20260505170804-3ixwpwc","Type":"NodeParagraph","Properties":{"id":"20260505170804-3ixwpwc","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先理架构再动手"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无论是自己写代码还是让 AI 生成代码，都必须先明确需求、整体架构和模块边界"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果在架构模糊的情况下直接编码，很容易出现重复实现或职责冲突，后期修改成本反而更高"}]},{"ID":"20260505170804-a73qg1e","Type":"NodeParagraph","Properties":{"id":"20260505170804-a73qg1e","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"单 Chat 专注单功能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"新功能或大改动开启新的 Chat"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并在开头引入项目结构说明或关键文档作为上下文基础，这样可以避免历史对话干扰，提高输出质量"}]},{"ID":"20260505170804-8wa89xm","Type":"NodeParagraph","Properties":{"id":"20260505170804-8wa89xm","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"功能落地后写指南"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 AI 总结实现过程，抽象出通用步骤，形成操作指南"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"（比如新增接口的标准流程、文件导出的统一实现方式等。这些沉淀下来的内容，可以在后续类似需求中快速复用）"}]},{"ID":"20260505170804-012bl89","Type":"NodeParagraph","Properties":{"id":"20260505170804-012bl89","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不依赖 AI，主动复盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 仅作辅助，代码生成后需认真 Review，理解原理、优化不合理处，避免技术停滞"}]},{"ID":"20260505170804-6el3pd4","Type":"NodeParagraph","Properties":{"id":"20260505170804-6el3pd4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"定期删无用代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"清理冗余代码，减少对 AI 的误导和上下文干扰，提升开发效率"}]},{"ID":"20260505170804-setv23c","Type":"NodeParagraph","Properties":{"id":"20260505170804-setv23c","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用好配置文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":".cursorrules 定义 AI 生成代码的规则、风格和常用片段"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":".cursorignore 指定不允许 AI 修改的文件 / 目录，保护核心代码"}]},{"ID":"20260505170804-v2tzmzu","Type":"NodeParagraph","Properties":{"id":"20260505170804-v2tzmzu","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"持续维护文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"项目重大变更后，让 AI 同步更新文档、记录 “踩坑” 经验，积累团队知识库"}]},{"ID":"20260505170804-rieiify","Type":"NodeParagraph","Properties":{"id":"20260505170804-rieiify","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"让 AI 先 “学” 项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"大型项目先让 Cursor 分析代码库，生成含架构、目录职责、核心类等的结构文档，作为后续开发的基础上下文"}]},{"ID":"20260505170804-y9l1v0w","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-y9l1v0w","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"提示词工程 Prompt"}]},{"ID":"20260505170804-fefpjds","Type":"NodeParagraph","Properties":{"id":"20260505170804-fefpjds","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"提示词工程是一种专门对语言模型进行优化的方法"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它的目标是通过设计和调整输入的提示词来引导这些模型生成更准确、更有针对性的输出文本"}]},{"ID":"20260505170804-ksd4sa3","Type":"NodeParagraph","Properties":{"id":"20260505170804-ksd4sa3","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在与大型预训练语言模型交互时，给定的提示词会极大地影响模型的响应内容和质量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提示词工程关注如何创建最有效的提示词，以便让模型能够理解和满足用户的需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这可能涉及到对不同场景的理解，使用正确的词汇和语法结构，以及尝试不同的提示策略以观察哪种效果最佳"}]},{"ID":"20260505170804-r4l01y9","Type":"NodeParagraph","Properties":{"id":"20260505170804-r4l01y9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"提示词设计全流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"初始提示词–模型输出–分析偏差–优化提示词–再次测试–固化模板"}]},{"ID":"20260505170804-6c8fs93","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-6c8fs93","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"编写提示词的基本原则"}]},{"ID":"20260505170804-ic5npza","Type":"NodeParagraph","Properties":{"id":"20260505170804-ic5npza","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编写清晰、具体的指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过提供尽可能清晰和具体的指令来表达自己希望模型执行的操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这将引导模型给出正确的输出，并减少得到无关或不正确响应的可能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编写清晰的指令不意味着简短的指令，在许多情况下，更长的提示实际上更清晰且提供了更多上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这实际上可能导致更详细更相关的输出"}]},{"ID":"20260505170804-5cqsu29","Type":"NodeParagraph","Properties":{"id":"20260505170804-5cqsu29","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为指令添加一些详细的背景信息，输出的结果会更加符合我们的预期"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.使用分隔符清晰地表示输入的不同部分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.要求一个结构化输出，可以是 Json、HTML 等格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.要求模型检查是否满足条件，如果任务做出的假设不一定满足可以告诉模型先检查这些假设，若不满足提示并停止"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.在要求模型执行实际任务之前提供少量成功示例"}]},{"ID":"20260505170804-m5kdxy6","Type":"NodeParagraph","Properties":{"id":"20260505170804-m5kdxy6","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"给模型时间去思考"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.指定完成任务所需的步骤"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.指导模型在下结论前找出一个自己的解法；\t先让模型独立解决问题 ，再与输入答案对比 ，最后判断是否正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.模型偶尔会生成一些看似真实实则编造的知识。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为了减少这种幻觉：先要求模型找到文本中的任何相关引用，然后要求它使用这些引用来回答问题，追溯文档"}]},{"ID":"20260505170804-spiggam","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-spiggam","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"基础 Prompt 结构"}]},{"ID":"20260505170804-7uk8oe7","Type":"NodeParagraph","Properties":{"id":"20260505170804-7uk8oe7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"公式：指令 + 输入数据 + 背景 + 输出要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指令词是必须的，用来明确让模型做什么，比如解释、总结、翻译"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输入数据同样必不可少，是模型要处理的具体内容，要清晰完整"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"背景和输出要求是非必需的，背景能补充任务相关信息，让模型更精准理解需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输出要求则可以限定格式、字数、结构等，让结果更符合预期"}]},{"ID":"20260505170804-bk87ysy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bk87ysy","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Prompt 技巧"}]},{"ID":"20260505170804-z899hm8","Type":"NodeParagraph","Properties":{"id":"20260505170804-z899hm8","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设定大模型角色"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"给模型明确身份与专业背景，让回答更专业贴合需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"普通写法：直接提需求，模型易理解模糊"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优化写法：先定义角色（如资深健身教练、行业专家），补充自身情况、目标与约束，让模型后续对话无需重复确认信息"}]},{"ID":"20260505170804-vst1g6s","Type":"NodeParagraph","Properties":{"id":"20260505170804-vst1g6s","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"为自己设定角色"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"明确自身身份与知识水平，模型会匹配对应难度和语气解答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"示例：以小学生 / 大学生 / 研究生身份提问，同一问题会得到不同深度的解释"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"进阶：同时设定模型角色 + 自身角色，让对话场景更精准"}]},{"ID":"20260505170804-x17qh8q","Type":"NodeParagraph","Properties":{"id":"20260505170804-x17qh8q","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"明确问题并提供背景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提问时讲清场景、任务和具体信息，避免模型泛泛而答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"清晰说明自身职业、任务目标"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遇到具体问题（如代码报错），直接附上报错信息，方便模型定位解决"}]},{"ID":"20260505170804-8hyw0e5","Type":"NodeParagraph","Properties":{"id":"20260505170804-8hyw0e5","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"限制回复长度与精确度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接限定字数、格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长文本处理：分段发送，让模型只回复 “OK”，全部发完再统一处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"内容不足时，让模型继续补充输出"}]},{"ID":"20260505170804-jfeqzxa","Type":"NodeParagraph","Properties":{"id":"20260505170804-jfeqzxa","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"明确要求和目的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提问时细化方向，指定重点内容与延伸要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不熟悉领域可让模型引导提问，逐步明确需求，再生成答案"}]},{"ID":"20260505170804-avljnv4","Type":"NodeParagraph","Properties":{"id":"20260505170804-avljnv4","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统化设计自己的指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为常用职业 / 身份定制固定指令模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让模型了解你的信息：职业、项目、兴趣、目标、工具、背景等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让模型按要求回复：格式、语气、细节程度、建议类型、语言偏好等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"可套用模板为新媒体创作者、开发者等角色定制专属指令"}]},{"ID":"20260505170804-eesqpkd","Type":"NodeThematicBreak","Properties":{"id":"20260505170804-eesqpkd","updated":"20260505170804"}},{"ID":"20260505170804-uy10lrf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-uy10lrf","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你平时用什么大模型编程"}]},{"ID":"20260505170804-jef7g1s","Type":"NodeParagraph","Properties":{"id":"20260505170804-jef7g1s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先用 O3 撰写需求与设计文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"在 GitHub 上创建 Issues"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再借助 Claude 或 Gemini Pro 完成代码开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"之后由 O3 进行 Code Review"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修改完毕后关闭 Issues 并合并 PR"}]},{"ID":"20260505170804-1pqwxa9","Type":"NodeParagraph","Properties":{"id":"20260505170804-1pqwxa9","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"superpowers"},{"Type":"NodeText","Data":"\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一个完整的 AI 软件开发工作矿建"}]},{"ID":"20260505170804-fo3uzls","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-fo3uzls","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"知道 Agent 和 WorkFlow 吗"}]},{"ID":"20260505170804-5rypubh","Type":"NodeParagraph","Properties":{"id":"20260505170804-5rypubh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 是具备自主思考、规划和工具调用能力的智能体"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能根据目标自主拆解任务、动态决策，适合复杂、不确定的场景"}]},{"ID":"20260505170804-1i4no46","Type":"NodeParagraph","Properties":{"id":"20260505170804-1i4no46","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Workflow 是固定编排的工作流，按预设步骤顺序执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"流程可控、稳定，适合标准化、重复性任务"}]},{"ID":"20260505170804-qhf37t2","Type":"NodeParagraph","Properties":{"id":"20260505170804-qhf37t2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单来说，Agent 更灵活智能，Workflow 更稳定可靠，实际中常结合使用"}]},{"ID":"20260505170804-h17t6jr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-h17t6jr","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"AI 幻觉现象，怎么佐证？"}]},{"ID":"20260505170804-mwgge87","Type":"NodeParagraph","Properties":{"id":"20260505170804-mwgge87","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AI 幻觉"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"模型在无事实支撑时，自信生成错误且自洽的陈述"}]},{"ID":"20260505170804-i8k1ddm","Type":"NodeParagraph","Properties":{"id":"20260505170804-i8k1ddm","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"可通过典型案例、定量评测、机理分析、可复现检测四重证据充分证明"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其根源在于概率生成范式与训练评估偏差，是当前大模型的固有挑战"}]},{"ID":"20260505170804-3jggd5x","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3jggd5x","updated":"20260529154600"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"superpowers 详情"}]},{"ID":"20260505170804-jy0k183","Type":"NodeParagraph","Properties":{"id":"20260505170804-jy0k183","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它是给 AI 定的一套工作规范"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 AI 不要上来就乱写，而是像个有经验的老师傅那样"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先帮你想清楚需求，然后再动手"}]},{"ID":"20260505170804-66c2euh","Type":"NodeParagraph","Properties":{"id":"20260505170804-66c2euh","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"superpower 是一个完整的 AI 软件开发工作流框架"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"为 Coding Agents 赋予工程化超能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计优先"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写代码前先理解要做什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"技能组合"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"20 + 可组合 Skills 系统化流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工程化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"TDD + 代码审查质量有保障"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心理念"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"测试驱动开发：始终先写测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单性为首要目标：降低复杂性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"系统化优于临时性：流程优于猜测"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"证据优于断言：验证后再宣布成功"}]},{"ID":"20260529154556-rngpex0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260529154556-rngpex0","updated":"20260529155019"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"superpowers 的主要工作流是什么"}]},{"ID":"20260529155019-c567mug","Type":"NodeParagraph","Properties":{"id":"20260529155019-c567mug","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"头脑风暴"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提问完善想法探索替代方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Git "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工作树"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"创建隔离分支验证测试基线"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编写计划"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分解小任务每任务 2-5 分钟"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"执行开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分批执行设置检查点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TDD 测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RED-GREENREFACTOR 循环"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代码审查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"规范符合性代码质量审查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"完成分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"验证测试合并 / PR 决策"}]},{"ID":"20260529155019-vva4u5v","Type":"NodeParagraph","Properties":{"id":"20260529155019-vva4u5v","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工作流程特点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"强制检查：任何任务开始前都会检查相关 Skills，确保流程合规"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"小步快跑：每个任务 2-5 分钟，包含精确的文件路径、完整代码和验证步骤"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"人工检查点：计划执行过程中设置人工审核环节，关键问题阻止进度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"两阶段审查：规范符合性审查 + 代码质量审查，确保交付质量"}]},{"ID":"20260505170804-7h00px2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7h00px2","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"知道除了 vibe coding（氛围编程）的 ai 编程吗"}]},{"ID":"20260505170804-ldnke4a","Type":"NodeParagraph","Properties":{"id":"20260505170804-ldnke4a","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Vibe Coding（氛围编程）：不纠结细节，先快速跑出效果、边看边改，重直觉和节奏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agentic Coding（智能体编程）：自己规划、自己调试、自己跑完整个开发流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Spec-Driven（规范驱动）：先定好需求和规则，AI 严格按规范生成代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RAG 编程：先理解你现有项目代码，再往里写新逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"多 AI 协作：多个 AI 分工合作，有的架构、有的编码、有的测试"}]},{"ID":"20260505170804-c41r0hi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-c41r0hi","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"大模型怎么知道需要加载什么 skill"}]},{"ID":"20260505170804-doj6yyv","Type":"NodeParagraph","Properties":{"id":"20260505170804-doj6yyv","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模型在决策时，主要靠三步："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先，系统会把所有可用的 Skill 列表"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个技能的用途和参数格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过 Prompt 告诉大模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最终送给大模型的是："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"系统提示词 + 用户问题"},{"Type":"NodeText","Data":"，用户看不到也不用写这些技能描述"}]},{"ID":"20260505170804-hxkzg9p","Type":"NodeParagraph","Properties":{"id":"20260505170804-hxkzg9p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后，模型根据用户的需求和当前上下文，做意图理解 + 语义匹配，选出最合适的技能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后，模型按照固定的结构化格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"输出要调用的 Skill 名称和参数，框架再去真正执行这个技能"}]},{"ID":"20260505170804-7oeb6og","Type":"NodeParagraph","Properties":{"id":"20260505170804-7oeb6og","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"简单说：先给技能说明书，再让模型按需求匹配，最后按格式调用"}]},{"ID":"20260505170804-500ebmg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-500ebmg","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"大模型上下文怎么管理的"}]},{"ID":"20260505170804-ntevao2","Type":"NodeParagraph","Properties":{"id":"20260505170804-ntevao2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大模型本身是无状态的，不会自己记住对话历史"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以上下文管理主要靠外部来维护"}]},{"ID":"20260505170804-2ysmkhc","Type":"NodeParagraph","Properties":{"id":"20260505170804-2ysmkhc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"每次对话时，我们会把系统提示、历史对话和当前问题拼接成一段完整的提示词"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一起传给模型，这样它才能理解多轮对话的上下文"}]},{"ID":"20260505170804-fbn5hkx","Type":"NodeParagraph","Properties":{"id":"20260505170804-fbn5hkx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"但模型有固定的上下文窗口，token 数量有限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对话太长就会溢出，这时候就要做上下文压缩"}]},{"ID":"20260505170804-cngtxq7","Type":"NodeParagraph","Properties":{"id":"20260505170804-cngtxq7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常用方式有几种：最简单的是直接截断，丢掉最早的对话，只保留最近几轮"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也可以对旧的历史做摘要，把长对话提炼成简短总结，用摘要替代原文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还可以抽取关键信息，删掉冗余内容，只保留核心问题和结论"}]},{"ID":"20260505170804-hrkoukj","Type":"NodeParagraph","Properties":{"id":"20260505170804-hrkoukj","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"更进阶的会用向量库做检索，把历史存起来，需要时再召回相关内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"动态控制上下文长度，既不超窗口，又不丢失关键信息"}]},{"ID":"20260505170804-4527rbj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4527rbj","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么叫召回上下文"}]},{"ID":"20260505170804-6gte9h6","Type":"NodeParagraph","Properties":{"id":"20260505170804-6gte9h6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"召回上下文，是 RAG 检索增强生成中的核心概念"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指用户提问后，检索系统从私有知识库、文档、对话历史中"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"筛选匹配出来、注入提示词、供大模型生成回答的全部参考信息"}]},{"ID":"20260505170804-16wwa72","Type":"NodeParagraph","Properties":{"id":"20260505170804-16wwa72","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它核心衡量关键信息是否被完整召回，也就是有没有遗漏标准答案里的重要内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"召回上下文越完整，模型回答越全面，幻觉越少"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反之信息缺失，模型就容易编造、回答片面"}]},{"ID":"20260505170804-qma1ai2","Type":"NodeParagraph","Properties":{"id":"20260505170804-qma1ai2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它和上下文精确率要区分开："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"精确率看有没有无关冗余信息，召回上下文只看有没有漏信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时召回上下文也是整个 RAG 链路最关键的输入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接决定最终回答的准确性与可信度"}]},{"ID":"20260505170804-icc3vto","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-icc3vto","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"对接厂商大模型"}]},{"ID":"20260505170804-8l6y4co","Type":"NodeParagraph","Properties":{"id":"20260505170804-8l6y4co","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"对接厂商大模型，只需要提供："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"API 接口地址、密钥 Token、模型名称"}]},{"ID":"20260505170804-qgmxbu6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-qgmxbu6","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你觉得什么是智能体"}]},{"ID":"20260505170804-zsi6a3p","Type":"NodeParagraph","Properties":{"id":"20260505170804-zsi6a3p","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我理解的智能体 Agent"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是以大模型为核心大脑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"具备自主感知、规划思考、工具调用、执行行动和记忆反思能力的自主智能实体"}]},{"ID":"20260505170804-mpt4s7y","Type":"NodeParagraph","Properties":{"id":"20260505170804-mpt4s7y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和传统被动问答式大模型不同，智能体不再只是简单回复文本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是可以接收目标后主动拆解任务、分步推理决策、调用外部工具接口、与环境交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"并根据执行结果动态调整策略，最终自主完成完整复杂任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"形成感知 - 决策 - 行动 - 反馈的闭环"}]},{"ID":"20260505170804-t8cvbgp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-t8cvbgp","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你用过哪些 skills"}]},{"ID":"20260505170804-81rgue8","Type":"NodeParagraph","Properties":{"id":"20260505170804-81rgue8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我完整走过一整套 VibeCoding 端到端开发全流程："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先做需求头脑风暴，编写详细开发方案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后拆分任务，调度多子 Agent 并行开发，同时用 Git 多工作树做干净的分支隔离"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着按计划落地编码，用测试驱动 TDD 开发，配合系统化调试排错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"开发完成后主动发起代码评审，接收评审意见迭代优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"上线前做全量验证，最后完成开发分支合并收尾上线"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"全程熟练掌握这套 AI 驱动软件工程的完整技能链路"}]},{"ID":"20260505170804-jlpp27d","Type":"NodeParagraph","Properties":{"id":"20260505170804-jlpp27d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"brainstorming 需求头脑风暴"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"writing-plans 开发方案编写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"dispatching-parallel-agents 并行 Agent 调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"subagent-driven-development 子 Agent 驱动开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"using-git-worktrees Git 多工作树开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"executing-plans 方案落地执行编码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"writing-skills 专业提示词编写能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"using-superpowers AI 增强开发能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"test-driven-development 测试驱动开发（TDD）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"systematic-debugging 系统化调试排错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"requesting-code-review 发起代码评审"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"receiving-code-review 接收评审意见"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"verification-before-completion 交付上线前全量验证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"finishing-a-development-branch 开发分支收尾合并"}]},{"ID":"20260505170804-haajmir","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-haajmir","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Function Call"}]},{"ID":"20260505170804-uqos5te","Type":"NodeParagraph","Properties":{"id":"20260505170804-uqos5te","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 能查天气、能搜索信息、能操作数据库，这些能力是靠 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Function Call"},{"Type":"NodeText","Data":"（函数调用）来实现的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工作原理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"1.定义函数，开发者预先告知哪些工具可以用，用 JSON 格式描述每个函数的名字，功能说明和参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"2.模型判断，LLM 分析用户意图，自己判断调用那个函数\t"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"3.执行函数，LLM 自己不执行函数，它输出结构化指令，应用程序执行函数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"4.生成回答"}]},{"ID":"20260505170804-m0t2b3e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m0t2b3e","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么 Function Call 这么重要？"}]},{"ID":"20260505170804-iqnsz0o","Type":"NodeParagraph","Properties":{"id":"20260505170804-iqnsz0o","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Function Call 解决了两个核心问题"}]},{"ID":"20260505170804-4djp2j5","Type":"NodeParagraph","Properties":{"id":"20260505170804-4djp2j5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"一是意图判断，大模型自己识别要不要调用工具、调用哪个工具，不用我们写一堆 if else 判断"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"二是参数提取，能从用户口语里自动解析出结构化入参"}]},{"ID":"20260505170804-3o6n9qb","Type":"NodeParagraph","Properties":{"id":"20260505170804-3o6n9qb","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Function Call 就是 Agent 能力的最底层技术基础"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有 Function Call，Agent 就无法调用工具，也就没法真正做事"}]},{"ID":"20260505170804-5vk2psc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-5vk2psc","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么是 A2A"}]},{"ID":"20260505170804-zcmhkhd","Type":"NodeParagraph","Properties":{"id":"20260505170804-zcmhkhd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"A2A 全称 Agent to Agent，是智能体之间互联互通的通信协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它定义了一套统一标准"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来解决不同厂商、不同框架 Agent 无法交互的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个智能体都会通过 AgentCard 声明自身能力，比如擅长查询、计算、数据分析等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主智能体收到复杂任务后，可以拆解任务，主动委派给对应的专业子智能体协作完成，最后汇总结果返回"}]},{"ID":"20260505170804-3itj2e9","Type":"NodeParagraph","Properties":{"id":"20260505170804-3itj2e9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"A2A 和 Function Call 有本质区别"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Function Call 是智能体单向调用外部工具接口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 A2A 是多个智能体对等交流、互相调度、分工协作，是多智能体协同的核心协议"}]},{"ID":"20260509182305-uw0imbk","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260509182305-uw0imbk","updated":"20260509182309"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Agent 是怎么工作的"}]},{"ID":"20260509182305-5ckeo97","Type":"NodeParagraph","Properties":{"id":"20260509182305-5ckeo97","updated":"20260509181533"},"Children":[{"Type":"NodeText","Data":"Agent 的核心是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大模型 + 记忆 + 规划 + 工具调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"跑一个 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"感知-思考-行动-反馈"},{"Type":"NodeText","Data":" 的循环，直到任务完成"}]},{"ID":"20260509182305-gu5p4gf","Type":"NodeParagraph","Properties":{"id":"20260509182305-gu5p4gf","updated":"20260509181507"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心组件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"LLM"},{"Type":"NodeText","Data":"：负责理解、推理、任务拆解、决策 是核心调度者"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"记忆"},{"Type":"NodeText","Data":"：短期靠当前上下文\t长期靠向量库存储过往经验/知识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"规划"},{"Type":"NodeText","Data":"：把复杂目标拆成可执行小步骤"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工具"},{"Type":"NodeText","Data":"：联网搜索、代码解释器、API、数据库等，用来跟外部世界交互"}]},{"ID":"20260509182305-ubl6ddw","Type":"NodeParagraph","Properties":{"id":"20260509182305-ubl6ddw","updated":"20260509182230"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工作流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"感知：接收用户指令、工具返回结果、环境数据，同意转成模型可理解格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"思考：LLM 结合目标、记忆、工具能力\t判断下一步：直接回答/调用工具/继续规划"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"行动：生成结构化指令(如 json)，调用工具执行(搜索/运行代码/发请求）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"\t   LLM 不直接执行，只生成调用参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"反馈：工具结果返回，进入下一轮循环；直到 LLM 判断任务完成，或触发终止条件"}]},{"ID":"20260505170804-jlolk5a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-jlolk5a","updated":"20260512231007"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Agent 是怎么工作的"}]},{"ID":"20260505170804-z0pje2i","Type":"NodeParagraph","Properties":{"id":"20260505170804-z0pje2i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 核心就是大模型当大脑，结合感知、规划、工具调用、记忆"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自主完成复杂任务，不是单纯被动问答"}]},{"ID":"20260505170804-j08b9lz","Type":"NodeParagraph","Properties":{"id":"20260505170804-j08b9lz","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，Agent 会先"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接收用户需求"},{"Type":"NodeText","Data":"，结合自身短期上下文记忆和长期知识库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先理解目标、拆解任务"}]},{"ID":"20260505170804-yg9xs7m","Type":"NodeParagraph","Properties":{"id":"20260505170804-yg9xs7m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"大模型会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自主判断"},{"Type":"NodeText","Data":"当前需要做什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是直接回答，还是要查资料、调工具、执行代码，不用人一步步指令"}]},{"ID":"20260505170804-2tztths","Type":"NodeParagraph","Properties":{"id":"20260505170804-2tztths","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，关键是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"规划 + 工具调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遇到复杂问题会自动拆分多步子任务，按顺序推进"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要外部能力时，主动调用插件、接口、搜索、数据库这些工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拿到外部实时数据或执行结果，再交给大模型整合处理"}]},{"ID":"20260505170804-8plv9gk","Type":"NodeParagraph","Properties":{"id":"20260505170804-8plv9gk","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后，依靠"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"记忆和迭代闭环持续优化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"短期记忆保留当前对话上下文，长期记忆沉淀历史任务信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每做完一步会自我反思、校验结果，判断是否需要补全信息、重新调用工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直到任务闭环完成，再整理成完整答案输出给用户"}]},{"ID":"20260512231007-2nmj8v1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260512231007-2nmj8v1","updated":"20260512223427"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"现在 AIAgent 大概是怎么搭建起来的"}]},{"ID":"20260512231007-g7gep58","Type":"NodeParagraph","Properties":{"id":"20260512231007-g7gep58","updated":"20260512230845"},"Children":[{"Type":"NodeText","Data":"大模型 + 工作流编排 + 工具调用 + 记忆机制 + 反馈闭环"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也就是说，大模型负责理解任务和做决策，但真正让它像“Agent”一样干活的，不只是模型本身"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而是外面那一层执行框架"}]},{"ID":"20260512231007-ommwpr8","Type":"NodeParagraph","Properties":{"id":"20260512231007-ommwpr8","updated":"20260512230905"},"Children":[{"Type":"NodeText","Data":"从搭建上看"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第一层通常是大模型作为“大脑”，负责做任务拆解、意图判断和下一步决策"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第二层是工具系统，比如搜索、数据库、代码执行、调用业务 API，这部分相当于它的“手”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"第三层是记忆，包括短期上下文和长期记忆，用来保存用户信息、历史任务和中间结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再往外就是工作流或者状态机，控制它什么时候思考、什么时候调用工具、什么时候结束"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"很多 Agent 本质上就是一个 感知 -"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":" 决策 -"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":" 执行 -"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":" 观察结果 -"},{"Type":"NodeBackslash","Children":[{"Type":"NodeBackslashContent","Data":"\u003e"}]},{"Type":"NodeText","Data":" 再决策 的循环"}]},{"ID":"20260512231007-vsaccc4","Type":"NodeParagraph","Properties":{"id":"20260512231007-vsaccc4","updated":"20260512230926"},"Children":[{"Type":"NodeText","Data":"如果放到工程实现里，常见做法是：前面接一个用户入口，比如 Chat 界面或 API"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"中间有一个 Agent Runtime，里面做 Prompt 拼装、工具注册、上下文管理、任务调度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后面再挂上向量库、业务系统、知识库和各种外部服务"}]},{"ID":"20260512231007-jey7yrx","Type":"NodeParagraph","Properties":{"id":"20260512231007-jey7yrx","updated":"20260512230931"},"Children":[{"Type":"NodeText","Data":"现在很多团队会再加一层多 Agent 协作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如一个负责规划，一个负责执行，一个负责校验，但本质还是把单 Agent 的这套能力拆开了"}]},{"ID":"20260509184015-3niawp2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260509184015-3niawp2","updated":"20260508151409"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"agent 的记忆机制"}]},{"ID":"20260509184015-p1bx62y","Type":"NodeParagraph","Properties":{"id":"20260509184015-p1bx62y","updated":"20260509182823"},"Children":[{"Type":"NodeText","Data":"Agent 记忆分三层：瞬时记忆、短期记忆、长期记忆，再加记忆管理(读写、遗忘、召回)"}]},{"ID":"20260509184015-qkpstyu","Type":"NodeParagraph","Properties":{"id":"20260509184015-qkpstyu","updated":"20260509182935"},"Children":[{"Type":"NodeText","Data":"三层记忆核心"}]},{"ID":"20260509184015-pieppf5","Type":"NodeParagraph","Properties":{"id":"20260509184015-pieppf5","updated":"20260509183007"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"瞬时记忆（上下文窗口）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就是当前这轮对话上下文，直接塞给 LLM 提示词里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"特点：最快不用检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"局限：有窗口长度限制，多了装不下会丢"}]},{"ID":"20260509184015-2lid9es","Type":"NodeParagraph","Properties":{"id":"20260509184015-2lid9es","updated":"20260509183240"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"短期记忆（会话记忆）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"整个任务会话里的所有历史：用户提问、Agent 思考、工具调用记录"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"作用：连贯多轮任务，知道前面干到哪一步"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"存储：内存/临时数据库，会话结束可清空"}]},{"ID":"20260509184015-vli6p2d","Type":"NodeParagraph","Properties":{"id":"20260509184015-vli6p2d","updated":"20260509183506"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长期记忆(向量库记忆)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把过往对话、个人偏好、知识库、历史经验转成向量，存在向量数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"关键：靠语义相似度检索，不是关键词匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用途：跨会话复用，比如记住你习惯简洁回答、常用偏好"}]},{"ID":"20260509184015-m8ugsb6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260509184015-m8ugsb6","updated":"20260509183530"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"记忆完整工作流程"}]},{"ID":"20260509184015-338kv26","Type":"NodeParagraph","Properties":{"id":"20260509184015-338kv26","updated":"20260509183846"},"Children":[{"Type":"NodeText","Data":"写入：每轮对话结束，把内容做分块、向量化、存入向量库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"召回：用户新提问时，先语义检索，捞出相关历史记忆"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"融合：把召回的长期记忆 + 当前上下文一起喂给 LLM"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遗忘/压缩：太久没用、冗余的记忆做摘要或直接清理，防止臃肿"}]},{"ID":"20260509184015-215gnuc","Type":"NodeParagraph","Properties":{"id":"20260509184015-215gnuc","updated":"20260509183956"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"两种经典记忆类型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"显性记忆"},{"Type":"NodeText","Data":"：事实、知识、历史对话，可检索可复盘"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"隐性记忆"},{"Type":"NodeText","Data":"：做事风格、推理习惯、任务套路，模型潜移默化学会"}]},{"ID":"20260505170804-3h1gm06","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-3h1gm06","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Agent 得到一个答案，想要回流到知识里面，怎么决定这个答案有没有必要回流到知识里面？"}]},{"ID":"20260505170804-he2mnfi","Type":"NodeParagraph","Properties":{"id":"20260505170804-he2mnfi","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 不会把所有输出答案都无脑存入长期知识，会先做一层自主判断筛选"}]},{"ID":"20260505170804-05870xu","Type":"NodeParagraph","Properties":{"id":"20260505170804-05870xu","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"判断信息价值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只留存具备复用性、个性化、事实性的有效内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如用户长期偏好、业务规则、关键结论这类跨会话能用的信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"临时闲聊、一次性问答、重复内容直接过滤，不做回流"}]},{"ID":"20260505170804-irx2v4f","Type":"NodeParagraph","Properties":{"id":"20260505170804-irx2v4f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"校验信息质量与时效性"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"判断内容是否准确、无错误、不过时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"过时、矛盾、临时场景的无效答案，直接舍弃"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只有真实可靠、长期有效的信息，才会纳入知识沉淀"}]},{"ID":"20260505170804-rxzdd01","Type":"NodeParagraph","Properties":{"id":"20260505170804-rxzdd01","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合任务属性做决策"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一次性简单问答无需回流，复杂任务的最终结论、关键流程、经验总结这类高价值产出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"才会压缩精简，通过向量化存入长期知识库，避免知识冗余膨胀"}]},{"ID":"20260505170804-cz3cnqt","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-cz3cnqt","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"场景：实现一个登录注册，怎么用 Agent 去校验这个代码对不对，要不要回流过去，怎么校验代码是对的？"}]},{"ID":"20260505170804-8nz0lhb","Type":"NodeParagraph","Properties":{"id":"20260505170804-8nz0lhb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 先从功能、安全、边界场景自动校验登录注册代码，跑测试用例确认逻辑正确"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"然后判断校验结果是否是可复用的最佳实践或安全规则，有价值就回流，临时 bug 不回流"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最后把正确标准沉淀到知识库，让后续开发直接复用经验"}]},{"ID":"20260505170804-bmwhfyx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-bmwhfyx","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Skill 了解过吗，是怎么生成的"}]},{"ID":"20260505170804-ohuio8j","Type":"NodeParagraph","Properties":{"id":"20260505170804-ohuio8j","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我了解过 Skill，它是 Agent 可复用的标准化能力单元"}]},{"ID":"20260505170804-lzk9i4g","Type":"NodeParagraph","Properties":{"id":"20260505170804-lzk9i4g","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Skill 有两种生成方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主要以人为手写开发为主"},{"Type":"NodeText","Data":"，由开发者提前编写函数、脚本和工具逻辑"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"定义好入参、出参与使用规范，注册给 Agent，稳定性强、适合高频通用场景"}]},{"ID":"20260505170804-saxc75i","Type":"NodeParagraph","Properties":{"id":"20260505170804-saxc75i","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次是大模型动态生成，遇到非常规临时需求时，Agent 会自主编写临时 Skill 应急使用"}]},{"ID":"20260505170804-cxh78vs","Type":"NodeParagraph","Properties":{"id":"20260505170804-cxh78vs","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Skill 是能动手做的工具能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"回流记忆是用来参考避坑的知识经验"}]},{"ID":"20260505170804-i66o4nh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-i66o4nh","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"skill，Agent，RAG 是怎么联系和使用关系"}]},{"ID":"20260505170804-xxl07fg","Type":"NodeParagraph","Properties":{"id":"20260505170804-xxl07fg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent 是核心大脑，负责理解需求、规划任务、统一调度"}]},{"ID":"20260505170804-o0crdib","Type":"NodeParagraph","Properties":{"id":"20260505170804-o0crdib","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"RAG 管知识：缺专业资料、历史规则、私有内容时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agent 调用 RAG 检索知识库，提供参考信息"}]},{"ID":"20260505170804-1yvbms4","Type":"NodeParagraph","Properties":{"id":"20260505170804-1yvbms4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Skill 管执行：要写代码、跑脚本、调接口、做校验这类实际操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agent 就调用 Skill 完成落地"}]},{"ID":"20260505170804-0xu36vy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-0xu36vy","updated":"20260521123629"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么需要 skill"}]},{"ID":"20260505170804-3r77aws","Type":"NodeParagraph","Properties":{"id":"20260505170804-3r77aws","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Agent Skill 是把「指令、脚本、模板」一体化打包成可复用能力包的机制"}]},{"ID":"20260505170804-3klykwq","Type":"NodeParagraph","Properties":{"id":"20260505170804-3klykwq","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"关键在于三件事："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agent 能自动发现它、按需加载它、在需要时调用里面的脚本和资源"}]},{"ID":"20260505170804-hye0d98","Type":"NodeParagraph","Properties":{"id":"20260505170804-hye0d98","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它不只是「存 prompt」，而是一份 Agent 能自己翻阅的「操作手册 + 工具箱」"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个 Skill 是一个文件夹，里面有一份 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SKILL.md"},{"Type":"NodeText","Data":" 指令文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还可以带上脚本、模板、参考文献这些资源"}]},{"ID":"20260505170804-fult6ek","Type":"NodeParagraph","Properties":{"id":"20260505170804-fult6ek","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"code-review/                  ## Skill 文件夹，名字就是这个 Skill 的标识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"├── SKILL.md                  ## 核心指令文件（必须有）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"├── scripts/                  ## 可选：可执行的脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"│   └── check_security.py     ## 比如一个安全检查脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"├── references/               ## 可选：参考文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"│   └── review_standards.md   ## 比如团队的审查标准文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"└── assets/                   ## 可选：模板、资源文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"└── report_template.md    ## 比如审查报告的输出模板"}]},{"ID":"20260505170804-g85mjng","Type":"NodeParagraph","Properties":{"id":"20260505170804-g85mjng","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"解决重复粘贴 prompt 的痛点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"传统每次写任务都要复制大段 prompt"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"个人用着低效，团队里还会出现版本不统一、审查标准不一致的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Skill 把常用的指令、流程、模板打包成标准化模块"}]},{"ID":"20260505170804-trgfanx","Type":"NodeParagraph","Properties":{"id":"20260505170804-trgfanx","updated":"20260521123629"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"用 “渐进式加载” 解决 token 浪费问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果把所有 prompt、脚本、参考资料全塞进上下文，会占掉大量 token，影响模型思考空间 Skill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用三层加载机制："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"启动时只加载名字和简介，任务匹配时再加载完整指令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行中用到哪个模板 / 脚本才读取哪个，按需加载，大幅节省 context"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"让 Agent 始终高效运行"}]},{"ID":"20260505170804-dpzno7s","Type":"NodeParagraph","Properties":{"id":"20260505170804-dpzno7s","updated":"20260510164502"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"和 Tool、Prompt 形成互补，让 Agent 从 “能干活” 到 “会干活”"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool 只提供执行能力（比如查数据库、写代码）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 是一次性口头指令，而 Skill 是可复用的 SOP 手册"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它教 Agent 拿到工具后，该按什么步骤、什么标准、什么格式完成任务，把零散能力变成稳定、标准化的工作流，这是 Prompt 和 Tool 都做不到的"}]},{"ID":"20260505170804-m7o2sm9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-m7o2sm9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"了解 AI 工程化吗"}]},{"ID":"20260505170804-r2wyv1m","Type":"NodeParagraph","Properties":{"id":"20260505170804-r2wyv1m","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"AI 工程化，简单说就是把"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大模型、Agent、RAG 这些 AI 能力"},{"Type":"NodeText","Data":"，从 demo 原型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"变成稳定、可落地、可复用、可规模化上线的企业级应用"}]},{"ID":"20260505170804-ucwtlda","Type":"NodeParagraph","Properties":{"id":"20260505170804-ucwtlda","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先，AI 原生能力本身零散且不稳定"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接用大模型裸跑，会有输出不可控、上下文有限、无法落地执行的问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工程化就是通过"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"标准化封装"},{"Type":"NodeText","Data":"，把 RAG 知识库、Skill 工具、Agent 调度能力做模块化拆分"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"统一管理"}]},{"ID":"20260505170804-89lt88f","Type":"NodeParagraph","Properties":{"id":"20260505170804-89lt88f","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次，会解决实际落地的核心问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如上下文超限、知识过期、工具调用混乱、输出格式不统一、安全风险这些问题 |"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过向量库、记忆管理、权限控制、结果校验、熔断降级等"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工程手段做约束"},{"Type":"NodeText","Data":"，保证服务稳定可用"}]},{"ID":"20260505170804-1ufutan","Type":"NodeParagraph","Properties":{"id":"20260505170804-1ufutan","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后，AI 工程化还包含"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"迭代和运维"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如知识库定时更新、技能统一维护、任务流程沉淀优化、性能调优和成本管控，让 AI 应用可以长期迭代、批量复用，不只是临时 demo，能真正融入业务流程"}]},{"ID":"20260505170804-e3wjkyv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-e3wjkyv","updated":"20260529160546"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"了解 Harness 吗"}]},{"ID":"20260505170804-cuh6ens","Type":"NodeParagraph","Properties":{"id":"20260505170804-cuh6ens","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"我了解 Harness，它是 AI 模型 / Agent 的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工程化运行管控层"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"相当于给大模型套上的标准化 “运行环境 + 安全护栏”"}]},{"ID":"20260505170804-4vps48y","Type":"NodeParagraph","Properties":{"id":"20260505170804-4vps48y","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它的核心作用，就是把裸跑的大模型，变成能在业务里稳定用的系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它会帮模型做状态管理、工具调用、流程编排"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时加上权限控制、结果校验、安全过滤这些约束，防止模型乱输出、越权操作"}]},{"ID":"20260505170804-3s5y0rx","Type":"NodeParagraph","Properties":{"id":"20260505170804-3s5y0rx","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"和 Skill、RAG 这些不一样，Harness 更像一个统一的调度与管控平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所有的技能、知识库、工具，都要通过 Harness 来接入和执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它保证了 AI 应用的可观测、可维护、可规模化，是从 Demo 到企业级落地的关键"}]},{"ID":"20260529160546-bezdg7j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260529160546-bezdg7j","updated":"20260529160716"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"OpenSpec"}]},{"ID":"20260529160600-0ijsfac","Type":"NodeParagraph","Properties":{"id":"20260529160600-0ijsfac","updated":"20260529160620"},"Children":[{"Type":"NodeText","Data":"OpenSpec 是一套面向 AI 编程的规范开发工具，核心思路就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先定规则，再写代码"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260529160600-9z4ydap","Type":"NodeParagraph","Properties":{"id":"20260529160600-9z4ydap","updated":"20260529160702"},"Children":[{"Type":"NodeText","Data":"我们会把需求、功能要求、验收标准全都写成统一的文档,作为开发依据,从源头避免理解偏差"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"它完全基于本地文件，适配各类 AI 编码工具，使用起来很灵活"}]},{"ID":"20260529160600-17fs7nn","Type":"NodeParagraph","Properties":{"id":"20260529160600-17fs7nn","updated":"20260529160711"},"Children":[{"Type":"NodeText","Data":"整体流程也很清晰："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先提交变更方案，敲定正式规范，再完成技术设计、拆分开发任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"全程配合 TDD 模式开发、逐项验证，最终更新归档规范"}]},{"ID":"20260529160600-mqphile","Type":"NodeParagraph","Properties":{"id":"20260529160600-mqphile","updated":"20260529160716"},"Children":[{"Type":"NodeText","Data":"这套方式能让开发过程标准统一、有据可查"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每一步都可追溯、可审查，大幅提升 AI 编码的稳定性"}]},{"ID":"20260505170804-w2s2h39","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-w2s2h39","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Spec Coding"}]},{"ID":"20260505170804-thfngli","Type":"NodeParagraph","Properties":{"id":"20260505170804-thfngli","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"规格驱动开发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先写清楚需求和规格"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 按规格执行、不跑偏"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合正经项目、团队协作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"前期准备时间长"}]},{"ID":"20260505170804-4hyply7","Type":"NodeParagraph","Properties":{"id":"20260505170804-4hyply7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"先定标准、定契约、定规则再写代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接口格式、参数、返回值、模型调用规范全部提前约定好，代码严格照着约束写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"逻辑可控、边界清晰、不容易出隐式 bug"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"适合对接 AI 接口、后端业务、正式项目，稳定性强，但写起来约束多、改动慢"}]},{"ID":"20260505170804-lq2tx07","Type":"NodeParagraph","Properties":{"id":"20260505170804-lq2tx07","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Spec Coding 重规则与严谨，先约束后开发，适合线上正式项目"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Vibe Coding 重速度与随性，先实现后补坑，适合临时 demo"}]},{"ID":"20260505170804-7u6mlz9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-7u6mlz9","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"什么叫多模态"}]},{"ID":"20260505170804-eolz5m5","Type":"NodeParagraph","Properties":{"id":"20260505170804-eolz5m5","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模态 = 人类感知世界的不同信号形式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文字、语音、图片、视频、表情、触觉、气味，每一种都是一个模态"}]},{"ID":"20260505170804-stz36bg","Type":"NodeParagraph","Properties":{"id":"20260505170804-stz36bg","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多模态指的是融合文本、图像、音频、视频等多种不同类型信息模态的技术范式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"单一模态只能处理文字或图像一类单一数据，而多模态能够对多种异构信息进行统一理解与表征"}]},{"ID":"20260505170804-mawgxv7","Type":"NodeParagraph","Properties":{"id":"20260505170804-mawgxv7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心思路是通过各自专属编码器"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"将图像、语音、文本等不同形式的数据，转化为统一维度的语义特征向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完成跨模态语义对齐，让不同模态信息能够互相理解、关联匹配"}]},{"ID":"20260505170804-nz1ism4","Type":"NodeParagraph","Properties":{"id":"20260505170804-nz1ism4","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"在此基础上做多模态融合与联合推理，综合多源信息做分析、判断与生成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"目前广泛应用于图文问答、文生图、视频理解、音视频内容分析等场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"也是大模型落地的核心方向之一"}]},{"ID":"20260505170804-67hgx33","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-67hgx33","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"介绍一下 langchain 框架"}]},{"ID":"20260505170804-l795va7","Type":"NodeParagraph","Properties":{"id":"20260505170804-l795va7","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"LangChain 是大模型应用开发的开源框架"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用来串联大模型、外部数据、工具和对话记忆"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"弥补大模型知识滞后、无上下文、无法自主执行任务的缺陷"}]},{"ID":"20260505170804-k7vok3s","Type":"NodeParagraph","Properties":{"id":"20260505170804-k7vok3s","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"核心组件有五大类："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"模型、提示词、记忆、链路、智能体，还有检索模块"}]},{"ID":"20260505170804-e41jkyd","Type":"NodeParagraph","Properties":{"id":"20260505170804-e41jkyd","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"模型对接各类大模型与向量嵌入"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"提示词用来统一管理模板和输出格式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"记忆负责保存对话上下文，实现多轮交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"链路用来串联多个任务流程，组合完成复杂需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"智能体可以自主思考、选择调用工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检索模块专门处理本地文档、私有数据，实现 RAG 问答，整体模块化强、上手快"}]},{"ID":"20260505170804-4mvup0i","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-4mvup0i","updated":"20260510171052"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何管理多轮对话和上下文"}]},{"ID":"20260505170804-m1fxy3q","Type":"NodeParagraph","Properties":{"id":"20260505170804-m1fxy3q","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"多轮对话就是维护上下文会话窗口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把系统提示、历史问答、当前问题一起传给大模型，让模型能连贯理解语境"}]},{"ID":"20260505170804-2dowck8","Type":"NodeParagraph","Properties":{"id":"20260505170804-2dowck8","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"常用四种管理方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完整留存：全量带历史，简单但轮次多了耗 Token、容易超限"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"滑动窗口：只保留最近几轮，超出就丢弃最早记录，够用又省资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"摘要压缩：长对话定时总结关键信息，用摘要替代冗长历史，保核心、降开销"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长短记忆分离：短期存当前最近轮次，长期把用户偏好、业务配置存数据库 / 向量库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每次调用合并加载"}]},{"ID":"20260505170804-evv90kb","Type":"NodeParagraph","Properties":{"id":"20260505170804-evv90kb","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"工程落地关键点"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"固定系统提示词不改动；统一消息角色格式；控制上下文 Token 长度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"超长对话做截断或摘要，保证稳定不超限、对话不丢关键信息"}]},{"ID":"20260510171052-igq0e28","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260510171052-igq0e28","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"MCP 协议与 AI 工具互联"}]},{"ID":"20260510171052-q7g2225","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-q7g2225","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 完整定义"}]},{"ID":"20260510171052-dtmaupv","Type":"NodeParagraph","Properties":{"id":"20260510171052-dtmaupv","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 全称 Model Context Protocol（模型上下文协议）"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是一种面向 AI 大模型 / Agent 系统与外部能力互联的标准化通用协议"}]},{"ID":"20260510171052-80a9pbo","Type":"NodeParagraph","Properties":{"id":"20260510171052-80a9pbo","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它不训练模型、不替代原有业务系统"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心目标是为 AI 提供一套统一、可发现、可调用、可控制的标准化方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"安全连接外部真实世界资源"}]},{"ID":"20260510171052-n8h8z5s","Type":"NodeParagraph","Properties":{"id":"20260510171052-n8h8z5s","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"大模型原生只擅长文本理解与生成"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"天生不具备访问本地文件、数据库、操作系统终端、浏览器、企业内部业务系统的真实执行能力"}]},{"ID":"20260510171052-azdu53n","Type":"NodeParagraph","Properties":{"id":"20260510171052-azdu53n","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 的核心价值"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"就是把所有外部工具、资源、执行能力，以统一协议的形式标准化暴露给 AI"}]},{"ID":"20260510171052-1dggsi1","Type":"NodeParagraph","Properties":{"id":"20260510171052-1dggsi1","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"因此 MCP 不只是一个通信协议，本质是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与外部工具之间的标准连接规范"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与各类上下文资源之间的统一访问入口"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 与可执行动作之间的协议化能力抽象层"}]},{"ID":"20260510171052-4ky2yao","Type":"NodeParagraph","Properties":{"id":"20260510171052-4ky2yao","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 实现工具互联、上下文互通、企业系统安全接入的核心基础设施"}]},{"ID":"20260510171052-b4pkbnr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-b4pkbnr","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"传统 AI 工具接入存在的痛点"}]},{"ID":"20260510171052-9hdsl06","Type":"NodeParagraph","Properties":{"id":"20260510171052-9hdsl06","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"接入协议碎片化"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"数据库一套接入方式、浏览器一套方式、企业内部平台又是另一套独立方式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"没有统一标准，重复开发、维护成本极高"}]},{"ID":"20260510171052-82prj6h","Type":"NodeParagraph","Properties":{"id":"20260510171052-82prj6h","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"工具信息不统一不规范"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"部分工具只有代码接口、部分只有文档、部分缺少输入输出参数约束，模型 / Agent 无法清晰理解自身可用能力、调用规则"}]},{"ID":"20260510171052-mwr7ml9","Type":"NodeParagraph","Properties":{"id":"20260510171052-mwr7ml9","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"能力发现困难"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 无法感知当前环境有哪些可用能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不清楚能力入参出参要求、不明确自身权限边界，无法自主合理调用工具"}]},{"ID":"20260510171052-yxxms23","Type":"NodeParagraph","Properties":{"id":"20260510171052-yxxms23","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"安全控制分散混乱"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"文件访问、命令执行、数据库查询、内部服务调用各自独立管控"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"无法形成统一的权限治理、操作审批、行为审计机制，安全风险极高"}]},{"ID":"20260510171052-evu2qub","Type":"NodeParagraph","Properties":{"id":"20260510171052-evu2qub","updated":"20260510171022"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Agent 工程化难以扩展落地"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"本地 Demo 可以简单运行，但企业级落地时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"会面临接入混乱、调用不可控、能力复用性差、难以维护扩展的问题"}]},{"ID":"20260510171052-5522l0v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-5522l0v","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 统一解决的五大核心规范"}]},{"ID":"20260510171052-hpqptma","Type":"NodeParagraph","Properties":{"id":"20260510171052-hpqptma","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP 针对以上痛点，把全流程抽象成一套统一标准化模式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"标准化暴露"},{"Type":"NodeText","Data":"：统一规范外部工具 / 资源的接入格式、描述定义，不再各自定制协议"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自动化发现"},{"Type":"NodeText","Data":"：AI 可自动枚举、感知全部可用能力与能力详情，无需人工配置"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能力如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"规范化调用"},{"Type":"NodeText","Data":"：统一调用请求格式、交互流程，模型按标准发起执行请求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"结果如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结构化返回"},{"Type":"NodeText","Data":"：统一响应、错误、流式数据格式，AI 可稳定解析执行结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"权限如何"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"统一约束管控"},{"Type":"NodeText","Data":"：统一全链路权限校验、操作审批、行为审计、安全隔离机制"}]},{"ID":"20260510171052-cnz7r0s","Type":"NodeParagraph","Properties":{"id":"20260510171052-cnz7r0s","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"这意味着:MCP 不是把所有系统“变成同一种业务”，而是把它们对 AI 的接入方式变成同一种协议语言"}]},{"ID":"20260510171052-54xsz42","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-54xsz42","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么对 Agent 和 AI 编程重要"}]},{"ID":"20260510171052-bv5hxjb","Type":"NodeParagraph","Properties":{"id":"20260510171052-bv5hxjb","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 的关键不是 “会聊天”，而是能完成任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而完成任务通常意味着 AI 需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读取真实上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"访问真实环境"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行真实动作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"获取真实反馈"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"基于反馈继续决策"}]},{"ID":"20260510171052-vzzqh8d","Type":"NodeParagraph","Properties":{"id":"20260510171052-vzzqh8d","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"例如一个 AI 编程 Agent 修复 Bug 时，往往需要："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"读取报错文件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"搜索项目代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查询依赖版本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行测试命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"修改代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再次运行验证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这已经不是单纯的 Prompt 能完成的事情"}]},{"ID":"20260510171052-daj3rkx","Type":"NodeParagraph","Properties":{"id":"20260510171052-daj3rkx","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"它需要 AI 与文件系统、终端、测试框架、文档资源等形成受控互联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MCP 正是支撑这种互联的协议基础之一"}]},{"ID":"20260510171052-6l3a97p","Type":"NodeParagraph","Properties":{"id":"20260510171052-6l3a97p","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"在 MCP / AI 工具互联系统中的体现"}]},{"ID":"20260510171052-yv7kklc","Type":"NodeParagraph","Properties":{"id":"20260510171052-yv7kklc","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"在实际系统中，MCP 往往体现为以下结构："}]},{"ID":"20260510171052-2hmljsb","Type":"NodeParagraph","Properties":{"id":"20260510171052-2hmljsb","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP Client"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通常由 IDE、AI 助手、Agent Runtime 承担"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"负责连接 Server、发现能力、发起调用"}]},{"ID":"20260510171052-cw9p3ov","Type":"NodeParagraph","Properties":{"id":"20260510171052-cw9p3ov","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"MCP Server"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对外暴露能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"封装底层文件系统、数据库、浏览器、企业服务等"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool / Resource / Prompt"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Tool 负责动作执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Resource 负责上下文读取"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Prompt 负责复用任务模板"}]},{"ID":"20260510171052-5f0orpt","Type":"NodeParagraph","Properties":{"id":"20260510171052-5f0orpt","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"Agent 核心是完成真实任务而非聊天"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要 AI 读写上下文、访问环境、执行动作、根据反馈决策"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这类复杂编程任务无法仅靠 Prompt 实现，必须和文件、终端、代码系统真实互联"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而 MCP 采用 Client-Server 架构，Client 由 Agent/IDE 承担调用能力"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Server 封装暴露底层外部资源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拆分 Tool 执行、Resource 读上下文、Prompt 复用模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"是 AI Agent 工具互联的标准协议底座"}]},{"ID":"20260510171052-xk16s4o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-xk16s4o","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"企业中的典型使用场景"}]},{"ID":"20260510171052-fekpah2","Type":"NodeParagraph","Properties":{"id":"20260510171052-fekpah2","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"企业内部最典型的 MCP 使用场景包括："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 编程助手读取项目代码并运行测试"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 运维助手查询日志平台与监控平台"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 助手读取内部知识库文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 自动创建或更新工单"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 查询发布平台状态"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 在受控环境下执行终端命令"}]},{"ID":"20260510171052-cawyuuj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-cawyuuj","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 核心价值"}]},{"ID":"20260510171052-0ynhxvo","Type":"NodeParagraph","Properties":{"id":"20260510171052-0ynhxvo","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"统一工具接入标准、降低开发对接成本、AI 能力自主发现"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"集中安全权限治理、支持 Agent 企业级工程扩展，同时与底层大模型完全解耦"}]},{"ID":"20260510171052-d5kvgwi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260510171052-d5kvgwi","updated":"20260510171022"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常见误区 / 边界 / 风险"}]},{"ID":"20260510171052-ns1hztd","Type":"NodeParagraph","Properties":{"id":"20260510171052-ns1hztd","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 1：MCP 就是大模型本身"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。MCP 是连接模型与外部能力的协议层"}]},{"ID":"20260510171052-9cptjvg","Type":"NodeParagraph","Properties":{"id":"20260510171052-9cptjvg","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 2：MCP 就是某个具体 SDK"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。SDK 可以实现 MCP，但 MCP 本身是协议思想与交互规范"}]},{"ID":"20260510171052-iiqr6em","Type":"NodeParagraph","Properties":{"id":"20260510171052-iiqr6em","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 3：有了 MCP，模型就自动能安全执行一切操作"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不是。MCP 需要配合权限控制、审批、白名单、审计等工程机制"}]},{"ID":"20260510171052-mru2fqm","Type":"NodeParagraph","Properties":{"id":"20260510171052-mru2fqm","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"误区 4：MCP 等于所有工具调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不完全等于。工具调用是行为，MCP 是使这种行为标准化、可发现、可治理的协议化方式"}]},{"ID":"20260510171052-6j6qt7a","Type":"NodeParagraph","Properties":{"id":"20260510171052-6j6qt7a","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260419201257484"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260419201257484.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260510171052-d5fa3ig","Type":"NodeParagraph","Properties":{"id":"20260510171052-d5fa3ig","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"用户提出任务后，AI 并不是直接操作文件系统或数据库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"AI 通常通过 MCP Client 与 MCP Server 交互"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"MCP Server 再把底层能力以 Tool / Resource / Prompt 的方式暴露出来"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这使得 AI 对外部能力的访问变得统一、可控、可扩展"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"帮助读者从整体架构层面理解 MCP 的位置，明确它连接的是 AI 与外部真实能力"}]},{"ID":"20260510171052-dsqdnvo","Type":"NodeParagraph","Properties":{"id":"20260510171052-dsqdnvo","updated":"20260510171022"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260419200948217"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"C:/Users/zhanr/AppData/Roaming/Typora/typora-user-images/image-20260419200948217.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260505170804-ygne11d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260505170804-ygne11d","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"OpenClaw 架构深度分析"}]},{"ID":"20260505170804-2y33bc3","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-2y33bc3","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"整体架构：三层调度中心"}]},{"ID":"20260505170804-k3bf9i9","Type":"NodeParagraph","Properties":{"id":"20260505170804-k3bf9i9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"OpenClaw 是一套本地优先的 AI Agent 执行引擎"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而非简易聊天机器人，整体采用接口层 → 网关层 → 执行层的三层调度架构"}]},{"ID":"20260505170804-e7u6cs9","Type":"NodeParagraph","Properties":{"id":"20260505170804-e7u6cs9","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"接口层负责多聊天渠道接入适配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"网关层通过 WebSocket 做实时消息路由"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行层是 Agent 核心，负责 LLM 推理、工具执行与会话记忆管理"}]},{"ID":"20260505170804-qe8gwki","Type":"NodeParagraph","Properties":{"id":"20260505170804-qe8gwki","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"架构实现消息调度与 AI 执行解耦"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"采用 WebSocket 事件驱动实时通信，同时数据全本地存储，保障用户隐私安全"}]},{"ID":"20260505170804-udtey2d","Type":"NodeParagraph","Properties":{"id":"20260505170804-udtey2d","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"类似于："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"OpenClaw = 本地优先 AI 引擎 + 极高系统权限 + 多 Agent 协同调度 + 全链路本地长记忆"}]},{"ID":"20260505170804-dr02z9f","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-dr02z9f","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"怎么实现自动化 agent 协作"}]},{"ID":"20260505170804-vrr572e","Type":"NodeParagraph","Properties":{"id":"20260505170804-vrr572e","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"首先要做任务拆解与角色划分，根据业务把不同 Agent 定位分工"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如规划 Agent、执行 Agent、工具调用 Agent、复盘 Agent"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"每个角色绑定专属能力和职责边界，避免任务冲突和重复工作"}]},{"ID":"20260505170804-09hd0rc","Type":"NodeParagraph","Properties":{"id":"20260505170804-09hd0rc","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"其次搭建协作调度中枢，靠调度模块做流程编排"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用事件驱动、队列管理或者工作流引擎串联多个 Agent"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"自动分发子任务、把控执行顺序，支持串行、并行、条件分支等多种协作模式"}]},{"ID":"20260505170804-vovctd2","Type":"NodeParagraph","Properties":{"id":"20260505170804-vovctd2","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"然后统一通信与上下文共享"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"依靠向量数据库、全局记忆池做信息互通，所有 Agent 共用会话上下文、业务数据和中间结果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过标准化协议交互，保证信息同步不割裂，避免重复提问和数据不一致"}]},{"ID":"20260505170804-prsn5o0","Type":"NodeParagraph","Properties":{"id":"20260505170804-prsn5o0","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"最后增加协作管控与容错机制"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"靠规则校验、权限限制、结果校验约束 Agent 行为"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"加入失败重试、异常兜底、任务超时处理"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时加复盘评估模块，自动修正协作流程和任务分配逻辑，让多 Agent 协作稳定自动化运行"}]},{"ID":"20260505170804-warsjef","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-warsjef","updated":"20260505170804"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"向量数据库"}]},{"ID":"20260505170804-i746qw6","Type":"NodeParagraph","Properties":{"id":"20260505170804-i746qw6","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"向量数据库，就是专门存储 AI 向量数据、做相似度检索的数据库"}]},{"ID":"20260505170804-mvakwms","Type":"NodeParagraph","Properties":{"id":"20260505170804-mvakwms","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"普通数据库只能精准匹配内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"而向量数据库能把文字、图片这类内容，通过嵌入模型转为数字向量"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"语义、特征相近的数据，向量距离就更近"}]},{"ID":"20260505170804-z6i1f56","Type":"NodeParagraph","Properties":{"id":"20260505170804-z6i1f56","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"它可以在海量数据里快速检索相似内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用在 RAG 知识库、AI 记忆存储、Agent 上下文共享场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"帮 AI 快速调取相关信息，减少幻觉"}]},{"ID":"20260505170804-k869qge","Type":"NodeParagraph","Properties":{"id":"20260505170804-k869qge","updated":"20260505170804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在 agent 上下文中怎么做的"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先把每个 Agent 的对话、执行结果、中间信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过嵌入模型转为向量，统一存入向量数据库"}]},{"ID":"20260505170804-x0tg3sl","Type":"NodeParagraph","Properties":{"id":"20260505170804-x0tg3sl","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"所有 Agent 共用这个向量库"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要协作时，检索和当前任务语义相关的历史上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"直接读取复用"}]},{"ID":"20260505170804-s9f9rvr","Type":"NodeParagraph","Properties":{"id":"20260505170804-s9f9rvr","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"不用全量传输上下文，只拉取相似关键信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"实现轻量化信息互通，保证多 Agent 协作信息同步"}]},{"ID":"20260505170804-9972bq8","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260505170804-9972bq8","updated":"20260508095409"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"##### "},{"Type":"NodeText","Data":"function call 是什么"}]},{"ID":"20260505170804-lemw08v","Type":"NodeParagraph","Properties":{"id":"20260505170804-lemw08v","updated":"20260505170804"},"Children":[{"Type":"NodeText","Data":"Function Call 就是大模型主动调用外部工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"模型不会实时查数据、算复杂逻辑、调接口，就通过函数调用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"告诉程序要执行哪个工具、传什么参数"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"工具跑完把结果返回模型，模型再整合答案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Agent 自动干活、用插件、联网查询、多任务执行，全靠这个能力"}]},{"ID":"20260508095409-w0mvv5o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508095409-w0mvv5o","updated":"20260508130156"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"使用 AI 工具时遇到过幻觉或意图理解错误吗？"}]},{"ID":"20260508095409-ydr8f0o","Type":"NodeParagraph","Properties":{"id":"20260508095409-ydr8f0o","updated":"20260508094842"},"Children":[{"Type":"NodeText","Data":"遇到过"}]},{"ID":"20260508095409-ikkt8fh","Type":"NodeParagraph","Properties":{"id":"20260508095409-ikkt8fh","updated":"20260508095127"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"典型的 AI 幻觉："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"编造不存在的事实"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一本正经的说错专业知识"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"代码看似能跑但实则边界条件、并发安全、内存泄漏、逻辑漏洞全忽略等"}]},{"ID":"20260508095409-bx6wofz","Type":"NodeParagraph","Properties":{"id":"20260508095409-bx6wofz","updated":"20260508095159"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"意图理解错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"抓错核心需求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"曲解格式风格要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"答非所问"}]},{"ID":"20260508095409-aj16k2k","Type":"NodeParagraph","Properties":{"id":"20260508095409-aj16k2k","updated":"20260508095340"},"Children":[{"Type":"NodeText","Data":"我自己的理解，AI 很擅长逻辑包装，凑出完整答案"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"但专业深度、细节严谨性、精准匹配用户隐性需求经常翻车"}]},{"ID":"20260508130156-ub39bm8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508130156-ub39bm8","updated":"20260507165909"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你怎么降低 AI 幻觉、提升 AI 遵从度？"}]},{"ID":"20260508130156-7dv0myb","Type":"NodeParagraph","Properties":{"id":"20260508130156-7dv0myb","updated":"20260508114621"},"Children":[{"Type":"NodeText","Data":"核心就抓住一个根本原则："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"约束越具体，幻觉越少、执行越听话"}]},{"ID":"20260508130156-5egqkb0","Type":"NodeParagraph","Properties":{"id":"20260508130156-5egqkb0","updated":"20260508114645"},"Children":[{"Type":"NodeText","Data":"不用模糊提问、不给 AI 自由发挥的空间"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从身份、格式、知识范围和禁止项四方面提前把规则锁死，从根源减少编造和跑偏"}]},{"ID":"20260508130156-uic3ani","Type":"NodeParagraph","Properties":{"id":"20260508130156-uic3ani","updated":"20260508114947"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"日常使用时，别一次性抛复杂宽泛的问题，学会把大问题拆成单个小问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"尽量用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"封闭式带限定"},{"Type":"NodeText","Data":"的提问方式，专业内容提前要求真实可查证，杜绝凭空编造"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还能直接套用固定降幻觉 Prompt 模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设定好 AI 角色、指定输出格式、明确内容要求和禁止编造规则"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"听不懂就让它直说，不强行瞎答"}]},{"ID":"20260508130156-wrdqxab","Type":"NodeParagraph","Properties":{"id":"20260508130156-wrdqxab","updated":"20260508115135"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"同时可以加上强制校验机制，让关键内容标注依据来源"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一旦发现幻觉或理解偏差立刻纠正，要求模型重新按原始指令输出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长期下来会适配你的使用习惯"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"另外把自己的隐性需求直白写出来，把格式、禁令放在指令最前面"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不用大概、简单这类模糊表述，改用明确的条数、篇幅要求"}]},{"ID":"20260508130156-jol8yxn","Type":"NodeParagraph","Properties":{"id":"20260508130156-jol8yxn","updated":"20260508115156"},"Children":[{"Type":"NodeText","Data":"最后在模型选择和使用上做优化，严谨专业内容选逻辑可控的模型，避开脑洞创作型模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"长文档、大任务分段生成，不一次性批量输出"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再配合固定角色、硬性格式、锁定范围、明确禁令、拆分提问、有错即纠这套方法"}]},{"ID":"20260508130142-2c0ryr1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260508130142-2c0ryr1","updated":"20260521125035"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"你给 AI 写过 prompt 模板或自定义技能吗？"}]},{"ID":"20260508130142-vrz6bl3","Type":"NodeParagraph","Properties":{"id":"20260508130142-vrz6bl3","updated":"20260508125654"},"Children":[{"Type":"NodeText","Data":"我常用的几类 Prompt 模板"}]},{"ID":"20260508130142-xuslslt","Type":"NodeParagraph","Properties":{"id":"20260508130142-xuslslt","updated":"20260508125708"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"角色专家模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"固定人设 + 限定风格 + 输出格式 + 禁止冗余，比如：后端面试官、算法导师、文档润色专家"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"学习面试极简模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"要求：口语简洁、分点作答、满分面试话术、不废话、可直接背诵"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代码生成模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指定语言 + 工程规范 + 可直接运行 + 详细注释 + 思路总结，拒绝半成品"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"图文生成模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"摄影参数、构图、光影、风格、画质约束全套固定句式，不用每次重写"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"文档 / 课程设计模板"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"固定结构：背景、需求、模块设计、流程、优缺点、总结，自动按学术格式输出"}]},{"ID":"20260508130142-hs20i65","Type":"NodeParagraph","Properties":{"id":"20260508130142-hs20i65","updated":"20260508125952"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"自定义 skills 结构"}]},{"ID":"20260508130142-4rcrkjw","Type":"NodeParagraph","Properties":{"id":"20260508130142-4rcrkjw","updated":"20260508130034"},"Children":[{"Type":"NodeText","Data":"核心逻辑：定角色 + 定规则 + 定输出格式 + 禁废话 + 生效指令"}]},{"ID":"20260508130142-9u18fgk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"dGV4eQ==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260508130142-9u18fgk","updated":"20260508130058"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4eQ=="},{"Type":"NodeCodeBlockCode","Data":"【自定义技能名称】：XXX\n【角色定位】：你现在是XXX专家，只专注这个领域，不跑偏\n【硬性规则】\n1. 必须遵守：xxx\n2. 禁止做：xxx\n3. 语气风格：简洁/专业/口语/面试风\n【固定输出格式】\n每次回答严格按下面结构，不许乱改格式：\n1. 要点1\n2. 要点2\n总结：一句话概括\n【触发指令】\n以后我输入「开启XXX技能」，你立刻切换成这个模式；输入「关闭技能」恢复普通模式。\n\n\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260521125026-xbd7zkf","Type":"NodeParagraph","Properties":{"id":"20260521125026-xbd7zkf","updated":"20260521125026"}},{"ID":"20260521125035-xymg2bg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521125035-xymg2bg","updated":"20260521101506"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"可能会存在你 AI 生成结束之后，发现全是错的，这种情况要怎么去防止"}]},{"ID":"20260521125035-4hdq9od","Type":"NodeParagraph","Properties":{"id":"20260521125035-4hdq9od","updated":"20260521123135"},"Children":[{"Type":"NodeText","Data":"首先，想要避免产出内容出现错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最核心就是做好输入约束，在一开始就明确需求边界、限定范围与评判标准"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不让内容自由发散创作，从源头减少偏离和错误"}]},{"ID":"20260521125035-n4e34pj","Type":"NodeParagraph","Properties":{"id":"20260521125035-n4e34pj","updated":"20260521123146"},"Children":[{"Type":"NodeText","Data":"其次，生成完成后必须进行分层校验"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"先核对基础事实、专业知识点是否准确，再对照业务逻辑和实际场景排查漏洞"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"重点甄别常识错误、技术误区以及逻辑矛盾的地方，做到逐项把关"}]},{"ID":"20260521125035-zh6csz6","Type":"NodeParagraph","Properties":{"id":"20260521125035-zh6csz6","updated":"20260521123157"},"Children":[{"Type":"NodeText","Data":"最后，还要建立复盘修正习惯"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遇到不确定的内容及时查阅权威资料佐证，同时总结容易出错的场景和问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"后续创作提前规避，也可以分段生成、逐步核对，不一次性输出大段内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最大程度降低出错概率"}]},{"ID":"20260521125035-6g5cz1q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260521125035-6g5cz1q","updated":"20260522235546"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"写一个 skills 的流程"}]},{"ID":"20260521125035-9vf2vam","Type":"NodeParagraph","Properties":{"id":"20260521125035-9vf2vam","updated":"20260521123322"},"Children":[{"Type":"NodeText","Data":"Skills 流程"}]},{"ID":"20260521125035-eo43h41","Type":"NodeParagraph","Properties":{"id":"20260521125035-eo43h41","updated":"20260521123653"},"Children":[{"Type":"NodeText","Data":"先明确这个 skill 解决什么问题"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用户会怎么触发它，输入是什么，输出是什么，适合什么场景，不适合什么场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"一句话说清：这个 skill 是给 Codex 增加某类专门能力的"}]},{"ID":"20260521125035-97b1tqd","Type":"NodeParagraph","Properties":{"id":"20260521125035-97b1tqd","updated":"20260521123659"},"Children":[{"Type":"NodeText","Data":"定义几个典型使用例子"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如用户会说什么话触发它，常见任务有哪些，边界情况是什么"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这一步的目的，是反推 SKILL.md 里该写哪些触发描述和工作流程"}]},{"ID":"20260521125035-499i0md","Type":"NodeParagraph","Properties":{"id":"20260521125035-499i0md","updated":"20260521123703"},"Children":[{"Type":"NodeText","Data":"规划 skill 目录结构"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"最少必须有一个 SKILL.md"}]},{"ID":"20260521125035-0fjk8t6","Type":"NodeParagraph","Properties":{"id":"20260521125035-0fjk8t6","updated":"20260521123708"},"Children":[{"Type":"NodeText","Data":"如果内容多，再拆成："}]},{"ID":"20260521125035-ere7shh","Type":"NodeParagraph","Properties":{"id":"20260521125035-ere7shh","updated":"20260521123322"},"Children":[{"Type":"NodeText","Data":"scripts/：放可执行脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"references/：放参考文档"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"assets/：放模板、素材"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"agents/openai.yaml：放 UI 元数据"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"写 SKILL.md 的 frontmatter"}]},{"ID":"20260521125035-z0credc","Type":"NodeParagraph","Properties":{"id":"20260521125035-z0credc","updated":"20260521123735"},"Children":[{"Type":"NodeText","Data":"这里最关键的是："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"name"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"description"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"因为 Codex 主要靠这两个字段判断什么时候触发 skill"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"所以描述一定要写清“这是什么、什么时候用”"}]},{"ID":"20260521125035-9hu1i8b","Type":"NodeParagraph","Properties":{"id":"20260521125035-9hu1i8b","updated":"20260521123322"},"Children":[{"Type":"NodeText","Data":"写 SKILL.md 正文"}]},{"ID":"20260521125035-a9mclbv","Type":"NodeParagraph","Properties":{"id":"20260521125035-a9mclbv","updated":"20260521123750"},"Children":[{"Type":"NodeText","Data":"正文不要写成大而全教材，而是写："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"触发条件"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行步骤"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"选择分支"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要时去读哪个 reference"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要时运行哪个 script"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"核心原则是：主文件简洁，细节按需展开"}]},{"ID":"20260521125035-k2v4gr6","Type":"NodeParagraph","Properties":{"id":"20260521125035-k2v4gr6","updated":"20260521124225"},"Children":[{"Type":"NodeText","Data":"需要时去读 reference"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指参考文档、官方手册、权威资料，遇到不懂的知识点、参数、规范、接口用法时"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"查阅标准参考资料，用来核对正确性、补齐理论依据，保证内容不出错"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"需要时运行 script"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"指执行测试脚本、验证脚本，写完逻辑、代码、方案后，直接跑实测脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"通过实际运行结果验证逻辑是否可行、功能是否正常，用实操结果排查错误"}]},{"ID":"20260521125035-rb4rf42","Type":"NodeParagraph","Properties":{"id":"20260521125035-rb4rf42","updated":"20260521124256"},"Children":[{"Type":"NodeText","Data":"把易错、重复的操作做成脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果某个流程每次都一样，或者纯文字说明容易出错，就放到 scripts/ 里"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这样比每次让模型现写更稳定"}]},{"ID":"20260521125035-1e4uy94","Type":"NodeParagraph","Properties":{"id":"20260521125035-1e4uy94","updated":"20260521124304"},"Children":[{"Type":"NodeText","Data":"把大块资料放到 references"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如接口文档、字段说明、规范、模板说明，不要全塞进 SKILL.md，否则上下文会很重"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"只在 SKILL.md 里告诉模型：什么时候去看哪个 reference"}]},{"ID":"20260521125035-nwo0kz8","Type":"NodeParagraph","Properties":{"id":"20260521125035-nwo0kz8","updated":"20260521123322"},"Children":[{"Type":"NodeText","Data":"做一次验证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"检查三件事："}]},{"ID":"20260521125035-qx03pir","Type":"NodeParagraph","Properties":{"id":"20260521125035-qx03pir","updated":"20260521124332"},"Children":[{"Type":"NodeText","Data":"这个 skill 会不会被正确触发"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"触发后步骤是否清楚"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不同示例下是否能稳定完成任务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"根据真实使用迭代"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果发现触发不准，就改 description"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果发现执行不稳，就补步骤或补脚本"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"如果发现正文太长，就继续拆到 references/"}]},{"ID":"20260521125035-0tza306","Type":"NodeParagraph","Properties":{"id":"20260521125035-0tza306","updated":"20260521124339"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总结"}]},{"ID":"20260521125035-qu0oose","Type":"NodeParagraph","Properties":{"id":"20260521125035-qu0oose","updated":"20260521124344"},"Children":[{"Type":"NodeText","Data":"写 skill 的本质，就是先定义场景"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再把触发条件、执行流程和可复用资源整理成一个轻量但可落地的能力包"}]},{"ID":"20260522235546-clkfk0d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522235546-clkfk0d","updated":"20260522220356"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"AI 开发中 skill 及相关规则的生效规则是什么？"}]},{"ID":"20260522235546-vokdj79","Type":"NodeParagraph","Properties":{"id":"20260522235546-vokdj79","updated":"20260522225153"},"Children":[{"Type":"NodeText","Data":"Skill 是 Agent 封装好的独立能力单元"}]},{"ID":"20260522235546-07q08cv","Type":"NodeParagraph","Properties":{"id":"20260522235546-07q08cv","updated":"20260522225401"},"Children":[{"Type":"NodeText","Data":"生效时先匹配用户意图，筛选适配技能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"接着校验调用权限、频次与参数合法性，合规后按调度策略执行"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"执行结果回传给模型，更新对话上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"同时支持技能动态启停迭代，搭配重试、熔断机制，保障调用稳定可靠"}]},{"ID":"20260522235546-kdd3c8i","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522235546-kdd3c8i","updated":"20260522221404"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"AI 开发时上下文过长导致被压缩、出现不可预期问题，通常怎么解决？"}]},{"ID":"20260522235546-ubyt58l","Type":"NodeParagraph","Properties":{"id":"20260522235546-ubyt58l","updated":"20260522225456"},"Children":[{"Type":"NodeText","Data":"上下文过长被截断、压缩，最常用的解决思路就是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"控制长度、分层管理、动态清理"}]},{"ID":"20260522235546-msqvpu4","Type":"NodeParagraph","Properties":{"id":"20260522235546-msqvpu4","updated":"20260522225720"},"Children":[{"Type":"NodeText","Data":"首先会"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"过滤冗余信息"},{"Type":"NodeText","Data":"，只保留关键对话、任务状态和必要历史，去掉重复、无关内容"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"其次用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"摘要压缩"},{"Type":"NodeText","Data":"，把长历史转成精简摘要，保留核心意图，不丢关键信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"再配合"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"滑动窗口"},{"Type":"NodeText","Data":"，只保留最近 N 轮有效对话，更早的内容自动归档或摘要化"}]},{"ID":"20260522235546-x7gywpe","Type":"NodeParagraph","Properties":{"id":"20260522235546-x7gywpe","updated":"20260522225856"},"Children":[{"Type":"NodeText","Data":"复杂场景会做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"上下文分片 + 向量检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"把长内容存到知识库，需要时动态召回相关片段，不全部塞进上下文"}]},{"ID":"20260522235546-48wpd7m","Type":"NodeParagraph","Properties":{"id":"20260522235546-48wpd7m","updated":"20260522225722"},"Children":[{"Type":"NodeText","Data":"最后严格做"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"长度监控与熔断"},{"Type":"NodeText","Data":"，超过阈值自动触发清理，避免截断导致逻辑错乱"}]},{"ID":"20260522235546-hql1a8c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522235546-hql1a8c","updated":"20260522221423"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如何节约 AI 开发过程中的 token 成本？"}]},{"ID":"20260522235546-fduv6qk","Type":"NodeParagraph","Properties":{"id":"20260522235546-fduv6qk","updated":"20260522230111"},"Children":[{"Type":"NodeText","Data":"精简输入文本，剔除冗余话术、重复内容，缩减无效 token 占用"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"合理管控上下文，采用滑动窗口、摘要压缩，避免历史对话无限累积"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"按需选用模型，简单任务用轻量模型，复杂场景再调用高阶大模型"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"优化调用逻辑，合并重复请求，减少频繁交互与无效轮次问答"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"借助向量数据库检索关联信息，替代全量灌入长文本上下文"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"设置 token 阈值监控，超限自动裁剪内容，规避超额消耗"}]},{"ID":"20260522235546-4g8j8yz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260522235546-4g8j8yz","updated":"20260528142537"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"借助 AI 解决开发问题时，如何判断 AI 给出答案的正确性？"}]},{"ID":"20260522235546-rqz3uim","Type":"NodeParagraph","Properties":{"id":"20260522235546-rqz3uim","updated":"20260522230354"},"Children":[{"Type":"NodeText","Data":"对照业务逻辑与技术规范核验，判断方案是否符合实际开发要求"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拆分要点逐一推演，排查逻辑漏洞、边界异常与语法错误"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"小规模测试验证，运行代码、模拟场景看实际执行效果"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"交叉比对参考，结合自身经验、官方文档多方佐证"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"甄别常识与专业误区，对非常规结论重点溯源核查"}]},{"ID":"20260528142536-ckq6wkb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260528142536-ckq6wkb","updated":"20260528153826"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"skills 检索和 rag 检索有什么区别"}]},{"ID":"20260528142559-czfuuo4","Type":"NodeParagraph","Properties":{"id":"20260528142559-czfuuo4","updated":"20260528143457"},"Children":[{"Type":"NodeText","Data":"首先核心定位不同："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"skills 检索偏向"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"指令/能力匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"主要用来查找 Agent 已定义好的工具、函数、预设技能"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"判断当前任务该调用哪项能力，侧重"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"动作与执行"}]},{"ID":"20260528143500-8a3ze90","Type":"NodeParagraph","Properties":{"id":"20260528143500-8a3ze90","updated":"20260528143545"},"Children":[{"Type":"NodeText","Data":"而 RAG 检索是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"知识/文档匹配"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"从外部知识库、文档里召回相关文本资料，给大模型补充上下文信息"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"侧重"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"信息与内容"}]},{"ID":"20260528153233-6jw9f5g","Type":"NodeParagraph","Properties":{"id":"20260528153233-6jw9f5g","updated":"20260528153633"},"Children":[{"Type":"NodeText","Data":"其次使用场景不一样："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"遇到需要调用工具、执行具体操作的任务，就用 skills 检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如查天气、调用接口、运行脚本"}]},{"ID":"20260528153638-uw4hshj","Type":"NodeParagraph","Properties":{"id":"20260528153638-uw4hshj","updated":"20260528153702"},"Children":[{"Type":"NodeText","Data":"当模型自身知识不足、需要参考私有资料、历史文档时，就依赖 RAG 检索"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"比如解读内部手册、问答企业专属业务内容"}]},{"ID":"20260528153702-lkppj7i","Type":"NodeParagraph","Properties":{"id":"20260528153702-lkppj7i","updated":"20260528153826"},"Children":[{"Type":"NodeText","Data":"最后工作逻辑也有区别："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"skills 一般是精准匹配固定能力库，规则性、确定性更强"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"RAG 是语义相似度召回，依赖向量检索，侧重语义理解"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"还会搭配切片、重排、Prompt 组装等链路，整体流程更偏向传统检索增强架构"}]},{"ID":"20260528142536-9f6k6qx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260528142536-9f6k6qx","updated":"20260607205755"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"git 分布式版本控制工具"}]},{"ID":"20260607101429-4c6392c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260607101429-4c6392c","updated":"20260607205755"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"目标"}]},{"ID":"20260607102039-dh54aor","Type":"NodeParagraph","Properties":{"id":"20260607102039-dh54aor","updated":"20260607102132"},"Children":[{"Type":"NodeText","Data":"了解 git 基本概念"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能够概述 git 工作流程"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能够使用 git 常用命令"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"熟悉 git 代码托管服务"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"能够使用 idea 操作 git"}]},{"ID":"20260528142536-6rsbj3k","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260528142536-6rsbj3k","updated":"20260608221100"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"概述"}]},{"ID":"20260607205809-68jrio9","Type":"NodeParagraph","Properties":{"id":"20260607205809-68jrio9","updated":"20260607205945"},"Children":[{"Type":"NodeText","Data":"开发中的实际场景:"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"备份、代码还原、协同开发、追溯问题代码的编写人和编写时间"}]},{"ID":"20260528142536-2x2ns14","Type":"NodeParagraph","Properties":{"id":"20260528142536-2x2ns14","updated":"20260607210716"},"Children":[{"Type":"NodeText","Data":"版本控制器的方式："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"集中式版本控制工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"分布式版本控制工具"}]},{"ID":"20260607210716-3yvzfgd","Type":"NodeParagraph","Properties":{"id":"20260607210716-3yvzfgd","updated":"20260607210926"},"Children":[{"Type":"NodeText","Data":"Git"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Git 就是分布式版本控制工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单说：用来记录代码每一次改动、回溯历史、多人协作写代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"平时常用操作："},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"拉取别人代码、本地修改、提交保存、推送到远程仓库，还能建分支做新功能、合并代码"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不怕改乱、丢代码，团队协作全靠它"}]},{"ID":"20260607210927-zq00jxe","Type":"NodeParagraph","Properties":{"id":"20260607210927-zq00jxe","updated":"20260607213108"},"Children":[{"Type":"NodeText","Data":"速度"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"简单的设计"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对非线性开发模式的强力支持(支持成千上万个并行开发的分支)"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"完全分布式"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"有能力高效管理类似 Linux 内核一样的超大规模项目(速度和数据量)"}]},{"ID":"20260607213108-xs9ye0i","Type":"NodeParagraph","Properties":{"id":"20260607213108-xs9ye0i","updated":"20260607213111"},"Children":[{"Type":"NodeText","Data":"git 工作流程图"}]},{"ID":"20260528142537-i0e2pra","Type":"NodeParagraph","Properties":{"id":"20260528142537-i0e2pra","updated":"20260607213344"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"assets/image-20260607213344-wn8o6di.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260521125023-w6w1l0l","Type":"NodeParagraph","Properties":{"id":"20260521125023-w6w1l0l","updated":"20260608220328"},"Children":[{"Type":"NodeText","Data":"Git GUI：Git 提供的图形界面工具"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"Git Bash：Git 提供的命令行工具"}]},{"ID":"20260608220805-7qcrtxi","Type":"NodeParagraph","Properties":{"id":"20260608220805-7qcrtxi","updated":"20260608220850"},"Children":[{"Type":"NodeText","Data":"当安装 Git 后首先要做的事情是设置用户名和 email 地址"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"这是非常重要的，因为每次 Git 提交都会使用该用户信息"}]},{"ID":"20260608221056-9g696kv","Type":"NodeHeading","HeadingLevel":