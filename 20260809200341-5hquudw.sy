" 维护内存索引 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_records"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260809200341-7nusryx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7nusryx","updated":"20260809200341"},"Children":[{"ID":"20260809200341-w5avem7","Type":"NodeParagraph","Properties":{"id":"20260809200341-w5avem7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"并发控制：用户级 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncio.Lock"},{"Type":"NodeText","Data":" 控制同一用户 JSONL 写入，全局锁控制 rebuild。"}]}]},{"ID":"20260809200341-eh18u4c","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-eh18u4c","updated":"20260809200341"},"Children":[{"ID":"20260809200341-l7ol783","Type":"NodeParagraph","Properties":{"id":"20260809200341-l7ol783","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"Web："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"templates/dashboard.html"},{"Type":"NodeText","Data":" 提供看板。"}]}]}]},{"ID":"20260809200341-m8duc8s","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-m8duc8s","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3. 主链路"}]},{"ID":"20260809200341-kkc8y3u","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"dGV4dA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260809200341-kkc8y3u","updated":"20260809200341"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"wxlog_analyze AnalysisArchiveService\n  -\u003e POST /api/report\n  -\u003e server.py report_endpoint\n  -\u003e DataService.append_record\n  -\u003e 写入 data/records/{user}.jsonl\n  -\u003e 更新内存索引\n  -\u003e Web / REST / MCP 查询统计\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260809200341-41hi7mk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-41hi7mk","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4. 简历表述"}]},{"ID":"20260809200341-ybd9u8d","Type":"NodeParagraph","Properties":{"id":"20260809200341-ybd9u8d","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"可以写："}]},{"ID":"20260809200341-e8vigtt","Type":"NodeParagraph","Properties":{"id":"20260809200341-e8vigtt","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"实现企业微信 Crash 分析统计服务 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":"，基于 Starlette + FastMCP 提供 REST、MCP 和 Web 看板能力。服务采用按用户 JSONL 分片 + 内存索引的轻量存储方案，支持分析记录上报、反馈/备注更新、条件筛选、关键词搜索、分类分布、有效率统计、月度趋势和数据重载。针对并发写入设计用户级异步锁和全局 rebuild 锁，保障索引与文件一致性。"}]},{"ID":"20260809200341-gzq1m2z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-gzq1m2z","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5. 项目 Q\u0026A"}]},{"ID":"20260809200341-rl4xtij","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-rl4xtij","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q1：介绍一下 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260809200341-75l1wvr","Type":"NodeParagraph","Properties":{"id":"20260809200341-75l1wvr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-5bhl99q","Type":"NodeParagraph","Properties":{"id":"20260809200341-5bhl99q","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这是 Crash 分析工具链的统计归档服务。"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":" 每完成一次分析，会把分析结果、分类、用户、时间、源文件、反馈等信息上报到这个服务。服务端把记录写入按用户拆分的 JSONL 文件，并构建内存索引。"}]},{"ID":"20260809200341-8lankc6","Type":"NodeParagraph","Properties":{"id":"20260809200341-8lankc6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它提供三类访问方式：REST API 给客户端和看板使用，Web 页面给运营或开发查看统计，MCP tools 给 AI 助手查询记录和统计。"}]},{"ID":"20260809200341-wle5dsi","Type":"NodeParagraph","Properties":{"id":"20260809200341-wle5dsi","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"核心能力包括：分析总量、活跃用户数、helpful/not_helpful 反馈有效率、分类分布、被点踩分类、未分析原因细分、按时间范围筛选、关键词搜索和月度分类趋势。"}]},{"ID":"20260809200341-93vcbc8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-93vcbc8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q2：为什么选择 JSONL，而不是 MySQL 或 SQLite？"}]},{"ID":"20260809200341-li3sjhy","Type":"NodeParagraph","Properties":{"id":"20260809200341-li3sjhy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-158lzkz","Type":"NodeParagraph","Properties":{"id":"20260809200341-158lzkz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这是内部轻量统计服务，数据量和并发都相对可控，重点是部署简单、易查看、易迁移。JSONL 有几个优点："}]},{"ID":"20260809200341-xrwrnwx","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-xrwrnwx","updated":"20260809200341"},"Children":[{"ID":"20260809200341-q57btn3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-q57btn3","updated":"20260809200341"},"Children":[{"ID":"20260809200341-dqazrgm","Type":"NodeParagraph","Properties":{"id":"20260809200341-dqazrgm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"每条记录一行，append 简单，人工排查也方便。"}]}]},{"ID":"20260809200341-0ta4uqw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-0ta4uqw","updated":"20260809200341"},"Children":[{"ID":"20260809200341-sg9jvzj","Type":"NodeParagraph","Properties":{"id":"20260809200341-sg9jvzj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"按用户分片后，文件不会过大，不同用户写不同文件。"}]}]},{"ID":"20260809200341-2jvu9bh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-2jvu9bh","updated":"20260809200341"},"Children":[{"ID":"20260809200341-l53swkz","Type":"NodeParagraph","Properties":{"id":"20260809200341-l53swkz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"服务启动时扫描 JSONL 构建内存索引，查询速度足够。"}]}]},{"ID":"20260809200341-lm98l72","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-lm98l72","updated":"20260809200341"},"Children":[{"ID":"20260809200341-hsiyeap","Type":"NodeParagraph","Properties":{"id":"20260809200341-hsiyeap","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不依赖数据库部署，适合内部工具快速落地。"}]}]}]},{"ID":"20260809200341-tbckm7v","Type":"NodeParagraph","Properties":{"id":"20260809200341-tbckm7v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当然它有边界。如果数据量上升到百万级、需要复杂查询、强事务或多实例部署，就应该迁移到 SQLite/PostgreSQL/MySQL，并建立 schema、索引和迁移机制。"}]},{"ID":"20260809200341-0dvk4nc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-0dvk4nc","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q3：按用户拆 JSONL 有什么好处？"}]},{"ID":"20260809200341-mqyprj0","Type":"NodeParagraph","Properties":{"id":"20260809200341-mqyprj0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-94ualmc","Type":"NodeParagraph","Properties":{"id":"20260809200341-94ualmc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"按用户拆分主要是为了降低写冲突和文件重写成本。"}]},{"ID":"20260809200341-lwc1wru","Type":"NodeParagraph","Properties":{"id":"20260809200341-lwc1wru","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"反馈和备注更新需要修改已有记录。JSONL 不是原地更新友好的格式，所以服务会更新内存记录后重写该用户的 JSONL 文件。如果所有用户都写一个大文件，任何更新都要重写全量文件，成本高且锁粒度大。"}]},{"ID":"20260809200341-3mxvbhf","Type":"NodeParagraph","Properties":{"id":"20260809200341-3mxvbhf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"按用户拆分后，同一用户的记录在一个文件里。不同用户可以并发写不同文件；更新某个用户的反馈时，只重写这个用户文件。配合用户级 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncio.Lock"},{"Type":"NodeText","Data":"，能保证同一用户文件写入串行，不同用户互不阻塞。"}]},{"ID":"20260809200341-p4gg1o4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-p4gg1o4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q4：内存索引怎么设计？"}]},{"ID":"20260809200341-7ibxjyg","Type":"NodeParagraph","Properties":{"id":"20260809200341-7ibxjyg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-um5qh3y","Type":"NodeParagraph","Properties":{"id":"20260809200341-um5qh3y","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DataService"},{"Type":"NodeText","Data":" 启动时扫描 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"data/records/*.jsonl"},{"Type":"NodeText","Data":"，逐行解析 JSON，构建两个主要结构："}]},{"ID":"20260809200341-u5omljl","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-u5omljl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-rw6ow78","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rw6ow78","updated":"20260809200341"},"Children":[{"ID":"20260809200341-4vtrwmi","Type":"NodeParagraph","Properties":{"id":"20260809200341-4vtrwmi","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index: id -\u0026gt; record"},{"Type":"NodeText","Data":"，用于按记录 ID 快速查详情、更新反馈和备注。"}]}]},{"ID":"20260809200341-v8tauww","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-v8tauww","updated":"20260809200341"},"Children":[{"ID":"20260809200341-danzvva","Type":"NodeParagraph","Properties":{"id":"20260809200341-danzvva","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_records: userName -\u0026gt; list[record]"},{"Type":"NodeText","Data":"，用于按用户重写 JSONL 文件。"}]}]}]},{"ID":"20260809200341-hl1egur","Type":"NodeParagraph","Properties":{"id":"20260809200341-hl1egur","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"查询时先从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index.values()"},{"Type":"NodeText","Data":" 取全量记录，再按用户、日期、feedback、classification、vendor 等条件过滤。记录量不大时这样实现简单且足够快。"}]},{"ID":"20260809200341-kkz1tpj","Type":"NodeParagraph","Properties":{"id":"20260809200341-kkz1tpj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果未来数据量变大，可以把常用维度建倒排索引，或者迁移数据库，让数据库承担筛选和排序。"}]},{"ID":"20260809200341-0jxw6xs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-0jxw6xs","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q5：怎么保证并发写入一致性？"}]},{"ID":"20260809200341-zz56z3x","Type":"NodeParagraph","Properties":{"id":"20260809200341-zz56z3x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-lkubuku","Type":"NodeParagraph","Properties":{"id":"20260809200341-lkubuku","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这里有两类锁。"}]},{"ID":"20260809200341-mlqjpq5","Type":"NodeParagraph","Properties":{"id":"20260809200341-mlqjpq5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第一类是用户级锁 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_locks[userName]"},{"Type":"NodeText","Data":"。同一个用户的 append、feedback 更新、remark 更新都在同一把锁下执行，避免两个请求同时重写同一个 JSONL 文件导致覆盖。"}]},{"ID":"20260809200341-bu60qpw","Type":"NodeParagraph","Properties":{"id":"20260809200341-bu60qpw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第二类是全局锁 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_global_lock"},{"Type":"NodeText","Data":"，用于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"rebuild_index"},{"Type":"NodeText","Data":"。当手动删除磁盘文件后，可以调用 refresh 清空内存索引并从磁盘重建。重建期间用全局锁阻止写操作和索引不一致。"}]},{"ID":"20260809200341-f8fak3o","Type":"NodeParagraph","Properties":{"id":"20260809200341-f8fak3o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"另外，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"append_record"},{"Type":"NodeText","Data":" 里还处理了同一个 record_id 的用户迁移场景。如果同一条记录的 userName 变化，会先从旧用户文件中移除，再写入新用户文件，避免重启后旧文件残留覆盖最新索引。"}]},{"ID":"20260809200341-osvcwrf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-osvcwrf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q6：如果同一个记录重复上报怎么办？"}]},{"ID":"20260809200341-158xghg","Type":"NodeParagraph","Properties":{"id":"20260809200341-158xghg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6g143nz","Type":"NodeParagraph","Properties":{"id":"20260809200341-6g143nz","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"append_record"},{"Type":"NodeText","Data":" 会检查 record_id 是否已经存在。"}]},{"ID":"20260809200341-2nqf48y","Type":"NodeParagraph","Properties":{"id":"20260809200341-2nqf48y","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果同一用户重复上报，就更新内存索引，并重写该用户 JSONL 文件，避免同一 id 在文件里出现多条导致重启后加载不一致。"}]},{"ID":"20260809200341-k51f5zx","Type":"NodeParagraph","Properties":{"id":"20260809200341-k51f5zx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果 record_id 已存在但 userName 变了，会先在旧用户锁下移除旧用户文件里的残留，再在新用户锁下写入新记录。这样可以保证内存索引和磁盘文件最终一致。"}]},{"ID":"20260809200341-wop6xip","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-wop6xip","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q7：统计分类为什么要做映射？"}]},{"ID":"20260809200341-h0wacnk","Type":"NodeParagraph","Properties":{"id":"20260809200341-h0wacnk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-afkn0i5","Type":"NodeParagraph","Properties":{"id":"20260809200341-afkn0i5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"分析引擎输出的是技术分类，比如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_hit"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"self_exit"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_not_hit"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"system_oom"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxwork_oom"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 等。但运营或看板需要的是更容易理解的分类，比如“第三方”“企微自身”“系统内存不足”“企微内存溢出”“未分析出结果”。"}]},{"ID":"20260809200341-ynefivm","Type":"NodeParagraph","Properties":{"id":"20260809200341-ynefivm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"所以服务端维护 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"STATS_CLASSIFICATION_MAP"},{"Type":"NodeText","Data":"，把引擎分类映射到运营分类。这样客户端规则可以保持技术表达，看板可以面向业务理解。"}]},{"ID":"20260809200341-hmj5zqp","Type":"NodeParagraph","Properties":{"id":"20260809200341-hmj5zqp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"还有一个细节：如果一条记录里同时有多个分组，要按运营分类去重。并且“企微自身”有兜底性质，如果同一条记录里有更明确的非“企微自身”归因，就会剔除兜底分类，避免统计重复或误导。"}]},{"ID":"20260809200341-zs63adq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zs63adq","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q8：反馈有效率怎么计算？"}]},{"ID":"20260809200341-l1fuvqt","Type":"NodeParagraph","Properties":{"id":"20260809200341-l1fuvqt","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-y765n8t","Type":"NodeParagraph","Properties":{"id":"20260809200341-y765n8t","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"服务统计 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"feedback == helpful"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"feedback == not_helpful"},{"Type":"NodeText","Data":" 的数量。有效率计算为："}]},{"ID":"20260809200341-cs8d003","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"dGV4dA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260809200341-cs8d003","updated":"20260809200341"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"helpful / (helpful + not_helpful) * 100%\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260809200341-5qrc0xa","Type":"NodeParagraph","Properties":{"id":"20260809200341-5qrc0xa","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"没有反馈的记录不参与分母，因为它不能说明分析结果好或不好。这样得到的是“已反馈样本中的有效率”，比较适合衡量规则归因和话术质量。"}]},{"ID":"20260809200341-1d3e52b","Type":"NodeParagraph","Properties":{"id":"20260809200341-1d3e52b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"同时服务还统计每个分类下被点踩的数量，用来定位哪些归因类别最容易出错，比如“未分析出结果”或某类第三方识别不准。"}]},{"ID":"20260809200341-wb9u8u3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-wb9u8u3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q9："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 为什么要单独细分？"}]},{"ID":"20260809200341-hadofb3","Type":"NodeParagraph","Properties":{"id":"20260809200341-hadofb3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-e6pn4h7","Type":"NodeParagraph","Properties":{"id":"20260809200341-e6pn4h7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"“未分析出结果”本身不是一个原因，而是一个结果。它可能来自很多情况：没有可用 crash dump、MCP 服务不可用、预筛失败、CDB 命令失败、证据不足等。"}]},{"ID":"20260809200341-dehykiu","Type":"NodeParagraph","Properties":{"id":"20260809200341-dehykiu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果只统计一个大类，无法指导后续优化。项目里会对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"errorMessage"},{"Type":"NodeText","Data":" 做 breakdown，形成“未分析出结果”的内层细分。这样看板上能看到到底是服务稳定性问题、输入质量问题，还是规则覆盖不足。"}]},{"ID":"20260809200341-tnabhdv","Type":"NodeParagraph","Properties":{"id":"20260809200341-tnabhdv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这对后续迭代很有价值，因为不同原因对应不同优化方向。"}]},{"ID":"20260809200341-di495m1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-di495m1","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q10：REST 和 MCP 同时提供有什么意义？"}]},{"ID":"20260809200341-3frk8ky","Type":"NodeParagraph","Properties":{"id":"20260809200341-3frk8ky","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6774036","Type":"NodeParagraph","Properties":{"id":"20260809200341-6774036","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"REST 面向确定的程序调用，比如客户端上报 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/report"},{"Type":"NodeText","Data":"、看板请求 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/stats"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/records"},{"Type":"NodeText","Data":"。它稳定、通用，适合前后端交互。"}]},{"ID":"20260809200341-ch6zeco","Type":"NodeParagraph","Properties":{"id":"20260809200341-ch6zeco","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"MCP 面向 AI 助手，让 AI 可以通过标准工具查询统计，比如“最近 30 天第三方 crash 占比是多少”“哪些 not_helpful 记录最多”“查一下某个客户单号相关记录”。AI 不需要知道底层 API 细节，只调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"query_stats"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"list_records"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"search_records"},{"Type":"NodeText","Data":" 等工具。"}]},{"ID":"20260809200341-hud4o7i","Type":"NodeParagraph","Properties":{"id":"20260809200341-hud4o7i","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"所以 REST 是系统集成接口，MCP 是智能分析接口，两者复用同一套 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DataService"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260809200341-vur76x4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-vur76x4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q11：这个统计服务的性能瓶颈在哪里？"}]},{"ID":"20260809200341-tp13qlb","Type":"NodeParagraph","Properties":{"id":"20260809200341-tp13qlb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bklz2fg","Type":"NodeParagraph","Properties":{"id":"20260809200341-bklz2fg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前瓶颈主要有三个："}]},{"ID":"20260809200341-vy9thhz","Type":"NodeParagraph","Properties":{"id":"20260809200341-vy9thhz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第一，查询是从内存全量 records 过滤，数据量小没问题，数据大后会变慢。"}]},{"ID":"20260809200341-0eebjcb","Type":"NodeParagraph","Properties":{"id":"20260809200341-0eebjcb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第二，feedback 和 remark 更新需要重写用户 JSONL 文件。如果单个用户记录很多，更新成本会上升。"}]},{"ID":"20260809200341-l3l3khk","Type":"NodeParagraph","Properties":{"id":"20260809200341-l3l3khk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第三，单进程内存索引不适合多实例部署。多实例会有文件并发写和索引不同步问题。"}]},{"ID":"20260809200341-jyui2fe","Type":"NodeParagraph","Properties":{"id":"20260809200341-jyui2fe","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"优化方向是：中短期可以给常用维度建内存索引、限制查询时间范围、做分页；长期应该迁移数据库，比如 SQLite/PostgreSQL，并对 analyzedAt、userName、classification、feedback 建索引。"}]},{"ID":"20260809200341-4b9bez8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-4b9bez8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q12：为什么有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/refresh"},{"Type":"NodeText","Data":"？"}]},{"ID":"20260809200341-and9zen","Type":"NodeParagraph","Properties":{"id":"20260809200341-and9zen","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-n1htb92","Type":"NodeParagraph","Properties":{"id":"20260809200341-n1htb92","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"因为这是内部工具，实际使用时可能会手动删除 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"data/records"},{"Type":"NodeText","Data":" 里的 JSONL 文件做清理。如果不重启服务，内存索引里仍然有旧数据，Web 看板和 API 看到的就和磁盘不一致。"}]},{"ID":"20260809200341-qtfpzhn","Type":"NodeParagraph","Properties":{"id":"20260809200341-qtfpzhn","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/refresh"},{"Type":"NodeText","Data":" 的作用是清空内存索引并重新扫描磁盘 JSONL，做到不重启服务同步状态。实现时用全局锁保护 rebuild，避免重建期间和写操作交错导致数据不一致。"}]},{"ID":"20260809200341-9hd4jnv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9hd4jnv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q13：这个服务有哪些不足？"}]},{"ID":"20260809200341-i7f28xx","Type":"NodeParagraph","Properties":{"id":"20260809200341-i7f28xx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-zk1f9n1","Type":"NodeParagraph","Properties":{"id":"20260809200341-zk1f9n1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"主要是轻量实现的边界："}]},{"ID":"20260809200341-254cjap","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-254cjap","updated":"20260809200341"},"Children":[{"ID":"20260809200341-mq7uphl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-mq7uphl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-afar6rt","Type":"NodeParagraph","Properties":{"id":"20260809200341-afar6rt","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"没有数据库事务，JSONL 更新靠用户级锁和重写文件保证。"}]}]},{"ID":"20260809200341-bkn2aiu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-bkn2aiu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-5oe5ysz","Type":"NodeParagraph","Properties":{"id":"20260809200341-5oe5ysz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"单进程内存索引，不适合多实例横向扩展。"}]}]},{"ID":"20260809200341-vc0pxuu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-vc0pxuu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-8xsca7v","Type":"NodeParagraph","Properties":{"id":"20260809200341-8xsca7v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"查询是内存过滤，数据量大后需要索引或数据库。"}]}]},{"ID":"20260809200341-apz4v9a","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-apz4v9a","updated":"20260809200341"},"Children":[{"ID":"20260809200341-drdeftt","Type":"NodeParagraph","Properties":{"id":"20260809200341-drdeftt","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"schema 主要靠字段约定，缺少版本化 schema 校验。"}]}]},{"ID":"20260809200341-lecymgh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-lecymgh","updated":"20260809200341"},"Children":[{"ID":"20260809200341-btpgfp3","Type":"NodeParagraph","Properties":{"id":"20260809200341-btpgfp3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前 CORS 较宽，内部工具可接受，但生产环境需要鉴权和更严格的访问控制。"}]}]}]},{"ID":"20260809200341-p1z0r55","Type":"NodeParagraph","Properties":{"id":"20260809200341-p1z0r55","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"但在内部实习项目场景下，它换来了部署简单、调试方便、和主分析工具解耦。"}]},{"ID":"20260809200341-l3ytss8","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-l3ytss8","updated":"20260809200341"}},{"ID":"20260809200341-5jy159v","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-5jy159v","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"五、三项目串讲题"}]},{"ID":"20260809200341-ckcqnai","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ckcqnai","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q1：这三个项目之间的关系是什么？"}]},{"ID":"20260809200341-l7f9fcl","Type":"NodeParagraph","Properties":{"id":"20260809200341-l7f9fcl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-a3ds7xb","Type":"NodeParagraph","Properties":{"id":"20260809200341-a3ds7xb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它们组成了一个 Crash 分析闭环。"}]},{"ID":"20260809200341-c6ncrqg","Type":"NodeParagraph","Properties":{"id":"20260809200341-c6ncrqg","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":" 是底层能力层，把 CDB/WinDBG 服务化，解决 dump 上传、CDB session、命令执行和符号管理。"}]},{"ID":"20260809200341-0nf07rx","Type":"NodeParagraph","Properties":{"id":"20260809200341-0nf07rx","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":" 是业务分析层，用 Flutter 做 UI 和流程编排，调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":" 完成 dump 预筛和深度采证，再用本地规则引擎输出归因和话术。"}]},{"ID":"20260809200341-4w5epv0","Type":"NodeParagraph","Properties":{"id":"20260809200341-4w5epv0","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":" 是效果闭环层，接收 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":" 的归档和用户反馈，提供统计、搜索、趋势和看板，也能通过 MCP 被 AI 查询。"}]},{"ID":"20260809200341-jzromvw","Type":"NodeParagraph","Properties":{"id":"20260809200341-jzromvw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"所以完整链路是：调试能力服务化 -\u003e 自动化 crash 分析 -\u003e 分析结果统计反馈 -\u003e 反哺规则优化。"}]},{"ID":"20260809200341-1p63aie","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-1p63aie","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q2：如果面试官问“你的实习项目最大价值是什么”，怎么答？"}]},{"ID":"20260809200341-z5h7wwy","Type":"NodeParagraph","Properties":{"id":"20260809200341-z5h7wwy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ck5oxo9","Type":"NodeParagraph","Properties":{"id":"20260809200341-ck5oxo9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"最大价值是把企业微信 Windows Crash 分析从“依赖人工经验的调试过程”变成“可自动化、可解释、可统计的工具链”。"}]},{"ID":"20260809200341-h9aj7xe","Type":"NodeParagraph","Properties":{"id":"20260809200341-h9aj7xe","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"以前分析 dump 需要人工下载反馈包、本地开 WinDBG、配置符号、跑命令、判断栈、写结论。这个流程门槛高、耗时长、结果也难统计。"}]},{"ID":"20260809200341-ay3hm1u","Type":"NodeParagraph","Properties":{"id":"20260809200341-ay3hm1u","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我做的工具链把 CDB 能力放到服务端，用 MCP 标准化暴露；客户端自动解压反馈包、预筛 dump、深度采证、规则归因；统计服务沉淀每次结果和用户反馈。这样不仅能减少重复人工操作，还能持续观察哪些分类准确、哪些未分析原因最多，为后续规则优化提供数据。"}]},{"ID":"20260809200341-008lo95","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-008lo95","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q3：项目里为什么强调“可解释”？"}]},{"ID":"20260809200341-e9f89pn","Type":"NodeParagraph","Properties":{"id":"20260809200341-e9f89pn","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-lrdwjko","Type":"NodeParagraph","Properties":{"id":"20260809200341-lrdwjko","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"Crash 分析结论会影响客服回复和开发定位，不能只给一个黑盒结论。比如说“第三方导致”必须说明命中了哪个 DLL、路径是什么、异常码是什么、栈里有哪些证据；说“系统 OOM”也要有内存日志或异常码支撑。"}]},{"ID":"20260809200341-dqhtk3d","Type":"NodeParagraph","Properties":{"id":"20260809200341-dqhtk3d","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"所以项目里不是让 LLM 直接生成结论，而是用 CDB 采证、本地规则匹配、evidence list 和话术模板来保证可解释。统计服务也会记录 classification 和 feedback，方便回看某类结论是否可靠。"}]},{"ID":"20260809200341-u2p3w5s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-u2p3w5s","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q4：如果让你继续优化这条工具链，你会做什么？"}]},{"ID":"20260809200341-os062nh","Type":"NodeParagraph","Properties":{"id":"20260809200341-os062nh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-26q4gbb","Type":"NodeParagraph","Properties":{"id":"20260809200341-26q4gbb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会分三层优化。"}]},{"ID":"20260809200341-d6vwex8","Type":"NodeParagraph","Properties":{"id":"20260809200341-d6vwex8","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"底层 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":"：补鉴权、限流、危险命令白名单、磁盘水位清理、session 监控和更细的 CDB 命令超时指标。"}]},{"ID":"20260809200341-1bpgviv","Type":"NodeParagraph","Properties":{"id":"20260809200341-1bpgviv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":"：拆分偏重的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CrashAnalysisManager"},{"Type":"NodeText","Data":"，强化 schema 校验，完善取消模型，比如 Dio CancelToken 和服务端 session cancel；同时补更多规则冲突测试。"}]},{"ID":"20260809200341-1j6hnh6","Type":"NodeParagraph","Properties":{"id":"20260809200341-1j6hnh6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"统计服务 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":"：从 JSONL 逐步迁移到 SQLite 或 PostgreSQL，补 schema version、索引、分页查询优化和多实例部署能力。"}]},{"ID":"20260809200341-xzh724l","Type":"NodeParagraph","Properties":{"id":"20260809200341-xzh724l","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果只能选一个，我会优先做统计闭环和规则回归测试，因为 Crash 归因工具最重要的是持续提升准确率。"}]},{"ID":"20260809200341-eyd9iip","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-eyd9iip","updated":"20260809200341"}},{"ID":"20260809200341-hrwdssn","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-hrwdssn","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"六、高频追问题速记"}]},{"ID":"20260809200341-stq5b9z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-stq5b9z","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"MCP 相关"}]},{"ID":"20260809200341-e5aa4oh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-e5aa4oh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 是什么？你项目里怎么用？"}]},{"ID":"20260809200341-hfukdcj","Type":"NodeParagraph","Properties":{"id":"20260809200341-hfukdcj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"MCP 是 Model Context Protocol，作用是让 AI Agent 用标准协议访问外部工具、资源和上下文。在我的项目里，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":" 把 CDB 调试能力暴露成 MCP tools，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":" 把统计查询暴露成 MCP tools。AI 工具可以直接调用“上传 dump、创建 session、执行命令、查询统计”等能力，不需要为每个客户端写私有适配。"}]},{"ID":"20260809200341-4hp81lq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-4hp81lq","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"MCP 和 Function Calling 有什么区别？"}]},{"ID":"20260809200341-vr5ezmh","Type":"NodeParagraph","Properties":{"id":"20260809200341-vr5ezmh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"Function Calling 更像模型厂商内部的工具调用格式；MCP 更像外部工具服务协议。Function Calling 定义模型如何决定调用哪个函数，MCP 定义工具服务如何被发现、连接和调用。我的项目里 MCP server 提供工具，AI 客户端通过 MCP 连接后再决定调用。"}]},{"ID":"20260809200341-q9avav3","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-q9avav3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"CDB / WinDBG 相关"}]},{"ID":"20260809200341-nuxq3za","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-nuxq3za","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"常用 CDB 命令有哪些？"}]},{"ID":"20260809200341-d4xiy7o","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-d4xiy7o","updated":"20260809200341"},"Children":[{"ID":"20260809200341-j41gtx8","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-j41gtx8","updated":"20260809200341"},"Children":[{"ID":"20260809200341-vcsp341","Type":"NodeParagraph","Properties":{"id":"20260809200341-vcsp341","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".lastevent"},{"Type":"NodeText","Data":"：看最后异常事件。"}]}]},{"ID":"20260809200341-9ifd2ij","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-9ifd2ij","updated":"20260809200341"},"Children":[{"ID":"20260809200341-qhoihit","Type":"NodeParagraph","Properties":{"id":"20260809200341-qhoihit","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".exr -1"},{"Type":"NodeText","Data":"：查看当前异常记录；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".ecxr"},{"Type":"NodeText","Data":"：切换到异常上下文。"}]}]},{"ID":"20260809200341-vk85lav","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-vk85lav","updated":"20260809200341"},"Children":[{"ID":"20260809200341-9c4t38x","Type":"NodeParagraph","Properties":{"id":"20260809200341-9c4t38x","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":"：查看调用栈。"}]}]},{"ID":"20260809200341-2eeb8fg","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-2eeb8fg","updated":"20260809200341"},"Children":[{"ID":"20260809200341-8n3mpof","Type":"NodeParagraph","Properties":{"id":"20260809200341-8n3mpof","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":"：WinDBG 自动分析。"}]}]},{"ID":"20260809200341-t6n8alh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-t6n8alh","updated":"20260809200341"},"Children":[{"ID":"20260809200341-8khnjin","Type":"NodeParagraph","Properties":{"id":"20260809200341-8khnjin","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lmvm \u0026lt;module\u0026gt;"},{"Type":"NodeText","Data":"：查看模块列表和模块详情。"}]}]},{"ID":"20260809200341-q1vhy9t","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-q1vhy9t","updated":"20260809200341"},"Children":[{"ID":"20260809200341-wcluwqx","Type":"NodeParagraph","Properties":{"id":"20260809200341-wcluwqx","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".reload /f"},{"Type":"NodeText","Data":"：强制加载符号。"}]}]}]},{"ID":"20260809200341-d8f8adu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-d8f8adu","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"为什么符号很重要？"}]},{"ID":"20260809200341-qp0ibpp","Type":"NodeParagraph","Properties":{"id":"20260809200341-qp0ibpp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"没有符号时，栈里只能看到地址或不完整模块，无法准确定位函数、源码行和模块路径。Crash 归因尤其依赖模块名、函数名、PDB 匹配情况，所以需要符号路径、PDB 上传和 symstore 缓存。"}]},{"ID":"20260809200341-rwqeshe","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-rwqeshe","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"Flutter / Dart 相关"}]},{"ID":"20260809200341-kmyjvyj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-kmyjvyj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Flutter 客户端怎么避免 UI 卡顿？"}]},{"ID":"20260809200341-7mbrep5","Type":"NodeParagraph","Properties":{"id":"20260809200341-7mbrep5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"耗时 IO/CPU 操作尽量异步化。项目里 zip 解压放到 isolate，HTTP/MCP 调用用 Future，预筛用小并发窗口，UI 通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ChangeNotifier"},{"Type":"NodeText","Data":" 感知状态变化。主 isolate 只负责交互和展示。"}]},{"ID":"20260809200341-hqjemhw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-hqjemhw","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Dart event loop 下共享状态为什么没有加锁？"}]},{"ID":"20260809200341-pk957ol","Type":"NodeParagraph","Properties":{"id":"20260809200341-pk957ol","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"预筛并发用的是多个 Future 在同一个 Dart isolate 的事件循环里调度，不是多个 OS 线程同时写内存。状态更新在事件循环中顺序执行，所以 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"++"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"add"},{"Type":"NodeText","Data":" 不需要线程锁。但如果跨 isolate 共享状态，就不能这样做。"}]},{"ID":"20260809200341-f8imygb","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-f8imygb","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"存储 / 并发相关"}]},{"ID":"20260809200341-m1vmryj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-m1vmryj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"JSONL 更新为什么要重写文件？"}]},{"ID":"20260809200341-x08bxsc","Type":"NodeParagraph","Properties":{"id":"20260809200341-x08bxsc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"JSONL 是 append-friendly，不适合原地修改某一行，因为行长度可能变化。更新 feedback 或 remark 时，服务先改内存记录，再重写对应用户文件。按用户拆分可以降低重写成本。"}]},{"ID":"20260809200341-cw2ib8f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-cw2ib8f","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"如果数据量变大怎么办？"}]},{"ID":"20260809200341-rqgs2z2","Type":"NodeParagraph","Properties":{"id":"20260809200341-rqgs2z2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"迁移到数据库。轻量阶段 JSONL + 内存索引足够；数据量和并发上来后，用 SQLite/PostgreSQL/MySQL，给 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"analyzedAt"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"userName"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"classification"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"feedback"},{"Type":"NodeText","Data":" 建索引，并补 schema migration。"}]},{"ID":"20260809200341-092u4l7","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-092u4l7","updated":"20260809200341"}},{"ID":"20260809200341-c9olgfp","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-c9olgfp","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"七、面试前背诵版"}]},{"ID":"20260809200341-hmv096k","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-hmv096k","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"30 秒版"}]},{"ID":"20260809200341-9g23f6g","Type":"NodeParagraph","Properties":{"id":"20260809200341-9g23f6g","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我在企业微信实习做的是 Crash 分析工具链。底层 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":" 把 WinDBG/CDB 封装成 MCP + REST 服务，支持 dump 上传、SHA1 去重、CDB session 池和命令输出隔离。上层 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":" 是 Flutter 客户端，负责反馈包解压、dump 预筛、MCP 调试服务接入、深度采证、本地规则归因和结果归档。最后 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":" 接收分析记录和用户反馈，提供统计 API、Web 看板和 MCP 查询工具。整体目标是把人工 crash 分析变成可自动化、可解释、可统计的工程流水线。"}]},{"ID":"20260809200341-qyw0jhv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-qyw0jhv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2 分钟版"}]},{"ID":"20260809200341-b244jmy","Type":"NodeParagraph","Properties":{"id":"20260809200341-b244jmy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这套项目可以分成三层。"}]},{"ID":"20260809200341-todzhb3","Type":"NodeParagraph","Properties":{"id":"20260809200341-todzhb3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第一层是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":"，它把 CDB/WinDBG 服务化。客户端通过一次性 token 上传 dump，服务端流式落盘、计算 SHA1 去重，然后创建 CDB 子进程 session。后续命令通过 session 复用执行，并用 marker 和 UUID boundary 隔离输出。因为 CDB 是阻塞命令行工具，所以服务端用 ThreadPoolExecutor 桥接到 ASGI 异步服务，并通过 max_sessions、idle cleanup 和 timeout 做资源保护。"}]},{"ID":"20260809200341-zm7y4wi","Type":"NodeParagraph","Properties":{"id":"20260809200341-zm7y4wi","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第二层是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_analyze"},{"Type":"NodeText","Data":"，它是 Flutter 桌面工具。用户选择反馈包 zip 或 dump 后，客户端会在 isolate 里解压 zip，扫描 dump 和符号文件，用本地 SHA1 去重，再通过 MCP 服务跑 quick triage。预筛默认并发 2、最多保留 5 个 crash 候选。之后按 crash 签名分组，只对代表 dump 做 CDB 深度采证，再交给本地规则引擎归因。内存类 crash 还会反查企业微信日志，补充 OOM 或虚拟地址耗尽证据。最后结果展示到 UI，并本地 JSONL 归档、异步上报统计服务。"}]},{"ID":"20260809200341-qvv32hq","Type":"NodeParagraph","Properties":{"id":"20260809200341-qvv32hq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第三层是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxlog_stats_server"},{"Type":"NodeText","Data":"，它用 Starlette + FastMCP 提供 REST、MCP 和 Web 看板。数据按用户 JSONL 分片，同时维护内存索引，支持记录上报、反馈更新、分类分布、有效率、月度趋势和搜索。它让分析结果形成反馈闭环，后续可以根据 not_helpful 和 unable_to_analyze 的分布优化规则。"}]},{"ID":"20260809200341-wqwzojo","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-wqwzojo","updated":"20260809200341"}},{"ID":"20260809200341-vwhre6j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-vwhre6j","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"八、深挖题库：mcp-windbg"}]},{"ID":"20260809200341-dxs6iqh","Type":"NodeParagraph","Properties":{"id":"20260809200341-dxs6iqh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"下面的问题按照真实面试中的追问顺序整理：先确认你是否理解业务，再确认你是否理解实现，最后考察你能否解释边界和取舍。回答时不要一上来把所有细节全部背出，建议先说结论，面试官继续追问时再展开。"}]},{"ID":"20260809200341-cmm707g","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-cmm707g","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A. 需求、边界与架构"}]},{"ID":"20260809200341-i8ajhv3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-i8ajhv3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q13：这个项目真正解决的痛点是什么？"}]},{"ID":"20260809200341-yiqa6fh","Type":"NodeParagraph","Properties":{"id":"20260809200341-yiqa6fh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-on429ye","Type":"NodeParagraph","Properties":{"id":"20260809200341-on429ye","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"真正的痛点不是“远程执行一条命令”，而是把调试器能力变成上层可以稳定依赖的服务。原流程依赖个人电脑上的 WinDBG、符号配置和人工经验，环境不一致、步骤不可复用、结果难沉淀。项目把 dump 上传、文件去重、符号索引、CDB 会话、命令执行和资源回收统一起来，上层只需要调用稳定接口，就能自动化完成分析。"}]},{"ID":"20260809200341-vp9703r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-vp9703r","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q14：为什么同时提供 MCP、REST 和 Web 三种入口？"}]},{"ID":"20260809200341-3x58mg6","Type":"NodeParagraph","Properties":{"id":"20260809200341-3x58mg6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-53k9j47","Type":"NodeParagraph","Properties":{"id":"20260809200341-53k9j47","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"三种入口面向的使用者不同。MCP 面向 AI Agent，强调工具发现和上下文调用；REST 面向 Flutter 客户端、脚本和测试程序，协议简单、依赖少；Web 页面面向人工排查，适合临时执行命令和观察原始输出。三种入口最终都进入同一套 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FileManager"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SessionManager"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CDBSession"},{"Type":"NodeText","Data":"，避免不同入口产生不同的业务语义。"}]},{"ID":"20260809200341-rxwk9mi","Type":"NodeParagraph","Properties":{"id":"20260809200341-rxwk9mi","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"追问补充：如果未来入口增加，我会继续保持协议层薄、核心服务层稳定，并给每个接口定义统一错误码和超时语义。"}]},{"ID":"20260809200341-uz154sy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-uz154sy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q15：为什么没有把 CDB 能力直接做成一个普通 HTTP 命令执行接口？"}]},{"ID":"20260809200341-i6d960b","Type":"NodeParagraph","Properties":{"id":"20260809200341-i6d960b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-jv57irm","Type":"NodeParagraph","Properties":{"id":"20260809200341-jv57irm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"普通 HTTP 接口只能表达请求和响应，不能很好描述工具能力、资源和长生命周期 session。MCP 能把“上传 dump、创建调试会话、执行命令、关闭会话”表达成可发现的工具集合，更适合 Agent 按步骤规划。HTTP 仍然保留，因为客户端和脚本不一定支持 MCP。两者是接入协议的互补，不是二选一。"}]},{"ID":"20260809200341-9nqfetz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9nqfetz","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q16：这个服务的核心资源有哪些？生命周期怎么定义？"}]},{"ID":"20260809200341-m30keef","Type":"NodeParagraph","Properties":{"id":"20260809200341-m30keef","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-xlni3nk","Type":"NodeParagraph","Properties":{"id":"20260809200341-xlni3nk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"核心资源有上传 token、落盘文件、符号目录和 CDB session。上传 token 创建后只允许使用一次，成功或失败后都应失效；文件落盘后可以因 SHA1 命中而复用；符号索引属于缓存和基础设施资源；session 从创建开始占用 CDB 子进程，显式关闭、空闲超时或服务回收时释放。把资源生命周期说清楚，才能判断异常路径是否泄漏。"}]},{"ID":"20260809200341-q5nxork","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-q5nxork","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q17：为什么把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FileManager"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SessionManager"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CDBSession"},{"Type":"NodeText","Data":" 分开？"}]},{"ID":"20260809200341-1cb30xr","Type":"NodeParagraph","Properties":{"id":"20260809200341-1cb30xr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-o4vvp7x","Type":"NodeParagraph","Properties":{"id":"20260809200341-o4vvp7x","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FileManager"},{"Type":"NodeText","Data":" 关心文件身份、目录和符号索引；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SessionManager"},{"Type":"NodeText","Data":" 关心 session 数量、查找、关闭和清理；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CDBSession"},{"Type":"NodeText","Data":" 只负责一个 CDB 子进程的读写交互。三者分离后，文件去重策略变化不会影响命令读取逻辑，session 池策略变化也不会侵入 CDB 协议细节。这个边界还便于分别做单元测试和故障定位。"}]},{"ID":"20260809200341-7hlvnvz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-7hlvnvz","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q18：如果只给你一天时间做 MVP，你会保留哪些能力？"}]},{"ID":"20260809200341-7acw9hj","Type":"NodeParagraph","Properties":{"id":"20260809200341-7acw9hj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-p3nnmui","Type":"NodeParagraph","Properties":{"id":"20260809200341-p3nnmui","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会先保留单文件上传、创建 session、执行有限的只读 CDB 命令、返回结果和关闭 session，先打通一条可验证链路。PDB 自动索引、Web 页面、复杂统计和多种入口可以后置。MVP 的验收标准不是接口数量，而是同一个 dump 能稳定得到异常码、栈和模块信息，并且 session 在成功和失败后都能释放。"}]},{"ID":"20260809200341-3i274ek","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3i274ek","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q19：如果面试官质疑“这只是把命令行包了一层”，怎么回答？"}]},{"ID":"20260809200341-g8m2bsl","Type":"NodeParagraph","Properties":{"id":"20260809200341-g8m2bsl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-02924ij","Type":"NodeParagraph","Properties":{"id":"20260809200341-02924ij","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会承认底层执行器确实是 CDB，但工程价值在于围绕它补齐了服务化缺失的能力：大文件流式传输、一次性上传凭证、内容去重、符号管理、交互式 session、命令边界识别、异步线程隔离、超时、并发上限和空闲回收。没有这些能力，命令行只能在开发者本机使用，无法成为上层自动化流水线的可靠依赖。"}]},{"ID":"20260809200341-3e1uq5z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-3e1uq5z","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B. CDB 子进程与输出协议"}]},{"ID":"20260809200341-od49i6q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-od49i6q","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q20：CDB session 启动时需要解决哪些问题？"}]},{"ID":"20260809200341-6hxjp9z","Type":"NodeParagraph","Properties":{"id":"20260809200341-6hxjp9z","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-8lsujvw","Type":"NodeParagraph","Properties":{"id":"20260809200341-8lsujvw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"首先要确认 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cdb.exe"},{"Type":"NodeText","Data":" 路径和 dump 路径有效，其次要设置正确的工作目录、标准输入输出管道和必要的启动参数。启动后不能只看进程是否创建成功，还要等待 CDB 进入可接受命令的状态，并处理启动错误、符号加载提示和异常退出。最后要把进程句柄、读写流、创建时间和最近使用时间纳入 session 状态，供管理器回收。"}]},{"ID":"20260809200341-kc57doq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-kc57doq","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q21：为什么不能直接 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"read()"},{"Type":"NodeText","Data":" 到 EOF 来判断命令结束？"}]},{"ID":"20260809200341-nxoazhj","Type":"NodeParagraph","Properties":{"id":"20260809200341-nxoazhj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-8155flx","Type":"NodeParagraph","Properties":{"id":"20260809200341-8155flx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"交互式 CDB session 不会在每条命令后关闭标准输出，因此正常情况下没有 EOF。若把 EOF 当成命令结束，程序会一直等待；若强行关闭进程，又失去了 session 复用。项目采用写入唯一 marker，再读取输出直到 marker 出现，用应用层协议补足了子进程没有提供的消息边界。"}]},{"ID":"20260809200341-b9o0m0j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-b9o0m0j","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q22：marker 方案可能有什么风险？"}]},{"ID":"20260809200341-ie5hgod","Type":"NodeParagraph","Properties":{"id":"20260809200341-ie5hgod","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-tjnm8z9","Type":"NodeParagraph","Properties":{"id":"20260809200341-tjnm8z9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"marker 可能因为命令异常、CDB 崩溃、输出缓冲或读取超时而迟迟不出现，也可能被命令本身输出相同文本造成误判。因此 marker 必须足够随机，读取要有超时和最大输出限制，超时后要检查进程状态并关闭或重建 session。项目中进一步使用 UUID boundary marker，降低普通文本碰撞的概率，并把命令失败和 session 失效区分开。"}]},{"ID":"20260809200341-fngkn4b","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-fngkn4b","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q23：为什么既需要结束 marker，又需要 UUID boundary marker？"}]},{"ID":"20260809200341-moeqeat","Type":"NodeParagraph","Properties":{"id":"20260809200341-moeqeat","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-3b91ou4","Type":"NodeParagraph","Properties":{"id":"20260809200341-3b91ou4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"结束 marker 解决“这次命令在哪里结束”，boundary marker 解决“这次命令从哪里开始”。如果 CDB 还有上一次命令残留输出，只依赖结束标记可能把旧输出误认为本次结果。开始和结束都带上同一条 UUID 边界后，可以截取明确区间，再剥离提示符和控制信息，返回给上层更干净的结果。"}]},{"ID":"20260809200341-2luv2cs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2luv2cs","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q24：命令执行期间并发调用同一个 session 会发生什么？"}]},{"ID":"20260809200341-b14vrun","Type":"NodeParagraph","Properties":{"id":"20260809200341-b14vrun","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-v2cphoc","Type":"NodeParagraph","Properties":{"id":"20260809200341-v2cphoc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"同一个 CDB 的标准输入输出是有序字节流，两个命令并发写入会交错，返回结果也无法对应到调用方。因此单个 session 必须串行化命令执行，可以在 session 内增加异步锁或把命令放入专属队列。不同 dump 的 session 可以并行，但同一个 dump 的命令序列必须保持顺序。"}]},{"ID":"20260809200341-tddefif","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-tddefif","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q25：如何区分 CDB 命令失败、CDB 进程崩溃和网络超时？"}]},{"ID":"20260809200341-dhxyxkf","Type":"NodeParagraph","Properties":{"id":"20260809200341-dhxyxkf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-c0wi9sk","Type":"NodeParagraph","Properties":{"id":"20260809200341-c0wi9sk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会从三层判断：网络层只负责请求是否按时返回；session 层检查子进程是否仍存活、是否有退出码；命令层分析输出中是否包含明确错误。网络超时不等于 CDB 崩溃，命令输出错误也不一定意味着 session 不可复用。错误对象应携带 error type、命令、session id、是否可重试和建议动作，方便客户端做精确降级。"}]},{"ID":"20260809200341-i8jg3sm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-i8jg3sm","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q26：CDB 输出很大时怎么避免内存被打爆？"}]},{"ID":"20260809200341-1sleleb","Type":"NodeParagraph","Properties":{"id":"20260809200341-1sleleb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-yi91qz0","Type":"NodeParagraph","Properties":{"id":"20260809200341-yi91qz0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"读取时应使用分块或逐行消费，并设置单条命令的最大输出字节数。超过上限时保留前后关键片段，同时返回 truncated 标记，而不是无限拼接字符串。对于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 这种可能很大的命令，还可以拆成多个目标明确的命令，例如异常上下文、栈、模块列表分别采集。"}]},{"ID":"20260809200341-cw2fj8i","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-cw2fj8i","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q27：为什么 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 不能作为所有问题的唯一命令？"}]},{"ID":"20260809200341-prsi4m5","Type":"NodeParagraph","Properties":{"id":"20260809200341-prsi4m5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-thcna6r","Type":"NodeParagraph","Properties":{"id":"20260809200341-thcna6r","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它信息量大，但执行时间、符号依赖和输出噪声也更高。自动化场景应该先用低成本命令做预筛，再根据异常类型采集 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".ecxr"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lmvm"},{"Type":"NodeText","Data":" 等证据，最后把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 作为深度补充。这样既能控制平均耗时，也能让规则引擎消费结构更稳定的字段。"}]},{"ID":"20260809200341-hjvezqw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-hjvezqw","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q28：如何处理 CDB 卡死但进程仍然存在？"}]},{"ID":"20260809200341-ukm5yc7","Type":"NodeParagraph","Properties":{"id":"20260809200341-ukm5yc7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-pw1vzyz","Type":"NodeParagraph","Properties":{"id":"20260809200341-pw1vzyz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能只依赖进程存活判断。每次命令都设置 deadline，超时后先停止等待，再尝试终止当前 session；如果无法确认 CDB 是否仍能接收下一条命令，就把 session 标记为 broken 并释放。对自动化调用来说，牺牲一个 session 比把不确定状态继续复用更安全，后续可以重新创建 session 重试。"}]},{"ID":"20260809200341-b5ogy2q","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-b5ogy2q","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q29：session 复用会不会造成上一次分析污染下一次分析？"}]},{"ID":"20260809200341-6albs4y","Type":"NodeParagraph","Properties":{"id":"20260809200341-6albs4y","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-p3gl2mk","Type":"NodeParagraph","Properties":{"id":"20260809200341-p3gl2mk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"一个 session 创建时绑定一个 dump，不能跨 dump 复用。跨命令污染主要来自当前进程上下文、符号状态和输出残留，所以需要明确的开始边界、命令串行化以及 session 失效重建策略。对于需要改变上下文的命令，应该把上下文变化记录到 session 状态，或者在关键命令前执行显式初始化。"}]},{"ID":"20260809200341-zlzhufu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-zlzhufu","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C. 上传、文件和符号"}]},{"ID":"20260809200341-q7j0vbs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-q7j0vbs","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q30：一次性 upload token 的作用是什么？"}]},{"ID":"20260809200341-zx82vwe","Type":"NodeParagraph","Properties":{"id":"20260809200341-zx82vwe","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-uo356s2","Type":"NodeParagraph","Properties":{"id":"20260809200341-uo356s2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它把“申请上传”和“真正上传”拆成两步，同时避免客户端直接猜测文件存储路径。token 应当随机、短时有效、绑定预期用户或请求，并在成功、失败或超时后失效。服务端根据 token 映射到受控临时目录，最终文件名由服务端生成，不能直接信任用户传入的路径。"}]},{"ID":"20260809200341-kjl6k89","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-kjl6k89","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q31：流式上传和一次性读入内存的区别是什么？"}]},{"ID":"20260809200341-zdr0l0x","Type":"NodeParagraph","Properties":{"id":"20260809200341-zdr0l0x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-23lfuwp","Type":"NodeParagraph","Properties":{"id":"20260809200341-23lfuwp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"dump 可能很大，一次性读入内存会让并发上传的内存占用随文件大小线性增长。流式上传按块读取、写入和计算 SHA1，内存只保留固定大小的 buffer，峰值更可控。代价是错误恢复和临时文件清理要更仔细，需要在中断、磁盘不足和校验失败时删除未完成文件。"}]},{"ID":"20260809200341-fy9zb2r","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-fy9zb2r","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q32：如何防止路径穿越和任意文件覆盖？"}]},{"ID":"20260809200341-elnho5b","Type":"NodeParagraph","Properties":{"id":"20260809200341-elnho5b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-xs1kj0l","Type":"NodeParagraph","Properties":{"id":"20260809200341-xs1kj0l","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"用户提供的文件名只能作为展示信息，不能直接拼接成服务端路径。服务端应使用固定根目录、规范化路径后检查仍位于根目录内，并用服务端生成的 UUID 或内容哈希作为实际文件名。写入采用临时文件加原子 rename，避免上传中断留下一个看起来完整的目标文件。"}]},{"ID":"20260809200341-uskgzdn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-uskgzdn","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q33：SHA1 去重的完整流程是什么？"}]},{"ID":"20260809200341-zo16dvb","Type":"NodeParagraph","Properties":{"id":"20260809200341-zo16dvb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-8zk5pgf","Type":"NodeParagraph","Properties":{"id":"20260809200341-8zk5pgf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"上传过程中增量计算 SHA1，完成后以 hash 查询索引。命中时返回已有文件标识，不再重复写入；未命中时把临时文件移动到以 hash 管理的目录，并登记大小、路径和时间。并发上传同一文件时，最终落盘动作必须具备幂等性，不能因为两个请求同时判断未命中而留下两个互相覆盖的结果。"}]},{"ID":"20260809200341-11vw6lj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-11vw6lj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q34：重复上传的两个请求同时到达，怎么避免竞态？"}]},{"ID":"20260809200341-nyzxqks","Type":"NodeParagraph","Properties":{"id":"20260809200341-nyzxqks","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-si7slh6","Type":"NodeParagraph","Properties":{"id":"20260809200341-si7slh6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"可以按 hash 加锁，也可以使用独占创建或原子 rename，让只有一个请求成为最终拥有者。另一个请求发现目标已经存在后，校验文件状态并复用它。锁的粒度不宜扩大到整个上传服务，否则不同文件之间会互相阻塞；更实际的做法是对最终身份做细粒度同步。"}]},{"ID":"20260809200341-qv8ifwp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-qv8ifwp","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q35：为什么 PDB 管理不能只保存文件名？"}]},{"ID":"20260809200341-ovd3iib","Type":"NodeParagraph","Properties":{"id":"20260809200341-ovd3iib","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ni5lyqk","Type":"NodeParagraph","Properties":{"id":"20260809200341-ni5lyqk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不同构建版本可能有相同的 PDB 文件名，但符号是否匹配取决于 GUID、Age 和对应模块版本。只按文件名会把错误符号加载到 dump 上，得到看似合理但实际错误的函数名和栈。符号索引应保存内容身份和调试标识，并在加载时优先使用精确匹配，找不到时明确告诉上层符号缺失。"}]},{"ID":"20260809200341-05ath1o","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-05ath1o","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q36：符号加载慢时怎么优化？"}]},{"ID":"20260809200341-mm7x3gu","Type":"NodeParagraph","Properties":{"id":"20260809200341-mm7x3gu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-sqm49ch","Type":"NodeParagraph","Properties":{"id":"20260809200341-sqm49ch","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"首先缓存已经索引过的 PDB，避免重复扫描；其次把符号准备和命令执行分开，预先完成常用版本的索引；再次对只需要模块名和地址的 quick triage 不强制加载全部符号。对于远程符号服务器，还要设置超时和失败缓存，避免每个 session 重复等待同一个不可用源。"}]},{"ID":"20260809200341-4un6g79","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-4un6g79","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q37：如果 dump 能打开但栈没有符号，结果还能用吗？"}]},{"ID":"20260809200341-a99wl28","Type":"NodeParagraph","Properties":{"id":"20260809200341-a99wl28","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-2d893f0","Type":"NodeParagraph","Properties":{"id":"20260809200341-2d893f0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"能用，但结论置信度需要下降。异常码、异常地址、模块列表、原始地址栈仍然可以作为证据，模块归属也可能帮助规则判断。输出中应明确区分“分析失败”和“符号不完整”，并保留已采集证据，避免因为缺一个 PDB 就丢失整份结果。"}]},{"ID":"20260809200341-5zckvfg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-5zckvfg","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D. 并发、资源和可靠性"}]},{"ID":"20260809200341-h9xe29p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-h9xe29p","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q38："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"max_sessions"},{"Type":"NodeText","Data":" 应该怎么确定？"}]},{"ID":"20260809200341-gt0nxsw","Type":"NodeParagraph","Properties":{"id":"20260809200341-gt0nxsw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-2nresu5","Type":"NodeParagraph","Properties":{"id":"20260809200341-2nresu5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它不是越大越好，而是由机器 CPU、内存、磁盘 IO、CDB 平均占用和业务并发共同决定。可以先压测单 session 资源曲线，再设置保守上限，并观察排队时间、超时率和内存水位。实际运行中还要给系统和 Web 请求留余量，不能把所有 CPU 都分给 CDB。"}]},{"ID":"20260809200341-38lstov","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-38lstov","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q39：空闲 session 清理为什么不能只靠客户端主动 close？"}]},{"ID":"20260809200341-g2ct8lx","Type":"NodeParagraph","Properties":{"id":"20260809200341-g2ct8lx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-vbo5f2u","Type":"NodeParagraph","Properties":{"id":"20260809200341-vbo5f2u","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端可能崩溃、断网或被强制关闭，服务端收不到 close 请求。只依赖主动释放会导致 CDB 进程和文件句柄泄漏，最终把服务拖垮。服务端需要记录 last_used，后台定期扫描空闲 session，并在 close 时保证幂等，主动关闭和超时清理可以共存。"}]},{"ID":"20260809200341-k7k08um","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-k7k08um","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q40：清理任务和执行命令同时操作一个 session 怎么办？"}]},{"ID":"20260809200341-t5z7o6n","Type":"NodeParagraph","Properties":{"id":"20260809200341-t5z7o6n","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-xx170h0","Type":"NodeParagraph","Properties":{"id":"20260809200341-xx170h0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"清理前必须获得 session 状态锁，再把状态从 active 变成 closing；命令入口拿不到 active 状态就拒绝或重试。清理不能只从字典里删除引用，因为底层进程可能还在运行。最终要确保状态表、进程句柄和线程任务三者都完成收敛。"}]},{"ID":"20260809200341-2czp97m","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2czp97m","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q41：服务重启后原来的 session 怎么办？"}]},{"ID":"20260809200341-xwrtvao","Type":"NodeParagraph","Properties":{"id":"20260809200341-xwrtvao","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-kzgh0mn","Type":"NodeParagraph","Properties":{"id":"20260809200341-kzgh0mn","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"session 是进程内资源，服务重启后不应该假设它还能恢复。客户端需要把 session 当作短生命周期句柄，遇到服务重启后重新创建；服务端启动时清理遗留临时目录和孤儿 CDB 进程。真正需要跨重启恢复的是 dump 文件和分析记录，而不是交互式调试进程。"}]},{"ID":"20260809200341-l3547qj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-l3547qj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q42：多用户同时分析时，如何隔离数据？"}]},{"ID":"20260809200341-4oynsiy","Type":"NodeParagraph","Properties":{"id":"20260809200341-4oynsiy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-0jh7ev5","Type":"NodeParagraph","Properties":{"id":"20260809200341-0jh7ev5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"每个上传请求生成独立 token 和临时目录，session 显式绑定文件身份，返回结果时只允许持有对应 session id 的调用者访问。服务端不能把用户输入直接当作路径或 session key。生产化还要补充鉴权、用户级配额、审计日志和危险命令限制，内部工具也不能把隔离完全寄托在前端。"}]},{"ID":"20260809200341-v1t4xil","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-v1t4xil","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q43：如何设计服务的可观测性？"}]},{"ID":"20260809200341-lt21pzb","Type":"NodeParagraph","Properties":{"id":"20260809200341-lt21pzb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-wtpu3q1","Type":"NodeParagraph","Properties":{"id":"20260809200341-wtpu3q1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"至少记录 request id、user、file hash、session id、命令名、耗时、输出大小、退出原因和错误类型。指标上关注上传成功率、去重命中率、CDB 命令 P50/P95、session 数量、空闲清理数、超时率和磁盘使用率。日志中避免直接打印 dump 内容和敏感路径，调试细节用受控级别输出。"}]},{"ID":"20260809200341-mc24sl3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-mc24sl3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q44：服务出现内存持续上涨，你怎么排查？"}]},{"ID":"20260809200341-renq9ky","Type":"NodeParagraph","Properties":{"id":"20260809200341-renq9ky","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6sxc9vc","Type":"NodeParagraph","Properties":{"id":"20260809200341-6sxc9vc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会先区分 Python 进程内存、CDB 子进程内存和文件缓存。然后按时间关联上传大小、并发 session、命令输出长度和清理事件，观察是否存在未关闭 session、输出字符串长期保留或任务引用未释放。验证时用固定大小 dump 做阶梯压测，分别关闭上传、session、深度命令，逐段缩小增长来源。"}]},{"ID":"20260809200341-ai0tvvc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ai0tvvc","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q45：如果磁盘满了，服务应该怎么表现？"}]},{"ID":"20260809200341-c4p8kzx","Type":"NodeParagraph","Properties":{"id":"20260809200341-c4p8kzx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-7h9uhtw","Type":"NodeParagraph","Properties":{"id":"20260809200341-7h9uhtw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"上传前可以检查剩余空间和单用户配额，写入时捕获磁盘不足并删除临时文件。服务应返回明确的资源不足错误，而不是返回一个成功但不可用的文件 id。长期方案包括按 hash 清理重复文件、按保留策略删除旧缓存、设置磁盘水位告警，并把“数据归档”和“临时 dump 缓存”分开管理。"}]},{"ID":"20260809200341-q6xtaf8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-q6xtaf8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q46：你会允许客户端执行任意 CDB 命令吗？"}]},{"ID":"20260809200341-tdxw7ns","Type":"NodeParagraph","Properties":{"id":"20260809200341-tdxw7ns","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-1ylqb7u","Type":"NodeParagraph","Properties":{"id":"20260809200341-1ylqb7u","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"开发调试阶段可以开放，但面向多人和自动化 Agent 时不应无条件开放。应区分只读分析命令和可能修改进程状态、加载外部内容或触发高耗时操作的命令，采用白名单、超时、输出上限和审计。MCP 的工具描述也应该明确参数范围，避免 Agent 把 shell 命令当成普通分析命令。"}]},{"ID":"20260809200341-l9qi00f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-l9qi00f","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q47：如何做这个服务的测试？"}]},{"ID":"20260809200341-di8ra3o","Type":"NodeParagraph","Properties":{"id":"20260809200341-di8ra3o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-r1k5q1c","Type":"NodeParagraph","Properties":{"id":"20260809200341-r1k5q1c","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"核心逻辑可以用假的 CDB runner 测试 marker、超时、异常退出和输出截断；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FileManager"},{"Type":"NodeText","Data":" 测试 hash 去重、重复并发、路径校验和临时文件清理；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SessionManager"},{"Type":"NodeText","Data":" 测试上限、空闲回收和 close 幂等。最后用真实 CDB 和小型样例 dump 做少量集成测试，验证协议、符号和进程行为。"}]},{"ID":"20260809200341-nslpz59","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-nslpz59","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q48：如果重新设计，你会如何改造 session 接口？"}]},{"ID":"20260809200341-qup0yfk","Type":"NodeParagraph","Properties":{"id":"20260809200341-qup0yfk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-d3ajfmk","Type":"NodeParagraph","Properties":{"id":"20260809200341-d3ajfmk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会把 session 操作抽象成明确的状态机：creating、ready、busy、closing、closed、broken。命令接口返回结构化的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CommandResult"},{"Type":"NodeText","Data":"，包含 stdout、stderr、duration、timed_out、truncated 和 session_state，而不是只返回字符串。这样客户端可以根据状态决定重试或重建，服务端也更容易做指标和故障定位。"}]},{"ID":"20260809200341-h16gfmf","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-h16gfmf","updated":"20260809200341"}},{"ID":"20260809200341-ccrxc3d","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-ccrxc3d","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"九、深挖题库：wxlog_analyze"}]},{"ID":"20260809200341-mc9jk2y","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-mc9jk2y","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A. Flutter 客户端与任务编排"}]},{"ID":"20260809200341-47ahjx3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-47ahjx3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q16：为什么这个项目适合做成桌面 Flutter 工具？"}]},{"ID":"20260809200341-x5en4a9","Type":"NodeParagraph","Properties":{"id":"20260809200341-x5en4a9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-zpdx67f","Type":"NodeParagraph","Properties":{"id":"20260809200341-zpdx67f","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"使用者需要选择本地反馈包、观察长任务进度、查看原始证据和复制分析结论，桌面端比纯命令行更适合内部排障。Flutter 提供统一 UI 和状态管理能力，Dart 的异步模型也适合编排上传、轮询和多阶段分析。核心 CDB 能力放在远程服务，客户端只承担输入、交互和流程编排，降低桌面环境依赖。"}]},{"ID":"20260809200341-wm59bmb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-wm59bmb","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q17："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CrashAnalysisManager"},{"Type":"NodeText","Data":" 为什么要作为 UI 和业务之间的门面？"}]},{"ID":"20260809200341-1n0s7fa","Type":"NodeParagraph","Properties":{"id":"20260809200341-1n0s7fa","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-lxciijc","Type":"NodeParagraph","Properties":{"id":"20260809200341-lxciijc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"UI 只需要知道当前状态、进度、错误和最终结果，不应该直接处理 zip、HTTP、MCP 和 session 清理。Manager 通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ChangeNotifier"},{"Type":"NodeText","Data":" 对外暴露稳定状态，把复杂流程封装起来，界面只订阅变化。它的缺点是容易变成“大类”，所以后续应把扫描、预筛、深度分析和归档拆成服务，Manager 只做状态编排。"}]},{"ID":"20260809200341-3yfblec","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3yfblec","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q18：Flutter 中哪些任务必须放到后台 isolate？"}]},{"ID":"20260809200341-rfrcjyl","Type":"NodeParagraph","Properties":{"id":"20260809200341-rfrcjyl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-iwntmur","Type":"NodeParagraph","Properties":{"id":"20260809200341-iwntmur","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"判断标准不是“是否异步”，而是是否会在当前 isolate 上持续占用 CPU 或进行大量同步 IO。Future 只是异步等待，不能自动把 CPU 密集工作移出 UI isolate；大 zip 解压、批量校验和复杂文本扫描更适合放到 isolate。网络请求本身通常由异步 IO 处理，但返回数据后的大规模解析也要评估是否需要隔离。"}]},{"ID":"20260809200341-4ttxphs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-4ttxphs","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q19：为什么不能把整个分析流程都放进一个 isolate？"}]},{"ID":"20260809200341-vjzqb1p","Type":"NodeParagraph","Properties":{"id":"20260809200341-vjzqb1p","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ih8ahuj","Type":"NodeParagraph","Properties":{"id":"20260809200341-ih8ahuj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"网络客户端、UI 状态通知和部分插件对象不能简单跨 isolate 传递，整个流程搬走会增加通信和生命周期复杂度。更合理的是只把纯计算、纯数据输入输出的重任务放入 isolate，例如解压和哈希；MCP 请求由主流程异步等待，结果再更新状态。隔离边界应以可序列化数据为准，而不是为了“后台”而整体搬迁。"}]},{"ID":"20260809200341-371i0hh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-371i0hh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q20：如何设计分析任务的状态机？"}]},{"ID":"20260809200341-n35uyrw","Type":"NodeParagraph","Properties":{"id":"20260809200341-n35uyrw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bjab91b","Type":"NodeParagraph","Properties":{"id":"20260809200341-bjab91b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会定义 idle、scanning、prefiltering、collecting、classifying、archiving、completed、failed、cancelled 等状态，并规定合法迁移。每个状态携带阶段进度、当前文件、已完成数量和可展示错误；新任务启动前取消或拒绝旧任务，避免旧 Future 回写新任务的 UI。状态机比多个布尔变量更能避免“loading=false 但分析仍在运行”这类矛盾状态。"}]},{"ID":"20260809200341-nmi0gck","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-nmi0gck","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q21：用户在分析过程中点击取消，应该取消哪些东西？"}]},{"ID":"20260809200341-swq57ow","Type":"NodeParagraph","Properties":{"id":"20260809200341-swq57ow","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-96mbp40","Type":"NodeParagraph","Properties":{"id":"20260809200341-96mbp40","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"取消至少分三层：停止本地扫描和排队任务；取消尚未完成的 HTTP 上传或请求；通知服务端关闭已创建的 CDB session。取消不是简单忽略 Future 结果，因为服务端资源可能继续占用。所有 finally 都必须执行清理，返回结果时还要检查 task id，防止已取消任务覆盖 UI。"}]},{"ID":"20260809200341-k853ah0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-k853ah0","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q22：为什么批量预筛不能简单 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Future.wait"},{"Type":"NodeText","Data":" 全部任务？"}]},{"ID":"20260809200341-9yhyb0l","Type":"NodeParagraph","Properties":{"id":"20260809200341-9yhyb0l","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-1wpow4p","Type":"NodeParagraph","Properties":{"id":"20260809200341-1wpow4p","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Future.wait"},{"Type":"NodeText","Data":" 会同时发起所有上传和 session 创建，任务数量一多就会放大客户端、网络和服务端压力，且难以实现候选上限和及时取消。项目用并发窗口控制同时运行的数量，完成一个再补下一个；遇到候选已满，可以停止继续创建重资源 session。窗口调度还可以记录每个文件的独立失败原因，不让一个异常终止全部任务。"}]},{"ID":"20260809200341-xx2cpbf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-xx2cpbf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q23：并发度 2 是固定真理吗？"}]},{"ID":"20260809200341-aynyvia","Type":"NodeParagraph","Properties":{"id":"20260809200341-aynyvia","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-khysvid","Type":"NodeParagraph","Properties":{"id":"20260809200341-khysvid","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不是，它是当前资源和交互体验下的保守默认值。并发度应由服务端 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"max_sessions"},{"Type":"NodeText","Data":"、文件大小、网络带宽和 CDB 平均耗时共同决定。更完善的方案是服务端返回容量或排队信息，客户端根据失败率和耗时动态调整，但动态调节也要设置上下界，避免抖动。"}]},{"ID":"20260809200341-6k8loz6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-6k8loz6","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q24：为什么候选最多 5 个，而不是分析全部 dump？"}]},{"ID":"20260809200341-rz1b0zc","Type":"NodeParagraph","Properties":{"id":"20260809200341-rz1b0zc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-fe0cxy6","Type":"NodeParagraph","Properties":{"id":"20260809200341-fe0cxy6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"反馈包中可能包含历史 dump、重复 dump、手动 dump 和不同时间点的文件。全部做深度 CDB 分析成本高，结果也会淹没真正的问题。先用低成本 quick triage 筛选，再按签名分组，只对有代表性的候选深入分析，可以把时间花在高信息量样本上。5 是控制上限，不代表业务上只能存在 5 个问题。"}]},{"ID":"20260809200341-hsxdw77","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-hsxdw77","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q25：如何保证多个异步任务的结果不会串台？"}]},{"ID":"20260809200341-gc2ja87","Type":"NodeParagraph","Properties":{"id":"20260809200341-gc2ja87","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ab6q0s2","Type":"NodeParagraph","Properties":{"id":"20260809200341-ab6q0s2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"每次分析生成 task id，所有回调更新状态前校验 task id 是否仍是当前任务。列表项也要绑定 source fingerprint 和 dump hash，不能只按数组下标回写。任务结束、取消或重新开始时清理旧订阅和定时器，避免旧任务在新任务界面上继续触发通知。"}]},{"ID":"20260809200341-h29qms7","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-h29qms7","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B. 输入扫描、去重与证据质量"}]},{"ID":"20260809200341-qtsh4yy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-qtsh4yy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q26：zip、单个 dmp 和混合输入为什么要统一？"}]},{"ID":"20260809200341-3wkgbdh","Type":"NodeParagraph","Properties":{"id":"20260809200341-3wkgbdh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-27or9pb","Type":"NodeParagraph","Properties":{"id":"20260809200341-27or9pb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它们只是输入载体不同，后续都需要得到 dump 列表、符号文件列表和来源标识。如果让后续流程分别处理三条分支，预筛和归因逻辑会重复且容易产生行为差异。统一为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CrashInputScanResult"},{"Type":"NodeText","Data":" 后，上层消费标准化数据，输入差异被限制在扫描阶段。"}]},{"ID":"20260809200341-3gy4bm6","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3gy4bm6","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q27：source fingerprint 和 dump fingerprint 有什么区别？"}]},{"ID":"20260809200341-ybcie3w","Type":"NodeParagraph","Properties":{"id":"20260809200341-ybcie3w","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-it9f129","Type":"NodeParagraph","Properties":{"id":"20260809200341-it9f129","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"source fingerprint 描述一次输入来源，例如 zip 或一组文件，用于归档和缓存；dump fingerprint 描述单个 dump 内容，用于文件去重和代表样本选择。两者混用会导致同一个 zip 中的多个 dump 被错误合并，或者同一 dump 从不同 zip 来时重复分析。身份设计必须对应业务语义。"}]},{"ID":"20260809200341-ji6srvw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ji6srvw","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q28：为什么 SHA1 去重要在客户端和服务端都做？"}]},{"ID":"20260809200341-odg7dch","Type":"NodeParagraph","Properties":{"id":"20260809200341-odg7dch","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-jd5sgpt","Type":"NodeParagraph","Properties":{"id":"20260809200341-jd5sgpt","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端去重可以避免同一个反馈包内重复上传，节省网络和等待时间；服务端去重可以处理不同客户端、不同任务之间的重复请求，保护共享 CDB 资源。客户端优化体验，服务端保证最终一致和幂等，两层职责不同。客户端的 hash 不能替代服务端校验，因为客户端可能中断、版本不同或恶意伪造。"}]},{"ID":"20260809200341-gsoi7rm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-gsoi7rm","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q29：扫描到很多 dmp 时，如何确定顺序？"}]},{"ID":"20260809200341-qjq61ed","Type":"NodeParagraph","Properties":{"id":"20260809200341-qjq61ed","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-0j9jarv","Type":"NodeParagraph","Properties":{"id":"20260809200341-0j9jarv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"可以先按文件时间、文件大小和路径来源排序，但排序只是启发式，不能当作 crash 真实性证明。通常优先分析最新、体积合理且 quick triage 有异常证据的 dump；如果业务有明确的反馈时间字段，应优先使用业务时间。最终结果要保留选择依据，面试时说明“排序用于调度，规则用于判断”。"}]},{"ID":"20260809200341-37bfwvv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-37bfwvv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q30：zip 解压有哪些安全问题？"}]},{"ID":"20260809200341-rktovnc","Type":"NodeParagraph","Properties":{"id":"20260809200341-rktovnc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-538obm9","Type":"NodeParagraph","Properties":{"id":"20260809200341-538obm9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"需要防止 zip slip 路径穿越、压缩炸弹、超大文件和重复覆盖。解压前检查条目路径规范化后仍在目标目录内，限制条目数、解压总大小和单文件大小，并对同名文件采用明确策略。即使是内部工具，反馈包也可能来自用户环境，输入边界不能默认可信。"}]},{"ID":"20260809200341-6tl9u4z","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-6tl9u4z","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q31：为什么预筛结果要区分 crash、suspected 和 non-crash？"}]},{"ID":"20260809200341-c6eshws","Type":"NodeParagraph","Properties":{"id":"20260809200341-c6eshws","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-uej777o","Type":"NodeParagraph","Properties":{"id":"20260809200341-uej777o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"只有二元结果会把证据不足的样本误判成正常或异常。"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"crash"},{"Type":"NodeText","Data":" 表示已经有较强异常证据，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"non-crash"},{"Type":"NodeText","Data":" 表示更像手动、卡顿或调试中断，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"suspected"},{"Type":"NodeText","Data":" 表示存在信号但需要深度命令确认。三态结果可以控制后续成本，同时把不确定性显式传递给用户。"}]},{"ID":"20260809200341-9r66pax","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9r66pax","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q32：quick triage 的判定优先级怎么设计？"}]},{"ID":"20260809200341-n4a20oh","Type":"NodeParagraph","Properties":{"id":"20260809200341-n4a20oh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-t736esm","Type":"NodeParagraph","Properties":{"id":"20260809200341-t736esm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先识别明确的 benign break code 和采样特征，避免误报；再检查真实 exception code、exception record 和有效栈；最后根据模块命中等弱信号归入 suspected。优先级应该由证据强度决定，而不是由字符串出现顺序决定。规则中还要记录命中的字段，方便解释为什么得到某个状态。"}]},{"ID":"20260809200341-xi7ahnr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-xi7ahnr","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q33：如何处理 dump 文件损坏或格式不兼容？"}]},{"ID":"20260809200341-x83gnex","Type":"NodeParagraph","Properties":{"id":"20260809200341-x83gnex","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-w9u6hmw","Type":"NodeParagraph","Properties":{"id":"20260809200341-w9u6hmw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"输入层先做存在性、扩展名和基本文件大小校验，真正的格式判断交给 CDB 打开结果。某个 dump 打不开时只标记该样本失败，继续处理其他文件，并在最终报告中给出 skipped reason。不能把“打不开一个 dump”升级成“整个反馈包分析失败”，除非没有任何可用输入。"}]},{"ID":"20260809200341-p16336v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-p16336v","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q34：为什么要先预筛再深度分析？"}]},{"ID":"20260809200341-pn38r0g","Type":"NodeParagraph","Properties":{"id":"20260809200341-pn38r0g","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-sb5am9s","Type":"NodeParagraph","Properties":{"id":"20260809200341-sb5am9s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"预筛命令少、成本低，目标是判断样本是否值得继续消耗 CDB 资源；深度分析命令多、依赖符号且耗时高，目标是形成证据链。分阶段能控制平均耗时和服务压力，也让失败范围更小。它类似数据库查询的先过滤后聚合，先缩小数据集，再进行昂贵操作。"}]},{"ID":"20260809200341-fj1c7kv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-fj1c7kv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q35：签名分组可能误合并，怎么降低风险？"}]},{"ID":"20260809200341-3mrebxw","Type":"NodeParagraph","Properties":{"id":"20260809200341-3mrebxw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ksxgf74","Type":"NodeParagraph","Properties":{"id":"20260809200341-ksxgf74","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先使用异常码、模块和函数等强字段构造精确签名，再在证据足够时使用异常码加模块做宽松合并。宽松合并必须保留代表样本列表和原始差异，不能把它当作事实上的同一问题。若两个样本的栈或版本信息冲突，应拆分而不是强行合并。"}]},{"ID":"20260809200341-0wnglqc","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-0wnglqc","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C. 深度采证与规则归因"}]},{"ID":"20260809200341-2r68ctj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2r68ctj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q36：为什么深度分析器只采证不归因？"}]},{"ID":"20260809200341-e1g8lq0","Type":"NodeParagraph","Properties":{"id":"20260809200341-e1g8lq0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-i4k45vv","Type":"NodeParagraph","Properties":{"id":"20260809200341-i4k45vv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"采证器负责和 CDB/MCP 交互，归因器负责解释证据并映射业务分类。两者混在一起会让调试命令、网络错误和业务规则互相耦合，后续换调试后端或修改分类都困难。分离后可以对采集结果做离线回放，用同一份证据反复测试规则而不必每次启动 CDB。"}]},{"ID":"20260809200341-zzgev2f","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zzgev2f","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q37："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".ecxr"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 分别提供什么？"}]},{"ID":"20260809200341-nmu1xvv","Type":"NodeParagraph","Properties":{"id":"20260809200341-nmu1xvv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-kw9itjx","Type":"NodeParagraph","Properties":{"id":"20260809200341-kw9itjx","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".ecxr"},{"Type":"NodeText","Data":" 切换到异常上下文；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":" 查看当前上下文的调用栈；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":" 查看已加载模块；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 提供 WinDBG 的综合分析和异常摘要。它们互相补充：异常上下文告诉我们“在哪里出错”，栈告诉我们“怎么走到这里”，模块告诉我们“属于谁”，自动分析提供更多调试器推断，但不能取代原始证据。"}]},{"ID":"20260809200341-mwtjr1n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-mwtjr1n","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q38：如何判断异常模块属于自己、第三方还是系统？"}]},{"ID":"20260809200341-xp0gj8l","Type":"NodeParagraph","Properties":{"id":"20260809200341-xp0gj8l","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bo9hti5","Type":"NodeParagraph","Properties":{"id":"20260809200341-bo9hti5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能只根据 DLL 名称猜测，需要结合模块路径、版本、签名信息、已知模块集合和调用栈位置。规则可以先做高精度的企业微信模块匹配，再识别系统目录和常见第三方目录，无法确认时返回 unknown。分类结果要把命中的模块和判断依据放进 evidence，避免只显示一个标签。"}]},{"ID":"20260809200341-o050yo2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-o050yo2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q39：规则引擎中的规则顺序为什么重要？"}]},{"ID":"20260809200341-ega98v2","Type":"NodeParagraph","Properties":{"id":"20260809200341-ega98v2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-g1f1w7h","Type":"NodeParagraph","Properties":{"id":"20260809200341-g1f1w7h","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"同一份证据可能同时命中多个规则，例如异常栈既包含第三方模块又包含企业微信调用。规则顺序代表业务优先级，应该把证据更强、边界更明确的规则放在前面，把兜底规则放在最后。更可维护的实现是给规则显式 priority，并在测试中覆盖冲突样本，避免仅靠文件排列产生隐含行为。"}]},{"ID":"20260809200341-dzui0rp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-dzui0rp","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q40：规则引擎怎样做到可测试？"}]},{"ID":"20260809200341-0c9q1rr","Type":"NodeParagraph","Properties":{"id":"20260809200341-0c9q1rr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-8w0r9w7","Type":"NodeParagraph","Properties":{"id":"20260809200341-8w0r9w7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把输入设计成结构化的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DeepCollectionResult"},{"Type":"NodeText","Data":"，规则输出设计成固定 schema，包括分类、置信度、证据和话术。测试直接构造异常码、模块、栈和日志片段，验证命中规则、优先级和兜底结果，不需要真的运行 CDB。再用少量真实样本做集成回放，检查解析器和规则之间的字段契约。"}]},{"ID":"20260809200341-dx9o1s8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-dx9o1s8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q41：为什么不让大模型直接决定分类？"}]},{"ID":"20260809200341-ngprolp","Type":"NodeParagraph","Properties":{"id":"20260809200341-ngprolp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-pzk5uva","Type":"NodeParagraph","Properties":{"id":"20260809200341-pzk5uva","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"分类会影响问题流转和客服动作，要求结果稳定、可审计。大模型适合把已确认的证据组织成自然语言，也适合处理规则未覆盖的辅助解释，但不适合替代确定性判定。更稳妥的架构是规则给出分类和证据，模型只在允许的范围内生成摘要，并把原始证据一并展示。"}]},{"ID":"20260809200341-2mjoqxh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2mjoqxh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q42：置信度应该如何解释？"}]},{"ID":"20260809200341-nptc89p","Type":"NodeParagraph","Properties":{"id":"20260809200341-nptc89p","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bt0n23j","Type":"NodeParagraph","Properties":{"id":"20260809200341-bt0n23j","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"置信度不是模型概率，而是规则对证据强弱的离散表达。例如明确异常码加异常上下文和模块命中可以是 high，只有模块弱命中可以是 medium，证据缺失就是 low 或 unable。面试时要强调它是用于提示人工复核优先级的业务指标，不能包装成未经校准的统计概率。"}]},{"ID":"20260809200341-whtjfqh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-whtjfqh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q43：规则未命中时为什么返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":"？"}]},{"ID":"20260809200341-8cfkj8m","Type":"NodeParagraph","Properties":{"id":"20260809200341-8cfkj8m","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-h6f68tl","Type":"NodeParagraph","Properties":{"id":"20260809200341-h6f68tl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"没有足够证据时继续猜测会制造比“不确定”更大的风险。"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 不是异常崩溃，而是一个可统计、可改进的业务结果，表示当前采集信息不足或规则覆盖不足。统计服务单独计算这类样本，后续可以通过补充命令、日志解析和规则来降低比例。"}]},{"ID":"20260809200341-h5q12j8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-h5q12j8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q44：内存问题为什么不能只看 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"bad_alloc"},{"Type":"NodeText","Data":"？"}]},{"ID":"20260809200341-ctih065","Type":"NodeParagraph","Properties":{"id":"20260809200341-ctih065","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-nush3d2","Type":"NodeParagraph","Properties":{"id":"20260809200341-nush3d2","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"bad_alloc"},{"Type":"NodeText","Data":" 说明某次分配失败，但不直接说明是物理内存、提交内存、虚拟地址空间还是进程自身碎片问题。"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc0000017"},{"Type":"NodeText","Data":" 等异常也需要结合系统和应用日志确认。项目将 dump 的异常证据和反馈包里的 Memory、Environment、MemoryInspector 等日志联合判断，输出更贴近实际根因的分类。"}]},{"ID":"20260809200341-tm5ng23","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-tm5ng23","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q45：如果 dump 结论和日志结论冲突怎么办？"}]},{"ID":"20260809200341-4boksgv","Type":"NodeParagraph","Properties":{"id":"20260809200341-4boksgv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-h8p67te","Type":"NodeParagraph","Properties":{"id":"20260809200341-h8p67te","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先保留两类证据，不直接覆盖；再依据时间、进程、版本和样本来源判断是否属于同一次事件。规则可以定义冲突状态并降低置信度，交给人工复核。对于高风险分类，宁可输出“证据冲突”也不要为了得到一个漂亮标签而丢弃原始信息。"}]},{"ID":"20260809200341-6458mxd","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-6458mxd","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D. 可靠性、性能与产品闭环"}]},{"ID":"20260809200341-bkqdfnh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-bkqdfnh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q46：分析流程中哪个环节最可能成为瓶颈？"}]},{"ID":"20260809200341-4x720us","Type":"NodeParagraph","Properties":{"id":"20260809200341-4x720us","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-0b9v2mo","Type":"NodeParagraph","Properties":{"id":"20260809200341-0b9v2mo","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"批量场景中瓶颈通常不是 Flutter UI，而是 dump 上传、CDB 启动/符号加载和深度命令执行。可以分别测量扫描、哈希、上传、session 创建、每条命令和规则处理耗时，不能只看总耗时。优化顺序应先通过去重、预筛、签名分组减少任务数量，再考虑并发和缓存。"}]},{"ID":"20260809200341-xxganwf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-xxganwf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q47：为什么归档要先本地写、再异步上报？"}]},{"ID":"20260809200341-lucdx4n","Type":"NodeParagraph","Properties":{"id":"20260809200341-lucdx4n","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-5z6qaw9","Type":"NodeParagraph","Properties":{"id":"20260809200341-5z6qaw9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"分析结果对当前用户是主流程，统计服务属于后置闭环。先本地持久化可以在网络不可用时保留结果，异步上报避免 UI 等待远端。为了防止重复上报，本地记录需要有稳定 id，服务端接口要幂等；后台重试还要有次数和退避上限。"}]},{"ID":"20260809200341-edumq32","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-edumq32","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q48：异步上报失败会不会造成数据永久丢失？"}]},{"ID":"20260809200341-z2hkitf","Type":"NodeParagraph","Properties":{"id":"20260809200341-z2hkitf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bwtjy7g","Type":"NodeParagraph","Properties":{"id":"20260809200341-bwtjy7g","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如果只是 fire-and-forget 且没有待发送状态，确实存在丢失风险。当前 fail-soft 设计优先保证分析可用，但更完整的实现会把 pending、sent、failed 状态写进本地 outbox，应用启动或定时任务重试 pending 记录。这样仍不阻塞主流程，同时提高统计数据最终送达率。"}]},{"ID":"20260809200341-i8x9lp7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-i8x9lp7","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q49：为什么归档使用 JSONL？"}]},{"ID":"20260809200341-xpoijcc","Type":"NodeParagraph","Properties":{"id":"20260809200341-xpoijcc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-jo2s24y","Type":"NodeParagraph","Properties":{"id":"20260809200341-jo2s24y","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"本地归档主要为了可恢复、可调试和简单追加，JSONL 每行一条记录，分析失败时不容易破坏全部文件，也方便人工查看和离线迁移。它不适合高并发复杂查询，所以只把它作为本地结果和轻量缓存，复杂统计交给服务端。格式中应带 schema version，避免后续字段变化无法读取旧记录。"}]},{"ID":"20260809200341-69zunwz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-69zunwz","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q50：如何设计客户端的重试策略？"}]},{"ID":"20260809200341-ocio6a7","Type":"NodeParagraph","Properties":{"id":"20260809200341-ocio6a7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-knqa8eb","Type":"NodeParagraph","Properties":{"id":"20260809200341-knqa8eb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"只对明确可重试的网络错误、临时 5xx 和连接超时重试；参数错误、文件损坏和权限错误不应盲目重试。上传重试要依赖 token 是否可复用，若 token 一次性失效就重新申请；session 命令超时则优先重建 session，不能在未知状态上重复写命令。每次重试都记录原因和次数，避免形成请求风暴。"}]},{"ID":"20260809200341-3tgauv5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3tgauv5","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q51：用户看到的进度应该如何计算？"}]},{"ID":"20260809200341-fnho7ry","Type":"NodeParagraph","Properties":{"id":"20260809200341-fnho7ry","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-yblwfy6","Type":"NodeParagraph","Properties":{"id":"20260809200341-yblwfy6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能把所有阶段简单平均，因为上传和 CDB 深度分析耗时差异很大。可以按阶段分配权重，并在阶段内按已完成文件数计算；未知耗时的命令显示“正在采集”而不是伪造精确百分比。进度的目标是帮助用户判断是否仍在工作，准确的阶段和当前文件往往比虚假的 73% 更有价值。"}]},{"ID":"20260809200341-pcda636","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-pcda636","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q52：分析结果如何做到可追溯？"}]},{"ID":"20260809200341-mzl5ri9","Type":"NodeParagraph","Properties":{"id":"20260809200341-mzl5ri9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-f3p09pe","Type":"NodeParagraph","Properties":{"id":"20260809200341-f3p09pe","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"结果至少关联 source fingerprint、dump hash、分析时间、规则版本、客户端版本和采集命令版本。报告里保留分类依据和关键原始输出摘要，不能只保存最终话术。以后规则变化时，可以用旧证据重放，解释为什么新旧结论不同。"}]},{"ID":"20260809200341-qyoyap2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-qyoyap2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q53：如果客户端在深度分析中途崩溃，服务端 session 怎么办？"}]},{"ID":"20260809200341-3xyrdej","Type":"NodeParagraph","Properties":{"id":"20260809200341-3xyrdej","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-3br5s4v","Type":"NodeParagraph","Properties":{"id":"20260809200341-3br5s4v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端无法保证 finally 一定执行，因此服务端必须有 session idle timeout 和进程健康检查。客户端重启后可以根据本地任务记录判断是否继续或重新开始，服务端不应无限等待客户端回来。对于大任务，也可以给 session 设置 owner、heartbeat 和最大生命周期，让回收更可控。"}]},{"ID":"20260809200341-gi274wf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-gi274wf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q54：你会怎样优化 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CrashAnalysisManager"},{"Type":"NodeText","Data":"？"}]},{"ID":"20260809200341-2d3dx41","Type":"NodeParagraph","Properties":{"id":"20260809200341-2d3dx41","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-lb41yh6","Type":"NodeParagraph","Properties":{"id":"20260809200341-lb41yh6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会把它拆成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"InputScanner"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PrefilterScheduler"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DeepEvidenceService"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RuleClassifier"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ArchiveCoordinator"},{"Type":"NodeText","Data":"，Manager 只负责状态和流程组合。每层用明确的输入输出对象连接，异常转换在边界处完成。拆分的收益不是类变多，而是能分别测试和替换每一段，同时降低一次改规则影响 UI 的风险。"}]},{"ID":"20260809200341-ruwhfvr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ruwhfvr","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q55：这个客户端如何做回归测试？"}]},{"ID":"20260809200341-6078exe","Type":"NodeParagraph","Properties":{"id":"20260809200341-6078exe","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-0m4cwnz","Type":"NodeParagraph","Properties":{"id":"20260809200341-0m4cwnz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"输入扫描用临时目录构造 zip、重复 dump、损坏 zip 和无 dump 样本；预筛用 fake MCP bridge 返回 crash、suspected、non-crash 和超时；规则引擎用固定证据样本验证分类和冲突优先级；归档用 fake server 验证 fail-soft 和重试。最后再保留少量真实 dump 的端到端测试，避免测试全部依赖外部 CDB。"}]},{"ID":"20260809200341-qkof21o","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-qkof21o","updated":"20260809200341"}},{"ID":"20260809200341-ogw9xb4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-ogw9xb4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十、深挖题库：wxlog_stats_server"}]},{"ID":"20260809200341-8gpaqe9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-8gpaqe9","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A. 数据模型与持久化"}]},{"ID":"20260809200341-jlrp78n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-jlrp78n","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q14：一条分析记录至少应该有哪些字段？"}]},{"ID":"20260809200341-rtqllsj","Type":"NodeParagraph","Properties":{"id":"20260809200341-rtqllsj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-c4685rv","Type":"NodeParagraph","Properties":{"id":"20260809200341-c4685rv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"至少包括稳定 id、用户、创建时间、source fingerprint、dump 或签名信息、分类、置信度、证据摘要、话术、规则版本、反馈状态和备注。字段应区分机器可检索数据与展示文本，时间统一格式，反馈使用有限枚举。每条记录带 schema version，后续增加字段时可以兼容旧数据。"}]},{"ID":"20260809200341-2ehv3ey","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2ehv3ey","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q15：为什么 JSONL 比普通 JSON 数组更适合追加记录？"}]},{"ID":"20260809200341-zevg0iu","Type":"NodeParagraph","Properties":{"id":"20260809200341-zevg0iu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-2gxtct5","Type":"NodeParagraph","Properties":{"id":"20260809200341-2gxtct5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"普通 JSON 数组追加通常需要读出整个数组、修改后重写，文件越大成本越高，写入中断还可能破坏整体结构。JSONL 每条记录独占一行，天然适合 append、逐行恢复和增量导入。它仍然不是数据库，复杂更新和多进程写入需要额外索引与锁来补足。"}]},{"ID":"20260809200341-9s39xwr","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9s39xwr","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q16：更新 JSONL 中间的一条记录为什么麻烦？"}]},{"ID":"20260809200341-imw8t5o","Type":"NodeParagraph","Properties":{"id":"20260809200341-imw8t5o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-jit01jm","Type":"NodeParagraph","Properties":{"id":"20260809200341-jit01jm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"JSONL 记录长度可变，不能安全地原地覆盖任意一行。因此更新时通常读取目标分片、修改内存记录、写临时文件，再原子替换原文件，同时重建或更新内存索引。数据量增长后可以采用追加事件、后台 compaction 或迁移 SQLite，不能无限依赖全文件重写。"}]},{"ID":"20260809200341-lyvqa4d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-lyvqa4d","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q17：为什么按用户分片，而不是所有人共用一个 JSONL？"}]},{"ID":"20260809200341-hqvbam0","Type":"NodeParagraph","Properties":{"id":"20260809200341-hqvbam0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-emrc96x","Type":"NodeParagraph","Properties":{"id":"20260809200341-emrc96x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"按用户分片能缩小单次读取和重写范围，用户级锁也不会让所有写入串行。它还便于按用户清理、导出和排查数据。缺点是跨用户全局统计需要遍历多个文件，所以服务启动时要构建全局索引，生产规模更大时再迁移数据库。"}]},{"ID":"20260809200341-6758op5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-6758op5","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q18：JSONL 写入中途进程崩溃，会留下什么状态？"}]},{"ID":"20260809200341-f9s7n40","Type":"NodeParagraph","Properties":{"id":"20260809200341-f9s7n40","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-mwi7724","Type":"NodeParagraph","Properties":{"id":"20260809200341-mwi7724","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"直接写原文件可能留下半行或截断文件，启动恢复时应逐行解析，遇到最后一条不完整记录可以丢弃并记录告警。更新采用临时文件写完后原子替换，可以避免旧文件和新文件之间出现半成品。重要数据还应定期备份，并通过 schema 校验发现损坏记录。"}]},{"ID":"20260809200341-iukoz90","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-iukoz90","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q19：内存索引和磁盘文件谁是事实来源？"}]},{"ID":"20260809200341-ya1grb3","Type":"NodeParagraph","Properties":{"id":"20260809200341-ya1grb3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-w8sfwtv","Type":"NodeParagraph","Properties":{"id":"20260809200341-w8sfwtv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"磁盘文件是持久化事实来源，内存索引是进程内加速结构。启动时从 JSONL 重建索引，更新成功写盘后再更新内存；不能只改内存就返回成功，否则重启会丢数据。若重建失败，应让服务进入降级状态或明确报错，而不是使用不完整索引提供误导性统计。"}]},{"ID":"20260809200341-1h26y3c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-1h26y3c","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q20："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_records"},{"Type":"NodeText","Data":" 分别解决什么问题？"}]},{"ID":"20260809200341-wqa7q3b","Type":"NodeParagraph","Properties":{"id":"20260809200341-wqa7q3b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-qa9yizw","Type":"NodeParagraph","Properties":{"id":"20260809200341-qa9yizw","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index"},{"Type":"NodeText","Data":" 适合通过记录 id 快速定位单条记录；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_records"},{"Type":"NodeText","Data":" 维护用户到记录集合的关系，便于按用户读取和更新。二者是不同维度的索引，更新记录时必须同时维护，删除或重载也不能只更新其中一个。索引重建是解决两者不一致的兜底手段。"}]},{"ID":"20260809200341-vo0batn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-vo0batn","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q21：如何保证索引和 JSONL 一致？"}]},{"ID":"20260809200341-x2xrw1a","Type":"NodeParagraph","Properties":{"id":"20260809200341-x2xrw1a","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-b25rjz7","Type":"NodeParagraph","Properties":{"id":"20260809200341-b25rjz7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"写入顺序应是先完成文件操作，再更新内存索引并返回成功；失败时不应把未落盘记录放进索引。启动或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/refresh"},{"Type":"NodeText","Data":" 时从文件重建，校验 id、用户和文件归属。并发写入使用用户级锁，重建使用全局锁，避免一边清空索引一边有写入遗漏。"}]},{"ID":"20260809200341-djfbem2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-djfbem2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B. 并发、接口与幂等"}]},{"ID":"20260809200341-uyu3qw4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-uyu3qw4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q22：为什么需要用户级异步锁？"}]},{"ID":"20260809200341-9r6lfvp","Type":"NodeParagraph","Properties":{"id":"20260809200341-9r6lfvp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-mse305z","Type":"NodeParagraph","Properties":{"id":"20260809200341-mse305z","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"同一用户的两个请求可能同时追加、更新或重写同一个 JSONL 文件，必须串行化以避免丢更新。不同用户之间文件独立，可以并行，所以按用户加锁比全局锁吞吐更高。锁只保护内存进程内的异步任务，多实例部署时还需要数据库事务、文件锁或分布式锁。"}]},{"ID":"20260809200341-0vyobig","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-0vyobig","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q23：全局 rebuild 锁和用户锁会不会死锁？"}]},{"ID":"20260809200341-6tfvfcl","Type":"NodeParagraph","Properties":{"id":"20260809200341-6tfvfcl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-oy91bu5","Type":"NodeParagraph","Properties":{"id":"20260809200341-oy91bu5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"理想方案是规定统一的加锁顺序，不能一个路径先拿用户锁再拿全局锁，另一个路径反过来。当前实现中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"rebuild_index()"},{"Type":"NodeText","Data":" 持有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_global_lock"},{"Type":"NodeText","Data":"，但 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"append_record()"},{"Type":"NodeText","Data":" 没有获取该锁，因此“全局锁阻止所有写操作”目前还是设计目标，不能当作已经完全保证的事实。另外，用户迁移路径会先锁旧用户、再锁新用户，若两个请求反向迁移，存在死锁风险。改进时可以统一按用户名排序后获取多把用户锁，并让所有写路径遵循 global -\u003e user 的固定顺序。"}]},{"ID":"20260809200341-098tf1h","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-098tf1h","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q24：同一份 report 重复上报怎么办？"}]},{"ID":"20260809200341-fbjs7f4","Type":"NodeParagraph","Properties":{"id":"20260809200341-fbjs7f4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6jm18vw","Type":"NodeParagraph","Properties":{"id":"20260809200341-6jm18vw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前代码以客户端上报的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"record_id"},{"Type":"NodeText","Data":" 作为主要幂等键：同一个 id 已存在时更新已有记录，而不是再次追加。它能解决客户端重试造成的重复记录，但还没有把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"source fingerprint + 用户维度"},{"Type":"NodeText","Data":" 做成独立的服务端幂等约束；如果客户端每次重试都生成新 id，当前实现仍然无法识别。后续可以增加稳定的分析任务 id、来源指纹唯一约束或幂等键表，并明确“重复上报”和“补充反馈”是两种不同语义。"}]},{"ID":"20260809200341-5yjjwtn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-5yjjwtn","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q25：反馈接口为什么要和上报接口分开？"}]},{"ID":"20260809200341-y4x1w6b","Type":"NodeParagraph","Properties":{"id":"20260809200341-y4x1w6b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-wns1tks","Type":"NodeParagraph","Properties":{"id":"20260809200341-wns1tks","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"上报是创建事实记录，反馈和备注是用户对既有记录的后续操作，生命周期和权限都不同。分开后可以明确校验记录存在、限制可更新字段，并保留反馈时间。统计时也能区分“没有反馈”和“反馈为无效”，避免把未知状态当成负反馈。"}]},{"ID":"20260809200341-l0jfdgf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-l0jfdgf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q26：反馈有效率怎么算才不误导？"}]},{"ID":"20260809200341-m64d0hf","Type":"NodeParagraph","Properties":{"id":"20260809200341-m64d0hf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bfcvkvq","Type":"NodeParagraph","Properties":{"id":"20260809200341-bfcvkvq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"分母应是已经产生有效反馈的记录，而不是所有分析记录；分子通常是 helpful，具体要和业务枚举定义一致。没有反馈的记录应单独展示 feedback coverage，不混入有效率。还要按分类、规则版本和时间段拆分，避免少量反馈样本造成过度解读。"}]},{"ID":"20260809200341-xqoxpwv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-xqoxpwv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q27：REST 接口如何做分页和排序？"}]},{"ID":"20260809200341-1b2zrrv","Type":"NodeParagraph","Properties":{"id":"20260809200341-1b2zrrv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-qklzn7a","Type":"NodeParagraph","Properties":{"id":"20260809200341-qklzn7a","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"记录列表不能把全部内存数据一次性返回。接口应支持 page/page_size 或基于时间和 id 的 cursor，限定最大 page size，并明确排序稳定性。当前轻量实现可以在内存中过滤后切片，数据量变大后应把条件下推到数据库或倒排索引，避免每次扫描全部记录。"}]},{"ID":"20260809200341-oaxg80y","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-oaxg80y","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q28：搜索接口应该搜索哪些字段？"}]},{"ID":"20260809200341-ltpgpb7","Type":"NodeParagraph","Properties":{"id":"20260809200341-ltpgpb7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-4g95tzc","Type":"NodeParagraph","Properties":{"id":"20260809200341-4g95tzc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"搜索可以覆盖记录 id、模块名、异常码、分类、源文件和证据摘要，但要明确大小写、分词和时间范围。对日志原文做全文搜索成本高且容易泄露敏感内容，默认应只搜索经过清洗的摘要字段。查询参数要限制长度，避免极端关键词造成高 CPU 扫描。"}]},{"ID":"20260809200341-p5h1i2p","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-p5h1i2p","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q29："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/api/refresh"},{"Type":"NodeText","Data":" 的正确使用场景是什么？"}]},{"ID":"20260809200341-g90f493","Type":"NodeParagraph","Properties":{"id":"20260809200341-g90f493","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-m4en3wq","Type":"NodeParagraph","Properties":{"id":"20260809200341-m4en3wq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它用于外部手工修改、文件恢复、服务启动后重新加载或发现索引异常时重建内存状态，不应该作为每次查询的默认路径。重建期间要给出状态，避免用户看到半更新结果。生产化可以把 refresh 变为后台任务，并返回任务 id、耗时和校验错误数量。"}]},{"ID":"20260809200341-t0026zl","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-t0026zl","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C. 统计口径与数据质量"}]},{"ID":"20260809200341-n9pkuhm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-n9pkuhm","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q30：为什么要把规则分类映射为运营分类？"}]},{"ID":"20260809200341-8wgdzwf","Type":"NodeParagraph","Properties":{"id":"20260809200341-8wgdzwf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ybt0oat","Type":"NodeParagraph","Properties":{"id":"20260809200341-ybt0oat","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"规则引擎的标签可能随着实现变化，包含技术细节；运营更关心企业微信自身、第三方、系统、内存和无法分析等稳定类别。服务端做映射后，报表口径不会被每次规则重命名直接打碎。映射应版本化，保留原始 engine label，出现未知标签时进入 unknown 并告警。"}]},{"ID":"20260809200341-l0s6121","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-l0s6121","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q31：月度统计按什么时间计算？"}]},{"ID":"20260809200341-ccgujgy","Type":"NodeParagraph","Properties":{"id":"20260809200341-ccgujgy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-kczwv6s","Type":"NodeParagraph","Properties":{"id":"20260809200341-kczwv6s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"应明确使用分析创建时间、上报时间还是反馈时间。月度趋势通常按分析创建时间统计，反馈效果则按反馈时间单独计算；两者混用会导致跨月数据解释错误。时间统一存储为带时区的标准格式，展示层再转换为本地日期。"}]},{"ID":"20260809200341-xcotkvv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-xcotkvv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q32：统计时如何处理旧记录缺字段？"}]},{"ID":"20260809200341-87tu802","Type":"NodeParagraph","Properties":{"id":"20260809200341-87tu802","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-9ga0fpu","Type":"NodeParagraph","Properties":{"id":"20260809200341-9ga0fpu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"读取层要做默认值和版本迁移，例如没有 feedback 字段就视为 no_feedback，而不是 helpful 或 not_helpful。无法解析的记录不能静默跳过，应记录文件、行号和原因。统计结果还可以返回数据质量计数，让使用者知道报表是否基于完整数据。"}]},{"ID":"20260809200341-b0hcxb9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-b0hcxb9","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q33：为什么要单独统计无法分析原因？"}]},{"ID":"20260809200341-996htbx","Type":"NodeParagraph","Properties":{"id":"20260809200341-996htbx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-2bsqqdm","Type":"NodeParagraph","Properties":{"id":"20260809200341-2bsqqdm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"只有一个 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 总数无法指导优化。应该继续区分无 dump、符号缺失、CDB 超时、输入损坏、证据冲突和规则未覆盖。这样可以判断问题出在采集基础设施、输入质量还是规则能力，并把统计结果直接转化为下一轮工程任务。"}]},{"ID":"20260809200341-zn981wv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zn981wv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q34：如果同一用户大量重复上报，会影响报表怎么办？"}]},{"ID":"20260809200341-1c3hy0z","Type":"NodeParagraph","Properties":{"id":"20260809200341-1c3hy0z","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-sd3kwrq","Type":"NodeParagraph","Properties":{"id":"20260809200341-sd3kwrq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先用稳定 id 幂等，无法幂等时用用户加 source fingerprint 做近似去重，并在数据中保留 duplicate_count。统计分母按独立分析事件还是请求次数，必须提前定义并在界面标明。否则重试、批量点击和真正的新样本会混在一起，导致反馈有效率失真。"}]},{"ID":"20260809200341-zuewge7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zuewge7","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q35：统计服务如何验证上报数据可信？"}]},{"ID":"20260809200341-c4wu4zo","Type":"NodeParagraph","Properties":{"id":"20260809200341-c4wu4zo","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-c4s9b3w","Type":"NodeParagraph","Properties":{"id":"20260809200341-c4s9b3w","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"服务端不能信任客户端传来的分类和时间，应校验 schema、枚举、长度、时间格式和必填字段。更强的方案是客户端上报原始证据摘要和规则版本，服务端按规则版本做一致性校验。敏感字段还要脱敏、限长并审计访问，避免统计服务变成原始日志泄露点。"}]},{"ID":"20260809200341-of827gy","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-of827gy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D. MCP、部署与演进"}]},{"ID":"20260809200341-uucnrqu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-uucnrqu","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q36：统计服务为什么也提供 MCP？"}]},{"ID":"20260809200341-9f3c9mq","Type":"NodeParagraph","Properties":{"id":"20260809200341-9f3c9mq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-poj9dki","Type":"NodeParagraph","Properties":{"id":"20260809200341-poj9dki","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"人可以看 Web 看板，程序可以调 REST，AI Agent 则更适合通过 MCP 查询统计和历史记录。MCP tools 把 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"query_stats"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"search_records"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"monthly_breakdown"},{"Type":"NodeText","Data":" 等能力描述清楚，Agent 可以根据问题选择工具。查询工具应保持只读、结果限量，并对时间范围和关键词做参数校验。"}]},{"ID":"20260809200341-d6wkols","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-d6wkols","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q37：MCP 查询工具和 REST 查询接口如何避免口径不一致？"}]},{"ID":"20260809200341-7ken8yn","Type":"NodeParagraph","Properties":{"id":"20260809200341-7ken8yn","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-wh3zwca","Type":"NodeParagraph","Properties":{"id":"20260809200341-wh3zwca","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前 REST 和 MCP 都复用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DataService"},{"Type":"NodeText","Data":" 的查询、搜索和统计方法，已经避免了两套核心统计逻辑；但权限、参数范围和错误语义仍需要在协议层明确补齐。分类映射、反馈口径和时间过滤应继续放在核心服务层。后续新增 REST 参数时，要同步评估 MCP schema、接口契约测试和兼容性，而不是只修改其中一个入口。"}]},{"ID":"20260809200341-9ya8ejx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9ya8ejx","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q38：单进程内存索引适合生产吗？"}]},{"ID":"20260809200341-sz6ojww","Type":"NodeParagraph","Properties":{"id":"20260809200341-sz6ojww","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-1hxcrnx","Type":"NodeParagraph","Properties":{"id":"20260809200341-1hxcrnx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"适合低到中等数据量、单实例、内部工具和查询模式简单的场景，优点是实现快、依赖少、读取快。它不适合多实例共享写入、超大数据量和复杂事务。随着数据量和可靠性要求增长，应迁移到 SQLite 或 PostgreSQL，并把唯一约束、索引、事务和分页交给数据库。"}]},{"ID":"20260809200341-iu5wi19","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-iu5wi19","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q39：从 JSONL 迁移数据库要注意什么？"}]},{"ID":"20260809200341-e6c7dr6","Type":"NodeParagraph","Properties":{"id":"20260809200341-e6c7dr6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-65phmtk","Type":"NodeParagraph","Properties":{"id":"20260809200341-65phmtk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先定义字段 schema、唯一键、时间和枚举映射，再做一次可校验的离线导入，不要边读边无条件插入。迁移后对记录数、分类分布、月度总数和反馈统计做双读比对。切换时保留 JSONL 只读备份，出现口径差异时能回溯原始记录。"}]},{"ID":"20260809200341-ae6hncq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ae6hncq","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q40：如果部署两个实例，现有锁还能保证一致吗？"}]},{"ID":"20260809200341-0staqy0","Type":"NodeParagraph","Properties":{"id":"20260809200341-0staqy0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-fdxvfxk","Type":"NodeParagraph","Properties":{"id":"20260809200341-fdxvfxk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能。异步锁只存在于单个 Python 进程，两个实例可以同时修改同一文件，导致覆盖和索引分歧。多实例方案要使用数据库事务，或者明确单写主节点；如果必须共享文件，则要有跨进程文件锁和更严格的原子写策略，但通常数据库更合适。"}]},{"ID":"20260809200341-cw1eoc7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-cw1eoc7","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q41：如何让 Web 看板不影响上报接口？"}]},{"ID":"20260809200341-th22pze","Type":"NodeParagraph","Properties":{"id":"20260809200341-th22pze","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-8ynzp6t","Type":"NodeParagraph","Properties":{"id":"20260809200341-8ynzp6t","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前查询主要在内存索引上做 Python 过滤，重建则异步读取 JSONL；数据量较大时仍可能占用事件循环和影响响应。改进方向是缓存统计结果、限制查询范围、把重建放后台任务，并让写入路径与 rebuild 使用一致的锁协议。进一步可以把读写拆成独立服务或迁移数据库，但这些属于后续演进，不应表述成当前已经具备的能力。"}]},{"ID":"20260809200341-wm1vokz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-wm1vokz","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q42：统计服务最重要的监控指标是什么？"}]},{"ID":"20260809200341-tqy645r","Type":"NodeParagraph","Properties":{"id":"20260809200341-tqy645r","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ay2cw25","Type":"NodeParagraph","Properties":{"id":"20260809200341-ay2cw25","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会监控上报成功率、重复上报率、JSONL 解析失败数、索引重建耗时、写入锁等待、查询 P95、反馈覆盖率和 unknown 分类占比。业务上还要看 helpful、not_helpful、unable_to_analyze 的趋势。技术指标和业务指标要关联规则版本，否则只能看到异常，无法判断是哪次规则变更导致。"}]},{"ID":"20260809200341-2uoia0d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2uoia0d","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q43：这个服务的安全风险有哪些？"}]},{"ID":"20260809200341-aple47s","Type":"NodeParagraph","Properties":{"id":"20260809200341-aple47s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ioooadh","Type":"NodeParagraph","Properties":{"id":"20260809200341-ioooadh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"包括未鉴权查看其他用户记录、备注或搜索接口泄露敏感信息、任意路径写入、超大请求耗尽磁盘、MCP 查询被滥用以及调试数据未脱敏。改进上要加身份认证、用户级授权、请求体和字段长度限制、速率限制、审计日志和敏感字段脱敏。内部网不等于没有安全边界。"}]},{"ID":"20260809200341-tg5npir","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-tg5npir","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q44：如果让你继续完善这个项目，优先级怎么排？"}]},{"ID":"20260809200341-d91mcb2","Type":"NodeParagraph","Properties":{"id":"20260809200341-d91mcb2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-rfi8gtg","Type":"NodeParagraph","Properties":{"id":"20260809200341-rfi8gtg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"第一优先是 schema 校验、鉴权、幂等和数据备份，先保证数据可信；第二是把 JSONL 的全量重写和查询瓶颈迁移到 SQLite/PostgreSQL；第三是补可观测性、分页和规则版本统计；最后才是更复杂的看板和多实例扩展。优先级依据是数据正确性和线上风险，而不是界面功能数量。"}]},{"ID":"20260809200341-vpnlocb","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-vpnlocb","updated":"20260809200341"}},{"ID":"20260809200341-9unfant","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-9unfant","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十一、三项目联合深挖题"}]},{"ID":"20260809200341-s17x6t5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-s17x6t5","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q5：从一次用户选择反馈包到最终看板展示，完整数据流是什么？"}]},{"ID":"20260809200341-0lkuewp","Type":"NodeParagraph","Properties":{"id":"20260809200341-0lkuewp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-a6tld3j","Type":"NodeParagraph","Properties":{"id":"20260809200341-a6tld3j","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"用户在 Flutter 客户端选择 zip，客户端计算来源指纹并在 isolate 中解压，扫描出 dump 和符号文件。预筛阶段对去重后的 dump 申请上传 token、流式上传、创建 CDB session 并执行 quick triage；候选按签名合并后采集深度证据，由本地规则引擎分类。客户端先展示并本地归档，再异步调用 stats server 的 report 接口；服务端落盘、更新索引，之后 REST、MCP 和 Web 看板读取同一统计口径。"}]},{"ID":"20260809200341-7ctl28d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-7ctl28d","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q6：三项目之间最重要的接口契约有哪些？"}]},{"ID":"20260809200341-5a6mal3","Type":"NodeParagraph","Properties":{"id":"20260809200341-5a6mal3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6cltl1o","Type":"NodeParagraph","Properties":{"id":"20260809200341-6cltl1o","updated":"20260809200341"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"mcp-windbg"},{"Type":"NodeText","Data":" 和客户端之间的契约包括上传 token、文件 id、session id、命令结果和错误类型；客户端内部的契约包括 quick triage、深度采证和规则输入对象；客户端和统计服务之间的契约包括稳定记录 id、分类枚举、反馈枚举、时间和 schema version。接口不应只约定成功字符串，还要约定超时、部分结果、重复请求和取消后的行为。"}]},{"ID":"20260809200341-3rye96v","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3rye96v","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q7：如果 mcp-windbg 不可用，客户端如何降级？"}]},{"ID":"20260809200341-2jfadxj","Type":"NodeParagraph","Properties":{"id":"20260809200341-2jfadxj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-mesz19k","Type":"NodeParagraph","Properties":{"id":"20260809200341-mesz19k","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端仍应完成输入扫描、哈希、日志提取和已有本地规则能支持的分析，并明确标记 CDB 证据缺失。归档时记录 unavailable，而不是伪造一个分类；网络恢复后可以重试未完成的远程步骤。降级的边界是“尽可能保留已有信息”，不能把服务不可用解释成 dump 本身无效。"}]},{"ID":"20260809200341-snvthmp","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-snvthmp","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q8：如果 stats server 不可用，工具链还能用吗？"}]},{"ID":"20260809200341-oabxpb4","Type":"NodeParagraph","Properties":{"id":"20260809200341-oabxpb4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6yqaufc","Type":"NodeParagraph","Properties":{"id":"20260809200341-6yqaufc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"能，主分析结果和本地归档不应依赖统计服务在线。客户端将待上报记录写入本地 outbox，后续重试；界面可以提示“统计同步待完成”，但不阻塞当前结论。这样把即时诊断和长期统计解耦，符合故障隔离原则。"}]},{"ID":"20260809200341-3h80xgy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3h80xgy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q9：为什么把规则放在客户端，而不是 stats server？"}]},{"ID":"20260809200341-oramx58","Type":"NodeParagraph","Properties":{"id":"20260809200341-oramx58","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-d4kejhq","Type":"NodeParagraph","Properties":{"id":"20260809200341-d4kejhq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"归因需要采集后的详细证据，且用户希望立即看到结果，把规则放客户端可以减少往返并支持离线降级。stats server 的职责更偏存储、统计和反馈，不应重复承担 CDB 相关业务逻辑。长期若规则需要集中更新，可以把规则包版本化下发，但仍要保留版本和离线兼容策略。"}]},{"ID":"20260809200341-an05tep","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-an05tep","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q10：怎样避免三个项目的版本升级互相破坏？"}]},{"ID":"20260809200341-pj7t5bp","Type":"NodeParagraph","Properties":{"id":"20260809200341-pj7t5bp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-sa07wk6","Type":"NodeParagraph","Properties":{"id":"20260809200341-sa07wk6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"接口使用 schema version 和能力协商，客户端启动时检查服务端支持的工具和版本。新增字段尽量向后兼容，删除字段要经过过渡期；MCP tool 参数变化要同步更新描述和客户端适配。发布前用固定 dump、固定证据和固定上报样本做契约测试，验证端到端结果。"}]},{"ID":"20260809200341-qk1q78e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-qk1q78e","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q11：如果分析结论错误，你如何定位是哪一层的问题？"}]},{"ID":"20260809200341-njtteci","Type":"NodeParagraph","Properties":{"id":"20260809200341-njtteci","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-h82n2eq","Type":"NodeParagraph","Properties":{"id":"20260809200341-h82n2eq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先看最终记录中的规则版本、source fingerprint 和 evidence。若原始 CDB 输出错误或缺失，查 mcp-windbg 的 session、命令和符号日志；若证据正确但结构化字段错误，查客户端解析器；若字段正确但分类错误，查规则优先级；若分类正确但看板统计错误，查 stats server 的映射和统计口径。每层都要保留可回放输入，才能避免凭感觉排查。"}]},{"ID":"20260809200341-ct5cca2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ct5cca2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q12：这条链路哪里适合缓存？"}]},{"ID":"20260809200341-91gn7zv","Type":"NodeParagraph","Properties":{"id":"20260809200341-91gn7zv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-1tvjrnh","Type":"NodeParagraph","Properties":{"id":"20260809200341-1tvjrnh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"dump 文件和符号索引适合按内容身份缓存，quick triage 和深度证据也可以按 dump hash、命令版本和符号版本缓存。规则分类可以对证据结果缓存，但规则版本变化后必须失效。统计结果可以短时间缓存，反馈更新后主动失效；缓存 key 必须包含真正影响结果的版本和用户边界。"}]},{"ID":"20260809200341-cixkbgs","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-cixkbgs","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q13：如果要支持 Linux core dump，哪些部分可以复用？"}]},{"ID":"20260809200341-kvqqxi9","Type":"NodeParagraph","Properties":{"id":"20260809200341-kvqqxi9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-f7k3ctj","Type":"NodeParagraph","Properties":{"id":"20260809200341-f7k3ctj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"上传、内容去重、session 生命周期、并发窗口、证据对象、规则归因框架和统计归档都可以复用。需要替换的是 CDB runner、命令集合、符号处理和平台特定解析器。通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DebuggerAdapter"},{"Type":"NodeText","Data":" 或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"EvidenceCollector"},{"Type":"NodeText","Data":" 接口隔离平台差异，比在每条规则里写 Windows/Linux 分支更可维护。"}]},{"ID":"20260809200341-es37wfa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-es37wfa","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q14：你如何向面试官证明项目不是只会调库？"}]},{"ID":"20260809200341-8zx3hxc","Type":"NodeParagraph","Properties":{"id":"20260809200341-8zx3hxc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-k1hiu3i","Type":"NodeParagraph","Properties":{"id":"20260809200341-k1hiu3i","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会沿着一个异常样本讲清楚从文件身份、上传、session、命令边界、证据对象、规则命中到统计记录的完整路径，再解释其中三个取舍：为什么流式上传、为什么并发受限、为什么规则不让模型直接判定。最后补充一个失败场景和一个可量化指标，例如去重减少重复上传、预筛减少深度分析数量或降低人工排查步骤。这样体现的是系统设计和工程闭环，而不是 API 罗列。"}]},{"ID":"20260809200341-tug5mf0","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-tug5mf0","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q15：如果没有线上指标，如何诚实地描述项目效果？"}]},{"ID":"20260809200341-p8yg6gu","Type":"NodeParagraph","Properties":{"id":"20260809200341-p8yg6gu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-5jmewr1","Type":"NodeParagraph","Properties":{"id":"20260809200341-5jmewr1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能编造用户数、耗时下降或准确率。可以准确描述已实现的机制和可验证的实验指标，例如固定样本集上的分析成功率、重复样本减少比例、不同并发度下的 P95、规则覆盖率和 unable_to_analyze 占比。如果真实业务指标尚未建立，应明确说“当前阶段主要完成工具链落地，后续通过 stats server 建立反馈指标”。"}]},{"ID":"20260809200341-nth5ofy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-nth5ofy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q16：这个项目中你最大的技术取舍是什么？"}]},{"ID":"20260809200341-cl8jir5","Type":"NodeParagraph","Properties":{"id":"20260809200341-cl8jir5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-7f3cdfd","Type":"NodeParagraph","Properties":{"id":"20260809200341-7f3cdfd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"最大的取舍是用确定性本地规则保证可解释和可复现，同时保留 MCP/LLM 的扩展能力；存储上选择 JSONL + 内存索引换取快速落地和低依赖，但承认它不适合无限增长；并发上选择小窗口和候选上限，牺牲部分峰值吞吐换取 CDB 服务稳定。回答取舍时要同时说适用范围和未来演进，而不是只说当前方案“最好”。"}]},{"ID":"20260809200341-f0auqwu","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-f0auqwu","updated":"20260809200341"}},{"ID":"20260809200341-frey1eo","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-frey1eo","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十二、场景题：把项目经验迁移到系统设计"}]},{"ID":"20260809200341-mfsxfhx","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-mfsxfhx","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q1：如果一次上传 20 个 10GB dump，你会怎么设计？"}]},{"ID":"20260809200341-v2cdqko","Type":"NodeParagraph","Properties":{"id":"20260809200341-v2cdqko","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-py67im2","Type":"NodeParagraph","Properties":{"id":"20260809200341-py67im2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先做客户端去重和元数据预扫描，不立即并发上传全部文件；服务端采用分片或可恢复上传，限制单用户并发和总磁盘配额。上传完成后异步排队分析，quick triage 先过滤，再按签名合并，深度分析只保留代表样本。任务状态持久化，客户端断线后可以查询进度，服务端通过队列和 worker 控制 CDB 资源。"}]},{"ID":"20260809200341-phifzr1","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-phifzr1","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q2：如果要求 100 个用户同时分析，最先改哪里？"}]},{"ID":"20260809200341-pj40gqw","Type":"NodeParagraph","Properties":{"id":"20260809200341-pj40gqw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-hyvlixh","Type":"NodeParagraph","Properties":{"id":"20260809200341-hyvlixh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先把同步启动 CDB、磁盘 IO 和符号加载的资源曲线测出来，再做排队和配额，而不是直接把并发数改成 100。mcp-windbg 需要 worker 池、session 上限、任务队列和优先级；文件存储需要容量隔离和清理；客户端需要轮询或事件通知。若单机无法承载，就拆出上传、调度和分析 worker，统计服务独立扩容。"}]},{"ID":"20260809200341-55jvo70","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-55jvo70","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q3：如果用户频繁点击“开始分析”，如何防重复任务？"}]},{"ID":"20260809200341-7ss8umz","Type":"NodeParagraph","Properties":{"id":"20260809200341-7ss8umz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-7bjr4tp","Type":"NodeParagraph","Properties":{"id":"20260809200341-7bjr4tp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端按钮状态和 task id 可以阻止同一页面重复启动，但服务端仍要根据 source fingerprint、用户和规则版本做幂等。相同任务返回已有任务状态，不重复创建 session；不同规则版本可以作为新任务。UI 侧还要在取消、失败和完成后正确恢复按钮状态，不能只靠防抖解决业务重复。"}]},{"ID":"20260809200341-ekctjjy","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ekctjjy","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q4：如果分析结果必须在 3 秒内返回，怎么取舍？"}]},{"ID":"20260809200341-5bnk9x3","Type":"NodeParagraph","Properties":{"id":"20260809200341-5bnk9x3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-qgi7jy9","Type":"NodeParagraph","Properties":{"id":"20260809200341-qgi7jy9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把目标拆成首屏结果和完整结果：3 秒内返回文件扫描、quick triage 和已有缓存命中结果，深度 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 后台继续。优先保证低成本证据和可解释的初步结论，超时则明确显示 partial。要用 P95 而不是平均值评估，避免少数极慢 dump 让用户误以为全部满足 SLA。"}]},{"ID":"20260809200341-d8ua9z3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-d8ua9z3","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q5：如果网络中断后恢复，上传如何续传？"}]},{"ID":"20260809200341-iaqqzrc","Type":"NodeParagraph","Properties":{"id":"20260809200341-iaqqzrc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-2lt8pm6","Type":"NodeParagraph","Properties":{"id":"20260809200341-2lt8pm6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"需要给上传任务分配 upload id，服务端记录已确认的分片和总长度，客户端从最后确认位置继续发送。最终用完整文件 hash 校验，不能只相信分片数量。若现有一次性 token 接口不支持续传，就应诚实说明当前实现只能重新申请 token 重传，并把可恢复上传作为下一步改造。"}]},{"ID":"20260809200341-q02iiux","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-q02iiux","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q6：如果同一 dump 的深度分析命令结果不稳定，怎么处理？"}]},{"ID":"20260809200341-f1sk4lo","Type":"NodeParagraph","Properties":{"id":"20260809200341-f1sk4lo","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-hl51l67","Type":"NodeParagraph","Properties":{"id":"20260809200341-hl51l67","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先检查是否复用了错误 session、符号版本不一致、命令上下文被污染或 CDB 输出截断，再检查 dump 本身是否包含不确定信息。固定 dump、CDB 版本、符号目录和命令顺序做重复实验，记录原始输出和环境指纹。若仍有差异，规则层降低置信度并保留多次证据，不能简单取一次结果作为真值。"}]},{"ID":"20260809200341-igk8al4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-igk8al4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q7：如果 stats server 数据文件损坏，你会如何恢复？"}]},{"ID":"20260809200341-61tp6cv","Type":"NodeParagraph","Properties":{"id":"20260809200341-61tp6cv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-j2meay7","Type":"NodeParagraph","Properties":{"id":"20260809200341-j2meay7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先停止写入或切换只读模式，保留原文件副本；逐行解析，恢复完整合法记录，标记损坏行并记录行号。重建新文件和索引后进行记录数、分类数、时间范围和反馈统计比对，再原子替换。没有备份时也不能静默删除损坏内容，应向使用者报告恢复范围和数据缺口。"}]},{"ID":"20260809200341-ltcjiha","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ltcjiha","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q8：如果规则升级导致历史结果分类变化，怎么办？"}]},{"ID":"20260809200341-i636h8s","Type":"NodeParagraph","Properties":{"id":"20260809200341-i636h8s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-5r5xhb1","Type":"NodeParagraph","Properties":{"id":"20260809200341-5r5xhb1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"记录中保存规则版本和原始证据，升级后可以选择只影响新任务，或离线重跑历史任务生成新版本结果。报表默认按当前展示版本还是首次分析版本，必须明确，最好同时支持对比。不能直接覆盖旧分类而不留版本，否则反馈趋势和回溯都会失去解释。"}]},{"ID":"20260809200341-y0bkj2s","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-y0bkj2s","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q9：如果 AI Agent 执行危险 CDB 命令怎么办？"}]},{"ID":"20260809200341-8njhyw6","Type":"NodeParagraph","Properties":{"id":"20260809200341-8njhyw6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-i6saz4g","Type":"NodeParagraph","Properties":{"id":"20260809200341-i6saz4g","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"工具层只暴露分析所需的白名单命令，参数做长度和字符校验；对高耗时或可能修改状态的命令做权限隔离、确认或直接禁止。服务端记录调用方、命令、session 和结果摘要，超过配额就拒绝。MCP 的自然语言描述不是安全控制，真正的控制必须在服务端执行。"}]},{"ID":"20260809200341-zcbn7iu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zcbn7iu","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q10：如果用户反馈“分类有用”，如何证明规则真的有效？"}]},{"ID":"20260809200341-775rzqc","Type":"NodeParagraph","Properties":{"id":"20260809200341-775rzqc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-gak9jsd","Type":"NodeParagraph","Properties":{"id":"20260809200341-gak9jsd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"有用反馈只能作为业务信号，不能直接等同于技术准确率。需要建立带人工真值的样本集，计算按分类的 precision、recall、覆盖率，再结合 helpful、not_helpful 和 unable_to_analyze 分析用户体验。反馈数据要按规则版本和样本类型拆分，避免样本构成变化造成错误结论。"}]},{"ID":"20260809200341-9qny4me","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-9qny4me","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q11：如果用户只看结论，不看证据，为什么还要保留证据链？"}]},{"ID":"20260809200341-2cl01s7","Type":"NodeParagraph","Properties":{"id":"20260809200341-2cl01s7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-bgxnhl1","Type":"NodeParagraph","Properties":{"id":"20260809200341-bgxnhl1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"证据链服务于复核、纠错和规则迭代，不只是给当前用户阅读。出现误判时，没有原始异常码、模块和栈就无法判断是采集错、解析错还是规则错；统计服务也无法分析无法归因的原因。UI 可以默认折叠证据，但系统层必须保留经过脱敏和限长的关键证据。"}]},{"ID":"20260809200341-oe4nbd4","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-oe4nbd4","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q12：如果需要开放给外部用户，现有架构还缺什么？"}]},{"ID":"20260809200341-yow9v7d","Type":"NodeParagraph","Properties":{"id":"20260809200341-yow9v7d","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-i8kczyv","Type":"NodeParagraph","Properties":{"id":"20260809200341-i8kczyv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"需要补身份认证、租户隔离、访问控制、上传配额、病毒和压缩包检查、敏感数据脱敏、命令白名单、审计、数据保留和多实例部署。还要重新评估 dump 跨网络传输和符号文件的知识产权风险。当前方案定位是内部工具，外部开放不能只在入口前加一个登录页面。"}]},{"ID":"20260809200341-py4jg94","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-py4jg94","updated":"20260809200341"}},{"ID":"20260809200341-tv00e6a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-tv00e6a","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十三、面试表达与项目复盘"}]},{"ID":"20260809200341-ifwf69c","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-ifwf69c","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"1. 推荐回答模板"}]},{"ID":"20260809200341-28pugwc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-28pugwc","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模板一：介绍项目"}]},{"ID":"20260809200341-jkoq181","Type":"NodeParagraph","Properties":{"id":"20260809200341-jkoq181","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"先说业务痛点，再说自己的职责，然后说主链路，最后说一个工程取舍和结果。示例："}]},{"ID":"20260809200341-xt993cw","Type":"NodeParagraph","Properties":{"id":"20260809200341-xt993cw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"“这个项目解决的是……我主要负责……一次请求会经过……其中我重点处理了……因为……所以选择……最终通过……保证了……。”"}]},{"ID":"20260809200341-0gb5er6","Type":"NodeParagraph","Properties":{"id":"20260809200341-0gb5er6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不要把技术栈当作项目介绍的主体。技术栈只能帮助面试官定位问题，真正有价值的是你为什么这样拆、遇到什么边界、怎样验证。"}]},{"ID":"20260809200341-b4dcbq7","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-b4dcbq7","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模板二：回答为什么这样设计"}]},{"ID":"20260809200341-ph88p81","Type":"NodeParagraph","Properties":{"id":"20260809200341-ph88p81","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"使用“约束 -\u003e 方案 -\u003e 收益 -\u003e 代价 -\u003e 适用范围”的顺序。比如并发度为 2，不要只说“为了稳定”，而要说 CDB 和上传是重资源，完全串行吞吐低，完全并发会触发资源上限，因此用小窗口平衡耗时和压力；代价是峰值吞吐受限，未来可用队列和动态调度改进。"}]},{"ID":"20260809200341-pil1g1a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-pil1g1a","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模板三：回答项目难点"}]},{"ID":"20260809200341-rcmf6t3","Type":"NodeParagraph","Properties":{"id":"20260809200341-rcmf6t3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"难点要有具体对象和失败风险。推荐说“交互式 CDB 没有天然消息边界，直接读取会挂起或串结果；我用 UUID marker 定义命令边界，并配合超时和 broken session 回收”。这比“我遇到了很多困难，最后解决了”更能证明实际参与。"}]},{"ID":"20260809200341-o8nwd2a","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-o8nwd2a","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"模板四：回答没有做过的细节"}]},{"ID":"20260809200341-2zx7f37","Type":"NodeParagraph","Properties":{"id":"20260809200341-2zx7f37","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不要编造指标或实现。可以说：“当前代码里已经做到的是 A 和 B；C 还没有做，我会按 D 的方式补上，原因是它能解决 E 风险。”诚实地划分已实现和设计思路，通常比把推测说成事实更可靠。"}]},{"ID":"20260809200341-ler7bl2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-ler7bl2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2. 三个项目各自最容易被追问的薄弱点"}]},{"ID":"20260809200341-ojjd7r9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ojjd7r9","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"mcp-windbg"}]},{"ID":"20260809200341-zrsqgi8","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-zrsqgi8","updated":"20260809200341"},"Children":[{"ID":"20260809200341-469zdhs","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-469zdhs","updated":"20260809200341"},"Children":[{"ID":"20260809200341-or7nooc","Type":"NodeParagraph","Properties":{"id":"20260809200341-or7nooc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否真的理解 CDB 的交互式输入输出，而不是只知道命令名。"}]}]},{"ID":"20260809200341-wzg97a5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-wzg97a5","updated":"20260809200341"},"Children":[{"ID":"20260809200341-0vgs9g9","Type":"NodeParagraph","Properties":{"id":"20260809200341-0vgs9g9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否考虑任意命令、路径穿越、session 泄漏和磁盘打满。"}]}]},{"ID":"20260809200341-rdhlf4s","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rdhlf4s","updated":"20260809200341"},"Children":[{"ID":"20260809200341-mh8w1jm","Type":"NodeParagraph","Properties":{"id":"20260809200341-mh8w1jm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能解释线程池、事件循环和进程资源之间的关系。"}]}]},{"ID":"20260809200341-7hdumq4","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7hdumq4","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ku59vq3","Type":"NodeParagraph","Properties":{"id":"20260809200341-ku59vq3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否知道 SHA1 去重只解决身份和性能，不等于安全校验。"}]}]}]},{"ID":"20260809200341-to0hnap","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-to0hnap","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"wxlog_analyze"}]},{"ID":"20260809200341-o6s2lrm","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-o6s2lrm","updated":"20260809200341"},"Children":[{"ID":"20260809200341-z2a8qrx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-z2a8qrx","updated":"20260809200341"},"Children":[{"ID":"20260809200341-c2bionz","Type":"NodeParagraph","Properties":{"id":"20260809200341-c2bionz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能说清 Flutter isolate、Future 和 UI isolate 的差别。"}]}]},{"ID":"20260809200341-gvooyo3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-gvooyo3","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ql8l402","Type":"NodeParagraph","Properties":{"id":"20260809200341-ql8l402","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能解释预筛、候选上限和签名分组，而不是只说“调用 AI 分析”。"}]}]},{"ID":"20260809200341-t0tswzt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-t0tswzt","updated":"20260809200341"},"Children":[{"ID":"20260809200341-c5dc8tz","Type":"NodeParagraph","Properties":{"id":"20260809200341-c5dc8tz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能区分证据采集、规则归因和话术生成三个职责。"}]}]},{"ID":"20260809200341-mlkmsb2","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-mlkmsb2","updated":"20260809200341"},"Children":[{"ID":"20260809200341-d4mkqv1","Type":"NodeParagraph","Properties":{"id":"20260809200341-d4mkqv1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否考虑取消、重试、旧任务回写、部分失败和归档失败。"}]}]}]},{"ID":"20260809200341-s1p7bg8","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-s1p7bg8","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"wxlog_stats_server"}]},{"ID":"20260809200341-llownid","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-llownid","updated":"20260809200341"},"Children":[{"ID":"20260809200341-n57lwfl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-n57lwfl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-n3s7u8i","Type":"NodeParagraph","Properties":{"id":"20260809200341-n3s7u8i","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否理解 JSONL 追加简单但更新困难、内存索引快但重启需重建。"}]}]},{"ID":"20260809200341-x30m1v5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-x30m1v5","updated":"20260809200341"},"Children":[{"ID":"20260809200341-pzcwtcp","Type":"NodeParagraph","Properties":{"id":"20260809200341-pzcwtcp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能说清用户锁和全局 rebuild 锁的边界。"}]}]},{"ID":"20260809200341-uk88au1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-uk88au1","updated":"20260809200341"},"Children":[{"ID":"20260809200341-of04a72","Type":"NodeParagraph","Properties":{"id":"20260809200341-of04a72","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否能准确解释反馈覆盖率、有效率和重复上报的统计口径。"}]}]},{"ID":"20260809200341-v2j3lg7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-v2j3lg7","updated":"20260809200341"},"Children":[{"ID":"20260809200341-o4x67f6","Type":"NodeParagraph","Properties":{"id":"20260809200341-o4x67f6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"是否知道单进程异步锁不能解决多实例并发。"}]}]}]},{"ID":"20260809200341-hpef9t9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-hpef9t9","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3. 最后检查清单"}]},{"ID":"20260809200341-pdllqe9","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-pdllqe9","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"每个项目都要能回答"}]},{"ID":"20260809200341-bbsiuzw","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-bbsiuzw","updated":"20260809200341"},"Children":[{"ID":"20260809200341-vkd1qbj","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-vkd1qbj","updated":"20260809200341"},"Children":[{"ID":"20260809200341-963o36k","Type":"NodeParagraph","Properties":{"id":"20260809200341-963o36k","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"一句话目标是什么？服务谁？"}]}]},{"ID":"20260809200341-umelut7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-umelut7","updated":"20260809200341"},"Children":[{"ID":"20260809200341-negty2v","Type":"NodeParagraph","Properties":{"id":"20260809200341-negty2v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"自己具体负责了哪些模块？"}]}]},{"ID":"20260809200341-2jex8wi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-2jex8wi","updated":"20260809200341"},"Children":[{"ID":"20260809200341-2eqi9rz","Type":"NodeParagraph","Properties":{"id":"20260809200341-2eqi9rz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"一次完整请求的数据流是什么？"}]}]},{"ID":"20260809200341-ym5lnx6","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-ym5lnx6","updated":"20260809200341"},"Children":[{"ID":"20260809200341-a3nfive","Type":"NodeParagraph","Properties":{"id":"20260809200341-a3nfive","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"最难的一个技术问题是什么？为什么难？"}]}]},{"ID":"20260809200341-sl71pr7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-sl71pr7","updated":"20260809200341"},"Children":[{"ID":"20260809200341-1jsk4bb","Type":"NodeParagraph","Properties":{"id":"20260809200341-1jsk4bb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"方案的替代选择是什么？为什么没选？"}]}]},{"ID":"20260809200341-t6pp327","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-t6pp327","updated":"20260809200341"},"Children":[{"ID":"20260809200341-bkojt81","Type":"NodeParagraph","Properties":{"id":"20260809200341-bkojt81","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"失败和超时如何处理？"}]}]},{"ID":"20260809200341-osfy6ge","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-osfy6ge","updated":"20260809200341"},"Children":[{"ID":"20260809200341-fx4ckwa","Type":"NodeParagraph","Properties":{"id":"20260809200341-fx4ckwa","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"并发、内存、磁盘或网络边界在哪里？"}]}]},{"ID":"20260809200341-0vk7sf1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-0vk7sf1","updated":"20260809200341"},"Children":[{"ID":"20260809200341-b6ow9qh","Type":"NodeParagraph","Properties":{"id":"20260809200341-b6ow9qh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"如何测试，如何证明结果可信？"}]}]},{"ID":"20260809200341-lfebzd7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-lfebzd7","updated":"20260809200341"},"Children":[{"ID":"20260809200341-n958djd","Type":"NodeParagraph","Properties":{"id":"20260809200341-n958djd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前方案的不足和下一步是什么？"}]}]}]},{"ID":"20260809200341-p3739bi","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-p3739bi","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"回答时要避免"}]},{"ID":"20260809200341-91c8kog","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-91c8kog","updated":"20260809200341"},"Children":[{"ID":"20260809200341-48a8u1z","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-48a8u1z","updated":"20260809200341"},"Children":[{"ID":"20260809200341-qapnlp4","Type":"NodeParagraph","Properties":{"id":"20260809200341-qapnlp4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把“用了 MCP / Flutter / JSONL”当成技术难点。"}]}]},{"ID":"20260809200341-eebw2jt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-eebw2jt","updated":"20260809200341"},"Children":[{"ID":"20260809200341-s0e5heu","Type":"NodeParagraph","Properties":{"id":"20260809200341-s0e5heu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把没有真实数据支撑的性能提升说成确定指标。"}]}]},{"ID":"20260809200341-xxmfq1x","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-xxmfq1x","updated":"20260809200341"},"Children":[{"ID":"20260809200341-fx7pjpx","Type":"NodeParagraph","Properties":{"id":"20260809200341-fx7pjpx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把 LLM 的输出直接说成根因结论。"}]}]},{"ID":"20260809200341-2x0g0ro","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-2x0g0ro","updated":"20260809200341"},"Children":[{"ID":"20260809200341-xncq8tz","Type":"NodeParagraph","Properties":{"id":"20260809200341-xncq8tz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把客户端异步写成“开了线程”，混淆 Future、isolate 和线程。"}]}]},{"ID":"20260809200341-a45v8iq","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-a45v8iq","updated":"20260809200341"},"Children":[{"ID":"20260809200341-7o3xr7h","Type":"NodeParagraph","Properties":{"id":"20260809200341-7o3xr7h","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"把服务端的资源回收责任推给客户端。"}]}]},{"ID":"20260809200341-81o605e","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-81o605e","updated":"20260809200341"},"Children":[{"ID":"20260809200341-zzsbdwx","Type":"NodeParagraph","Properties":{"id":"20260809200341-zzsbdwx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"同一个问题换个说法重复回答，导致项目显得单薄。"}]}]}]},{"ID":"20260809200341-ohl2y3w","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-ohl2y3w","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4. 30 秒项目追问版"}]},{"ID":"20260809200341-slk88ii","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-slk88ii","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"被问：你在项目里最有价值的工作是什么？"}]},{"ID":"20260809200341-xplrysh","Type":"NodeParagraph","Properties":{"id":"20260809200341-xplrysh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"回答："}]},{"ID":"20260809200341-du2x44y","Type":"NodeParagraph","Properties":{"id":"20260809200341-du2x44y","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我做的重点不是把几个 API 串起来，而是把 Crash 分析中最容易失控的边界工程化：底层处理 CDB 的阻塞、命令边界、session 回收和大文件去重；客户端处理批量输入、并发窗口、候选压缩、证据与规则分离；统计服务处理幂等、JSONL 与内存索引一致性以及反馈口径。三层组合起来，才能把一次人工排查变成可重复、可解释、可复盘的流程。"}]},{"ID":"20260809200341-vekietw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-vekietw","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"被问：你最大的不足是什么？"}]},{"ID":"20260809200341-w0b32cx","Type":"NodeParagraph","Properties":{"id":"20260809200341-w0b32cx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"回答："}]},{"ID":"20260809200341-0kxmgds","Type":"NodeParagraph","Properties":{"id":"20260809200341-0kxmgds","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当前方案仍然偏内部工具：mcp-windbg 的鉴权和危险命令控制、stats server 的多实例一致性、客户端的可恢复任务和系统化指标都还有演进空间。我已经能明确指出这些不足对应的风险和改造方向，例如状态机、任务队列、数据库事务、schema version、outbox 和可观测性，而不是把当前实现包装成没有边界的生产系统。"}]},{"ID":"20260809200341-djoffbo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-djoffbo","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"被问：你从这段实习中学到了什么？"}]},{"ID":"20260809200341-w1l4ahr","Type":"NodeParagraph","Properties":{"id":"20260809200341-w1l4ahr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"回答："}]},{"ID":"20260809200341-p4xjexs","Type":"NodeParagraph","Properties":{"id":"20260809200341-p4xjexs","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我最大的收获是理解了“能跑”和“可依赖”的区别。一个内部工具要真正提高排障效率，除了主流程，还要处理输入不可信、资源有限、网络失败、结果不确定和后续反馈。通过这三个项目，我把进程封装、异步编排、规则归因、轻量存储和数据闭环串成了一个完整的工程视角。"}]},{"ID":"20260809200341-92fwi04","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-92fwi04","updated":"20260809200341"}},{"ID":"20260809200341-yqjfsqf","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-yqjfsqf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十四、按面试轮次的复习顺序"}]},{"ID":"20260809200341-it6n369","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-it6n369","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"一面：先保证主链路讲清楚"}]},{"ID":"20260809200341-s2syluz","Type":"NodeParagraph","Properties":{"id":"20260809200341-s2syluz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"重点背：三个项目关系、每个项目一句话、一次请求流程、自己的职责、一个最难问题、一个异常场景。此时不要主动展开所有类名，先让面试官相信你确实理解系统。"}]},{"ID":"20260809200341-gk9zn3s","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-gk9zn3s","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"二面：重点准备取舍和边界"}]},{"ID":"20260809200341-04iof9o","Type":"NodeParagraph","Properties":{"id":"20260809200341-04iof9o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"重点背：为什么 MCP、为什么 session 复用、为什么 marker、为什么并发 2、为什么规则优先于 LLM、为什么 JSONL、锁如何保证一致性、服务不可用如何降级。每题都要能说出代价和后续方案。"}]},{"ID":"20260809200341-sf9engh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-sf9engh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"交叉面：准备基础知识映射"}]},{"ID":"20260809200341-pptc0o7","Type":"NodeParagraph","Properties":{"id":"20260809200341-pptc0o7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"将项目映射到基础知识：CDB 子进程对应进程间通信和阻塞 IO；线程池对应异步任务隔离；SHA1 对应哈希和幂等；JSONL 对应日志结构和持久化；内存索引对应空间换时间；锁对应并发一致性；MCP/REST 对应协议和接口抽象；规则引擎对应确定性状态处理。"}]},{"ID":"20260809200341-ovkx48z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260809200341-ovkx48z","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"反问面试官的高质量问题"}]},{"ID":"20260809200341-wl109ig","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-wl109ig","updated":"20260809200341"},"Children":[{"ID":"20260809200341-pyn1mg1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-pyn1mg1","updated":"20260809200341"},"Children":[{"ID":"20260809200341-c2m95i4","Type":"NodeParagraph","Properties":{"id":"20260809200341-c2m95i4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"团队目前更关注 Crash 分析的覆盖率、分析耗时，还是反馈有效率？"}]}]},{"ID":"20260809200341-30cyejl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-30cyejl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-4igucga","Type":"NodeParagraph","Properties":{"id":"20260809200341-4igucga","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这类内部工具后续是否会向统一调试基础设施或任务平台演进？"}]}]},{"ID":"20260809200341-xr0j8vt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-xr0j8vt","updated":"20260809200341"},"Children":[{"ID":"20260809200341-lx46lqa","Type":"NodeParagraph","Properties":{"id":"20260809200341-lx46lqa","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"对实习生来说，最希望继续深入的是调试器底层、客户端工程，还是数据闭环？"}]}]}]},{"ID":"20260809200341-8bst7u6","Type":"NodeParagraph","Properties":{"id":"20260809200341-8bst7u6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"这些问题能体现你关注真实业务指标和长期演进，不会把反问变成泛泛的“团队氛围怎么样”。"}]},{"ID":"20260809200341-y6vxxlq","Type":"NodeParagraph","Properties":{"id":"20260809200341-y6vxxlq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我认为这套项目最重要的工程点是：没有把 AI 当黑盒，而是用 CDB 采证、本地规则归因、统计反馈闭环，保证结果可解释、可复现、可持续优化。"}]},{"ID":"20260809200341-8smhin5","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-8smhin5","updated":"20260809200341"}},{"ID":"20260809200341-q1m4i1j","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-q1m4i1j","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十五、专项补充题库：mcp-windbg 的底层实现与运维"}]},{"ID":"20260809200341-3qhyg2j","Type":"NodeBlockquote","Properties":{"id":"20260809200341-3qhyg2j","updated":"20260809200341"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260809200341-av2zpzo","Type":"NodeParagraph","Properties":{"id":"20260809200341-av2zpzo","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"编号说明：本节及后续两个“专项补充题库”沿用各自项目的局部编号；复习定位请以“项目名 + 问题标题”为准，不以单独的 Q 编号跨章节检索。"}]}]},{"ID":"20260809200341-sszqg7d","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-sszqg7d","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q49：ASGI handler 把阻塞任务交给线程池后，为什么还要限制请求数？"}]},{"ID":"20260809200341-6bsxemv","Type":"NodeParagraph","Properties":{"id":"20260809200341-6bsxemv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-r258uaq","Type":"NodeParagraph","Properties":{"id":"20260809200341-r258uaq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"线程池只避免阻塞事件循环，不会让 CPU、内存和 CDB 变成无限资源。若请求数无限进入 executor，任务会在内存排队，超时请求也可能继续消耗资源。"}]},{"ID":"20260809200341-06wnmn2","Type":"NodeParagraph","Properties":{"id":"20260809200341-06wnmn2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-o3o6nzf","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-o3o6nzf","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ms2ozwq","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-ms2ozwq","updated":"20260809200341"},"Children":[{"ID":"20260809200341-zi98mvb","Type":"NodeParagraph","Properties":{"id":"20260809200341-zi98mvb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"入口层通过容量限制或信号量形成背压。"}]}]},{"ID":"20260809200341-1giz9i5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-1giz9i5","updated":"20260809200341"},"Children":[{"ID":"20260809200341-5j5qa1h","Type":"NodeParagraph","Properties":{"id":"20260809200341-5j5qa1h","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"返回“服务繁忙”比无限排队更可预测。"}]}]}]},{"ID":"20260809200341-1pzwdyu","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-1pzwdyu","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q50：线程池大小和 CDB session 数是否一定相等？"}]},{"ID":"20260809200341-lv8mxdv","Type":"NodeParagraph","Properties":{"id":"20260809200341-lv8mxdv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-l0f1yyk","Type":"NodeParagraph","Properties":{"id":"20260809200341-l0f1yyk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不一定相等，但应有明确关系。一个正在执行命令的 session 需要一个工作线程；空闲 session 只占进程资源，不持续占线程。"}]},{"ID":"20260809200341-xjsi1ao","Type":"NodeParagraph","Properties":{"id":"20260809200341-xjsi1ao","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-c88gigj","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-c88gigj","updated":"20260809200341"},"Children":[{"ID":"20260809200341-zbj818e","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-zbj818e","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ld825q7","Type":"NodeParagraph","Properties":{"id":"20260809200341-ld825q7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"线程池过小会让可用 session 排队。"}]}]},{"ID":"20260809200341-ptxma35","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-ptxma35","updated":"20260809200341"},"Children":[{"ID":"20260809200341-5j84z6g","Type":"NodeParagraph","Properties":{"id":"20260809200341-5j84z6g","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"线程池过大则可能让多个重命令争抢机器资源。"}]}]}]},{"ID":"20260809200341-3thk5qo","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-3thk5qo","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q51：如何避免子进程 stderr 管道写满导致死锁？"}]},{"ID":"20260809200341-hhnvmcn","Type":"NodeParagraph","Properties":{"id":"20260809200341-hhnvmcn","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-syimsxq","Type":"NodeParagraph","Properties":{"id":"20260809200341-syimsxq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"子进程同时写 stdout 和 stderr 时，如果父进程只读取其中一条管道，另一条缓冲区写满后会阻塞子进程。封装层必须并发消费两条流，或把 stderr 合并到 stdout 后统一解析。"}]},{"ID":"20260809200341-lb828zx","Type":"NodeParagraph","Properties":{"id":"20260809200341-lb828zx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-xwjqk39","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-xwjqk39","updated":"20260809200341"},"Children":[{"ID":"20260809200341-vv8bs6z","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-vv8bs6z","updated":"20260809200341"},"Children":[{"ID":"20260809200341-431l2at","Type":"NodeParagraph","Properties":{"id":"20260809200341-431l2at","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能只在命令失败时才去读取 stderr。"}]}]},{"ID":"20260809200341-d6nq7wd","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-d6nq7wd","updated":"20260809200341"},"Children":[{"ID":"20260809200341-jd2yoh7","Type":"NodeParagraph","Properties":{"id":"20260809200341-jd2yoh7","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"返回结果中仍应保留 stderr 的来源信息。"}]}]}]},{"ID":"20260809200341-eckpq8c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-eckpq8c","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q52：为什么要记录 CDB 命令白名单的版本？"}]},{"ID":"20260809200341-gy1s6ei","Type":"NodeParagraph","Properties":{"id":"20260809200341-gy1s6ei","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-b88fcxn","Type":"NodeParagraph","Properties":{"id":"20260809200341-b88fcxn","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"白名单本质上是安全和兼容性策略。工具行为变化时，历史审计需要知道当时允许了哪些命令、参数规则是什么。"}]},{"ID":"20260809200341-qhkrodl","Type":"NodeParagraph","Properties":{"id":"20260809200341-qhkrodl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-39u546m","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-39u546m","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ko95a6v","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-ko95a6v","updated":"20260809200341"},"Children":[{"ID":"20260809200341-de3l6gx","Type":"NodeParagraph","Properties":{"id":"20260809200341-de3l6gx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"命令策略版本可写入调用日志。"}]}]},{"ID":"20260809200341-31qdyvl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-31qdyvl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-rdmmr6a","Type":"NodeParagraph","Properties":{"id":"20260809200341-rdmmr6a","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"修改白名单应经过回归样本验证。"}]}]}]},{"ID":"20260809200341-qwk4xrn","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-qwk4xrn","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q53：上传接口为什么需要 Content-Length 或大小限制？"}]},{"ID":"20260809200341-enm54h4","Type":"NodeParagraph","Properties":{"id":"20260809200341-enm54h4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-x0od852","Type":"NodeParagraph","Properties":{"id":"20260809200341-x0od852","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"它能在落盘前拒绝明显超配额请求，降低被大文件拖垮的概率。即使没有 Content-Length，也要在流式读取过程中累计字节并及时中断。"}]},{"ID":"20260809200341-6lmozw0","Type":"NodeParagraph","Properties":{"id":"20260809200341-6lmozw0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-7sdcf50","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7sdcf50","updated":"20260809200341"},"Children":[{"ID":"20260809200341-p02vuze","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-p02vuze","updated":"20260809200341"},"Children":[{"ID":"20260809200341-lm73fat","Type":"NodeParagraph","Properties":{"id":"20260809200341-lm73fat","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"限制应同时有单文件、单用户和全局维度。"}]}]},{"ID":"20260809200341-whbg490","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-whbg490","updated":"20260809200341"},"Children":[{"ID":"20260809200341-xwxwp7w","Type":"NodeParagraph","Properties":{"id":"20260809200341-xwxwp7w","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"拒绝时应清理临时文件和 token 状态。"}]}]}]},{"ID":"20260809200341-arpyylh","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-arpyylh","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q54：上传完成后为什么不能立刻信任文件？"}]},{"ID":"20260809200341-h5etz1a","Type":"NodeParagraph","Properties":{"id":"20260809200341-h5etz1a","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-ajsay1u","Type":"NodeParagraph","Properties":{"id":"20260809200341-ajsay1u","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"上传成功只表示字节写完，不代表文件一定可被 CDB 打开，也不代表它是目标格式。后续仍要做格式验证和可读性验证。"}]},{"ID":"20260809200341-zgcq107","Type":"NodeParagraph","Properties":{"id":"20260809200341-zg