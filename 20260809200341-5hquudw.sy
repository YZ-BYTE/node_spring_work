260809200341"},"Children":[{"Type":"NodeText","Data":"输出展示和服务端日志应使用不同脱敏策略。"}]}]},{"ID":"20260809200341-vpuqfsu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-vpuqfsu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-fd3ogoy","Type":"NodeParagraph","Properties":{"id":"20260809200341-fd3ogoy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"访问调试日志也需要审计。"}]}]}]},{"ID":"20260809200341-0e2quow","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-0e2quow","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q61：为什么上传 token 需要过期时间？"}]},{"ID":"20260809200341-ndeettv","Type":"NodeParagraph","Properties":{"id":"20260809200341-ndeettv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-j0za16h","Type":"NodeParagraph","Properties":{"id":"20260809200341-j0za16h","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"没有过期时间的 token 一旦泄露就长期可用，也会让临时状态无限积累。短时过期把资源释放和安全边界前移。"}]},{"ID":"20260809200341-fb4a1wj","Type":"NodeParagraph","Properties":{"id":"20260809200341-fb4a1wj","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-kq63o0w","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-kq63o0w","updated":"20260809200341"},"Children":[{"ID":"20260809200341-4etntct","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-4etntct","updated":"20260809200341"},"Children":[{"ID":"20260809200341-iq1y0j2","Type":"NodeParagraph","Properties":{"id":"20260809200341-iq1y0j2","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"过期清理应和临时目录清理联动。"}]}]},{"ID":"20260809200341-zjrtl01","Type":"NodeListItem",