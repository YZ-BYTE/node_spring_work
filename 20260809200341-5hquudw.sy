true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rd54uht","updated":"20260809200341"},"Children":[{"ID":"20260809200341-9u899i0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-9u899i0","updated":"20260809200341"},"Children":[{"ID":"20260809200341-d0eqbkx","Type":"NodeParagraph","Properties":{"id":"20260809200341-d0eqbkx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"时间窗口匹配应容忍时钟偏差。"}]}]},{"ID":"20260809200341-t8tamth","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-t8tamth","updated":"20260809200341"},"Children":[{"ID":"20260809200341-976h2d5","Type":"NodeParagraph","Properties":{"id":"20260809200341-976h2d5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"报告中可显示原始时间和归一化时间。"}]}]}]},{"ID":"20260809200341-oe8yojc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-oe8yojc","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q65：为什么需要分析版本而不仅是应用版本？"}]},{"ID":"20260809200341-vc4d14z","Type":"NodeParagraph","Properties":{"id":"20260809200341-vc4d14z","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-5u3vteg","Type":"NodeParagraph","Properties":{"id":"20260809200341-5u3vteg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"相同 dump 在不同 CDB、符号、规则和客户端版本下可能得到不同结果。分析版本能帮助复现结论和比较规则迭代效果。"}]},{"ID":"20260809200341-vmnp63m","Type":"NodeParagraph","Properties":{"id":"20260809200341-vmnp63m","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-jc1uokw","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-jc1uokw","updated":"20260809200341"},"Children":[{"ID":"20260809200341-rxhyltk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rxhyltk","updated":"20260809200341"},"Children":[{"ID":"20260809200341-z8ia79v","Type":"NodeParagraph","Properties":{"id":"20260809200341-z8ia79v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"版本字段应覆盖采集器和规则器。"}]}]},{"ID":"20260809200341-qhuasd2","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-qhuasd2","updated":"20260809200341"},"Children":[{"ID":"20260809200341-gyx82dg","Type":"NodeParagraph","Properties":{"id":"20260809200341-gyx82dg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"缓存 key 也应包含影响结果的版本。"}]}]}]},{"ID":"20260809200341-kmc2pbf","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-kmc2pbf","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q66：什么是“代表 dump”，如何选择？"}]},{"ID":"20260809200341-hsfmy7j","Type":"NodeParagraph","Properties":{"id":"20260809200341-hsfmy7j","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-phaoy8w","Type":"NodeParagraph","Properties":{"id":"20260809200341-phaoy8w","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"代表 dump 是一个签名组中最适合做深度采证的样本，通常优先选择符号更完整、时间更新、文件可读且 quick triage 证据更强的样本。它不等于该组唯一真相。"}]},{"ID":"20260809200341-iyjglki","Type":"NodeParagraph","Properties":{"id":"20260809200341-iyjglki","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-eg3x0jn","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-eg3x0jn","updated":"20260809200341"},"Children":[{"ID":"20260809200341-isprlup","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-isprlup","updated":"20260809200341"},"Children":[{"ID":"20260809200341-jrfhd86","Type":"NodeParagraph","Properties":{"id":"20260809200341-jrfhd86","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"报告要展示该代表的选择依据。"}]}]},{"ID":"20260809200341-abd26gl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-abd26gl","updated":"20260809200341"},"Children":[{"ID":"20260809200341-d21zvwd","Type":"NodeParagraph","Properties":{"id":"20260809200341-d21zvwd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"组内差异明显时应拆组而不是强选代表。"}]}]}]},{"ID":"20260809200341-hwsuvss","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-hwsuvss","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q67：如何衡量预筛规则是否有效？"}]},{"ID":"20260809200341-e056q9s","Type":"NodeParagraph","Properties":{"id":"20260809200341-e056q9s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-zct6kdz","Type":"NodeParagraph","Properties":{"id":"20260809200341-zct6kdz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"用人工标注样本统计 crash、suspected、non-crash 的混淆矩阵，并跟踪预筛后进入深度分析的比例和最终确认率。只看筛掉多少文件会鼓励过度过滤。"}]},{"ID":"20260809200341-cl1ty2e","Type":"NodeParagraph","Properties":{"id":"20260809200341-cl1ty2e","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-6jquelr","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-6jquelr","updated":"20260809200341"},"Children":[{"ID":"20260809200341-k9uyjoc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-k9uyjoc","updated":"20260809200341"},"Children":[{"ID":"20260809200341-0nhdfky","Type":"NodeParagraph","Properties":{"id":"20260809200341-0nhdfky","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"suspected 的转化率是重要指标。"}]}]},{"ID":"20260809200341-bdcbih0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-bdcbih0","updated":"20260809200341"},"Children":[{"ID":"20260809200341-nf9qzez","Type":"NodeParagraph","Properties":{"id":"20260809200341-nf9qzez","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"样本集应覆盖手动 dump 和异常 dump。"}]}]}]},{"ID":"20260809200341-6lw9t3j","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-6lw9t3j","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q68：如何衡量签名分组是否有效？"}]},{"ID":"20260809200341-znxy62x","Type":"NodeParagraph","Properties":{"id":"20260809200341-znxy62x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-0h30qsk","Type":"NodeParagraph","Properties":{"id":"20260809200341-0h30qsk","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"观察每组平均样本数、代表样本和组内样本的分类一致率，以及误合并人工复核率。分组目标是减少重复深度分析，不能以牺牲根因区分为代价。"}]},{"ID":"20260809200341-xd92k54","Type":"NodeParagraph","Properties":{"id":"20260809200341-xd92k54","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-pwu01mg","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-pwu01mg","updated":"20260809200341"},"Children":[{"ID":"20260809200341-553y39c","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-553y39c","updated":"20260809200341"},"Children":[{"ID":"20260809200341-z3tw9rc","Type":"NodeParagraph","Properties":{"id":"20260809200341-z3tw9rc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"精确签名和宽松签名要分别统计。"}]}]},{"ID":"20260809200341-iabw7l1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-iabw7l1","updated":"20260809200341"},"Children":[{"ID":"20260809200341-lkx7wxu","Type":"NodeParagraph","Properties":{"id":"20260809200341-lkx7wxu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"规则版本改变后应重新评估分组质量。"}]}]}]},{"ID":"20260809200341-5h55mq5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-5h55mq5","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q69：如何处理服务端返回字段缺失或新增？"}]},{"ID":"20260809200341-1689boz","Type":"NodeParagraph","Properties":{"id":"20260809200341-1689boz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-sykn4wr","Type":"NodeParagraph","Properties":{"id":"20260809200341-sykn4wr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"解析器对必填字段严格校验，对可选新增字段忽略或保留扩展区。收到缺失必填字段时返回协议错误而不是 NPE 式崩溃。"}]},{"ID":"20260809200341-blwyy02","Type":"NodeParagraph","Properties":{"id":"20260809200341-blwyy02","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-yzay7sc","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-yzay7sc","updated":"20260809200341"},"Children":[{"ID":"20260809200341-emec6ev","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-emec6ev","updated":"20260809200341"},"Children":[{"ID":"20260809200341-i0ttrto","Type":"NodeParagraph","Properties":{"id":"20260809200341-i0ttrto","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"客户端应记录服务端版本和响应摘要。"}]}]},{"ID":"20260809200341-7jez3q0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7jez3q0","updated":"20260809200341"},"Children":[{"ID":"20260809200341-3b4epy6","Type":"NodeParagraph","Properties":{"id":"20260809200341-3b4epy6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"契约测试覆盖旧服务端和新服务端组合。"}]}]}]},{"ID":"20260809200341-rbgh1dg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-rbgh1dg","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q70：为什么不能在 UI 层拼接所有业务错误？"}]},{"ID":"20260809200341-q64cr8s","Type":"NodeParagraph","Properties":{"id":"20260809200341-q64cr8s","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-z6atcnz","Type":"NodeParagraph","Properties":{"id":"20260809200341-z6atcnz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"底层错误缺少用户上下文，UI 又不应该理解 CDB 和 HTTP 细节。应在业务边界把错误转为稳定的领域错误，再由 UI 映射为用户可读提示。"}]},{"ID":"20260809200341-beit2zu","Type":"NodeParagraph","Properties":{"id":"20260809200341-beit2zu","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-yb43w08","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-yb43w08","updated":"20260809200341"},"Children":[{"ID":"20260809200341-anppsl1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-anppsl1","updated":"20260809200341"},"Children":[{"ID":"20260809200341-let64id","Type":"NodeParagraph","Properties":{"id":"20260809200341-let64id","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"用户提示避免暴露内部路径和 token。"}]}]},{"ID":"20260809200341-eo8uubb","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-eo8uubb","updated":"20260809200341"},"Children":[{"ID":"20260809200341-np86rgx","Type":"NodeParagraph","Properties":{"id":"20260809200341-np86rgx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"调试详情可复制但默认折叠。"}]}]}]},{"ID":"20260809200341-z51care","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-z51care","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q71：怎样设计日志级别以方便现场问题排查？"}]},{"ID":"20260809200341-ogze2ko","Type":"NodeParagraph","Properties":{"id":"20260809200341-ogze2ko","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-m1rm22y","Type":"NodeParagraph","Properties":{"id":"20260809200341-m1rm22y","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"正常运行记录阶段、task id、耗时和结果摘要；debug 记录请求参数摘要和命令名；error 记录堆栈和可复现上下文，但不记录敏感原文。不同级别不能只靠打印更多字符串。"}]},{"ID":"20260809200341-fw7earp","Type":"NodeParagraph","Properties":{"id":"20260809200341-fw7earp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-6nlcv1v","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-6nlcv1v","updated":"20260809200341"},"Children":[{"ID":"20260809200341-2r9u5vg","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-2r9u5vg","updated":"20260809200341"},"Children":[{"ID":"20260809200341-yd6lddm","Type":"NodeParagraph","Properties":{"id":"20260809200341-yd6lddm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"每条日志要能关联同一个 task id。"}]}]},{"ID":"20260809200341-312fhp0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-312fhp0","updated":"20260809200341"},"Children":[{"ID":"20260809200341-oydvcsv","Type":"NodeParagraph","Properties":{"id":"20260809200341-oydvcsv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"本地日志需要轮转和大小限制。"}]}]}]},{"ID":"20260809200341-gjuzzkv","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-gjuzzkv","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q72：为什么要给分析设置总超时和分阶段超时？"}]},{"ID":"20260809200341-chrdnrl","Type":"NodeParagraph","Properties":{"id":"20260809200341-chrdnrl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-w6h8f9n","Type":"NodeParagraph","Properties":{"id":"20260809200341-w6h8f9n","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"总超时防止任务无限占用 UI 和资源，分阶段超时能定位是解压、上传还是 CDB 命令慢。只设总超时会让用户无法判断卡在哪里。"}]},{"ID":"20260809200341-0rkacx9","Type":"NodeParagraph","Properties":{"id":"20260809200341-0rkacx9","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-7hopr40","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7hopr40","updated":"20260809200341"},"Children":[{"ID":"20260809200341-w5ralpe","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-w5ralpe","updated":"20260809200341"},"Children":[{"ID":"20260809200341-i8908i6","Type":"NodeParagraph","Properties":{"id":"20260809200341-i8908i6","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"超时值应基于真实分位数设置。"}]}]},{"ID":"20260809200341-gd2ay80","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-gd2ay80","updated":"20260809200341"},"Children":[{"ID":"20260809200341-6u3du73","Type":"NodeParagraph","Properties":{"id":"20260809200341-6u3du73","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"超时后也要执行 session 和临时目录清理。"}]}]}]},{"ID":"20260809200341-40y1elj","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-40y1elj","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q73：如何处理用户关闭窗口时仍在运行的任务？"}]},{"ID":"20260809200341-twpjmzq","Type":"NodeParagraph","Properties":{"id":"20260809200341-twpjmzq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-schuypd","Type":"NodeParagraph","Properties":{"id":"20260809200341-schuypd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"窗口生命周期结束时触发取消信号，停止本地调度、取消可取消请求，并尽力关闭已知 session。不能依赖对象析构做异步清理。"}]},{"ID":"20260809200341-q48qshg","Type":"NodeParagraph","Properties":{"id":"20260809200341-q48qshg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-nb2fst7","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-nb2fst7","updated":"20260809200341"},"Children":[{"ID":"20260809200341-tp6yata","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-tp6yata","updated":"20260809200341"},"Children":[{"ID":"20260809200341-on4uqp1","Type":"NodeParagraph","Properties":{"id":"20260809200341-on4uqp1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"必要时将任务交给应用级 coordinator 管理。"}]}]},{"ID":"20260809200341-abwdq6z","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-abwdq6z","updated":"20260809200341"},"Children":[{"ID":"20260809200341-obljl6f","Type":"NodeParagraph","Properties":{"id":"20260809200341-obljl6f","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"本地归档应标记为 cancelled 而不是 completed。"}]}]}]},{"ID":