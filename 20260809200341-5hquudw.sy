m":-1},"Properties":{"id":"20260809200341-jbmunif","updated":"20260809200341"},"Children":[{"ID":"20260809200341-188q2i4","Type":"NodeParagraph","Properties":{"id":"20260809200341-188q2i4","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"HTTP 状态码表达类别，业务 code 表达细节。"}]}]}]},{"ID":"20260809200341-d4ufeor","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-d4ufeor","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q63：为什么 session id 必须不可预测？"}]},{"ID":"20260809200341-98qqcg1","Type":"NodeParagraph","Properties":{"id":"20260809200341-98qqcg1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-hkl1y71","Type":"NodeParagraph","Properties":{"id":"20260809200341-hkl1y71","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"若 session id 连续递增，其他调用方可能枚举并访问别人的调试上下文。应使用高熵随机值，并在服务端同时校验所属身份。"}]},{"ID":"20260809200341-fceiakg","Type":"NodeParagraph","Properties":{"id":"20260809200341-fceiakg","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-uox0nc2","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-uox0nc2","updated":"20260809200341"},"Children":[{"ID":"20260809200341-d59bdlm","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-d59bdlm","updated":"20260809200341"},"Children":[{"ID":"20260809200341-kds0aio","Type":"NodeParagraph","Properties":{"id":"20260809200341-kds0aio","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"随机 id 不是鉴权的替代品。"}]}]},{"ID":"20260809200341-r89nab8","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-r89nab8","updated":"20260809200341"},"Children":[{"ID":"20260809200341-sy23umv","Type":"NodeParagraph","Properties":{"id":"20260809200341-sy23umv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"session 查询和关闭也必须做所有权校验。"}]}]}]},{"ID":"20260809200341-2ykvo16","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-2ykvo16","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q64：如何做 CDB 服务的容量压测？"}]},{"ID":"20260809200341-ya3hdyh","Type":"NodeParagraph","Properties":{"id":"20260809200341-ya3hdyh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-qdjy6wd","Type":"NodeParagraph","Properties":{"id":"20260809200341-qdjy6wd","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"准备不同大小、不同符号完整度的样例 dump，逐步增加上传并发和命令并发，记录 CPU、内存、磁盘、队列长度和 P95。压测要覆盖超时和取消，而不仅是成功路径。"}]},{"ID":"20260809200341-56e2c0l","Type":"NodeParagraph","Properties":{"id":"20260809200341-56e2c0l","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-sikl4b0","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-sikl4b0","updated":"20260809200341"},"Children":[{"ID":"20260809200341-8gy9loi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-8gy9loi","updated":"20260809200341"},"Children":[{"ID":"20260809200341-9ij7no1","Type":"NodeParagraph","Properties":{"id":"20260809200341-9ij7no1","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"找到拐点后设置保守阈值。"}]}]},{"ID":"20260809200341-se10rxw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-se10rxw","updated":"20260809200341"},"Children":[{"ID":"20260809200341-qa97h02","Type":"NodeParagraph","Properties":{"id":"20260809200341-qa97h02","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"区分冷缓存和热缓存结果。"}]}]}]},{"ID":"20260809200341-rv863bm","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-rv863bm","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q65：什么情况下应该把 CDB 分析改成任务队列？"}]},{"ID":"20260809200341-e4v1tbb","Type":"NodeParagraph","Properties":{"id":"20260809200341-e4v1tbb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6ywrv4d","Type":"NodeParagraph","Properties":{"id":"20260809200341-6ywrv4d","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"当命令耗时长、并发请求多、需要排队、断线恢复或跨机器调度时，同步 HTTP 请求会变得脆弱。此时创建分析任务并异步查询状态更合适。"}]},{"ID":"20260809200341-axwou6x","Type":"NodeParagraph","Properties":{"id":"20260809200341-axwou6x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-k9mpqdu","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-k9mpqdu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-tl0yvaz","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-tl0yvaz","updated":"20260809200341"},"Children":[{"ID":"20260809200341-mnywlvl","Type":"NodeParagraph","Properties":{"id":"20260809200341-mnywlvl","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"quick triage 仍可保留同步快速接口。"}]}]},{"ID":"20260809200341-rg9allm","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rg9allm","updated":"20260809200341"},"Children":[{"ID":"20260809200341-pdcs61x","Type":"NodeParagraph","Properties":{"id":"20260809200341-pdcs61x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"深度分析可使用队列和独立 worker。"}]}]}]},{"ID":"20260809200341-me6h6ts","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-me6h6ts","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q66：如果需要支持优先级，如何定义？"}]},{"ID":"20260809200341-jwlqi7x","Type":"NodeParagraph","Properties":{"id":"20260809200341-jwlqi7x","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-962etxc","Type":"NodeParagraph","Properties":{"id":"20260809200341-962etxc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"可按人工紧急排障、普通交互分析、离线批量回放分级，并给每个用户设置公平队列，避免一个大任务占满资源。优先级不是简单插队，还要防止低优先级永久饥饿。"}]},{"ID":"20260809200341-dljb40j","Type":"NodeParagraph","Properties":{"id":"20260809200341-dljb40j","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-9nfi8p6","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-9nfi8p6","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ha4t79b","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-ha4t79b","updated":"20260809200341"},"Children":[{"ID":"20260809200341-7bbb0kh","Type":"NodeParagraph","Properties":{"id":"20260809200341-7bbb0kh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"明确最大等待时间和配额。"}]}]},{"ID":"20260809200341-kvx2eyk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-kvx2eyk","updated":"20260809200341"},"Children":[{"ID":"20260809200341-f6iugxy","Type":"NodeParagraph","Properties":{"id":"20260809200341-f6iugxy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"记录优先级来源，避免人为滥用。"}]}]}]},{"ID":"20260809200341-v0qvdl2","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-v0qvdl2","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q67：为什么需要健康检查而不只是端口存活检查？"}]},{"ID":"20260809200341-4b1ubbc","Type":"NodeParagraph","Properties":{"id":"20260809200341-4b1ubbc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-6pfabf5","Type":"NodeParagraph","Properties":{"id":"20260809200341-6pfabf5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"端口能响应不代表 CDB 路径、临时目录、线程池和符号目录正常。健康检查应至少验证关键依赖配置、磁盘水位和可用容量。"}]},{"ID":"20260809200341-2jzlsqi","Type":"NodeParagraph","Properties":{"id":"20260809200341-2jzlsqi","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-7tnbbps","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-7tnbbps","updated":"20260809200341"},"Children":[{"ID":"20260809200341-tqqn567","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-tqqn567","updated":"20260809200341"},"Children":[{"ID":"20260809200341-89wc3te","Type":"NodeParagraph","Properties":{"id":"20260809200341-89wc3te","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"深度健康检查不应频繁启动真实 CDB。"}]}]},{"ID":"20260809200341-cvdle2c","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-cvdle2c","updated":"20260809200341"},"Children":[{"ID":"20260809200341-agd6a7o","Type":"NodeParagraph","Properties":{"id":"20260809200341-agd6a7o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"可分 readiness 和 liveness 两类检查。"}]}]}]},{"ID":"20260809200341-ljvoy59","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-ljvoy59","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q68：这个服务最重要的故障演练是什么？"}]},{"ID":"20260809200341-y7o1wyv","Type":"NodeParagraph","Properties":{"id":"20260809200341-y7o1wyv","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-n9iim7t","Type":"NodeParagraph","Properties":{"id":"20260809200341-n9iim7t","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"我会演练上传中断、CDB 卡死、符号源不可用、磁盘满、客户端不 close、服务重启和高并发排队。每个演练都要验证资源是否回收、错误是否可理解、是否影响其他用户。"}]},{"ID":"20260809200341-5hw95zc","Type":"NodeParagraph","Properties":{"id":"20260809200341-5hw95zc","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-9dmuz9f","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-9dmuz9f","updated":"20260809200341"},"Children":[{"ID":"20260809200341-b4rfvxu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-b4rfvxu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-4u8rwqq","Type":"NodeParagraph","Properties":{"id":"20260809200341-4u8rwqq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"故障演练能验证 finally 和超时是否真有效。"}]}]},{"ID":"20260809200341-a36b1dn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-a36b1dn","updated":"20260809200341"},"Children":[{"ID":"20260809200341-acp1buw","Type":"NodeParagraph","Properties":{"id":"20260809200341-acp1buw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"结果要沉淀成运行手册而不是一次性测试。"}]}]}]},{"ID":"20260809200341-lxeisk5","Type":"NodeThematicBreak","Properties":{"id":"20260809200341-lxeisk5","updated":"20260809200341"}},{"ID":"20260809200341-63myx6r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260809200341-63myx6r","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"十六、专项补充题库：wxlog_analyze 的交互、质量与演进"}]},{"ID":"20260809200341-zmt4w9g","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-zmt4w9g","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q56：如何避免用户选择错误反馈包后误分析？"}]},{"ID":"20260809200341-a7ur5xf","Type":"NodeParagraph","Properties":{"id":"20260809200341-a7ur5xf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-w1h0vbm","Type":"NodeParagraph","Properties":{"id":"20260809200341-w1h0vbm","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"扫描阶段展示可识别 dump 数量、文件来源和基本时间信息；没有 dump 或格式异常时在深度分析前明确提示。不能仅根据 zip 扩展名就认为输入有效。"}]},{"ID":"20260809200341-sg1oqux","Type":"NodeParagraph","Properties":{"id":"20260809200341-sg1oqux","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-0hnyvwq","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-0hnyvwq","updated":"20260809200341"},"Children":[{"ID":"20260809200341-9m9s9bu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-9m9s9bu","updated":"20260809200341"},"Children":[{"ID":"20260809200341-9oz6p2n","Type":"NodeParagraph","Properties":{"id":"20260809200341-9oz6p2n","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"预览信息应来自扫描结果而不是文件名猜测。"}]}]},{"ID":"20260809200341-t0wo5p3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-t0wo5p3","updated":"20260809200341"},"Children":[{"ID":"20260809200341-1mtw4i5","Type":"NodeParagraph","Properties":{"id":"20260809200341-1mtw4i5","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"用户仍可查看被跳过文件的原因。"}]}]}]},{"ID":"20260809200341-fbuavbw","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-fbuavbw","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q57：为什么 UI 要展示“部分成功”？"}]},{"ID":"20260809200341-ohjie7p","Type":"NodeParagraph","Properties":{"id":"20260809200341-ohjie7p","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-uu6bytq","Type":"NodeParagraph","Properties":{"id":"20260809200341-uu6bytq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"批量输入中一个 dump 上传失败不应掩盖其他已完成结论。部分成功让用户知道哪些样本可用、哪些需要重试，也能帮助排查环境问题。"}]},{"ID":"20260809200341-qudhumq","Type":"NodeParagraph","Properties":{"id":"20260809200341-qudhumq","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-kbsgqzf","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-kbsgqzf","updated":"20260809200341"},"Children":[{"ID":"20260809200341-3gmw1uv","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-3gmw1uv","updated":"20260809200341"},"Children":[{"ID":"20260809200341-24clijb","Type":"NodeParagraph","Properties":{"id":"20260809200341-24clijb","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"结果模型不能只有 success 和 error 两种状态。"}]}]},{"ID":"20260809200341-6viev75","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-6viev75","updated":"20260809200341"},"Children":[{"ID":"20260809200341-x6f5nmy","Type":"NodeParagraph","Properties":{"id":"20260809200341-x6f5nmy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"汇总页应展示成功、跳过和失败数量。"}]}]}]},{"ID":"20260809200341-kn4ra1c","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-kn4ra1c","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q58：如何避免分析报告对客服造成误导？"}]},{"ID":"20260809200341-n28l8d3","Type":"NodeParagraph","Properties":{"id":"20260809200341-n28l8d3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-icl634b","Type":"NodeParagraph","Properties":{"id":"20260809200341-icl634b","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"将“事实证据”“规则推断”“建议话术”分区展示，话术必须与置信度匹配。低置信度或 unable 场景不能输出过度确定的根因描述。"}]},{"ID":"20260809200341-4qrnh73","Type":"NodeParagraph","Properties":{"id":"20260809200341-4qrnh73","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-bei00ye","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-bei00ye","updated":"20260809200341"},"Children":[{"ID":"20260809200341-6vkbcvo","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-6vkbcvo","updated":"20260809200341"},"Children":[{"ID":"20260809200341-165gwq0","Type":"NodeParagraph","Properties":{"id":"20260809200341-165gwq0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"话术模板应版本化和可审核。"}]}]},{"ID":"20260809200341-lfe76as","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-lfe76as","updated":"20260809200341"},"Children":[{"ID":"20260809200341-kihatjo","Type":"NodeParagraph","Properties":{"id":"20260809200341-kihatjo","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"报告应保留人工升级处理入口。"}]}]}]},{"ID":"20260809200341-21xsqil","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-21xsqil","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q59：为什么要把原始输出做截断和摘要？"}]},{"ID":"20260809200341-x7u1u7w","Type":"NodeParagraph","Properties":{"id":"20260809200341-x7u1u7w","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-d4hazcx","Type":"NodeParagraph","Properties":{"id":"20260809200341-d4hazcx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"完整 CDB 输出可能很长、含噪声和潜在敏感信息，直接塞进 UI 会影响可读性和性能。摘要突出异常码、模块和栈，原始内容按需展开。"}]},{"ID":"20260809200341-vsrop79","Type":"NodeParagraph","Properties":{"id":"20260809200341-vsrop79","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-1g5ebp3","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-1g5ebp3","updated":"20260809200341"},"Children":[{"ID":"20260809200341-f778shn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-f778shn","updated":"20260809200341"},"Children":[{"ID":"20260809200341-5o3h8ti","Type":"NodeParagraph","Properties":{"id":"20260809200341-5o3h8ti","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"截断不能丢失定位所需的前后文。"}]}]},{"ID":"20260809200341-6fbfo76","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-6fbfo76","updated":"20260809200341"},"Children":[{"ID":"20260809200341-fi0s36o","Type":"NodeParagraph","Properties":{"id":"20260809200341-fi0s36o","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"摘要生成规则应可测试。"}]}]}]},{"ID":"20260809200341-6e8cjow","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-6e8cjow","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q60：怎样保证规则修改不会改变 UI 解析？"}]},{"ID":"20260809200341-qkadhk8","Type":"NodeParagraph","Properties":{"id":"20260809200341-qkadhk8","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-80kj007","Type":"NodeParagraph","Properties":{"id":"20260809200341-80kj007","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"规则层输出稳定的结果 schema，UI 只依赖分类、置信度、evidence 和话术等契约字段。新增内部规则不能让字段语义随意变化。"}]},{"ID":"20260809200341-5b0su17","Type":"NodeParagraph","Properties":{"id":"20260809200341-5b0su17","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-gor9guy","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-gor9guy","updated":"20260809200341"},"Children":[{"ID":"20260809200341-82h2s46","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-82h2s46","updated":"20260809200341"},"Children":[{"ID":"20260809200341-jueootw","Type":"NodeParagraph","Properties":{"id":"20260809200341-jueootw","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"使用版本化结果对象和兼容默认值。"}]}]},{"ID":"20260809200341-sd7mfpd","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-sd7mfpd","updated":"20260809200341"},"Children":[{"ID":"20260809200341-1ndewox","Type":"NodeParagraph","Properties":{"id":"20260809200341-1ndewox","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"对 UI 做基于 fixture 的渲染测试。"}]}]}]},{"ID":"20260809200341-d724b4e","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-d724b4e","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q61：如果要支持规则热更新，有哪些风险？"}]},{"ID":"20260809200341-nt138jz","Type":"NodeParagraph","Properties":{"id":"20260809200341-nt138jz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-1x3zmr0","Type":"NodeParagraph","Properties":{"id":"20260809200341-1x3zmr0","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"热更新可以缩短规则发布周期，但会带来版本不可追溯、错误规则即时扩大和离线环境不一致的问题。规则包必须签名、版本化、可回滚。"}]},{"ID":"20260809200341-aeo2jvx","Type":"NodeParagraph","Properties":{"id":"20260809200341-aeo2jvx","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-nuo0vsz","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-nuo0vsz","updated":"20260809200341"},"Children":[{"ID":"20260809200341-jmhvqha","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-jmhvqha","updated":"20260809200341"},"Children":[{"ID":"20260809200341-1q9owzh","Type":"NodeParagraph","Properties":{"id":"20260809200341-1q9owzh","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"报告中记录实际生效的规则版本。"}]}]},{"ID":"20260809200341-p7rr6bm","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-p7rr6bm","updated":"20260809200341"},"Children":[{"ID":"20260809200341-vepciy3","Type":"NodeParagraph","Properties":{"id":"20260809200341-vepciy3","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"下载失败时继续使用已验证的本地版本。"}]}]}]},{"ID":"20260809200341-eq5g2qe","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-eq5g2qe","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q62：为什么不把所有日志都上传到服务端分析？"}]},{"ID":"20260809200341-ex7wd93","Type":"NodeParagraph","Properties":{"id":"20260809200341-ex7wd93","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-o83p3xy","Type":"NodeParagraph","Properties":{"id":"20260809200341-o83p3xy","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"完整日志体积大、敏感性高，上传会增加带宽、存储和合规成本。客户端先做本地筛选，只上传分析所需的最小证据或脱敏摘要。"}]},{"ID":"20260809200341-ys8pt5v","Type":"NodeParagraph","Properties":{"id":"20260809200341-ys8pt5v","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"展开点："}]},{"ID":"20260809200341-l5t3zxf","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-l5t3zxf","updated":"20260809200341"},"Children":[{"ID":"20260809200341-sxspu4b","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-sxspu4b","updated":"20260809200341"},"Children":[{"ID":"20260809200341-eh7g8hr","Type":"NodeParagraph","Properties":{"id":"20260809200341-eh7g8hr","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"最小化收集是隐私设计的一部分。"}]}]},{"ID":"20260809200341-rxgkjc9","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260809200341-rxgkjc9","updated":"20260809200341"},"Children":[{"ID":"20260809200341-ul9i4hz","Type":"NodeParagraph","Properties":{"id":"20260809200341-ul9i4hz","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"需要原始日志时应有显式授权和保留策略。"}]}]}]},{"ID":"20260809200341-vrv70pq","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260809200341-vrv70pq","updated":"20260809200341"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"Q63：内存日志扫描如何避免误命中？"}]},{"ID":"20260809200341-5ds5agf","Type":"NodeParagraph","Properties":{"id":"20260809200341-5ds5agf","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"满分回答："}]},{"ID":"20260809200341-3p39agp","Type":"NodeParagraph","Properties":{"id":"20260809200341-3p39agp","updated":"20260809200341"},"Children":[{"Type":"NodeText","Data":"不能只匹配“memory”字符串，应结合日志模块、时间窗口、数值字段和异常发生时间。多个弱信号组合后再提高结论置信度。"}]},{"ID":"20260809200341-c6l1wjr","Type":"NodeParagraph","Properties":{"id":"20260809200341-c6l1wjr","updated":"2026080920