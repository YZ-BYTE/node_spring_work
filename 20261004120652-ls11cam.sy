4120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：TOCTOU（检查与使用之间的窗口）——先查再等锁，锁到手时前提可能已变。正确姿势：临界区内重新验证前提，失效就当失败返回。"}]}]},{"ID":"20261004120652-0kyf89w","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-0kyf89w","updated":"20261004120652"},"Children":[{"ID":"20261004120652-nditao8","Type":"NodeParagraph","Properties":{"id":"20261004120652-nditao8","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"update_feedback"},{"Type":"NodeText","Data":" 先按 id 查记录才知道该拿哪把用户锁，但等锁期间 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"rebuild_index"},{"Type":"NodeText","Data":" 可能重建索引，所以"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"锁内重查"},{"Type":"NodeText","Data":"记录是否还在。这类\"锁内二次校验\"是并发代码面试官最爱抠的点。"}]}]}]},{"ID":"20261004120652-91q1vgx","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-91q1vgx","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C5 为什么用 asyncio.Lock 而不是 threading.Lock？"}]},{"ID":"20261004120652-qfq8xl2","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-qfq8xl2","updated":"20261004120652"},"Children":[{"ID":"20261004120652-0er3y33","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-0er3y33","updated":"20261004120652"},"Children":[{"ID":"20261004120652-8jqojcc","Type":"NodeParagraph","Properties":{"id":"20261004120652-8jqojcc","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：stats_server 锁选型的原话：\"线程锁会卡整个 loop\"。"}]}]},{"ID":"20261004120652-hzjvigy","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-hzjvigy","updated":"20261004120652"},"Children":[{"ID":"20261004120652-csb1cyg","Type":"NodeParagraph","Properties":{"id":"20261004120652-csb1cyg","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：asyncio 单线程事件循环，协程切换单位是 await；threading.Lock 阻塞会卡住整个线程=所有协程全停；asyncio.Lock 只挂起当前协程让出 loop。但 asyncio.Lock 防不了多线程（本就没多线程）。"}]}]},{"ID":"20261004120652-yo6g3hn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-yo6g3hn","updated":"20261004120652"},"Children":[{"ID":"20261004120652-g4b4n01","Type":"NodeParagraph","Properties":{"id":"20261004120652-g4b4n01","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：Starlette 单进程 ASGI、全 async 处理器，用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"asyncio.Lock"},{"Type":"NodeText","Data":" 等锁期间其他协程继续服务；纯内存 dict 的读操作直接不加锁（同步代码段无 await 点，天然原子）——锁只加在有 await 的写路径上。"}]}]}]},{"ID":"20261004120652-lfq5vn7","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-lfq5vn7","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C6 协程、线程、进程的区别和切换代价？（高频）"}]},{"ID":"20261004120652-ttgew6u","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ttgew6u","updated":"20261004120652"},"Children":[{"ID":"20261004120652-goppqz5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"2