708j5","Type":"NodeParagraph","Properties":{"id":"20261004120652-r1708j5","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：SendMessage 同步阻塞直到目标窗口过程处理完；PostMessage 投进消息队列立即返回，处理时机不确定（异步）。所以\"发出通知\"和\"标记已通知\"之间存在窗口。"}]}]},{"ID":"20261004120652-mw3jhb1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-mw3jhb1","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ko8w0w1","Type":"NodeParagraph","Properties":{"id":"20261004120652-ko8w0w1","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：PostEvent 请求弹窗是异步的（可能被丢/延迟），若等弹窗真正显示再写 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"last_notify_time"},{"Type":"NodeText","Data":"，崩溃在中间就重复弹窗；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"先立即写时间戳"},{"Type":"NodeText","Data":"，误差方向安全=最多少弹一次、绝不重复弹——用\"幂等方向的选择\"消化异步不确定性。"}]}]}]},{"ID":"20261004120652-k5lq1t8","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-k5lq1t8","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B2 为什么 CGI 请求必须在 UI 线程发？多线程 UI 编程的基本规则？"}]},{"ID":"20261004120652-t79cuzc","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-t79cuzc","updated":"20261004120652"},"Children":[{"ID":"20261004120652-gwtukuw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-gwtukuw","updated":"20261004120652"},"Children":[{"ID":"20261004120652-c4ujdqy","Type":"NodeParagraph","Properties":{"id":"20261004120652-c4ujdqy","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：检测 CGI 用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetUIThread()-\u0026gt;PostTask"},{"Type":"NodeText","Data":" 切 UI 线程发起，回调 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetExecuteThread()-\u0026gt;PostTask"},{"Type":"NodeText","Data":" 切回。"}]}]},{"ID":"20261004120652-a6jl18x","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-a6jl18x","updated":"20261004120652"},"Children":[{"ID":"20261004120652-wbs0ont","Type":"NodeParagraph","Properties":{"id":"20261004120652-wbs0ont","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：Windows 窗口/大量框架 API 要求在创建它的线程调用（线程亲和性）；跨线程碰 UI/框架对象是未定义行为。规则：工作线程算完，把结果 PostTask 回拥有对象的线程再操作成员。"}]}]},{"ID":"20261004120652-4grdpxy","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-4grdpxy","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ffcvd1b","Type":"NodeParagraph","Properties":{"id":"20261004120652-ffcvd1b","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：框架要求 promise 版 CGI 必须 UI 线程发；我的模式是\"执行线程发起任务→切 UI 线程发请求→回调只取数据→切回执行线程改状态\"，跨线程不共享可变成员，照抄框架既有范式（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"IntervalAutoSilentUpgradeTask"},{"Type":"NodeText","Data":"）降低风险。"}]}]}]},{"ID":"20261004120652-jmyh4d2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-jmyh4d2","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B3 DestroyWindow 和 Close() 有什么区别？为什么单例弹窗被占用时不能用 Close()？"}]},{"ID":"20261004120652-xmo5hp8","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-xmo5hp8","updated":"20261004120652"},"Children":[{"ID":"20261004120652-e1rx9y1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-e1rx9y1","updated":"20261004120652"},"Children":[{"ID":"20261004120652-zdjo8z4","Type":"NodeParagraph","Properties":{"id":"20261004120652-zdjo8z4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：真实修过的隐蔽 bug：单例 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"suggest_instance"},{"Type":"NodeText","Data":" 占用时误用 Close 导致提醒丢失。"}]}]},{"ID":"20261004120652-202qiux","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-202qiux","updated":"20261004120652"},"Children":[{"ID":"20261004120652-nmx9d82","Type":"NodeParagraph","Properties":{"id":"20261004120652-nmx9d82","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DestroyWindow"},{"Type":"NodeText","Data":" 同步销毁窗口、立即失效句柄；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Close()"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PostMessage(WM_CLOSE)"},{"Type":"NodeText","Data":" 只是投消息"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异步"},{"Type":"NodeText","Data":"走关闭流程，本函数返回时旧窗口还在。"}]}]},{"ID":"20261004120652-tx1ak8l","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-tx1ak8l","updated":"20261004120652"},"Children":[{"ID":"20261004120652-pjj3p8g","Type":"NodeParagraph","Properties":{"id":"20261004120652-pjj3p8g","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：旧窗口还在时走\"只置顶\"分支=新提醒不显示，但时间戳已写→提醒丢失且不再重试。修复：package_ready 时同步 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"::DestroyWindow()"},{"Type":"NodeText","Data":" 旧窗口再重建（封装成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ShowPiplineSilentUpdateWindow"},{"Type":"NodeText","Data":"）——异步通知链上\"以为关了其实没关\"是经典 UI 并发坑。"}]}]}]},{"ID":"20261004120652-uho9c7i","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-uho9c7i","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B4 Windows 消息机制讲一下？消息循环、窗口过程、消息队列。"}]},{"ID":"20261004120652-6z07po9","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-6z07po9","updated":"20261004120652"},"Children":[{"ID":"20261004120652-mgcxl0a","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-mgcxl0a","updated":"20261004120652"},"Children":[{"ID":"20261004120652-llwpamn","Type":"NodeParagraph","Properties":{"id":"20261004120652-llwpamn","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：MFC/Win32 客户端岗必考，你的笔记只有一句话版。"}]}]},{"ID":"20261004120652-dwl9ea1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-dwl9ea1","updated":"20261004120652"},"Children":[{"ID":"20261004120652-tvsdglj","Type":"NodeParagraph","Properties":{"id":"20261004120652-tvsdglj","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：每个 UI 线程有消息队列；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"GetMessage/PeekMessage"},{"Type":"NodeText","Data":" 取消息→"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DispatchMessage"},{"Type":"NodeText","Data":" 分发到窗口过程 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WndProc"},{"Type":"NodeText","Data":"；SendMessage 直接调目标 WndProc。常见考点：WM_TIMER 低优先级会被合并、模态对话框有独立消息循环、消息过滤（PreTranslateMessage）。"}]}]},{"ID":"20261004120652-2k5t2rk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-2k5t2rk","updated":"20261004120652"},"Children":[{"ID":"20261004120652-m5sbgii","Type":"NodeParagraph","Properties":{"id":"20261004120652-m5sbgii","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：蓝盾链路里 PostEvent/PostTask 全是消息队列机制的上层封装；弹窗单例替换、SetFocus 不给安装按钮（防误触）都是对消息调度行为的利用/规避。"}]}]}]},{"ID":"20261004120652-q6gfy4o","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-q6gfy4o","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B5 窗口子类化/Hook 是什么？（中频）"}]},{"ID":"20261004120652-szs07um","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-szs07um","updated":"20261004120652"},"Children":[{"ID":"20261004120652-aio1xbk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-aio1xbk","updated":"20261004120652"},"Children":[{"ID":"20261004120652-injz579","Type":"NodeParagraph","Properties":{"id":"20261004120652-injz579","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：崩溃分析里出现 IAT Hook、DLP/Hook 环境、TSF 输入法场景。"}]}]},{"ID":"20261004120652-a0jnj5l","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-a0jnj5l","updated":"20261004120652"},"Children":[{"ID":"20261004120652-v8z7sub","Type":"NodeParagraph","Properties":{"id":"20261004120652-v8z7sub","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：子类化=替换窗口过程接管消息；IAT Hook=改写导入地址表劫持 API 调用；WH_CBT/WH_KEYBOARD 等系统 Hook。安全软件/输入法大量使用，也带来兼容性问题。"}]}]},{"ID":"20261004120652-d4gn4xi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-d4gn4xi","updated":"20261004120652"},"Children":[{"ID":"20261004120652-gg9hrmr","Type":"NodeParagraph","Properties":{"id":"20261004120652-gg9hrmr","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：归因规则里\"栈溢出+空栈+DLP/Hook 环境→Hook 递归 trampoline 自环\"\"访问违例+空栈+CreateProcess 帧→IAT Hook 腐败野指针\"这类兜底规则，正是对第三方 Hook 技术的理解才写得出来——答原理后立刻举这两个归因例子。"}]}]}]},{"ID":"20261004120652-d70je0y","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-d70je0y","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"B6 进程的虚拟内存布局？为什么会 OOM？（客户端内存专项直接相关）"}]},{"ID":"20261004120652-pqjxjsa","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-pqjxjsa","updated":"20261004120652"},"Children":[{"ID":"20261004120652-yzwirus","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-yzwirus","updated":"20261004120652"},"Children":[{"ID":"20261004120652-nl0al80","Type":"NodeParagraph","Properties":{"id":"202610