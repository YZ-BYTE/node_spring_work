NodeTextMark","TextMarkType":"code","TextMarkTextContent":"WCRS_LOG_INFO() \u0026lt;\u0026lt; x \u0026lt;\u0026lt; y"},{"Type":"NodeText","Data":" 里 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"LogEntry(level, file, line)"},{"Type":"NodeText","Data":" 是临时对象，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"operator\u0026lt;\u0026lt;"},{"Type":"NodeText","Data":" 把内容攒进流，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"析构发生在语句结束（full-expression 结束）时"},{"Type":"NodeText","Data":"，统一提交一条完整日志——把\"多段拼接\"和\"落盘\"解耦。"}]}]},{"ID":"20261004120652-gsu68yc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-gsu68yc","updated":"20261004120652"},"Children":[{"ID":"20261004120652-hsoyy5d","Type":"NodeParagraph","Properties":{"id":"20261004120652-hsoyy5d","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：临时对象在分号处析构，所以宏结尾不需要分号参与拼接；级别不够时构造阶段就短路，不拼字符串，省拷贝。"}]}]}]},{"ID":"20261004120652-onymla7","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-onymla7","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A2 为什么析构函数里不能抛异常？你们的日志析构怎么处理错误？"}]},{"ID":"20261004120652-cv6j6k4","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-cv6j6k4","updated":"20261004120652"},"Children":[{"ID":"20261004120652-zzhknlw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-zzhknlw","updated":"20261004120652"},"Children":[{"ID":"20261004120652-shodc9u","Type":"NodeParagraph","Properties":{"id":"20261004120652-shodc9u","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"str