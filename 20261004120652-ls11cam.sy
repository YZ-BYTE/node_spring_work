:"oom_batch_skipped"},{"Type":"NodeText","Data":"——真实事故类型你都有规则。"}]}]}]},{"ID":"20261004120652-z58indm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-z58indm","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"G12 怎么测试一个\"自动清理/自动更新\"这种容易误删误装的功能？"}]},{"ID":"20261004120652-42rbjgq","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-42rbjgq","updated":"20261004120652"},"Children":[{"ID":"20261004120652-htrzr6f","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-htrzr6f","updated":"20261004120652"},"Children":[{"ID":"20261004120652-pme6v70","Type":"NodeParagraph","Properties":{"id":"20261004120652-pme6v70","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点骨架"},{"Type":"NodeText","Data":"：分维度设计用例（功能/边界/异常/并发/兼容/回归）→白盒（日志/落盘状态断言）+黑盒（用户可见现象）→故障注入（断网、强杀、磁盘满、半截文件）→现网影响控制（闸门）。"}]}]},{"ID":"20261004120652-qfcr3rt","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-qfcr3rt","updated":"20261004120652"},"Children":[{"ID":"20261004120652-4dqcssp","Type":"NodeParagraph","Properties":{"id":"20261004120652-4dqcssp","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：蓝盾 26 用例六维度、黑盒 10/白盒 16/综合 19；白盒断言用日志/文件状态表达验证点；故障注入=断网续检、半截包、登出取消下载、包被删后点安装；防误删=独立包类别+"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ResetAllUpdateState"},{"Type":"NodeText","Data":" 一行不动（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CheckAndExecuteUpdate"},{"Type":"NodeText","Data":" 登录前无条件调用会误删的坑）——\"清理功能的测试重点是不该删的一个都没删\"。"}]}]}]},{"ID":"20261004120652-n4xlzfb","Ty