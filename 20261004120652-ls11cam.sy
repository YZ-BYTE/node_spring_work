g","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：改过真实 C++ 工程，必问资源管理。"}]}]},{"ID":"20261004120652-r7xo71x","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-r7xo71x","updated":"20261004120652"},"Children":[{"ID":"20261004120652-go5xp2u","Type":"NodeParagraph","Properties":{"id":"20261004120652-go5xp2u","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unique_ptr"},{"Type":"NodeText","Data":" 独占、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"shared_ptr"},{"Type":"NodeText","Data":" 引用计数、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"weak_ptr"},{"Type":"NodeText","Data":" 打破循环引用；优先栈对象/值语义，其次 unique_ptr，shared_ptr 只在真正共享所有权时用；自定义 deleter 管非内存资源。"}]}]},{"ID":"20261004120652-mgirj6s","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-mgirj6s","updated":"20261004120652"},"Children":[{"ID":"20261004120652-k3vif7j","Type":"NodeParagraph","Properties":{"id":"20261004120652-k3vif7j","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：清理线程是全局静态 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::thread"},{"Type":"NodeText","Data":" 不需要智能指针；文件句柄靠 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::filesystem"},{"Type":"NodeText","Data":" RAII 封装；observer 回调用裸指针+明确\"注销时等待 in-flight 归零\"的所有权协议（见 A9），说明\"何时不用 shared_ptr 也能安全\"比背定义更得分。"}]}]}]},{"ID":"20261004120652-iluzxot","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-iluzxot","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A6 移动语义解决什么问题？什么情况该用 std::move？"}]},{"ID":"20261004120652-ch6r7x5","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ch6r7x5","updated":"20261004120652"},"Children":[{"ID":"20261004120652-1pc9mf0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-1pc9mf0","updated":"20261004120652"},"Children":[{"ID":"20261004120652-rdlfqfb","Type":"NodeParagraph","Properties":{"id":"20261004120652-rdlfqfb","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：日志攒流、任务对象传递都会涉及拷贝开销。"}]}]},{"ID":"20261004120652-6ms70ku","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-6ms70ku","updated":"20261004120652"},"Children":[{"ID":"20261004120652-fpqqzbw","Type":"NodeParagraph","Properties":{"id":"20261004120652-fpqqzbw","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：移动把资源所有权从将亡值转移，避免深拷贝；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::move"},{"Type":"NodeText","Data":" 只是转成右值引用的 cast，真正做事的是移动构造/移动赋值；移动后源对象处于\"有效但未指定\"状态；有成员实现了移动的类要自己写/默认五个拷贝移动函数（rule of five）。"}]}]},{"ID":"20261004120652-ormaga0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ormaga0","updated":"20261004120652"},"Children":[{"ID":"20261004120652-8bmmjaj","Type":"NodeParagraph","Properties":{"id":"20261004120652-8bmmjaj","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：日志内容攒在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::ostringstream"},{"Type":"NodeText","Data":" 移动进 LogEntry 提交，避免字符串拷贝；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::thread"},{"Type":"NodeText","Data":" 对象本身不可拷贝只能移动——任务注册传工厂函数、执行时生成任务对象就是靠移动转移所有权。"}]}]}]},{"ID":"20261004120652-o5jo0fk","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-o5jo0fk","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A7 构造函数初始化列表和构造顺序知道吗？构造函数里访问成员为什么危险？"}]},{"ID":"20261004120652-yte8gly","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-yte8gly","updated":"20261004120652"},"Children":[{"ID":"20261004120652-skjnh7a","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-skjnh7a","updated":"20261004120652"},"Children":[{"ID":"20261004120652-5ousc6f","Type":"NodeParagraph","Properties":{"id":"20261004120652-5ousc6f","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：蓝盾改造踩过\"基类构造期访问成员=UB\"的坑。"}]}]},{"ID":"20261004120652-b443ou5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-b443ou5","updated":"20261004120652"},"Children":[{"ID":"20261004120652-z2de2be","Type":"NodeParagraph","Properties":{"id":"20261004120652-z2de2be","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：成员按"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"声明顺序"},{"Type":"NodeText","Data":"初始化（不是初始化列表顺序）；基类先于成员、成员先于构造体；派生类构造时基类构造阶段虚函数不派发到派生（vptr 还是基类的），此时访问派生成员=UB。"}]}]},{"ID":"20261004120652-vfppxtc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-vfppxtc","updated":"20261004120652"},"Children":[{"ID":"20261004120652-el467zu","Type":"NodeParagraph","Properties":{"id":"20261004120652-el467zu","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：蓝盾周期任务的构造参数必须是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"编译期常量"},{"Type":"NodeText","Data":"（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"#if RDM_BUILD"},{"Type":"NodeText","Data":" + constexpr），因为基类构造期就要用周期值做调度决策，运行期成员还没初始化——这是真实修过的 UB 隐患。"}]}]}]},{"ID":"20261004120652-hv9h96e","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-hv9h96e","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A8 C++ 异常安全等级？异常和错误码怎么选？"}]},{"ID":"20261004120652-8j6riwx","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-8j6riwx","updated":"20261004120652"},"Children":[{"ID":"20261004120652-b767cky","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-b767cky","updated":"20261004120652"},"Children":[{"ID":"20261004120652-5h7wsia","Type":"NodeParagraph","Properties":{"id":"20261004120652-5h7wsia","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：日志链\"catch 分层降级\"、下载/检测链路的失败兜底。"}]}]},{"ID":"20261004120652-k07icb7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-k07icb7","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ktod845","Type":"NodeParagraph","Properties":{"id":"20261004120652-ktod845","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：基本保证（不泄漏不破坏）、强保证（失败回滚如初）、不抛保证。构造失败用异常、可预期的业务失败用错误码/返回值；异常路径贵在\"不该发生\"，别用异常做正常控制流。"}]}]},{"ID":"20261004120652-djt5j6a","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-djt5j6a","updated":"20261004120652"},"Children":[{"ID":"20261004120652-dn64pf4","Type":"NodeParagraph","Properties":{"id":"20261004120652-dn64pf4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：日志/清理这种宿主基础能力全部 catch 吞掉走降级（不抛给业务）；周期任务失败走 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"onError"},{"Type":"NodeText","Data":" 兜底续期、下载失败可重试——\"可预期失败用状态表达，意外异常在边界统一兜底\"。"}]}]}]},{"ID":"20261004120652-62q2f5z","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-62q2f5z","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A9 原子变量与内存序了解吗？怎么做\"注销回调时保证没有回调还在跑\"？"}]},{"ID":"20261004120652-d3e7n6k","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-d3e7n6k","updated":"20261004120652"},"Children":[{"ID":"20261004120652-epwm0r0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-epwm0r0","updated":"20261004120652"},"Children":[{"ID":"20261004120652-okk95h0","Type":"NodeParagraph","Properties":{"id":"20261004120652-okk95h0","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ShellStatusHub::SetObserver(nullptr)"},{"Type":"NodeText","Data":" 要等 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"observer_in_flight_ == 0"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20261004120652-d27ndu7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-d27ndu7","updated":"20261004120652"},"Children":[{"ID":"20261004120652-v9m6myn","Type":"NodeParagraph","Properties":{"id":"20261004120652-v9m6myn","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"std::atomic"},{"Type":"NodeText","Data":" 保证可见性与原子性，内存序 relaxed/acquire/release/seq_cst 权衡；计数器类\"进入计数+等待归零\"是经典 in-flight 屏障：回调方 fetch_add 进入、返回前 fetch_sub，注销方置空指针后自旋/条件等待计数归零，防止注销后回调踩空。"}]}]},{"ID":"20261004120652-g6whaer","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-g6whaer","updated":"20261004120652"},"Children":[{"ID":"20261004120652-iwr0dod","Type":"NodeParagraph","Properties":{"id":"20261004120652-iwr0dod","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SetObserver(nullptr)"},{"Type":"NodeText","Data":" 等 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"observer_in_flight_==0"},{"Type":"NodeText","Data":" 才返回，保证没有回调拿着已注销 observer 指针；比直接加锁轻——读多写极少的回调分发不想每次付互斥量成本。"}]}]}]},{"ID":"20261004120652-rfrvcne","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-rfrvcne","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"A10 thread_local 是什么？为什么日志重入保护要用 thread_local 而不是全局 bool？"}]},{"ID":"20261004120652-o6lmhoc","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padd