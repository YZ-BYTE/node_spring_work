":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：框架 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AddConcurrentTask"},{"Type":"NodeText","Data":" 只登记"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工厂函数"},{"Type":"NodeText","Data":"不立即执行，到点生成任务交给并发执行器；所有分支（成功/失败/onError）都走 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ScheduleNext"},{"Type":"NodeText","Data":" 续期、禁用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FinishExecuting"},{"Type":"NodeText","Data":"——\"周期任务的失败兜底就是续期\"，任务永不因异常停摆。"}]}]}]},{"ID":"20261004120652-j7dw3ds","Type":"NodeThematicBreak","Properties":{"id":"20261004120652-j7dw3ds","updated":"20261004120652"}},{"ID":"20261004120652-vd5o6jw","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261004120652-vd5o6jw","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"D. 网络与 HTTP（锚：dump 上传 / REST 接口 / MCP 传输）"}]},{"ID":"20261004120652-3ryxr4y","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-3ryxr4y","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D1 HTTP 常见方法与 REST 语义？你们接口怎么选的？"}]},{"ID":"20261004120652-ae22ea2","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ae22ea2","updated":"20261004120652"},"Children":[{"ID":"20261004120652-x7xcs61","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-x7xcs61","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ensyzux","Type":"NodeParagraph","Properties":{"id":"20261004120652-ensyzux","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkTy