trong","TextMarkTextContent":"要点骨架"},{"Type":"NodeText","Data":"：先定位瓶颈（内存索引、全量重写、单进程）→短期（分片文件、增量索引、换原子写）→长期（换 SQLite/MySQL、查询下推、聚合预计算、读写分离）→迁移路径。"}]}]},{"ID":"20261004120652-3vx1a4e","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-3vx1a4e","updated":"20261004120652"},"Children":[{"ID":"20261004120652-1d7ryd8","Type":"NodeParagraph","Properties":{"id":"20261004120652-1d7ryd8","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：当前 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index"},{"Type":"NodeText","Data":" 全内存、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_rewrite_user_file"},{"Type":"NodeText","Data":" 整文件重写、rebuild 全量重建都是 O(n) 点；按 userName 拆文件已经是水平分片雏形；答这题的关键是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"给演进路线而不是一步到位"},{"Type":"NodeText","Data":"，并说清触发阈值。"}]}]}]},{"ID":"20261004120652-slbrdac","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-slbrdac","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"G8 怎么保证\"上报不丢不重\"？"}]},{"ID":"20261004120652-xnty5m3","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-xnty5m3","updated":"20261004120652"},"Children":[{"ID":"20261004120652-5i835l4","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-5i835l4","updated":"20261004120652"},"Children":[{"ID":"20261004120652-nvx7j81","Type":"NodeParagraph","Properties":{"id":"20261004120652-nvx7j81","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点骨架"},{"Type":"NodeText","Data":"：不重=幂等键去重（客户端 taskId+服务端 id 覆盖）；不丢=本地队列持久化/重试+退避+分类重试；顺序=队首回插；依赖顺序的任务（record 先于 remark）用挂起机制。"}]}]},{"ID":"20261004120652-e1xjlds","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-e1xjlds","updated":"20261004120652"},"Children":[{"ID":"20261004120652-24hoxep","Type":"NodeParagraph","Properties":{"id":"20261004120652-24hoxep","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：挂起区设计——主记录未入库时备注/评价挂起（按 taskId 去重的 Map），成功后 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_flushPendingUpdates"},{"Type":"NodeText","Data":" 补发并重置重试计数，失败回挂起区；1+3 重试退避 2/5/15s；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"诚实讲缺口"},{"Type":"NodeText","Data":"：挂起区是内存态、进程退出会丢，用状态条+关闭拦截兜底，生产化应落盘——面试官要的是\"知道边界\"。"}]}]}]},{"ID":"20261004120652-f7nocyj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-f7nocyj","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"G9 设计规则引擎的灰度/回滚/远程关闭能力。"}]},{"ID":"20261004120652-tsr9dyk","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-tsr9dyk","updated":"20261004120652"},"Children":[{"ID":"20261004120652-j3cjctv","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-j3cjctv","updated":"20261004120652"},"Children":[{"ID":"20261004120652-dhu7lte","Type":"NodeParagraph","Properties":{"id":"20261004120652-dhu7lte","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点骨架"},{"Type":"NodeText","Data":"：规则配置化（阈值外置）→版本化（规则集版本号）→灰度（按用户/比例）→远程开关（kill switch）→观测（命中率监控）→回滚（配置回滚秒级）。"}]}]},{"ID":"20261004120652-yhjwbyg","Type":"NodeListItem","Data":"-","L