etChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-t1g7vhy","updated":"20261004120652"},"Children":[{"ID":"20261004120652-pwkn4ak","Type":"NodeParagraph","Properties":{"id":"20261004120652-pwkn4ak","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：dio 流式上传 dump 的三个坑。"}]}]},{"ID":"20261004120652-s6zibaf","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-s6zibaf","updated":"20261004120652"},"Children":[{"ID":"20261004120652-g4semxg","Type":"NodeParagraph","Properties":{"id":"20261004120652-g4semxg","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：流式上传避免整文件进内存、分块、断点续传、校验；手动 Content-Length：dio "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"File.openRead()"},{"Type":"NodeText","Data":" 流式 body 不会预计算长度；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content-Type: application/octet-stream"},{"Type":"NodeText","Data":" 否则默认 JSON 头服务端解析报错。"}]}]},{"ID":"20261004120652-opiz06s","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-opiz06s","updated":"20261004120652"},"Children":[{"ID":"20261004120652-o41m843","Type":"NodeParagraph","Properties":{"id":"20261004120652-o41m843","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dio.put()"},{"Type":"NodeText","Data":" + "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"File.openRead()"},{"Type":"NodeText","Data":" 流式 body + 手动 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Content-Length"},{"Type":"NodeText","Data":" + 手动 octet-stream 头；8MB chunk、4GB 上限、超限 413；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sendTimeout"},{"Type":"NodeText","Data":" 放大到 600 秒；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"大文件不重试"},{"Type":"NodeText","Data":"（几百 MB 重传代价太大，小请求才重试）——超时参数按\"包体大小×带宽\"定，不是拍脑袋。"}]}]}]},{"ID":"20261004120652-m2g2obj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-m2g2obj","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D3 怎么防止重复上传？SHA-1 内容指纹去重怎么做的？"}]},{"ID":"20261004120652-ac7i6bj","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ac7i6bj","updated":"20261004120652"},"Children":[{"ID":"20261004120652-62o61hi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-62o61hi","updated":"20261004120652"},"Children":[{"ID":"20261004120652-p0thsh4","Type":"NodeParagraph","Properties":{"id":"20261004120652-p0thsh4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：本地 SHA-1 预去重（PUT 几百 MB 最贵）、FileManager 指纹、\"内容指纹\"。"}]}]},{"ID":"20261004120652-9kivhb1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-9kivhb1","updated":"20261004120652"},"Children":[{"ID":"20261004120652-fckxxc4","Type":"NodeParagraph","Properties":{"id":"20261004120652-fckxxc4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：先算指纹查服务端有没有（HEAD/查接口），有就跳过上传；大文件哈希分块算（1MB 分块）防算哈希本身卡死；SHA-1 抗碰撞足够非加密场景，加密场景用 SHA-256。"}]}]},{"ID":"20261004120652-0h3a8qp","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-0h3a8qp","updated":"20261004120652"},"Children":[{"ID":"20261004120652-2s13vw0","Type":"NodeParagraph","Properties":{"id":"20261004120652-2s13vw0","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：客户端本地先算 SHA-1 查重（省掉最贵的 PUT）；服务端 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FileManager"},{"Type":"NodeText","Data":" 按内容指纹同名存储，同一 dump 多次上传只存一份；分块 1MB 流式算指纹不爆内存。"}]}]}]},{"ID":"20261004120652-2vlygmh","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-2vlygmh","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D4 断点续传的原理？半截包怎么补全？"}]},{"ID":"20261004120652-prwsu0d","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-prwsu0d","updated":"20261004120652"},"Children":[{"ID":"20261004120652-75cllt1","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-75cllt1","updated":"20261004120652"},"Children":[{"ID":"20261004120652-hvknjig","Type":"NodeParagraph","Properties":{"id":"20261004120652-hvknjig","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：蓝盾半截包断点续传补全、纠错事实 2。"}]}]},{"ID":"20261004120652-pzbtts6","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-pzbtts6","updated":"20261004120652"},"Children":[{"ID":"20261004120652-cyhn5u5","Type":"NodeParagraph","Properties":{"id":"20261004120652-cyhn5u5","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：客户端记录已传偏移（Range/自定义 offset），续传从偏移继续，服务端拼接或分块合并；关键难点是\"伪完整\"（文件名完整内容截断）不能只看文件名。"}]}]},{"ID":"20261004120652-nza6fll","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-nza6fll","updated":"20261004120652"},"Children":[{"ID":"20261004120652-0ktn3qf","Type":"NodeParagraph","Properties":{"id":"20261004120652-0ktn3qf","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：半截包文件名完整，靠"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"签名校验"},{"Type":"NodeText","Data":"识别：完整包校验通过直接短路成功（同版本不重复下载的实际机制）、半截包从断点续传补全——\"完整性判定靠内容校验不靠元数据\"是设计题万能素材。"}]}]}]},{"ID":"20261004120652-es5zi56","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-es5zi56","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D5 HTTP 超时有哪些？怎么定的？"}]},{"ID":"20261004120652-w7q1r6w","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-w7q1r6w","updated":"20261004120652"},"Children":[{"ID":"20261004120652-4y5ht01","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-4y5ht01","updated":"20261004120652"},"Children":[{"ID":"20261004120652-c0dmi6e","Type":"NodeParagraph","Properties":{"id":"20261004120652-c0dmi6e","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：sendTimeout 600s、深度分析超时掐断。"}]}]},{"ID":"20261004120652-or7plkl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-or7plkl","updated":"20261004120652"},"Children":[{"ID":"20261004120652-0oreico