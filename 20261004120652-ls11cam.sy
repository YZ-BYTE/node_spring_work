rkTextContent":"触发点"},{"Type":"NodeText","Data":"：归档上报 1 首发+3 重试、退避 2/5/15s。"}]}]},{"ID":"20261004120652-9wywzxz","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-9wywzxz","updated":"20261004120652"},"Children":[{"ID":"20261004120652-hk4a66h","Type":"NodeParagraph","Properties":{"id":"20261004120652-hk4a66h","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：指数退避+抖动防雪崩；只重试可重试错误（网络错/5xx），不重试 4xx；幂等=同请求发多次效果等于一次（幂等键/覆盖写）；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HTTP 状态码不等于业务成功"},{"Type":"NodeText","Data":"，必须看响应体。"}]}]},{"ID":"20261004120652-vecxkgp","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-vecxkgp","updated":"20261004120652"},"Children":[{"ID":"20261004120652-vxet745","Type":"NodeParagraph","Properties":{"id":"20261004120652-vxet745","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：重试分类——网络错误和 5xx 可重试、400/404 和 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"body ok:false"},{"Type":"NodeText","Data":" 不可重试；坑：服务端返回 200 但业务失败，只看状态码会误判成功；敢重试的前提是后台按 record id "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"覆盖式幂等"},{"Type":"NodeText","Data":"；可重试的放回队首保序，taskId=\"记录 ID+类型\"去重、重复入队删旧（连点只发最后一次）。"}]}]}]},{"ID":"20261004120652-7icpe9g","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-7icpe9g","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D7 TCP 和 UDP 的区别？为什么这些传输都用 TCP/HTTP？"}]},{"ID":"20261004120652-dfpp3oo","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-dfpp3oo","updated":"20261004120652"},"Children":[{"ID":"20261004120652-y8a3lfi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-y8a3lfi","updated":"20261004120652"},"Children":[{"ID":"20261004120652-bbusd7o","Type":"NodeParagraph","Properties":{"id":"20261004120652-bbusd7o","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：基础必问题，挂上传/远程调试场景。"}]}]},{"ID":"20261004120652-9kuwmdj","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-9kuwmdj","updated":"20261004120652"},"Children":[{"ID":"20261004120652-0svnxgi","Type":"NodeParagraph","Properties":{"id":"20261004120652-0svnxgi","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：TCP 面向连接可靠有序拥塞控制、UDP 无连接低延迟不保证到达；选型看可靠性 vs 实时性。"}]}]},{"ID":"20261004120652-gdnoy6t","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-gdnoy6t","updated":"20261004120652"},"Children":[{"ID":"20261004120652-8ftnxeb","Type":"NodeParagraph","Properties":{"id":"20261004120652-8ftnxeb","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：dump 上传、CDB 命令下发都是\"一条不能错\"的场景，走 HTTP/TCP；可以对比讲\"如果是实时日志流/音视频我会选 UDP+前向纠错\"（你的音视频笔记能接上）。"}]}]}]},{"ID":"20261004120652-95wvj0a","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-95wvj0a","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D8 HTTP/1.1、HTTP/2、HTTP/3 区别？队头阻塞？"}]},{"ID":"20261004120652-ko53ndh","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ko53ndh","updated":"20261004120652"},"Children":[{"ID":"20261004120652-74xr23e","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-74xr23e","updated":"20261004120652"},"Children":[{"ID":"20261004120652-3wrla85","Type":"NodeParagraph","Properties":{"id":"20261004120652-3wrla85","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"你的笔记已覆盖基础"},{"Type":"NodeText","Data":"，这里补与实习的连接点："}]}]},{"ID":"20261004120652-jzzg1wb","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-jzzg1wb","updated":"20261004120652"},"Children":[{"ID":"20261004120652-8wkpb55","Type":"NodeParagraph","Properties":{"id":"20261004120652-8wkpb55","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：1.1 持久连接+管线化仍有应用层队头阻塞；2 多路复用+HPACK（TCP 层队头阻塞仍在）；3 QUIC/UDP 解决传输层队头阻塞。"}]}]},{"ID":"20261004120652-2dp6s3p","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-2dp6s3p","updated":"20261004120652"},"Children":[{"ID":"20261004120652-dqx5mi8","Type":"NodeParagraph","Properties":{"id":"20261004120652-dqx5mi8","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：mcp-windbg 的 Streamable HTTP 长连接传输选择、以及\"会话复用\"设计，都可以拿多路复用概念来解释为什么不给每个命令开一条新连接。"}]}]}]},{"ID":"20261004120652-0xs1jru","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-0xs1jru","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D9 MCP 是什么？和 Function Calling 有什么区别？（AI 岗必考）"}]},{"ID":"20261004120652-k6xvfes","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-k6xvfes","updated":"20261004120652"},"Children":[{"ID":"20261004120652-buollkc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-buollkc","updated":"20261004120652"},"Children":[{"ID":"20261004120652-0ms11s9","Type":"NodeParagraph","Properties":{"id":"20261004120652-0ms11s9","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：mcp-windbg 核心亮点，题库有项目版，这里是概念版。"}]}]},{"ID":"20261004120652-9prp678","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-9prp678","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ir56go3","Type":"NodeParagraph","Properties":{"id":"20261004120652-ir56go3","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：Function Calling 是模型 API 的调用约定（模型输出结构化调用意图，宿主执行后回传）；MCP（Model Context Protocol）是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工具/资源的标准化接入协议"},{"Type":"NodeText","Data":"（JSON-RPC、Streamable HTTP/SSE 传输、工具 schema 描述），让任何客户端（Claude/IDE/自研 Agent）都能复用同一套工具服务。类比：Function Calling 是\"点菜\"，MCP 是\"统一菜单格式的接口标准\"。"}]}]},{"ID":"20261004120652-bx3kw9d","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-bx3kw9d","updated":"20261004120652"},"Children":[{"ID":"20261004120652-aak1m6a","Type":"NodeParagraph","Properties":{"id":"20261004120652-aak1m6a","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：把 CDB 调试能力包成 FastMCP 服务（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/mcp"},{"Type":"NodeText","Data":" endpoint + Bearer 鉴权），同一个服务被 AI 客户端、REST 脚本、Web 页面三个入口复用——\"调试能力服务化、协议化\"正是选 MCP 的理由。"}]}]}]},{"ID":"20261004120652-2vn3lpw","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-2vn3lpw","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D10 长连接/断线重连/心跳怎么做？（中频）"}]},{"ID":"20261004120652-vzzanx6","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-vzzanx6","updated":"20261004120652"},"Children":[{"ID":"20261004120652-eznpg06","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-eznpg06","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ueskt0y","Type":"NodeParagraph","Properties":{"id":"20261004120652-ueskt0y","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：WebSocket "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"task_updated"},{"Type":"NodeText","Data":" 广播（你的 FastAPI 项目）、会话 idle 管理。"}]}]},{"ID":"20261004120652-efxh9px","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-efxh9px","updated":"20261004120652"},"Children":[{"ID":"20261004120652-zj6g5jf","Type":"NodeParagraph","Properties":{"id":"20261004120652-zj6g5jf","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：心跳保活+超时踢、断线指数退避重连、消息补偿（序号/拉取缺失）。"}]}]},{"ID":"20261004120652-p88c90g","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-p88c90g","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ripawa0","Type":"NodeParagraph","Properties":{"id":"20261004120652-ripawa0","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：会话池用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"last_activity"},{"Type":"NodeText","Data":" 60 秒扫描清理 idle 会话（30 分钟 idle 超时上限）——本质是\"连接/会话资源的活性管理\"，和心跳踢人是同一套思路。"}]}]}]},{"ID":"20261004120652-gddbn7p","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-gddbn7p","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D11 鉴权怎么做？token 放哪？为什么用 Bearer header？"}]},{"ID":"20261004120652-7l70ukq","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-7l70ukq","updated":"20261004120652"},"Children":[{"ID":"20261004120652-k4shpvj","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-k4shpvj","updated":"20261004120652"},"Children":[{"ID":"20261004120652-e81l0z7","Type":"NodeParagraph","Properties":{"id":"20261004120652-e81l0z7","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：MCP 配置 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"{\"headers\": {\"Authorization\": \"Bearer ...\"}}"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20261004120652-u3lze1m","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-u3lze1m","updated":"20261004120652"},"Children":[{"ID":"20261004120652-c3a2nk4","Type":"NodeParagraph","Properties":{"id":"20261004120652-c3a2nk4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：Bearer token 放 header 不落 URL（URL 会进日志/Referer）；服务端校验+过期；内网服务和公网服务的威胁模型不同。"}]}]},{"ID":"20261004120652-pfjboft","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-pfjboft","updated":"20261004120652"},"Children":[{"ID":"20261004120652-dli2r99","Type":"NodeParagraph","Properties":{"id":"20261004120652-dli2r99","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：MCP 服务部署在内网、Bearer token 保护调试能力（这个能力能看任意 dump，必须防滥用）；注意 token 出现在配置文件里，答\"生产化我会换成环境变量注入+短期凭证\"能拿印象分。"}]}]}]},{"ID":"20261004120652-xtewfki","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-xtewfki","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"D12 时区/时间一致性问题踩过吗？"}]},{"ID":"20261004120652-9rxpgud","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-9rxpgud","updated":"20261004120652"},"Children":[{"ID":"20261004120652-d073xce","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-d073xce","updated":"20261004120652"},"Children":[{"ID":"20261004120652-z99jq2c","Type":"NodeParagraph","Properties":{"id":"20261004120652-z99jq2c","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：crash_context 时区差、节流用 ServerTime。"}]}]},{"ID":"20261004120652-xruutvp","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-xruutvp","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ehad8fu","Type":"NodeParagraph","Properties":{"id":"20261004120652-ehad8fu","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：UTC vs 本地时间、夏令时、客户端时间可被用户篡改、以服务端时间为准。"}]}]},{"ID":"20261004120652-qhwsfa0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-qhwsfa0","updated":"20261004120652"},"Children":[{"ID":"20261004120652-103jsz5","Type":"NodeParagraph","Properties":{"id":"20261004120652-103jsz5","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：① 进程运行时长计算时启动时间是 UTC、崩溃时间是本地，不换算会算出负数；② 弹窗节流 24h 用"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"服务器时间"},{"Type":"NodeText","Data":"判定防止改系统时间绕过——两个真实案例讲\"时间不可信\"这一课。"}]}]}]},{"ID":"20261004120652-07sbfx8","Type":"NodeThematicBreak","Properties":{"id":"20261004120652-07sbfx8","updated":"20261004120652"}},{"ID":"20261004120652-8vssbt0","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20261004120652-8vssbt0","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"E. 服务端 / Python 工程（锚：mcp-windbg / wxlog_stats_server / Starlette）"}]},{"ID":"20261004120652-15utbnr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-15utbnr","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"E1 ASGI 和 WSGI 的区别？为什么选 Starlette 单进程？"}]},{"ID":"20261004120652-zdt3wnf","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-zdt3wnf","updated":"20261004120652"},"Children":[{"ID":"20261004120652-aioun6t","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-aioun6t","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ekclwav","Type":"NodeParagraph","Properties":{"id":"20261004120652-ekclwav","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：两个服务都用 Starlette + Uvicorn。"}]}]},{"ID":"20261004120652-v7spqz4","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-v7spqz4","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ovlmii5","Type":"NodeParagraph","Properties":{"id":"20261004120652-ovlmii5","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：WSGI 同步一请求一线程、ASGI 异步事件循环高并发 IO；单进程=无跨进程状态同步问题，配合 asyncio 足够（内部工具、QPS 低）。"}]}]},{"ID":"20261004120652-qx9rbfw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-qx9rbfw","updated":"20261004120652"},"Children":[{"ID":"20261004120652-szn0aqm","Type":"NodeParagraph","Properties":{"id":"20261004120652-szn0aqm","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：内网工具服务并发低、CPU 轻（大活交给 CDB 子进程/客户端），单进程 asyncio 最简单可靠；讲清\"什么时候我会加多进程/换 DB\"（数据量涨、CPU 算统计）就是场景题答案（见 G7）。"}]}]}]},{"ID":"20261004120652-a5hr70y","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-a5hr70y","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"E2 Python 的 GIL 是什么？有 GIL 还需要加锁吗？"}]},{"ID":"20261004120652-mnlijtx","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-mnlijtx","updated":"20261004120652"},"Children":[{"ID":"20261004120652-2i9p6os","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-2i9p6os","updated":"20261004120652"},"Children":[{"ID":"20261004120652-pt0z8m4","Type":"NodeParagraph","Properties":{"id":"20261004120652-pt0z8m4","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"高频必考"},{"Type":"NodeText","Data":"，正好你的服务是多线程/协程混合。"}]}]},{"ID":"20261004120652-rfcvzmm","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-rfcvzmm","updated":"20261004120652"},"Children":[{"ID":"20261004120652-4nil88k","Type":"NodeParagraph","Properties":{"id":"20261004120652-4nil88k","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：GIL 保证同一时刻一个线程执行字节码、多线程 CPU 密集不加速、IO 密集会释放 GIL；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"GIL 不是并发正确性的保证"},{"Type":"NodeText","Data":"——"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dict[k] = v"},{"Type":"NodeText","Data":" 这类单字节码才原子，多步操作仍要锁；asyncio 单线程协程间无抢占（无 await 的段原子）。"}]}]},{"ID":"20261004120652-ve6mm7b","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ve6mm7b","updated":"20261004120652"},"Children":[{"ID":"20261004120652-64lvcyt","Type":"NodeParagraph","Properties":{"id":"20261004120652-64lvcyt","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：stats_server 是单线程事件循环+asyncio.Lock——锁防的是 await 点交错而非 CPU 并行，所以用 asyncio.Lock 而非 threading.Lock（见 C5）；CDB 干脆子进程绕开 GIL。"}]}]}]},{"ID":"20261004120652-65gtwe8","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-65gtwe8","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"E3 JSONL 文件当数据库用的取舍？什么时候该换数据库？"}]},{"ID":"20261004120652-6sqik5g","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-6sqik5g","updated":"20261004120652"},"Children":[{"ID":"20261004120652-frnod7i","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-frnod7i","updated":"20261004120652"},"Children":[{"ID":"20261004120652-ny8bfhj","Type":"NodeParagraph","Properties":{"id":"20261004120652-ny8bfhj","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：归档 JSONL vs DB 是你的招牌取舍题。"}]}]},{"ID":"20261004120652-3wdnbbw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-3wdnbbw","updated":"20261004120652"},"Children":[{"ID":"20261004120652-w9ohiqf","Type":"NodeParagraph","Properties":{"id":"20261004120652-w9ohiqf","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：JSONL append-only 实现零依赖、崩溃友好（追加不破坏旧数据）、可直接进 Git/分析脚本；代价是查询靠全量扫描/内存索引、聚合能力弱、重写整文件。换 DB 的信号：数据量\u003e内存、需要复杂查询/并发写、多实例。"}]}]},{"ID":"20261004120652-cnxlwwo","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-cnxlwwo","updated":"20261004120652"},"Children":[{"ID":"20261004120652-7kz4ifh","Type":"NodeParagraph","Properties":{"id":"20261004120652-7kz4ifh","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：归档走\"本地 JSONL + 异步 POST 统计后台\"双写；stats_server 按 userName 拆文件追加、内存索引 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_index"},{"Type":"NodeText","Data":"/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"_user_records"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"build_index"},{"Type":"NodeText","Data":" 启动重建——\"单机单写者场景 JSONL 够用且最稳\"，同时给出迁移到 MySQL 的路径（见 G4）。"}]}]}]},{"ID":"20261004120652-c1yerqu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-c1yerqu","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"E4 崩溃恢复：先落盘还是先改内存？你们两个方向都用了，为什么？"}]},{"ID":"20261004120652-xckz52f","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-xckz52f","updated":"20261004120652"},"Children":[{"ID":"20261004120652-n77psv0","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-n77psv0","updated":"20261004120652"},"Children":[{"ID":"20261004120652-c05fo33","Type":"NodeParagraph","Properties":{"id":"20261004120652-c05fo33","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：report 先落盘后改内存，feedback 反过来——有意为之的不对称。"}]}]},{"ID":"20261004120652-8wlvu30","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-8wlvu30","updated":"20261004120652"},"Children":[{"ID":"20261004120652-58belhf","Type":"NodeParagraph","Properties":{"id":"20261004120652-58belhf","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：持久化顺序决定崩溃后的状态：先写盘再改内存=崩溃后可从盘重建（丢内存不丢数据）；先改内存再写盘=崩溃丢最后一次写（丢写）。选择看\"哪边可重建\"。"}]}]},{"ID":"20261004120652-7idmvn3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-7i