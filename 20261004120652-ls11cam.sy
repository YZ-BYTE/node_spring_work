4120652-12frwp9","updated":"20261004120652"},"Children":[{"ID":"20261004120652-fykglgr","Type":"NodeParagraph","Properties":{"id":"20261004120652-fykglgr","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：mtime 会被拷贝/备份/异常断电改写、不稳定；文件名内嵌业务日期是不可变事实。固定名主文件+滚动生成带日期历史文件是常见日志轮转设计（对比 logrotate）。"}]}]},{"ID":"20261004120652-czdayxn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-czdayxn","updated":"20261004120652"},"Children":[{"ID":"20261004120652-7dcmem0","Type":"NodeParagraph","Properties":{"id":"20261004120652-7dcmem0","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"TrimOldMainLogs"},{"Type":"NodeText","Data":" 启动时扫盘，正则解析文件名日期删 7 天前的历史文件；spdlog "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"max_files"},{"Type":"NodeText","Data":" 只能管运行期数量，用户长期不启动时 max_files 形同虚设——所以两层：运行期靠 max_files、启动期靠日期兜底，覆盖\"断续启动\"场景。"}]}]}]},{"ID":"20261004120652-69bvedv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-69bvedv","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C11 进程被强杀/断电会发生什么？你们哪些设计是为\"被强杀\"准备的？"}]},{"ID":"20261004120652-w12vgvz","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-w12vgvz","updated":"20261004120652"},"Children":[{"ID":"20261004120652-pynko0g","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-pynko0g","updated":"20261004120652"},"Children":[{"ID":"20261004120652-kgls9ro","Type":"NodeParagraph","Properties":{"id":"20261004120652-kgls9ro","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"触发点"},{"Type":"NodeText","Data":"：高频追问点：清理为什么放启动时做、半截包问题。"}]}]},{"ID":"20261004120652-itqxhng","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-itqxhng","updated":"20261004120652"},"Children":[{"ID":"20261004120652-l2dxhzg","Type":"NodeParagraph","Properties":{"id":"20261004120652-l2dxhzg","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"要点"},{"Type":"NodeText","Data":"：强杀跳过析构/flush：日志丢缓冲、文件写一半、锁不释放（OS 级锁自动释放，用户态标志位丢失）。设计对策：启动时补偿（清理、校验）、写入原子性、幂等重放。"}]}]},{"ID":"20261004120652-ghbs19r","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-ghbs19r","updated":"20261004120652"},"Children":[{"ID":"20261004120652-7dx2b53","Type":"NodeParagraph","Properties":{"id":"20261004120652-7dx2b53","updated":"20261004120652"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结合实习"},{"Type":"NodeText","Data":"：① 清理在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"InitLog"},{"Type":"NodeText","Data":" 首步做，强杀/断电必然在下次启动触发；② 强杀丢异步日志队列是接受的降级（三个刷盘时机压缩窗口）；③ 下载被强杀留下\"文件名完整内容截断\"的半截包→同版本也统一走下载、第一步签名校验短路/补全——全是同一个故障模型的产物。"}]}]}]},{"ID":"20261004120652-3gd0o4m","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20261004120652-3gd0o4m","updated":"20261004120652"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"C12 虚拟内存/页置换/零拷贝 mmap 了解吗？（中频）"}]},{"ID":"20261004120652-i2qa21w","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20261004120652-i2qa21w","updated":"20261004120652"},"Children":[{"ID":"20261004120652-2mvrhp1","Type":"NodeListItem","Data":"-","ListData":{"Tight