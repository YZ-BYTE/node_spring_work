updated":"20260902232323"},"Children":[{"ID":"20260902232323-v285zfq","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-v285zfq","updated":"20260902232323"},"Children":[{"ID":"20260902232323-opvah5c","Type":"NodeParagraph","Properties":{"id":"20260902232323-opvah5c","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"参与企业微信日志分析工具中 Crash 分析功能的设计与开发，基于 Flutter/Dart 实现从反馈包解压、dump 预筛到深度归因的完整流水线。"}]}]},{"ID":"20260902232323-nd63aqk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-nd63aqk","updated":"20260902232323"},"Children":[{"ID":"20260902232323-dn9xgf5","Type":"NodeParagraph","Properties":{"id":"20260902232323-dn9xgf5","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"实现基于 SHA-1 指纹缓存和后台 isolate 的 zip 解压与输入归一化，支持 zip/dmp/混合输入，通过 Future.any 滑动窗口并发预筛，最多保留 5 个崩溃候选。"}]}]},{"ID":"20260902232323-rwkhfvr","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-rwkhfvr","updated":"20260902232323"},"Children":[{"ID":"20260902232323-zfd9n0q","Type":"NodeParagraph","Properties":{"id":"20260902232323-zfd9n0q","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"封装 CDB MCP 服务桥接层，实现 exception_info/module_list/kb/!analyze -v 四步深度采证与四级栈帧降级，保证增强命令失败不拖垮主流程。"}]}]},{"ID":"20260902232323-8t83mxx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-8t83mxx","updated":"20260902232323"},"Children":[{"ID":"20260902232323-wpcd67h","Type":"NodeParagraph","Properties":{"id":"20260902232323-wpcd67h","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"设计并实现 S0~S5+R8 确定性规则归因引擎，通过内存破坏模式、透明模块过滤、置信度钳位、未知模块主导性检查等机制控制误判，输出分类、置信度、证据链和客服话术。"}]}]},{"ID":"20260902232323-qlwbymc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-qlwbymc","updated":"20260902232323"},"Children":[{"ID":"20260902232323-5ivfg97","Type":"NodeParagraph","Properties":{"id":"20260902232323-5ivfg97","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"实现内存日志专项分析与 Intel 13/14 代 CPU 缺陷检测，通过强弱信号分级和覆盖矩阵对规则结论做受约束修正。"}]}]},{"ID":"20260902232323-wijz8u5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-wijz8u5","updated":"20260902232323"},"Children":[{"ID":"20260902232323-3in9f1b","Type":"NodeParagraph","Properties":{"id":"20260902232323-3in9f1b","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"实现本地 JSONL 归档与远端异步上报，反馈和备注关联归档记录，形成分析结果质量闭环。"}]}]},{"ID":"20260902232323-7zih3pa","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260902232323-7zih3pa","updated":"20260902232323"},"Children":[{"ID":"20260902232323-5in10ok","Type":"NodeParagraph","Properties":{"id":"20260902232323-5in10ok","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"开发 crash 分析统计后台，基于 Starlette + FastMCP 提供上报、查询、统计和 Web 看板三种入口，通过 JSONL 持久化、内存索引、用户级写锁和运营层分类聚合实现分析结果的可视化统计与质量反馈闭环。"}]}]}]},{"ID":"20260902232323-5eczouc","Type":"NodeParagraph","Properties":{"id":"20260902232323-5eczouc","updated":"20260902232323"},"Children":[{"Type":"NodeText","Data":"不要写项目没有证据支撑的内容，例如\"使用大模型自动归因生产链路\"\"实现微服务高可用\"\"服务端用 C++ 开发\"等。"}]}]}