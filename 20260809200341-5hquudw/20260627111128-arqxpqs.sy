0627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"4. 关键数据结构"}]},{"ID":"20260627111128-mbsu28x","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-mbsu28x","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.1 规则配置层：增量扩展 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RuleConfigObject"}]},{"ID":"20260627111128-qfl1pxa","Type":"NodeParagraph","Properties":{"id":"20260627111128-qfl1pxa","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像给现有的规则字典加上了“智能标签”。以前系统只知道“匹配到A就输出B”，现在加上这些字段后，系统就能知道“这条规则代表微信自己的问题，且证据很强”。"}]},{"ID":"20260627111128-8irlw9w","Type":"NodeParagraph","Properties":{"id":"20260627111128-8irlw9w","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：不破坏现有的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"config.json"},{"Type":"NodeText","Data":" 结构和解析逻辑，仅在单条规则上增加分类和证据元信息。旧规则如果没有这些字段，默认按 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unknown"},{"Type":"NodeText","Data":" 处理。"}]},{"ID":"20260627111128-xmrsljl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-xmrsljl","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class RuleConfigObject {\n  // ... 现有字段保持完全不变 (rule_id, prekeyword, match, reason, solution 等) ...\n\n  // --- 新增：分类与证据元信息 (按需解析) ---\n  String? rootCategory;      // 问题类型: wx_self, third_party, environment, network, unknown 等\n  String? attributionSide;   // 责任侧: wx_self, third_party, neutral\n  String? evidenceLevel;     // 证据强度: strong, medium, weak\n  bool allowDirectOutput = false; // 是否允许单条强证据直接出结论\n  List\u003cString\u003e? sceneTagList;// 场景标签: dns, disk, proxy 等\n  String? defaultActionType; // 默认下一步动作: reply_user, escalate_to_dev 等\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-jzt2ptq","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-jzt2ptq","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.2 输入准备层："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisSource"},{"Type":"NodeText","Data":" \u0026 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PreparedInput"}]},{"ID":"20260627111128-i7wqgr4","Type":"NodeParagraph","Properties":{"id":"20260627111128-i7wqgr4","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像在厨房里加了一个“配菜员”。以前是把整个购物袋（zip路径）直接扔给厨师（分析引擎），现在是由配菜员先洗菜切菜，把日志、Dump文件、网络日志分门别类装进标准化的“备菜盘”（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PreparedInput"},{"Type":"NodeText","Data":"）里，再端给厨师。"}]},{"ID":"20260627111128-rmmz26o","Type":"NodeParagraph","Properties":{"id":"20260627111128-rmmz26o","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：替代目前直接传递 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"String logFilePath"},{"Type":"NodeText","Data":" 的做法，统一收口文件输入，并标准化解压/扫描后的分析材料，为后续分流（普通日志、Dump、网络日志）提供确定性输入。"}]},{"ID":"20260627111128-2i8ltut","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-2i8ltut","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 前端传入的原始输入源\nclass AnalysisSource {\n  final String sourceType; // 默认 'file'\n  final String filePath;   // zip 或 log 的本地路径\n  final String displayName;\n  \n  AnalysisSource({this.sourceType = 'file', required this.filePath, required this.displayName});\n}\n\n/// 内部标准化分析材料 (由解压和扫描阶段产出)\nclass PreparedInput {\n  final String preparedType; // 分流标识: plain_log, dump_bundle, dump_only, network_log_segment\n  final String sourceFingerprint; // 用于结果缓存的输入指纹\n  \n  // 物理载体\n  final String? logFilePath;\n  final List\u003cString\u003e? dumpFilePathList; // 输入准备阶段提取到的全部 dump 本地路径（未经筛选）\n  final List\u003cString\u003e? symbolFilePathList; // 提取的符号文件 (本地路径，如 .pdb)\n  List\u003cString\u003e? dumpSha1List;           // 上传到 MCP 服务器后获取的 SHA1 列表 (由分析层调度上传后补充)\n  bool isSymbolsUploaded;               // 符号文件是否已成功上传并建立索引\n  final String? dumpUrl;                // 从 zip 中提取的 dump 下载地址\n  \n  // 附加上下文 (按需存在)\n  final bool hasLogContext;\n  final DumpHints? dumpHints;           // log 预分析提取的线索 (issueType, timeWindow 等)\n  final NetworkLogSegment? logSegment;  // 网络日志选段与压缩结果，作为正交特征可挂载到 dump_bundle 或独立形成 network_log_segment\n\n  PreparedInput({\n    required this.preparedType,\n    required this.sourceFingerprint,\n    this.logFilePath,\n    this.dumpFilePathList,\n    this.symbolFilePathList,\n    this.dumpUrl,\n    this.isSymbolsUploaded = false,\n    this.hasLogContext = false,\n    this.dumpHints,\n    this.logSegment,\n  });\n}\n\n// 辅助类：Dump 线索与网络日志片段\nclass DumpHints {\n  String? issueType;\n  String? timeWindow;\n  List\u003cString\u003e? modules;\n}\n\nclass NetworkLogSegment {\n  String? sourceFile;\n  String? compressedContent; // 压缩后的关键事件与时间线，直接喂给 AI\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-09yll6h","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-09yll6h","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.3 内部处理层："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"EvidenceEvent"}]},{"ID":"20260627111128-qtw64f4","Type":"NodeParagraph","Properties":{"id":"20260627111128-qtw64f4","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像从“交警直接贴罚单”变成了“侦探先收集线索”。以前匹配到一行日志就立刻生成一条界面展示文本；现在是先把它当成一个“证据”记录在案，等收集完所有证据后，再综合算总账，避免一两行偶发报错导致误判。"}]},{"ID":"20260627111128-4gl6rrc","Type":"NodeParagraph","Properties":{"id":"20260627111128-4gl6rrc","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"log-only"},{"Type":"NodeText","Data":" 场景下，命中规则不再直接等价于最终结论，而是先沉淀为“证据单元”，用于后续的去重和责任侧计分（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wxScore"},{"Type":"NodeText","Data":", "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"thirdPartyScore"},{"Type":"NodeText","Data":"）。这个结构仅在分析层内部流转，不暴露给 UI。"}]},{"ID":"20260627111128-z8v7fzz","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-z8v7fzz","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class EvidenceEvent {\n  final String ruleId;\n  final String sourceFile;\n  final int lineIndex;\n  final String rawText;\n  final String? attributionSide; // 继承自 RuleConfigObject\n  final String? evidenceLevel;   // 继承自 RuleConfigObject\n  final String dedupFingerprint; // 用于去重的指纹 (规则ID + 文件名 + 去噪内容 + TraceID)\n\n  EvidenceEvent({\n    required this.ruleId,\n    required this.sourceFile,\n    required this.lineIndex,\n    required this.rawText,\n    this.attributionSide,\n    this.evidenceLevel,\n    required this.dedupFingerprint,\n  });\n}\n\n/// 本地规则提炼的结构化摘要 (用于 log-only 场景下升级 AI 仲裁)\nclass LocalRuleSummary {\n  final int wxScore;\n  final int thirdPartyScore;\n  final int neutralScore;\n  final List\u003cEvidenceEvent\u003e topEvidences; // 去重后的核心证据片段\n  final List\u003cString\u003e conflictPoints;      // 发现的冲突点\n  final List\u003cString\u003e missingItems;        // 缺失项说明\n  final List\u003cString\u003e sceneTagList;        // 场景标签\n\n  LocalRuleSummary({\n    required this.wxScore,\n    required this.thirdPartyScore,\n    required this.neutralScore,\n    required this.topEvidences,\n    this.conflictPoints = const [],\n    this.missingItems = const [],\n    this.sceneTagList = const [],\n  });\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-cqdnhra","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-cqdnhra","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.4 统一输出层："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisResult"}]},{"ID":"20260627111128-jglo7ie","Type":"NodeParagraph","Properties":{"id":"20260627111128-jglo7ie","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像一份标准的“体检报告单”。以前系统输出的只是一堆散落的文本块，客服还得自己总结；现在强制要求系统输出结构化的结论（是谁的锅、怎么回复用户、怎么转交研发），最后再“降维”成界面文本展示，既保住了现有 UI，又实现了智能归因。"}]},{"ID":"20260627111128-xdhfuhp","Type":"NodeParagraph","Properties":{"id":"20260627111128-xdhfuhp","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：无论底层是本地规则、Dump AI 还是网络日志 AI，最终都收敛为这个统一结果对象。它包含了客服闭环所需的所有要素，并与 UI 完全解耦。"}]},{"ID":"20260627111128-lt3l7vq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-lt3l7vq","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class AnalysisResult {\n  // ==========================================\n  // 1. 元数据与来源标识 (Meta Info)\n  // ==========================================\n  /// 结果来源类型: local_rule(本地规则), dump_attribution(Dump归因), network_log_summary(网络日志总结)\n  final String resultType; \n  /// 分析指纹: 用于缓存复用，避免相同的日志/Dump重复调用 AI。\n  /// 采用“按需组合”的动态指纹策略：根据 resultType 动态决定将哪些版本因子（如 ruleVersion, modelVersion, mcpVersion）纳入 Hash 计算，避免无关模块升级导致缓存失效。\n  final String? analysisFingerprint; \n  /// 是否命中了本地缓存\n  final bool cacheHit;\n\n  // ==========================================\n  // 2. 核心结论 (Core Conclusion)\n  // ==========================================\n  /// 一句话结论 (例如: \"检测到第三方输入法注入导致微信崩溃\")\n  final String headline;\n  /// 责任侧分类: wx_self(微信自身), third_party(第三方), environment(环境), network(网络), unknown(未知)\n  final String classification;\n  /// 分类置信度: high, medium, low (主要用于本地规则判定时，表达证据的充分程度)\n  final String? classificationConfidence;\n  /// 第三方主体名称 (仅在 classification 为 third_party 时存在，如 \"搜狗输入法\")\n  final String? thirdPartyName;\n\n  // ==========================================\n  // 3. 客服闭环动作 (Actionable Advice)\n  // ==========================================\n  /// 下一步动作建议: reply_user(回复用户), escalate_to_dev(转交研发), ask_for_more_info(补充材料)\n  final String actionType;\n  /// 面向用户的回复话术 (通俗易懂，可直接复制给用户)\n  final String userReplyTemplate;\n  /// 面向研发的技术摘要 (包含堆栈、寄存器、关键日志行等硬核信息，转单时使用)\n  final String developerSummary;\n\n  // ==========================================\n  // 4. 证据与上下文 (Evidence \u0026 Context)\n  // ==========================================\n  /// 关键证据列表 (支撑上述结论的核心日志行或 Dump 堆栈片段)\n  final List\u003cString\u003e evidenceList;\n  /// 缺失信息说明 (例如: \"缺少网络日志，无法判断是否为弱网导致\")\n  final List\u003cString\u003e missingInfoList;\n  /// 上下文完整度标签: full_context(日志+Dump), log_guided_dump(日志引导的Dump), dump_only(仅Dump)\n  final String? contextLevel;\n\n  // ==========================================\n  // 5. 异常兜底 (Fallback)\n  // ==========================================\n  /// 错误信息 (当 AI 调用失败、解压失败或完全无法分析时，用于前端展示兜底文案)\n  final String? errorMessage;\n\n  // ==========================================\n  // 6. 规则演进 (Rule Evolution)\n  // ==========================================\n  /// AI 建议沉淀的规则草案 (仅在特定高置信度场景下由 AI 生成，不用于前端展示，仅用于后台静默收集)\n  final RuleDraft? suggestedRuleDraft;\n\n  AnalysisResult({\n    required this.resultType,\n    required this.headline,\n    required this.classification,\n    required this.actionType,\n    required this.userReplyTemplate,\n    required this.developerSummary,\n    this.analysisFingerprint,\n    this.cacheHit = false,\n    this.classificationConfidence,\n    this.thirdPartyName,\n    this.evidenceList = const [],\n    this.missingInfoList = const [],\n    this.contextLevel,\n    this.errorMessage,\n    this.suggestedRuleDraft,\n  });\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-1wqp1ds","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-1wqp1ds","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.5 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisProgress"}]},{"ID":"20260627111128-fso1mqk","Type":"NodeParagraph","Properties":{"id":"20260627111128-fso1mqk","updated":"20260627111128"},"Children":[{"Type":"NodeText","Data":"表示分析过程中的前端可见状态。"}]},{"ID":"20260627111128-azvj0cx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-azvj0cx","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class AnalysisProgress {\n  final String status; // running / succeeded / failed\n  final String progressText;\n  final AnalysisResult? result;\n\n  AnalysisProgress({\n    required this.status,\n    required this.progressText,\n    this.result,\n  });\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-aq6yx85","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-aq6yx85","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.6 网络日志预处理核心逻辑"}]},{"ID":"20260627111128-kiegjzw","Type":"NodeParagraph","Properties":{"id":"20260627111128-kiegjzw","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：在将网络日志送入 AI 前，必须经过候选识别、本地选段和去重压缩，以极致优化 Token 消耗并保留关键时序。"}]},{"ID":"20260627111128-uizlprr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-uizlprr","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class NetworkLogIdentifier {\n  static bool isNetworkLogCandidate(String fileName, String content) {\n    // 1. 文件级识别\n    final networkKeywords = ['network', 'http', 'socket', 'ws', 'connect', 'dns', 'tls'];\n    if (networkKeywords.any((k) =\u003e fileName.toLowerCase().contains(k))) return true;\n    \n    // 2. 内容级识别\n    final networkPatterns = [\n      RegExp(r'DNS.*fail', caseSensitive: false),\n      RegExp(r'TLS.*error', caseSensitive: false),\n      RegExp(r'timeout', caseSensitive: false),\n      RegExp(r'connect.*fail', caseSensitive: false),\n    ];\n    return networkPatterns.any((p) =\u003e p.hasMatch(content));\n  }\n}\n\nclass NetworkLogCompressor {\n  static String compressNetworkLog(String content) {\n    final lines = content.split('\\n');\n    final compressedLines = \u003cString\u003e[];\n    final signatureCount = \u003cString, int\u003e{};\n    \n    for (final line in lines) {\n      final signature = _normalizeLine(line); // 归一化：移除时间戳、UUID、IP等\n      signatureCount[signature] = (signatureCount[signature] ?? 0) + 1;\n      \n      // 保护状态变化与错误码变化，折叠纯重复\n      if (_shouldKeepLine(line, signature, signatureCount[signature]!)) {\n        compressedLines.add(line);\n      }\n    }\n    \n    // 补充重复统计信息\n    // ...\n    return compressedLines.join('\\n');\n  }\n  \n  static String _normalizeLine(String line) { /* ... */ return line; }\n  static bool _shouldKeepLine(String line, String sig, int count) { /* ... */ return true; }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-udjlgei","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-udjlgei","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.7 AI 桥接组装逻辑"}]},{"ID":"20260627111128-0x67kei","Type":"NodeParagraph","Properties":{"id":"20260627111128-0x67kei","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AiBridge"},{"Type":"NodeText","Data":" 负责将本地预处理产出的结构化数据（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"NetworkLogSegment"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"DumpHints"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"LocalRuleSummary"},{"Type":"NodeText","Data":"）组装为 JSON 喂给大模型，并将大模型返回的 JSON 严格映射为统一的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisResult"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260627111128-miwcipe","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-miwcipe","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class AiBridge {\n  Future\u003cAnalysisResult\u003e analyze(PreparedInput input, {LocalRuleSummary? localSummary}) async {\n    String prompt = \"\";\n    \n    if (input.preparedType == 'network_log_segment') {\n      final networkSummary = {\n        \"source_file\": input.logSegment?.sourceFile,\n        \"compressed_content\": input.logSegment?.compressedContent,\n        // 提取关键网络事件、时间线摘要、重复统计等\n      };\n      final template = ConfigManager.getPrompt('networkTemplate');\n      prompt = template.replaceAll('{{networkSummaryJson}}', jsonEncode(networkSummary));\n    } else if (input.preparedType == 'dump_bundle' || input.preparedType == 'dump_only') {\n      // 组装 Dump 分析材料与 DumpHints\n      final dumpAnalysisInput = {\n        \"dumpSha1List\": input.dumpSha1List ?? [], // 必须是上传后获取的 SHA1\n        \"dumpUrl\": input.dumpUrl,\n        \"dumpHints\": input.dumpHints != null ? {\n          \"issueType\": input.dumpHints!.issueType,\n          \"timeWindow\": input.dumpHints!.timeWindow,\n          \"modules\": input.dumpHints!.modules,\n        } : null,\n        // 将网络日志片段作为 Dump 分析的补充上下文\n        \"networkContext\": input.logSegment != null ? {\n          \"compressed_content\": input.logSegment!.compressedContent\n        } : null,\n      };\n      final template = ConfigManager.getPrompt('dumpAttributionTemplate');\n      prompt = template.replaceAll('{{dumpAnalysisJson}}', jsonEncode(dumpAnalysisInput));\n    } else if (input.preparedType == 'plain_log' \u0026\u0026 localSummary != null) {\n      // 组装 log-only 场景下的 AI 仲裁输入\n      final logArbitrationInput = {\n        \"wxScore\": localSummary.wxScore,\n        \"thirdPartyScore\": localSummary.thirdPartyScore,\n        \"neutralScore\": localSummary.neutralScore,\n        \"evidences\": localSummary.topEvidences.map((e) =\u003e e.rawText).toList(),\n        \"conflictPoints\": localSummary.conflictPoints,\n        \"missingItems\": localSummary.missingItems,\n        \"sceneTags\": localSummary.sceneTagList,\n      };\n      final template = ConfigManager.getPrompt('logArbitrationTemplate');\n      prompt = template.replaceAll('{{logArbitrationJson}}', jsonEncode(logArbitrationInput));\n    }\n    \n    // 调用 CAOI 获取大模型返回的 JSON 字符串\n    final String llmResponseText = await _callCaio(prompt);\n    final Map\u003cString, dynamic\u003e jsonMap = jsonDecode(llmResponseText);\n    \n    RuleDraft? draft;\n    if (jsonMap['suggestedRuleDraft'] != null) {\n      final draftMap = jsonMap['suggestedRuleDraft'];\n      draft = RuleDraft(\n        prekeyword: draftMap['prekeyword'],\n        match: draftMap['match'],\n        reason: draftMap['reason'],\n        solution: draftMap['solution'],\n        rootCategory: draftMap['rootCategory'],\n        attributionSide: draftMap['attributionSide'],\n        evidenceLevel: draftMap['evidenceLevel'],\n        allowDirectOutput: draftMap['allowDirectOutput'] ?? false,\n        sceneTagList: draftMap['sceneTagList'] != null ? List\u003cString\u003e.from(draftMap['sceneTagList']) : null,\n        defaultActionType: draftMap['defaultActionType'],\n        draftReason: draftMap['draftReason'],\n        sampleLogLine: draftMap['sampleLogLine'] ?? \"\",\n      );\n      \n      // 触发本地静默落盘逻辑 (不阻塞主分析链路)\n      LocalRuleManager.saveDraft(draft);\n    }\n\n    // 统一映射为 AnalysisResult\n    return AnalysisResult(\n      resultType: input.preparedType,\n      headline: jsonMap['headline'],\n      classification: jsonMap['classification'],\n      classificationConfidence: jsonMap['classificationConfidence'],\n      thirdPartyName: jsonMap['thirdPartyName'],\n      actionType: jsonMap['actionType'],\n      userReplyTemplate: jsonMap['userReplyTemplate'],\n      developerSummary: jsonMap['developerSummary'],\n      evidenceList: List\u003cString\u003e.from(jsonMap['evidenceList'] ?? []),\n      missingInfoList: List\u003cString\u003e.from(jsonMap['missingInfoList'] ?? []),\n      contextLevel: input.preparedType, // 实际落地时可映射为 full_context, log_guided_dump, dump_only 等\n      errorMessage: jsonMap['errorMessage'],\n      suggestedRuleDraft: draft,\n    );\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-nsbypqv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-nsbypqv","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.8 规则草案数据结构 ("},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RuleDraft"},{"Type":"NodeText","Data":")"}]},{"ID":"20260627111128-4lihc76","Type":"NodeParagraph","Properties":{"id":"20260627111128-4lihc76","updated":"20260627111128"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计意图"},{"Type":"NodeText","Data":"：承载 AI 动态生成的规则草案，结构上高度对齐现有的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RuleConfigObject"},{"Type":"NodeText","Data":"，但增加了用于辅助判断的字段（如生成理由）。该结构独立于主展示链路，直接在客户端本地落盘，形成动态规则库。"}]},{"ID":"20260627111128-yj66mj6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-yj66mj6","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// AI 生成的候选规则草案\nclass RuleDraft {\n  // --- 核心规则字段 (对齐 RuleConfigObject) ---\n  final String prekeyword;\n  final String match;\n  final String reason;\n  final String solution;\n  final String rootCategory;\n  final String attributionSide;\n  final String evidenceLevel;\n  final bool allowDirectOutput;\n  final List\u003cString\u003e? sceneTagList;\n  final String? defaultActionType;\n\n  // --- 辅助字段 (草案特有，供本地管理与排查用) ---\n  final String draftReason;      // AI 解释为什么建议将此特征沉淀为规则\n  final String sampleLogLine;    // 触发生成该草案的原始日志行样本 (用于研发回归测试)\n\n  RuleDraft({\n    required this.prekeyword,\n    required this.match,\n    required this.reason,\n    required this.solution,\n    required this.rootCategory,\n    required this.attributionSide,\n    required this.evidenceLevel,\n    required this.allowDirectOutput,\n    this.sceneTagList,\n    this.defaultActionType,\n    required this.draftReason,\n    required this.sampleLogLine,\n  });\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-5bf0rt4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260627111128-5bf0rt4","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"5. 主链路时序"}]},{"ID":"20260627111128-281joli","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-281joli","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.1 文件分析统一主链路"}]},{"ID":"20260627111128-dz8pcbv","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-dz8pcbv","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"sequenceDiagram\n    participant UI as Flutter界面\n    participant MG as LogManager\n    participant DS as 分析层(datasource)\n    participant IP as 输入准备\n    participant LR as 本地规则分析\n    participant UP as 上传模块\n    participant AI as AI桥接\n    participant CA as CAOI\n    participant MCP as cdb-analysis MCP\n    participant RM as 结果整理\n\n    UI-\u003e\u003eMG: 上传 zip / 日志文件\n    MG-\u003e\u003eDS: analyzeSource(file)\n    DS-\u003e\u003eIP: prepare(source)\n    IP--\u003e\u003eDS: PreparedInput (包含原始本地路径)\n    \n    opt log + dump 场景\n        DS-\u003e\u003eLR: quickScan(log)\n        LR--\u003e\u003eDS: 返回短路结果 或 dumpHints\n    end\n\n    alt 触发本地强规则短路\n        DS--\u003e\u003eMG: AnalysisResult (直接输出本地结论)\n    else 正常准备完成\n        opt 存在 dumpHints\n            DS-\u003e\u003eDS: 根据 dumpHints 筛选保留项 Dump\n        end\n\n        opt 需要上传 Dump\n            DS-\u003e\u003eUP: 获取上传凭证并并发直传 Dump 与符号\n            UP--\u003e\u003eDS: 返回 dump_sha1 与符号上传状态\n            DS-\u003e\u003eDS: 将 sha1 补充到 PreparedInput\n        end\n\n        alt 普通日志\n            DS-\u003e\u003eLR: analyze(preparedInput)\n            LR--\u003e\u003eDS: AnalysisResult 或 LocalRuleSummary\n            opt 需要升级 AI 仲裁\n                DS-\u003e\u003eAI: analyze(preparedInput, localSummary)\n                AI-\u003e\u003eCA: 发起 log-only 仲裁请求\n                CA--\u003e\u003eAI: ai result\n                AI--\u003e\u003eDS: AnalysisResult\n            end\n        else log + dump (常规主路径)\n            DS-\u003e\u003eAI: analyze(preparedInput)\n            alt MCP 可用且已提取 dump 分析材料\n                AI-\u003e\u003eCA: 发起 dump 定向归因请求（使用 dump_sha1，附带 dumpHints）\n                CA-\u003e\u003eMCP: analyze(dump_bundle)\n                MCP--\u003e\u003eCA: tool evidence\n                CA--\u003e\u003eAI: ai result\n            else MCP 不可用\n                AI-\u003e\u003eCA: 直接传入 dump 分析材料与 dumpHints\n                CA--\u003e\u003eAI: ai result\n            end\n            AI--\u003e\u003eDS: AnalysisResult\n        else 仅 dump\n            DS-\u003e\u003eAI: analyze(preparedInput)\n            alt MCP 可用\n                AI-\u003e\u003eCA: 发起 dump-only 归因请求（使用 dump_sha1）\n                CA-\u003e\u003eMCP: analyze(dump_only)\n                MCP--\u003e\u003eCA: tool evidence\n                CA--\u003e\u003eAI: ai result\n            else MCP 不可用\n                AI-\u003e\u003eCA: 返回受限分析请求\n                CA--\u003e\u003eAI: restricted result\n            end\n            AI--\u003e\u003eDS: AnalysisResult\n        else 网络日志片段\n            DS-\u003e\u003eAI: analyze(preparedInput)\n            AI-\u003e\u003eCA: 发起网络日志总结请求\n            CA--\u003e\u003eAI: ai result\n            AI--\u003e\u003eDS: AnalysisResult\n        end\n    end\n\n    DS-\u003e\u003eRM: toDisplayData(result)\n    RM--\u003e\u003eDS: 展示结果\n    DS--\u003e\u003eMG: 更新结果/进度\n    MG--\u003e\u003eUI: 刷新右侧展示\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-zd5jxg5","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-zd5jxg5","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.2 zip 解压后的输入准备链路"}]},{"ID":"20260627111128-dao4nhg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111128-dao4nhg","updated":"20260627111128"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"sequenceDiagram\n    participant DS as datasource.dart\n    participant ZIP as unzipLogAndGetPath\n    participant PRE as 输入准备逻辑\n    participant OUT as PreparedInput\n\n    DS-\u003e\u003eZIP: 解压 zip 到临时目录\n    ZIP--\u003e\u003eDS: unzipPath\n    DS-\u003e\u003ePRE: 扫描解压结果\n    PRE--\u003e\u003eDS: .log 列表 / .dmp 列表 / 符号文件列表 / dump_url\n    \n    opt 存在 .log\n        DS-\u003e\u003ePRE: 网络特征轻量嗅探\n        PRE--\u003e\u003eDS: 提取并压缩网络片段 logSegment (按需)\n    end\n\n    alt 同时存在 .log 与 .dmp\n        DS-\u003e\u003eOUT: 组装 dump_bundle PreparedInput (包含原始本地路径，按需挂载 logSegment)\n        OUT--\u003e\u003eDS: 返回 PreparedInput\n        DS-\u003e\u003eDS: 调度 LocalRuleAnalyzer.quickScan 尝试短路或提取 dumpHints\n        DS-\u003e\u003eDS: 根据 dumpHints 筛选多个 dump\n    else 仅存在 .dmp\n        PRE--\u003e\u003eDS: 先做完全重复去重与时间戳去重\n        DS-\u003e\u003eOUT: 组装 dump_only PreparedInput (包含本地路径)\n    else 仅存在符号文件无 .dmp\n        PRE--\u003e\u003eDS: 直接丢弃符号文件，按无 dump 处理\n        DS-\u003e\u003eOUT: 按 plain_log / network_log_segment 组装 PreparedInput\n    else 其他输入\n        DS-\u003e\u003eOUT: 按 plain_log / network_log_segment 组装 PreparedInput\n    end\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111128-9xyaxmg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111128-9xyaxmg","updated":"20260627111128"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.3 网络日志选段"}]},{"ID":"20260627111128-5mamvnt","Type":"NodeParagraph","Properties":{"id":"20260627111128-5mamvnt","updated":"20260627111128"},"Children":[{"Type":"NodeText","Data":"说明："}]},{"ID":"20260627111128-7oq43tf","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111128-7oq43tf","updated":"20260627111128"},"Children":[{"ID":"20260627111128-nsllirr","Type":"NodeListItem","Data":"-","ListData":{"Tigh