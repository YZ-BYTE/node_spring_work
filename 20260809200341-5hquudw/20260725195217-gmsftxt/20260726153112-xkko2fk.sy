deText","Data":"栈里命中输入法/文本输入相关关键字，并且环境有输入法类模块"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说是文本输入过程里的输入法问题"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"io_error"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"异常码命中 I/O 类错误，且环境有磁盘加密/DLP/杀毒相关模块"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说是磁盘 I/O 问题，可能受安全软件影响"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hook_crash"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"栈里命中 Hook/注入关键字，且环境有相关安全软件模块"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说是第三方 Hook 注入导致"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tsf_focus_crash"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"栈里命中 TSF/MSCTF 焦点链关键字，且环境有输入法/安全软件模块"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说是系统输入法框架回调链冲突"}]}]}]},{"ID":"20260726153112-voshyaz","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260726153112-voshyaz","updated":"20260726153112"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"5. S2 / S3 / S4-C 兜底话术"}]},{"ID":"20260726153112-uzhjty3","Type":"NodeTable","Data":"| 结果 | 触发条件 | 话术要点 |\n|---|---|---|\n| `third_party_hit` | 栈里直接命中第三方厂商模块 | 直接说该厂商导致崩溃 |\n| `third_party_hit`（scene） | 场景规则命中，但厂商模块没在栈里 | 说“相关模块已加载”，并给场景建议 |\n| `third_party_hit`（hook_interleave） | 非企微模块在前 20 帧里反复出现 \u003e= 3 次 | 说疑似 Hook 注入，要求人工确认 |\n| `third_party_hit`（低置信度） | S4 命中场景，但调用栈里有未知模块干扰 | 继续提示第三方风险，但置信度降级 |","TableAligns":[0,0,0],"Properties":{"id":"20260726153112-uzhjty3","updated":"20260726153112"},"Children":[{"Type":"NodeTableHead","Children