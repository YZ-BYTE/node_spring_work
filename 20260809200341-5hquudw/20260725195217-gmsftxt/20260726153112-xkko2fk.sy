MarkType":"code","TextMarkTextContent":"third_party_not_hit"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"栈顶是企微自身模块，但没命中第三方"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"企微自身问题，建议升级或反馈研发"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"缺异常码、规则都没命中、或调用链太乱"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无法自动判定，建议人工复核"}]}]}]},{"ID":"20260726153112-juvn904","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260726153112-juvn904","updated":"20260726153112"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"3. S1.7 硬件/I-O 场景"}]},{"ID":"20260726153112-nsth8qk","Type":"NodeTable","Data":"| 场景 | 触发条件 | 话术要点 |\n|---|---|---|\n| `hardware_issue` | `STATUS_IN_PAGE_ERROR`，且环境里没检测到 DLP/杀毒/磁盘加密干扰 | 直接偏向磁盘/存储故障 |\n| `hardware_issue_with_ime` | 上面成立，同时检测到第三方输入法 | 还是硬件问题，但加一句排查输入法 |\n| `hardware_issue`（兜底） | 有 DLP/杀毒环境，但 S4 也没把场景讲清楚 | 倾向硬件/存储问题，但语气更保守 |","TableAligns":[0,0,0],"Properties":{"id":"20260726153112-nsth8qk","updated":"20260726153112"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"场景"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"触发条件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"话术要点"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hardware_issue"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"STATUS_IN_PAGE_ERROR"},{"Type":"NodeText","Data":"，且环境里没检测到 DLP/杀毒/磁盘加密干扰"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"直接偏向磁盘/存储故障"}]}]},{"Type