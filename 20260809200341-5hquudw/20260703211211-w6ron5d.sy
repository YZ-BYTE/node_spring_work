xtContent":"third_party_hit"},{"Type":"NodeText","Data":" (medium/low)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"场景关联命中，间接证据"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"S5"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_not_hit"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"企微自身问题"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"6 (最低)"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"S5-兜底"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无法判定，需人工介入"}]}]}]},{"ID":"20260703211211-h4hfcu5","Type":"NodeBlockquote","Properties":{"id":"20260703211211-h4hfcu5","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-f81j6f2","Type":"NodeParagraph","Properties":{"id":"20260703211211-f81j6f2","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"当前串行 if-else 结构天然保证了此优先级顺序。多条件同时满足时，高优先级结果覆盖低优先级，不会出现并行输出。"}]}]},{"ID":"20260703211211-v2yjao3","Type":"NodeParagraph","Properties":{"id":"20260703211211-v2yjao3","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全局置信度钳位规则"},{"Type":"NodeText","Data":"：当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"heapMode=true"},{"Type":"NodeText","Data":"​ 或 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"funcPtrMode=true"},{"Type":"NodeText","Data":"​ 时，无论哪个步骤输出了 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"high"},{"Type":"NodeText","Data":"​ 置信度，最终输出前都会被钳位为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"medium"},{"Type":"NodeText","Data":"​。这是因为内存破坏场景下，即便栈顶是第三方模块，也存在被其他模块踩内存的可能，不应给出 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"high"},{"Type":"NodeText","Data":" 置信判定。"}]},{"ID":"20260703211211-r2tcapk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-r2tcapk","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    A[开始分析] --\u003e S0{S0: 前置检查\u003cbr/\u003eMCP返回数据是否有效?}\n    S0 --\u003e|数据缺失| Z1[unable_to_analyze\u003cbr/\u003econfidence=low\u003cbr/\u003ereason: MCP返回数据异常]\n    S0 --\u003e|完备| S1[S1: exception_code 分流\u003cbr/\u003e+ 堆函数模式检测]\n    \n    S1 --\u003e|0xc0000374 或\u003cbr/\u003e栈顶有堆操作函数| HC[标记 heap_mode=true\u003cbr/\u003econfidence 上限=medium]\n    S1 --\u003e|AV.Fault=Execute 且\u003cbr/\u003eEIP不在任何模块内| FP[标记 funcPtrMode=true\u003cbr/\u003econfidence 上限=medium]\n    S1 --\u003e|其他| HW\n    HC --\u003e HW\n    FP --\u003e HW\n    \n    HW{S1.5: Failure Bucket\u003cbr/\u003e含 hardware_?}\n    HW --\u003e|YES| R0[hardware_issue\u003cbr/\u003econfidence=high\u003cbr/\u003e非软件问题]\n    HW --\u003e|NO 或无数据| S2\n    \n    S2[S2: 构建 userFrames 列表\u003cbr/\u003e过滤 transparent_modules\u003cbr/\u003e去递归重复帧\u003cbr/\u003e取 topUserFrame] --\u003e S2C{userFrames\u003cbr/\u003e为空?}\n    S2C --\u003e|YES| Z2[unable_to_analyze\u003cbr/\u003e所有帧均为系统模块]\n    S2C --\u003e|NO| S3A\n    \n    S3A{Step A: 栈顶用户帧\u003cbr/\u003e∈ 第三方名册?}\n    S3A --\u003e|YES| R1[third_party_hit\u003cbr/\u003econfidence=high/medium\u003cbr/\u003evendor=匹配厂商]\n    S3A --\u003e|NO| S3B\n    \n    S3B{Step B: userFrames 去重后前20个\u003cbr/\u003e有第三方模块?}\n    S3B --\u003e|YES, 相对位置i\u003c5| R2[third_party_hit\u003cbr/\u003econfidence=high]\n    S3B --\u003e|YES, 相对位置5\u003c=i\u003c15| R3[third_party_hit\u003cbr/\u003econfidence=medium]\n    S3B --\u003e|YES, 相对位置i\u003e=15| R3B[third_party_hit\u003cbr/\u003econfidence=low]\n    S3B --\u003e|NO| S4\n    \n    S4{S4: 场景关联检测}\n    S4 --\u003e S4A{输入法场景?\u003cbr/\u003e栈中有文本输入关键词\u003cbr/\u003e+ 加载了输入法模块}\n    S4A --\u003e|YES| R4[third_party_hit\u003cbr/\u003econfidence=medium\u003cbr/\u003escene=text_input]\n    S4A --\u003e|NO| S4B{IO错误场景?\u003cbr/\u003eexception_code=0xc0000006\u003cbr/\u003e+ 加载了磁盘/安全模块}\n    S4B --\u003e|YES| R5[third_party_hit\u003cbr/\u003econfidence=medium\u003cbr/\u003escene=io_error]\n    S4B --\u003e|NO| S4C{模块穿插检测?\u003cbr/\u003e同一未知/第三方模块\u003cbr/\u003e在userFrames中出现\u003e=3次}\n    S4C --\u003e|YES| R6B[third_party_hit\u003cbr/\u003econfidence=low\u003cbr/\u003escene=hook_interleave]\n    S4C --\u003e|NO| S5\n    \n    S5{S5: 栈顶用户帧\u003cbr/\u003e∈ 企微名册?}\n    S5 --\u003e|YES + heapMode| R7H[unable_to_analyze\u003cbr/\u003e堆损坏场景\u003cbr/\u003e栈顶企微帧可能是受害者\u003cbr/\u003e建议人工分析]\n    S5 --\u003e|YES + 非heapMode| R7[third_party_not_hit\u003cbr/\u003e企微自身问题\u003cbr/\u003e需提单给开发]\n    S5 --\u003e|NO| R8[unable_to_analyze\u003cbr/\u003econfidence=low\u003cbr/\u003e附加: 环境中第三方模块列表\u003cbr/\u003e+ 未知模块详情]\n    \n    R1 --\u003e SF[S-Final: 全局置信度钳位]\n    R2 --\u003e SF\n    R3 --\u003e SF\n    R3B --\u003e SF\n    R4 --\u003e SF\n    R5 --\u003e SF\n    R6B --\u003e SF\n    R7 --\u003e SF\n    SF --\u003e SF_CHECK{heapMode OR\u003cbr/\u003efuncPtrMode?}\n    SF_CHECK --\u003e|YES 且 confidence=high| CLAMP[降为 medium\u003cbr/\u003e附加钳位说明到 evidence]\n    SF_CHECK --\u003e|NO 或已\u003c=medium| OUT[输出最终结果]\n    CLAMP --\u003e OUT\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-ngq6ss4","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-ngq6ss4","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.3 各步骤详细规则"}]},{"ID":"20260703211211-b09hndg","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-b09hndg","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S0: 前置检查"}]},{"ID":"20260703211211-2po9tsb","Type":"NodeBlockquote","Properties":{"id":"20260703211211-2po9tsb","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-j8lod4v","Type":"NodeParagraph","Properties":{"id":"20260703211211-j8lod4v","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"说明"},{"Type":"NodeText","Data":"：S0 是防御性兜底，防的是\"MCP 返回了空数据\"这种极端异常（如 dump 文件损坏、MCP 服务异常），而"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不是"},{"Type":"NodeText","Data":"检查\"符号全不全\"。因为："}]},{"ID":"20260703211211-xl0sz2z","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-xl0sz2z","updated":"20260703211211"},"Children":[{"ID":"20260703211211-jf493m4","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-jf493m4","updated":"20260703211211"},"Children":[{"ID":"20260703211211-29zzovq","Type":"NodeParagraph","Properties":{"id":"20260703211211-29zzovq","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"CDB MCP 服务器已内置微软公共符号服务器，系统 DLL 符号基本都能拿到"}]}]},{"ID":"20260703211211-cujf6je","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-cujf6je","updated":"20260703211211"},"Children":[{"ID":"20260703211211-oqr2mw7","Type":"NodeParagraph","Properties":{"id":"20260703211211-oqr2mw7","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"即使完全没有 PDB 符号，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"exceptionCode"},{"Type":"NodeText","Data":"​（来自异常记录）和调用栈中的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"模块名"},{"Type":"NodeText","Data":"（来自 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":" 地址范围映射）都不依赖符号文件"}]}]},{"ID":"20260703211211-76u1kxs","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-76u1kxs","updated":"20260703211211"},"Children":[{"ID":"20260703211211-6jzzutr","Type":"NodeParagraph","Properties":{"id":"20260703211211-6jzzutr","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"我们的规则引擎归因逻辑"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"主要依赖模块名"},{"Type":"NodeText","Data":"匹配（第三方名册、企微名册），不强依赖函数名"}]}]},{"ID":"20260703211211-utsiorx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-utsiorx","updated":"20260703211211"},"Children":[{"ID":"20260703211211-zyssbi1","Type":"NodeParagraph","Properties":{"id":"20260703211211-zyssbi1","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"函数名（需要符号）只在 S4 场景关联的关键词匹配中用到，属于辅助路径"}]}]}]}]},{"ID":"20260703211211-f0okcpf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-f0okcpf","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"bool _passPreCheck(DeepCollectionResult data) {\n  // MCP 是否正常返回了异常代码（不依赖符号，来自异常记录）\n  if (data.exceptionCode == null) return false;\n  // MCP 是否正常返回了调用栈（模块名不依赖符号，来自地址范围映射）\n  if (data.stackFrames.isEmpty) return false;\n  // MCP 是否正常返回了模块列表（lm 命令输出）\n  if (data.loadedModules.isEmpty) return false;\n  return true;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-5i24gsf","Type":"NodeParagraph","Properties":{"id":"20260703211211-5i24gsf","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不通过时"},{"Type":"NodeText","Data":"：输出 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"classification = unable_to_analyze"},{"Type":"NodeText","Data":"​，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"confidence = low"},{"Type":"NodeText","Data":"​，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"reason = \"MCP返回数据异常：缺少异常代码或调用栈（可能dump文件损坏或MCP服务异常）\""},{"Type":"NodeText","Data":"。"}]},{"ID":"20260703211211-laybwvc","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-laybwvc","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S1: exception_code 分流"}]},{"ID":"20260703211211-nx4dk6m","Type":"NodeTable","Data":"|异常码|含义|处理|\n| --------| -------------------| ------------------------------------------|\n|`0xc0000374`|Heap corruption|标记 `heapMode=true`​，后续 confidence 上限为 `medium`|\n|`0xc0000006`|In-page I/O error|标记 `ioErrorMode=true`，场景关联时优先检测磁盘/安全软件|\n|`0xc00000fd`|Stack overflow|标记 `stackOverflowMode=true`，看递归函数所在模块|\n|其他|正常走|无特殊标记|","TableAligns":[0,0,0],"Properties":{"id":"20260703211211-nx4dk6m","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"异常码"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"含义"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"处理"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc0000374"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Heap corruption"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"标记 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"heapMode=true"},{"Type":"NodeText","Data":"​，后续 confidence 上限为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"medium"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc0000006"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"In-page I/O error"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"标记 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"ioErrorMode=true"},{"Type":"NodeText","Data":"，场景关联时优先检测磁盘/安全软件"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc00000fd"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Stack overflow"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"标记 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"stackOverflowMode=true"},{"Type":"NodeText","Data":"，看递归函数所在模块"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"其他"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"正常走"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无特殊标记"}]}]}]},{"ID":"20260703211211-vlgnzmp","Type":"NodeParagraph","Properties":{"id":"20260703211211-vlgnzmp","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计决策"},{"Type":"NodeText","Data":"：不为每种异常码搞独立子链（过度设计），只做标记影响后续步骤的 confidence 和优先级。"}]},{"ID":"20260703211211-p7kugz1","Type":"NodeParagraph","Properties":{"id":"20260703211211-p7kugz1","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补充 A：堆操作函数模式检测"}]},{"ID":"20260703211211-10x5dou","Type":"NodeParagraph","Properties":{"id":"20260703211211-10x5dou","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"即使 exception_code 不是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc0000374"},{"Type":"NodeText","Data":"​，如果栈顶前 5 帧中出现堆操作函数（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RtlAllocateHeap"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"RtlEnterCriticalSection"},{"Type":"NodeText","Data":"​ 等），也应标记 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"heapMode=true"},{"Type":"NodeText","Data":"​。这是因为堆损坏场景下，异常码可能表现为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"0xc0000005"},{"Type":"NodeText","Data":"（AV），但实际根因是堆被第三方写坏。"}]},{"ID":"20260703211211-9oekn39","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-9oekn39","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 在 S1 异常码分流之后，补充堆函数模式检测\nfinal heapFunctions = [\n  'RtlAllocateHeap', 'RtlFreeHeap', 'RtlEnterCriticalSection',\n  'RtlpAllocateHeap', 'RtlDebugAllocateHeap', 'RtlpFreeHeap',\n  'HeapAlloc', 'HeapFree', 'malloc', 'free', 'operator new',\n  'RtlpAllocateHeapInternal', 'RtlSizeHeap',\n];\nbool hasHeapPattern = stackFrames.take(5).any((f) =\u003e\n    heapFunctions.any((fn) =\u003e f.functionName?.contains(fn) ?? false));\nif (hasHeapPattern) heapMode = true;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-oa6cbsp","Type":"NodeParagraph","Properties":{"id":"20260703211211-oa6cbsp","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补充 B：函数指针破坏模式检测（funcPtrMode）"}]},{"ID":"20260703211211-dxwmpf4","Type":"NodeParagraph","Properties":{"id":"20260703211211-dxwmpf4","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"当 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":"​ 输出中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AV.Fault = Execute"},{"Type":"NodeText","Data":"​（即 DEP 违规，CPU 试图执行非代码区域的数据），且异常地址不在任何已加载模块的地址范围内时，说明函数指针/虚表被破坏。这与 heapMode 类似，都是\"内存被第三方写坏\"的表现，confidence 上限应为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"medium"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260703211211-8ii7cs1","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-8ii7cs1","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 在堆函数模式检测之后，补充函数指针破坏检测\n// 条件：AV.Fault = Execute，且异常地址不在任何已知模块范围内\nbool isFuncPtrCorrupt = false;\nif (exceptionCode?.toLowerCase() == '0xc0000005') {\n  // 从 !analyze -v 输出中提取 AV.Fault 字段\n  final avFault = _extractAvFault(analyzeVOutput); // 'Read' | 'Write' | 'Execute'\n  if (avFault == 'Execute' \u0026\u0026 exceptionModule == null) {\n    isFuncPtrCorrupt = true;\n  }\n}\nbool funcPtrMode = isFuncPtrCorrupt;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-fwjo8sw","Type":"NodeParagraph","Properties":{"id":"20260703211211-fwjo8sw","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"funcPtrMode 的含义"},{"Type":"NodeText","Data":"：函数指针/虚表被篡改，CPU 跳转到了非代码区域。这通常是第三方 Hook 软件写坏了内存（如 IP-guard 的 winimhca.dll），但由于崩溃现场已经脱离了正常代码流，栈顶可能是无意义的地址，无法直接归因到具体第三方。后续步骤中 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"funcPtrMode"},{"Type":"NodeText","Data":"​ 与 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"heapMode"},{"Type":"NodeText","Data":"​ 效果相同：confidence 上限降为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"medium"},{"Type":"NodeText","Data":"，S5 中企微自身帧也不能直接判定为企微问题。"}]},{"ID":"20260703211211-rvtkx6a","Type":"NodeParagraph","Properties":{"id":"20260703211211-rvtkx6a","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补充 C：硬件故障提前判定（S1.5）"}]},{"ID":"20260703211211-tnc6ypm","Type":"NodeParagraph","Properties":{"id":"20260703211211-tnc6ypm","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"如果 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":"​ 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"FAILURE_BUCKET_ID"},{"Type":"NodeText","Data":"​ 是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"纯硬件故障模式"},{"Type":"NodeText","Data":"，说明 WinDbg 已经明确判定是硬件故障。此时无需再走后续的第三方模块检测流程，直接返回 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hardware_issue"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260703211211-jxp71kj","Type":"NodeParagraph","Properties":{"id":"20260703211211-jxp71kj","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"判定规则"},{"Type":"NodeText","Data":"：不能简单用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"contains('hardware_')"},{"Type":"NodeText","Data":"​，因为有些混合型 Bucket（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"IN_PAGE_ERROR_c000009c_SOFTWARE_NX_FAULT_c0000006_hardware_disk!Unknown"},{"Type":"NodeText","Data":"）同时含软件和硬件标记，说明 WinDbg 自身判定也存在歧义。应使用更严格的匹配："}]},{"ID":"20260703211211-oeeztpb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-oeeztpb","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// S1 分流之后、S2 之前，优先检查硬件故障\n// 严格匹配：Bucket ID 以 hardware_ 开头，或不含任何软件故障标记\nbool isHardwareOnly = false;\nif (failureBucketId != null) {\n  final lowerBucket = failureBucketId.toLowerCase();\n  // 条件1：以 hardware_ 开头（WinDbg 明确判定为纯硬件）\n  // 条件2：含 hardware_ 但不含 SOFTWARE / APPLICATION_FAULT 等软件标记\n  final hasHardware = lowerBucket.contains('hardware_');\n  final hasSoftwareMarker = lowerBucket.contains('software') || \n      lowerBucket.contains('application_fault');\n  isHardwareOnly = hasHardware \u0026\u0026 !hasSoftwareMarker;\n}\n\nif (isHardwareOnly) {\n  return LocalAnalysisResult(\n    classification: 'hardware_issue',\n    confidence: 'high',\n    evidence: [\n      'WinDbg 自动分析判定为硬件故障',\n      'FAILURE_BUCKET_ID: $failureBucketId',\n    ],\n    userReply: '经分析，该崩溃由用户电脑硬件故障（磁盘/内存）导致，非软件问题。建议用户检查磁盘健康状态。',\n  );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-eozngr9","Type":"NodeParagraph","Properties":{"id":"20260703211211-eozngr9","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计理由"},{"Type":"NodeText","Data":"：硬件故障是最高优先级的判定——如果硬件坏了，任何软件层面的归因都没有意义。提前返回避免了后续步骤的无效计算，也让流程的优先级语义更清晰："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"硬件故障 \u0026gt; 内存破坏标记 \u0026gt; 用户帧分析"},{"Type":"NodeText","Data":"。但对于混合型 Bucket（同时含硬件和软件标记），应继续走后续流程做更精确的归因。"}]},{"ID":"20260703211211-4gv44ir","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-4gv44ir","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S2: 构建用户帧列表 + 去递归重复帧 + 定位栈顶用户帧"}]},{"ID":"20260703211211-yz8zvv8","Type":"NodeParagraph","Properties":{"id":"20260703211211-yz8zvv8","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"stackFrames[0]"},{"Type":"NodeText","Data":"​ 开始，过滤掉 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"transparent_modules.json"},{"Type":"NodeText","Data":"​ 中列出的系统模块，然后"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"去除递归重复帧"},{"Type":"NodeText","Data":"，构建完整的 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"userFrames 列表"},{"Type":"NodeText","Data":"。后续 S3-A/B 都基于这个统一列表操作，避免逻辑重复和漂移。"}]},{"ID":"20260703211211-wf345bb","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-wf345bb","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 构建用户帧列表：从原始栈帧中过滤掉透明模块，保留有意义的用户代码帧。\n/// 返回的列表保持原始顺序，每个元素仍保留原始 frameIndex（kb 输出帧号）。\nList\u003cStackFrame\u003e _buildUserFrames(List\u003cStackFrame\u003e frames, Set\u003cString\u003e transparentModules) {\n  return frames.where((frame) {\n    if (frame.moduleName == null) return false;\n    return !transparentModules.contains(frame.moduleName!.toLowerCase());\n  }).toList();\n}\n\n/// 去递归重复帧：同一 module!function 只保留首次出现，避免递归栈干扰位置判断。\n/// 保留原始 frameIndex 不变。\nList\u003cStackFrame\u003e _deduplicateRecursiveFrames(List\u003cStackFrame\u003e frames) {\n  final seen = \u003cString\u003e{};\n  return frames.where((f) {\n    final key = '${f.moduleName?.toLowerCase() ?? \"\"}!${f.functionName?.toLowerCase() ?? \"\"}';\n    if (seen.contains(key)) return false;\n    seen.add(key);\n    return true;\n  }).toList();\n}\n\n// 使用：\nfinal rawUserFrames = _buildUserFrames(stackFrames, transparentModules);\nfinal userFrames = _deduplicateRecursiveFrames(rawUserFrames);\nfinal topUserFrame = userFrames.isNotEmpty ? userFrames.first : null;\n\nif (topUserFrame == null) {\n  // 所有帧都是系统/透明模块，无法归因\n  return LocalAnalysisResult(\n    classification: 'unable_to_analyze',\n    confidence: 'low',\n    evidence: ['调用栈中所有帧均为系统透明模块，无法定位用户代码'],\n  );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-xgrn6c9","Type":"NodeParagraph","Properties":{"id":"20260703211211-xgrn6c9","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键设计"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-ko2y887","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-ko2y887","updated":"20260703211211"},"Children":[{"ID":"20260703211211-ip162wx","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-ip162wx","updated":"20260703211211"},"Children":[{"ID":"20260703211211-kgy41ii","Type":"NodeParagraph","Properties":{"id":"20260703211211-kgy41ii","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"userFrames"},{"Type":"NodeText","Data":"​ 中每个元素的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"frameIndex"},{"Type":"NodeText","Data":"​ 字段保留的是原始 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":" 输出中的帧序号（如 0、2、5、9...），而非过滤后的相对序号。这确保了后续 evidence 记录时用户能直接对应 CDB 输出。"}]}]},{"ID":"20260703211211-64plwvb","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-64plwvb","updated":"20260703211211"},"Children":[{"ID":"20260703211211-63ufvm0","Type":"NodeParagraph","Properties":{"id":"20260703211211-63ufvm0","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"去递归重复帧"},{"Type":"NodeText","Data":"：循环递归场景下，同一函数可能连续出现数十次，如果不去重，前 20 帧全部是重复函数，统计位置完全失效。去重后保留首次出现即可反映调用链路。"}]}]}]},{"ID":"20260703211211-s3pu214","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-s3pu214","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S3: 三步归因"}]},{"ID":"20260703211211-egth8pz","Type":"NodeParagraph","Properties":{"id":"20260703211211-egth8pz","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Step A"},{"Type":"NodeText","Data":"：栈顶用户帧的模块 ∈ 第三方名册？（排除企微模块）"}]},{"ID":"20260703211211-w5f3j5h","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-w5f3j5h","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 在 third_party_dlls.json 的所有 vendors[].modules[] 中查找\n// 匹配规则：不区分大小写，支持前缀匹配\n// 关键：先排除企微模块，防止企微模块名与第三方名册意外重名导致误判\nif (_isWxWorkModule(topUserFrame.moduleName)) {\n  // 跳过 Step A，进入 Step B（企微模块不可能是第三方）\n} else {\n  ThirdPartyVendor? vendor = _matchThirdParty(topUserFrame.moduleName);\n  if (vendor != null) {\n    return LocalAnalysisResult(\n      classification: 'third_party_hit',\n      confidence: (heapMode || funcPtrMode) ? 'medium' : 'high',\n      vendor: vendor,\n      evidence: ['栈顶用户帧 ${topUserFrame.fullSymbol} 命中第三方模块 ${vendor.name}'],\n    );\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-n0llxf4","Type":"NodeParagraph","Properties":{"id":"20260703211211-n0llxf4","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Step B"},{"Type":"NodeText","Data":"：扫描去重后的前 20 个用户帧，是否有第三方模块？"}]},{"ID":"20260703211211-pzrfgcj","Type":"NodeBlockquote","Properties":{"id":"20260703211211-pzrfgcj","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-1uj47ye","Type":"NodeParagraph","Properties":{"id":"20260703211211-1uj47ye","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"注意：这里遍历的是 S2 构建的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"userFrames"},{"Type":"NodeText","Data":"​ 列表（已跳过透明模块、已去递归重复帧），但 evidence 中记录的帧号使用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"frame.frameIndex"},{"Type":"NodeText","Data":"（原始 kb 输出帧号），确保用户能直接对应 CDB 输出。"}]},{"ID":"20260703211211-49agydq","Type":"NodeParagraph","Properties":{"id":"20260703211211-49agydq","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"扫描范围设计"},{"Type":"NodeText","Data":"：去重后前 20 帧（而非原始帧的前 15 帧）。去重后的相对位置更能反映\"第三方离崩溃点的真实距离\"，避免递归栈干扰。"}]}]},{"ID":"20260703211211-g2d11nr","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-g2d11nr","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 从 userFrames[1] 开始（[0] 已在 Step A 判过）\n// 扫描范围：去重后的前 20 帧\nfinal scanLimit = min(20, userFrames.length);\nfor (int i = 1; i \u003c scanLimit; i++) {\n  // 排除企微模块，防止误判\n  if (_isWxWorkModule(userFrames[i].moduleName)) continue;\n  \n  ThirdPartyVendor? vendor = _matchThirdParty(userFrames[i].moduleName);\n  if (vendor != null) {\n    // 置信度用 userFrames 的相对位置 i 判断（而非原始帧号）\n    // 理由：原始帧号受透明模块数量影响，相对位置更能反映\"第三方离崩溃点的距离\"\n    // userFrames[1..4] = high，userFrames[5..14] = medium，userFrames[15..19] = low（扩展区间）\n    String confidence;\n    if (i \u003c 5) {\n      confidence = 'high';\n    } else if (i \u003c 15) {\n      confidence = 'medium';\n    } else {\n      confidence = 'low'; // 扩展区间：越靠后置信度越低\n    }\n    // 内存破坏场景：high 降为 medium，medium/low 不变\n    if ((heapMode || funcPtrMode) \u0026\u0026 confidence == 'high') {\n      confidence = 'medium';\n    }\n    \n    // evidence 中仍用原始帧号，方便用户对照 CDB 输出\n    final originalFrameIdx = userFrames[i].frameIndex;\n    return LocalAnalysisResult(\n      classification: 'third_party_hit',\n      confidence: confidence,\n      vendor: vendor,\n      evidence: ['调用栈第 ${originalFrameIdx} 帧(原始kb帧号) / userFrames[$i] ${userFrames[i].fullSymbol} 命中第三方模块 ${vendor.name}'],\n    );\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-j0d1pxa","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-j0d1pxa","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S4: 场景关联检测"}]},{"ID":"20260703211211-ywyow9i","Type":"NodeParagraph","Properties":{"id":"20260703211211-ywyow9i","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"这是本方案的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心创新点"},{"Type":"NodeText","Data":"，解决\"崩在系统 DLL 但实际是第三方导致\"的 case。"}]},{"ID":"20260703211211-fyxhsfa","Type":"NodeParagraph","Properties":{"id":"20260703211211-fyxhsfa","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计原则"},{"Type":"NodeText","Data":"：场景关联的规则参数（关键词列表、异常码、关联 category）全部从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"scene_associations.json"},{"Type":"NodeText","Data":" 配置文件加载，代码只实现通用匹配逻辑，不硬编码任何具体规则。这样新增场景只需改配置文件，无需改代码。"}]},{"ID":"20260703211211-jzbebfk","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-jzbebfk","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 从 scene_associations.json 加载场景规则，逐个匹配。\n/// 每个场景规则包含: stack_keywords(可选)、exception_codes(可选)、related_categories。\n/// 匹配逻辑: (栈关键词命中 OR 异常码命中) AND 环境中加载了 related_categories 类型的第三方模块。\nfor (final scene in sceneRules) {\n  bool contextMatch = false;\n  String? matchedEvidence;\n\n  // 条件1a: 调用栈关键词匹配（如果该场景定义了 stack_keywords）\n  if (scene.stackKeywords != null \u0026\u0026 scene.stackKeywords!.isNotEmpty) {\n    for (final frame in stackFrames) {\n      final matchedKw = scene.stackKeywords!.firstWhere(\n        (kw) =\u003e frame.fullSymbol?.contains(kw) ?? false,\n        orElse: () =\u003e '',\n      );\n      if (matchedKw.isNotEmpty) {\n        contextMatch = true;\n        matchedEvidence = '栈中含关键词 \"$matchedKw\" (帧 ${frame.frameIndex})';\n        break;\n      }\n    }\n  }\n\n  // 条件1b: 异常码匹配（如果该场景定义了 exception_codes）\n  if (!contextMatch \u0026\u0026 scene.exceptionCodes != null) {\n    if (scene.exceptionCodes!.contains(exceptionCode?.toLowerCase())) {\n      contextMatch = true;\n      matchedEvidence = '异常码 $exceptionCode 命中场景 ${scene.id}';\n    }\n  }\n\n  if (!contextMatch) continue;\n\n  // 条件2: 环境中加载了该场景关联类型的第三方模块\n  List\u003cThirdPartyVendor\u003e relatedVendors = loadedModules\n    .map((m) =\u003e _matchThirdParty(m.name))\n    .whereNotNull()\n    .where((v) =\u003e scene.relatedCategories.contains(v.category))\n    .toList();\n\n  if (relatedVendors.isNotEmpty) {\n    return LocalAnalysisResult(\n      classification: 'third_party_hit',\n      confidence: scene.confidence,\n      vendor: relatedVendors.first,\n      scene: scene.id,\n      evidence: [\n        matchedEvidence!,\n        '进程中加载了 ${scene.name} 相关模块: ${relatedVendors.map((v) =\u003e v.name).join(\", \")}',\n      ],\n    );\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-cyg8kqf","Type":"NodeParagraph","Properties":{"id":"20260703211211-cyg8kqf","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"模式 C：未知/第三方模块多次穿插检测"}]},{"ID":"20260703211211-i50vxn1","Type":"NodeParagraph","Properties":{"id":"20260703211211-i50vxn1","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"当栈中同一个「非企微、非系统」的模块在 userFrames 中出现 ≥3 次，推断该模块在 Hook 企微消息链路。这是对无符号 Hook 软件（如 winimhca）的启发式检测。此逻辑不依赖配置文件，是代码内置的兜底启发式规则。"}]},{"ID":"20260703211211-d35nc4l","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-d35nc4l","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 统计 userFrames 中每个模块的出现次数（排除企微模块）\n// 注意：这里不排除已知第三方，因为 S3-B 只扫描去重后前20帧，\n// 如果已知第三方出现在 userFrames[15+] 位置，S3-B 会漏掉，此处兜底捕获\nMap\u003cString, int\u003e nonWecomModuleCount = {};\nfor (final frame in userFrames.take(20)) {\n  if (frame.moduleName == null) continue;\n  if (_isWxWorkModule(frame.moduleName)) continue;\n  nonWecomModuleCount[frame.moduleName!] = \n      (nonWecomModuleCount[frame.moduleName!] ?? 0) + 1;\n}\n\n// 如果某个非企微模块出现 \u003e=3 次，进一步判断\nfinal suspiciousModules = nonWecomModuleCount.entries\n    .where((e) =\u003e e.value \u003e= 3)\n    .toList();\nif (suspiciousModules.isNotEmpty) {\n  final topSuspect = suspiciousModules.first;\n  // 先检查是否为已知第三方（S3-B 前20帧之外的漏网之鱼）\n  final vendor = _matchThirdParty(topSuspect.key);\n  if (vendor != null) {\n    return LocalAnalysisResult(\n      classification: 'third_party_hit',\n      confidence: 'medium',\n      vendor: vendor,\n      scene: 'hook_interleave',\n      evidence: [\n        '第三方模块 ${topSuspect.key} 在调用栈中出现 ${topSuspect.value} 次（超出 S3-B 扫描范围）',\n        '命中第三方厂商: ${vendor.name}',\n      ],\n    );\n  }\n  // 未知模块，低置信度提示\n  return LocalAnalysisResult(\n    classification: 'third_party_hit',\n    confidence: 'low',\n    scene: 'hook_interleave',\n    evidence: [\n      '未知模块 ${topSuspect.key} 在调用栈中出现 ${topSuspect.value} 次，疑似 Hook 注入',\n      '建议人工确认该模块归属，或使用 lmvm ${topSuspect.key} 查看详情',\n    ],\n  );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-jgktaga","Type":"NodeBlockquote","Properties":{"id":"20260703211211-jgktaga","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-wsliqfo","Type":"NodeParagraph","Properties":{"id":"20260703211211-wsliqfo","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"注意"},{"Type":"NodeText","Data":"：模式 C 中 confidence=low（未知模块）或 medium（已知第三方），仅作为兜底输出。如果未知模块后续被确认为第三方，应将其加入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_dlls.json"},{"Type":"NodeText","Data":" 名册。"}]}]},{"ID":"20260703211211-4j33vva","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-4j33vva","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S5: 企微自身判定"}]},{"ID":"20260703211211-1bd6zui","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-1bd6zui","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 栈顶用户帧 ∈ wxwork_dlls.json\nif (_isWxWorkModule(topUserFrame.moduleName)) {\n  // 关键：heapMode 或 funcPtrMode 下不能直接判定为企微自身问题\n  // 因为内存破坏场景中，栈顶企微帧可能只是\"受害者\"而非\"肇事者\"\n  if (heapMode || funcPtrMode) {\n    return LocalAnalysisResult(\n      classification: 'unable_to_analyze',\n      confidence: 'low',\n      evidence: [\n        '栈顶用户帧 ${topUserFrame.fullSymbol} 属于企微自身模块',\n        '但检测到内存破坏模式(${heapMode ? \"heapMode\" : \"funcPtrMode\"})，栈顶帧可能只是受害者而非根因',\n        '建议人工分析或使用 CLI 深度分析',\n      ],\n      loadedThirdPartyModules: _findAllLoadedThirdParty(loadedModules),\n    );\n  }\n  \n  return LocalAnalysisResult(\n    classification: 'third_party_not_hit',\n    confidence: 'high',\n    evidence: ['栈顶用户帧 ${topUserFrame.fullSymbol} 属于企微自身模块'],\n    // 附加: 列出环境中的第三方模块供参考\n    loadedThirdPartyModules: _findAllLoadedThirdParty(loadedModules),\n  );\n}\n\n// R8 兜底：栈顶用户帧既不是第三方也不是企微\nreturn LocalAnalysisResult(\n  classification: 'unable_to_analyze',\n  confidence: 'low',\n  evidence: [\n    '调用栈中未命中已知第三方或企微模块',\n    '栈顶用户帧: ${topUserFrame.fullSymbol ?? \"无符号\"}',\n    '异常码: $exceptionCode',\n    '异常地址: ${exceptionAddress ?? \"未知\"}',\n    '异常模块: ${exceptionModule ?? \"不在任何已知模块范围内\"}',\n  ],\n  loadedThirdPartyModules: _findAllLoadedThirdParty(loadedModules),\n  // 新增：列出栈中所有未识别模块（非企微、非系统、非已知第三方）\n  unknownModulesInStack: _findUnknownModules(userFrames, loadedModules),\n);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-om51uzc","Type":"NodeParagraph","Properties":{"id":"20260703211211-om51uzc","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"_findUnknownModules"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeText","Data":"​ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"辅助方法"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-8pesa7d","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-8pesa7d","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 找出调用栈中所有\"未识别\"的模块：既不在企微名册、也不在第三方名册、也不在透明模块列表中。\n/// 这些模块是人工排查的重点线索。\nList\u003cUnknownModuleInfo\u003e _findUnknownModules(\n  List\u003cStackFrame\u003e userFrames,\n  List\u003cLoadedModule\u003e loadedModules,\n) {\n  final seen = \u003cString\u003e{};\n  final result = \u003cUnknownModuleInfo\u003e[];\n  \n  for (final frame in userFrames) {\n    if (frame.moduleName == null) continue;\n    final name = frame.moduleName!.toLowerCase();\n    if (seen.contains(name)) continue;\n    seen.add(name);\n    \n    // 排除已知模块\n    if (_isWxWorkModule(frame.moduleName)) continue;\n    if (_matchThirdParty(frame.moduleName) != null) continue;\n    \n    // 从 loadedModules 中找到该模块的详细信息\n    final moduleInfo = loadedModules.firstWhere(\n      (m) =\u003e m.name.toLowerCase() == name,\n      orElse: () =\u003e LoadedModule(name: frame.moduleName!),\n    );\n    \n    result.add(UnknownModuleInfo(\n      moduleName: frame.moduleName!,\n      path: moduleInfo.path,\n      startAddress: moduleInfo.startAddress,\n      endAddress: moduleInfo.endAddress,\n      appearsInFrames: userFrames\n          .where((f) =\u003e f.moduleName?.toLowerCase() == name)\n          .map((f) =\u003e f.frameIndex)\n          .toList(),\n    ));\n  }\n  return result;\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-lwimcah","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-lwimcah","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"S-Final: 全局置信度钳位"}]},{"ID":"20260703211211-n3ptt4q","Type":"NodeParagraph","Properties":{"id":"20260703211211-n3ptt4q","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"在规则引擎 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"analyze()"},{"Type":"NodeText","Data":"​ 方法最终返回结果前，统一执行置信度钳位。这是一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"全局安全网"},{"Type":"NodeText","Data":"，确保无论哪个分支输出了 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"high"},{"Type":"NodeText","Data":"，在内存破坏场景下都会被降级。"}]},{"ID":"20260703211211-p1ip9a7","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-p1ip9a7","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 全局置信度钳位：heapMode/funcPtrMode 下禁止输出 high 置信度。\n/// 在 analyze() 方法返回前调用。\nLocalAnalysisResult _applyConfidenceClamp(LocalAnalysisResult result) {\n  if (!(heapMode || funcPtrMode)) return result;\n  if (result.confidence != 'high') return result;\n  // hardware_issue 不受钳位影响（硬件故障判定不依赖内存完整性）\n  if (result.classification == 'hardware_issue') return result;\n  \n  return result.copyWith(\n    confidence: 'medium',\n    evidenceList: [\n      ...result.evidenceList,\n      '⚠️ 检测到内存破坏模式(${heapMode ? \"heapMode\" : \"funcPtrMode\"})，置信度已从 high 降为 medium，建议人工复核',\n    ],\n  );\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-98e2uw7","Type":"NodeBlockquote","Properties":{"id":"20260703211211-98e2uw7","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-saurmzb","Type":"NodeParagraph","Properties":{"id":"20260703211211-saurmzb","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"设计理由"},{"Type":"NodeText","Data":"：虽然 S3-A/B 中已经有 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"if (heapMode) confidence = 'medium'"},{"Type":"NodeText","Data":" 的逻辑，但 S-Final 作为全局安全网可以防止未来新增分支时遗漏此约束。两者不冲突：分支内的降级是\"主动降级\"，S-Final 是\"兜底防漏\"。"}]}]},{"ID":"20260703211211-ndua9tc","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-ndua9tc","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.4 模块匹配算法"}]},{"ID":"20260703211211-arqcawq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-arqcawq","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 在第三方名册中查找匹配的厂商。\n/// 匹配规则：\n///   1. 不区分大小写\n///   2. 支持前缀匹配（如 \"SogouPY\" 匹配 \"SogouPY.dll\" 和 \"SogouPY64.dll\"）\n///   3. 优先精确匹配，其次前缀匹配\nThirdPartyVendor? _matchThirdParty(String? moduleName) {\n  if (moduleName == null || moduleName.isEmpty) return null;\n  final lower = moduleName.toLowerCase();\n  \n  // 精确匹配\n  for (final vendor in thirdPartyVendors) {\n    for (final mod in vendor.modules) {\n      if (mod.toLowerCase() == lower) return vendor;\n    }\n  }\n  \n  // 前缀匹配\n  for (final vendor in thirdPartyVendors) {\n    for (final mod in vendor.modules) {\n      if (lower.startsWith(mod.toLowerCase())) return vendor;\n    }\n  }\n  \n  return null;\n}\n\n/// 在企微名册中查找。\nbool _isWxWorkModule(String? moduleName) {\n  if (moduleName == null || moduleName.isEmpty) return false;\n  final lower = moduleName.toLowerCase();\n  return wxWorkModuleNames.contains(lower);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-ie6kinc","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-ie6kinc","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"5.5 结果数据模型"}]},{"ID":"20260703211211-bkwtnqy","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-bkwtnqy","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 本地规则引擎归因结果。\nclass LocalAnalysisResult {\n  /// 分类结论。\n  /// 取值: third_party_hit | third_party_not_hit | hardware_issue | unable_to_analyze\n  final String classification;\n  \n  /// 置信度。\n  /// 取值: high | medium | low\n  final String confidence;\n  \n  /// 命中的第三方厂商信息（仅 classification=third_party_hit 时非空）。\n  final ThirdPartyVendor? vendor;\n  \n  /// 触发的场景关联类型（仅场景关联命中时非空）。\n  /// 取值: text_input | io_error | hook_crash | null\n  final String? scene;\n  \n  /// 证据链列表（每条证据是一句人可读的描述）。\n  final List\u003cString\u003e evidenceList;\n  \n  /// 客服回复话术（命中第三方时从 vendor.reply_template 取）。\n  final String? userReplyTemplate;\n  \n  /// 环境中加载的第三方模块列表（无论是否命中，都列出供参考）。\n  final List\u003cLoadedThirdPartyInfo\u003e loadedThirdPartyModules;\n  \n  /// 调用栈中未识别的模块列表（仅 unable_to_analyze 时填充，供人工排查）。\n  final List\u003cUnknownModuleInfo\u003e unknownModulesInStack;\n  \n  /// 异常摘要（供提单使用）。\n  final String? exceptionSummary;\n  \n  /// 分析耗时（毫秒）。\n  final int elapsedMs;\n}\n\n/// 环境中加载的第三方模块信息。\nclass LoadedThirdPartyInfo {\n  final String moduleName;\n  final String vendorName;\n  final String category;\n  final String? modulePath;\n}\n\n/// 调用栈中未识别的模块信息（非企微、非系统、非已知第三方）。\n/// 这些模块是人工排查的重点线索。\nclass UnknownModuleInfo {\n  final String moduleName;         // 模块名\n  final String? path;              // 模块路径（如有）\n  final String? startAddress;      // 加载起始地址\n  final String? endAddress;        // 加载结束地址\n  final List\u003cint\u003e appearsInFrames; // 出现在哪些帧号中\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-m5lj9oo","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-m5lj9oo","updated":"20260703211211"}},{"ID":"20260703211211-p8g51q6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-p8g51q6","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"6. 配置文件设计"}]},{"ID":"20260703211211-dq8zjbi","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-dq8zjbi","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"6.1 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"transparent_modules.json"},{"Type":"NodeText","Data":"（新增）"}]},{"ID":"20260703211211-v5xxb1t","Type":"NodeParagraph","Properties":{"id":"20260703211211-v5xxb1t","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"系统透明模块列表——这些模块出现在栈顶时应该被跳过，往下找第一个\"有意义的用户代码帧\"。"}]},{"ID":"20260703211211-4878b2a","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"anNvbg==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-4878b2a","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"anNvbg=="},{"Type":"NodeCodeBlockCode","Data":"{\n  \"description\": \"系统透明模块列表：出现在栈顶时跳过，定位真正的用户代码帧\",\n  \"version\": \"1.0.0\",\n  \"last_updated\": \"2026-07-03\",\n  \"rationale\": \"这些模块是 Windows 系统核心组件或 CRT 运行时，崩在这些模块里通常是被调用方传了错误参数导致，真正的肇事者在栈的下一层。【重要边界】：此列表只应包含 Microsoft 官方签名的系统 DLL，绝不可将第三方模块（即使名字类似系统DLL，如 winimhca）加入此列表，否则会导致 S2 跳过真正的肇事者。\",\n  \"modules\": [\n    \"ntdll\",\n    \"kernel32\",\n    \"kernelbase\",\n    \"advapi32\",\n    \"user32\",\n    \"gdi32\",\n    \"win32u\",\n    \"gdi32full\",\n    \"shell32\",\n    \"ole32\",\n    \"oleaut32\",\n    \"combase\",\n    \"rpcrt4\",\n    \"msvcrt\",\n    \"ucrtbase\",\n    \"vcruntime140\",\n    \"vcruntime140_1\",\n    \"vcruntime140d\",\n    \"msvcp140\",\n    \"msvcp140_1\",\n    \"concrt140\",\n    \"sechost\",\n    \"crypt32\",\n    \"bcrypt\",\n    \"sspicli\",\n    \"ws2_32\",\n    \"mswsock\",\n    \"dnsapi\",\n    \"clbcatq\",\n    \"cfgmgr32\",\n    \"setupapi\",\n    \"imm32\",\n    \"msctf\",\n    \"shcore\",\n    \"shlwapi\",\n    \"uxtheme\",\n    \"dwmapi\",\n    \"d3d11\",\n    \"dxgi\",\n    \"dbghelp\",\n    \"dbgcore\",\n    \"msftedit\",\n    \"riched20\",\n    \"riched32\"\n  ]\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-jr7bnkn","Type":"NodeBlockquote","Properties":{"id":"20260703211211-jr7bnkn","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-jdmvsdb","Type":"NodeParagraph","Properties":{"id":"20260703211211-jdmvsdb","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"说明"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"msftedit"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"riched20"},{"Type":"NodeText","Data":"​、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"riched32"},{"Type":"NodeText","Data":"​ 是 Windows 系统自带的 RichEdit 文本控件。在输入法相关崩溃中，这些模块经常作为\"无辜中间层\"出现在调用栈中（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"msftedit!CTxtBreaker::SetBreaks"},{"Type":"NodeText","Data":"），将它们标记为透明模块可以让 S2 正确跳过，更准确地定位到真正的输入法模块或企微模块。"}]}]},{"ID":"20260703211211-4fm58ik","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-4fm58ik","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"6.2 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"scene_associations.json"},{"Type":"NodeText","Data":"（新增）"}]},{"ID":"20260703211211-14bz7jj","Type":"NodeParagraph","Properties":{"id":"20260703211211-14bz7jj","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"场景关联规则配置——定义\"什么样的调用栈模式 + 什么类型的第三方模块 = 场景关联命中\"。"}]},{"ID":"20260703211211-45xrjur","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"anNvbg==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-45xrjur","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"anNvbg=="},{"Type":"NodeCodeBlockCode","Data":"{\n  \"description\": \"场景关联规则：当崩溃模块不直接是第三方，但崩溃场景与特定类型第三方软件强相关时，通过场景关联判定\",\n  \"version\": \"1.0.0\",\n  \"last_updated\": \"2026-07-03\",\n  \"scenes\": [\n    {\n      \"id\": \"text_input\",\n      \"name\": \"文本输入/断词/自动纠正场景\",\n      \"description\": \"用户正在输入文字时，输入法参与了文本处理链路导致崩溃\",\n      \"stack_keywords\": [\n        \"WordBreak\", \"TxWordBreakProc\", \"AutoCorrect\", \"PutChar\",\n        \"OnTxChar\", \"GetTokens\", \"SelectableWord\", \"TextBreaker\",\n        \"ImmGetCompositionString\", \"ImmSetCompositionString\",\n        \"TextInput\", \"RichEdit\", \"CTxtEdit\", \"CTxtBreaker\",\n        \"CRichEditUI\", \"TxSendMessage\", \"FindWordBreak\",\n        \"Windows_Globalization\"\n      ],\n      \"related_categories\": [\"input_method\"],\n      \"confidence\": \"medium\",\n      \"reply_suffix\": \"该崩溃发生在文本输入过程中，与输入法处理相关。\"\n    },\n    {\n      \"id\": \"io_error\",\n      \"name\": \"内存页 I/O 错误场景\",\n      \"description\": \"磁盘 I/O 错误导致内存页无法加载，可能与磁盘加密/DLP 软件相关\",\n      \"exception_codes\": [\"0xc0000006\", \"0xc000009c\", \"0xc000009d\"],\n      \"related_categories\": [\"dlp\", \"disk_encryption\", \"antivirus\"],\n      \"confidence\": \"medium\",\n      \"reply_suffix\": \"该崩溃与磁盘 I/O 错误相关，可能受到磁盘加密或安全软件影响。\"\n    },\n    {\n      \"id\": \"hook_crash\",\n      \"name\": \"Hook 注入导致的崩溃\",\n      \"description\": \"第三方软件通过 Hook 注入企微进程导致崩溃\",\n      \"stack_keywords\": [\n        \"Hook\", \"Detour\", \"Intercept\", \"Trampoline\",\n        \"DispatchHookA\", \"DispatchHookW\", \"CallNextHookEx\",\n        \"SetWindowsHookEx\", \"UnhookWindowsHookEx\"\n      ],\n      \"related_categories\": [\"antivirus\", \"dlp\", \"monitoring\"],\n      \"confidence\": \"medium\",\n      \"reply_suffix\": \"该崩溃可能由第三方软件的 Hook 注入导致。\"\n    }\n  ]\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-3kzxaqm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-3kzxaqm","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"6.3 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_dlls.json"},{"Type":"NodeText","Data":" 扩展"}]},{"ID":"20260703211211-e0jaxq4","Type":"NodeParagraph","Properties":{"id":"20260703211211-e0jaxq4","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"在现有结构基础上，为每个厂商增加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"category"},{"Type":"NodeText","Data":" 字段："}]},{"ID":"20260703211211-t1pnigz","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"anNvbg==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-t1pnigz","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"anNvbg=="},{"Type":"NodeCodeBlockCode","Data":"{\n  \"vendor\": \"百度输入法\",\n  \"company\": \"北京百度网讯科技有限公司\",\n  \"category\": \"input_method\",\n  \"modules\": [\"baiducnTSF\", \"BaiduPinyinIme\", \"BaiduPY\", \"BaiduTSF\", \"BDInput\", \"UIPFull\", \"imefreetype\", \"imezlib\", \"imepng\", \"IMEResourceMgr\"],\n  \"keywords\": [\"baidu\", \"百度输入法\"],\n  \"reply_template\": \"经核实，该问题可能与您安装的百度输入法存在冲突导致。建议先退出或卸载百度输入法（也可尝试更新至最新版本），然后重启企业微信后重试。\"\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-z7tyiuo","Type":"NodeParagraph","Properties":{"id":"20260703211211-z7tyiuo","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"category 取值规范"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-48rizu5","Type":"NodeTable","Data":"|category|含义|典型厂商|\n| ----------| ----------------| ------------------------------------|\n|`input_method`|输入法|搜狗、百度、QQ输入法|\n|`dlp`|数据防泄漏|IP-guard、铁盒、亿赛通|\n|`antivirus`|杀毒/终端安全|360、火绒、卡巴斯基、McAfee|\n|`edr`|终端检测与响应|奇安信天擎、深信服EDR、CrowdStrike|\n|`disk_encryption`|磁盘加密|BitLocker 第三方扩展|\n|`monitoring`|终端监控/准入|联软UniAccess、绿盟|\n|`cloud_security`|云安全/零信任|Zscaler|\n|`system_component`|系统组件相关|Windows.Globalization|","TableAligns":[0,0,0],"Properties":{"id":"20260703211211-48rizu5","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"category"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"含义"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"典型厂商"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"input_method"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"输入法"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"搜狗、百度、QQ输入法"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dlp"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"数据防泄漏"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"IP-guard、铁盒、亿赛通"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"antivirus"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"杀毒/终端安全"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"360、火绒、卡巴斯基、McAfee"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"edr"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"终端检测与响应"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"奇安信天擎、深信服EDR、CrowdStrike"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"disk_encryption"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"磁盘加密"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"BitLocker 第三方扩展"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"monitoring"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"终端监控/准入"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"联软UniAccess、绿盟"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cloud_security"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"云安全/零信任"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Zscaler"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"system_component"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"系统组件相关"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Windows.Globalization"}]}]}]},{"ID":"20260703211211-v5dfdgk","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-v5dfdgk","updated":"20260703211211"}},{"ID":"20260703211211-7j6mic8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-7j6mic8","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"7. Manager 层集成"}]},{"ID":"20260703211211-rxxamdz","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-rxxamdz","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"7.1 新增入口方法"}]},{"ID":"20260703211211-nx0e96w","Type":"NodeParagraph","Properties":{"id":"20260703211211-nx0e96w","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CrashAnalysisManager"},{"Type":"NodeText","Data":" 中新增："}]},{"ID":"20260703211211-in2za6k","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-in2za6k","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 纯本地 MCP 分析入口：复用 B2 预筛结果。\n/// 直接复用预筛阶段的 sessionId 和 dumpSha1，跳过上传和建会话步骤。\n///\n/// 流程: 深度采证(复用 sessionId) → 规则引擎归因 → closeSession\n///\n/// [prefilteredList] 来自 B2 阶段的 CrashDumpPrefilterResult.selectedCrashDumpList。\n/// 不会抛异常: 任何子步骤失败都通过 status=failed + errorMsg 反馈。\nFuture\u003cvoid\u003e startLocalAnalyze(\n  List\u003cPrefilteredCrashDump\u003e prefilteredList,\n) async {\n  if (prefilteredList.isEmpty) return;\n  if (_status == CrashAnalysisStatus.analyzing) return;\n  \n  final AppConfig? cfg = await _ensureAppConfigOrFail();\n  if (cfg == null) return;\n  \n  _enterAnalyzing('正在进行本地深度分析...');\n  await _runLocalAnalyze(prefilteredList, cfg);\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-3vi0v5h","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-3vi0v5h","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"7.2 状态扩展"}]},{"ID":"20260703211211-phji4rg","Type":"NodeParagraph","Properties":{"id":"20260703211211-phji4rg","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"新增本地分析结果字段："}]},{"ID":"20260703211211-s5nf5z4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-s5nf5z4","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"// 本地深度分析结果（与 _deepResult 独立）。\nLocalAnalysisResult? _localResult;\n\nLocalAnalysisResult? get localResult =\u003e _localResult;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-rphwcf7","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-rphwcf7","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"7.3 内部编排流程"}]},{"ID":"20260703211211-gxoe12s","Type":"NodeBlockquote","Properties":{"id":"20260703211211-gxoe12s","updated":"20260703211211"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260703211211-1f5v36i","Type":"NodeParagraph","Properties":{"id":"20260703211211-1f5v36i","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"复用 B2 预筛阶段的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sessionId"},{"Type":"NodeText","Data":"，跳过上传和建会话步骤，节省 5-10s。"}]}]},{"ID":"20260703211211-rgb8j0b","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-rgb8j0b","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"Future\u003cvoid\u003e _runLocalAnalyze(\n  List\u003cPrefilteredCrashDump\u003e prefilteredList,\n  AppConfig config,\n) async {\n  try {\n    final bridge = CrashMcpBridge.fromConfig(config);\n    \n    // 1. 取第一个候选（首版只分析第一个）\n    final PrefilteredCrashDump candidate = prefilteredList.first;\n    final String sessionId = candidate.sessionId;\n    final String dumpSha1 = candidate.dumpSha1;\n    final String dumpPath = candidate.dumpFilePath;\n    \n    try {\n      // 2. 深度采证（直接复用 sessionId，无需上传和建会话）\n      _progressText = '正在执行深度分析命令...';\n      _safeNotify();\n      final analyzer = CrashLocalDeepAnalyzer(bridge: bridge);\n      final collectionResult = await analyzer.runDeepCollection(\n        sessionId: sessionId,\n        dumpSha1: dumpSha1,\n        dumpFilePath: dumpPath,\n        // 传入 quickTriageRaw 供 S0/S1 快速消费，避免重复调用 exception_info preset\n        quickTriageHint: candidate.quickTriageRaw,\n      );\n      \n      // 3. 规则引擎归因\n      _progressText = '正在进行规则引擎归因...';\n      _safeNotify();\n      final engine = CrashLocalRuleEngine.fromConfig();\n      final result = engine.analyze(collectionResult);\n      \n      // 4. 完成\n      _localResult = result;\n      _status = CrashAnalysisStatus.done;\n      _progressText = '';\n      _safeNotify();\n    } finally {\n      // 5. 无论成功失败都关闭会话（预筛阶段保留的会话在此关闭）\n      await bridge.closeSession(sessionId: sessionId);\n    }\n  } catch (e) {\n    if (_isDisposed) return;\n    _enterFailed('本地分析失败: $e');\n  }\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-m98nrst","Type":"NodeParagraph","Properties":{"id":"20260703211211-m98nrst","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键设计说明"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-iwdzxsc","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-iwdzxsc","updated":"20260703211211"},"Children":[{"ID":"20260703211211-mby1jno","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-mby1jno","updated":"20260703211211"},"Children":[{"ID":"20260703211211-nk0gn2u","Type":"NodeParagraph","Properties":{"id":"20260703211211-nk0gn2u","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"candidate.quickTriageRaw"},{"Type":"NodeText","Data":"​ 作为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"quickTriageHint"},{"Type":"NodeText","Data":"​ 传入深度采证器，其中的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"exception_code"},{"Type":"NodeText","Data":"​ 可被 S0/S1 直接消费，无需等待 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"exception_info"},{"Type":"NodeText","Data":" preset 返回"}]}]},{"ID":"20260703211211-d2gm2hn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-d2gm2hn","updated":"20260703211211"},"Children":[{"ID":"20260703211211-f54a5lt","Type":"NodeParagraph","Properties":{"id":"20260703211211-f54a5lt","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"预筛阶段保留的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sessionId"},{"Type":"NodeText","Data":"​ 在本方法的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"finally"},{"Type":"NodeText","Data":" 块中关闭，确保资源释放"}]}]},{"ID":"20260703211211-oocrs8k","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-oocrs8k","updated":"20260703211211"},"Children":[{"ID":"20260703211211-hlls5w2","Type":"NodeParagraph","Properties":{"id":"20260703211211-hlls5w2","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"如果预筛阶段的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"sessionId"},{"Type":"NodeText","Data":"​ 已过期（MCP 服务端超时回收），"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"execDeepCommands"},{"Type":"NodeText","Data":" 会抛出异常，此时 catch 块会标记失败"}]}]}]},{"ID":"20260703211211-nrr4hfy","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-nrr4hfy","updated":"20260703211211"}},{"ID":"20260703211211-oldqhq4","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-oldqhq4","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"8. UI 层改动"}]},{"ID":"20260703211211-l27wn88","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-l27wn88","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8.1 新增按钮"}]},{"ID":"20260703211211-5x86sa1","Type":"NodeParagraph","Properties":{"id":"20260703211211-5x86sa1","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"crash_analysis_window.dart"},{"Type":"NodeText","Data":" 的操作区域，现有\"分析\"按钮旁新增："}]},{"ID":"20260703211211-n6c7xmx","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-n6c7xmx","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"ElevatedButton.icon(\n  onPressed: (manager.isAnalyzing || manager.prefilterResult == null) ? null : () {\n    final prefiltered = manager.prefilterResult!.selectedCrashDumpList;\n    if (prefiltered.isNotEmpty) {\n      manager.startLocalAnalyze(prefiltered);\n    }\n  },\n  icon: const Icon(Icons.computer),\n  label: const Text('本地深度分析'),\n  style: ElevatedButton.styleFrom(\n    backgroundColor: Colors.green,\n  ),\n),\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-0rnirn5","Type":"NodeParagraph","Properties":{"id":"20260703211211-0rnirn5","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"按钮启用条件"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-8s47b6y","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-8s47b6y","updated":"20260703211211"},"Children":[{"ID":"20260703211211-2mwb5op","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-2mwb5op","updated":"20260703211211"},"Children":[{"ID":"20260703211211-gcsy6n9","Type":"NodeParagraph","Properties":{"id":"20260703211211-gcsy6n9","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"B2 预筛完成且 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"selectedCrashDumpList"},{"Type":"NodeText","Data":" 非空时 → 按钮可用"}]}]},{"ID":"20260703211211-67v9xri","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-67v9xri","updated":"20260703211211"},"Children":[{"ID":"20260703211211-la1ymf7","Type":"NodeParagraph","Properties":{"id":"20260703211211-la1ymf7","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"预筛未完成或正在分析中时 → 按钮禁用"}]}]}]},{"ID":"20260703211211-9gj22km","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-9gj22km","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"8.2 结果展示"}]},{"ID":"20260703211211-ftebibh","Type":"NodeParagraph","Properties":{"id":"20260703211211-ftebibh","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"本地分析结果的展示卡片："}]},{"ID":"20260703211211-eocr094","Type":"NodeTable","Data":"|classification|展示样式|\n| ----------------| --------------------------------------------------------------|\n|`third_party_hit`|🟢 绿色卡片，显示厂商名 + 置信度 + 客服回复话术 + 证据链|\n|`third_party_not_hit`|🟡 黄色卡片，显示\"企微自身问题，需提单\" + 环境第三方模块列表|\n|`hardware_issue`|🔵 蓝色卡片，显示\"硬件故障\" + 用户回复建议|\n|`unable_to_analyze`|⚪ 灰色卡片，显示\"无法自动判定\" + 原因 + 建议人工分析|","TableAligns":[0,0],"Properties":{"id":"20260703211211-eocr094","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"classification"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"展示样式"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_hit"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"🟢 绿色卡片，显示厂商名 + 置信度 + 客服回复话术 + 证据链"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_not_hit"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"🟡 黄色卡片，显示\"企微自身问题，需提单\" + 环境第三方模块列表"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hardware_issue"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"🔵 蓝色卡片，显示\"硬件故障\" + 用户回复建议"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"⚪ 灰色卡片，显示\"无法自动判定\" + 原因 + 建议人工分析"}]}]}]},{"ID":"20260703211211-hfab8tg","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-hfab8tg","updated":"20260703211211"}},{"ID":"20260703211211-p95qaa5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-p95qaa5","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"9. 实施计划"}]},{"ID":"20260703211211-a54n7yx","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-a54n7yx","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"9.1 分步实施"}]},{"ID":"20260703211211-q4o6kcp","Type":"NodeTable","Data":"|步骤|内容|依赖|预估工时|\n| ---------| ------------------------------------------------| --------------| ----------|\n|Step 1|创建 `transparent_modules.json`​ + `scene_associations.json` 配置文件|无|0.5h|\n|Step 2|扩展 `third_party_dlls.json`​，为每个厂商增加 `category` 字段|无|0.5h|\n|Step 3|`CrashMcpBridge`​ 新增 `execDeepCommands` 方法|无|2h|\n|Step 4|实现 `CrashLocalDeepAnalyzer`（深度采证编排 + CDB 输出解析）|Step 3|4h|\n|Step 5|实现 `CrashLocalRuleEngine`（规则引擎归因算法）|Step 1, 2|4h|\n|Step 6|实现 `LocalAnalysisResult` 数据模型|无|1h|\n|Step 7|`CrashAnalysisManager`​ 新增 `startLocalAnalyze` 入口|Step 4, 5, 6|2h|\n|Step 8|UI 层新增\"本地深度分析\"按钮 + 结果展示卡片|Step 7|2h|\n|Step 9|单元测试（规则引擎 + CDB 输出解析）|Step 4, 5|3h|\n|Step 10|集成测试（用 crash_text_1 的 dump 端到端验证）|All|1h|","TableAligns":[0,0,0,0],"Properties":{"id":"20260703211211-q4o6kcp","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"步骤"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"内容"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"依赖"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"预估工时"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Step 1"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"创建 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"transparent_modules.json"},{"Type":"NodeText","Data":"​ + "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"scene_associations.json"},{"Type":"NodeText","Data":" 配置文件"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"0.5h"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"Step 2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"扩展 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party_dlls.json"},{"Type":"NodeText","Data":"​，为每个厂商增加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"category"},{"Type":"NodeText","Data":" 字段"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText",