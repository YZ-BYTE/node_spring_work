ype":"NodeText","Data":"​ 中的栈帧可能被截断，且缺少 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 数据）"}]}]}]},{"ID":"20260703211211-50aum67","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-50aum67","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 执行深度采证。\n/// \n/// [sessionId] CDB 会话 ID（来自预筛复用或新建）。\n/// [dumpSha1] dump 文件 SHA1。\n/// [dumpFilePath] dump 文件本地路径。\n/// [quickTriageHint] 可选，来自 B2 预筛的 quickTriageRaw，\n///   用于 S0/S1 快速消费异常码，以及作为 kb 命令失败时的降级数据源。\nFuture\u003cDeepCollectionResult\u003e runDeepCollection({\n  required String sessionId,\n  required String dumpSha1,\n  required String dumpFilePath,\n  Map\u003cString, dynamic\u003e? quickTriageHint,\n}) async { ... }\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-m96olkz","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-m96olkz","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.3 采证结果数据模型"}]},{"ID":"20260703211211-3qpucnl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-3qpucnl","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 深度采证结果，包含规则引擎所需的全部结构化数据。\nclass DeepCollectionResult {\n  // ===== 基础信息 =====\n  /// dump 文件的 SHA1。\n  final String dumpSha1;\n  /// dump 文件本地路径。\n  final String dumpFilePath;\n  \n  // ===== 异常信息 =====\n  /// 异常代码，如 \"0xc0000005\"。\n  final String? exceptionCode;\n  /// 异常地址，如 \"0x7ff8`12345678\"。\n  final String? exceptionAddress;\n  /// 异常地址所在模块名（从地址解析），如 \"Windows_Globalization\"。\n  final String? exceptionModule;\n  /// 异常描述，如 \"Access violation - code c0000005 (first/second chance not available)\"。\n  final String? exceptionDescription;\n  \n  // ===== 调用栈 =====\n  /// 崩溃线程调用栈帧列表（从栈顶到栈底）。\n  final List\u003cStackFrame\u003e stackFrames;\n  \n  // ===== 模块列表 =====\n  /// 进程中加载的所有模块。\n  final List\u003cLoadedModule\u003e loadedModules;\n  \n  // ===== !analyze -v 结果 =====\n  /// Failure Bucket ID（如 \"IN_PAGE_ERROR_c000009c_hardware_disk!Unknown\"）。\n  final String? failureBucketId;\n  /// FAULTING_MODULE（如 \"ntdll\"）。\n  final String? faultingModule;\n  /// 完整的 !analyze -v 原始输出（供人工审阅）。\n  final String? analyzeVOutput;\n  \n  // ===== 元数据 =====\n  /// 采证耗时（毫秒）。\n  final int elapsedMs;\n  /// 是否所有命令都成功执行。\n  final bool allCommandsSucceeded;\n  /// 失败的命令列表（用于降级判断）。\n  final List\u003cString\u003e failedCommands;\n}\n\n/// 调用栈帧。\nclass StackFrame {\n  final int frameIndex;        // 帧序号（0 = 栈顶）\n  final String? moduleName;    // 模块名，如 \"Windows_Globalization\"\n  final String? functionName;  // 函数名，如 \"InternalAddRef\"\n  final String? fullSymbol;    // 完整符号，如 \"Windows_Globalization!...InternalAddRef\"\n  final String? framePointer;  // 帧指针地址\n  final String? returnAddress; // 返回地址\n}\n\n/// 加载的模块信息。\nclass LoadedModule {\n  final String name;           // 模块名（不含扩展名），如 \"baiducnTSF\"\n  final String? fullName;      // 完整文件名，如 \"baiducnTSF.dll\"\n  final String? path;          // 模块路径，如 \"C:\\Windows\\System32\\baiducnTSF.dll\"\n  final String? startAddress;  // 加载起始地址\n  final String? endAddress;    // 加载结束地址\n  final String? version;       // 版本号\n  final String? companyName;   // 公司名（来自 PE VersionInfo，可能为空）\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-3cag2kl","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-3cag2kl","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"4.4 CDB 输出解析"}]},{"ID":"20260703211211-xaqgb0n","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260703211211-xaqgb0n","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"4.4.1 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"kb"},{"Type":"NodeText","Data":" 输出解析"}]},{"ID":"20260703211211-f5wwqb6","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-f5wwqb6","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":" # ChildEBP RetAddr      Args to Child\n00 0019e8c0 6a0a1234 00000000 00000001 Windows_Globalization!...InternalAddRef\n01 0019e8d4 6a0a5678 00000000 00000001 Windows_Globalization!...AddRef\n02 0019e8f0 75ab1234 00000000 00000001 msftedit!CTxtBreaker::SetBreaks\n...\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-bnvu76g","Type":"NodeParagraph","Properties":{"id":"20260703211211-bnvu76g","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"解析规则："}]},{"ID":"20260703211211-voakzbv","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-voakzbv","updated":"20260703211211"},"Children":[{"ID":"20260703211211-bxroxeh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-bxroxeh","updated":"20260703211211"},"Children":[{"ID":"20260703211211-84