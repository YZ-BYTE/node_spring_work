","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"exceptionCode = \"0xc0000006\"\nexceptionModule = \"Windows_Globalization\"\nstackFrames = [\n  {0, \"Windows_Globalization\", \"InternalAddRef\", \"Windows_Globalization!...InternalAddRef\"},\n  {1, \"Windows_Globalization\", \"AddRef\", \"Windows_Globalization!...AddRef\"},\n  {2, \"Windows_Globalization\", \"SimpleVectorView\", \"Windows_Globalization!...SimpleVectorView\"},\n  {3, \"Windows_Globalization\", \"GetView\", \"Windows_Globalization!...GetView\"},\n  {4, \"Windows_Globalization\", \"GetTokens\", \"Windows_Globalization!...GetTokens\"},\n  {5, \"msftedit\", \"SetBreaks\", \"msftedit!CTxtBreaker::SetBreaks\"},\n  {6, \"msftedit\", \"OnPostReplaceRange\", \"msftedit!CTxtBreaker::OnPostReplaceRange\"},\n  {7, \"msftedit\", \"CalculateBaseBreaks\", \"msftedit!CTxtBreaker::CalculateBaseBreaks\"},\n  {8, \"msftedit\", \"CanBreakCp\", \"msftedit!CTxtBreaker::CanBreakCp\"},\n  {9, \"msftedit\", \"TxWordBreakProc\", \"msftedit!CTxtEdit::TxWordBreakProc\"},\n  {10, \"msftedit\", \"FindWordBreak\", \"msftedit!CTxtPtr::FindWordBreak\"},\n  {11, \"msftedit\", \"AutoCorrect\", \"msftedit!CTxtEdit::AutoCorrect\"},\n  {12, \"msftedit\", \"PutChar\", \"msftedit!CTxtSelection::PutChar\"},\n  ...\n  {18, \"DuiLib\", \"TxSendMessage\", \"DuiLib!CRichEditUI::TxSendMessage\"},\n  {22, \"WXWork\", \"HandleMessage\", \"WXWork!BaseWindow::HandleMessage\"},\n]\nloadedModules 包含: baiducnTSF, UIPFull, imefreetype, imezlib, imepng, IMEResourceMgr\nfailureBucketId = \"IN_PAGE_ERROR_c000009c_SOFTWARE_NX_FAULT_c0000006_hardware_disk!Unknown\"\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-sjj4dcs","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-sjj4dcs","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"执行推演"}]},{"ID":"20260703211211-co559ig","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-co559ig","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"S0: 前置检查\n  ✅ exceptionCode = \"0xc0000006\" (非空)\n  ✅ stackFrames.length = 23 (非空)\n  ✅ loadedModules.length \u003e 0 (非空)\n  → 通过\n\nS1: exception_code 分流\n  \"0xc0000006\" 不是 0xc0000374\n  → 标记 ioErrorMode = true（IO 错误场景）\n  → 继续\n\nS2: 构建 userFrames + 去递归重复帧\n  过滤 transparent_modules → Windows_Globalization 不在列表中，保留\n  去递归重复帧 → 本 case 无递归，帧列表不变\n  → topUserFrame = frame[0] (Windows_Globalization!...InternalAddRef)\n\nS3-A: 栈顶用户帧 ∈ 第三方名册？（先排除企微模块）\n  \"Windows_Globalization\" 不在 wxwork_dlls.json 中 → 继续匹配第三方名册\n  查找 \"Windows_Globalization\" in third_party_dlls.json\n  → ✅ 命中！vendor = \"Windows.Globalization (系统输入法组件)\"\n  → classification = \"third_party_hit\"\n  → confidence = \"high\"（非 heapMode/funcPtrMode，不触发钳位）\n\nS-Final: 全局置信度钳位\n  heapMode=false, funcPtrMode=false → 不钳位\n  → 最终 confidence = \"high\"\n  → 结束！\n\n输出:\n  classification: \"third_party_hit\"\n  confidence: \"high\"\n  vendor: \"Windows.Globalization (系统输入法组件)\"\n  evidenceList: [\n    \"栈顶用户帧 Windows_Globalization!...InternalAddRef 命中第三方模块 Windows.Globalization\",\n  ]\n  userReplyTemplate: \"经核实，该问题与系统输入法组件 Windows.Globalization.dll 相关...\"\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-ccsgyau","Type":"NodeParagraph","Properties":{"id":"20260703211211-ccsgyau","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"补充说明：本 case 中 failureBucketId 含"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"hardware_disk"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"}]},{"ID":"20260703211211-jxod2mp","Type":"NodeParagraph","Properties":{"id":"20260703211211-jxod2mp","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"注意本 case 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"failureBucketId = \"IN_PAGE_ERROR_c000009c_SOFTWARE_NX_FAULT_c0000006_hardware_disk!Unknown\""},{"Type":"NodeText","Data":"​，按 S1.5 规则会命中硬件故障提前返回。但实际上这个 Bucket ID 同时含 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"SOFTWARE_NX_FAULT"},{"Type":"NodeText","Data":"​，说明 WinDbg 自身判定也存在歧义。因此 S1.5 的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"hardware_"},{"Type":"NodeText","Data":"​ 匹配应更严格："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只有"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"failureBucketId"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeText","Data":"​ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"以"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"hardware_"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"​"},{"Type":"NodeText","Data":" ​ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"开头或整体模式为纯硬件故障时才提前返回"},{"Type":"NodeText","Data":"，而非简单 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"contains"},{"Type":"NodeText","Data":"。本 case 应继续走 S2 以下流程。"}]},{"ID":"20260703211211-z9i6bun","Type":"NodeParagraph","Properties":{"id":"20260703211211-z9i6bun","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"如果 Windows_Globalization 不在第三方名册（假设移除），且未被 S1.5 拦截"},{"Type":"NodeText","Data":"："}]},{"ID":"20260703211211-lubz7ep","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260703211211-lubz7ep","updated":"20260703211211"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"S3-A: 不命中\nS3-B: 扫描去重后前20帧，没有 baiducnTSF 出现在栈上（排除企微模块后）→ 不命中\nS4: 场景关联检测\n  模式 A (输入法场景):\n    条件1: 栈中有 \"TxWordBreakProc\"(frame 9), \"AutoCorrect\"(frame 11), \n           \"PutChar\"(frame 12), \"GetTokens\"(frame 4) → ✅ 命中\n    条件2: loadedModules 中有 baiducnTSF(category=input_method) → ✅ 命中\n    → classification = \"third_party_hit\"\n    → confidence = \"medium\"\n    → vendor = \"百度输入法\"\n    → scene = \"text_input\"\n    → 结束！\n\n  (如果模式 A 也不命中，继续模式 B):\n  模式 B (IO 错误场景):\n    条件1: exceptionCode = \"0xc0000006\" → ✅ 是 IO 错误\n    条件2: loadedModules 中有 DLP/安全模块？→ 看具体环境\n    ...\n\n  模式 C (模块穿插检测):\n    统计 userFrames 中非企微、非系统的未知模块出现次数\n    → 本 case 无此类模块 → 不命中\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260703211211-u9akjvv","Type":"NodeParagraph","Properties":{"id":"20260703211211-u9akjvv","updated":"20260703211211"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结论"},{"Type":"NodeText","Data":"：S3-A 直接命中是主路径；即使移除 Windows_Globalization，S4 模式 A 仍能通过场景关联正确归因。两条路径形成"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"双重保险"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260703211211-vfvm026","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-vfvm026","updated":"20260703211211"}},{"ID":"20260703211211-pdc23ca","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-pdc23ca","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"11. 风险与局限性"}]},{"ID":"20260703211211-qu3fhkq","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-qu3fhkq","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"11.1 已知局限"}]},{"ID":"20260703211211-2nhkiwj","Type":"NodeTable","Data":"|局限|影响|缓解措施|\n| ------------------------| --------------------------------| --------------------------------------------|\n|第三方名册是有限集|新出现的第三方模块无法自动识别|定期维护名册 + `unable_to_analyze` 兜底|\n|`!analyze -v` 依赖符号下载|符号服务器不可达时该命令超时|降级跳过，规则引擎不强依赖此输出|\n|只看崩溃线程栈|heap corruption 场景可能漏判|S1 标记 heapMode，confidence 降级为 medium|\n|场景关联依赖关键词列表|新场景需要手动添加关键词|配置文件化，可热更新|\n|minidump 信息有限|无法做 `!heap -x` 等深度诊断|不做超出 minidump 能力的分析|","TableAligns":[0,0,0],"Properties":{"id":"20260703211211-2nhkiwj","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"局限"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"影响"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"缓解措施"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"第三方名册是有限集"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"新出现的第三方模块无法自动识别"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"定期维护名册 + "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 兜底"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!analyze -v"},{"Type":"NodeText","Data":" 依赖符号下载"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"符号服务器不可达时该命令超时"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"降级跳过，规则引擎不强依赖此输出"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"只看崩溃线程栈"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"heap corruption 场景可能漏判"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"S1 标记 heapMode，confidence 降级为 medium"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"场景关联依赖关键词列表"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"新场景需要手动添加关键词"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"配置文件化，可热更新"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"minidump 信息有限"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"无法做 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"!heap -x"},{"Type":"NodeText","Data":" 等深度诊断"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"不做超出 minidump 能力的分析"}]}]}]},{"ID":"20260703211211-wffjovn","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260703211211-wffjovn","updated":"20260703211211"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"11.2 与 CLI 链路的互补关系"}]},{"ID":"20260703211211-d5rbfha","Type":"NodeTable","Data":"|场景|本地规则引擎|CLI/LLM|\n| ---------------------------| -------------------------------| --------------------------------|\n|已知第三方模块直接命中|✅ 秒级确定性判定|✅ 也能判，但慢且不稳定|\n|场景关联（输入法/IO错误）|✅ 通过配置规则覆盖|✅ LLM 语义理解可能更灵活|\n|完全未知的第三方模块|❌ 只能标记 unable_to_analyze|✅ LLM 可能通过模块名/路径推理|\n|复杂的多线程踩踏|❌ 超出规则引擎能力|⚠️ LLM 也不一定能判准|\n|硬件故障|✅ Failure Bucket 直接判定|✅ 也能判|","TableAligns":[0,0,0],"Properties":{"id":"20260703211211-d5rbfha","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"场景"}]},{"Type":"No