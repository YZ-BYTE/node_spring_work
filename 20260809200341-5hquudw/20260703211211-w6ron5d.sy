ker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-3yc0hze","updated":"20260703211211"},"Children":[{"ID":"20260703211211-mhs3aao","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-mhs3aao","updated":"20260703211211"},"Children":[{"ID":"20260703211211-rg1gxsd","Type":"NodeParagraph","Properties":{"id":"20260703211211-rg1gxsd","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"客服日常使用 → 优先点\"本地深度分析\"（快、稳、免费）"}]}]},{"ID":"20260703211211-p4begnk","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260703211211-p4begnk","updated":"20260703211211"},"Children":[{"ID":"20260703211211-ddkc449","Type":"NodeParagraph","Properties":{"id":"20260703211211-ddkc449","updated":"20260703211211"},"Children":[{"Type":"NodeText","Data":"本地分析输出 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unable_to_analyze"},{"Type":"NodeText","Data":" 时 → 再点\"CLI 深度分析\"（慢、贵、但覆盖面更广）"}]}]}]},{"ID":"20260703211211-040vwwo","Type":"NodeThematicBreak","Properties":{"id":"20260703211211-040vwwo","updated":"20260703211211"}},{"ID":"20260703211211-4lgc6bx","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260703211211-4lgc6bx","updated":"20260705145703"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"12. 后续迭代方向（v2+）"}]},{"ID":"20260703211211-spjh9fx","Type":"NodeTable","Data":"|迭代项|优先级|说明|\n| ----------------------| --------| ---------------------------------------------------------------------------------------------------------------------------------------|\n|多 dump 批量分析|P1|首版只分析第一个 dump，后续支持批量|\n|全线程栈扫描|P2|heap corruption 时扫描 `~*kb` 所有线程|\n|全线程输入法辅助判断|P2|采证阶段增加 `~*kb`，检测其他线程中是否有输入法模块的栈帧，作为 text_input 场景的辅助证据（如 crash_text_1 中百度输入法有独立线程在运行）|\n|模块详情查询|P2|对可疑模块执行 `lmvm` 获取 CompanyName|\n|名册自动更新|P3|从远端拉取最新的第三方名册|\n|分析结果缓存|P3|相同 dump SHA1 不重复分析|\n|导出报告|P3|一键导出分析报告供提单使用|\n|路径特征匹配|P3|在 third_party_dlls.json 中支持 `path_patterns`​ 字段，通过模块加载路径特征（如 `C:\\Windows\\SYSTEM32\\winaim*`​）识别未在名册中的监控类模块。需要从 `lm` 输出中解析完整路径信息|","TableAligns":[0,0,0],"Properties":{"id":"20260703211211-spjh9fx","updated":"20260703211211"},"Children":[{"Type":"NodeTableHead","Children":[{"Type":"NodeTableRow","Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"迭代项"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"优先级"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"说明"}]}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"多 dump 批量分析"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P1"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"首版只分析第一个 dump，后续支持批量"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"全线程栈扫描"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"heap corruption 时扫描 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"~*kb"},{"Type":"NodeText","Data":" 所有线程"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"全线程输入法辅助判断"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"采证阶段增加 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"~*kb"},{"Type":"NodeText","Data":"，检测其他线程中是否有输入法模块的栈帧，作为 text_input 场景的辅助证据（如 crash_text_1 中百度输入法有独立线程在运行）"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"模块详情查询"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"对可疑模块执行 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lmvm"},{"Type":"NodeText","Data":" 获取 CompanyName"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"名册自动更新"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"从远端拉取最新的第三方名册"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"分析结果缓存"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"相同 dump SHA1 不重复分析"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"导出报告"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"一键导出分析报告供提单使用"}]}]},{"Type":"NodeTableRow","TableAligns":[0,0,0],"Children":[{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"路径特征匹配"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"P3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeText","Data":"在 third_party_dlls.json 中支持 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"path_patterns"},{"Type":"NodeText","Data":"​ 字段，通过模块加载路径特征（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"C:\\Windows\\SYSTEM32\\winaim*"},{"Type":"NodeText","Data":"​）识别未在名册中的监控类模块。需要从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"lm"},{"Type":"NodeText","Data":" 输出中解析完整路径信息"}]}]}]},{"ID":"20260705145647-m4a63al","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260705145647-m4a63al","updated":"20260705155130"},"Children":[{"Type":"NodeText","Data":"windbg常用命令"}]},{"ID":"20260705151908-ipsci22","Type":"NodeParagraph","Properties":{"id":"20260705151908-ipsci22","updated":"20260705151908"},"Child