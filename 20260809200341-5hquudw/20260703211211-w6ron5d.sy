53326-gbfkxnm","updated":"20260705153428"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"code c0000006"},{"Type":"NodeText","Data":"\n主异常码\n0xc0000006 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":" EXCEPTION"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"IN"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"PAGE"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"ERROR\n含义：程序访问某块内存时，系统要把页面从磁盘/映射文件读进来，但失败了"}]},{"ID":"20260705153326-uvw631i","Type":"NodeParagraph","Properties":{"id":"20260705153326-uvw631i","updated":"20260705153432"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"In-page I/O error c000009c"},{"Type":"NodeText","Data":"\n更底层的 I/O 状态\n0xc000009c 通常偏向设备读错误/介质错误"}]},{"ID":"20260705153326-bdjcltz","Type":"NodeParagraph","Properties":{"id":"20260705153326-bdjcltz","updated":"20260705153436"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"first/second chance not available"},{"Type":"NodeText","Data":"\n不是说没异常\n是这个 mini dump 没保留完整 chance 信息"}]},{"ID":"20260705151153-nzwdo09","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260705151153-nzwdo09","updated":"20260705153826"},"Children":[{"Type":"NodeText","Data":".exr -1"}]},{"ID":"20260705151226-nw12o4a","Type":"NodeParagraph","Properties":{"id":"20260705151226-nw12o4a","updated":"20260705153826"},"Children":[{"Type":"NodeText","Data":"拿最近一次异常记录\n读正式异常记录\n给你“异常地址 + 异常码 + 参数”"}]},{"ID":"20260705152619-kajq3td","Type":"NodeParagraph","Properties":{"id":"20260705152619-kajq3td","updated":"20260705152841"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20260705152841-v3xn6fr.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260705153501-4scaay1","Type":"NodeParagraph","Properties":{"id":"20260705153501-4scaay1","updated":"20260705153501"},"Children":[{"Type":"NodeText","Data":"看 5 个点："}]},{"ID":"20260705153501-o4mat01","Type":"NodeParagraph","Properties":{"id":"20260705153501-o4mat01","updated":"20260705153513"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ExceptionAddress"},{"Type":"NodeText","Data":"\n异常地址\n这里是 5fe17dc9\n落在 Windows"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"Globalization.dll"}]},{"ID":"20260705153501-hzt33lk","Type":"NodeParagraph","Properties":{"id":"20260705153501-hzt33lk","updated":"20260705153634"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ExceptionCode"},{"Type":"NodeText","Data":"\n和 .lastevent 一致，还是 c0000006"}]},{"ID":"20260705153643-zn4fbee","Type":"NodeParagraph","Properties":{"id":"20260705153643-zn4fbee","updated":"20260705153644"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parameter[0]     故障类型"},{"Type":"NodeText","Data":"\n对 c0000006 来说是异常类型细节\n一般不如后两个直观"}]},{"ID":"20260705153501-p1t6sd5","Type":"NodeParagraph","Properties":{"id":"20260705153501-p1t6sd5","updated":"20260705153635"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parameter[1]     出错的内存地址"},{"Type":"NodeText","Data":"\n出问题的地址/相关地址\n这里也是 5fe17dc9"}]},{"ID":"20260705153501-pducres","Type":"NodeParagraph","Properties":{"id":"20260705153501-pducres","updated":"20260705153807"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parameter[2]     底层 IO 错误码"}]},{"ID":"20260705153501-cggyqlh","Type":"NodeParagraph","Properties":{"id":"20260705153501-cggyqlh","updated":"20260705153656"},"Children":[{"Type":"NodeText","Data":"最关键\n这里是 c000009c\n就是底层 I/O 错误状态"}]},{"ID":"20260705151202-qorv399","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260705151202-qorv399","updated":"20260705154212"},"Children":[{"Type":"NodeText","Data":".ecxr"}]},{"ID":"20260705151244-lxgt571","Type":"NodeParagraph","Properties":{"id":"20260705151244-lxgt571","updated":"20260705154212"},"Children":[{"Type":"NodeText","Data":"切到异常上下文\n把当前调试上下文切到“异常发生那一刻”\n之后再执行 kb，拿到的才是异常现场栈"}]},{"ID":"20260705152843-gbsqmma","Type":"NodeParagraph","Properties":{"id":"20260705152843-gbsqmma","updated":"20260705152930"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20260705152930-7wp12xs.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260705154129-wu2bdmi","Type":"NodeParagraph","Properties":{"id":"20260705154129-wu2bdmi","updated":"20260705154129"},"Children":[{"Type":"NodeText","Data":"看 3 个点："}]},{"ID":"20260705154129-ff29hrb","Type":"NodeParagraph","Properties":{"id":"20260705154129-ff29hrb","updated":"20260705154142"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"eip=5fe17dc9"},{"Type":"NodeText","Data":"\nx86 下 eip 就是当前指令地址\n它和 .exr -1 的 ExceptionAddress: 5fe17dc9 对上了\n这说明你已经切到了异常现场"}]},{"ID":"20260705154129-pybe5km","Type":"NodeParagraph","Properties":{"id":"20260705154129-pybe5km","updated":"20260705154146"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"模块名"},{"Type":"NodeText","Data":"\n还是 Windows"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"Globalization\n和异常记录一致"}]},{"ID":"20260705154129-bkrd5m9","Type":"NodeParagraph","Properties":{"id":"20260705154129-bkrd5m9","updated":"20260705154152"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"当前汇编"},{"Type":"NodeText","Data":"\nmov edi,edi 本身没特殊意义\n重点不是这条指令做了什么\n重点是“当前上下文已经定位到异常地址”"}]},{"ID":"20260705151210-6f04tv6","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260705151210-6f04tv6","updated":"20260705154356"},"Children":[{"Type":"NodeText","Data":"kb"}]},{"ID":"20260705151255-n2zoph7","Type":"NodeParagraph","Properties":{"id":"20260705151255-n2zoph7","updated":"20260705154356"},"Children":[{"Type":"NodeText","Data":"打印崩溃线程调用栈\n看异常是沿着什么调用链触发的\n判断故障模块、业务场景、是否像 crash 现场"}]},{"ID":"20260705152845-21zwkvi","Type":"NodeParagraph","Properties":{"id":"20260705152845-21zwkvi","updated":"20260705153010"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20260705152944-h6jo3rp.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260705154320-6z6szm7","Type":"NodeParagraph","Properties":{"id":"20260705154320-6z6szm7","updated":"20260705154320"},"Children":[{"Type":"NodeText","Data":"怎么看："}]},{"ID":"20260705154320-8cywspb","Type":"NodeParagraph","Properties":{"id":"20260705154320-8cywspb","updated":"20260705154331"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"栈顶最重要"},{"Type":"NodeText","Data":"\n00 到 08 在 Windows"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"Globalization\n说明异常发生在这个模块内部"}]},{"ID":"20260705154320-of7j6eh","Type":"NodeParagraph","Properties":{"id":"20260705154320-of7j6eh","updated":"20260705154335"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"再往下看业务场景"},{"Type":"NodeText","Data":"\nmsftedit!CTxtBreaker / AutoCorrect / OnTxChar\n这是明显的文本输入、分词、自动纠错链路"}]},{"ID":"20260705154320-ia2gq9i","Type":"NodeParagraph","Properties":{"id":"20260705154320-ia2gq9i","updated":"20260705154338"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"再往下看宿主 UI"},{"Type":"NodeText","Data":"\nDuiLib\nWXWork"}]},{"ID":"20260705151217-e1i6grz","Type":"NodeHeading","HeadingLevel":5,"Properties":{"id":"20260705151217-e1i6grz","updated":"20260705155019"},"Children":[{"Type":"NodeText","Data":"!teb"}]},{"ID":"20260705151309-slyvilp","Type":"NodeParagraph","Properties":{"id":"20260705151309-slyvilp","updated":"20260705154439"},"Children":[{"Type":"NodeText","Data":"看当前线程的TEB（线程环境块）信息"}]},{"ID":"20260705145711-sj5lybh","Type":"NodeParagraph","Properties":{"id":"20260705145711-sj5lybh","updated":"20260705153110"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20260705153110-a25e96e.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260705154448-ygp6b34","Type":"NodeParagraph","Properties":{"id":"20260705154448-ygp6b34","updated":"20260705154448"},"Children":[{"Type":"NodeText","Data":"看 3 个点："}]},{"ID":"20260705154448-yksgpiq","Type":"NodeParagraph","Properties":{"id":"20260705154448-yksgpiq","updated":"20260705154458"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ClientId"},{"Type":"NodeText","Data":"\n4b58 . 4528\n跟 .lastevent 里的 4b58.4528 对上了\n说明你看的 TEB 就是异常线程"}]},{"ID":"20260705154448-u88deks","Type":"NodeParagraph","Properties":{"id":"20260705154448-u88deks","updated":"20260705154502"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"LastErrorValue: 0"},{"Type":"NodeText","Data":"\nWin32 错误码为 0\n没太大帮助"}]},{"ID":"20260705154448-4anlzx8","Type":"NodeParagraph","Properties":{"id":"20260705154448-4anlzx8","updated":"20260705154509"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"LastStatusValue: c000000f"},{"Type":"NodeText","Data":"\n线程最近一次 NTSTATUS\n是辅助线索，不是主证据\n不要拿它覆盖 .exr -1 里的 c000009c"}]},{"ID":"20260705154935-rtz1wpo","Type":"NodeThematicBreak","Properties":{"id":"20260705154935-rtz1wpo","updated":"20260705154935"}},{"ID":"20260705145711-ky637ax","Type":"NodeParagraph","Properties":{"id":"20260705145711-ky637ax","updated":"20260705155019"},"Children":[{"Type":"NodeText","Data":"一般就按 .lastevent -\u003e .exr -1 -\u003e .ecxr -\u003e kb -\u003e !teb 这顺序看：\n先用 .lastevent 看最后一次是不是明确的异常事件，比如 c0000006/c0000005 这种；\n再用 .exr -1 确认确实有完整异常记录，能看到异常地址、异常码和参数；\n接着 .ecxr 切到异常当时的上下文，如果寄存器里的 eip/rip 能对上异常地址，说明现场是有效的；\n然后 kb 看异常线程的调用栈，能看到清晰的栈顶模块和调用链，基本就能确认这是崩溃现场；\n最后 !teb 主要是补线程信息和 LastErrorValue/LastStatusValue 做辅助校验。"}]},{"ID":"20260705145711-dmzk5m2","Type":"NodeParagraph","Properties":{"id":"20260705145711-dmzk5m2","updated":"20260705145711"}},{"ID":"20260705145711-p94dhtf","Type":"NodeParagraph","Properties":{"id":"20260705145711-p94dhtf","updated":"20260705145711"}},{"ID":"20260705145712-2o5hlzl","Type":"NodeParagraph","Properties":{"id":"20260705145712-2o5hlzl","updated":"20260705145712"}},{"ID":"20260705145712-ozaqums","Type":"NodeParagraph","Properties":{"id":"20260705145712-ozaqums","updated":"20260705145712"}},{"ID":"20260705145712-tl9erce","Type":"NodeParagraph","Properties":{"id":"20260705145712-tl9erce","updated":"20260705145712"}},{"ID":"20260705145712-jkzesiq","Type":"NodeParagraph","Properties":{"id":"20260705145712-jkzesiq","updated":"20260705145712"}},{"ID":"20260705145712-idnz81q","Type":"NodeParagraph","Properties":{"id":"20260705145712-idnz81q","updated":"20260705145712"}},{"ID":"20260705145712-qkgfgzt","Type":"NodeParagraph","Properties":{"id":"20260705145712-qkgfgzt","updated":"20260705145712"}},{"ID":"20260705145712-gpecsyq","Type":"NodeParagraph","Properties":{"id":"20260705145712-gp