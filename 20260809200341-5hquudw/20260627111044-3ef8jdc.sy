":"20260627111044-y6wgwmh","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-y6wgwmh","updated":"20260627111044"},"Children":[{"ID":"20260627111044-b5owk5f","Type":"NodeParagraph","Properties":{"id":"20260627111044-b5owk5f","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"结论标题"},{"Type":"NodeText","Data":"：由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"headline"},{"Type":"NodeText","Data":" 承担，用一句话说明当前最可能的问题。"}]}]},{"ID":"20260627111044-dplib7h","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-dplib7h","updated":"20260627111044"},"Children":[{"ID":"20260627111044-gpnxzcm","Type":"NodeParagraph","Properties":{"id":"20260627111044-gpnxzcm","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"建议回复"},{"Type":"NodeText","Data":"：由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"userReplyTemplate"},{"Type":"NodeText","Data":" 承担，给出客服可直接复制给用户的回复文案。"}]}]},{"ID":"20260627111044-4lj4snf","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-4lj4snf","updated":"20260627111044"},"Children":[{"ID":"20260627111044-zcjvw7c","Type":"NodeParagraph","Properties":{"id":"20260627111044-zcjvw7c","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"问题分类"},{"Type":"NodeText","Data":"：展示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"企业微信自身异常"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"第三方应用异常"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"无法判断"},{"Type":"NodeText","Data":" 等分类结果。"}]}]},{"ID":"20260627111044-o70a5f3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-o70a5f3","updated":"20260627111044"},"Children":[{"ID":"20260627111044-iil4nt0","Type":"NodeParagraph","Properties":{"id":"20260627111044-iil4nt0","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键依据"},{"Type":"NodeText","Data":"：由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"evidenceList"},{"Type":"NodeText","Data":" 承担，列出支撑结论的日志、Dump、网络或环境证据摘要。"}]}]},{"ID":"20260627111044-mn8epxw","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-mn8epxw","updated":"20260627111044"},"Children":[{"ID":"20260627111044-jbgq5mr","Type":"NodeParagraph","Properties":{"id":"20260627111044-jbgq5mr","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"下一步动作"},{"Type":"NodeText","Data":"：由 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"actionType"},{"Type":"NodeText","Data":" 直接映射生成展示文案，明确当前应直接回复、引导用户自查、补充材料、转研发或联系第三方。"}]}]},{"ID":"20260627111044-b7km7j9","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-b7km7j9","updated":"20260627111044"},"Children":[{"ID":"20260627111044-4xnsmv1","Type":"NodeParagraph","Properties":{"id":"20260627111044-4xnsmv1","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"技术详情"},{"Type":"NodeText","Data":"：按需展示原始证据引用、上下文标签和调试信息，如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"仅基于 dump 分析"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"无日志上下文"},{"Type":"NodeText","Data":"。"}]}]}]},{"ID":"20260627111044-bnboyr1","Type":"NodeParagraph","Properties":{"id":"20260627111044-bnboyr1","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"为尽量保留目前原有字段名并控制首版复杂度，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisResult"},{"Type":"NodeText","Data":" 建议收敛为\"核心闭环字段 + 少量场景辅助字段\"的结构："}]},{"ID":"20260627111044-o1vlwan","Type":"NodeParagraph","Properties":{"id":"20260627111044-o1vlwan","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像一份标准的“体检报告单”。以前系统输出的只是一堆散落的文本块，客服还得自己总结；现在强制要求系统输出结构化的结论（是谁的锅、怎么回复用户、怎么转交研发），最后再“降维”成界面文本展示，既保住了现有 UI，又实现了智能归因。"}]},{"ID":"20260627111044-mbql1u3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111044-mbql1u3","updated":"20260627111044"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"class AnalysisResult {\n  // ==========================================\n  // 1. 元数据与来源标识 (Meta Info)\n  // ==========================================\n  /// 结果来源类型: local_rule(本地规则), dump_attribution(Dump归因), network_log_summary(网络日志总结)\n  final String resultType; \n  /// 分析指纹: 用于缓存复用，避免相同的日志/Dump重复调用 AI。\n  /// 采用“按需组合”的动态指纹策略：根据 resultType 动态决定将哪些版本因子（如 ruleVersion, modelVersion, mcpVersion）纳入 Hash 计算，避免无关模块升级导致缓存失效。\n  final String? analysisFingerprint; \n  /// 是否命中了本地缓存\n  final bool cacheHit;\n\n  // ==========================================\n  // 2. 核心结论 (Core Conclusion)\n  // ==========================================\n  /// 一句话结论 (例如: \"检测到第三方输入法注入导致微信崩溃\")\n  final String headline;\n  /// 责任侧分类: wx_self(微信自身), third_party(第三方), environment(环境), network(网络), unknown(未知)\n  final String classification;\n  /// 分类置信度: high, medium, low (主要用于本地规则判定时，表达证据的充分程度)\n  final String? classificationConfidence;\n  /// 第三方主体名称 (仅在 classification 为 third_party 时存在，如 \"搜狗输入法\")\n  final String? thirdPartyName;\n\n  // ==========================================\n  // 3. 客服闭环动作 (Actionable Advice)\n  // ==========================================\n  /// 下一步动作建议: reply_user(回复用户), escalate_to_dev(转交研发), ask_for_more_info(补充材料)\n  final String actionType;\n  /// 面向用户的回复话术 (通俗易懂，可直接复制给用户)\n  final String userReplyTemplate;\n  /// 面向研发的技术摘要 (包含堆栈、寄存器、关键日志行等硬核信息，转单时使用)\n  final String developerSummary;\n\n  // ==========================================\n  // 4. 证据与上下文 (Evidence \u0026 Context)\n  // ==========================================\n  /// 关键证据列表 (支撑上述结论的核心日志行或 Dump 堆栈片段)\n  final List\u003cString\u003e evidenceList;\n  /// 缺失信息说明 (例如: \"缺少网络日志，无法判断是否为弱网导致\")\n  final List\u003cString\u003e missingInfoList;\n  /// 上下文完整度标签: full_context(日志+Dump), log_guided_dump(日志引导的Dump), dump_only(仅Dump)\n  final String? contextLevel;\n\n  // ==========================================\n  // 5. 异常兜底 (Fallback)\n  // ==========================================\n  /// 错误信息 (当 AI 调用失败、解压失败或完全无法分析时，用于前端展示兜底文案)\n  final String? errorMessage;\n\n  // ==========================================\n  // 6. 规则演进 (Rule Evolution)\n  // ==========================================\n  /// AI 建议沉淀的规则草案 (仅在特定高置信度场景下由 AI 生成，不用于前端展示，仅用于后台静默收集)\n  final RuleDraft? suggestedRuleDraft;\n\n  AnalysisResult({\n    required this.resultType,\n    required this.headline,\n    required this.classification,\n    required this.actionType,\n    required this.userReplyTemplate,\n    required this.developerSummary,\n    this.analysisFingerprint,\n    this.cacheHit = false,\n    this.classificationConfidence,\n    this.thirdPartyName,\n    this.evidenceList = const [],\n    this.missingInfoList = const [],\n    this.contextLevel,\n    this.errorMessage,\n    this.suggestedRuleDraft,\n  });\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111044-75516nd","Type":"NodeParagraph","Properties":{"id":"20260627111044-75516nd","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"其中："}]},{"ID":"20260627111044-xarmise","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-xarmise","updated":"20260627111044"},"Children":[{"ID":"20260627111044-wo0506y","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-wo0506y","updated":"20260627111044"},"Children":[{"ID":"20260627111044-odsjxld","Type":"NodeParagraph","Properties":{"id":"20260627111044-odsjxld","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"classificationConfidence"},{"Type":"NodeText","Data":" 仅用于 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"log-only"},{"Type":"NodeText","Data":" 场景下表达本地分类稳定度，不作为所有分析路径的通用总分。"}]}]},{"ID":"20260627111044-ckx3dr8","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-ckx3dr8","updated":"20260627111044"},"Children":[{"ID":"20260627111044-aztuy43","Type":"NodeParagraph","Properties":{"id":"20260627111044-aztuy43","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"missingInfoList"},{"Type":"NodeText","Data":" 统一承载材料不足、上下文缺失、能力受限以及当前仍无法稳定判断的位置。"}]}]},{"ID":"20260627111044-41c47yq","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-41c47yq","updated":"20260627111044"},"Children":[{"ID":"20260627111044-f0rgbo9","Type":"NodeParagraph","Properties":{"id":"20260627111044-f0rgbo9","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"