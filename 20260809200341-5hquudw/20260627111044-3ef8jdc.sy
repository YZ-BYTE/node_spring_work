键时序信息"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260627111044-pcwceo8","Type":"NodeParagraph","Properties":{"id":"20260627111044-pcwceo8","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"网络日志重复的常见原因包括："}]},{"ID":"20260627111044-6i586pt","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-6i586pt","updated":"20260627111044"},"Children":[{"ID":"20260627111044-bwww9vu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-bwww9vu","updated":"20260627111044"},"Children":[{"ID":"20260627111044-0wmageu","Type":"NodeParagraph","Properties":{"id":"20260627111044-0wmageu","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"同一事件被多层模块重复打印"}]}]},{"ID":"20260627111044-iutqoy7","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-iutqoy7","updated":"20260627111044"},"Children":[{"ID":"20260627111044-w8xv38u","Type":"NodeParagraph","Properties":{"id":"20260627111044-w8xv38u","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"请求重试、重连、重发导致多次记录"}]}]},{"ID":"20260627111044-r6vjsqn","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-r6vjsqn","updated":"20260627111044"},"Children":[{"ID":"20260627111044-wcc4l0j","Type":"NodeParagraph","Properties":{"id":"20260627111044-wcc4l0j","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"多进程、多线程输出近似日志"}]}]},{"ID":"20260627111044-fvxfxvi","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-fvxfxvi","updated":"20260627111044"},"Children":[{"ID":"20260627111044-3wlzsv4","Type":"NodeParagraph","Properties":{"id":"20260627111044-3wlzsv4","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"采集或合并链路导致重复片段"}]}]},{"ID":"20260627111044-t5uwgqa","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-t5uwgqa","updated":"20260627111044"},"Children":[{"ID":"20260627111044-c80lxkw","Type":"NodeParagraph","Properties":{"id":"20260627111044-c80lxkw","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"心跳、轮询、定时任务天然重复"}]}]}]},{"ID":"20260627111044-lc9u8n6","Type":"NodeParagraph","Properties":{"id":"20260627111044-lc9u8n6","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"其中："}]},{"ID":"20260627111044-2e84m69","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-2e84m69","updated":"20260627111044"},"Children":[{"ID":"20260627111044-cqkpviy","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-cqkpviy","updated":"20260627111044"},"Children":[{"ID":"20260627111044-fci10jf","Type":"NodeParagraph","Properties":{"id":"20260627111044-fci10jf","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"可去重"},{"Type":"NodeText","Data":"：完全重复且不携带新状态变化的短时间重复日志"}]}]},{"ID":"20260627111044-rvk171t","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-rvk171t","updated":"20260627111044"},"Children":[{"ID":"20260627111044-pavjsdp","Type":"NodeParagraph","Properties":{"id":"20260627111044-pavjsdp","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"不可简单去重"},{"Type":"NodeText","Data":"：重试链路、状态迁移、性能时序、不同请求上下文下的相似日志"}]}]}]},{"ID":"20260627111044-0rfg2eb","Type":"NodeParagraph","Properties":{"id":"20260627111044-0rfg2eb","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"首版压缩建议采用\""},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"日志签名 + 时间邻近 + 状态变化保护"},{"Type":"NodeText","Data":"\"的口径："}]},{"ID":"20260627111044-ocw4ypu","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-ocw4ypu","updated":"20260627111044"},"Children":[{"ID":"20260627111044-r9alqax","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-r9alqax","updated":"20260627111044"},"Children":[{"ID":"20260627111044-ljsm299","Type":"NodeParagraph","Properties":{"id":"20260627111044-ljsm299","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"日志签名归一化"},{"Type":"NodeText","Data":"：先对日志行做轻量归一化，消除时间戳、随机 ID、地址值等高波动字段，提取可用于比较的稳定签名。"}]}]},{"ID":"20260627111044-py0ykau","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-py0ykau","updated":"20260627111044"},"Children":[{"ID":"20260627111044-zhafi2j","Type":"NodeParagraph","Properties":{"id":"20260627111044-zhafi2j","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"短时间纯重复折叠"},{"Type":"NodeText","Data":"：若短时间内出现同模块、同签名、同语义且不携带新状态变化的重复日志，则折叠为一条，并记录重复次数、首次时间、末次时间和代表样本。"}]}]},{"ID":"20260627111044-lkad54m","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-lkad54m","updated":"20260627111044"},"Children":[{"ID":"20260627111044-q27zp8z","Type":"NodeParagraph","Properties":{"id":"20260627111044-q27zp8z","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键时序保护"},{"Type":"NodeText","Data":"：若日志体现的是重试次数递增、状态从 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"connecting"},{"Type":"NodeText","Data":" 到 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"failed"},{"Type":"NodeText","Data":" 的迁移、耗时演进、错误码变化或上下文切换，则即使文本高度相似，也应保留为独立事件。"}]}]},{"ID":"20260627111044-kxmzing","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-kxmzing","updated":"20260627111044"},"Children":[{"ID":"20260627111044-0p3hd58","Type":"NodeParagraph","Properties":{"id":"20260627111044-0p3hd58","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"输出形式收敛"},{"Type":"NodeText","Data":"：压缩结果不再追求逐行保留，而是收敛为若干个压缩事件、异常时间线片段和重复签名统计项，供后续 AI 使用。"}]}]}]},{"ID":"20260627111044-fib86jz","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260627111044-fib86jz","updated":"20260627111044"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"3.6.4 第 3 步：结构化摘要与 AI 总结"}]},{"ID":"20260627111044-rge96t5","Type":"NodeParagraph","Properties":{"id":"20260627111044-rge96t5","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"网络日志路径不直接把原始全文发送给 AI，而是把本地选段和压缩结果整理为结构化摘要包，再进入总结阶段。"}]},{"ID":"20260627111044-gl91l64","Type":"NodeParagraph","Properties":{"id":"20260627111044-gl91l64","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"AI 输入内容建议至少包括："}]},{"ID":"20260627111044-vg4iris","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-vg4iris","updated":"20260627111044"},"Children":[{"ID":"20260627111044-wf0foxl","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-wf0foxl","updated":"20260627111044"},"Children":[{"ID":"20260627111044-klv5psd","Type":"NodeParagraph","Properties":{"id":"20260627111044-klv5psd","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"关键证据"},{"Type":"NodeText","Data":"：如超时、连接失败、DNS 失败、TLS 握手失败、重试耗尽等高价值异常事件"}]}]},{"ID":"20260627111044-oqknwar","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-oqknwar","updated":"20260627111044"},"Children":[{"ID":"20260627111044-s7r7vj2","Type":"NodeParagraph","Properties":{"id":"20260627111044-s7r7vj2","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"异常时间线"},{"Type":"NodeText","Data":"：按时间顺序整理的重要状态变化、失败链路与恢复情况"}]}]},{"ID":"20260627111044-jwc1tep","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-jwc1tep","updated":"20260627111044"},"Children":[{"ID":"20260627111044-6cjdlhl","Type":"NodeParagraph","Properties":{"id":"20260627111044-6cjdlhl","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重复签名统计"},{"Type":"NodeText","Data":"：哪些异常重复出现、重复次数多少、持续时间多长"}]}]},{"ID":"20260627111044-6w65wcu","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-6w65wcu","updated":"20260627111044"},"Children":[{"ID":"20260627111044-72637fh","Type":"NodeParagraph","Properties":{"id":"20260627111044-72637fh","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"未决问题"},{"Type":"NodeText","Data":"：当前仍缺少哪些上下文，或哪些位置存在冲突和不确定性"}]}]}]},{"ID":"20260627111044-5eypzeb","Type":"NodeParagraph","Properties":{"id":"20260627111044-5eypzeb","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"AI 在该场景下的职责主要是："}]},{"ID":"20260627111044-lexsm5h","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-lexsm5h","updated":"20260627111044"},"Children":[{"ID":"20260627111044-1rujarq","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-1rujarq","updated":"20260627111044"},"Children":[{"ID":"20260627111044-m6byrhe","Type":"NodeParagraph","Properties":{"id":"20260627111044-m6byrhe","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"对压缩后的结构化材料做用户可读总结"}]}]},{"ID":"20260627111044-1ftpeuo","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-1ftpeuo","updated":"20260627111044"},"Children":[{"ID":"20260627111044-hlwvp2i","Type":"NodeParagraph","Properties":{"id":"20260627111044-hlwvp2i","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"提炼最可能的问题链路和关键依据"}]}]},{"ID":"20260627111044-9qoacp9","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-9qoacp9","updated":"20260627111044"},"Children":[{"ID":"20260627111044-k2ioch8","Type":"NodeParagraph","Properties":{"id":"20260627111044-k2ioch8","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"明确当前更像网络链路异常、环境问题还是外部依赖问题"}]}]},{"ID":"20260627111044-g1tqeni","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-g1tqeni","updated":"20260627111044"},"Children":[{"ID":"20260627111044-obtd6gn","Type":"NodeParagraph","Properties":{"id":"20260627111044-obtd6gn","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"在证据不足时保守输出边界说明和下一步建议"}]}]}]},{"ID":"20260627111044-uni4s6c","Type":"NodeParagraph","Properties":{"id":"20260627111044-uni4s6c","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"因此，网络日志 AI 不是替代本地预处理，而是建立在本地候选识别、选段与压缩之后的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"总结与表达层"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260627111044-4qd6cdw","Type":"NodeParagraph","Properties":{"id":"20260627111044-4qd6cdw","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"网络日志总结 (Network Log Summary) 提示词设计"},{"Type":"NodeText","Data":"："}]},{"ID":"20260627111044-rfz3ima","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWFya2Rvd24=","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111044-rfz3ima","updated":"20260627111044"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWFya2Rvd24="},{"Type":"NodeCodeBlockCode","Data":"# Role\n你是企业微信的网络诊断专家。你的任务是基于本地预处理后的网络日志摘要，分析网络连接、请求失败、超时等问题，并严格以 JSON 格式输出结构化结论。\n\n# Context\n本地预处理已对原始网络日志进行了以下处理：\n1. **候选识别**：识别出这是网络相关的日志片段\n2. **本地选段**：围绕异常锚点提取了相关上下文\n3. **去重压缩**：折叠了纯重复日志，保留了关键时序信息\n\n# Workflow\n1. 分析网络连接的生命周期：DNS解析 -\u003e TLS握手 -\u003e 连接建立 -\u003e 请求发送 -\u003e 响应接收\n2. 识别关键异常点：连接失败、超时、重试、TLS错误、DNS解析失败等\n3. 判断问题类型：是网络链路问题、环境配置问题，还是服务端问题？\n   - **主次诱因区分**：若明确是本地代理/防火墙拦截，归为环境问题；若明确是 DNS 污染或公网超时，归为网络链路问题。\n4. 如果证据不足或冲突，保守判定为 `unknown`\n5. 严格按照下方的 JSON Schema 输出结果\n\n# Strict Constraints\n1. 你的输出必须是合法的 JSON 字符串，绝对不要包含任何 Markdown 标记\n2. 必须先在 `_thinking` 字段中写下你的推理过程\n3. **证据约束**：`evidenceList` 必须且只能从输入的网络日志摘要中提取**最核心的报错行或状态变化行**，**绝对禁止编造日志**。\n4. **错误处理**：`errorMessage` 仅在输入数据完全缺失或格式严重错误导致无法分析时填写具体原因，正常分析成功时必须为 `null`。\n\n# Output JSON Schema\n{\n  \"_thinking\": \"在这里写下你的网络分析过程：你看到了哪些网络事件？关键失败点在哪里？时序关系如何？\",\n  \"headline\": \"一句话网络问题结论，例如：检测到DNS解析失败导致后续连接全部超时\",\n  \"classification\": \"必须是以下之一: network(网络链路), environment(环境配置), third_party(第三方服务), unknown(未知)\",\n  \"classificationConfidence\": \"必须是以下之一: high(错误码明确且时序完整), medium(有明确超时但缺少底层错误码), low(仅有零星失败且无明确规律)\",\n  \"thirdPartyName\": \"如果 classification 为 third_party，提取第三方主体名称（如 '深信服天擎'），否则为 null\",\n  \"actionType\": \"必须是以下之一: reply_user(可直接回复用户), escalate_to_dev(需转交研发), ask_for_more_info(需补充材料)\",\n  \"userReplyTemplate\": \"通俗易懂的网络问题排查建议，如检查代理设置、DNS配置、网络连接等\",\n  \"developerSummary\": \"包含关键网络错误码、超时时间、重试次数等技术摘要\",\n  \"evidenceList\": [\n    \"仅限从输入中提取的核心网络日志原文，禁止编造，最多3条\"\n  ],\n  \"missingInfoList\": [\n    \"如果判定为 unknown，指出缺少什么信息\"\n  ],\n  \"errorMessage\": \"正常为 null，仅在输入完全无效时填写错误原因\"\n}\n\n# Input Data\n以下是经过本地选段与去重压缩后的网络日志关键事件与时间线摘要（JSON格式）：\n{{networkSummaryJson}}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111044-y4sjxfb","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260627111044-y4sjxfb","updated":"20260627111044"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"3.6.5 设计边界与去重冗余控制"}]},{"ID":"20260627111044-8ks12ta","Type":"NodeParagraph","Properties":{"id":"20260627111044-8ks12ta","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"为避免方案内部重复和职责漂移，网络日志详细设计建议遵循以下边界："}]},{"ID":"20260627111044-5m79a8o","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-5m79a8o","updated":"20260627111044"},"Children":[{"ID":"20260627111044-20y975j","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-20y975j","updated":"20260627111044"},"Children":[{"ID":"20260627111044-spachf9","Type":"NodeParagraph","Properties":{"id":"20260627111044-spachf9","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"候选识别属于输入准备阶段，不与 AI 总结阶段重复实现。"}]}]},{"ID":"20260627111044-tcafllj","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-tcafllj","updated":"20260627111044"},"Children":[{"ID":"20260627111044-1pc3agb","Type":"NodeParagraph","Properties":{"id":"20260627111044-1pc3agb","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"选段负责缩小上下文范围，不承担最终问题归因。"}]}]},{"ID":"20260627111044-8p1uuo5","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-8p1uuo5","updated":"20260627111044"},"Children":[{"ID":"20260627111044-93rnlk7","Type":"NodeParagraph","Properties":{"id":"20260627111044-93rnlk7","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"去重压缩负责减少噪声、保留时序，不直接生成面向用户的最终文案。"}]}]},{"ID":"20260627111044-9m6n9sc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-9m6n9sc","updated":"20260627111044"},"Children":[{"ID":"20260627111044-rqwff7a","Type":"NodeParagraph","Properties":{"id":"20260627111044-rqwff7a","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"AI 总结只消费结构化摘要包，不直接处理未经选段和压缩的原始全文。"}]}]}]},{"ID":"20260627111044-d5ik87v","Type":"NodeParagraph","Properties":{"id":"20260627111044-d5ik87v","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"据此，文档其他位置只需引用\"网络日志候选识别 / 选段 / 去重压缩 / AI 总结\"这一固定链路，不再重复展开相同步骤细节。"}]},{"ID":"20260627111044-nududcu","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111044-nududcu","updated":"20260627111044"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.7 规则库完善方向"}]},{"ID":"20260627111044-9p37n09","Type":"NodeParagraph","Properties":{"id":"20260627111044-9p37n09","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"规则库不建议继续停留在\"正则集合\"层面，而应逐步升级为\""},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分类 + 证据 + 本地分类信号"},{"Type":"NodeText","Data":"\"的知识规则库。"}]},{"ID":"20260627111044-0hqn0aa","Type":"NodeParagraph","Properties":{"id":"20260627111044-0hqn0aa","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"这里的\"置信度\"不建议设计为关键词权重或整份日志的通用总分，而应收敛为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"log-only"},{"Type":"NodeText","Data":" 场景下的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"classificationConfidence"},{"Type":"NodeText","Data":"：用于表达本地规则对 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wx_self"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unknown"},{"Type":"NodeText","Data":" 分类结论的稳定度。首版建议采用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"high"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"medium"},{"Type":"NodeText","Data":" / "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"low"},{"Type":"NodeText","Data":" 三档，由规则命中后的分类证据聚合得到。"}]},{"ID":"20260627111044-tuzokbg","Type":"NodeParagraph","Properties":{"id":"20260627111044-tuzokbg","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"建议一级分类至少包含："}]},{"ID":"20260627111044-2zn0zfb","Type":"NodeList","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-2zn0zfb","updated":"20260627111044"},"Children":[{"ID":"20260627111044-0ershuc","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-0ershuc","updated":"20260627111044"},"Children":[{"ID":"20260627111044-faay7p5","Type":"NodeParagraph","Properties":{"id":"20260627111044-faay7p5","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"企业微信自身异常"}]}]},{"ID":"20260627111044-l5ujav3","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-l5ujav3","updated":"20260627111044"},"Children":[{"ID":"202606