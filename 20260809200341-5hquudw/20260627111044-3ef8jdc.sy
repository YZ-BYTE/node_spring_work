627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"dump_url"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 仅允许来自用户上传 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"zip"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 解压后的内部提取"},{"Type":"NodeText","Data":"，并明确表示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".dmp"},{"Type":"NodeText","Data":" 的下载地址，不作为前端显式输入。"}]}]},{"ID":"20260627111044-et4v930","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-et4v930","updated":"20260627111044"},"Children":[{"ID":"20260627111044-64kv3w0","Type":"NodeParagraph","Properties":{"id":"20260627111044-64kv3w0","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":".log"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 但存在 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":".dmp"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":" 不视为异常输入"},{"Type":"NodeText","Data":"，应进入 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dump-only"},{"Type":"NodeText","Data":" 分析路径。"}]}]},{"ID":"20260627111044-9ztq47x","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-9ztq47x","updated":"20260627111044"},"Children":[{"ID":"20260627111044-23nf1e1","Type":"NodeParagraph","Properties":{"id":"20260627111044-23nf1e1","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"无任何可分析材料"},{"Type":"NodeText","Data":" 才判定为输入无效。"}]}]}]},{"ID":"20260627111044-d4trn5g","Type":"NodeParagraph","Properties":{"id":"20260627111044-d4trn5g","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"输入分类建议统一为以下几类，并收敛为标准化的 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PreparedInput"},{"Type":"NodeText","Data":" 数据结构："}]},{"ID":"20260627111044-vkt7zbp","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"ZGFydA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111044-vkt7zbp","updated":"20260627111044"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"ZGFydA=="},{"Type":"NodeCodeBlockCode","Data":"/// 内部标准化分析材料 (由解压和扫描阶段产出)\nclass PreparedInput {\n  final String preparedType; // 分流标识: plain_log, dump_bundle, dump_only, network_log_segment\n  final String sourceFingerprint; // 用于结果缓存的输入指纹\n  \n  // 物理载体\n  final String? logFilePath;\n  final List\u003cString\u003e? dumpFilePathList; // 输入准备阶段提取到的全部 dump 本地路径（未经筛选）\n  final List\u003cString\u003e? symbolFilePathList; // 提取的符号文件 (本地路径，如 .pdb)\n  List\u003cString\u003e? dumpSha1List;           // 上传到 MCP 服务器后获取的 SHA1 列表 (由分析层调度上传后补充)\n  bool isSymbolsUploaded;               // 符号文件是否已成功上传并建立索引\n  final String? dumpUrl;                // 从 zip 中提取的 dump 下载地址\n  \n  // 附加上下文 (按需存在)\n  final bool hasLogContext;\n  final DumpHints? dumpHints;           // log 预分析提取的线索 (issueType, timeWindow 等)\n  final NetworkLogSegment? logSegment;  // 网络日志选段与压缩结果，作为正交特征可挂载到 dump_bundle 或独立形成 network_log_segment\n\n  PreparedInput({\n    required this.preparedType,\n    required this.sourceFingerprint,\n    this.logFilePath,\n    this.dumpFilePathList,\n    this.symbolFilePathList,\n    this.dumpUrl,\n    this.isSymbolsUploaded = false,\n    this.hasLogContext = false,\n    this.dumpHints,\n    this.logSegment,\n  });\n}\n\n// 辅助类：Dump 线索与网络日志片段\nclass DumpHints {\n  String? issueType;\n  String? timeWindow;\n  List\u003cString\u003e? modules;\n}\n\nclass NetworkLogSegment {\n  String? sourceFile;\n  String? compressedContent; // 压缩后的关键事件与时间线，直接喂给 AI\n}\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111044-9gb81zg","Type":"NodeParagraph","Properties":{"id":"20260627111044-9gb81zg","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"对应的输入分流与主处理关系如下："}]},{"ID":"20260627111044-lobn9y0","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260627111044-lobn9y0","updated":"20260627111044"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    A[上传 zip / 单文件] --\u003e B{是否为 zip}\n\n    B -- 是 --\u003e C[解压并扫描]\n    B -- 否 --\u003e D[识别单文件类型]\n\n    C --\u003e E[提取材料\u003cbr/\u003elog / dmp / 符号文件 / dump_url]\n    D --\u003e E\n\n    E --\u003e N1{是否存在 log?}\n    N1 -- 是 --\u003e N2[网络特征轻量嗅探]\n    N2 -- 命中 --\u003e N3[提取并压缩网络片段 logSegment]\n    N2 -- 未命中 --\u003e N4[无网络片段]\n    N1 -- 否 --\u003e N4\n\n    N3 --\u003e F\n    N4 --\u003e F\n\n    F{是否存在 dmp?}\n\n    F -- 是且存在 log --\u003e H[形成 dump_bundle\u003cbr/\u003e按需挂载 logSegment]\n    H --\u003e G[主控层调度 log 轻量预分析]\n    G --\u003e SC{触发强规则短路?}\n    SC -- 是 --\u003e SC_OUT[直接输出本地结论]\n    SC -- 否 --\u003e G2[提取 dumpHints 并筛选 dump]\n    G2 --\u003e U1[并发上传保留项 Dump 与符号文件]\n    U1 --\u003e I[进入 Dump 专业分析\u003cbr/\u003e结合 networkContext]\n\n    F -- 是且不存在 log --\u003e J1[dump 去重归并]\n    J1 --\u003e J[形成 dump_only]\n    J --\u003e U2[并发上传代表项 Dump 与符号文件]\n    U2 --\u003e I\n\n    F -- 否 --\u003e K{是否存在可分析 log?}\n    K -- 否 --\u003e L[\"输入无效 (丢弃孤立符号文件)\"]\n    K -- 是 --\u003e M{是否挂载了 logSegment?}\n    M -- 是 --\u003e R[形成 network_log_segment]\n    R --\u003e S[进入网络日志总结]\n    M -- 否 --\u003e N[形成 plain_log]\n    N --\u003e O[进入本地规则分析]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260627111044-hp3bdwy","Type":"NodeParagraph","Properties":{"id":"20260627111044-hp3bdwy","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"其中，"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"log_only"},{"Type":"NodeText","Data":" 仅表示当前输入材料中存在可分析日志，并不直接等同于最终 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PreparedInput.preparedType"},{"Type":"NodeText","Data":"；在该场景下，应默认形成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"plain_log"},{"Type":"NodeText","Data":" 主链路。如果同时提取到了 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"logSegment"},{"Type":"NodeText","Data":"，则可以独立形成 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"network_log_segment"},{"Type":"NodeText","Data":" 进入网络日志总结路径，或者作为补充上下文挂载。"}]},{"ID":"20260627111044-8gafws5","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260627111044-8gafws5","updated":"20260627111044"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"#### "},{"Type":"NodeText","Data":"3.2.1 URL 输入边界说明"}]},{"ID":"20260627111044-lrrer4z","Type":"NodeParagraph","Properties":{"id":"20260627111044-lrrer4z","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"首版仍将 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"dump_url"},{"Type":"NodeText","Data":" 视为受支持的分析输入形态，并明确其表示 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":".dmp"},{"Type":"NodeText","Data":" 的下载地址，但仅支持从用户上传 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"zip"},{"Type":"NodeText","Data":" 解压结果中内部提取，不开放用户手工输入 URL。"}]},{"ID":"20260627111044-plhifpq","Type":"NodeParagraph","Properties":{"id":"20260627111044-plhifpq","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"这样收敛的原因如下："}]},{"ID":"20260627111044-84r3ua0","Type":"NodeList","L