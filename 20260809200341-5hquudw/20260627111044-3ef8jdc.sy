ldren":[{"ID":"20260627111044-pl8ol7w","Type":"NodeParagraph","Properties":{"id":"20260627111044-pl8ol7w","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"AI 接入层"},{"Type":"NodeText","Data":"：通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CAOI"},{"Type":"NodeText","Data":" 统一访问 AI 能力；Dump 场景优先通过 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"CAOI"},{"Type":"NodeText","Data":" 调用 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"cdb-analysis MCP"},{"Type":"NodeText","Data":"。"}]}]}]},{"ID":"20260627111044-k3q1p7r","Type":"NodeParagraph","Properties":{"id":"20260627111044-k3q1p7r","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"本次方案不新建独立子系统，不引入额外本地服务，优先在现有骨架上增量改造。"}]},{"ID":"20260627111044-0hb0qit","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260627111044-0hb0qit","updated":"20260627111044"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.2 输入准备与分类"}]},{"ID":"20260627111044-6zjjpps","Type":"NodeParagraph","Properties":{"id":"20260627111044-6zjjpps","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"【通俗解释】"},{"Type":"NodeText","Data":"：就像在厨房里加了一个“配菜员”。以前是把整个购物袋（zip路径）直接扔给厨师（分析引擎），现在是由配菜员先洗菜切菜，把日志、Dump文件、网络日志分门别类装进标准化的“备菜盘”（"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"PreparedInput"},{"Type":"NodeText","Data":"）里，再端给厨师。"}]},{"ID":"20260627111044-kakvdjs","Type":"NodeParagraph","Properties":{"id":"20260627111044-kakvdjs","updated":"20260627111044"},"Children":[{"Type":"NodeText","Data":"前端传入的原始输入源统一封装为 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AnalysisSource"},{"Type":"NodeText","Data":"："}]},{"ID":"20260627111044-s66gc9v","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo