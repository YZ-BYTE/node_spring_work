":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-jxwz9lu","updated":"20260627111044"},"Children":[{"ID":"20260627111044-jfccqhi","Type":"NodeParagraph","Properties":{"id":"20260627111044-jfccqhi","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分类字段先落在 "},{"Type":"NodeTextMark","TextMarkType":"strong code","TextMarkTextContent":"rule_list"},{"Type":"NodeText","Data":"：首版优先在单条规则上新增 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root_category"},{"Type":"NodeText","Data":" 字段，用于承载根因分类；未补该字段的旧规则按 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unknown"},{"Type":"NodeText","Data":" 处理，不影响原有命中逻辑。"}]}]},{"ID":"20260627111044-m2re985","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-m2re985","updated":"20260627111044"},"Children":[{"ID":"20260627111044-7vl2mmi","Type":"NodeParagraph","Properties":{"id":"20260627111044-7vl2mmi","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"代码层最小消费新字段"},{"Type":"NodeText","Data":"：首版可先在 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"datasource.dart"},{"Type":"NodeText","Data":" 的现有规则解析和结果拼装过程中最小读取 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root_category"},{"Type":"NodeText","Data":"，用于兼容分类试点与结果标签透传；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"attribution_side"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"evidence_level"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"allow_direct_output"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"scene_tag_list"},{"Type":"NodeText","Data":" 等字段按阶段接入。这里的\"最小读取\"仅表示阶段性接入顺序，不代表最终归因方案只依赖 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root_category"},{"Type":"NodeText","Data":"；"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"log-only"},{"Type":"NodeText","Data":" 场景下的最终 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"classification"},{"Type":"NodeText","Data":" 仍应基于责任侧聚合结果生成，而不是直接由单条规则类型映射得出。"}]}]},{"ID":"20260627111044-dmamv3x","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-dmamv3x","updated":"20260627111044"},"Children":[{"ID":"20260627111044-3h4rcfb","Type":"NodeParagraph","Properties":{"id":"20260627111044-3h4rcfb","updated":"20260627111044"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分类枚举先收敛后扩展"},{"Type":"NodeText","Data":"："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"root_category"},{"Type":"NodeText","Data":" 建议至少支持 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wx_self"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"third_party"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"environment"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"network"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"external_dependency"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"unknown"},{"Type":"NodeText","Data":"；其中环境类与网络类先在规则层和结果对象中保留，待前端展示节奏成熟后再独立开放。"}]}]},{"ID":"20260627111044-sq2r7xs","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260627111044-sq2r7xs","updated":"20260627111044"},"Children":[{"ID":"20260627111044-z7kuklw","Type":"NodeParagraph","Properties":{"id":"20