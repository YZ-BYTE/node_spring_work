}\n    D --\u003e E[\"取代表 dump → 深度采证 runDeepCollection()\"]\n    E --\u003e F[\"🎯 engine.analyze() 规则归因\"]\n    F --\u003e G{\"组内有多种异常帧?\"}\n    G -- 是 --\u003e H[\"补充 exceptionSummary\"]\n    G -- 否 --\u003e I[\"保持原结果\"]\n    H --\u003e J{\"检测到内存信号?\u003cbr/\u003ebad_alloc / 0xc0000017\"}\n    I --\u003e J\n    J -- 是 --\u003e K[\"触发 analyzeMemoryLogs()\"]\n    J -- 否 --\u003e D\n    K -- \"systemOom/wxworkOom\" --\u003e L[\"⏸️ break 用精确话术覆盖\"]\n    K -- \"数据不足\" --\u003e D\n    D -- \"全部完成\" --\u003e M[\"📊 构建 MultiDumpAnalysisResult\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-c41olnm","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-c41olnm","updated":"20260725144256"}},{"ID":"20260725144256-zjcap3h","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-zjcap3h","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"图2：分组算法（groupBySignature）"}]},{"ID":"20260725144256-wf3v0mf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260725144256-wf3v0mf","updated":"20260725144256"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    A[\"输入: 预筛后 dump 列表\"] --\u003e B[\"提取三元签名\u003cbr/\u003e{exceptionCode, module, function}\"]\n    B --\u003e C{\"异常码不可合并?\u003cbr/\u003e0xc0000374 / 0x80000003\"}\n    C -- 是 --\u003e D[\"各自独立成组\"]\n    C -- 否 --\u003e E[\"按 L1 key 预分组\u003cbr/\u003ecode!module!function\"]\n    E --\u003e F{\"L1 组内 ≥ 2?\"}\n    F -- 是 --\u003e G[\"建 L1 组 (函数级)\"]\n    F -- 否 --\u003e H[\"尝试 L2 key\u003cbr/\u003ecode!module\"]\n    H --\u003e I{\"L2 相同 ≥ 2?\"}\n    I -- 是 --\u003e J[\"建 L2 组 (模块级)\"]\n    I -- 否 --\u003e K[\"独立成组 (异常码级)\"]\n    G \u0026 J \u0026 K \u0026 D --\u003e L[\"按组内 dump 数降序排序\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-x79farr","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-x79farr","updated":"20260725144256"}},{"ID":"20260725144256-7b3dv4s","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-7b3dv4s","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"图3：规则管道 — S0 ~ S1.7（异常码快速通道）"}]},{"ID":"20260725144256-ir867qq","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260725144256-ir867qq","updated":"20260725144256"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    Start([\"📥 输入: DeepCollectionResult\"]) --\u003e S0{\"S0: 数据完备?\"}\n    S0 -- \"缺异常码/栈帧\" --\u003e S0R[\"❌ unable_to_analyze\"]\n    S0 -- \"完备\" --\u003e S1[\"S1: 内存破坏模式打标\u003cbr/\u003eheapMode / funcPtrMode\"]\n    S1 --\u003e S15{\"S1.5: FAILURE_BUCKET\u003cbr/\u003e命中硬件桶?\"}\n    S15 -- 是 --\u003e S15R[\"✅ hardware_issue (high)\"]\n    S15 -- 否 --\u003e S16{\"S1.6: 异常码 ∈ 主动退出集?\u003cbr/\u003eabort / Crashpad\"}\n    S16 -- 是 --\u003e S16R[\"✅ self_exit (medium)\"]\n    S16 -- 否 --\u003e Sx{\"Sx: CEF 环境异常?\u003cbr/\u003e0x80000003 + CEF模块\"}\n    Sx -- 是 --\u003e SxR[\"✅ environment_issue\"]\n    Sx -- 否 --\u003e S17{\"S1.7: I/O Error 异常码?\"}\n    S17 -- 否 --\u003e NEXT[\"➡️ 进入 S2\"]\n    S17 -- 是 --\u003e S17E{\"环境有 DLP/杀毒?\"}\n    S17E -- 无 --\u003e S17HW[\"✅ hardware_issue (high)\"]\n    S17E -- 有 --\u003e S17D{\"明确磁盘错误?\"}\n    S17D -- 是 --\u003e S17HW\n    S17D -- 否 --\u003e S17Skip[\"设 skipS3=true → 进入 S2\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-elguspn","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-elguspn","updated":"20260725144256"}},{"ID":"20260725144256-o8hcrnv","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-o8hcrnv","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"图4：规则管道 — S2 ~ S3-B（用户栈 + 第三方名册）"}]},{"ID":"20260725144256-uia4pyo","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260725144256-uia4pyo","updated":"20260725144256"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    NEXT([\"➡️ S2 入口\"]) --\u003e S2[\"S2: 构建 userFrames\u003cbr/\u003e剔除透明模块 + 去递归\"]\n    S2 --\u003e S2E{\"userFrames 为空?\"}\n    S2E -- 否 --\u003e S3A\n    S2E -- 是 --\u003e S2F{\"栈溢出 + DLP/Hook?\"}\n    S2F -- 是 --\u003e S2FR[\"✅ third_party_hit\"]\n    S2F -- 否 --\u003e S2G{\"AV + CreateProcess\u003cbr/\u003e+ DLP/未知模块?\"}\n    S2G -- 是 --\u003e S2GR[\"✅ third_party_hit\"]\n    S2G -- 否 --\u003e S2H[\"❌ unable_to_analyze\"]\n\n    S3A{\"S3-A: 栈顶用户帧\u003cbr/\u003e命中第三方名册?\"}\n    S3A -- 是 --\u003e S3AR[\"✅ third_party_hit (high)\u003cbr/\u003e→ S-Final 钳位\"]\n    S3A -- 否 --\u003e S3B[\"S3-B: 扫描 userFrames[1..19]\"]\n    S3B --\u003e S3BC{\"帧 i 命中第三方?\"}\n    S3BC -- \"idx\u003c5\" --\u003e S3BH[\"✅ high\"]\n    S3BC -- \"5≤idx\u003c10\" --\u003e S3BM[\"✅ medium\"]\n    S3BC -- \"idx≥10\" --\u003e S3BL[\"✅ low\"]\n    S3BC -- \"未命中\" --\u003e NEXT2[\"➡️ 进入 S4\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-v4x02d8","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-v4x02d8","updated":"20260725144256"}},{"ID":"20260725144256-8jgsdib","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-8jgsdib","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"图5：规则管道 — S4 ~ R8（场景关联 + 企微判定 + 兜底）"}]},{"ID":"20260725144256-z6bmxzi","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260725144256-z6bmxzi","updated":"20260725144256"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart TD\n    NEXT2([\"➡️ S4 入口\"]) --\u003e S4{\"S4: 场景规则命中?\u003cbr/\u003e栈关键词 + 环境模块\"}\n    S4 -- 是 --\u003e S4R[\"✅ third_party_hit → S-Final 钳位\"]\n    S4 -- 否 --\u003e S4C{\"S4-C: 穿插检测\u003cbr/\u003e非企微帧 ≥ 3次?\"}\n    S4C -- 是 --\u003e S4CR[\"✅ third_party_hit (medium/low)\"]\n    S4C -- 否 --\u003e S4D{\"S4-D: skipS3=true?\"}\n    S4D -- 是 --\u003e S4DR[\"✅ hardware_issue (low)\"]\n    S4D -- 否 --\u003e S5{\"S5: 栈顶属于企微?\"}\n    S5 -- 否 --\u003e R8\n    S5 -- \"是 + 内存破坏\" --\u003e S5MC[\"评估内存破坏栈\"]\n    S5 -- \"是 + 无内存破坏\" --\u003e S5N\n\n    S5MC --\u003e MC1{\"企微连续≥3帧?\"}\n    MC1 -- 是 --\u003e MC1R[\"✅ third_party_not_hit (medium)\u003cbr/\u003e'企微自身内存问题'\"]\n    MC1 -- 否 --\u003e MC2{\"第三方连续≥3帧?\"}\n    MC2 -- 是 --\u003e MC2R[\"❌ unable_to_analyze\u003cbr/\u003e'企微是受害者'\"]\n    MC2 -- 否 --\u003e MC3R[\"❌ unable_to_analyze (low)\u003cbr/\u003e'栈不可信'\"]\n\n    S5N{\"S5-D: 有未识别模块?\"}\n    S5N -- 是 --\u003e S5NR[\"✅ third_party_hit (medium)\"]\n    S5N -- 否 --\u003e S5E{\"S5-E: 环境有Hook类?\"}\n    S5E -- 是 --\u003e S5ER[\"✅ third_party_not_hit (medium)\u003cbr/\u003e'企微Bug+疑似干扰'\"]\n    S5E -- 否 --\u003e S5ER2[\"✅ third_party_not_hit (high)\u003cbr/\u003e'确认企微自身Bug'\"]\n\n    R8{\"R8: 兜底\u003cbr/\u003e栈中有未识别模块?\"}\n    R8 -- 是 --\u003e R8R[\"✅ third_party_hit (medium)\"]\n    R8 -- 否 --\u003e R8N[\"❌ unable_to_analyze (low)\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-zx32hu7","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-zx32hu7","updated":"20260725144256"}},{"ID":"20260725144256-i0rrnqh","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-i0rrnqh","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"附：S-Final 全局置信度钳位"}]},{"ID":"20260725144256-cr1zo86","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260725144256-cr1zo86","updated":"20260725144256"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"flowchart LR\n    IN([\"命中结果 confidence=high\"]) --\u003e C1{\"memoryCorruptMode?\"}\n    C1 -- 否 --\u003e OUT([\"保持 high\"])\n    C1 -- 是 --\u003e C2{\"硬件类结论?\"}\n    C2 -- 是 --\u003e OUT\n    C2 -- 否 --\u003e C3{\"评估内存破坏栈\"}\n    C3 -- \"第三方可信\" --\u003e OUT\n    C3 -- \"企微可信\" --\u003e D1[\"⚠️ 降为 medium + '建议人工复核'\"]\n    C3 -- \"栈不可信\" --\u003e D2[\"⚠️ 降为 medium + '建议人工复核'\"]\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260725144256-rbjzfns","Type":"NodeThematicBreak","Properties":{"id":"20260725144256-rbjzfns","updated":"20260725144256"}},{"ID":"20260725144256-yoifyf6","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260725144256-yoifyf6","updated":"20260725144256"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"归因分类速查"}]},{"ID":"20260725144256-ru4u7lv","Type":"NodeTable","Data":"| 分类 